theorem exists_weightedFreeComponent_ne_zero
    (K : Type u) [Field K] {sigma : Type*} {N : ℕ}
    (r : Fin N → ℕ) {p : Fin N → MvPolynomial sigma K}
    (hp : p ≠ 0) :
    ∃ d, weightedFreeComponent K r d p ≠ 0 := by
