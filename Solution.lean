open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V]

theorem boundaryOnSimplex_apply
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (F : AugmentedSimplex C (q + 1)) (R : AugmentedSimplex C q) :
    boundaryOnSimplex K C q F R = if R.1 ⊆ F.1 then 1 else 0 := by
  classical
  rw [boundaryOnSimplex]
  rw [Finsupp.finsetSum_apply]
  by_cases hRF : R.1 ⊆ F.1
  · rw [if_pos hRF]
    have hcard : (F.1 \ R.1).card = 1 := by
      rw [Finset.card_sdiff_of_subset hRF, F.2.2, R.2.2]
      omega
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp hcard
    have hvdiff : v ∈ F.1 \ R.1 := by simp [hv]
    have hvF : v ∈ F.1 := (Finset.mem_sdiff.mp hvdiff).1
    have hvR : v ∉ R.1 := (Finset.mem_sdiff.mp hvdiff).2
    let w : ↥F.1 := ⟨v, hvF⟩
    have hF : F.1 = insert v R.1 := by
      ext x
      constructor
      · intro hxF
        by_cases hxR : x ∈ R.1
        · simp [hxR]
        · have hxdiff : x ∈ F.1 \ R.1 :=
            Finset.mem_sdiff.mpr ⟨hxF, hxR⟩
          have hxv : x = v := by simpa [hv] using hxdiff
          simp [hxv]
      · intro hx
        rw [Finset.mem_insert] at hx
        exact hx.elim (fun hxv ↦ hxv.symm ▸ hvF) (fun hxR ↦ hRF hxR)
    have herase : eraseSimplex C F w = R := by
      apply Subtype.ext
      change F.1.erase v = R.1
      simp [hF, hvR]
    rw [Finset.sum_eq_single w]
    · simp [herase]
    · intro b _ hbw
      have hne : eraseSimplex C F b ≠ R := by
        intro hbR
        have heq : F.1.erase b.1 = F.1.erase w.1 := by
          simpa only [eraseSimplex_val] using
            congrArg Subtype.val (hbR.trans herase.symm)
        have hbval : b.1 = w.1 := (Finset.erase_inj F.1 b.2).mp heq
        exact hbw (Subtype.ext hbval)
      simp [hne]
    · simp
  · rw [if_neg hRF]
    apply Finset.sum_eq_zero
    intro w _
    have hne : eraseSimplex C F w ≠ R := by
      intro heq
      apply hRF
      intro x hxR
      have hxerase : x ∈ F.1.erase w.1 := by
        simpa only [eraseSimplex_val] using
          (show x ∈ (eraseSimplex C F w).1 by rw [heq]; exact hxR)
      exact Finset.mem_of_mem_erase hxerase
    simp [hne]

noncomputable def facetIndicatorChain
    (K : Type v) [Field K] [Finite V]
    (C : AugmentedComplex V) (q : ℕ)
    (P : AugmentedSimplex C q → Prop) :
    AugmentedChain K C q := by
  classical
  exact ∑ F : AugmentedSimplex C q,
    if P F then Finsupp.single F 1 else 0

omit [DecidableEq V] in
@[simp]
theorem facetIndicatorChain_apply
    (K : Type v) [Field K] [Finite V]
    (C : AugmentedComplex V) (q : ℕ)
  (P : AugmentedSimplex C q → Prop) [DecidablePred P]
    (F : AugmentedSimplex C q) :
    facetIndicatorChain K C q P F = if P F then 1 else 0 := by
  classical
  rw [facetIndicatorChain, Finsupp.finsetSum_apply,
    Finset.sum_eq_single F]
  · by_cases hP : P F <;> simp [hP]
  · intro G _ hGF
    by_cases hP : P G <;> simp [hP, hGF]
  · simp

theorem faceBoundary_facetIndicatorChain_apply
    (K : Type v) [Field K] [Finite V]
    (C : AugmentedComplex V) (q : ℕ)
    (P : AugmentedSimplex C (q + 1) → Prop) [DecidablePred P]
    (R : AugmentedSimplex C q) :
    faceBoundary K C q (facetIndicatorChain K C (q + 1) P) R =
      ∑ F : AugmentedSimplex C (q + 1),
        if P F then (if R.1 ⊆ F.1 then 1 else 0) else 0 := by
  classical
  rw [facetIndicatorChain, map_sum, Finsupp.finsetSum_apply]
  apply Finset.sum_congr rfl
  intro F _
  by_cases hP : P F
  · simp [hP, faceBoundary_single, boundaryOnSimplex_apply]
  · simp [hP]

omit [DecidableEq V] in
theorem augmentedFacetAdjacent_symm (C : AugmentedComplex V) (d : ℕ) :
    ∀ {F G}, AugmentedFacetAdjacent C d F G →
      AugmentedFacetAdjacent C d G F := by
  rintro F G ⟨R, hR, hcard, hRF, hRG⟩
  exact ⟨R, hR, hcard, hRG, hRF⟩

omit [DecidableEq V] in
theorem reach_iff_of_augmentedFacetAdjacent
    (C : AugmentedComplex V) (d : ℕ)
    (F₀ F G : AugmentedFacetOfCard C d)
    (hFG : AugmentedFacetAdjacent C d F G) :
    Relation.ReflTransGen (AugmentedFacetAdjacent C d) F₀ F ↔
      Relation.ReflTransGen (AugmentedFacetAdjacent C d) F₀ G := by
  constructor
  · intro h
    exact h.trans (Relation.ReflTransGen.single hFG)
  · intro h
    exact h.trans (Relation.ReflTransGen.single
      (augmentedFacetAdjacent_symm C d hFG))

omit [DecidableEq V] in
theorem augmentedFacetReach_symm
    (C : AugmentedComplex V) (d : ℕ)
    {F G : AugmentedFacetOfCard C d}
    (h : Relation.ReflTransGen (AugmentedFacetAdjacent C d) F G) :
    Relation.ReflTransGen (AugmentedFacetAdjacent C d) G F := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hAB hBC ih =>
      exact (Relation.ReflTransGen.single
        (augmentedFacetAdjacent_symm C d hBC)).trans ih

theorem facetComponentChain_cycle
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : SimplicialSphereAnisotropicity.Topology.FacesBoundedBy C (q + 1))
    (hall : SimplicialSphereAnisotropicity.Topology.IsAllLinkHomologySphere K C (q + 1))
    (F₀ : AugmentedFacetOfCard C (q + 1)) :
    faceBoundary K C q
      (facetIndicatorChain K C (q + 1)
        (fun F ↦ Relation.ReflTransGen
          (AugmentedFacetAdjacent C (q + 1)) F₀ F)) = 0 := by
  classical
  apply Finsupp.ext
  intro R
  rw [faceBoundary_facetIndicatorChain_apply]
  have htwo := SimplicialSphereAnisotropicity.Topology.ridge_two_of_allLinkHomologySphere
    K C (q + 1) hbound hall R.2.1 (by simpa using R.2.2)
  rw [Set.ncard_eq_two] at htwo
  obtain ⟨X, Y, hXY, hset⟩ := htwo
  have hXmem : X ∈ C ∧ X.card = q + 1 ∧ R.1 ⊆ X := by
    have : X ∈ {F : Finset V | F ∈ C ∧ F.card = q + 1 ∧ R.1 ⊆ F} := by
      rw [hset]
      simp
    exact this
  have hYmem : Y ∈ C ∧ Y.card = q + 1 ∧ R.1 ⊆ Y := by
    have : Y ∈ {F : Finset V | F ∈ C ∧ F.card = q + 1 ∧ R.1 ⊆ F} := by
      rw [hset]
      simp
    exact this
  let FX : AugmentedFacetOfCard C (q + 1) := ⟨X, hXmem.1, hXmem.2.1⟩
  let FY : AugmentedFacetOfCard C (q + 1) := ⟨Y, hYmem.1, hYmem.2.1⟩
  have hFXY : FX ≠ FY := by
    intro h
    exact hXY (congrArg Subtype.val h)
  have hinc (F : AugmentedFacetOfCard C (q + 1)) :
      R.1 ⊆ F.1 ↔ F = FX ∨ F = FY := by
    constructor
    · intro hRF
      have hm : F.1 ∈ {G : Finset V |
          G ∈ C ∧ G.card = q + 1 ∧ R.1 ⊆ G} :=
        ⟨F.2.1, F.2.2, hRF⟩
      rw [hset] at hm
      rcases hm with hm | hm
      · exact Or.inl (Subtype.ext hm)
      · exact Or.inr (Subtype.ext hm)
    · rintro (rfl | rfl)
      · exact hXmem.2.2
      · exact hYmem.2.2
  have hadj : AugmentedFacetAdjacent C (q + 1) FX FY :=
    ⟨R.1, R.2.1, by simpa using R.2.2, hXmem.2.2, hYmem.2.2⟩
  have hreach :
      Relation.ReflTransGen (AugmentedFacetAdjacent C (q + 1)) F₀ FX ↔
        Relation.ReflTransGen (AugmentedFacetAdjacent C (q + 1)) F₀ FY :=
    reach_iff_of_augmentedFacetAdjacent C (q + 1) F₀ FX FY hadj
  simp_rw [hinc]
  have hrestrict :
      (∑ x : AugmentedFacetOfCard C (q + 1),
        if Relation.ReflTransGen (AugmentedFacetAdjacent C (q + 1)) F₀ x then
          if x = FX ∨ x = FY then (1 : K) else 0
        else 0) =
      ∑ x ∈ ({FX, FY} : Finset (AugmentedFacetOfCard C (q + 1))),
        if Relation.ReflTransGen (AugmentedFacetAdjacent C (q + 1)) F₀ x then
          if x = FX ∨ x = FY then (1 : K) else 0
        else 0 := by
    symm
    apply Finset.sum_subset (by simp)
    intro x _ hx
    have hxpair : ¬ (x = FX ∨ x = FY) := by simpa using hx
    simp [hxpair]
  rw [hrestrict]
  by_cases hP : Relation.ReflTransGen
      (AugmentedFacetAdjacent C (q + 1)) F₀ FX
  · have hPY : Relation.ReflTransGen
        (AugmentedFacetAdjacent C (q + 1)) F₀ FY := hreach.mp hP
    simp [hP, hPY, hFXY, CharTwo.add_self_eq_zero]
  · have hPY : ¬ Relation.ReflTransGen
        (AugmentedFacetAdjacent C (q + 1)) F₀ FY := fun h ↦ hP (hreach.mpr h)
    simp [hP, hPY]

theorem facet_connected_of_allLinkHomologySphere
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : SimplicialSphereAnisotropicity.Topology.FacesBoundedBy C d)
    (hall : SimplicialSphereAnisotropicity.Topology.IsAllLinkHomologySphere K C d) :
    ∀ F G : AugmentedFacetOfCard C d,
      Relation.ReflTransGen (AugmentedFacetAdjacent C d) F G := by
  classical
  rcases d with _ | q
  · intro F G
    have hFG : F = G := by
      apply Subtype.ext
      exact (Finset.card_eq_zero.mp F.2.2).trans
        (Finset.card_eq_zero.mp G.2.2).symm
    subst G
    exact Relation.ReflTransGen.refl
  · intro F₀ G₀
    by_contra hnot
    let zF : AugmentedChain K C (q + 1) :=
      facetIndicatorChain K C (q + 1)
        (fun H ↦ Relation.ReflTransGen
          (AugmentedFacetAdjacent C (q + 1)) F₀ H)
    let zG : AugmentedChain K C (q + 1) :=
      facetIndicatorChain K C (q + 1)
        (fun H ↦ Relation.ReflTransGen
          (AugmentedFacetAdjacent C (q + 1)) G₀ H)
    have hzF : faceBoundary K C q zF = 0 := by
      exact facetComponentChain_cycle K C q hbound hall F₀
    have hzG : faceBoundary K C q zG = 0 := by
      exact facetComponentChain_cycle K C q hbound hall G₀
    have hnotGF : ¬ Relation.ReflTransGen
        (AugmentedFacetAdjacent C (q + 1)) G₀ F₀ := by
      intro h
      exact hnot (augmentedFacetReach_symm C (q + 1) h)
    let zFk : LinearMap.ker (faceBoundary K C q) := ⟨zF, hzF⟩
    let zGk : LinearMap.ker (faceBoundary K C q) := ⟨zG, hzG⟩
    let pairMap : K × K →ₗ[K] LinearMap.ker (faceBoundary K C q) :=
      { toFun := fun p ↦ p.1 • zFk + p.2 • zGk
        map_add' := by
          intro p r
          simp only [Prod.fst_add, Prod.snd_add, add_smul]
          abel
        map_smul' := by
          intro a p
          ext
          simp [mul_smul, smul_add] }
    have hreflF : Relation.ReflTransGen
        (AugmentedFacetAdjacent C (q + 1)) F₀ F₀ :=
      Relation.ReflTransGen.refl
    have hreflG : Relation.ReflTransGen
        (AugmentedFacetAdjacent C (q + 1)) G₀ G₀ :=
      Relation.ReflTransGen.refl
    have hzFF : zF F₀ = 1 := by simp [zF, hreflF]
    have hzGF : zG F₀ = 0 := by simp [zG, hnotGF]
    have hzFG : zF G₀ = 0 := by simp [zF, hnot]
    have hzGG : zG G₀ = 1 := by simp [zG, hreflG]
    have hpair : Function.Injective pairMap := by
      intro p r hpr
      have hfirst := congrArg
        (fun z : LinearMap.ker (faceBoundary K C q) ↦ z.1 F₀) hpr
      have hsecond := congrArg
        (fun z : LinearMap.ker (faceBoundary K C q) ↦ z.1 G₀) hpr
      have hp₁ : p.1 = r.1 := by
        simpa [pairMap, zFk, zGk, hzFF, hzGF] using hfirst
      have hp₂ : p.2 = r.2 := by
        simpa [pairMap, zFk, zGk, hzFG, hzGG] using hsecond
      exact Prod.ext hp₁ hp₂
    let A := faceChainComplex K C
    let hEmptyNext : IsEmpty (AugmentedSimplex C (q + 2)) := by
      constructor
      intro H
      have hle := hbound H.1 H.2.1
      rw [H.2.2] at hle
      omega
    let hsubNext : Subsingleton (AugmentedChain K C (q + 2)) :=
      ⟨fun x y ↦ Finsupp.ext fun i ↦ (hEmptyNext.false i).elim⟩
    have hXNext : IsZero (A.X (q + 2)) := by
      change IsZero (ModuleCat.of K (AugmentedChain K C (q + 2)))
      exact ModuleCat.isZero_of_iff_subsingleton.mpr hsubNext
    have hHomology : Module.finrank K (A.homology (q + 1)) = 1 := by
      have hh := hall ∅ C.empty_mem (q + 1)
      rw [if_pos (by simp)] at hh
      exact (SimplicialSphereAnisotropicity.Topology.faceHomologyFinrank_congr K
        (SimplicialSphereAnisotropicity.Topology.link_empty C) (q + 1)).symm.trans hh
    have hker : Module.finrank K
        (LinearMap.ker (faceBoundary K C q)) = 1 := by
      have heq := SimplicialSphereAnisotropicity.Topology.finrank_homology_eq_finrank_ker_of_next_X_zero
        K A (q + 1) (by omega) hXNext
      have heq' : Module.finrank K (A.homology (q + 1)) =
          Module.finrank K (LinearMap.ker (A.d (q + 1) q).hom) := by
        simpa using heq
      have heq'' : Module.finrank K (A.homology (q + 1)) =
          Module.finrank K (LinearMap.ker (faceBoundary K C q)) := by
        dsimp [A] at heq' ⊢
        rw [faceChainComplex_d] at heq'
        exact heq'
      exact heq''.symm.trans hHomology
    have hle := LinearMap.finrank_le_finrank_of_injective hpair
    have hdomain : Module.finrank K (K × K) = 2 := by simp
    rw [hdomain, hker] at hle
    omega

theorem isAugmentedPseudomanifold_of_allLinkHomologySphere
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : SimplicialSphereAnisotropicity.Topology.FacesBoundedBy C d)
    (hall : SimplicialSphereAnisotropicity.Topology.IsAllLinkHomologySphere K C d) :
    IsAugmentedPseudomanifold C d where
  pure := fun hF ↦
    SimplicialSphereAnisotropicity.Topology.pure_of_allLinkHomologySphere K C d hbound hall hF
  ridge_two := fun hR hridge ↦
    SimplicialSphereAnisotropicity.Topology.ridge_two_of_allLinkHomologySphere
      K C d hbound hall hR hridge
  facet_connected := facet_connected_of_allLinkHomologySphere K C d hbound hall

theorem allLinks_isAugmentedPseudomanifold
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : SimplicialSphereAnisotropicity.Topology.FacesBoundedBy C d)
    (hall : SimplicialSphereAnisotropicity.Topology.IsAllLinkHomologySphere K C d)
    (F : Finset V) (hF : F ∈ C) (s : ℕ) (hds : F.card + s = d) :
    IsAugmentedPseudomanifold (C.link F hF) s := by
  apply isAugmentedPseudomanifold_of_allLinkHomologySphere K
  · intro G hG
    have hle := hbound (F ∪ G) hG.2
    rw [Finset.card_union_of_disjoint hG.1] at hle
    omega
  · exact SimplicialSphereAnisotropicity.Topology.allLinkHomologySphere_link
      K C d hall F hF s hds

def facetOfCardEquivAugmented
    (D : AbstractSimplicialComplex V) (d : ℕ) (hd : 0 < d) :
    FacetOfCard D d ≃ AugmentedFacetOfCard (AugmentedComplex.ofAbstract D) d where
  toFun F := ⟨F.1, Or.inr F.2.1, F.2.2⟩
  invFun F := by
    have hne : F.1.Nonempty := Finset.card_pos.mp (by rw [F.2.2]; exact hd)
    exact ⟨F.1,
      (AugmentedComplex.nonempty_mem_ofAbstract_iff D hne).mp F.2.1,
      F.2.2⟩
  left_inv F := by apply Subtype.ext; rfl
  right_inv F := by apply Subtype.ext; rfl

omit [DecidableEq V] in
theorem isPseudomanifold_of_augmented
    [Finite V] (D : AbstractSimplicialComplex V) (d : ℕ) (hd : 2 ≤ d)
    (haug : IsAugmentedPseudomanifold (AugmentedComplex.ofAbstract D) d) :
    IsPseudomanifold D d where
  pure := by
    intro F hF
    obtain ⟨G, hG, hFG, hGcard⟩ := haug.pure (Or.inr hF)
    have hGne : G.Nonempty := Finset.card_pos.mp (by omega)
    exact ⟨G,
      (AugmentedComplex.nonempty_mem_ofAbstract_iff D hGne).mp hG,
      hFG, hGcard⟩
  ridge_two := by
    intro R hR hridge
    have haugCount := haug.ridge_two (Or.inr hR) hridge
    have hsets :
        {F : Finset V | F ∈ AugmentedComplex.ofAbstract D ∧
          F.card = d ∧ R ⊆ F} =
        {F : Finset V | F ∈ D ∧ F.card = d ∧ R ⊆ F} := by
      ext F
      constructor
      · rintro ⟨hF, hFcard, hRF⟩
        have hFne : F.Nonempty := Finset.card_pos.mp (by omega)
        exact ⟨(AugmentedComplex.nonempty_mem_ofAbstract_iff D hFne).mp hF,
          hFcard, hRF⟩
      · rintro ⟨hF, hFcard, hRF⟩
        exact ⟨Or.inr hF, hFcard, hRF⟩
    rw [hsets] at haugCount
    exact haugCount
  facet_connected := by
    intro F G
    let e := facetOfCardEquivAugmented D d (by omega)
    have hpath := haug.facet_connected (e F) (e G)
    have hadj : ∀ A B,
        AugmentedFacetAdjacent (AugmentedComplex.ofAbstract D) d A B →
          FacetAdjacent D d (e.symm A) (e.symm B) := by
      rintro A B ⟨R, hR, hRcard, hRA, hRB⟩
      have hRne : R.Nonempty := Finset.card_pos.mp (by omega)
      exact ⟨R,
        (AugmentedComplex.nonempty_mem_ofAbstract_iff D hRne).mp hR,
        hRcard, hRA, hRB⟩
    simpa only [Function.onFun, Equiv.symm_apply_apply] using
      hpath.lift e.symm hadj

theorem simplicialSphere_facesBoundedBy
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    SimplicialSphereAnisotropicity.Topology.FacesBoundedBy
      (AugmentedComplex.ofAbstract D) (n + 1) := by
  intro F hF
  rcases hF with rfl | hF
  · simp
  · exact hD.1.1 F hF

theorem simplicialSphere_isAugmentedPseudomanifold
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    IsAugmentedPseudomanifold (AugmentedComplex.ofAbstract D) (n + 1) :=
  isAugmentedPseudomanifold_of_allLinkHomologySphere K
    (AugmentedComplex.ofAbstract D) (n + 1)
    (simplicialSphere_facesBoundedBy D hD)
    (SimplicialSphereAnisotropicity.Topology.simplicialSphere_allLinkHomologySphere K D hD)

theorem simplicialSphere_isPseudomanifold
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (hn : 1 ≤ n)
    (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    IsPseudomanifold D (n + 1) :=
  isPseudomanifold_of_augmented D (n + 1) (by omega)
    (simplicialSphere_isAugmentedPseudomanifold K D hD)

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# The top kernel of the face resolution

The all-facet chain is a cycle.  In every face-support strand its projection
is nonzero and spans the one-dimensional top kernel.  Allowed monomial
exponents are then assembled into an injective source whose range is exactly
the kernel of the top face-resolution boundary.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V] [Finite V]

/-- The all-ones chain on the top faces is a cycle. -/
theorem allTopFacesChain_cycle
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1)) :
    faceBoundary K C q
      (facetIndicatorChain K C (q + 1) (fun _ ↦ True)) = 0 := by
  classical
  obtain ⟨G, hG, -, hGcard⟩ :=
    pure_of_allLinkHomologySphere K C (q + 1) hbound hall C.empty_mem
  let F₀ : AugmentedFacetOfCard C (q + 1) := ⟨G, hG, hGcard⟩
  have hcycle := facetComponentChain_cycle K C q hbound hall F₀
  have hchain :
      facetIndicatorChain K C (q + 1)
          (fun F ↦ Relation.ReflTransGen
            (AugmentedFacetAdjacent C (q + 1)) F₀ F) =
        facetIndicatorChain K C (q + 1) (fun _ ↦ True) := by
    apply Finsupp.ext
    intro F
    have hreach := facet_connected_of_allLinkHomologySphere
      K C (q + 1) hbound hall F₀ F
    simp [facetIndicatorChain_apply, hreach]
  rw [hchain] at hcycle
  exact hcycle

/-- Projection of the all-ones top-face chain to faces containing `H`. -/
def relativeAllTopFacesChain
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (H : Finset V) (d : ℕ) :
    RelativeChain K C H d :=
  relativeProjectionDegree K C H d
    (facetIndicatorChain K C d (fun _ ↦ True))

@[simp]
theorem relativeAllTopFacesChain_apply
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (H : Finset V) (d : ℕ)
    (G : ContainingSimplex C H d) :
    relativeAllTopFacesChain K C H d G = 1 := by
  classical
  rw [relativeAllTopFacesChain, facetIndicatorChain, map_sum,
    Finsupp.finsetSum_apply]
  rw [Finset.sum_eq_single G.1]
  · simp [relativeProjectionDegree_single, relativeProjectOnSimplex, G.2]
  · intro F _ hFG
    by_cases hH : H ⊆ F.1
    · have hne : (⟨F, hH⟩ : ContainingSimplex C H d) ≠ G := by
        intro h
        exact hFG (congrArg (fun Z : ContainingSimplex C H d ↦ Z.1) h)
      simp [relativeProjectionDegree_single, relativeProjectOnSimplex,
        hH, hne]
    · simp [relativeProjectionDegree_single, relativeProjectOnSimplex, hH]
  · simp

/-- Every relative projection of the all-ones top chain is a cycle. -/
theorem relativeAllTopFacesChain_cycle
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1))
    (H : Finset V) :
    relativeBoundary K C H q
      (relativeAllTopFacesChain K C H (q + 1)) = 0 := by
  have hcomm := LinearMap.congr_fun
    (relativeProjection_boundary K C H q)
    (facetIndicatorChain K C (q + 1) (fun _ ↦ True))
  simp only [LinearMap.comp_apply] at hcomm
  rw [allTopFacesChain_cycle K C q hbound hall,
    map_zero] at hcomm
  simpa [relativeAllTopFacesChain] using hcomm.symm

omit [Finite V] in
/-- At the top nonempty link degree, the outgoing link-boundary kernel has
dimension one. -/
theorem link_top_boundary_ker_finrank
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (hH : H ∈ C) (s : ℕ)
    (hsum : H.card + (s + 1) = d) :
    Module.finrank K
      (LinearMap.ker (faceBoundary K (C.link H hH) s)) = 1 := by
  let L := C.link H hH
  let A := faceChainComplex K L
  have hempty : IsEmpty (AugmentedSimplex L (s + 2)) := by
    constructor
    intro G
    have hle := hbound (H ∪ G.1) G.2.1.2
    rw [Finset.card_union_of_disjoint G.2.1.1, G.2.2] at hle
    omega
  let hsub : Subsingleton (AugmentedChain K L (s + 2)) :=
    ⟨fun x y ↦ Finsupp.ext fun i ↦ (hempty.false i).elim⟩
  have hX : IsZero (A.X (s + 2)) := by
    change IsZero (ModuleCat.of K (AugmentedChain K L (s + 2)))
    exact ModuleCat.isZero_of_iff_subsingleton.mpr hsub
  have heq := finrank_homology_eq_finrank_ker_of_next_X_zero
    K A (s + 1) (by omega) hX
  have hhom : Module.finrank K (A.homology (s + 1)) = 1 := by
    dsimp [A, L]
    simpa [hsum] using hall H hH (s + 1)
  have heq' : Module.finrank K (A.homology (s + 1)) =
      Module.finrank K (LinearMap.ker (A.d (s + 1) s).hom) := by
    simpa using heq
  have heq'' : Module.finrank K (A.homology (s + 1)) =
      Module.finrank K
        (LinearMap.ker (faceBoundary K (C.link H hH) s)) := by
    dsimp [A, L] at heq' ⊢
    rw [faceChainComplex_d] at heq'
    exact heq'
  exact heq''.symm.trans hhom

/-- The kernel of a relative boundary in positive link degree is linearly
equivalent to the corresponding link-boundary kernel. -/
noncomputable def relativeBoundaryKerEquivLink
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (H : Finset V) (hH : H ∈ C) (s : ℕ) :
    LinearMap.ker (relativeBoundary K C H (H.card + s)) ≃ₗ[K]
      LinearMap.ker (faceBoundary K (C.link H hH) s) where
  toFun z := ⟨relativeDegreeEquivLink K C H hH (s + 1) z.1, by
    have hcomm := LinearMap.congr_fun
      (relativeDegreeEquivLink_boundary K C H hH s) z.1
    simpa [z.2] using hcomm.symm⟩
  invFun z := ⟨(relativeDegreeEquivLink K C H hH (s + 1)).symm z.1, by
    apply (relativeDegreeEquivLink K C H hH s).injective
    have hcomm := LinearMap.congr_fun
      (relativeDegreeEquivLink_boundary K C H hH s)
      ((relativeDegreeEquivLink K C H hH (s + 1)).symm z.1)
    simpa [z.2] using hcomm⟩
  left_inv z := by ext; simp
  right_inv z := by ext; simp
  map_add' x y := by ext; simp
  map_smul' a x := by ext; simp

omit [Finite V] in
/-- The relative top kernel has dimension one when the link top degree is
positive. -/
theorem relative_top_boundary_ker_finrank_positive
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (hH : H ∈ C) (s : ℕ)
    (hsum : H.card + (s + 1) = d) :
    Module.finrank K
      (LinearMap.ker (relativeBoundary K C H (H.card + s))) = 1 := by
  exact (relativeBoundaryKerEquivLink K C H hH s).finrank_eq.trans
    (link_top_boundary_ker_finrank K C d hbound hall H hH s hsum)

/-- The relative all-ones top chain is nonzero for every face support. -/
theorem relativeAllTopFacesChain_ne_zero
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (hH : H ∈ C) :
    relativeAllTopFacesChain K C H d ≠ 0 := by
  obtain ⟨G, hG, hHG, hGcard⟩ :=
    pure_of_allLinkHomologySphere K C d hbound hall hH
  let Z : ContainingSimplex C H d := ⟨⟨G, hG, hGcard⟩, hHG⟩
  intro hzero
  have hz := congrArg (fun z : RelativeChain K C H d ↦ z Z) hzero
  simp [Z] at hz

/-- The relative all-ones top chain belongs to the top kernel. -/
theorem relativeAllTopFacesChain_mem_ker
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1))
    (H : Finset V) :
    relativeAllTopFacesChain K C H (q + 1) ∈
      LinearMap.ker (relativeBoundary K C H q) := by
  rw [LinearMap.mem_ker]
  exact relativeAllTopFacesChain_cycle K C q hbound hall H

/-- The top relative-boundary kernel has dimension one, including the seam
where the support itself is a facet and its link top degree is zero. -/
theorem relative_top_boundary_ker_finrank
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1))
    (H : Finset V) (hH : H ∈ C) :
    Module.finrank K
      (LinearMap.ker (relativeBoundary K C H q)) = 1 := by
  have hle : H.card ≤ q + 1 := hbound H hH
  by_cases hcard : H.card = q + 1
  · have hempty : IsEmpty (ContainingSimplex C H q) :=
      isEmpty_containingSimplex_of_lt C H q (by omega)
    let hsub : Subsingleton (RelativeChain K C H q) :=
      ⟨fun x y ↦ Finsupp.ext fun i ↦ (hempty.false i).elim⟩
    have hout : relativeBoundary K C H q = 0 := by
      apply LinearMap.ext
      intro z
      exact @Subsingleton.elim _ hsub _ _
    have hker : LinearMap.ker (relativeBoundary K C H q) = ⊤ := by
      rw [hout, LinearMap.ker_zero]
    let G₀ : ContainingSimplex C H (q + 1) :=
      ⟨⟨H, hH, hcard⟩, Finset.Subset.rfl⟩
    have hcardContaining : Fintype.card (ContainingSimplex C H (q + 1)) = 1 := by
      apply Fintype.card_eq_one_of_forall_eq (i := G₀)
      intro G
      apply Subtype.ext
      apply Subtype.ext
      symm
      exact Finset.eq_of_subset_of_card_le G.2 (by
        rw [G.1.2.2, hcard])
    rw [hker, finrank_top, Module.finrank_finsupp_self,
      hcardContaining]
  · have hlt : H.card < q + 1 := lt_of_le_of_ne hle hcard
    let r := q + 1 - H.card
    have hrpos : 0 < r := by dsimp [r]; omega
    obtain ⟨s, hs⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hrpos)
    have hsum : H.card + (s + 1) = q + 1 := by
      dsimp [r] at hs
      omega
    have hq : q = H.card + s := by omega
    rw [hq]
    exact relative_top_boundary_ker_finrank_positive
      K C (q + 1) hbound hall H hH s hsum

/-- The relative all-ones chain spans the whole top kernel. -/
theorem relative_top_boundary_ker_eq_span
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1))
    (H : Finset V) (hH : H ∈ C) :
    LinearMap.ker (relativeBoundary K C H q) =
      K ∙ relativeAllTopFacesChain K C H (q + 1) := by
  apply eq_span_singleton_of_mem_of_finrank_eq_one
    (relative_top_boundary_ker_finrank K C q hbound hall H hH)
    (relativeAllTopFacesChain_mem_ker K C q hbound hall H)
    (relativeAllTopFacesChain_ne_zero K C (q + 1) hbound hall H hH)

end SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

open SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V] [Finite V]

/-- Ambient monomial exponents whose support is an augmented face. -/
abbrev AllowedExponent (C : AugmentedComplex V) :=
  { α : V →₀ ℕ // α.support ∈ C }

/-- The monomial-vector-space model of the augmented face ring. -/
abbrev FaceRingModel (K : Type v) [Field K] (C : AugmentedComplex V) :=
  AllowedExponent C →₀ K

/-- In exponent coordinates, an allowed monomial restricts with coefficient
one to every face containing its support. -/
def faceResolutionByExponentSourceOnExponent
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ) (a : AllowedExponent C) :
    FaceResolutionByExponent K C d :=
  DFinsupp.single a.1
    (relativeAllTopFacesChain K C a.1.support d)

/-- The exponentwise source from allowed face-ring monomials. -/
def faceResolutionByExponentSource
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ) :
    FaceRingModel K C →ₗ[K] FaceResolutionByExponent K C d :=
  Finsupp.linearCombination K
    (faceResolutionByExponentSourceOnExponent K C d)

@[simp]
theorem faceResolutionByExponentSource_single
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ) (a : AllowedExponent C) (c : K) :
    faceResolutionByExponentSource K C d (Finsupp.single a c) =
      c • faceResolutionByExponentSourceOnExponent K C d a := by
  exact Finsupp.linearCombination_single K c a

/-- In an allowed exponent strand, the source is the input coefficient times
the relative all-ones top chain. -/
theorem faceResolutionByExponentSource_apply_allowed
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ)
    (z : FaceRingModel K C) (a : AllowedExponent C) :
    faceResolutionByExponentSource K C d z a.1 =
      z a • relativeAllTopFacesChain K C a.1.support d := by
  classical
  change (DFinsupp.lapply (R := K)
      (M := fun α : V →₀ ℕ ↦ RelativeChain K C α.support d) a.1)
      (faceResolutionByExponentSource K C d z) = _
  rw [faceResolutionByExponentSource,
    Finsupp.apply_linearCombination]
  have hfamily :
      (DFinsupp.lapply (R := K)
          (M := fun α : V →₀ ℕ ↦ RelativeChain K C α.support d) a.1) ∘
          faceResolutionByExponentSourceOnExponent K C d =
        Pi.single a (relativeAllTopFacesChain K C a.1.support d) := by
    funext b
    by_cases hba : b = a
    · subst b
      simp [faceResolutionByExponentSourceOnExponent]
    · have hval : a.1 ≠ b.1 := fun h ↦ hba (Subtype.ext h.symm)
      rw [Function.comp_apply, faceResolutionByExponentSourceOnExponent,
        DFinsupp.lapply_apply, DFinsupp.single_eq_of_ne hval,
        Pi.single_eq_of_ne hba]
  rw [hfamily, Finsupp.linearCombination_single_index]

/-- The exponentwise source is injective because every allowed support is
contained in a top face. -/
theorem faceResolutionByExponentSource_injective
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d) :
    Function.Injective (faceResolutionByExponentSource K C d) := by
  intro x y hxy
  apply Finsupp.ext
  intro a
  obtain ⟨G, hG, hGa, hGcard⟩ :=
    pure_of_allLinkHomologySphere K C d hbound hall a.2
  let Z : ContainingSimplex C a.1.support d :=
    ⟨⟨G, hG, hGcard⟩, hGa⟩
  have hcoord := congrArg
    (fun z : FaceResolutionByExponent K C d ↦ z a.1 Z) hxy
  rw [faceResolutionByExponentSource_apply_allowed,
    faceResolutionByExponentSource_apply_allowed,
    Finsupp.smul_apply, Finsupp.smul_apply,
    relativeAllTopFacesChain_apply, smul_eq_mul, smul_eq_mul,
    mul_one, mul_one] at hcoord
  exact hcoord

/-- The exponentwise source has range exactly the top componentwise kernel. -/
theorem faceResolutionByExponentSource_range_eq_ker
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1)) :
    LinearMap.range (faceResolutionByExponentSource K C (q + 1)) =
      LinearMap.ker (faceResolutionByExponentBoundary K C q) := by
  classical
  apply le_antisymm
  · rintro z ⟨c, rfl⟩
    rw [LinearMap.mem_ker]
    apply DFinsupp.ext
    intro α
    rw [faceResolutionByExponentBoundary_apply]
    apply Finsupp.ext
    intro G
    have hface : α.support ∈ C := C.down_closed G.1.2.1 G.2
    let a : AllowedExponent C := ⟨α, hface⟩
    have hsource := faceResolutionByExponentSource_apply_allowed
      K C (q + 1) c a
    change faceResolutionByExponentSource K C (q + 1) c α = _ at hsource
    rw [hsource, map_smul,
      relativeAllTopFacesChain_cycle K C q hbound hall,
      smul_zero]
    rfl
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    have hexists (a : AllowedExponent C) :
        Nonempty (ContainingSimplex C a.1.support (q + 1)) := by
      obtain ⟨G, hG, hGa, hGcard⟩ :=
        pure_of_allLinkHomologySphere K C (q + 1) hbound hall a.2
      exact ⟨⟨⟨G, hG, hGcard⟩, hGa⟩⟩
    let chosen : ∀ a : AllowedExponent C,
        ContainingSimplex C a.1.support (q + 1) :=
      fun a ↦ Classical.choice (hexists a)
    let coeff : AllowedExponent C → K :=
      fun a ↦ z a.1 (chosen a)
    have hcoeffFinite : Function.support coeff |>.Finite := by
      have hpre : ((fun a : AllowedExponent C ↦ a.1) ⁻¹'
          (↑z.support : Set (V →₀ ℕ))).Finite :=
        Set.Finite.preimage_embedding
          ⟨(fun a : AllowedExponent C ↦ a.1), Subtype.val_injective⟩
          z.support.finite_toSet
      apply hpre.subset
      intro a ha
      change coeff a ≠ 0 at ha
      change a.1 ∈ z.support
      rw [DFinsupp.mem_support_iff]
      intro hzero
      apply ha
      dsimp [coeff]
      rw [hzero]
      rfl
    let c : FaceRingModel K C :=
      Finsupp.ofSupportFinite coeff hcoeffFinite
    refine ⟨c, ?_⟩
    apply DFinsupp.ext
    intro α
    apply Finsupp.ext
    intro G
    have hface : α.support ∈ C := C.down_closed G.1.2.1 G.2
    let a : AllowedExponent C := ⟨α, hface⟩
    have hcycle : z α ∈
        LinearMap.ker (relativeBoundary K C α.support q) := by
      rw [LinearMap.mem_ker]
      have hcoord := congrArg
        (fun w : FaceResolutionByExponent K C q ↦ w α) hz
      simpa using hcoord
    have hspan : z α ∈
        K ∙ relativeAllTopFacesChain K C α.support (q + 1) := by
      rw [← relative_top_boundary_ker_eq_span
        K C q hbound hall α.support hface]
      exact hcycle
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hspan
    have hchosen := congrArg
      (fun w : RelativeChain K C α.support (q + 1) ↦ w (chosen a)) hr
    have hG := congrArg
      (fun w : RelativeChain K C α.support (q + 1) ↦ w G) hr
    simp only [Finsupp.smul_apply, relativeAllTopFacesChain_apply,
      smul_eq_mul, mul_one] at hchosen hG
    have hsource := faceResolutionByExponentSource_apply_allowed
      K C (q + 1) c a
    change faceResolutionByExponentSource K C (q + 1) c α = _ at hsource
    rw [hsource, Finsupp.smul_apply, relativeAllTopFacesChain_apply,
      smul_eq_mul, mul_one]
    change c a = z α G
    have hc : c a = coeff a := by
      change (Finsupp.ofSupportFinite coeff hcoeffFinite :
        AllowedExponent C →₀ K) a = coeff a
      rw [Finsupp.ofSupportFinite_coe]
    rw [hc]
    exact hchosen.symm.trans hG

/-- Restriction of an allowed face-ring monomial to all faces of cardinality
`d`, transported back from the exponent decomposition. -/
def faceResolutionSource
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ) :
    FaceRingModel K C →ₗ[K] FaceResolutionTerm K C d :=
  (faceResolutionByExponentEquiv K C d).symm.toLinearMap.comp
    (faceResolutionByExponentSource K C d)

@[simp]
theorem faceResolutionByExponentEquiv_source
    (K : Type v) [Field K]
    (C : AugmentedComplex V) (d : ℕ) (z : FaceRingModel K C) :
    faceResolutionByExponentEquiv K C d
        (faceResolutionSource K C d z) =
      faceResolutionByExponentSource K C d z := by
  simp [faceResolutionSource]

/-- The concrete face-resolution source is injective. -/
theorem faceResolutionSource_injective
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d) :
    Function.Injective (faceResolutionSource K C d) := by
  intro x y hxy
  apply faceResolutionByExponentSource_injective
    K C d hbound hall
  have hcoord := congrArg
    (faceResolutionByExponentEquiv K C d) hxy
  simpa using hcoord

/-- The concrete source range is the kernel of the top face-resolution
boundary. -/
theorem faceResolutionSource_range_eq_ker
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hbound : FacesBoundedBy C (q + 1))
    (hall : IsAllLinkHomologySphere K C (q + 1)) :
    LinearMap.range (faceResolutionSource K C (q + 1)) =
      LinearMap.ker (faceResolutionBoundary K C q) := by
  have hrange := faceResolutionByExponentSource_range_eq_ker
    K C q hbound hall
  apply le_antisymm
  · rintro z ⟨c, rfl⟩
    rw [LinearMap.mem_ker]
    apply (faceResolutionByExponentEquiv K C q).injective
    have hcomm := LinearMap.congr_fun
      (faceResolutionByExponentEquiv_boundary K C q)
      (faceResolutionSource K C (q + 1) c)
    have hzero : faceResolutionByExponentBoundary K C q
        (faceResolutionByExponentSource K C (q + 1) c) = 0 := by
      rw [← LinearMap.mem_ker, ← hrange]
      exact ⟨c, rfl⟩
    simpa [hzero] using hcomm
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    have hcomm := LinearMap.congr_fun
      (faceResolutionByExponentEquiv_boundary K C q) z
    have hcycle : faceResolutionByExponentEquiv K C (q + 1) z ∈
        LinearMap.ker (faceResolutionByExponentBoundary K C q) := by
      rw [LinearMap.mem_ker]
      simpa [hz] using hcomm.symm
    rw [← hrange] at hcycle
    obtain ⟨c, hc⟩ := hcycle
    refine ⟨c, ?_⟩
    apply (faceResolutionByExponentEquiv K C (q + 1)).injective
    simpa using hc

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

section

/-!
# Parameter-linear face-resolution modules

The monomial face resolution is identified with the finite product of the
polynomial coordinate rings of its faces.  In those coordinates its boundary
is parameter-linear.  Conjugacy with the established monomial boundary
transports exactness, and dimension shifting gives the sharp strict bound for
every boundary kernel.
-/

noncomputable section

open CategoryTheory
open SimplicialSphereAnisotropicity.Simplicial
open SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

def faceMonomialIndexEquivSigma
    {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (q : ℕ) :
    FaceMonomialIndex C q ≃
      Σ F : AugmentedSimplex C q, (↑F.1 →₀ ℕ) where
  toFun I := ⟨I.face,
    I.exponent.comapDomain Subtype.val Subtype.val_injective.injOn⟩
  invFun I :=
    { face := I.1
      exponent := I.2.mapDomain Subtype.val
      support_subset := by
        intro x hx
        by_contra hxF
        have hnot : x ∉ Set.range (fun y : ↑I.1.1 ↦ y.1) := by
          rintro ⟨y, rfl⟩
          exact hxF y.2
        exact (Finsupp.mem_support_iff.mp hx)
          (Finsupp.mapDomain_of_notMem_range I.2 x hnot) }
  left_inv I := by
    apply FaceMonomialIndex.ext
    · rfl
    · apply Finsupp.mapDomain_comapDomain Subtype.val
        Subtype.val_injective I.exponent
      intro x hx
      exact ⟨⟨x, I.support_subset hx⟩, rfl⟩
  right_inv I := by
    exact Sigma.ext rfl (heq_of_eq
      (Finsupp.comapDomain_mapDomain Subtype.val
        Subtype.val_injective I.2))

abbrev FaceCoordinateTerm
    (k : Type u) [Field k] {n m : ℕ}
    (C : AugmentedComplex (Fin m)) (q : ℕ) :=
  ∀ F : AugmentedSimplex C q,
    MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)

noncomputable def localExponentLEquivPolynomial
    (K : Type u) [Field K] (sigma : Type*) :
    ((sigma →₀ ℕ) →₀ K) ≃ₗ[K] MvPolynomial sigma K :=
  (AddMonoidAlgebra.coeffLinearEquiv K).symm

@[instance_reducible]
noncomputable def faceCoordinateModule
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) :
    Module (Generic.ParameterRing k n m)
      (MvPolynomial ↑F (SimplicialSphereAnisotropicity.GenericField k n m)) := by
  letI : Algebra (Generic.ParameterRing k n m)
      (MvPolynomial ↑F (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    Generic.faceParameterAlgebra k (n := n) (m := m) F
  infer_instance

@[instance_reducible]
noncomputable def faceCoordinateTermModule
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    Module (Generic.ParameterRing k n m)
      (FaceCoordinateTerm k (n := n) (m := m) C q) := by
  letI : ∀ F : AugmentedSimplex C q,
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun F ↦ faceCoordinateModule k F.1
  infer_instance

noncomputable def faceResolutionTermEquivCoordinate
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    FaceResolutionTerm (SimplicialSphereAnisotropicity.GenericField k n m) C q ≃ₗ[
        SimplicialSphereAnisotropicity.GenericField k n m]
      FaceCoordinateTerm k (n := n) (m := m) C q := by
  exact (
    (Finsupp.domLCongr
        (R := SimplicialSphereAnisotropicity.GenericField k n m)
        (faceMonomialIndexEquivSigma C q)).trans
      (Finsupp.sigmaFinsuppLEquivPiFinsupp
        (SimplicialSphereAnisotropicity.GenericField k n m))).trans
    (LinearEquiv.piCongrRight (fun F : AugmentedSimplex C q ↦
      localExponentLEquivPolynomial
        (SimplicialSphereAnisotropicity.GenericField k n m) ↑F.1))

theorem eraseSimplex_subset
    {V : Type*} [DecidableEq V] {C : AugmentedComplex V} {q : ℕ}
    (F : AugmentedSimplex C (q + 1)) (x : ↑F.1) :
    (eraseSimplex C F x).1 ⊆ F.1 := by
  simpa only [eraseSimplex_val] using Finset.erase_subset x.1 F.1

@[simp]
theorem faceResolutionTermEquivCoordinate_apply_coeff
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceResolutionTerm (SimplicialSphereAnisotropicity.GenericField k n m) C q)
    (F : AugmentedSimplex C q) (α : ↑F.1 →₀ ℕ) :
    (faceResolutionTermEquivCoordinate k C z F).coeff α =
      z ((faceMonomialIndexEquivSigma C q).symm ⟨F, α⟩) := by
  rfl

@[simp]
theorem faceResolutionTermEquivCoordinate_single
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (I : FaceMonomialIndex C q) (a : SimplicialSphereAnisotropicity.GenericField k n m) :
    faceResolutionTermEquivCoordinate k C (Finsupp.single I a) =
      Pi.single I.face
        (MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn) a) := by
  classical
  ext F α
  rw [faceResolutionTermEquivCoordinate_apply_coeff]
  rw [Finsupp.single_apply]
  by_cases hidx :
      I = (faceMonomialIndexEquivSigma C q).symm ⟨F, α⟩
  · rw [if_pos hidx]
    have hpair :
        (⟨F, α⟩ : Σ G : AugmentedSimplex C q, (↑G.1 →₀ ℕ)) =
          faceMonomialIndexEquivSigma C q I := by
      simpa using congrArg (faceMonomialIndexEquivSigma C q) hidx.symm
    cases hpair
    simp
  · rw [if_neg hidx]
    by_cases hF : F = I.face
    · subst F
      simp only [Pi.single_eq_same, MvPolynomial.coeff_monomial]
      rw [if_neg]
      intro hα
      subst α
      apply hidx
      change I = (faceMonomialIndexEquivSigma C q).symm
        (faceMonomialIndexEquivSigma C q I)
      exact ((faceMonomialIndexEquivSigma C q).symm_apply_apply I).symm
    · simp [hF]

set_option linter.style.haveILetI false in
theorem faceCoordinateTerm_hasProjectiveDimensionLT
    (k : Type u) [Field k] {n m d q : ℕ}
    (C : AugmentedComplex (Fin m))
    (hpure : ∀ {F : Finset (Fin m)}, F ∈ C →
      ∃ G : Finset (Fin m), G ∈ C ∧ F ⊆ G ∧ G.card = d)
    (hd : d = n + 1)
    (hq : q ≤ d) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    HasProjectiveDimensionLT
      (ModuleCat.of (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q))
      (d - q + 1) := by
  classical
  letI : ∀ F : AugmentedSimplex C q,
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun F ↦ faceCoordinateModule k F.1
  refine SimplicialSphereAnisotropicity.Algebra.hasProjectiveDimensionLT_pi
    (R := Generic.ParameterRing k n m)
    (M := fun F : AugmentedSimplex C q ↦
      MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m))
    (d - q + 1) ?_
  intro F
  obtain ⟨G, hGC, hFG, hGcard⟩ := hpure F.2.1
  have hFcard : F.1.card = q := F.2.2
  have hbound := Generic.faceCoordinate_hasProjectiveDimensionLT
    k F.1 G hFG (by omega : G.card = n + 1)
  let _ : HasProjectiveDimensionLT
      (ModuleCat.of (Generic.ParameterRing k n m)
        (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)))
      (n + 1 - F.1.card + 1) := hbound
  exact hasProjectiveDimensionLT_of_ge
    (ModuleCat.of (Generic.ParameterRing k n m)
      (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)))
    (n + 1 - F.1.card + 1) (d - q + 1) (by omega)

noncomputable def faceCoordinateBoundaryOnFace
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (F : AugmentedSimplex C (q + 1)) :
    MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m) →ₗ[
        Generic.ParameterRing k n m]
      FaceCoordinateTerm k (n := n) (m := m) C q := by
  classical
  letI : ∀ G : AugmentedSimplex C q,
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑G.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun G ↦ faceCoordinateModule k G.1
  letI : Module (Generic.ParameterRing k n m)
      (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    faceCoordinateModule k F.1
  exact ∑ x : ↑F.1,
    (LinearMap.single (Generic.ParameterRing k n m)
      (fun G : AugmentedSimplex C q ↦
        MvPolynomial ↑G.1 (SimplicialSphereAnisotropicity.GenericField k n m))
      (eraseSimplex C F x)).comp
    (Generic.faceCoordinateRestrictionLinear k
      (eraseSimplex_subset F x))

noncomputable def faceCoordinateBoundary
    (k : Type u) [Field k] {n m : ℕ}
    (C : AugmentedComplex (Fin m)) (q : ℕ) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    FaceCoordinateTerm k (n := n) (m := m) C (q + 1) →ₗ[
        Generic.ParameterRing k n m]
      FaceCoordinateTerm k (n := n) (m := m) C q := by
  classical
  letI : ∀ F : AugmentedSimplex C (q + 1),
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun F ↦ faceCoordinateModule k F.1
  letI : ∀ G : AugmentedSimplex C q,
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑G.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun G ↦ faceCoordinateModule k G.1
  exact ∑ F : AugmentedSimplex C (q + 1),
    (faceCoordinateBoundaryOnFace k C F).comp
      (LinearMap.proj F)

theorem faceCoordinateRestriction_monomial_localExponent
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (I : FaceMonomialIndex C (q + 1)) (x : ↑I.face.1)
    (a : SimplicialSphereAnisotropicity.GenericField k n m) :
    Generic.faceCoordinateRestrictionLinear k
        (eraseSimplex_subset I.face x)
        (MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn) a) =
      if _hx : x.1 ∉ I.exponent.support then
        MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn :
              ↑(eraseSimplex C I.face x).1 →₀ ℕ) a
      else 0 := by
  classical
  rw [Generic.faceCoordinateRestrictionLinear_apply,
    Generic.faceCoordinateRestriction]
  by_cases hx : x.1 ∉ I.exponent.support
  · rw [dif_pos hx,
      MvPolynomial.killCompl_monomial_eq_monomial_comapDomain_of_subset]
    · exact congrArg
        (fun s : ↑(eraseSimplex C I.face x).1 →₀ ℕ ↦
          MvPolynomial.monomial s a) (by
            ext y
            rfl)
    · intro y hy
      refine ⟨⟨y.1, ?_⟩, ?_⟩
      · apply Finset.mem_erase.mpr
        refine ⟨?_, y.2⟩
        intro hyx
        apply hx
        rw [Finsupp.mem_support_iff]
        have hne := Finsupp.mem_support_iff.mp hy
        simpa [hyx] using hne
      · apply Subtype.ext
        rfl
  · rw [dif_neg hx,
      MvPolynomial.killCompl_monomial_eq_zero_of_not_subset]
    intro hsubset
    have hx' : x.1 ∈ I.exponent.support := by simpa using hx
    have hxmem : x ∈
        (I.exponent.comapDomain Subtype.val
          Subtype.val_injective.injOn).support := by
      rw [Finsupp.mem_support_iff]
      simpa only [Finsupp.comapDomain_apply] using
        Finsupp.mem_support_iff.mp hx'
    obtain ⟨y, hy⟩ := hsubset hxmem
    have hval := congrArg Subtype.val hy
    exact (Finset.mem_erase.mp y.2).1 hval

@[simp]
theorem faceCoordinateBoundary_pi_single
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (F : AugmentedSimplex C (q + 1))
    (p : MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    faceCoordinateBoundary k (n := n) (m := m) C q (Pi.single F p) =
      faceCoordinateBoundaryOnFace k C F p := by
  classical
  rw [faceCoordinateBoundary, LinearMap.sum_apply]
  let term : AugmentedSimplex C (q + 1) →
      FaceCoordinateTerm k (n := n) (m := m) C q := fun G ↦
    faceCoordinateBoundaryOnFace k C G
      ((Pi.single F p :
        FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) G)
  have hsum : (∑ G, term G) = term F := by
    apply Fintype.sum_eq_single F
    intro G hGF
    simp [term, hGF]
  simpa [term] using hsum

theorem faceCoordinateBoundaryOnFace_monomial
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (I : FaceMonomialIndex C (q + 1))
    (a : SimplicialSphereAnisotropicity.GenericField k n m) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    faceCoordinateBoundaryOnFace k C I.face
        (MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn) a) =
      ∑ x : ↑I.face.1,
        if _hx : x.1 ∉ I.exponent.support then
          Pi.single (eraseSimplex C I.face x)
            (MvPolynomial.monomial
              (I.exponent.comapDomain Subtype.val
                Subtype.val_injective.injOn :
                  ↑(eraseSimplex C I.face x).1 →₀ ℕ) a)
        else 0 := by
  classical
  rw [faceCoordinateBoundaryOnFace, LinearMap.sum_apply]
  apply Finset.sum_congr rfl
  intro x _
  rw [LinearMap.comp_apply, LinearMap.single_apply,
    faceCoordinateRestriction_monomial_localExponent]
  split_ifs <;> simp

theorem faceResolutionTermEquivCoordinate_boundary_single
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (I : FaceMonomialIndex C (q + 1))
    (a : SimplicialSphereAnisotropicity.GenericField k n m) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    faceResolutionTermEquivCoordinate k C
        (faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C q
          (Finsupp.single I a)) =
      faceCoordinateBoundary k (n := n) (m := m) C q
        (faceResolutionTermEquivCoordinate k C
          (Finsupp.single I a)) := by
  classical
  rw [faceResolutionBoundary_single,
    map_smul,
    faceResolutionBoundaryOnIndex, map_sum,
    faceResolutionTermEquivCoordinate_single,
    faceCoordinateBoundary_pi_single,
    faceCoordinateBoundaryOnFace_monomial]
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : x.1 ∉ I.exponent.support
  · rw [dif_pos hx, dif_pos hx,
      faceResolutionTermEquivCoordinate_single]
    change a • (Pi.single (eraseSimplex C I.face x)
        (MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn :
              ↑(eraseSimplex C I.face x).1 →₀ ℕ) 1) :
          FaceCoordinateTerm k (n := n) (m := m) C q) =
      (Pi.single (eraseSimplex C I.face x)
        (MvPolynomial.monomial
          (I.exponent.comapDomain Subtype.val
            Subtype.val_injective.injOn :
              ↑(eraseSimplex C I.face x).1 →₀ ℕ) a) :
          FaceCoordinateTerm k (n := n) (m := m) C q)
    rw [← Pi.single_smul, MvPolynomial.smul_monomial]
    simp
  · rw [dif_neg hx, dif_neg hx]
    simp

theorem faceResolutionTermEquivCoordinate_boundary
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceResolutionTerm (SimplicialSphereAnisotropicity.GenericField k n m) C (q + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    faceResolutionTermEquivCoordinate k C
        (faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C q z) =
      faceCoordinateBoundary k (n := n) (m := m) C q
        (faceResolutionTermEquivCoordinate k C z) := by
  classical
  induction z using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp [hx, hy]
  | single I a =>
      exact faceResolutionTermEquivCoordinate_boundary_single
        k C I a

theorem faceResolutionTermEquivCoordinate_symm_boundary
    (k : Type u) [Field k] {n m q : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    (faceResolutionTermEquivCoordinate k C).symm
        (faceCoordinateBoundary k (n := n) (m := m) C q z) =
      faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C q
        ((faceResolutionTermEquivCoordinate k C).symm z) := by
  apply (faceResolutionTermEquivCoordinate k C).injective
  rw [faceResolutionTermEquivCoordinate_boundary]
  simp

theorem faceCoordinateBoundary_boundary
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 2)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (q + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C q) :=
      faceCoordinateTermModule k C
    (faceCoordinateBoundary k (n := n) (m := m) C q).comp
      (faceCoordinateBoundary k (n := n) (m := m) C (q + 1)) = 0 := by
  apply LinearMap.ext
  intro z
  apply (faceResolutionTermEquivCoordinate k C).symm.injective
  rw [LinearMap.comp_apply,
    faceResolutionTermEquivCoordinate_symm_boundary,
    faceResolutionTermEquivCoordinate_symm_boundary]
  have hzero := LinearMap.congr_fun
    (faceResolutionBoundary_boundary
      (SimplicialSphereAnisotropicity.GenericField k n m) C q)
    ((faceResolutionTermEquivCoordinate k C).symm z)
  simpa only [LinearMap.comp_apply, LinearMap.zero_apply, map_zero] using hzero

theorem faceCoordinateBoundary_range_eq_ker_below_top
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m)) (d : ℕ)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C d)
    (a : ℕ) (ha : a + 1 < d) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (a + 2)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (a + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C a) :=
      faceCoordinateTermModule k C
    LinearMap.range
        (faceCoordinateBoundary k (n := n) (m := m) C (a + 1)) =
      LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m) C a) := by
  ext z
  constructor
  · rintro ⟨w, rfl⟩
    rw [LinearMap.mem_ker]
    have hzero := LinearMap.congr_fun
      (faceCoordinateBoundary_boundary k C (q := a)) w
    simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using hzero
  · intro hz
    rw [LinearMap.mem_ker] at hz
    have hzold : faceResolutionBoundary
        (SimplicialSphereAnisotropicity.GenericField k n m) C a
        ((faceResolutionTermEquivCoordinate k C).symm z) = 0 := by
      rw [← faceResolutionTermEquivCoordinate_symm_boundary,
        hz, map_zero]
    have hmem :
        (faceResolutionTermEquivCoordinate k C).symm z ∈
          LinearMap.ker
            (faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C a) := by
      exact hzold
    rw [← faceResolutionBoundary_range_eq_ker_below_top
      (SimplicialSphereAnisotropicity.GenericField k n m) C d hall a ha] at hmem
    obtain ⟨w, hw⟩ := hmem
    refine ⟨faceResolutionTermEquivCoordinate k C w, ?_⟩
    apply (faceResolutionTermEquivCoordinate k C).symm.injective
    rw [faceResolutionTermEquivCoordinate_symm_boundary,
      LinearEquiv.symm_apply_apply, hw]

theorem faceCoordinateBoundary_zero_surjective
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m)) (d : ℕ)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C d)
    (hd : 0 < d) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C 1) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C 0) :=
      faceCoordinateTermModule k C
    Function.Surjective
      (faceCoordinateBoundary k (n := n) (m := m) C 0) := by
  intro z
  obtain ⟨w, hw⟩ := faceResolutionBoundary_zero_surjective
    (SimplicialSphereAnisotropicity.GenericField k n m) C d hall hd
    ((faceResolutionTermEquivCoordinate k C).symm z)
  refine ⟨faceResolutionTermEquivCoordinate k C w, ?_⟩
  apply (faceResolutionTermEquivCoordinate k C).symm.injective
  rw [faceResolutionTermEquivCoordinate_symm_boundary,
    LinearEquiv.symm_apply_apply, hw]

set_option linter.style.haveILetI false in
theorem faceCoordinateBoundary_ker_hasProjectiveDimensionLT
    (k : Type u) [Field k] [CharP k 2] {n m d : ℕ}
    (C : AugmentedComplex (Fin m))
    (hpure : ∀ {F : Finset (Fin m)}, F ∈ C →
      ∃ G : Finset (Fin m), G ∈ C ∧ F ⊆ G ∧ G.card = d)
    (hd : d = n + 1)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C d)
    (a : ℕ) (ha : a < d) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (a + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C a) :=
      faceCoordinateTermModule k C
    HasProjectiveDimensionLT
      (ModuleCat.of (Generic.ParameterRing k n m)
        (LinearMap.ker
          (faceCoordinateBoundary k (n := n) (m := m) C a)))
      (d - a) := by
  induction a with
  | zero =>
      have hdpos : 0 < d := by omega
      have hmiddle := faceCoordinateTerm_hasProjectiveDimensionLT
        k C hpure hd (q := 1) (by omega)
      have hright := faceCoordinateTerm_hasProjectiveDimensionLT
        k C hpure hd (q := 0) (by omega)
      have hmiddle' : HasProjectiveDimensionLT
          (ModuleCat.of (Generic.ParameterRing k n m)
            (FaceCoordinateTerm k (n := n) (m := m) C 1))
          (d - 1 + 1) := by
        exact hmiddle
      have hright' : HasProjectiveDimensionLT
          (ModuleCat.of (Generic.ParameterRing k n m)
            (FaceCoordinateTerm k (n := n) (m := m) C 0))
          (d - 1 + 2) := by
        convert hright using 1
        omega
      have hstep := SimplicialSphereAnisotropicity.Algebra.hasProjectiveDimensionLT_kernel_step
        (LinearMap.shortExact_shortComplexKer
          (faceCoordinateBoundary_zero_surjective
            k C d hall hdpos))
        (d - 1) hmiddle' hright'
      convert hstep using 1
      omega
  | succ a ih =>
      have ha' : a < d := by omega
      have hi := ih ha'
      have hterm := faceCoordinateTerm_hasProjectiveDimensionLT
        k C hpure hd (q := a + 2) (by omega)
      have hexact :=
        faceCoordinateBoundary_range_eq_ker_below_top
          k C d hall a (by omega)
      have hterm' : HasProjectiveDimensionLT
          (ModuleCat.of (Generic.ParameterRing k n m)
            (FaceCoordinateTerm k (n := n) (m := m) C (a + 2)))
          (d - (a + 2) + 1) := by
        exact hterm
      have hi' : HasProjectiveDimensionLT
          (ModuleCat.of (Generic.ParameterRing k n m)
            (LinearMap.ker
              (faceCoordinateBoundary k (n := n) (m := m) C a)))
          (d - (a + 2) + 2) := by
        convert hi using 1
        omega
      have hstep :=
        SimplicialSphereAnisotropicity.Algebra.hasProjectiveDimensionLT_ker_of_range_eq_ker
          (faceCoordinateBoundary k (n := n) (m := m) C (a + 1))
          (faceCoordinateBoundary k (n := n) (m := m) C a)
          hexact (d - (a + 2)) hterm' hi'
      convert hstep using 1
      omega

set_option linter.style.haveILetI false in
/-- The top boundary kernel of the parameter-linear face resolution is a
projective module over the parameter polynomial ring. -/
theorem faceCoordinateTopKernel_projective
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hpure : ∀ {F : Finset (Fin m)}, F ∈ C →
      ∃ G : Finset (Fin m), G ∈ C ∧ F ⊆ G ∧ G.card = n + 1)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (n + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C n) :=
      faceCoordinateTermModule k C
    Module.Projective (Generic.ParameterRing k n m)
      (LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m) C n)) := by
  have hpd := faceCoordinateBoundary_ker_hasProjectiveDimensionLT
    k C hpure rfl hall n (by omega)
  have hpd' : HasProjectiveDimensionLT
      (ModuleCat.of (Generic.ParameterRing k n m)
        (LinearMap.ker
          (faceCoordinateBoundary k (n := n) (m := m) C n))) 1 := by
    convert hpd using 1
    omega
  exact SimplicialSphereAnisotropicity.Algebra.moduleProjective_of_hasProjectiveDimensionLT_one
    (R := Generic.ParameterRing k n m)
    (M := LinearMap.ker
      (faceCoordinateBoundary k (n := n) (m := m) C n)) hpd'

end SimplicialSphereAnisotropicity.StanleyReisner

end

