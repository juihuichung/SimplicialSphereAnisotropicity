theorem weightedFreeComponent_succ_eq_zero_of_mem_polynomialVariableSubmoduleK
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ)
    (Q : Submodule (MvPolynomial (Fin d) K)
      (Fin N → MvPolynomial (Fin d) K))
    (q : ℕ)
    (hzero : ∀ x ∈ Q, weightedFreeComponent K r q x = 0)
    {p : Fin N → MvPolynomial (Fin d) K}
    (hp : p ∈ polynomialVariableSubmoduleK K d Q) :
    weightedFreeComponent K r (q + 1) p = 0 := by
  induction hp using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨i, ⟨y, hy⟩⟩, rfl⟩ := hx
      rw [weightedFreeComponent_parameter_X_smul, hzero y hy,
        smul_zero]
  | zero => exact LinearMap.map_zero _
  | add x y hx hy ihx ihy =>
      rw [LinearMap.map_add, ihx, ihy, add_zero]
  | smul c x hx ih =>
      rw [LinearMap.map_smul, ih, smul_zero]

theorem weightedFreeComponent_idempotent
    (K : Type u) [Field K] {sigma : Type*} {N : ℕ}
    (r : Fin N → ℕ) (d : ℕ)
    (p : Fin N → MvPolynomial sigma K) :
    weightedFreeComponent K r d
        (weightedFreeComponent K r d p) =
      weightedFreeComponent K r d p := by
  apply funext
  intro i
  rw [weightedFreeComponent_apply, weightedFreeComponent_apply]
  by_cases hri : r i ≤ d
