theorem matrix_det_isHomogeneous_zero_of_degree_balance
    {K : Type*} [Field K] {s : Type*} {N d : ℕ}
    (G : Matrix (Fin N) (Fin N) (MvPolynomial s K))
    (r : Fin N → ℕ)
    (hhom : ∀ i j, (G i j).IsHomogeneous (r i + r j - d))
    (hzero : ∀ i j, r i + r j < d → G i j = 0)
    (hbalance : 2 * ∑ i, r i = d * N) :
    G.det.IsHomogeneous 0 := by
  rw [Matrix.det_apply']
  apply MvPolynomial.IsHomogeneous.sum Finset.univ _ 0
  intro σ _hσ
  by_cases hall : ∀ i, d ≤ r (σ i) + r i
  · have hdegree : ∑ i, (r (σ i) + r i - d) = 0 := by
      rw [Finset.sum_tsub_distrib Finset.univ
        (fun i _hi ↦ hall i)]
      rw [Finset.sum_add_distrib, Equiv.sum_comp σ r, ← two_mul,
        hbalance]
      simp [Nat.mul_comm]
    have hprod :
        (∏ i, G (σ i) i).IsHomogeneous
          (∑ i, (r (σ i) + r i - d)) := by
      apply MvPolynomial.IsHomogeneous.prod Finset.univ
        (fun i ↦ G (σ i) i)
        (fun i ↦ r (σ i) + r i - d)
      intro i _hi
      exact hhom (σ i) i
    rw [hdegree] at hprod
    change (MvPolynomial.C (((Equiv.Perm.sign σ : ℤ) : K)) *
      ∏ i, G (σ i) i).IsHomogeneous 0
    exact hprod.C_mul _
  · push Not at hall
    obtain ⟨i, hi⟩ := hall
    have hz : ∏ j, G (σ j) j = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      exact hzero (σ i) i hi
    rw [hz, mul_zero]
    exact MvPolynomial.isHomogeneous_zero s K 0

