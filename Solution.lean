/-!
# Augmented finite simplicial complexes

Mathlib's abstract simplicial complexes store only nonempty faces.  This file
adds one conventional empty face and defines the link, costar, and finite
facet types used by the reviewed proof.
-/

namespace SimplicialSphereAnisotropicity.Simplicial

open Finset Set

universe u

/-- A downward-closed face family which explicitly contains the empty face. -/
structure AugmentedComplex (V : Type u) where
  faces : Set (Finset V)
  empty_mem : ∅ ∈ faces
  down_closed : ∀ {F G : Finset V}, F ∈ faces → G ⊆ F → G ∈ faces

namespace AugmentedComplex

instance {V : Type u} : Membership (Finset V) (AugmentedComplex V) :=
  ⟨fun C F ↦ F ∈ C.faces⟩

@[ext]
theorem ext {V : Type u} {C C' : AugmentedComplex V}
    (h : C.faces = C'.faces) : C = C' := by
  cases C
  cases C'
  cases h
  rfl

@[simp]
theorem mem_faces {V : Type u} (C : AugmentedComplex V) (F : Finset V) :
    F ∈ C.faces ↔ F ∈ C := Iff.rfl

@[simp]
theorem empty_mem' {V : Type u} (C : AugmentedComplex V) : ∅ ∈ C :=
  C.empty_mem

/-- Add the conventional empty face to a pre-simplicial complex. -/
def ofPre {V : Type u} (C : PreAbstractSimplicialComplex V) :
    AugmentedComplex V where
  faces := {F | F = ∅ ∨ F ∈ C}
  empty_mem := Or.inl rfl
  down_closed := by
    rintro F G (rfl | hF) hGF
    · exact Or.inl (Finset.subset_empty.mp hGF)
    · by_cases hG : G = ∅
      · exact Or.inl hG
      · exact Or.inr ((C.isRelLowerSet_faces hF).2 hGF
          (Finset.nonempty_iff_ne_empty.mpr hG))

/-- Add the conventional empty face to Mathlib's nonempty-face convention. -/
def ofAbstract {V : Type u} (D : AbstractSimplicialComplex V) :
    AugmentedComplex V where
  faces := {F | F = ∅ ∨ F ∈ D}
  empty_mem := Or.inl rfl
  down_closed := by
    rintro F G (rfl | hF) hGF
    · exact Or.inl (Finset.subset_empty.mp hGF)
    · by_cases hG : G = ∅
      · exact Or.inl hG
      · exact Or.inr ((D.isRelLowerSet_faces hF).2 hGF
          (Finset.nonempty_iff_ne_empty.mpr hG))

@[simp]
theorem mem_ofPre {V : Type u} (C : PreAbstractSimplicialComplex V)
    (F : Finset V) : F ∈ ofPre C ↔ F = ∅ ∨ F ∈ C := Iff.rfl

@[simp]
theorem mem_ofAbstract {V : Type u} (D : AbstractSimplicialComplex V)
    (F : Finset V) : F ∈ ofAbstract D ↔ F = ∅ ∨ F ∈ D := Iff.rfl

theorem nonempty_mem_ofAbstract_iff {V : Type u}
    (D : AbstractSimplicialComplex V) {F : Finset V} (hF : F.Nonempty) :
    F ∈ ofAbstract D ↔ F ∈ D := by
  simp [hF.ne_empty]

/-- The augmented link of `F`, with the same ambient vertex type. -/
def link {V : Type u} [DecidableEq V] (C : AugmentedComplex V)
    (F : Finset V) (hF : F ∈ C) : AugmentedComplex V where
  faces := {G | Disjoint F G ∧ F ∪ G ∈ C}
  empty_mem := by simp [hF]
  down_closed := by
    rintro G H ⟨hdisj, hface⟩ hHG
    exact ⟨hdisj.mono_right hHG,
      C.down_closed hface (Finset.union_subset_union_right hHG)⟩

@[simp]
theorem mem_link {V : Type u} [DecidableEq V]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    (G : Finset V) :
    G ∈ C.link F hF ↔ Disjoint F G ∧ F ∪ G ∈ C := Iff.rfl

/-- The costar of a nonempty set `F`: faces which do not contain all of `F`. -/
def costar {V : Type u} (C : AugmentedComplex V)
    (F : Finset V) (hF : F.Nonempty) : AugmentedComplex V where
  faces := {G | G ∈ C ∧ ¬F ⊆ G}
  empty_mem := ⟨C.empty_mem, fun h ↦ hF.ne_empty (Finset.subset_empty.mp h)⟩
  down_closed := by
    rintro G H ⟨hG, hnG⟩ hHG
    exact ⟨C.down_closed hG hHG, fun hFH ↦ hnG (hFH.trans hHG)⟩

@[simp]
theorem mem_costar {V : Type u} (C : AugmentedComplex V)
    (F : Finset V) (hF : F.Nonempty) (G : Finset V) :
    G ∈ C.costar F hF ↔ G ∈ C ∧ ¬F ⊆ G := Iff.rfl

theorem erase_mem {V : Type u} [DecidableEq V]
    (C : AugmentedComplex V) {F : Finset V} (hF : F ∈ C) (v : V) :
    F.erase v ∈ C :=
  C.down_closed hF (Finset.erase_subset v F)

theorem singleton_mem_of_mem {V : Type u} [DecidableEq V]
    (C : AugmentedComplex V) {F : Finset V} (hF : F ∈ C)
    {v : V} (hv : v ∈ F) : {v} ∈ C :=
  C.down_closed hF (Finset.singleton_subset_iff.mpr hv)

end AugmentedComplex

/-- Purity with facets of a fixed cardinality. -/
def IsPureOfCard {V : Type u} (D : AbstractSimplicialComplex V)
    (d : ℕ) : Prop :=
  ∀ {F : Finset V}, F ∈ D →
    ∃ G : Finset V, G ∈ D ∧ F ⊆ G ∧ G.card = d

abbrev FacetOfCard {V : Type u} (D : AbstractSimplicialComplex V)
    (d : ℕ) :=
  {F : Finset V // F ∈ D ∧ F.card = d}

def FacetAdjacent {V : Type u} (D : AbstractSimplicialComplex V)
    (d : ℕ) (F G : FacetOfCard D d) : Prop :=
  ∃ R : Finset V,
    R ∈ D ∧ R.card + 1 = d ∧ R ⊆ F.1 ∧ R ⊆ G.1

abbrev AugmentedFacetOfCard {V : Type u} (C : AugmentedComplex V)
    (d : ℕ) :=
  {F : Finset V // F ∈ C ∧ F.card = d}

/-- Facet adjacency which permits the common ridge to be empty. -/
def AugmentedFacetAdjacent {V : Type u} (C : AugmentedComplex V)
    (d : ℕ) (F G : AugmentedFacetOfCard C d) : Prop :=
  ∃ R : Finset V,
    R ∈ C ∧ R.card + 1 = d ∧ R ⊆ F.1 ∧ R ⊆ G.1

/-- The concrete augmented pseudomanifold data derived later from link
homology. -/
structure IsAugmentedPseudomanifold {V : Type u} [Finite V]
    (C : AugmentedComplex V) (d : ℕ) : Prop where
  pure : ∀ {F : Finset V}, F ∈ C →
    ∃ G : Finset V, G ∈ C ∧ F ⊆ G ∧ G.card = d
  ridge_two : ∀ {R : Finset V}, R ∈ C → R.card + 1 = d →
    Set.ncard {F : Finset V | F ∈ C ∧ F.card = d ∧ R ⊆ F} = 2
  facet_connected : ∀ F G : AugmentedFacetOfCard C d,
    Relation.ReflTransGen (AugmentedFacetAdjacent C d) F G

/-- The nonaugmented pseudomanifold data used for the original complex. -/
structure IsPseudomanifold {V : Type u} [Finite V]
    (D : AbstractSimplicialComplex V) (d : ℕ) : Prop where
  pure : IsPureOfCard D d
  ridge_two : ∀ {R : Finset V}, R ∈ D → R.card + 1 = d →
    Set.ncard {F : Finset V | F ∈ D ∧ F.card = d ∧ R ⊆ F} = 2
  facet_connected : ∀ F G : FacetOfCard D d,
    Relation.ReflTransGen (FacetAdjacent D d) F G

/-- Faces of cardinality `q`, including the unique formal empty face at
`q=0`. -/
abbrev AugmentedSimplex {V : Type u} (C : AugmentedComplex V) (q : ℕ) :=
  {F : Finset V // F ∈ C ∧ F.card = q}

noncomputable instance augmentedSimplexFintype {V : Type u} [Finite V]
    (C : AugmentedComplex V) (q : ℕ) : Fintype (AugmentedSimplex C q) := by
  letI := Fintype.ofFinite V
  exact Fintype.ofFinite _

end SimplicialSphereAnisotropicity.Simplicial


end

