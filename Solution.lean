section

/-!
# Derivations on generic rational-function fields

This module constructs coordinate derivations on fraction fields and a
coefficientwise extension of a derivation through a multivariate polynomial
ring and its fraction field.  It also records the characteristic-two square
identities used by the directional-derivative argument.
-/

set_option autoImplicit false

noncomputable section

open scoped BigOperators TensorProduct

namespace SimplicialSphereAnisotropicity.Generic

universe u v

section CoefficientwisePolynomial

variable {k K sigma : Type*} [CommRing k] [CommRing K] [Algebra k K]

/-- Apply a derivation coefficientwise to a multivariate polynomial. -/
noncomputable def coefficientwisePolynomialLinearMap
    (D : Derivation k K K) :
    MvPolynomial sigma K →ₗ[k] MvPolynomial sigma K :=
  (AddMonoidAlgebra.coeffLinearEquiv k).symm.toLinearMap.comp
    ((Finsupp.mapRange.linearMap D.toLinearMap).comp
      (AddMonoidAlgebra.coeffLinearEquiv k).toLinearMap)

@[simp]
theorem coefficientwisePolynomialLinearMap_coeff
    (D : Derivation k K K) (p : MvPolynomial sigma K) (s : sigma →₀ ℕ) :
    (coefficientwisePolynomialLinearMap D p).coeff s = D (p.coeff s) := by
  rfl

@[simp]
theorem coefficientwisePolynomialLinearMap_monomial
    (D : Derivation k K K) (s : sigma →₀ ℕ) (a : K) :
    coefficientwisePolynomialLinearMap D (MvPolynomial.monomial s a) =
      MvPolynomial.monomial s (D a) := by
  classical
  ext u
  by_cases h : u = s
  · subst u
    simp [coefficientwisePolynomialLinearMap_coeff]
  · have hs : s ≠ u := fun hsu => h hsu.symm
    simp [coefficientwisePolynomialLinearMap_coeff,
      MvPolynomial.coeff_monomial, hs]

/-- The coefficientwise polynomial map is a derivation and kills all variables. -/
noncomputable def coefficientwisePolynomialDerivation
    (D : Derivation k K K) :
    Derivation k (MvPolynomial sigma K) (MvPolynomial sigma K) where
  toLinearMap := coefficientwisePolynomialLinearMap D
  map_one_eq_zero' := by
    rw [MvPolynomial.one_def, coefficientwisePolynomialLinearMap_monomial,
      D.map_one_eq_zero]
    exact map_zero _
  leibniz' p q := by
    classical
    induction p using MvPolynomial.induction_on' with
    | add p₁ p₂ hp₁ hp₂ =>
        simp only [add_mul, map_add, hp₁, hp₂, add_smul]
        module
    | monomial s a =>
        induction q using MvPolynomial.induction_on' with
        | add q₁ q₂ hq₁ hq₂ =>
            simp only [mul_add, map_add, hq₁, hq₂, smul_add]
            module
        | monomial t b =>
            simp only [MvPolynomial.monomial_mul,
              coefficientwisePolynomialLinearMap_monomial,
              D.leibniz, smul_eq_mul]
            rw [add_comm t s]
            exact LinearMap.map_add _ _ _

@[simp]
theorem coefficientwisePolynomialDerivation_coeff
    (D : Derivation k K K) (p : MvPolynomial sigma K) (s : sigma →₀ ℕ) :
    (coefficientwisePolynomialDerivation D p).coeff s = D (p.coeff s) := by
  exact coefficientwisePolynomialLinearMap_coeff D p s

@[simp]
theorem coefficientwisePolynomialDerivation_monomial
    (D : Derivation k K K) (s : sigma →₀ ℕ) (a : K) :
    coefficientwisePolynomialDerivation D (MvPolynomial.monomial s a) =
      MvPolynomial.monomial s (D a) :=
  coefficientwisePolynomialLinearMap_monomial D s a

@[simp]
theorem coefficientwisePolynomialDerivation_C
    (D : Derivation k K K) (a : K) :
    coefficientwisePolynomialDerivation (sigma := sigma) D (MvPolynomial.C a) =
      MvPolynomial.C (D a) := by
  rw [MvPolynomial.C_apply, MvPolynomial.C_apply,
    coefficientwisePolynomialDerivation_monomial]

@[simp]
theorem coefficientwisePolynomialDerivation_X
    (D : Derivation k K K) (i : sigma) :
    coefficientwisePolynomialDerivation D (MvPolynomial.X i) = 0 := by
  rw [MvPolynomial.X, coefficientwisePolynomialDerivation_monomial,
    D.map_one_eq_zero]
  exact map_zero _

/-- Coefficientwise polynomial extensions of commuting derivations commute. -/
theorem coefficientwisePolynomialDerivation_comm
    (D E : Derivation k K K)
    (hcomm : ∀ x, D (E x) = E (D x))
    (p : MvPolynomial sigma K) :
    coefficientwisePolynomialDerivation D
        (coefficientwisePolynomialDerivation E p) =
      coefficientwisePolynomialDerivation E
        (coefficientwisePolynomialDerivation D p) := by
  ext s
  simp only [coefficientwisePolynomialDerivation_coeff]
  exact hcomm _

end CoefficientwisePolynomial

section FractionExtension

variable {k R S : Type*} [CommRing k] [CommRing R] [Field S]
variable [Algebra k R] [Algebra k S] [Algebra R S]
variable [IsScalarTower k R S] [IsFractionRing R S]

/-- Extend a derivation uniquely through a fraction-field localization. -/
noncomputable def extendDerivationToFraction
    (D : Derivation k R R) : Derivation k S S := by
  letI : Algebra.FormallyEtale R S :=
    Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors R)
  let onBaseDifferentials : Ω[R⁄k] →ₗ[R] S :=
    (Algebra.linearMap R S).comp D.liftKaehlerDifferential
  let contract : S ⊗[R] Ω[R⁄k] →ₗ[S] S :=
    onBaseDifferentials.liftBaseChange S
  let onFractionDifferentials : Ω[S⁄k] →ₗ[S] S :=
    contract.comp
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k R S).symm.toLinearMap
  exact onFractionDifferentials.compDer (KaehlerDifferential.D k S)

set_option linter.style.haveILetI false in
@[simp]
theorem extendDerivationToFraction_algebraMap
    (D : Derivation k R R) (p : R) :
    extendDerivationToFraction D (algebraMap R S p) = algebraMap R S (D p) := by
  letI : Algebra.FormallyEtale R S :=
    Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors R)
  simp [extendDerivationToFraction,
    KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap,
    Derivation.liftKaehlerDifferential_comp_D]

end FractionExtension

section FractionExtensionality

variable {k R S : Type*} [CommRing k] [CommRing R] [Field S]
variable [Algebra k S] [Algebra R S] [IsFractionRing R S]

/-- Derivations on a fraction field are determined on the embedded domain. -/
theorem fractionDerivation_ext
    {D E : Derivation k S S}
    (h : ∀ p : R, D (algebraMap R S p) = E (algebraMap R S p)) : D = E := by
  ext x
  obtain ⟨p, q, hx⟩ := IsLocalization.exists_mk'_eq (nonZeroDivisors R) x
  rw [← hx, IsFractionRing.mk'_eq_div, D.leibniz_div, E.leibniz_div]
  simp only [h]

end FractionExtensionality

section CoordinateDerivations

variable {K sigma : Type*} [CommRing K]

/-- Coordinate partial derivatives commute on multivariate polynomials. -/
theorem pderiv_comm (i j : sigma) (p : MvPolynomial sigma K) :
    MvPolynomial.pderiv i (MvPolynomial.pderiv j p) =
      MvPolynomial.pderiv j (MvPolynomial.pderiv i p) := by
  let Di : Derivation K (MvPolynomial sigma K) (MvPolynomial sigma K) :=
    MvPolynomial.pderiv i
  let Dj : Derivation K (MvPolynomial sigma K) (MvPolynomial sigma K) :=
    MvPolynomial.pderiv j
  have hz : ⁅Di, Dj⁆ =
      (0 : Derivation K (MvPolynomial sigma K) (MvPolynomial sigma K)) := by
    classical
    apply MvPolynomial.derivation_ext
    intro x
    simp only [Derivation.commutator_apply, Di, Dj, MvPolynomial.pderiv_X,
      Derivation.zero_apply]
    by_cases hix : i = x <;> by_cases hjx : j = x <;> simp [hix, hjx]
  have hp := Derivation.congr_fun hz p
  simpa [Derivation.commutator_apply, Di, Dj] using sub_eq_zero.mp hp

variable [IsDomain K]

/-- Coordinate differentiation on the rational function field `Frac(K[sigma])`. -/
noncomputable def fractionCoordinateDerivation
    (i : sigma) :
    Derivation K (FractionRing (MvPolynomial sigma K))
      (FractionRing (MvPolynomial sigma K)) :=
  extendDerivationToFraction (k := K) (R := MvPolynomial sigma K)
    (S := FractionRing (MvPolynomial sigma K)) (MvPolynomial.pderiv i)

@[simp]
theorem fractionCoordinateDerivation_algebraMap
    (i : sigma) (p : MvPolynomial sigma K) :
    fractionCoordinateDerivation i
        (algebraMap (MvPolynomial sigma K)
          (FractionRing (MvPolynomial sigma K)) p) =
      algebraMap (MvPolynomial sigma K)
        (FractionRing (MvPolynomial sigma K)) (MvPolynomial.pderiv i p) := by
  simp [fractionCoordinateDerivation]

@[simp]
theorem fractionCoordinateDerivation_X
    [DecidableEq sigma] (i j : sigma) :
    fractionCoordinateDerivation (K := K) i
        (algebraMap (MvPolynomial sigma K)
          (FractionRing (MvPolynomial sigma K)) (MvPolynomial.X j)) =
      if i = j then 1 else 0 := by
  rw [fractionCoordinateDerivation_algebraMap]
  by_cases h : i = j
  · subst j
    simp
  · simp [h]

/-- Coordinate derivations commute on the rational function field. -/
theorem fractionCoordinateDerivation_comm
    (i j : sigma) (x : FractionRing (MvPolynomial sigma K)) :
    fractionCoordinateDerivation i (fractionCoordinateDerivation j x) =
      fractionCoordinateDerivation j (fractionCoordinateDerivation i x) := by
  let Di := fractionCoordinateDerivation (K := K) i
  let Dj := fractionCoordinateDerivation (K := K) j
  have hbracket : ⁅Di, Dj⁆ =
      (0 : Derivation K (FractionRing (MvPolynomial sigma K))
        (FractionRing (MvPolynomial sigma K))) := by
    apply fractionDerivation_ext (R := MvPolynomial sigma K)
    intro p
    simp only [Derivation.commutator_apply, Di, Dj,
      fractionCoordinateDerivation_algebraMap, Derivation.zero_apply]
    rw [pderiv_comm]
    exact sub_self _
  have hx := Derivation.congr_fun hbracket x
  simpa [Derivation.commutator_apply, Di, Dj] using sub_eq_zero.mp hx

end CoordinateDerivations

section CoefficientwiseFraction

variable {k L sigma : Type*} [CommRing k] [Field L] [Algebra k L]

/-- Extend a derivation on `L` coefficientwise to `Frac(L[sigma])`. -/
noncomputable def coefficientwiseFractionDerivation
    (D : Derivation k L L) :
    Derivation k (FractionRing (MvPolynomial sigma L))
      (FractionRing (MvPolynomial sigma L)) :=
  extendDerivationToFraction (k := k) (R := MvPolynomial sigma L)
    (S := FractionRing (MvPolynomial sigma L))
    (coefficientwisePolynomialDerivation (sigma := sigma) D)

@[simp]
theorem coefficientwiseFractionDerivation_algebraMap
    (D : Derivation k L L) (p : MvPolynomial sigma L) :
    coefficientwiseFractionDerivation D
        (algebraMap (MvPolynomial sigma L)
          (FractionRing (MvPolynomial sigma L)) p) =
      algebraMap (MvPolynomial sigma L)
        (FractionRing (MvPolynomial sigma L))
        (coefficientwisePolynomialDerivation D p) := by
  simp [coefficientwiseFractionDerivation]

/-- Coefficientwise fraction-field extensions of commuting derivations commute. -/
theorem coefficientwiseFractionDerivation_comm
    (D E : Derivation k L L)
    (hcomm : ∀ x, D (E x) = E (D x))
    (x : FractionRing (MvPolynomial sigma L)) :
    coefficientwiseFractionDerivation D
        (coefficientwiseFractionDerivation E x) =
      coefficientwiseFractionDerivation E
        (coefficientwiseFractionDerivation D x) := by
  let D' := coefficientwiseFractionDerivation (sigma := sigma) D
  let E' := coefficientwiseFractionDerivation (sigma := sigma) E
  have hbracket : ⁅D', E'⁆ =
      (0 : Derivation k (FractionRing (MvPolynomial sigma L))
        (FractionRing (MvPolynomial sigma L))) := by
    apply fractionDerivation_ext (R := MvPolynomial sigma L)
    intro p
    simp only [Derivation.commutator_apply, D', E',
      coefficientwiseFractionDerivation_algebraMap, Derivation.zero_apply]
    rw [coefficientwisePolynomialDerivation_comm D E hcomm]
    exact sub_self _
  have hx := Derivation.congr_fun hbracket x
  simpa [Derivation.commutator_apply, D', E'] using sub_eq_zero.mp hx

end CoefficientwiseFraction

section Determinants

/-- The Leibniz rule for a finite product, with the differentiated factor singled out. -/
theorem derivation_finset_prod
    {k A ι : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [DecidableEq ι]
    (D : Derivation k A A) (s : Finset ι) (f : ι → A) :
    D (∏ i ∈ s, f i) =
      ∑ i ∈ s, D (f i) * ∏ j ∈ s.erase i, f j := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.prod_insert ha, D.leibniz, ih, Finset.sum_insert ha]
      simp only [smul_eq_mul]
      have hsum :
          (∑ i ∈ s, D (f i) * ∏ j ∈ (insert a s).erase i, f j) =
            ∑ i ∈ s, f a * (D (f i) * ∏ j ∈ s.erase i, f j) := by
        apply Finset.sum_congr rfl
        intro i hi
        have hai : a ≠ i := fun h ↦ ha (h ▸ hi)
        rw [Finset.erase_insert_of_ne hai, Finset.prod_insert]
        · ring
        · exact fun h ↦ ha (Finset.erase_subset i s h)
      rw [hsum]
      rw [Finset.erase_insert ha, Finset.mul_sum]
      ring

/-- A derivation of a determinant is the sum of its single-column derivatives. -/
theorem derivation_det
    {k A ι : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [Fintype ι] [DecidableEq ι]
    (D : Derivation k A A) (M : Matrix ι ι A) :
    D M.det =
      ∑ j, (M.updateCol j (fun i ↦ D (M i j))).det := by
  calc
    D M.det =
        ∑ σ : Equiv.Perm ι, ((Equiv.Perm.sign σ : ℤ) : A) *
          ∑ j, D (M (σ j) j) *
            ∏ i ∈ Finset.univ.erase j, M (σ i) i := by
      rw [Matrix.det_apply', map_sum]
      apply Finset.sum_congr rfl
      intro σ _hσ
      rw [D.leibniz, D.map_intCast]
      simp only [smul_eq_mul, mul_zero, add_zero]
      rw [derivation_finset_prod D Finset.univ]
    _ = ∑ j, ∑ σ : Equiv.Perm ι, ((Equiv.Perm.sign σ : ℤ) : A) *
          (D (M (σ j) j) *
            ∏ i ∈ Finset.univ.erase j, M (σ i) i) := by
      simp_rw [Finset.mul_sum]
      exact Finset.sum_comm
    _ = ∑ j, (M.updateCol j (fun i ↦ D (M i j))).det := by
      apply Finset.sum_congr rfl
      intro j _hj
      rw [Matrix.det_apply']
      apply Finset.sum_congr rfl
      intro σ _hσ
      congr 1
      have hfun :
          (fun i ↦ (M.updateCol j (fun r ↦ D (M r j))) (σ i) i) =
            Function.update (fun i ↦ M (σ i) i) j (D (M (σ j) j)) := by
        funext i
        by_cases hij : i = j
        · subst i
          simp
        · simp [hij]
      rw [hfun, Finset.prod_update_of_mem (Finset.mem_univ j),
        Finset.sdiff_singleton_eq_erase]

/-- Swapping an old and a replacement column does not change a determinant in characteristic two. -/
theorem det_updateCol_swap_charTwo
    {A ι : Type*} [CommRing A] [CharP A 2]
    [Fintype ι] [DecidableEq ι]
    (M : Matrix ι ι A) (i j : ι) (hij : i ≠ j) (u : ι → A) :
    ((M.updateCol j u).updateCol i (fun r ↦ M r j)).det =
      (M.updateCol i u).det := by
  let σ : Equiv.Perm ι := Equiv.swap i j
  let R := M.updateCol i u
  have hmatrix :
      (M.updateCol j u).updateCol i (fun r ↦ M r j) =
        R.submatrix id σ := by
    ext r c
    by_cases hci : c = i
    · subst c
      simp only [Matrix.updateCol_self, Matrix.submatrix_apply, id_eq, σ,
        Equiv.swap_apply_left, R]
      rw [Matrix.updateCol_ne hij.symm]
    · by_cases hcj : c = j
      · subst c
        simp only [Matrix.updateCol_ne hij.symm, Matrix.updateCol_self,
          Matrix.submatrix_apply, id_eq, σ, Equiv.swap_apply_right, R]
      · simp only [Matrix.updateCol_ne hci, Matrix.updateCol_ne hcj,
          Matrix.submatrix_apply, id_eq, σ,
          Equiv.swap_apply_of_ne_of_ne hci hcj, R]
  calc
    ((M.updateCol j u).updateCol i (fun r ↦ M r j)).det =
        (R.submatrix id σ).det := congrArg Matrix.det hmatrix
    _ = Equiv.Perm.sign σ * R.det := Matrix.det_permute' σ R
    _ = R.det := by
      rw [Equiv.Perm.sign_swap hij]
      simp only [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one,
        one_mul, CharTwo.neg_eq]
    _ = (M.updateCol i u).det := rfl

end Determinants

section CharacteristicTwo

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] [CharP A 2]

/-- Every derivation kills every square in characteristic two. -/
theorem derivation_sq (D : Derivation k A A) (x : A) : D (x ^ 2) = 0 := by
  rw [pow_two, D.leibniz]
  exact CharTwo.add_self_eq_zero _

/-- A fixed-order composition of derivations. -/
def iterDerivation : List (Derivation k A A) → A → A
  | [], x => x
  | D :: derivatives, x => D (iterDerivation derivatives x)

/-- Square scalars pass through any fixed-order iterated derivation. -/
theorem iterDerivation_sq_mul
    (derivatives : List (Derivation k A A)) (s x : A) :
    iterDerivation derivatives (s ^ 2 * x) =
      s ^ 2 * iterDerivation derivatives x := by
  induction derivatives with
  | nil => rfl
  | cons D derivatives ih =>
      simp only [iterDerivation, ih]
      rw [D.leibniz, derivation_sq]
      simp [smul_eq_mul]

end CharacteristicTwo

/-- A scalar killed by every member passes through a fixed-order derivative composition. -/
theorem iterDerivation_const_mul_of_forall
    {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    (derivatives : List (Derivation k A A)) (c x : A)
    (hc : ∀ D ∈ derivatives, D c = 0) :
    iterDerivation derivatives (c * x) =
      c * iterDerivation derivatives x := by
  induction derivatives with
  | nil => rfl
  | cons D derivatives ih =>
      simp only [iterDerivation]
      rw [ih]
      · rw [D.leibniz, hc D (by simp)]
        simp [smul_eq_mul]
      · intro E hE
        exact hc E (by simp [hE])

/-- A derivation kills a finite product if it kills every factor. -/
theorem derivation_finset_prod_eq_zero
    {k A ι : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [DecidableEq ι]
    (D : Derivation k A A) (s : Finset ι) (f : ι → A)
    (hf : ∀ i ∈ s, D (f i) = 0) :
    D (∏ i ∈ s, f i) = 0 := by
  rw [derivation_finset_prod]
  apply Finset.sum_eq_zero
  intro i hi
  rw [hf i hi, zero_mul]

/-- Diagonal differentiation of matched factors has one surviving Leibniz assignment. -/
theorem iterDerivation_ofFn_prod
    {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    {q : ℕ}
    (D : Fin q → Derivation k A A) (a b : Fin q → A)
    (hdiag : ∀ i, D i (a i) = b i)
    (hoffA : ∀ i j, i ≠ j → D i (a j) = 0)
    (hoffB : ∀ i j, i ≠ j → D i (b j) = 0) :
    iterDerivation (List.ofFn D) (∏ i, a i) = ∏ i, b i := by
  induction q with
  | zero => simp [iterDerivation]
  | succ q ih =>
      rw [List.ofFn_succ, Fin.prod_univ_succ, Fin.prod_univ_succ]
      simp only [iterDerivation]
      rw [iterDerivation_const_mul_of_forall]
      · rw [ih (fun i ↦ D i.succ) (fun i ↦ a i.succ) (fun i ↦ b i.succ)]
        · rw [(D 0).leibniz, hdiag]
          rw [derivation_finset_prod_eq_zero]
          · simp [smul_eq_mul, mul_comm]
          · intro i _hi
            exact hoffB 0 i.succ (Fin.succ_ne_zero i).symm
        · intro i
          exact hdiag i.succ
        · intro i j hij
          exact hoffA i.succ j.succ (fun h ↦ hij (Fin.succ_injective q h))
        · intro i j hij
          exact hoffB i.succ j.succ (fun h ↦ hij (Fin.succ_injective q h))
      · intro E hE
        rw [List.mem_ofFn] at hE
        obtain ⟨i, rfl⟩ := hE
        exact hoffA i.succ 0 (Fin.succ_ne_zero i)

/-- Evaluation commutes with a finite sum of derivations. -/
theorem derivation_finsetSum_apply
    {k ι A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    (s : Finset ι) (f : ι → Derivation k A A) (x : A) :
    (∑ i ∈ s, f i) x = ∑ i ∈ s, f i x := by
  classical
  induction s using Finset.induction_on with
  | empty => rfl
  | @insert a s ha ih =>
      simp only [Finset.sum_insert ha, Derivation.add_apply, ih]

section TrustedCoefficientField

open SimplicialSphereAnisotropicity

variable (k : Type*) [Field k] {n m : ℕ}

/-- A coordinate derivation on the trusted generic coefficient field. -/
noncomputable def genericCoordinateDerivation
    (i : Fin (n + 1)) (v : Fin m) :
    Derivation k (GenericField k n m) (GenericField k n m) :=
  fractionCoordinateDerivation (K := k) (i, v)

@[simp]
theorem genericCoordinateDerivation_apply_coefficient
    (i r : Fin (n + 1)) (v u : Fin m) :
    genericCoordinateDerivation k i v (genericCoefficient k r u) =
      if (i, v) = (r, u) then 1 else 0 := by
  simpa [genericCoordinateDerivation, genericCoefficient] using
    (fractionCoordinateDerivation_X (K := k)
      (sigma := Fin (n + 1) × Fin m) (i, v) (r, u))

/-- Coordinate derivations on the trusted generic coefficient field commute. -/
theorem genericCoordinateDerivation_comm
    (i r : Fin (n + 1)) (v u : Fin m) (x : GenericField k n m) :
    genericCoordinateDerivation k i v (genericCoordinateDerivation k r u x) =
      genericCoordinateDerivation k r u (genericCoordinateDerivation k i v x) := by
  exact fractionCoordinateDerivation_comm (K := k)
    (sigma := Fin (n + 1) × Fin m) (i, v) (r, u) x

end TrustedCoefficientField

end SimplicialSphereAnisotropicity.Generic

end

end

section

/-!
# The canonical face model and the trusted Artinian reduction

This module maps the allowed-exponent face model directly to the exact
`SimplicialSphereAnisotropicity.GenericArtinianReduction`.  In that quotient, the canonical parameter
action specializes through `MvPolynomial.constantCoeff`.  The final generic
helper descends a scalar-bilinear map through an ideal quotient when the ideal
lies in both kernels.
-/

noncomputable section

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v w

private abbrev K_TrustedReduction (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev T_TrustedReduction (k : Type u) [Field k] (n m : ℕ) :=
  Generic.ParameterRing k n m

private abbrev VertexPolynomial_TrustedReduction (k : Type u) [Field k] (n m : ℕ) :=
  MvPolynomial (Fin m) (K_TrustedReduction k n m)

private abbrev Model_TrustedReduction (k : Type u) [Field k] (n m : ℕ)
    (D : AbstractSimplicialComplex (Fin m)) :=
  FaceRingModel (K_TrustedReduction k n m) (AugmentedComplex.ofAbstract D)

private abbrev Reduction_TrustedReduction (k : Type u) [Field k] (n : ℕ) {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :=
  SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D

/-- Evaluation of the parameter polynomial in the exact trusted reduction. -/
noncomputable def parameterToReduction
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    T_TrustedReduction k n m →+* Reduction_TrustedReduction k n D :=
  (Ideal.Quotient.mkₐ (K_TrustedReduction k n m)
      (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toRingHom.comp
    (ambientParameterAlgHom k).toRingHom

theorem genericLinearForm_mk_reduction_eq_zero
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (i : Fin (n + 1)) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (SimplicialSphereAnisotropicity.genericLinearForm k (m := m) i) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_sup_right
    (Ideal.subset_span (Set.mem_range_self i))

/-- Every parameter polynomial acts in the trusted reduction by its constant
coefficient. -/
theorem parameterToReduction_eq_constantCoeff
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    parameterToReduction k D =
      (algebraMap (K_TrustedReduction k n m) (Reduction_TrustedReduction k n D)).comp
        MvPolynomial.constantCoeff := by
  apply MvPolynomial.ringHom_ext
  · intro c
    dsimp [parameterToReduction]
    change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (ambientParameterAlgHom k (MvPolynomial.C c)) =
      algebraMap (K_TrustedReduction k n m) (Reduction_TrustedReduction k n D)
        (MvPolynomial.constantCoeff (MvPolynomial.C c))
    rw [MvPolynomial.constantCoeff_C]
    rw [show ambientParameterAlgHom k (MvPolynomial.C c) =
        MvPolynomial.C c by simp [ambientParameterAlgHom]]
    rw [← MvPolynomial.algebraMap_eq]
    rfl
  · intro i
    dsimp [parameterToReduction]
    change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (ambientParameterAlgHom k (MvPolynomial.X i)) =
      algebraMap (K_TrustedReduction k n m) (Reduction_TrustedReduction k n D)
        (MvPolynomial.constantCoeff (MvPolynomial.X i))
    rw [MvPolynomial.constantCoeff_X, map_zero]
    rw [ambientParameterAlgHom_X,
      genericLinearForm_mk_reduction_eq_zero]

/-- The direct linear map from the allowed-exponent model to the exact
trusted Artinian reduction. -/
noncomputable def faceRingModelToReduction
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Model_TrustedReduction k n m D →ₗ[K_TrustedReduction k n m] Reduction_TrustedReduction k n D :=
  (Ideal.Quotient.mkₐ (K_TrustedReduction k n m)
      (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toLinearMap.comp
    (faceRingModelToPolynomial (K_TrustedReduction k n m)
      (AugmentedComplex.ofAbstract D))

@[simp]
theorem faceRingModelToReduction_apply
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (z : Model_TrustedReduction k n m D) :
    faceRingModelToReduction k D z =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (faceRingModelToPolynomial (K_TrustedReduction k n m)
          (AugmentedComplex.ofAbstract D) z) := by
  rfl

/-- Replacing a polynomial by its face-supported part does not change its
class in the trusted reduction. -/
theorem reduction_mk_facePart
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : VertexPolynomial_TrustedReduction k n m) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (faceRingModelToPolynomial (K_TrustedReduction k n m)
          (AugmentedComplex.ofAbstract D)
          (polynomialFacePart (K_TrustedReduction k n m)
            (AugmentedComplex.ofAbstract D) p)) =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  have hmem : p - faceRingModelToPolynomial (K_TrustedReduction k n m)
        (AugmentedComplex.ofAbstract D)
        (polynomialFacePart (K_TrustedReduction k n m)
          (AugmentedComplex.ofAbstract D) p) ∈
      SimplicialSphereAnisotropicity.genericReductionIdeal k D :=
    Ideal.mem_sup_left
      (polynomial_sub_facePart_mem_stanleyReisnerIdeal
        (K_TrustedReduction k n m) D p)
  simpa only [neg_sub] using
    (SimplicialSphereAnisotropicity.genericReductionIdeal k D).neg_mem hmem

set_option linter.style.haveILetI false in
/-- The direct map specializes the canonical parameter action by constant
coefficient. -/
theorem faceRingModelToReduction_parameter_smul
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : T_TrustedReduction k n m) (z : Model_TrustedReduction k n m D) :
    letI : Module (T_TrustedReduction k n m) (Model_TrustedReduction k n m D) :=
      faceRingModelCanonicalModule k D
    faceRingModelToReduction k D (p • z) =
      MvPolynomial.constantCoeff p • faceRingModelToReduction k D z := by
  letI : Module (T_TrustedReduction k n m) (Model_TrustedReduction k n m D) :=
    faceRingModelCanonicalModule k D
  rw [faceRingModelCanonical_smul_eq_facePart]
  change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (faceRingModelToPolynomial (K_TrustedReduction k n m)
        (AugmentedComplex.ofAbstract D)
        (polynomialFacePart (K_TrustedReduction k n m)
          (AugmentedComplex.ofAbstract D)
          (ambientParameterAlgHom k p *
            faceRingModelToPolynomial (K_TrustedReduction k n m)
              (AugmentedComplex.ofAbstract D) z))) = _
  rw [reduction_mk_facePart]
  change parameterToReduction k D p *
      faceRingModelToReduction k D z = _
  rw [parameterToReduction_eq_constantCoeff]
  exact (Algebra.smul_def
    (MvPolynomial.constantCoeff p)
    (faceRingModelToReduction k D z)).symm

/-- The direct map reaches every class of the exact trusted reduction. -/
theorem faceRingModelToReduction_surjective
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Function.Surjective (faceRingModelToReduction k (n := n) D) := by
  intro q
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  refine ⟨polynomialFacePart (K_TrustedReduction k n m)
    (AugmentedComplex.ofAbstract D) p, ?_⟩
  exact reduction_mk_facePart k D p

/-- A scalar-bilinear map annihilating an ideal in both arguments descends
to a bilinear map on the ring quotient. -/
noncomputable def idealQuotientLiftBilinear
    {K₀ : Type u} {R : Type v} {V : Type w}
    [Field K₀] [CommRing R] [Algebra K₀ R]
    [AddCommGroup V] [Module K₀ V]
    (I : Ideal R) (f : R →ₗ[K₀] R →ₗ[K₀] V)
    (hleft : ∀ x, x ∈ I → f x = 0)
    (hright : ∀ y, y ∈ I → f.flip y = 0) :
    (R ⧸ I) →ₗ[K₀] (R ⧸ I) →ₗ[K₀] V :=
  f.liftQ₂ (I.restrictScalars K₀) (I.restrictScalars K₀)
    (fun x hx ↦ LinearMap.mem_ker.mpr (hleft x hx))
    (fun y hy ↦ LinearMap.mem_ker.mpr (hright y hy))

@[simp]
theorem idealQuotientLiftBilinear_mk_mk
    {K₀ : Type u} {R : Type v} {V : Type w}
    [Field K₀] [CommRing R] [Algebra K₀ R]
    [AddCommGroup V] [Module K₀ V]
    (I : Ideal R) (f : R →ₗ[K₀] R →ₗ[K₀] V)
    (hleft : ∀ x, x ∈ I → f x = 0)
    (hright : ∀ y, y ∈ I → f.flip y = 0)
    (x y : R) :
    idealQuotientLiftBilinear I f hleft hright
        (Ideal.Quotient.mk I x) (Ideal.Quotient.mk I y) = f x y :=
  rfl

end SimplicialSphereAnisotropicity.Generic.Brion

end

end

section

/-!
# The Brion pairing on the trusted Artinian reduction

This module composes polynomial-valued Brion integration with constant-term
extraction and multiplication.  The Stanley--Reisner and generic-parameter
summands of the exact trusted reduction ideal lie in the resulting pairing's
two kernels, so the pairing descends to `SimplicialSphereAnisotropicity.GenericArtinianReduction`.
Its matrix on images of a face-model basis is definitionally the
constant-coefficient specialization of the established Brion Gram matrix.
-/

noncomputable section

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

private abbrev K_ReductionPairing (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev T_ReductionPairing (k : Type u) [Field k] (n m : ℕ) :=
  Generic.ParameterRing k n m

private abbrev S_ReductionPairing (k : Type u) [Field k] (n m : ℕ) :=
  MvPolynomial (Fin m) (K_ReductionPairing k n m)

/-- Constant-coefficient extraction as a linear map over the coefficient
field. -/
noncomputable def mvPolynomialConstantCoeffLinearMap
    (K₀ : Type*) [Field K₀] (s : Type*) :
    MvPolynomial s K₀ →ₗ[K₀] K₀ where
  toFun := MvPolynomial.constantCoeff
  map_add' := map_add _
  map_smul' := MvPolynomial.constantCoeff_smul

@[simp]
theorem mvPolynomialConstantCoeffLinearMap_apply
    (K₀ : Type*) [Field K₀] (s : Type*)
    (p : MvPolynomial s K₀) :
    mvPolynomialConstantCoeffLinearMap K₀ s p =
      MvPolynomial.constantCoeff p :=
  rfl

set_option linter.style.haveILetI false in
/-- Constant-term extraction after the polynomial-valued Brion map. -/
noncomputable def ambientBrionConstantTerm
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    S_ReductionPairing k n m →ₗ[K_ReductionPairing k n m] K_ReductionPairing k n m := by
  letI : Algebra (T_ReductionPairing k n m) (S_ReductionPairing k n m) :=
    parameterActionAlgebra (K_ReductionPairing k n m) (n + 1)
      (genericCoefficientMatrix k)
  exact (mvPolynomialConstantCoeffLinearMap (K_ReductionPairing k n m) (Fin (n + 1))).comp
    ((brionPolynomialLinearMap (K_ReductionPairing k n m) D (n + 1) hd hpm
      (genericCoefficientMatrix k)
      (genericFacetMatrix_det_ne_zero k)).restrictScalars (K_ReductionPairing k n m))

@[simp]
theorem ambientBrionConstantTerm_apply
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p : S_ReductionPairing k n m) :
    ambientBrionConstantTerm k D hd hpm p =
      MvPolynomial.constantCoeff
        (brionPolynomial (K_ReductionPairing k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) p) :=
  rfl

/-- The constant-term Brion functional applied after multiplication. -/
noncomputable def ambientBrionPairing
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    S_ReductionPairing k n m →ₗ[K_ReductionPairing k n m] S_ReductionPairing k n m →ₗ[K_ReductionPairing k n m] K_ReductionPairing k n m :=
  (LinearMap.mul (K_ReductionPairing k n m) (S_ReductionPairing k n m)).compr₂
    (ambientBrionConstantTerm k D hd hpm)

@[simp]
theorem ambientBrionPairing_apply
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p q : S_ReductionPairing k n m) :
    ambientBrionPairing k D hd hpm p q =
      MvPolynomial.constantCoeff
        (brionPolynomial (K_ReductionPairing k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) (p * q)) :=
  rfl

/-- The left annihilator of the constant-term Brion multiplication pairing. -/
noncomputable def ambientBrionAnnihilatorIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    Ideal (S_ReductionPairing k n m) where
  carrier := {p | ∀ q, ambientBrionConstantTerm k D hd hpm (p * q) = 0}
  zero_mem' := by
    intro q
    rw [zero_mul, ambientBrionConstantTerm_apply,
      brionPolynomial_zero, map_zero]
  add_mem' := by
    intro p q hp hq z
    simp only [add_mul, map_add, hp z, hq z, add_zero]
  smul_mem' := by
    intro a p hp q
    change ambientBrionConstantTerm k D hd hpm ((a * p) * q) = 0
    simpa only [mul_assoc, mul_left_comm a p] using hp (a * q)

@[simp]
theorem mem_ambientBrionAnnihilatorIdeal_iff
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p : S_ReductionPairing k n m) :
    p ∈ ambientBrionAnnihilatorIdeal k D hd hpm ↔
      ∀ q, ambientBrionConstantTerm k D hd hpm (p * q) = 0 :=
  Iff.rfl

/-- A polynomial in the Stanley--Reisner ideal has no face-supported
coefficients. -/
theorem polynomialFacePart_eq_zero_of_mem_stanleyReisnerIdeal
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : S_ReductionPairing k n m)
    (hp : p ∈ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K_ReductionPairing k n m) D) :
    polynomialFacePart (K_ReductionPairing k n m) (AugmentedComplex.ofAbstract D) p = 0 := by
  apply Finsupp.ext
  intro a
  rw [polynomialFacePart_apply]
  by_contra ha
  have hasupp : a.1 ∈ p.support :=
    MvPolynomial.mem_support_iff.mpr ha
  exact (mem_stanleyReisnerIdeal_iff_support_not_face
    (K_ReductionPairing k n m) D p).mp hp a.1 hasupp a.2

/-- Brion integration vanishes on the Stanley--Reisner ideal. -/
theorem genericBrionPolynomial_eq_zero_of_mem_stanleyReisnerIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p : S_ReductionPairing k n m)
    (hp : p ∈ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K_ReductionPairing k n m) D) :
    brionPolynomial (K_ReductionPairing k n m) D (n + 1) hd hpm
        (genericCoefficientMatrix k)
        (genericFacetMatrix_det_ne_zero k) p = 0 := by
  have hface := genericBrionPolynomial_facePart k D hd hpm p
  rw [polynomialFacePart_eq_zero_of_mem_stanleyReisnerIdeal k D p hp,
    map_zero] at hface
  simpa only [brionPolynomial_zero] using hface.symm

theorem stanleyReisnerIdeal_le_ambientBrionAnnihilatorIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K_ReductionPairing k n m) D ≤
      ambientBrionAnnihilatorIdeal k D hd hpm := by
  intro p hp
  rw [mem_ambientBrionAnnihilatorIdeal_iff]
  intro q
  rw [ambientBrionConstantTerm_apply,
    genericBrionPolynomial_eq_zero_of_mem_stanleyReisnerIdeal
      k D hd hpm (p * q)]
  · exact map_zero _
  · exact (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K_ReductionPairing k n m) D).mul_mem_right q hp

theorem genericLinearForm_mem_ambientBrionAnnihilatorIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (i : Fin (n + 1)) :
    SimplicialSphereAnisotropicity.genericLinearForm k (m := m) i ∈
      ambientBrionAnnihilatorIdeal k D hd hpm := by
  rw [mem_ambientBrionAnnihilatorIdeal_iff]
  intro q
  rw [ambientBrionConstantTerm_apply]
  rw [← ambientParameterAlgHom_X]
  rw [← parameterActionAlgHom_genericCoefficientMatrix k]
  rw [brionPolynomial_parameterAction_mul]
  simp

theorem genericParameterIdeal_le_ambientBrionAnnihilatorIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    SimplicialSphereAnisotropicity.genericParameterIdeal k n m ≤
      ambientBrionAnnihilatorIdeal k D hd hpm := by
  rw [SimplicialSphereAnisotropicity.genericParameterIdeal]
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact genericLinearForm_mem_ambientBrionAnnihilatorIdeal
    k D hd hpm i

theorem genericReductionIdeal_le_ambientBrionAnnihilatorIdeal
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    SimplicialSphereAnisotropicity.genericReductionIdeal k D ≤
      ambientBrionAnnihilatorIdeal k D hd hpm := by
  rw [SimplicialSphereAnisotropicity.genericReductionIdeal]
  exact sup_le
    (stanleyReisnerIdeal_le_ambientBrionAnnihilatorIdeal k D hd hpm)
    (genericParameterIdeal_le_ambientBrionAnnihilatorIdeal k D hd hpm)

theorem ambientBrionPairing_left_kernel
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p : S_ReductionPairing k n m) (hp : p ∈ SimplicialSphereAnisotropicity.genericReductionIdeal k D) :
    ambientBrionPairing k D hd hpm p = 0 := by
  apply LinearMap.ext
  intro q
  exact genericReductionIdeal_le_ambientBrionAnnihilatorIdeal
    k D hd hpm hp q

theorem ambientBrionPairing_right_kernel
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (q : S_ReductionPairing k n m) (hq : q ∈ SimplicialSphereAnisotropicity.genericReductionIdeal k D) :
    (ambientBrionPairing k D hd hpm).flip q = 0 := by
  apply LinearMap.ext
  intro p
  change ambientBrionConstantTerm k D hd hpm (p * q) = 0
  rw [mul_comm]
  exact genericReductionIdeal_le_ambientBrionAnnihilatorIdeal
    k D hd hpm hq p

/-- The constant-term Brion multiplication pairing on the exact trusted
Artinian reduction. -/
noncomputable def reductionBrionPairing
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D →ₗ[K_ReductionPairing k n m]
      SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D →ₗ[K_ReductionPairing k n m]
        K_ReductionPairing k n m :=
  idealQuotientLiftBilinear (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
    (ambientBrionPairing k D hd hpm)
    (ambientBrionPairing_left_kernel k D hd hpm)
    (ambientBrionPairing_right_kernel k D hd hpm)

@[simp]
theorem reductionBrionPairing_mk_mk
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p q : S_ReductionPairing k n m) :
    reductionBrionPairing k D hd hpm
        (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p)
        (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) q) =
      MvPolynomial.constantCoeff
        (brionPolynomial (K_ReductionPairing k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) (p * q)) :=
  rfl

@[simp]
theorem reductionBrionPairing_faceRingModelToReduction
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (z w : FaceRingModel (K_ReductionPairing k n m)
      (AugmentedComplex.ofAbstract D)) :
    reductionBrionPairing k D hd hpm
        (faceRingModelToReduction k D z)
        (faceRingModelToReduction k D w) =
      MvPolynomial.constantCoeff
        (brionPolynomial (K_ReductionPairing k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k)
          (faceRingModelToPolynomial (K_ReductionPairing k n m)
              (AugmentedComplex.ofAbstract D) z *
            faceRingModelToPolynomial (K_ReductionPairing k n m)
              (AugmentedComplex.ofAbstract D) w)) :=
  rfl

@[simp]
theorem reductionBrionPairing_basis_eq_constantCoeff_gram
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (T_ReductionPairing k n m)
          (FaceRingModel (K_ReductionPairing k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionPairing k n m)
        (FaceRingModel (K_ReductionPairing k n m)
          (AugmentedComplex.ofAbstract D)))
    (i j : Fin N) :
    reductionBrionPairing k D hd hpm
        (faceRingModelToReduction k D (b i))
        (faceRingModelToReduction k D (b j)) =
      MvPolynomial.constantCoeff
        (faceRingBrionGramMatrix k D hd hpm b i j) :=
  rfl

end SimplicialSphereAnisotropicity.Generic.Brion

end

