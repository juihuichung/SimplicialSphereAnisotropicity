section

/-!
# Polynomial-valued Brion integration

This file defines the facetwise Brion sum in the fraction field, identifies
it with the single fraction having `brionCommonNumerator` and
`brionCommonDenominator`, and uses the proved denominator divisibility to
choose its unique polynomial value.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v

theorem sum_div_eq_commonDenominator
    {K : Type u} [Field K]
    {ι : Type v} [DecidableEq ι]
    (s : Finset ι) (b e : ι → K)
    (hne : ∀ i ∈ s, e i ≠ 0) :
    ∑ i ∈ s, b i / e i =
      commonDenominatorNumerator s b e / ∏ i ∈ s, e i := by
  have hprod : ∏ i ∈ s, e i ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr hne
  rw [eq_div_iff hprod, Finset.sum_mul]
  unfold commonDenominatorNumerator
  apply Finset.sum_congr rfl
  intro i hi
  rw [← Finset.mul_prod_erase s e hi, ← mul_assoc,
    div_mul_cancel₀ _ (hne i hi)]

noncomputable def facetBrionFraction
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (F : FacetOfCard D d) : ParameterFraction L d :=
  algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
      (facetBrionNumerator L d a ha f F) /
    algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
      (facetBrionDenominator L d a ha F)

noncomputable def brionRational
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) : ParameterFraction L d :=
  ∑ F : FacetOfCard D d, facetBrionFraction L d a ha f F

theorem brionRational_eq_commonFraction
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) :
    brionRational L D d a ha f =
      algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
          (brionCommonNumerator L D d a ha f) /
        algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
          (brionCommonDenominator L D d a ha) := by
  let φ := algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
  have hne : ∀ F ∈ (Finset.univ : Finset (FacetOfCard D d)),
      φ (facetBrionDenominator L d a ha F) ≠ 0 := by
    intro F _hF
    exact (map_ne_zero_iff φ
      (IsFractionRing.injective
        (ParameterPolynomial L d) (ParameterFraction L d))).mpr
      (facetEuler_ne_zero L d a F.1 F.2.2 (ha F))
  have h := sum_div_eq_commonDenominator
    (Finset.univ : Finset (FacetOfCard D d))
    (fun F ↦ φ (facetBrionNumerator L d a ha f F))
    (fun F ↦ φ (facetBrionDenominator L d a ha F)) hne
  simpa [brionRational, facetBrionFraction,
    brionCommonNumerator, brionCommonDenominator,
    commonDenominatorNumerator, φ] using h

noncomputable def brionPolynomial
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) : ParameterPolynomial L d :=
  Classical.choose
    (brionCommonDenominator_dvd_brionCommonNumerator
      L D d hd hpm a ha f)

theorem brionCommonNumerator_eq_denominator_mul_brionPolynomial
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) :
    brionCommonNumerator L D d a ha f =
      brionCommonDenominator L D d a ha *
        brionPolynomial L D d hd hpm a ha f :=
  Classical.choose_spec
    (brionCommonDenominator_dvd_brionCommonNumerator
      L D d hd hpm a ha f)

theorem brionRational_eq_algebraMap_brionPolynomial
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) :
    brionRational L D d a ha f =
      algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
        (brionPolynomial L D d hd hpm a ha f) := by
  rw [brionRational_eq_commonFraction L D d a ha f,
    brionCommonNumerator_eq_denominator_mul_brionPolynomial
      L D d hd hpm a ha f]
  simp [brionCommonDenominator_ne_zero L D d a ha]

theorem brionRational_mem_range_algebraMap
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) :
    brionRational L D d a ha f ∈
      Set.range (algebraMap (ParameterPolynomial L d)
        (ParameterFraction L d)) := by
  exact ⟨brionPolynomial L D d hd hpm a ha f,
    (brionRational_eq_algebraMap_brionPolynomial
      L D d hd hpm a ha f).symm⟩

end SimplicialSphereAnisotropicity.Generic.Brion

end

end

section

/-!
# Cardinal-graded augmented face chains

The empty face has degree zero and a nonempty face has degree equal to its
cardinality.  Incidence signs disappear over a characteristic-two field.
-/

noncomputable section

open scoped BigOperators

namespace SimplicialSphereAnisotropicity.Simplicial

open Finset CategoryTheory

universe u v

abbrev AugmentedChain (K : Type v) [Semiring K] {V : Type u}
    (C : AugmentedComplex V) (q : ℕ) :=
  AugmentedSimplex C q →₀ K

def eraseSimplex {V : Type u} [DecidableEq V]
    (C : AugmentedComplex V) {q : ℕ}
    (F : AugmentedSimplex C (q + 1)) (v : ↥F.1) :
    AugmentedSimplex C q :=
  ⟨F.1.erase v.1, C.down_closed F.2.1 (Finset.erase_subset _ _), by
    rw [Finset.card_erase_of_mem v.2, F.2.2]
    omega⟩

@[simp]
theorem eraseSimplex_val {V : Type u} [DecidableEq V]
    (C : AugmentedComplex V) {q : ℕ}
    (F : AugmentedSimplex C (q + 1)) (v : ↥F.1) :
    (eraseSimplex C F v).1 = F.1.erase v.1 := rfl

def boundaryOnSimplex (K : Type v) [Field K] {V : Type u}
    [DecidableEq V] (C : AugmentedComplex V) (q : ℕ)
    (F : AugmentedSimplex C (q + 1)) : AugmentedChain K C q :=
  ∑ v : ↥F.1, Finsupp.single (eraseSimplex C F v) 1

/-- Unsigned deletion boundary in cardinal degree. -/
def faceBoundary (K : Type v) [Field K] {V : Type u}
    [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    AugmentedChain K C (q + 1) →ₗ[K] AugmentedChain K C q :=
  Finsupp.linearCombination K (boundaryOnSimplex K C q)

@[simp]
theorem faceBoundary_single (K : Type v) [Field K] {V : Type u}
    [DecidableEq V] (C : AugmentedComplex V) (q : ℕ)
    (F : AugmentedSimplex C (q + 1)) (a : K) :
    faceBoundary K C q (Finsupp.single F a) =
      a • boundaryOnSimplex K C q F := by
  exact Finsupp.linearCombination_single K a F

abbrev DeletionPair {V : Type u} [DecidableEq V] (F : Finset V) :=
  Σ v : ↥F, ↥(F.erase v.1)

def swapDeletionPair {V : Type u} [DecidableEq V] (F : Finset V) :
    DeletionPair F → DeletionPair F
  | ⟨v, w⟩ =>
      ⟨⟨w.1, (Finset.mem_erase.mp w.2).2⟩,
        ⟨v.1, Finset.mem_erase.mpr
          ⟨Ne.symm (Finset.mem_erase.mp w.2).1, v.2⟩⟩⟩

theorem swapDeletionPair_ne {V : Type u} [DecidableEq V]
    (F : Finset V) (p : DeletionPair F) :
    swapDeletionPair F p ≠ p := by
  rintro h
  have hv := congrArg (fun z : DeletionPair F ↦ z.1.1) h
  have hn := (Finset.mem_erase.mp p.2.2).1
  exact hn hv

theorem swapDeletionPair_involutive {V : Type u} [DecidableEq V]
    (F : Finset V) (p : DeletionPair F) :
    swapDeletionPair F (swapDeletionPair F p) = p := by
  rcases p with ⟨⟨v, hv⟩, ⟨w, hw⟩⟩
  rfl

def deletionPairTerm (K : Type v) [Field K] {V : Type u}
    [DecidableEq V] (C : AugmentedComplex V) {q : ℕ}
    (F : AugmentedSimplex C (q + 2)) (p : DeletionPair F.1) :
    AugmentedChain K C q :=
  Finsupp.single
    (eraseSimplex C (eraseSimplex C F p.1) p.2) 1

theorem deletionPairTerm_swap (K : Type v) [Field K] {V : Type u}
    [DecidableEq V] (C : AugmentedComplex V) {q : ℕ}
    (F : AugmentedSimplex C (q + 2)) (p : DeletionPair F.1) :
    deletionPairTerm K C F (swapDeletionPair F.1 p) =
      deletionPairTerm K C F p := by
  apply congrArg (fun G : AugmentedSimplex C q ↦ Finsupp.single G (1 : K))
  apply Subtype.ext
  exact Finset.erase_right_comm

theorem faceBoundary_boundary_single (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ)
    (F : AugmentedSimplex C (q + 2)) :
    faceBoundary K C q
        (faceBoundary K C (q + 1) (Finsupp.single F 1)) = 0 := by
  simp only [faceBoundary_single, one_smul, boundaryOnSimplex,
    map_sum]
  change (∑ v : ↥F.1, ∑ w : ↥(F.1.erase v.1),
    deletionPairTerm K C F ⟨v, w⟩) = 0
  rw [← Fintype.sum_sigma (fun p : DeletionPair F.1 ↦
    deletionPairTerm K C F p)]
  let term : DeletionPair F.1 → AugmentedChain K C q :=
    deletionPairTerm K C F
  have hcancel : ∀ p : DeletionPair F.1,
      term p + term (swapDeletionPair F.1 p) = 0 := by
    intro p
    change deletionPairTerm K C F p +
      deletionPairTerm K C F (swapDeletionPair F.1 p) = 0
    rw [deletionPairTerm_swap]
    let x : AugmentedChain K C q := deletionPairTerm K C F p
    calc
      x + x = (1 : K) • x + (1 : K) • x := by simp
      _ = ((1 : K) + 1) • x := by rw [add_smul]
      _ = 0 := by rw [CharTwo.add_self_eq_zero, zero_smul]
  simpa [term, deletionPairTerm] using
    (Finset.sum_involution (s := Finset.univ) (f := term)
      (fun p _ ↦ swapDeletionPair F.1 p)
      (fun p _ ↦ hcancel p)
      (fun p _ _ ↦ swapDeletionPair_ne F.1 p)
      (fun _ _ ↦ Finset.mem_univ _)
      (fun p _ ↦ swapDeletionPair_involutive F.1 p))

theorem faceBoundary_boundary_on (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ)
    (F : AugmentedSimplex C (q + 2)) :
    faceBoundary K C q (boundaryOnSimplex K C (q + 1) F) = 0 := by
  simpa only [faceBoundary_single, one_smul] using
    faceBoundary_boundary_single K C q F

theorem faceBoundary_boundary (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    (faceBoundary K C q).comp (faceBoundary K C (q + 1)) = 0 := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceBoundary_single, map_smul,
    faceBoundary_boundary_on, smul_zero, LinearMap.zero_apply]

/-- The finite augmented face chain complex, indexed by face cardinality. -/
def faceChainComplex (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) :
    ChainComplex (ModuleCat K) ℕ :=
  let X : ℕ → ModuleCat K :=
    fun q ↦ ModuleCat.of K (AugmentedChain K C q)
  let d : ∀ q : ℕ, X (q + 1) ⟶ X q :=
    fun q ↦ ModuleCat.ofHom (faceBoundary K C q)
  ChainComplex.of X d (fun q : ℕ ↦ by
    apply ModuleCat.hom_ext
    exact faceBoundary_boundary K C q)

@[simp]
theorem faceChainComplex_X (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    (faceChainComplex K C).X q = ModuleCat.of K (AugmentedChain K C q) :=
  rfl

@[simp]
theorem faceChainComplex_d (K : Type v) [Field K] [CharP K 2]
    {V : Type u} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    (faceChainComplex K C).d (q + 1) q =
      ModuleCat.ofHom (faceBoundary K C q) := by
  simp [faceChainComplex]

end SimplicialSphereAnisotropicity.Simplicial

end

end

section

noncomputable section

open scoped BigOperators
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u v

variable {V : Type u} [DecidableEq V]

/-- A monomial in a face coordinate ring, recorded with its ambient exponent.
The support condition is exactly what coordinate restriction tests. -/
structure FaceMonomialIndex (C : AugmentedComplex V) (q : ℕ) where
  face : AugmentedSimplex C q
  exponent : V →₀ ℕ
  support_subset : exponent.support ⊆ face.1

omit [DecidableEq V] in
@[ext]
theorem FaceMonomialIndex.ext {C : AugmentedComplex V} {q : ℕ}
    {I J : FaceMonomialIndex C q}
    (hface : I.face = J.face) (hexponent : I.exponent = J.exponent) : I = J := by
  cases I
  cases J
  cases hface
  cases hexponent
  rfl

abbrev FaceResolutionTerm (K : Type v) [Semiring K]
    (C : AugmentedComplex V) (q : ℕ) :=
  FaceMonomialIndex C q →₀ K

/-- Delete a vertex which is absent from the monomial support. -/
def eraseFaceMonomialIndex (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 1)) (x : ↥I.face.1)
    (hx : x.1 ∉ I.exponent.support) : FaceMonomialIndex C q where
  face := eraseSimplex C I.face x
  exponent := I.exponent
  support_subset := by
    intro y hy
    apply Finset.mem_erase.mpr
    refine ⟨?_, I.support_subset hy⟩
    intro hyx
    subst y
    exact hx hy

@[simp]
theorem eraseFaceMonomialIndex_face_val (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 1)) (x : ↥I.face.1)
    (hx : x.1 ∉ I.exponent.support) :
    (eraseFaceMonomialIndex C I x hx).face.1 = I.face.1.erase x.1 := rfl

@[simp]
theorem eraseFaceMonomialIndex_exponent (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 1)) (x : ↥I.face.1)
    (hx : x.1 ∉ I.exponent.support) :
    (eraseFaceMonomialIndex C I x hx).exponent = I.exponent := rfl

def faceResolutionBoundaryOnIndex
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (I : FaceMonomialIndex C (q + 1)) : FaceResolutionTerm K C q :=
  ∑ x : ↥I.face.1,
    if hx : x.1 ∉ I.exponent.support then
      Finsupp.single (eraseFaceMonomialIndex C I x hx) 1
    else 0

def faceResolutionBoundary
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ) :
    FaceResolutionTerm K C (q + 1) →ₗ[K] FaceResolutionTerm K C q :=
  Finsupp.linearCombination K (faceResolutionBoundaryOnIndex K C q)

@[simp]
theorem faceResolutionBoundary_single
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (I : FaceMonomialIndex C (q + 1)) (a : K) :
    faceResolutionBoundary K C q (Finsupp.single I a) =
      a • faceResolutionBoundaryOnIndex K C q I :=
  Finsupp.linearCombination_single K a I

/-- Delete two vertices, both absent from the monomial support. -/
def eraseFaceMonomialIndexPair
    (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 2)) (p : DeletionPair I.face.1)
    (h : p.1.1 ∉ I.exponent.support ∧ p.2.1 ∉ I.exponent.support) :
    FaceMonomialIndex C q :=
  eraseFaceMonomialIndex C
    (eraseFaceMonomialIndex C I p.1 h.1) p.2 h.2

theorem eraseFaceMonomialIndexPair_swap
    (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 2)) (p : DeletionPair I.face.1)
    (h : p.1.1 ∉ I.exponent.support ∧ p.2.1 ∉ I.exponent.support) :
    eraseFaceMonomialIndexPair C I (swapDeletionPair I.face.1 p) ⟨h.2, h.1⟩ =
      eraseFaceMonomialIndexPair C I p h := by
  apply FaceMonomialIndex.ext
  · apply Subtype.ext
    exact Finset.erase_right_comm
  · rfl

/-- A two-vertex deletion term.  If either vertex belongs to the monomial
support, the corresponding composite coordinate restriction is zero. -/
def faceResolutionDeletionPairTerm
    (K : Type v) [Field K] (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 2)) (p : DeletionPair I.face.1) :
    FaceResolutionTerm K C q :=
  if h : p.1.1 ∉ I.exponent.support ∧ p.2.1 ∉ I.exponent.support then
    Finsupp.single (eraseFaceMonomialIndexPair C I p h) 1
  else 0

theorem faceResolutionDeletionPairTerm_swap
    (K : Type v) [Field K] (C : AugmentedComplex V) {q : ℕ}
    (I : FaceMonomialIndex C (q + 2)) (p : DeletionPair I.face.1) :
    faceResolutionDeletionPairTerm K C I (swapDeletionPair I.face.1 p) =
      faceResolutionDeletionPairTerm K C I p := by
  by_cases h : p.1.1 ∉ I.exponent.support ∧
      p.2.1 ∉ I.exponent.support
  · have hs : (swapDeletionPair I.face.1 p).1.1 ∉ I.exponent.support ∧
        (swapDeletionPair I.face.1 p).2.1 ∉ I.exponent.support := ⟨h.2, h.1⟩
    rw [faceResolutionDeletionPairTerm, dif_pos hs,
      faceResolutionDeletionPairTerm, dif_pos h]
    congr 1
    exact eraseFaceMonomialIndexPair_swap C I p h
  · have hs : ¬ ((swapDeletionPair I.face.1 p).1.1 ∉ I.exponent.support ∧
        (swapDeletionPair I.face.1 p).2.1 ∉ I.exponent.support) := by
      intro hs
      exact h ⟨hs.2, hs.1⟩
    rw [faceResolutionDeletionPairTerm, dif_neg hs,
      faceResolutionDeletionPairTerm, dif_neg h]

theorem faceResolutionBoundary_boundary_onIndex
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (I : FaceMonomialIndex C (q + 2)) :
    faceResolutionBoundary K C q
      (faceResolutionBoundaryOnIndex K C (q + 1) I) = 0 := by
  simp only [faceResolutionBoundaryOnIndex, map_sum, apply_dite, map_zero,
    faceResolutionBoundary_single, one_smul]
  change (∑ x : ↥I.face.1,
      if hx : x.1 ∉ I.exponent.support then
        ∑ y : ↥(I.face.1.erase x.1),
          if hy : y.1 ∉ I.exponent.support then
            Finsupp.single
              (eraseFaceMonomialIndex C
                (eraseFaceMonomialIndex C I x hx) y hy) 1
          else 0
      else 0) = 0
  rw [show
      (∑ x : ↥I.face.1,
        if hx : x.1 ∉ I.exponent.support then
          ∑ y : ↥(I.face.1.erase x.1),
            if hy : y.1 ∉ I.exponent.support then
              Finsupp.single
                (eraseFaceMonomialIndex C
                  (eraseFaceMonomialIndex C I x hx) y hy) 1
            else 0
        else 0) =
      ∑ x : ↥I.face.1, ∑ y : ↥(I.face.1.erase x.1),
        faceResolutionDeletionPairTerm K C I ⟨x, y⟩ by
    apply Finset.sum_congr rfl
    intro x _
    by_cases hx : x.1 ∉ I.exponent.support
    · rw [dif_pos hx]
      apply Finset.sum_congr rfl
      intro y _
      by_cases hy : y.1 ∉ I.exponent.support
      · rw [dif_pos hy, faceResolutionDeletionPairTerm,
          dif_pos ⟨hx, hy⟩]
        rfl
      · rw [dif_neg hy, faceResolutionDeletionPairTerm,
          dif_neg (fun h ↦ hy h.2)]
    · rw [dif_neg hx]
      symm
      apply Finset.sum_eq_zero
      intro y _
      rw [faceResolutionDeletionPairTerm,
        dif_neg (fun h ↦ hx h.1)]]
  rw [← Fintype.sum_sigma (fun p : DeletionPair I.face.1 ↦
    faceResolutionDeletionPairTerm K C I p)]
  let term : DeletionPair I.face.1 → FaceResolutionTerm K C q :=
    faceResolutionDeletionPairTerm K C I
  have hcancel : ∀ p : DeletionPair I.face.1,
      term p + term (swapDeletionPair I.face.1 p) = 0 := by
    intro p
    dsimp [term]
    rw [faceResolutionDeletionPairTerm_swap]
    let z : FaceResolutionTerm K C q :=
      faceResolutionDeletionPairTerm K C I p
    calc
      z + z = (1 : K) • z + (1 : K) • z := by simp
      _ = ((1 : K) + 1) • z := by rw [add_smul]
      _ = 0 := by rw [CharTwo.add_self_eq_zero, zero_smul]
  simpa [term] using
    (Finset.sum_involution (s := Finset.univ) (f := term)
      (fun p _ ↦ swapDeletionPair I.face.1 p)
      (fun p _ ↦ hcancel p)
      (fun p _ _ ↦ swapDeletionPair_ne I.face.1 p)
      (fun _ _ ↦ Finset.mem_univ _)
      (fun p _ ↦ swapDeletionPair_involutive I.face.1 p))

theorem faceResolutionBoundary_boundary
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ) :
    (faceResolutionBoundary K C q).comp
      (faceResolutionBoundary K C (q + 1)) = 0 := by
  apply Finsupp.lhom_ext
  intro I a
  simp only [LinearMap.comp_apply, faceResolutionBoundary_single, map_smul,
    faceResolutionBoundary_boundary_onIndex, smul_zero, LinearMap.zero_apply]

def faceResolutionComplex
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) : ChainComplex (ModuleCat K) ℕ :=
  let X : ℕ → ModuleCat K :=
    fun q ↦ ModuleCat.of K (FaceResolutionTerm K C q)
  let d : ∀ q : ℕ, X (q + 1) ⟶ X q :=
    fun q ↦ ModuleCat.ofHom (faceResolutionBoundary K C q)
  ChainComplex.of X d (fun q ↦ by
    apply ModuleCat.hom_ext
    exact faceResolutionBoundary_boundary K C q)

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

section

/-!
# Augmented unnormalized singular chains

The ordinary unnormalized simplicial chain complex of the singular set is
shifted up by one cardinal degree.  Degree zero is one copy of the coefficient
field, and the new differential in degree one is the usual augmentation.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open AlgebraicTopology

namespace SimplicialSphereAnisotropicity.Topology

universe v

abbrev sSetChainComplex (K : Type v) [Field K] (X : SSet) :
    ChainComplex (ModuleCat K) ℕ :=
  X.chainComplex (ModuleCat.of K K)

/-- The augmentation of unnormalized simplicial zero-chains: every vertex is
sent to `1`. -/
noncomputable def sSetAugmentation (K : Type v) [Field K] (X : SSet) :
    (sSetChainComplex K X).X 0 ⟶ ModuleCat.of K K :=
  Sigma.desc (fun _ : X _⦋0⦌ ↦ 𝟙 (ModuleCat.of K K))

@[reassoc (attr := simp)]
theorem sSet_ι_augmentation (K : Type v) [Field K]
    (X : SSet) (x : X _⦋0⦌) :
    X.ιChainComplex x ≫ sSetAugmentation K X =
      𝟙 (ModuleCat.of K K) := by
  exact Sigma.ι_desc (fun _ : X _⦋0⦌ ↦ 𝟙 (ModuleCat.of K K)) x

/-- The alternating boundary of every one-simplex has total coefficient
zero. -/
theorem sSet_boundary_augmentation (K : Type v) [Field K] (X : SSet) :
    (sSetChainComplex K X).d 1 0 ≫ sSetAugmentation K X = 0 := by
  apply SSet.chainComplex_hom_ext
  intro x
  rw [← Category.assoc, SSet.ιChainComplex_d]
  simp

/-- Unnormalized simplicial chains with one formal augmented degree inserted
at cardinal degree zero. -/
noncomputable abbrev augmentedSSetChainComplex
    (K : Type v) [Field K] (X : SSet) :
    ChainComplex (ModuleCat K) ℕ :=
  (sSetChainComplex K X).augment (sSetAugmentation K X)
    (sSet_boundary_augmentation K X)

@[simp]
theorem augmentedSSetChainComplex_X_zero
    (K : Type v) [Field K] (X : SSet) :
    (augmentedSSetChainComplex K X).X 0 = ModuleCat.of K K := rfl

@[simp]
theorem augmentedSSetChainComplex_X_succ
    (K : Type v) [Field K] (X : SSet) (q : ℕ) :
    (augmentedSSetChainComplex K X).X (q + 1) =
      (sSetChainComplex K X).X q := rfl

@[simp]
theorem augmentedSSetChainComplex_d_one_zero
    (K : Type v) [Field K] (X : SSet) :
    (augmentedSSetChainComplex K X).d 1 0 = sSetAugmentation K X := rfl

@[simp]
theorem augmentedSSetChainComplex_d_succ_succ
    (K : Type v) [Field K] (X : SSet) (q r : ℕ) :
    (augmentedSSetChainComplex K X).d (q + 1) (r + 1) =
      (sSetChainComplex K X).d q r := by
  exact ChainComplex.augment_d_succ_succ _ _ _ q r

/-- The coproduct injection of a simplex, now placed in cardinal degree one
higher. -/
noncomputable def ιAugmentedSSet (K : Type v) [Field K]
    (X : SSet) {q : ℕ} (x : X _⦋q⦌) :
    ModuleCat.of K K ⟶ (augmentedSSetChainComplex K X).X (q + 1) :=
  X.ιChainComplex x

@[reassoc (attr := simp)]
theorem ιAugmentedSSet_d_one_zero (K : Type v) [Field K]
    (X : SSet) (x : X _⦋0⦌) :
    ιAugmentedSSet K X x ≫ (augmentedSSetChainComplex K X).d 1 0 =
      𝟙 (ModuleCat.of K K) := by
  exact sSet_ι_augmentation K X x

@[reassoc]
theorem ιAugmentedSSet_d_succ_succ (K : Type v) [Field K]
    (X : SSet) {q : ℕ} (x : X _⦋q + 1⦌) :
    ιAugmentedSSet K X x ≫
        (augmentedSSetChainComplex K X).d (q + 2) (q + 1) =
      ∑ i : Fin (q + 2),
        (-1) ^ i.val • ιAugmentedSSet K X (X.δ i x) := by
  change X.ιChainComplex x ≫
      (X.chainComplex (ModuleCat.of K K)).d (q + 1) q =
    ∑ i : Fin (q + 2),
      (-1) ^ i.val • X.ιChainComplex (X.δ i x)
  exact SSet.ιChainComplex_d X (ModuleCat.of K K) x

theorem sSetAugmentation_naturality (K : Type v) [Field K]
    {X Y : SSet} (f : X ⟶ Y) :
    (SSet.chainComplexMap f (ModuleCat.of K K)).f 0 ≫
        sSetAugmentation K Y = sSetAugmentation K X := by
  apply SSet.chainComplex_hom_ext
  intro x
  rw [← Category.assoc, SSet.ι_chainComplexMap_f,
    sSet_ι_augmentation, sSet_ι_augmentation]

/-- A simplicial map acts by the identity in augmented degree zero and by the
usual unnormalized chain map in successor degrees. -/
noncomputable def augmentedSSetMap (K : Type v) [Field K]
    {X Y : SSet} (f : X ⟶ Y) :
    augmentedSSetChainComplex K X ⟶ augmentedSSetChainComplex K Y where
  f
    | 0 => 𝟙 _
    | q + 1 => (SSet.chainComplexMap f (ModuleCat.of K K)).f q
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      simpa using sSetAugmentation_naturality K f
    · simp

@[simp]
theorem augmentedSSetMap_f_zero (K : Type v) [Field K]
    {X Y : SSet} (f : X ⟶ Y) :
    (augmentedSSetMap K f).f 0 = 𝟙 _ := rfl

@[simp]
theorem augmentedSSetMap_f_succ (K : Type v) [Field K]
    {X Y : SSet} (f : X ⟶ Y) (q : ℕ) :
    (augmentedSSetMap K f).f (q + 1) =
      (SSet.chainComplexMap f (ModuleCat.of K K)).f q := rfl

@[simp]
theorem augmentedSSetMap_id (K : Type v) [Field K] (X : SSet) :
    augmentedSSetMap K (𝟙 X) = 𝟙 (augmentedSSetChainComplex K X) := by
  apply HomologicalComplex.hom_ext
  intro q
  rcases q with _ | q
  · rfl
  · simp

@[simp]
theorem augmentedSSetMap_comp (K : Type v) [Field K]
    {X Y Z : SSet} (f : X ⟶ Y) (g : Y ⟶ Z) :
    augmentedSSetMap K (f ≫ g) =
      augmentedSSetMap K f ≫ augmentedSSetMap K g := by
  apply HomologicalComplex.hom_ext
  intro q
  rcases q with _ | q
  · simp
  · simp

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- A simplicial homotopy gives a chain homotopy after augmentation.  The
ordinary prism is shifted to successor degrees and is zero on the formal
empty generator. -/
noncomputable def augmentedSSetHomotopy (K : Type v) [Field K]
    {X Y : SSet} {f g : X ⟶ Y} (H : SSet.Homotopy f g) :
    _root_.Homotopy (augmentedSSetMap K f) (augmentedSSetMap K g) := by
  let h := H.chainComplexMap (ModuleCat.of K K)
  let hs : ∀ i j,
      (augmentedSSetChainComplex K X).X i ⟶
        (augmentedSSetChainComplex K Y).X j :=
    fun i j ↦ match i, j with
      | i + 1, j + 1 => h.hom i j
      | _, _ => 0
  refine
    { hom := hs
      zero := ?_
      comm := ?_ }
  · intro i j hij
    rcases i with _ | i <;> rcases j with _ | j
    · rfl
    · rfl
    · rfl
    · exact h.zero i j (by simpa using hij)
  · intro i
    rcases i with _ | i
    · simp [augmentedSSetMap, dNext, prevD, hs]
    · have hd : dNext (i + 1) hs = dNext i h.hom := by
        rw [dNext_nat, dNext_nat]
        rcases i with _ | i
        · simp [hs]
        · rfl
      have hp : prevD (i + 1) hs = prevD i h.hom := by
        rw [prevD_eq hs (show (ComplexShape.down ℕ).Rel (i + 2) (i + 1) by
          rfl)]
        rw [prevD_eq h.hom (show (ComplexShape.down ℕ).Rel (i + 1) i by
          rfl)]
        rfl
      rw [hd, hp]
      exact h.comm i

abbrev singularSSet (X : TopCat) : SSet := TopCat.toSSet.obj X

abbrev singularChainComplex (K : Type v) [Field K] (X : TopCat) :
    ChainComplex (ModuleCat K) ℕ := sSetChainComplex K (singularSSet X)

/-- The cardinal-graded augmented unnormalized singular chain complex. -/
noncomputable abbrev augmentedSingularChainComplex
    (K : Type v) [Field K] (X : TopCat) :
    ChainComplex (ModuleCat K) ℕ :=
  augmentedSSetChainComplex K (singularSSet X)

/-- The augmented singular chain map induced by a continuous map. -/
noncomputable def augmentedSingularMap (K : Type v) [Field K]
    {X Y : TopCat} (f : X ⟶ Y) :
    augmentedSingularChainComplex K X ⟶ augmentedSingularChainComplex K Y :=
  augmentedSSetMap K (TopCat.toSSet.map f)

@[simp]
theorem augmentedSingularMap_f_zero (K : Type v) [Field K]
    {X Y : TopCat} (f : X ⟶ Y) :
    (augmentedSingularMap K f).f 0 = 𝟙 _ := rfl

@[simp]
theorem augmentedSingularMap_f_succ (K : Type v) [Field K]
    {X Y : TopCat} (f : X ⟶ Y) (q : ℕ) :
    (augmentedSingularMap K f).f (q + 1) =
      (SSet.chainComplexMap (TopCat.toSSet.map f)
        (ModuleCat.of K K)).f q := rfl

/-- The augmented singular prism, zero on the formal empty generator. -/
noncomputable def augmentedSingularHomotopy (K : Type v) [Field K]
    {X Y : TopCat} {f g : X ⟶ Y} (H : TopCat.Homotopy f g) :
    _root_.Homotopy (augmentedSingularMap K f) (augmentedSingularMap K g) :=
  augmentedSSetHomotopy K H.toSSet

/-- Singular simplices whose images lie in one member of a cover form a
simplicial subcomplex. -/
noncomputable def smallSingularSubcomplex
    {X : TopCat} {I : Type*} (U : I → Set X) :
    (singularSSet X).Subcomplex where
  obj Δ := {s | ∃ i, Set.range (X.toSSetObjEquiv Δ s) ⊆ U i}
  map f s hs := by
    obtain ⟨i, hi⟩ := hs
    refine ⟨i, ?_⟩
    rintro _ ⟨z, rfl⟩
    exact hi ⟨stdSimplex.map f.unop z, by
      simpa using (TopCat.toSSetObjEquiv_naturality_apply f.unop s z).symm⟩

abbrev smallSingularSSet {X : TopCat} {I : Type*} (U : I → Set X) : SSet :=
  (smallSingularSubcomplex U).toSSet

noncomputable abbrev augmentedSmallSingularChainComplex
    (K : Type v) [Field K] {X : TopCat} {I : Type*} (U : I → Set X) :
    ChainComplex (ModuleCat K) ℕ :=
  augmentedSSetChainComplex K (smallSingularSSet U)

/-- Inclusion of augmented small singular chains into all augmented singular
chains. -/
noncomputable def augmentedSmallSingularInclusion
    (K : Type v) [Field K] {X : TopCat} {I : Type*} (U : I → Set X) :
    augmentedSmallSingularChainComplex K U ⟶
      augmentedSingularChainComplex K X :=
  augmentedSSetMap K (smallSingularSubcomplex U).ι

end SimplicialSphereAnisotropicity.Topology

end

