  have hcoeff := congrArg (MvPolynomial.coeff a) hvalue
  rw [MvPolynomial.coeff_homogeneousComponent, if_pos rfl,
    MvPolynomial.coeff_zero] at hcoeff
  exact (MvPolynomial.mem_support_iff.mp ha) hcoeff

