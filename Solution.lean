theorem faceBoundary_crossInclusion_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) (q + 1)) :
    faceBoundary K (crossAug (d + 1)) (q + 1)
        (crossInclusion K d (q + 1) (Finsupp.single F 1)) =
      crossInclusion K d q
        (faceBoundary K (crossAug d) q (Finsupp.single F 1)) := by
  simp only [crossInclusion_single, one_smul, crossIncludeOnSimplex,
    map_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastPos, boundaryOnSimplex_liftLastNeg]
  simp only [one_smul, boundaryOnSimplex, map_sum, crossInclusion_single,
    crossIncludeOnSimplex]
  let liftTerm : AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    Finsupp.single (liftCrossSimplex d F) 1
  let posTerm : ↥F.1 → AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    fun v ↦ Finsupp.single
      (liftLastPosSimplex d (eraseSimplex (crossAug d) F v)) 1
  let negTerm : ↥F.1 → AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    fun v ↦ Finsupp.single
      (liftLastNegSimplex d (eraseSimplex (crossAug d) F v)) 1
  change (liftTerm + ∑ v, posTerm v) + (liftTerm + ∑ v, negTerm v) =
    ∑ v, (posTerm v + negTerm v)
  rw [Finset.sum_add_distrib]
  calc
    (liftTerm + ∑ v, posTerm v) + (liftTerm + ∑ v, negTerm v) =
        (liftTerm + liftTerm) + ((∑ v, posTerm v) + ∑ v, negTerm v) := by
      abel
    _ = (∑ v, posTerm v) + ∑ v, negTerm v := by
      have hLift : liftTerm + liftTerm = 0 := by
        calc
          liftTerm + liftTerm =
              (1 : K) • liftTerm + (1 : K) • liftTerm := by simp
          _ = ((1 : K) + 1) • liftTerm := by rw [add_smul]
          _ = 0 • liftTerm := congrArg (fun a : K ↦ a • liftTerm)
            (CharTwo.add_self_eq_zero (1 : K))
          _ = 0 := zero_smul K liftTerm
      rw [hLift, zero_add]

theorem crossInclusion_boundary (K : Type*) [Field K] [CharP K 2]
    (d q : ℕ) :
    (faceBoundary K (crossAug (d + 1)) (q + 1)).comp
        (crossInclusion K d (q + 1)) =
      (crossInclusion K d q).comp (faceBoundary K (crossAug d) q) := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceBoundary_single,
    crossInclusion_single, map_smul]
  have h := faceBoundary_crossInclusion_single_one K d q F
  simp only [crossInclusion_single, one_smul, faceBoundary_single] at h
  rw [h]

theorem crossInclusion_boundary_zero (K : Type*) [Field K] [CharP K 2]
    (d : ℕ) :
    (faceBoundary K (crossAug (d + 1)) 0).comp
        (crossInclusion K d 0) = 0 := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, crossInclusion_single,
    crossIncludeOnSimplex, map_smul, map_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastPos_zero,
    boundaryOnSimplex_liftLastNeg_zero]
  simp only [one_smul, LinearMap.zero_apply]
  let x : AugmentedChain K (crossAug (d + 1)) 0 :=
    Finsupp.single (liftCrossSimplex d F) 1
  have hx : x + x = 0 := by
    calc
      x + x = (1 : K) • x + (1 : K) • x := by simp
      _ = ((1 : K) + 1) • x := by rw [add_smul]
      _ = 0 • x := congrArg (fun b : K ↦ b • x)
        (CharTwo.add_self_eq_zero (1 : K))
      _ = 0 := zero_smul K x
  change a • (x + x) = 0
  rw [hx, smul_zero]

@[simp]
theorem liftLastNegSimplex_projectLastNegSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1))
    (hn : crossLastNeg d ∈ F.1) :
    liftLastNegSimplex d (projectLastNegSimplex d F hn) = F := by
  apply Subtype.ext
  change insert (crossLastNeg d)
      (liftCrossFace d (lowerCrossFace d (F.1.erase (crossLastNeg d)))) = F.1
  have hpF : crossLastPos d ∉ F.1 :=
    lastPos_not_mem_of_lastNeg_mem d F.1 F.2.1 hn
  have hpE : crossLastPos d ∉ F.1.erase (crossLastNeg d) :=
    fun h ↦ hpF (Finset.mem_of_mem_erase h)
  have hnE : crossLastNeg d ∉ F.1.erase (crossLastNeg d) := by simp
  rw [liftCrossFace_lowerCrossFace_of_noLast d _ hpE hnE]
  exact Finset.insert_erase hn

@[simp]
theorem crossProjectOnSimplex_liftCross (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) (q + 1)) :
    crossProjectOnSimplex K d q (liftCrossSimplex d F) = 0 := by
  simp [crossProjectOnSimplex, liftCrossSimplex,
    lastNeg_not_mem_liftCrossFace]

theorem crossProjection_faceBoundary_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 2)) :
    crossProjection K d q
        (faceBoundary K (crossAug (d + 1)) (q + 1)
          (Finsupp.single F 1)) =
      faceBoundary K (crossAug d) q
        (crossProjection K d (q + 1) (Finsupp.single F 1)) := by
  by_cases hn : crossLastNeg d ∈ F.1
  · let G := projectLastNegSimplex d F hn
    have hF : liftLastNegSimplex d G = F :=
      liftLastNegSimplex_projectLastNegSimplex d F hn
    rw [← hF]
    simp only [faceBoundary_single, one_smul,
      boundaryOnSimplex_liftLastNeg, map_add, map_sum,
      crossProjection_single]
    simp [G, crossProjectOnSimplex_liftCross,
      crossProjectOnSimplex_liftLastNeg]
    rw [show crossProjectOnSimplex K d (q + 1) F =
        Finsupp.single G 1 by
      simp [crossProjectOnSimplex, hn, G]]
    simp [faceBoundary_single, boundaryOnSimplex, Finset.univ_eq_attach, G]
  · simp only [faceBoundary_single, one_smul, boundaryOnSimplex,
      map_sum, crossProjection_single]
    have hErase : ∀ v : ↥F.1,
        crossLastNeg d ∉
          (eraseSimplex (crossAug (d + 1)) F v).1 := by
      intro v hmem
      exact hn (Finset.mem_of_mem_erase hmem)
    simp [crossProjectOnSimplex, hn]

theorem crossProjection_boundary (K : Type*) [Field K] [CharP K 2]
    (d q : ℕ) :
    (crossProjection K d q).comp
        (faceBoundary K (crossAug (d + 1)) (q + 1)) =
      (faceBoundary K (crossAug d) q).comp
        (crossProjection K d (q + 1)) := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceBoundary_single,
    crossProjection_single, map_smul]
  have h := crossProjection_faceBoundary_single_one K d q F
  simp only [faceBoundary_single, one_smul, crossProjection_single] at h
  rw [h]

theorem lastNeg_not_mem_of_lastPos_mem (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1))))
    (hF : F ∈ crossAug (d + 1)) (hp : crossLastPos d ∈ F) :
    crossLastNeg d ∉ F := by
  intro hn
  exact crossAug_pair_condition (d + 1) F hF (Fin.last d)
    ⟨by simpa [crossLastPos] using hp, by simpa [crossLastNeg] using hn⟩

def projectLastPosSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1))
    (hp : crossLastPos d ∈ F.1) : AugmentedSimplex (crossAug d) q := by
  let E := F.1.erase (crossLastPos d)
  have hE : E ∈ crossAug (d + 1) :=
    (crossAug (d + 1)).erase_mem F.2.1 (crossLastPos d)
  have hnF : crossLastNeg d ∉ F.1 :=
    lastNeg_not_mem_of_lastPos_mem d F.1 F.2.1 hp
  have hpE : crossLastPos d ∉ E := by simp [E]
  have hnE : crossLastNeg d ∉ E := fun h ↦ hnF (Finset.mem_of_mem_erase h)
  refine ⟨lowerCrossFace d E, lowerCrossFace_mem d E hE, ?_⟩
  rw [card_lowerCrossFace_of_noLast d E hpE hnE,
    Finset.card_erase_of_mem hp, F.2.2]
  omega

@[simp]
theorem liftLastPosSimplex_projectLastPosSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1))
    (hp : crossLastPos d ∈ F.1) :
    liftLastPosSimplex d (projectLastPosSimplex d F hp) = F := by
  apply Subtype.ext
  change insert (crossLastPos d)
      (liftCrossFace d (lowerCrossFace d (F.1.erase (crossLastPos d)))) = F.1
  have hnF : crossLastNeg d ∉ F.1 :=
    lastNeg_not_mem_of_lastPos_mem d F.1 F.2.1 hp
  have hpE : crossLastPos d ∉ F.1.erase (crossLastPos d) := by simp
  have hnE : crossLastNeg d ∉ F.1.erase (crossLastPos d) :=
    fun h ↦ hnF (Finset.mem_of_mem_erase h)
  rw [liftCrossFace_lowerCrossFace_of_noLast d _ hpE hnE]
  exact Finset.insert_erase hp

def lowerCrossSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) q)
    (hp : crossLastPos d ∉ F.1) (hn : crossLastNeg d ∉ F.1) :
    AugmentedSimplex (crossAug d) q :=
  ⟨lowerCrossFace d F.1, lowerCrossFace_mem d F.1 F.2.1,
    (card_lowerCrossFace_of_noLast d F.1 hp hn).trans F.2.2⟩

@[simp]
theorem liftCrossSimplex_lowerCrossSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) q)
    (hp : crossLastPos d ∉ F.1) (hn : crossLastNeg d ∉ F.1) :
    liftCrossSimplex d (lowerCrossSimplex d F hp hn) = F := by
  apply Subtype.ext
  exact liftCrossFace_lowerCrossFace_of_noLast d F.1 hp hn

@[simp]
theorem lowerCrossSimplex_liftCrossSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q)
    (hp : crossLastPos d ∉ (liftCrossSimplex d F).1)
    (hn : crossLastNeg d ∉ (liftCrossSimplex d F).1) :
    lowerCrossSimplex d (liftCrossSimplex d F) hp hn = F := by
  apply Subtype.ext
  exact lowerCrossFace_liftCrossFace d F.1

@[simp]
theorem coneLastPosSimplex_eq_liftLastPos_lower (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) q)
    (hp : crossLastPos d ∉ F.1) (hn : crossLastNeg d ∉ F.1) :
    coneLastPosSimplex d F hp hn =
      liftLastPosSimplex d (lowerCrossSimplex d F hp hn) := by
  apply Subtype.ext
  change insert (crossLastPos d) F.1 =
    insert (crossLastPos d) (liftCrossFace d (lowerCrossFace d F.1))
  rw [liftCrossFace_lowerCrossFace_of_noLast d F.1 hp hn]

@[simp]
theorem crossConeOnSimplex_liftCross (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossConeOnSimplex K d q (liftCrossSimplex d F) =
      Finsupp.single (liftLastPosSimplex d F) 1 := by
  have hp : crossLastPos d ∉ (liftCrossSimplex d F).1 := by
    simp [liftCrossSimplex]
  have hn : crossLastNeg d ∉ (liftCrossSimplex d F).1 := by
    simp [liftCrossSimplex]
  unfold crossConeOnSimplex
  rw [dif_neg hp, dif_neg hn,
    coneLastPosSimplex_eq_liftLastPos_lower]
  congr 2
  exact lowerCrossSimplex_liftCrossSimplex d F hp hn

@[simp]
theorem crossConeOnSimplex_liftLastPos (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossConeOnSimplex K d (q + 1) (liftLastPosSimplex d F) = 0 := by
  simp [crossConeOnSimplex, liftLastPosSimplex]

@[simp]
theorem crossConeOnSimplex_liftLastNeg (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossConeOnSimplex K d (q + 1) (liftLastNegSimplex d F) = 0 := by
  simp [crossConeOnSimplex, liftLastNegSimplex]

theorem crossCone_equation_liftCross_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) (q + 1)) :
    faceBoundary K (crossAug (d + 1)) (q + 1)
        (crossCone K d (q + 1)
          (Finsupp.single (liftCrossSimplex d F) 1)) +
      crossCone K d q
        (faceBoundary K (crossAug (d + 1)) q
          (Finsupp.single (liftCrossSimplex d F) 1)) =
      Finsupp.single (liftCrossSimplex d F) 1 +
        crossInclusion K d q
          (crossProjection K d q
            (Finsupp.single (liftCrossSimplex d F) 1)) := by
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftCross,
    faceBoundary_single]
  rw [boundaryOnSimplex_liftLastPos, boundaryOnSimplex_liftCross]
  simp only [map_sum, crossCone_single, one_smul,
    crossConeOnSimplex_liftCross, crossProjection_single,
    crossProjectOnSimplex_liftCross, map_zero, add_zero]
  let repeated : AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    ∑ v : ↥F.1,
      Finsupp.single
        (liftLastPosSimplex d (eraseSimplex (crossAug d) F v)) 1
  change (Finsupp.single (liftCrossSimplex d F) 1 + repeated) + repeated =
    Finsupp.single (liftCrossSimplex d F) 1
  have hRepeated : repeated + repeated = 0 := by
    calc
      repeated + repeated =
          (1 : K) • repeated + (1 : K) • repeated := by simp
      _ = ((1 : K) + 1) • repeated := by rw [add_smul]
      _ = 0 • repeated := congrArg (fun a : K ↦ a • repeated)
        (CharTwo.add_self_eq_zero (1 : K))
      _ = 0 := zero_smul K repeated
  calc
    (Finsupp.single (liftCrossSimplex d F) 1 + repeated) + repeated =
        Finsupp.single (liftCrossSimplex d F) 1 +
          (repeated + repeated) :=
      add_assoc _ _ _
    _ = Finsupp.single (liftCrossSimplex d F) 1 + 0 :=
      congrArg (Finsupp.single (liftCrossSimplex d F) 1 + ·) hRepeated
    _ = Finsupp.single (liftCrossSimplex d F) 1 :=
      add_zero _

theorem crossCone_equation_liftLastPos_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) (q + 1)) :
    faceBoundary K (crossAug (d + 1)) (q + 2)
        (crossCone K d (q + 2)
          (Finsupp.single (liftLastPosSimplex d F) 1)) +
      crossCone K d (q + 1)
        (faceBoundary K (crossAug (d + 1)) (q + 1)
          (Finsupp.single (liftLastPosSimplex d F) 1)) =
      Finsupp.single (liftLastPosSimplex d F) 1 +
        crossInclusion K d (q + 1)
          (crossProjection K d (q + 1)
            (Finsupp.single (liftLastPosSimplex d F) 1)) := by
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftLastPos,
    map_zero, zero_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastPos]
  simp [map_add, map_sum, crossCone_single,
    crossConeOnSimplex_liftCross, crossConeOnSimplex_liftLastPos,
    crossProjection_single, crossProjectOnSimplex_liftLastPos]

theorem crossCone_equation_liftLastNeg_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) (q + 1)) :
    faceBoundary K (crossAug (d + 1)) (q + 2)
        (crossCone K d (q + 2)
          (Finsupp.single (liftLastNegSimplex d F) 1)) +
      crossCone K d (q + 1)
        (faceBoundary K (crossAug (d + 1)) (q + 1)
          (Finsupp.single (liftLastNegSimplex d F) 1)) =
      Finsupp.single (liftLastNegSimplex d F) 1 +
        crossInclusion K d (q + 1)
          (crossProjection K d (q + 1)
            (Finsupp.single (liftLastNegSimplex d F) 1)) := by
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftLastNeg,
    map_zero, zero_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastNeg]
  simp only [map_add, map_sum, crossCone_single, one_smul,
    crossConeOnSimplex_liftCross, crossConeOnSimplex_liftLastNeg,
    Finset.sum_const_zero, add_zero, crossProjection_single,
    crossProjectOnSimplex_liftLastNeg,
    crossInclusion_single, crossIncludeOnSimplex]
  let neg : AugmentedChain K (crossAug (d + 1)) (q + 2) :=
    Finsupp.single (liftLastNegSimplex d F) 1
  let pos : AugmentedChain K (crossAug (d + 1)) (q + 2) :=
    Finsupp.single (liftLastPosSimplex d F) 1
  change pos = neg + (pos + neg)
  have hNeg : neg + neg = 0 := by
    calc
      neg + neg = (1 : K) • neg + (1 : K) • neg := by simp
      _ = ((1 : K) + 1) • neg := by rw [add_smul]
      _ = 0 • neg := congrArg (fun a : K ↦ a • neg)
        (CharTwo.add_self_eq_zero (1 : K))
      _ = 0 := zero_smul K neg
  calc
    pos = pos + 0 := (add_zero pos).symm
    _ = pos + (neg + neg) := congrArg (pos + ·) hNeg.symm
    _ = neg + (pos + neg) := by abel

theorem crossCone_equation_single_one
    (K : Type*) [Field K] [CharP K 2] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 2)) :
    faceBoundary K (crossAug (d + 1)) (q + 2)
        (crossCone K d (q + 2) (Finsupp.single F 1)) +
      crossCone K d (q + 1)
        (faceBoundary K (crossAug (d + 1)) (q + 1)
          (Finsupp.single F 1)) =
      Finsupp.single F 1 +
        crossInclusion K d (q + 1)
          (crossProjection K d (q + 1) (Finsupp.single F 1)) := by
  by_cases hp : crossLastPos d ∈ F.1
  · let G := projectLastPosSimplex d F hp
    have hF : liftLastPosSimplex d G = F :=
      liftLastPosSimplex_projectLastPosSimplex d F hp
    rw [← hF]
    exact crossCone_equation_liftLastPos_single_one K d q G
  · by_cases hn : crossLastNeg d ∈ F.1
    · let G := projectLastNegSimplex d F hn
      have hF : liftLastNegSimplex d G = F :=
        liftLastNegSimplex_projectLastNegSimplex d F hn
      rw [← hF]
      exact crossCone_equation_liftLastNeg_single_one K d q G
    · let G := lowerCrossSimplex d F hp hn
      have hF : liftCrossSimplex d G = F :=
        liftCrossSimplex_lowerCrossSimplex d F hp hn
      rw [← hF]
      exact crossCone_equation_liftCross_single_one K d (q + 1) G

theorem crossCone_equation (K : Type*) [Field K] [CharP K 2]
    (d q : ℕ) :
    (faceBoundary K (crossAug (d + 1)) (q + 2)).comp
          (crossCone K d (q + 2)) +
        (crossCone K d (q + 1)).comp
          (faceBoundary K (crossAug (d + 1)) (q + 1)) =
      LinearMap.id +
        (crossInclusion K d (q + 1)).comp
          (crossProjection K d (q + 1)) := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.add_apply, LinearMap.comp_apply,
    crossCone_single, faceBoundary_single, crossProjection_single,
    LinearMap.id_apply, map_smul]
  have h := crossCone_equation_single_one K d q F
  simp only [crossCone_single, one_smul, faceBoundary_single,
    crossProjection_single] at h
  rw [← smul_add, h]
  simp only [smul_add, Finsupp.smul_single, smul_eq_mul, mul_one]

theorem crossCone_boundary_zero_single_one
    (K : Type*) [Field K] [CharP K 2] (d : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) 0) :
    faceBoundary K (crossAug (d + 1)) 0
        (crossCone K d 0 (Finsupp.single F 1)) =
      Finsupp.single F 1 := by
  have hEmpty : F.1 = ∅ := Finset.card_eq_zero.mp F.2.2
  have hp : crossLastPos d ∉ F.1 := by simp [hEmpty]
  have hn : crossLastNeg d ∉ F.1 := by simp [hEmpty]
  let G := lowerCrossSimplex d F hp hn
  have hF : liftCrossSimplex d G = F :=
    liftCrossSimplex_lowerCrossSimplex d F hp hn
  rw [← hF]
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftCross,
    faceBoundary_single]
  exact boundaryOnSimplex_liftLastPos_zero K d G

theorem crossCone_boundary_zero (K : Type*) [Field K] [CharP K 2]
    (d : ℕ) :
    (faceBoundary K (crossAug (d + 1)) 0).comp (crossCone K d 0) =
      LinearMap.id := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, crossCone_single,
    LinearMap.id_apply, map_smul]
  have h := crossCone_boundary_zero_single_one K d F
  simp only [crossCone_single, one_smul] at h
  rw [h]
  simp only [Finsupp.smul_single, smul_eq_mul, mul_one]

theorem crossCone_equation_liftLastPos_zero_single_one
    (K : Type*) [Field K] [CharP K 2] (d : ℕ)
    (F : AugmentedSimplex (crossAug d) 0) :
    faceBoundary K (crossAug (d + 1)) 1
        (crossCone K d 1
          (Finsupp.single (liftLastPosSimplex d F) 1)) +
      crossCone K d 0
        (faceBoundary K (crossAug (d + 1)) 0
          (Finsupp.single (liftLastPosSimplex d F) 1)) =
      Finsupp.single (liftLastPosSimplex d F) 1 +
        crossInclusion K d 0
          (crossProjection K d 0
            (Finsupp.single (liftLastPosSimplex d F) 1)) := by
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftLastPos,
    map_zero, zero_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastPos_zero]
  simp [crossCone_single, crossConeOnSimplex_liftCross,
    crossProjection_single, crossProjectOnSimplex_liftLastPos]

theorem crossCone_equation_liftLastNeg_zero_single_one
    (K : Type*) [Field K] [CharP K 2] (d : ℕ)
    (F : AugmentedSimplex (crossAug d) 0) :
    faceBoundary K (crossAug (d + 1)) 1
        (crossCone K d 1
          (Finsupp.single (liftLastNegSimplex d F) 1)) +
      crossCone K d 0
        (faceBoundary K (crossAug (d + 1)) 0
          (Finsupp.single (liftLastNegSimplex d F) 1)) =
      Finsupp.single (liftLastNegSimplex d F) 1 +
        crossInclusion K d 0
          (crossProjection K d 0
            (Finsupp.single (liftLastNegSimplex d F) 1)) := by
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftLastNeg,
    map_zero, zero_add, faceBoundary_single]
  rw [boundaryOnSimplex_liftLastNeg_zero]
  simp only [crossCone_single, one_smul, crossConeOnSimplex_liftCross,
    crossProjection_single, crossProjectOnSimplex_liftLastNeg,
    crossInclusion_single, crossIncludeOnSimplex]
  let neg : AugmentedChain K (crossAug (d + 1)) 1 :=
    Finsupp.single (liftLastNegSimplex d F) 1
  let pos : AugmentedChain K (crossAug (d + 1)) 1 :=
    Finsupp.single (liftLastPosSimplex d F) 1
  change pos = neg + (pos + neg)
  have hNeg : neg + neg = 0 := by
    calc
      neg + neg = (1 : K) • neg + (1 : K) • neg := by simp
      _ = ((1 : K) + 1) • neg := by rw [add_smul]
      _ = 0 • neg := congrArg (fun a : K ↦ a • neg)
        (CharTwo.add_self_eq_zero (1 : K))
      _ = 0 := zero_smul K neg
  calc
    pos = pos + 0 := (add_zero pos).symm
    _ = pos + (neg + neg) := congrArg (pos + ·) hNeg.symm
    _ = neg + (pos + neg) := by abel

theorem crossCone_equation_one_single_one
    (K : Type*) [Field K] [CharP K 2] (d : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) 1) :
    faceBoundary K (crossAug (d + 1)) 1
        (crossCone K d 1 (Finsupp.single F 1)) +
      crossCone K d 0
        (faceBoundary K (crossAug (d + 1)) 0 (Finsupp.single F 1)) =
      Finsupp.single F 1 +
        crossInclusion K d 0
          (crossProjection K d 0 (Finsupp.single F 1)) := by
  by_cases hp : crossLastPos d ∈ F.1
  · let G := projectLastPosSimplex d F hp
    have hF : liftLastPosSimplex d G = F :=
      liftLastPosSimplex_projectLastPosSimplex d F hp
    rw [← hF]
    exact crossCone_equation_liftLastPos_zero_single_one K d G
  · by_cases hn : crossLastNeg d ∈ F.1
    · let G := projectLastNegSimplex d F hn
      have hF : liftLastNegSimplex d G = F :=
        liftLastNegSimplex_projectLastNegSimplex d F hn
      rw [← hF]
      exact crossCone_equation_liftLastNeg_zero_single_one K d G
    · let G := lowerCrossSimplex d F hp hn
      have hF : liftCrossSimplex d G = F :=
        liftCrossSimplex_lowerCrossSimplex d F hp hn
      rw [← hF]
      exact crossCone_equation_liftCross_single_one K d 0 G

theorem crossCone_equation_one (K : Type*) [Field K] [CharP K 2]
    (d : ℕ) :
    (faceBoundary K (crossAug (d + 1)) 1).comp (crossCone K d 1) +
        (crossCone K d 0).comp
          (faceBoundary K (crossAug (d + 1)) 0) =
      LinearMap.id +
        (crossInclusion K d 0).comp (crossProjection K d 0) := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.add_apply, LinearMap.comp_apply,
    crossCone_single, faceBoundary_single, crossProjection_single,
    LinearMap.id_apply, map_smul]
  have h := crossCone_equation_one_single_one K d F
  simp only [crossCone_single, one_smul, faceBoundary_single,
    crossProjection_single] at h
  rw [← smul_add, h]
  simp only [smul_add, Finsupp.smul_single, smul_eq_mul, mul_one]

theorem crossCone_equation_succ (K : Type*) [Field K] [CharP K 2]
    (d r : ℕ) :
    (faceBoundary K (crossAug (d + 1)) (r + 1)).comp
          (crossCone K d (r + 1)) +
        (crossCone K d r).comp
          (faceBoundary K (crossAug (d + 1)) r) =
      LinearMap.id +
        (crossInclusion K d r).comp (crossProjection K d r) := by
  rcases r with _ | q
  · exact crossCone_equation_one K d
  · exact crossCone_equation K d q

universe u v

noncomputable def faceChainXIso
    (K : Type u) [Field K] [CharP K 2]
    {V : Type v} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    (faceChainComplex K C).X q ≅
      ModuleCat.of K (AugmentedChain K C q) := by
  change ModuleCat.of K (AugmentedChain K C q) ≅
    ModuleCat.of K (AugmentedChain K C q)
  exact Iso.refl _

theorem faceChain_d_eq_conjugated
    (K : Type u) [Field K] [CharP K 2]
    {V : Type v} [DecidableEq V] (C : AugmentedComplex V) (q : ℕ) :
    (faceChainXIso K C (q + 1)).hom ≫
        ModuleCat.ofHom (faceBoundary K C q) ≫
          (faceChainXIso K C q).inv =
      (faceChainComplex K C).d (q + 1) q := by
  unfold faceChainXIso
  rw [faceChainComplex_d]
  simp

noncomputable def crossStepProjectionComponent
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    ∀ q,
      (faceChainComplex K (crossAug (d + 1))).X q ⟶
        (cardinalSuspension K (faceChainComplex K (crossAug d))).X q
  | 0 => 0
  | q + 1 =>
      (faceChainXIso K (crossAug (d + 1)) (q + 1)).hom ≫
        ModuleCat.ofHom (crossProjection K d q) ≫
          (faceChainXIso K (crossAug d) q).inv ≫
            (cardinalSuspensionXIso K
              (faceChainComplex K (crossAug d)) q).inv

noncomputable def crossStepProjectionHom
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    faceChainComplex K (crossAug (d + 1)) ⟶
      cardinalSuspension K (faceChainComplex K (crossAug d)) where
  f := crossStepProjectionComponent K d
  comm' i j hij := by
    rw [ComplexShape.down_Rel] at hij
    subst i
    rcases j with _ | q
    · exact (cardinalSuspensionXZero_isZero K
        (faceChainComplex K (crossAug d))).eq_of_tgt _ _
    · change crossStepProjectionComponent K d (q + 2) ≫
          (cardinalSuspension K (faceChainComplex K (crossAug d))).d
            (q + 2) (q + 1) =
        (faceChainComplex K (crossAug (d + 1))).d (q + 2) (q + 1) ≫
          crossStepProjectionComponent K d (q + 1)
      rw [cardinalSuspension_d_eq]
      have hraw :
          ModuleCat.ofHom (crossProjection K d (q + 1)) ≫
              ModuleCat.ofHom (faceBoundary K (crossAug d) q) =
            ModuleCat.ofHom
                (faceBoundary K (crossAug (d + 1)) (q + 1)) ≫
              ModuleCat.ofHom (crossProjection K d q) := by
        simpa only [ModuleCat.ofHom_comp] using
          congrArg (fun f ↦ ModuleCat.ofHom f)
            (crossProjection_boundary K d q).symm
      rw [← faceChain_d_eq_conjugated K (crossAug d) q,
        ← faceChain_d_eq_conjugated K (crossAug (d + 1)) (q + 1)]
      simp only [crossStepProjectionComponent, Category.assoc,
        Iso.inv_hom_id_assoc]
      apply (cancel_epi
        (faceChainXIso K (crossAug (d + 1)) (q + 2)).hom).2
      simpa only [Category.assoc] using
        congrArg
          (fun f ↦ f ≫ (faceChainXIso K (crossAug d) q).inv ≫
            (cardinalSuspensionXIso K
              (faceChainComplex K (crossAug d)) q).inv) hraw

noncomputable def crossStepInclusionComponent
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    ∀ q,
      (cardinalSuspension K (faceChainComplex K (crossAug d))).X q ⟶
        (faceChainComplex K (crossAug (d + 1))).X q
  | 0 => 0
  | q + 1 =>
      (cardinalSuspensionXIso K
        (faceChainComplex K (crossAug d)) q).hom ≫
        (faceChainXIso K (crossAug d) q).hom ≫
          ModuleCat.ofHom (crossInclusion K d q) ≫
            (faceChainXIso K (crossAug (d + 1)) (q + 1)).inv

noncomputable def crossStepInclusionHom
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    cardinalSuspension K (faceChainComplex K (crossAug d)) ⟶
      faceChainComplex K (crossAug (d + 1)) where
  f := crossStepInclusionComponent K d
  comm' i j hij := by
    rw [ComplexShape.down_Rel] at hij
    subst i
    rcases j with _ | q
    · change crossStepInclusionComponent K d 1 ≫
          (faceChainComplex K (crossAug (d + 1))).d 1 0 = 0
      rw [← faceChain_d_eq_conjugated K (crossAug (d + 1)) 0]
      simp only [crossStepInclusionComponent, Category.assoc,
        Iso.inv_hom_id_assoc]
      have hraw :
          ModuleCat.ofHom (crossInclusion K d 0) ≫
              ModuleCat.ofHom
                (faceBoundary K (crossAug (d + 1)) 0) = 0 := by
        apply ModuleCat.hom_ext
        simpa only [ModuleCat.hom_comp, ModuleCat.hom_ofHom,
          ModuleCat.hom_zero] using crossInclusion_boundary_zero K d
      simpa only [Category.assoc, comp_zero, zero_comp] using
        congrArg
          (fun f ↦
            (cardinalSuspensionXIso K
              (faceChainComplex K (crossAug d)) 0).hom ≫
              (faceChainXIso K (crossAug d) 0).hom ≫ f ≫
                (faceChainXIso K (crossAug (d + 1)) 0).inv) hraw
    · change crossStepInclusionComponent K d (q + 2) ≫
          (faceChainComplex K (crossAug (d + 1))).d
            (q + 2) (q + 1) =
        (cardinalSuspension K (faceChainComplex K (crossAug d))).d
            (q + 2) (q + 1) ≫
          crossStepInclusionComponent K d (q + 1)
      rw [cardinalSuspension_d_eq]
      have hraw :
          ModuleCat.ofHom (crossInclusion K d (q + 1)) ≫
              ModuleCat.ofHom
                (faceBoundary K (crossAug (d + 1)) (q + 1)) =
            ModuleCat.ofHom (faceBoundary K (crossAug d) q) ≫
              ModuleCat.ofHom (crossInclusion K d q) := by
        simpa only [ModuleCat.ofHom_comp] using
          congrArg (fun f ↦ ModuleCat.ofHom f)
            (crossInclusion_boundary K d q)
      rw [← faceChain_d_eq_conjugated K (crossAug d) q,
        ← faceChain_d_eq_conjugated K (crossAug (d + 1)) (q + 1)]
      simp only [crossStepInclusionComponent, Category.assoc,
        Iso.inv_hom_id_assoc]
      apply (cancel_epi
        (cardinalSuspensionXIso K
          (faceChainComplex K (crossAug d)) (q + 1)).hom).2
      apply (cancel_epi
        (faceChainXIso K (crossAug d) (q + 1)).hom).2
      simpa only [Category.assoc] using
        congrArg
          (fun f ↦ f ≫
            (faceChainXIso K (crossAug (d + 1)) (q + 1)).inv) hraw

theorem crossStep_inclusion_projection
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    crossStepInclusionHom K d ≫ crossStepProjectionHom K d =
      𝟙 (cardinalSuspension K (faceChainComplex K (crossAug d))) := by
  apply HomologicalComplex.hom_ext
  intro q
  rcases q with _ | q
  · exact (cardinalSuspensionXZero_isZero K
      (faceChainComplex K (crossAug d))).eq_of_src _ _
  · simp only [HomologicalComplex.comp_f, HomologicalComplex.id_f,
      crossStepInclusionHom, crossStepProjectionHom,
      crossStepInclusionComponent, crossStepProjectionComponent]
    have hraw :
        ModuleCat.ofHom (crossInclusion K d q) ≫
            ModuleCat.ofHom (crossProjection K d q) = 𝟙 _ := by
      simpa only [ModuleCat.ofHom_comp, ModuleCat.ofHom_id] using
        congrArg (fun f ↦ ModuleCat.ofHom f)
          (crossProjection_comp_crossInclusion K d q)
    have hfull := congrArg
        (fun f ↦
          (cardinalSuspensionXIso K
            (faceChainComplex K (crossAug d)) q).hom ≫
            (faceChainXIso K (crossAug d) q).hom ≫ f ≫
              (faceChainXIso K (crossAug d) q).inv ≫
                (cardinalSuspensionXIso K
                  (faceChainComplex K (crossAug d)) q).inv) hraw
    refine hfull.trans ?_
    let eS := cardinalSuspensionXIso K
      (faceChainComplex K (crossAug d)) q
    let eF := faceChainXIso K (crossAug d) q
    calc
      eS.hom ≫ eF.hom ≫ eF.inv ≫ eS.inv =
          eS.hom ≫ eS.inv := by
        simpa only [Category.assoc, Category.id_comp, Category.comp_id] using
          congrArg (fun f ↦ eS.hom ≫ f ≫ eS.inv) eF.hom_inv_id
      _ = 𝟙 _ := eS.hom_inv_id

noncomputable def crossStepConeComponent
    (K : Type u) [Field K] [CharP K 2] (d q : ℕ) :
    (faceChainComplex K (crossAug (d + 1))).X q ⟶
      (faceChainComplex K (crossAug (d + 1))).X (q + 1) :=
  (faceChainXIso K (crossAug (d + 1)) q).hom ≫
    ModuleCat.ofHom (crossCone K d q) ≫
      (faceChainXIso K (crossAug (d + 1)) (q + 1)).inv

noncomputable def crossStepConeHom
    (K : Type u) [Field K] [CharP K 2] (d i j : ℕ) :
    (faceChainComplex K (crossAug (d + 1))).X i ⟶
      (faceChainComplex K (crossAug (d + 1))).X j := by
  by_cases h : j = i + 1
  · subst j
    exact crossStepConeComponent K d i
  · exact 0

@[simp]
theorem crossStepConeHom_succ
    (K : Type u) [Field K] [CharP K 2] (d i : ℕ) :
    crossStepConeHom K d i (i + 1) = crossStepConeComponent K d i := by
  unfold crossStepConeHom
  simp
  rfl

theorem crossStepCone_boundary_zero
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    crossStepConeComponent K d 0 ≫
        (faceChainComplex K (crossAug (d + 1))).d 1 0 =
      𝟙 _ := by
  have hraw :
      ModuleCat.ofHom (crossCone K d 0) ≫
          ModuleCat.ofHom (faceBoundary K (crossAug (d + 1)) 0) =
        𝟙 _ := by
    simpa only [ModuleCat.ofHom_comp, ModuleCat.ofHom_id] using
      congrArg (fun f ↦ ModuleCat.ofHom f)
        (crossCone_boundary_zero K d)
  rw [← faceChain_d_eq_conjugated K (crossAug (d + 1)) 0]
  simp only [crossStepConeComponent, Category.assoc,
    Iso.inv_hom_id_assoc]
  have hfull := congrArg
    (fun f ↦ (faceChainXIso K (crossAug (d + 1)) 0).hom ≫
      f ≫ (faceChainXIso K (crossAug (d + 1)) 0).inv) hraw
  refine hfull.trans ?_
  exact (faceChainXIso K (crossAug (d + 1)) 0).hom_inv_id

theorem crossStepCone_equation_succ
    (K : Type u) [Field K] [CharP K 2] (d r : ℕ) :
    crossStepConeComponent K d (r + 1) ≫
          (faceChainComplex K (crossAug (d + 1))).d (r + 2) (r + 1) +
        (faceChainComplex K (crossAug (d + 1))).d (r + 1) r ≫
          crossStepConeComponent K d r =
      𝟙 _ +
        (crossStepProjectionHom K d ≫ crossStepInclusionHom K d).f
          (r + 1) := by
  have hraw :
      ModuleCat.ofHom (crossCone K d (r + 1)) ≫
            ModuleCat.ofHom
              (faceBoundary K (crossAug (d + 1)) (r + 1)) +
          ModuleCat.ofHom (faceBoundary K (crossAug (d + 1)) r) ≫
            ModuleCat.ofHom (crossCone K d r) =
        𝟙 _ +
          ModuleCat.ofHom (crossProjection K d r) ≫
            ModuleCat.ofHom (crossInclusion K d r) := by
    apply ModuleCat.hom_ext
    simpa only [ModuleCat.hom_add, ModuleCat.hom_comp,
      ModuleCat.hom_ofHom, ModuleCat.hom_id] using
        crossCone_equation_succ K d r
  let e := faceChainXIso K (crossAug (d + 1)) (r + 1)
  have hfull := congrArg (fun f ↦ e.hom ≫ f ≫ e.inv) hraw
  dsimp only [e] at hfull
  rw [← faceChain_d_eq_conjugated K (crossAug (d + 1)) r,
    ← faceChain_d_eq_conjugated K (crossAug (d + 1)) (r + 1)]
  simpa only [crossStepConeComponent, HomologicalComplex.comp_f,
    crossStepProjectionHom, crossStepInclusionHom,
    crossStepProjectionComponent, crossStepInclusionComponent,
    Preadditive.comp_add, Preadditive.add_comp, Category.assoc,
    Category.id_comp, Category.comp_id, Iso.inv_hom_id_assoc,
    Iso.hom_inv_id] using hfull

noncomputable def crossStepHomotopy
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    _root_.Homotopy
      (crossStepProjectionHom K d ≫ crossStepInclusionHom K d)
      (𝟙 (faceChainComplex K (crossAug (d + 1)))) where
  hom := crossStepConeHom K d
  zero i j hij := by
    unfold crossStepConeHom
    split
    · rename_i h
      exfalso
      apply hij
      rw [ComplexShape.down_Rel]
      exact h.symm
    · rfl
  comm i := by
    rcases i with _ | r
    · rw [dNext_nat]
      rw [prevD_eq _
        (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
      simp only [HomologicalComplex.comp_f,
        crossStepProjectionHom, crossStepInclusionHom,
        crossStepProjectionComponent, crossStepInclusionComponent,
        HomologicalComplex.id_f, crossStepConeHom_succ, zero_comp]
      change 0 =
        (faceChainComplex K (crossAug (d + 1))).d 0 0 ≫
            crossStepConeHom K d 0 0 +
          crossStepConeComponent K d 0 ≫
            (faceChainComplex K (crossAug (d + 1))).d 1 0 + 𝟙 _
      have hd : (faceChainComplex K (crossAug (d + 1))).d 0 0 = 0 :=
        (faceChainComplex K (crossAug (d + 1))).shape 0 0 (by
          simp [ComplexShape.down_Rel])
      rw [hd, zero_comp, zero_add]
      rw [crossStepCone_boundary_zero]
      exact (charTwo_module_add_self_eq_zero K (𝟙 _)).symm
    · rw [dNext_nat]
      rw [prevD_eq _
        (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)]
      rw [show r + 1 - 1 = r by omega]
      simp only [HomologicalComplex.id_f]
      have hcone :
          crossStepConeHom K d (r + 1) (r + 2) =
            crossStepConeComponent K d (r + 1) := by
        unfold crossStepConeHom
        simp
        rfl
      rw [crossStepConeHom_succ K d r, hcone]
      let f :=
        (crossStepProjectionHom K d ≫ crossStepInclusionHom K d).f
          (r + 1)
      let e :
          (faceChainComplex K (crossAug (d + 1))).X (r + 1) ⟶
            (faceChainComplex K (crossAug (d + 1))).X (r + 1) := 𝟙 _
      have heq := crossStepCone_equation_succ K d r
      have hId : e + e = 0 := charTwo_module_add_self_eq_zero K e
      change f =
        (faceChainComplex K (crossAug (d + 1))).d (r + 1) r ≫
            crossStepConeComponent K d r +
          crossStepConeComponent K d (r + 1) ≫
            (faceChainComplex K (crossAug (d + 1))).d
              (r + 2) (r + 1) + e
      calc
        f = f + 0 := (add_zero f).symm
        _ = f + (e + e) := congrArg (f + ·) hId.symm
        _ = (e + f) + e := by abel
        _ = (crossStepConeComponent K d (r + 1) ≫
                (faceChainComplex K (crossAug (d + 1))).d
                  (r + 2) (r + 1) +
              (faceChainComplex K (crossAug (d + 1))).d (r + 1) r ≫
                crossStepConeComponent K d r) + e := by rw [heq]
        _ = (faceChainComplex K (crossAug (d + 1))).d (r + 1) r ≫
                crossStepConeComponent K d r +
              crossStepConeComponent K d (r + 1) ≫
                (faceChainComplex K (crossAug (d + 1))).d
                  (r + 2) (r + 1) + e := by abel

noncomputable def crossStepHomotopyEquiv
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    HomotopyEquiv
      (faceChainComplex K (crossAug (d + 1)))
      (cardinalSuspension K (faceChainComplex K (crossAug d))) where
  hom := crossStepProjectionHom K d
  inv := crossStepInclusionHom K d
  homotopyHomInvId := crossStepHomotopy K d
  homotopyInvHomId := Homotopy.ofEq (crossStep_inclusion_projection K d)

noncomputable def crossSingleHomotopyEquiv
    (K : Type u) [Field K] [CharP K 2] :
    (d : ℕ) →
      HomotopyEquiv
        (faceChainComplex K (crossAug d))
        ((HomologicalComplex.single (ModuleCat K) (.down ℕ) d).obj
          (ModuleCat.of K K))
  | 0 => crossZeroHomotopyEquiv K
  | d + 1 =>
      (crossStepHomotopyEquiv K d).trans
        ((cardinalSuspensionHomotopyEquiv K
            (crossSingleHomotopyEquiv K d)).trans
          (HomotopyEquiv.ofIso (cardinalSuspensionSingleIso K d)))

noncomputable def crossTopHomologyIso
    (K : Type u) [Field K] [CharP K 2] (d : ℕ) :
    (faceChainComplex K (crossAug d)).homology d ≅ ModuleCat.of K K :=
  (crossSingleHomotopyEquiv K d).toHomologyIso d ≪≫
    HomologicalComplex.singleObjHomologySelfIso (.down ℕ) d
      (ModuleCat.of K K)

theorem crossHomology_isZero
    (K : Type u) [Field K] [CharP K 2] (d q : ℕ) (hq : q ≠ d) :
    IsZero ((faceChainComplex K (crossAug d)).homology q) := by
  exact IsZero.of_iso
    (HomologicalComplex.isZero_single_obj_homology (.down ℕ) d
      (ModuleCat.of K K) q hq)
    ((crossSingleHomotopyEquiv K d).toHomologyIso q)

noncomputable def simplicialSphereCrossHomotopyEquiv
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    HomotopyEquiv
      (faceChainComplex K (AugmentedComplex.ofAbstract D))
      (faceChainComplex K (crossAug (n + 1))) :=
  faceSphereCrossHomotopyEquiv K D hD
    (finiteAffineComparison K D.toPreAbstractSimplicialComplex)
    (finiteAffineComparison K
      (crosspolytope (n + 1)).toPreAbstractSimplicialComplex)

noncomputable def simplicialSphereSingleHomotopyEquiv
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    HomotopyEquiv
      (faceChainComplex K (AugmentedComplex.ofAbstract D))
      ((HomologicalComplex.single (ModuleCat K) (.down ℕ) (n + 1)).obj
        (ModuleCat.of K K)) :=
  (simplicialSphereCrossHomotopyEquiv K D hD).trans
    (crossSingleHomotopyEquiv K (n + 1))

noncomputable def simplicialSphereTopHomologyIso
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    (faceChainComplex K (AugmentedComplex.ofAbstract D)).homology (n + 1) ≅
      ModuleCat.of K K :=
  (simplicialSphereSingleHomotopyEquiv K D hD).toHomologyIso (n + 1) ≪≫
    HomologicalComplex.singleObjHomologySelfIso (.down ℕ) (n + 1)
      (ModuleCat.of K K)

theorem simplicialSphereHomology_isZero
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) (q : ℕ) (hq : q ≠ n + 1) :
    IsZero
      ((faceChainComplex K (AugmentedComplex.ofAbstract D)).homology q) := by
  exact IsZero.of_iso
    (HomologicalComplex.isZero_single_obj_homology (.down ℕ) (n + 1)
      (ModuleCat.of K K) q hq)
    ((simplicialSphereSingleHomotopyEquiv K D hD).toHomologyIso q)

end SimplicialSphereAnisotropicity.Topology

end

