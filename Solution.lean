    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous (K_ReductionTopDegree k n m)
      (AugmentedComplex.ofAbstract D) (r i) (b i)) :
    Module.finrank (K_ReductionTopDegree k n m)
      (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D 0) = 1 := by
  letI : Module (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D) :=
    faceRingModelCanonicalModule k D
  let b0 := quotientDegreeBasis k D (by omega)
    (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_ReductionTopDegree k n m) hn D hD)
    b r hb
    (sphereFaceRingBrionResidueGramMatrix_det_isUnit
      k hn D hD b r hb) 0
  calc
    Module.finrank (K_ReductionTopDegree k n m)
        (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D 0) =
        Fintype.card (DegreeIndex r 0) :=
      Module.finrank_eq_card_basis b0
    _ = 1 := degreeIndex_zero_card_of_homogeneous_faceRingModel_basis
      k D b r hb

set_option linter.style.haveILetI false in
theorem sphere_quotientDegree_top_finrank_eq_one
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous (K_ReductionTopDegree k n m)
      (AugmentedComplex.ofAbstract D) (r i) (b i)) :
    Module.finrank (K_ReductionTopDegree k n m)
      (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D (n + 1)) = 1 := by
  letI : Module (T_ReductionTopDegree k n m) (Model_ReductionTopDegree k n m D) :=
    faceRingModelCanonicalModule k D
  let p := quotientDegreeBrionPairing k D (by omega)
    (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_ReductionTopDegree k n m) hn D hD) 0 (n + 1)
  have hp : p.IsPerfPair := sphereQuotientDegreeBrionPairing_isPerfPair
    k hn D hD b r hb (by omega)
  let b0 := quotientDegreeBasis k D (by omega)
    (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_ReductionTopDegree k n m) hn D hD)
    b r hb
    (sphereFaceRingBrionResidueGramMatrix_det_isUnit
      k hn D hD b r hb) 0
  letI : FiniteDimensional (K_ReductionTopDegree k n m)
      (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D 0) :=
    b0.finiteDimensional_of_finite
  letI : p.IsPerfPair := hp
  calc
    Module.finrank (K_ReductionTopDegree k n m)
        (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D (n + 1)) =
        Module.finrank (K_ReductionTopDegree k n m)
          (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D 0) :=
      (Module.finrank_of_isPerfPair p).symm
    _ = 1 := sphere_quotientDegree_zero_finrank_eq_one
      k hn D hD b r hb

end SimplicialSphereAnisotropicity.Generic.Brion

