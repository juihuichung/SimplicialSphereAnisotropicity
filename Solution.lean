/-!
# The graded canonical parameter action

Canonical parameter multiplication on the allowed-exponent model is ambient
multiplication followed by restriction to face-supported exponents.  This
description proves that homogeneous parameter multiplication adds total
degrees.
-/

noncomputable section

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

theorem faceRingModelToStanleyReisner_polynomialFacePart
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : MvPolynomial (Fin m) K) :
    faceRingModelToStanleyReisner K D
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p) =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D) p := by
  change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D)
      (faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p)) =
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D) p
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  simpa only [neg_sub] using
    (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D).neg_mem
      (polynomial_sub_facePart_mem_stanleyReisnerIdeal K D p)

set_option linter.style.haveILetI false in
theorem faceRingModelCanonical_smul_eq_facePart
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : Generic.ParameterRing k n m)
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    p • z = polynomialFacePart
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (ambientParameterAlgHom k p *
        faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) z) := by
  letI : Algebra (Generic.ParameterRing k n m)
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
    stanleyReisnerParameterAlgebra k D
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  apply faceRingModelToStanleyReisner_injective
    (SimplicialSphereAnisotropicity.GenericField k n m) D
  calc
    faceRingModelToStanleyReisner (SimplicialSphereAnisotropicity.GenericField k n m) D (p • z) =
        p • faceRingModelToStanleyReisner
          (SimplicialSphereAnisotropicity.GenericField k n m) D z := by
      exact (faceRingModelCanonicalLinearEquiv k D).map_smul p z
    _ = Ideal.Quotient.mk
        (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D)
        (ambientParameterAlgHom k p *
          faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) z) := by
      rw [Algebra.smul_def,
        stanleyReisnerParameterAlgebra_algebraMap_apply]
      rfl
    _ = faceRingModelToStanleyReisner (SimplicialSphereAnisotropicity.GenericField k n m) D
        (polynomialFacePart
          (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
          (ambientParameterAlgHom k p *
            faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
              (AugmentedComplex.ofAbstract D) z)) :=
      (faceRingModelToStanleyReisner_polynomialFacePart
        (SimplicialSphereAnisotropicity.GenericField k n m) D _).symm

theorem faceRingModelToPolynomial_isHomogeneous
    (K : Type u) [Field K] {m r : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceRingModel K C)
    (hz : FaceRingModelHomogeneous K C r z) :
    (faceRingModelToPolynomial K C z).IsHomogeneous r := by
  intro a ha
  have hface : a.support ∈ C := by
    by_contra hnot
    exact ha (faceRingModelToPolynomial_apply_not_allowed K C z a hnot)
  let a' : AllowedExponent C := ⟨a, hface⟩
  have ha' : a' ∈ z.support := by
    rw [Finsupp.mem_support_iff]
    rw [← faceRingModelToPolynomial_apply_allowed K C z a']
    exact ha
  have hdegree := hz a' ha'
  rw [Finsupp.degree_eq_weight_one] at hdegree
  exact hdegree

theorem polynomialFacePart_isHomogeneous
    (K : Type u) [Field K] {m r : ℕ}
    (C : AugmentedComplex (Fin m))
    (p : MvPolynomial (Fin m) K) (hp : p.IsHomogeneous r) :
    FaceRingModelHomogeneous K C r (polynomialFacePart K C p) := by
  intro a ha
  rw [Finsupp.degree_eq_weight_one]
  apply hp
  rw [← polynomialFacePart_apply K C p a]
  exact Finsupp.mem_support_iff.mp ha

theorem ambientParameterAlgHom_isHomogeneous
    (k : Type u) [Field k] {n m s : ℕ}
    (p : Generic.ParameterRing k n m) (hp : p.IsHomogeneous s) :
    (ambientParameterAlgHom k p).IsHomogeneous s := by
  rw [ambientParameterAlgHom]
  simpa only [one_mul] using hp.aeval
    (fun i ↦ SimplicialSphereAnisotropicity.genericLinearForm k (n := n) (m := m) i)
    (fun i ↦ SimplicialSphereAnisotropicity.genericLinearForm_isHomogeneous k i)

set_option linter.style.haveILetI false in
theorem faceRingModelHomogeneous_parameter_smul
    (k : Type u) [Field k] {n m r s : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : Generic.ParameterRing k n m) (z : FaceRingModel
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D))
    (hp : p.IsHomogeneous s)
    (hz : FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) r z) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (s + r) (p • z) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  rw [faceRingModelCanonical_smul_eq_facePart]
  apply polynomialFacePart_isHomogeneous
  exact (ambientParameterAlgHom_isHomogeneous k p hp).mul
    (faceRingModelToPolynomial_isHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) z hz)

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

