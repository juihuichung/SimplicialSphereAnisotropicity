    faceRingModelCanonicalModule k D
  calc
    (∑ i, if r i ≤ q then
        (n + 1).multichoose (q - r i) else 0) =
        Fintype.card (WeightedFreeDegreeIndex (n + 1) N r q) :=
      (card_weightedFreeDegreeIndex (n + 1) N r q).symm
    _ = Fintype.card (FaceRingDegreeIndex
          (AugmentedComplex.ofAbstract D) q) :=
      homogeneous_faceRingModel_basis_degree_card_eq k D b r hb q
    _ = ∑ F : ComplexFace (AugmentedComplex.ofAbstract D),
