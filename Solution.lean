  obtain ⟨a, ha⟩ := MvPolynomial.support_nonempty.mpr hi
  refine ⟨r i + a.degree, ?_⟩
  intro hzero
  have hvalue := congrFun hzero i
  rw [weightedFreeComponent_apply] at hvalue
  have hri : r i ≤ r i + a.degree := Nat.le_add_right _ _
  rw [dif_pos hri, Nat.add_sub_cancel_left] at hvalue
