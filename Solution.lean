          (AugmentedComplex.ofAbstract D)))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (r i) (b i)) :
    IsUnit (faceRingBrionResidueGramMatrix k D (by omega)
      (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
        (SimplicialSphereAnisotropicity.GenericField k n m) hn D hD) b) :=
  (Matrix.isUnit_iff_isUnit_det _).mpr
    (sphereFaceRingBrionResidueGramMatrix_det_isUnit
      k hn D hD b r hb)

set_option linter.style.haveILetI false in
theorem faceRingBrionResidueGramMatrix_apply_eq_zero_of_degree_ne
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    [Nonempty (FacetOfCard D (n + 1))]
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (r i) (b i))
    (i j : Fin N) (hdegree : r i + r j ≠ n + 1) :
    faceRingBrionResidueGramMatrix k D hd hpm b i j = 0 := by
  rw [faceRingBrionResidueGramMatrix_apply]
  by_cases hlt : r i + r j < n + 1
  · rw [faceRingBrionGramMatrix_apply_eq_zero_of_lt
      k D hd hpm b r hb i j hlt]
    exact map_zero _
  · apply MvPolynomial.constantCoeff_eq_zero_of_isHomogeneous_pos
      (faceRingBrionGramMatrix_apply_isHomogeneous
        k D hd hpm b r hb i j)
    omega

set_option linter.style.haveILetI false in
theorem sphereFaceRingBrionResidueGramMatrix_apply_eq_zero_of_degree_ne
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (r i) (b i))
    (i j : Fin N) (hdegree : r i + r j ≠ n + 1) :
    faceRingBrionResidueGramMatrix k D (by omega)
        (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
          (SimplicialSphereAnisotropicity.GenericField k n m) hn D hD) b i j = 0 := by
  obtain ⟨F, hFD, hFcard⟩ := hD.1.2
  letI : Nonempty (FacetOfCard D (n + 1)) :=
    ⟨⟨F, hFD, hFcard⟩⟩
  exact faceRingBrionResidueGramMatrix_apply_eq_zero_of_degree_ne
    k D (by omega)
      (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
        (SimplicialSphereAnisotropicity.GenericField k n m) hn D hD)
      b r hb i j hdegree

abbrev DegreeIndex {N : ℕ} (r : Fin N → ℕ) (q : ℕ) :=
  {i : Fin N // r i = q}

noncomputable def degreeBlockMatrix
    {K : Type*} [Field K] {N : ℕ}
    (G : Matrix (Fin N) (Fin N) K) (r : Fin N → ℕ) (q s : ℕ) :
    Matrix (DegreeIndex r q) (DegreeIndex r s) K :=
  G.submatrix Subtype.val Subtype.val

theorem degreeBlockMatrix_mulVec_injective
    {K : Type*} [Field K] {N d : ℕ}
    (G : Matrix (Fin N) (Fin N) K) (r : Fin N → ℕ)
    (hunit : IsUnit G.det)
    (horth : ∀ i j, r i + r j ≠ d → G i j = 0)
    (q : ℕ) (hq : q ≤ d) :
    Function.Injective
      (degreeBlockMatrix G r (d - q) q).mulVec := by
  classical
  change Function.Injective
    (degreeBlockMatrix G r (d - q) q).mulVecLin
  rw [← LinearMap.ker_eq_bot]
  rw [Matrix.ker_mulVecLin_eq_bot_iff]
  intro x hx
  let xfull : Fin N → K := fun j ↦
    if hj : r j = q then x ⟨j, hj⟩ else 0
  have hxfullzero : G *ᵥ xfull = 0 := by
    funext i
    by_cases hi : r i + q = d
    · let ii : DegreeIndex r (d - q) := ⟨i, by omega⟩
      have hrow :
          (∑ j : DegreeIndex r q, G i j.1 * x j) = 0 := by
        simpa only [degreeBlockMatrix, Matrix.mulVec, Pi.zero_apply,
          dotProduct, Matrix.submatrix_apply] using congrFun hx ii
      change (∑ j : Fin N, G i j * xfull j) = 0
      have hpos :
          (∑ j : DegreeIndex r q, G i j.1 * xfull j.1) =
            ∑ j : DegreeIndex r q, G i j.1 * x j := by
        apply Fintype.sum_congr
        intro j
        simp [xfull, j.2]
      have hneg :
          (∑ j : {j : Fin N // ¬r j = q}, G i j.1 * xfull j.1) = 0 := by
        apply Finset.sum_eq_zero
        intro j _hj
        simp [xfull, j.2]
      calc
        (∑ j : Fin N, G i j * xfull j) =
            (∑ j : DegreeIndex r q, G i j.1 * xfull j.1) +
              ∑ j : {j : Fin N // ¬r j = q}, G i j.1 * xfull j.1 :=
          (Fintype.sum_subtype_add_sum_subtype
            (fun j : Fin N ↦ r j = q)
            (fun j ↦ G i j * xfull j)).symm
        _ = ∑ j : DegreeIndex r q, G i j.1 * x j := by
          rw [hpos, hneg, add_zero]
        _ = 0 := hrow
    · simp only [Matrix.mulVec, Pi.zero_apply]
      apply Finset.sum_eq_zero
      intro j _hj
      change G i j * xfull j = 0
      by_cases hjq : r j = q
      · simp [xfull, hjq, horth i j (by omega)]
      · simp [xfull, hjq]
  have hfullinj : Function.Injective G.mulVec :=
    Matrix.mulVec_injective_iff_isUnit.mpr
      ((Matrix.isUnit_iff_isUnit_det G).mpr hunit)
  have hxfull : xfull = 0 := by
    apply hfullinj
    simpa using hxfullzero
  funext i
  have hi := congrFun hxfull i.1
  simpa [xfull, i.2] using hi

theorem degreeBlockMatrix_mulVec_injective_of_add
    {K : Type*} [Field K] {N d q s : ℕ}
    (G : Matrix (Fin N) (Fin N) K) (r : Fin N → ℕ)
    (hunit : IsUnit G.det)
    (horth : ∀ i j, r i + r j ≠ d → G i j = 0)
    (hqs : q + s = d) :
    Function.Injective (degreeBlockMatrix G r q s).mulVec := by
  subst d
  have h := degreeBlockMatrix_mulVec_injective
    G r hunit horth s (by omega)
  have hsub : q + s - s = q := by omega
  rw [← hsub]
  exact h

noncomputable def degreeBlockPairing
    {K : Type*} [Field K] {N : ℕ}
    (G : Matrix (Fin N) (Fin N) K) (r : Fin N → ℕ) (q s : ℕ) :
    (DegreeIndex r q → K) →ₗ[K] (DegreeIndex r s → K) →ₗ[K] K :=
  Matrix.toLinearMap₂' K (degreeBlockMatrix G r q s)

theorem degreeBlockPairing_isPerfPair
    {K : Type*} [Field K] {N d q s : ℕ}
    (G : Matrix (Fin N) (Fin N) K) (r : Fin N → ℕ)
    (hunit : IsUnit G.det)
    (horth : ∀ i j, r i + r j ≠ d → G i j = 0)
    (hqs : q + s = d) :
    (degreeBlockPairing G r q s).IsPerfPair := by
  classical
  let B := degreeBlockMatrix G r q s
  have hright : B.SeparatingRight :=
    Matrix.separatingRight_iff_forall_mulVec_eq_zero.mpr
      (fun v hv ↦ degreeBlockMatrix_mulVec_injective_of_add
        G r hunit horth hqs (by simpa using hv))
  have hunitT : IsUnit G.transpose.det := by
    simpa using hunit
  have horthT : ∀ i j, r i + r j ≠ d → G.transpose i j = 0 := by
    intro i j hij
    exact horth j i (by omega)
  have hleft : B.SeparatingLeft := by
    rw [← Matrix.separatingRight_transpose_iff]
    have hinj : Function.Injective
        (degreeBlockMatrix G.transpose r s q).mulVec :=
      degreeBlockMatrix_mulVec_injective_of_add
        G.transpose r hunitT horthT (by omega)
    have hsep : (degreeBlockMatrix G.transpose r s q).SeparatingRight :=
      Matrix.separatingRight_iff_forall_mulVec_eq_zero.mpr
        (fun v hv ↦ hinj (by simpa using hv))
    simpa [B, degreeBlockMatrix] using hsep
  have hpnd : (degreeBlockPairing G r q s).Nondegenerate :=
    Matrix.Nondegenerate.toLinearMap₂' ⟨hleft, hright⟩
  apply LinearMap.IsPerfPair.of_injective
  · rw [← LinearMap.ker_eq_bot]
    exact LinearMap.separatingLeft_iff_ker_eq_bot.mp hpnd.1
  · rw [← LinearMap.ker_eq_bot]
    exact LinearMap.separatingRight_iff_flip_ker_eq_bot.mp hpnd.2

end SimplicialSphereAnisotropicity.Generic.Brion

end

