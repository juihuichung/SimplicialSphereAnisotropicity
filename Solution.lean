section

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

private abbrev K_TopStress (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev S_TopStress (k : Type u) [Field k] (n m : ℕ) :=
  MvPolynomial (Fin m) (K_TopStress k n m)

noncomputable def reductionBrionFunctional
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D →ₗ[K_TopStress k n m] K_TopStress k n m :=
  (reductionBrionPairing k D hd hpm).flip 1

@[simp]
theorem reductionBrionFunctional_mk
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (p : S_TopStress k n m) :
    reductionBrionFunctional k D hd hpm
        (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p) =
      MvPolynomial.constantCoeff
        (brionPolynomial (K_TopStress k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) p) := by
  change reductionBrionPairing k D hd hpm
      (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p) 1 = _
  rw [show (1 : SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D) =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) 1 by rfl,
    reductionBrionPairing_mk_mk, mul_one]

theorem reductionBrionFunctional_faceMonomial
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    reductionBrionFunctional k D hd hpm
        (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
          (SimplicialSphereAnisotropicity.faceMonomial F.1)) =
      (Generic.faceMinor k F.1 F.2.2)⁻¹ := by
  rw [reductionBrionFunctional_mk,
    genericBrionPolynomial_faceMonomial,
    MvPolynomial.constantCoeff_C]

noncomputable def topStressCoefficient
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (ρ : Fin m →₀ ℕ) : K_TopStress k n m :=
  reductionBrionFunctional k D hd hpm
    (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (MvPolynomial.monomial ρ 1))

@[simp]
theorem topStressCoefficient_squarefree_facet
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    topStressCoefficient k D hd hpm (squarefreeExponent F.1) =
      (Generic.faceMinor k F.1 F.2.2)⁻¹ := by
  rw [topStressCoefficient,
    ← faceMonomial_eq_monomial_squarefreeExponent,
    reductionBrionFunctional_faceMonomial]

theorem topStressCoefficient_eq_zero_of_support_not_face
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (ρ : Fin m →₀ ℕ)
    (hρ : ρ.support ∉ AugmentedComplex.ofAbstract D) :
    topStressCoefficient k D hd hpm ρ = 0 := by
  have hmem : MvPolynomial.monomial ρ (1 : K_TopStress k n m) ∈
      SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K_TopStress k n m) D := by
    rw [mem_stanleyReisnerIdeal_iff_support_not_face]
    intro α hα
    have hρα : ρ = α := by
      simpa using hα
    have hαρ : α = ρ := by
      exact hρα.symm
    subst α
    exact hρ
  have hzero : Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (MvPolynomial.monomial ρ (1 : K_TopStress k n m)) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_sup_left hmem
  rw [topStressCoefficient, hzero, map_zero]

private theorem genericLinearForm_monomial_term_TopStress
    (k : Type u) [Field k] {n m : ℕ}
    (i : Fin (n + 1)) (s : Fin m →₀ ℕ) (v : Fin m) :
    (MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v) *
        MvPolynomial.X v) * MvPolynomial.monomial s 1 =
      SimplicialSphereAnisotropicity.genericCoefficient k i v •
        MvPolynomial.monomial (s + Finsupp.single v 1) 1 := by
  calc
    (MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v) *
        MvPolynomial.X v) * MvPolynomial.monomial s 1 =
        MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v) *
          (MvPolynomial.X v * MvPolynomial.monomial s 1) := by
      rw [mul_assoc]
    _ = MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v) *
        MvPolynomial.monomial (s + Finsupp.single v 1) 1 := by
      congr 1
      calc
        MvPolynomial.X v * MvPolynomial.monomial s 1 =
            MvPolynomial.X v ^ 1 * MvPolynomial.monomial s 1 := by
          rw [pow_one]
        _ = MvPolynomial.monomial (Finsupp.single v 1 + s) 1 :=
          (MvPolynomial.monomial_single_add (R := K_TopStress k n m)).symm
        _ = MvPolynomial.monomial (s + Finsupp.single v 1) 1 := by
          exact congrArg
            (fun t : Fin m →₀ ℕ ↦
              MvPolynomial.monomial t (1 : K_TopStress k n m))
            (add_comm (Finsupp.single v 1 : Fin m →₀ ℕ) s)
    _ = SimplicialSphereAnisotropicity.genericCoefficient k i v •
        MvPolynomial.monomial (s + Finsupp.single v 1) 1 := by
      rw [MvPolynomial.smul_eq_C_mul]

theorem topStressCoefficient_equilibrium
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (s : Fin m →₀ ℕ) (i : Fin (n + 1)) :
    (∑ v : Fin m, SimplicialSphereAnisotropicity.genericCoefficient k i v *
      topStressCoefficient k D hd hpm
        (s + Finsupp.single v 1)) = 0 := by
  let W := reductionBrionFunctional k D hd hpm
  let I := SimplicialSphereAnisotropicity.genericReductionIdeal k (n := n) D
  let Q : S_TopStress k n m →ₗ[K_TopStress k n m]
      SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
    (Ideal.Quotient.mkₐ (K_TopStress k n m) I).toLinearMap
  have hzero : Q
      (SimplicialSphereAnisotropicity.genericLinearForm k i * MvPolynomial.monomial s 1) = 0 := by
    change Ideal.Quotient.mk I
      (SimplicialSphereAnisotropicity.genericLinearForm k i * MvPolynomial.monomial s 1) = 0
    rw [map_mul, genericLinearForm_mk_reduction_eq_zero, zero_mul]
  have hW := congrArg W hzero
  rw [map_zero] at hW
  change W (Q
      ((∑ v : Fin m,
          MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v) *
            MvPolynomial.X v) * MvPolynomial.monomial s 1)) = 0 at hW
  rw [Finset.sum_mul, map_sum] at hW
  rw [map_sum] at hW
  simp_rw [genericLinearForm_monomial_term_TopStress] at hW
  have hterm (v : Fin m) :
      W (Q
        (SimplicialSphereAnisotropicity.genericCoefficient k i v •
          MvPolynomial.monomial (s + Finsupp.single v 1) 1)) =
        SimplicialSphereAnisotropicity.genericCoefficient k i v *
          topStressCoefficient k D hd hpm
            (s + Finsupp.single v 1) := by
    rw [map_smul, map_smul]
    rfl
  calc
    (∑ v : Fin m, SimplicialSphereAnisotropicity.genericCoefficient k i v *
        topStressCoefficient k D hd hpm
          (s + Finsupp.single v 1)) =
        ∑ v : Fin m, W (Q
          (SimplicialSphereAnisotropicity.genericCoefficient k i v •
            MvPolynomial.monomial (s + Finsupp.single v 1) 1)) := by
      apply Fintype.sum_congr
      intro v
      exact (hterm v).symm
    _ = 0 := hW

theorem topStressCoefficient_equilibrium_vector
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (s : Fin m →₀ ℕ) :
    (∑ v : Fin m,
      topStressCoefficient k D hd hpm
          (s + Finsupp.single v 1) •
        SimplicialSphereAnisotropicity.Generic.genericColumn (n := n) (m := m) k v) = 0 := by
  funext i
  simp only [Finset.sum_apply, Pi.smul_apply, Pi.zero_apply,
    SimplicialSphereAnisotropicity.Generic.genericColumn]
  simpa only [smul_eq_mul, mul_comm] using
    topStressCoefficient_equilibrium k D hd hpm s i

end SimplicialSphereAnisotropicity.Generic.Brion

end

end

section

/-!
# Square-free spanning in the trusted generic reduction

Facet-coordinate pivot relations remove repeated variables from homogeneous
monomials.  Strong induction on degree minus support cardinality proves that
every homogeneous quotient class is spanned by square-free face monomials,
and identifies that span with the exact trusted homogeneous submodule.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic

universe u

private abbrev K_SquarefreeSpanning (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev S_SquarefreeSpanning (k : Type u) [Field k] (n m : ℕ) :=
  MvPolynomial (Fin m) (K_SquarefreeSpanning k n m)

noncomputable def facetPivotCoefficient
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) (w : Fin m) : K_SquarefreeSpanning k n m :=
  ∑ i : Fin (n + 1),
    (faceCoefficientMatrix k F hF)⁻¹ j i *
      SimplicialSphereAnisotropicity.genericCoefficient k i w

@[simp]
theorem facetPivotCoefficient_orderedFaceEmbedding
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j l : Fin (n + 1)) :
    facetPivotCoefficient k F hF j (orderedFaceEmbedding F hF l) =
      if j = l then 1 else 0 := by
  change (∑ i : Fin (n + 1),
      (faceCoefficientMatrix k F hF)⁻¹ j i *
        faceCoefficientMatrix k F hF i l) = _
  rw [← Matrix.mul_apply,
    Matrix.nonsing_inv_mul (faceCoefficientMatrix k F hF)
      (faceCoefficientMatrix_isUnit_det k F hF)]
  rfl

noncomputable def facetPivotPolynomial
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) : S_SquarefreeSpanning k n m :=
  ∑ w : Fin m,
    MvPolynomial.C (facetPivotCoefficient k F hF j w) *
      MvPolynomial.X w

theorem facetPivotParameterCombination
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) :
    (∑ i : Fin (n + 1),
      MvPolynomial.C ((faceCoefficientMatrix k F hF)⁻¹ j i) *
        SimplicialSphereAnisotropicity.genericLinearForm k (m := m) i) =
      facetPivotPolynomial k F hF j := by
  rw [facetPivotPolynomial]
  simp_rw [SimplicialSphereAnisotropicity.genericLinearForm, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Fintype.sum_congr
  intro w
  rw [facetPivotCoefficient]
  simp_rw [← mul_assoc, ← MvPolynomial.C_mul]
  rw [← Finset.sum_mul, ← map_sum]

theorem facetPivotPolynomial_mk_reduction_eq_zero
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (facetPivotPolynomial k F hF j) = 0 := by
  rw [← facetPivotParameterCombination]
  rw [map_sum]
  apply Finset.sum_eq_zero
  intro i _hi
  rw [map_mul,
    SimplicialSphereAnisotropicity.Generic.Brion.genericLinearForm_mk_reduction_eq_zero,
    mul_zero]

private theorem facetPivotPolynomial_monomial_term_SquarefreeSpanning
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) (b : Fin m →₀ ℕ) (w : Fin m) :
    (MvPolynomial.C (facetPivotCoefficient k F hF j w) *
        MvPolynomial.X w) * MvPolynomial.monomial b 1 =
      facetPivotCoefficient k F hF j w •
        MvPolynomial.monomial (b + Finsupp.single w 1) 1 := by
  calc
    (MvPolynomial.C (facetPivotCoefficient k F hF j w) *
        MvPolynomial.X w) * MvPolynomial.monomial b 1 =
        MvPolynomial.C (facetPivotCoefficient k F hF j w) *
          (MvPolynomial.X w * MvPolynomial.monomial b 1) := by
      rw [mul_assoc]
    _ = MvPolynomial.C (facetPivotCoefficient k F hF j w) *
        MvPolynomial.monomial (b + Finsupp.single w 1) 1 := by
      congr 1
      calc
        MvPolynomial.X w * MvPolynomial.monomial b 1 =
            MvPolynomial.X w ^ 1 * MvPolynomial.monomial b 1 := by
          rw [pow_one]
        _ = MvPolynomial.monomial (Finsupp.single w 1 + b) 1 :=
          (MvPolynomial.monomial_single_add (R := K_SquarefreeSpanning k n m)).symm
        _ = MvPolynomial.monomial (b + Finsupp.single w 1) 1 := by
          exact congrArg
            (fun t : Fin m →₀ ℕ ↦
              MvPolynomial.monomial t (1 : K_SquarefreeSpanning k n m))
            (add_comm (Finsupp.single w 1 : Fin m →₀ ℕ) b)
    _ = facetPivotCoefficient k F hF j w •
        MvPolynomial.monomial (b + Finsupp.single w 1) 1 := by
      rw [MvPolynomial.smul_eq_C_mul]

theorem facetPivot_monomial_relation
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) (b : Fin m →₀ ℕ) :
    (∑ w : Fin m, facetPivotCoefficient k F hF j w •
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k (n := n) D)
        (MvPolynomial.monomial (b + Finsupp.single w 1) 1)) = 0 := by
  let I := SimplicialSphereAnisotropicity.genericReductionIdeal k (n := n) D
  let Q : S_SquarefreeSpanning k n m →ₗ[K_SquarefreeSpanning k n m]
      SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
    (Ideal.Quotient.mkₐ (K_SquarefreeSpanning k n m) I).toLinearMap
  have hzero : Q
      (facetPivotPolynomial k F hF j * MvPolynomial.monomial b 1) = 0 := by
    change Ideal.Quotient.mk I
      (facetPivotPolynomial k F hF j * MvPolynomial.monomial b 1) = 0
    rw [map_mul, facetPivotPolynomial_mk_reduction_eq_zero, zero_mul]
  rw [facetPivotPolynomial, Finset.sum_mul, map_sum] at hzero
  simp_rw [facetPivotPolynomial_monomial_term_SquarefreeSpanning, map_smul] at hzero
  exact hzero

theorem squarefreeExponent_degree {m : ℕ} (F : Finset (Fin m)) :
    (squarefreeExponent F).degree = F.card := by
  rw [Finsupp.degree_apply, squarefreeExponent_support]
  simp [squarefreeExponent_apply]

theorem finsupp_card_support_le_degree
    {α : Type*} [DecidableEq α] (a : α →₀ ℕ) :
    a.support.card ≤ a.degree := by
  rw [Finsupp.degree_apply]
  calc
    a.support.card = ∑ v ∈ a.support, 1 := by simp
    _ ≤ ∑ v ∈ a.support, a v := by
      apply Finset.sum_le_sum
      intro v hv
      exact Nat.one_le_iff_ne_zero.mpr
        (Finsupp.mem_support_iff.mp hv)

theorem finsupp_eq_squarefreeExponent_support_of_forall_le_one
    {m : ℕ} (a : Fin m →₀ ℕ) (ha : ∀ v, a v ≤ 1) :
    a = squarefreeExponent a.support := by
  ext v
  by_cases hv : v ∈ a.support
  · have hvpos : 0 < a v :=
      Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv)
    have hvle := ha v
    have haveq : a v = 1 := by omega
    simp [squarefreeExponent_apply, hv, haveq]
  · have haveq : a v = 0 := Finsupp.notMem_support_iff.mp hv
    simp [squarefreeExponent_apply, hv, haveq]

theorem finsupp_exists_repeated_of_card_support_lt_degree
    {m : ℕ} (a : Fin m →₀ ℕ)
    (ha : a.support.card < a.degree) :
    ∃ v ∈ a.support, 2 ≤ a v := by
  classical
  by_cases hrep : ∃ v ∈ a.support, 2 ≤ a v
  · exact hrep
  have hall : ∀ v, a v ≤ 1 := by
    intro v
    by_cases hv : v ∈ a.support
    · have hvlt : a v < 2 := by
        exact Nat.lt_of_not_ge (fun hvge ↦ hrep ⟨v, hv, hvge⟩)
      omega
    · rw [Finsupp.notMem_support_iff.mp hv]
      exact Nat.zero_le 1
  have heq := finsupp_eq_squarefreeExponent_support_of_forall_le_one a hall
  have hdegree := congrArg Finsupp.degree heq
  rw [squarefreeExponent_degree] at hdegree
  omega

theorem finsupp_card_support_lt_degree_of_two_le
    {m : ℕ} (a : Fin m →₀ ℕ) (v : Fin m)
    (hvmem : v ∈ a.support) (hv : 2 ≤ a v) :
    a.support.card < a.degree := by
  rw [Finsupp.degree_apply]
  calc
    a.support.card = ∑ w ∈ a.support, 1 := by simp
    _ < ∑ w ∈ a.support, a w := by
      apply Finset.sum_lt_sum
      · intro w hw
        exact Nat.one_le_iff_ne_zero.mpr
          (Finsupp.mem_support_iff.mp hw)
      · exact ⟨v, hvmem, by omega⟩

theorem finsupp_eq_squarefreeExponent_support_of_card_eq_degree
    {m : ℕ} (a : Fin m →₀ ℕ)
    (ha : a.support.card = a.degree) :
    a = squarefreeExponent a.support := by
  apply finsupp_eq_squarefreeExponent_support_of_forall_le_one
  intro v
  by_cases hv : v ∈ a.support
  · by_contra hvle
    have hv2 : 2 ≤ a v := by omega
    have := finsupp_card_support_lt_degree_of_two_le a v hv hv2
    omega
  · rw [Finsupp.notMem_support_iff.mp hv]
    exact Nat.zero_le 1

theorem finsupp_sub_single_support_eq_of_two_le
    {m : ℕ} (a : Fin m →₀ ℕ) (v : Fin m) (hv : 2 ≤ a v) :
    (a - Finsupp.single v 1).support = a.support := by
  ext w
  rw [Finsupp.mem_support_iff, Finsupp.mem_support_iff]
  by_cases hwv : w = v
  · subst w
    rw [Finsupp.tsub_apply, Finsupp.single_eq_same]
    omega
  · rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne hwv, Nat.sub_zero]

theorem finsupp_sub_single_add_single
    {m : ℕ} (a : Fin m →₀ ℕ) (v : Fin m) (hv : 1 ≤ a v) :
    a - Finsupp.single v 1 + Finsupp.single v 1 = a := by
  exact tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hv)

theorem finsupp_support_add_new_single
    {m : ℕ} (b : Fin m →₀ ℕ) (w : Fin m) (hw : w ∉ b.support) :
    (b + Finsupp.single w 1).support = insert w b.support := by
  ext x
  rw [Finsupp.mem_support_iff]
  by_cases hxw : x = w
  · subst x
    simp [hw]
  · simp [Finsupp.mem_support_iff, hxw]

noncomputable def squarefreeReductionVector
    (k : Type u) [Field k] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofAbstract D) q) :
    SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
  Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
    (SimplicialSphereAnisotropicity.faceMonomial F.1)

noncomputable def squarefreeReductionSpan
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (q : ℕ) :
    Submodule (K_SquarefreeSpanning k n m) (SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D) :=
  Submodule.span (K_SquarefreeSpanning k n m)
    (Set.range (squarefreeReductionVector k (n := n) D (q := q)))

theorem reduction_monomial_eq_zero_of_support_not_face
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (a : Fin m →₀ ℕ)
    (ha : a.support ∉ AugmentedComplex.ofAbstract D) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k (n := n) D)
      (MvPolynomial.monomial a 1) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  apply Ideal.mem_sup_left
  rw [SimplicialSphereAnisotropicity.StanleyReisner.mem_stanleyReisnerIdeal_iff_support_not_face]
  intro b hb
  have hab : a = b := by
    simpa using hb
  subst b
  exact ha

theorem reduction_monomial_mem_squarefreeReductionSpan
    (k : Type u) [Field k] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hpure : IsPureOfCard D (n + 1))
    (a : Fin m →₀ ℕ) (ha : a.degree = q) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (MvPolynomial.monomial a 1) ∈
      squarefreeReductionSpan k (n := n) D q := by
  generalize he : q - a.support.card = e
  induction e using Nat.strong_induction_on generalizing a with
  | h e ih =>
      by_cases hface : a.support ∈ AugmentedComplex.ofAbstract D
      · have hcardle : a.support.card ≤ q := by
          have := finsupp_card_support_le_degree a
          omega
        by_cases hcardeq : a.support.card = q
        · have hacarddegree : a.support.card = a.degree := by omega
          have hasquarefree :=
            finsupp_eq_squarefreeExponent_support_of_card_eq_degree
              a hacarddegree
          let Fq : AugmentedSimplex
              (AugmentedComplex.ofAbstract D) q :=
            ⟨a.support, hface, hcardeq⟩
          rw [hasquarefree,
            ← faceMonomial_eq_monomial_squarefreeExponent]
          apply Submodule.subset_span
          exact Set.mem_range_self Fq
        · have hcardlt : a.support.card < a.degree := by omega
          obtain ⟨v, hv_support, hv_two⟩ :=
            finsupp_exists_repeated_of_card_support_lt_degree a hcardlt
          have hsupport_nonempty : a.support.Nonempty :=
            ⟨v, hv_support⟩
          have hsupport_D : a.support ∈ D :=
            (AugmentedComplex.nonempty_mem_ofAbstract_iff
              D hsupport_nonempty).mp hface
          obtain ⟨F, hFD, hsupportF, hFcard⟩ := hpure hsupport_D
          let j : Fin (n + 1) :=
            (F.orderIsoOfFin hFcard).symm ⟨v, hsupportF hv_support⟩
          let b : Fin m →₀ ℕ := a - Finsupp.single v 1
          have hb_support : b.support = a.support := by
            exact finsupp_sub_single_support_eq_of_two_le a v hv_two
          have hb_add : b + Finsupp.single v 1 = a := by
            exact finsupp_sub_single_add_single a v (by omega)
          have hb_degree : b.degree + 1 = q := by
            have hdegree := congrArg Finsupp.degree hb_add
            simpa only [map_add, Finsupp.degree_single,
              ha] using hdegree
          have hjv : orderedFaceEmbedding F hFcard j = v := by
            change ((F.orderIsoOfFin hFcard)
              ((F.orderIsoOfFin hFcard).symm
                ⟨v, hsupportF hv_support⟩)).1 = v
            exact congrArg Subtype.val
              ((F.orderIsoOfFin hFcard).apply_symm_apply
                ⟨v, hsupportF hv_support⟩)
          let term : Fin m → SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
            fun w ↦ facetPivotCoefficient k F hFcard j w •
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                (MvPolynomial.monomial (b + Finsupp.single w 1) 1)
          have hsum : (∑ w : Fin m, term w) = 0 := by
            exact facetPivot_monomial_relation k D F hFcard j b
          have hcoeff_v : facetPivotCoefficient k F hFcard j v = 1 := by
            rw [← hjv, facetPivotCoefficient_orderedFaceEmbedding]
            simp
          have hterm_v : term v =
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                (MvPolynomial.monomial a 1) := by
            simp only [term, hcoeff_v, one_smul, hb_add]
          have hterm_mem (w : Fin m) (hwv : w ≠ v) :
              term w ∈ squarefreeReductionSpan k (n := n) D q := by
            by_cases hwF : w ∈ F
            · let l : Fin (n + 1) :=
                (F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩
              have hlw : orderedFaceEmbedding F hFcard l = w := by
                change ((F.orderIsoOfFin hFcard)
                  ((F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩)).1 = w
                exact congrArg Subtype.val
                  ((F.orderIsoOfFin hFcard).apply_symm_apply ⟨w, hwF⟩)
              have hjl : j ≠ l := by
                intro hjleq
                apply hwv
                rw [← hjv, ← hlw, hjleq]
              have hcoeff_w :
                  facetPivotCoefficient k F hFcard j w = 0 := by
                rw [← hlw, facetPivotCoefficient_orderedFaceEmbedding,
                  if_neg hjl]
              simp only [term, hcoeff_w, zero_smul]
              exact Submodule.zero_mem _
            · have hw_bsupport : w ∉ b.support := by
                intro hw
                have hw_a : w ∈ a.support := by
                  rwa [← hb_support]
                exact hwF (hsupportF hw_a)
              have hnew_support :=
                finsupp_support_add_new_single b w hw_bsupport
              have hnew_card :
                  (b + Finsupp.single w 1).support.card =
                    a.support.card + 1 := by
                rw [hnew_support, Finset.card_insert_of_notMem hw_bsupport,
                  hb_support]
              have hnew_degree :
                  (b + Finsupp.single w 1).degree = q := by
                rw [map_add, Finsupp.degree_single]
                omega
              have hnew_measure :
                  q - (b + Finsupp.single w 1).support.card < e := by
                omega
              apply Submodule.smul_mem
              exact ih _ hnew_measure _ hnew_degree rfl
          have hrest :
              (∑ w ∈ Finset.univ.erase v, term w) ∈
                squarefreeReductionSpan k (n := n) D q := by
            apply Submodule.sum_mem
            intro w hw
            exact hterm_mem w (Finset.ne_of_mem_erase hw)
          have hdecomp :
              term v + ∑ w ∈ Finset.univ.erase v, term w = 0 := by
            rw [add_comm,
              Finset.sum_erase_add _ _ (Finset.mem_univ v)]
            exact hsum
          rw [hterm_v] at hdecomp
          have hneg :
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                  (MvPolynomial.monomial a 1) =
                -(∑ w ∈ Finset.univ.erase v, term w) :=
            eq_neg_of_add_eq_zero_left hdecomp
          rw [hneg]
          exact Submodule.neg_mem _ hrest
      · rw [reduction_monomial_eq_zero_of_support_not_face k D a hface]
        exact Submodule.zero_mem _

theorem reduction_mk_mem_squarefreeReductionSpan_of_isHomogeneous
    (k : Type u) [Field k] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hpure : IsPureOfCard D (n + 1))
    (p : S_SquarefreeSpanning k n m) (hp : p.IsHomogeneous q) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p ∈
      squarefreeReductionSpan k (n := n) D q := by
  let Q : S_SquarefreeSpanning k n m →ₗ[K_SquarefreeSpanning k n m]
      SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
    (Ideal.Quotient.mkₐ (K_SquarefreeSpanning k n m)
      (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toLinearMap
  change Q p ∈ squarefreeReductionSpan k (n := n) D q
  rw [← p.support_sum_monomial_coeff, map_sum]
  apply Submodule.sum_mem
  intro a ha
  have hadegree : a.degree = q := by
    rw [Finsupp.degree_eq_weight_one]
    exact hp (MvPolynomial.mem_support_iff.mp ha)
  have hmonomial :
      MvPolynomial.monomial a (MvPolynomial.coeff a p) =
        MvPolynomial.coeff a p • MvPolynomial.monomial a 1 := by
    rw [MvPolynomial.smul_monomial]
    simp
  rw [hmonomial, map_smul]
  exact Submodule.smul_mem _ (MvPolynomial.coeff a p)
    (reduction_monomial_mem_squarefreeReductionSpan
      k D hpure a hadegree)

theorem squarefreeReductionSpan_le_quotientDegree
    (k : Type u) [Field k] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    squarefreeReductionSpan k (n := n) D q ≤
      SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q := by
  apply Submodule.span_le.mpr
  rintro _ ⟨F, rfl⟩
  change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (SimplicialSphereAnisotropicity.faceMonomial F.1) ∈
    SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q
  refine ⟨SimplicialSphereAnisotropicity.faceMonomial F.1, ?_, rfl⟩
  change (SimplicialSphereAnisotropicity.faceMonomial (K := K_SquarefreeSpanning k n m) F.1).IsHomogeneous q
  simpa only [F.2.2] using
    (SimplicialSphereAnisotropicity.faceMonomial_isHomogeneous (K_SquarefreeSpanning k n m) F.1)

theorem quotientDegree_eq_squarefreeReductionSpan
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hpure : IsPureOfCard D (n + 1)) (q : ℕ) :
    SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q =
      squarefreeReductionSpan k (n := n) D q := by
  apply le_antisymm
  · rintro _ ⟨p, hp, rfl⟩
    exact reduction_mk_mem_squarefreeReductionSpan_of_isHomogeneous
      k D hpure p hp
  · exact squarefreeReductionSpan_le_quotientDegree k D

end SimplicialSphereAnisotropicity.Generic

end

end

section

/-!
# One-column auxiliary brackets and support-pivot functionals

This module embeds the generic coefficient field into a rational-function
field with one fresh column.  Facet Cramer brackets are nonzero there.  A
facet completion supplies normalized linear functionals dual to any prescribed
proper face support and annihilating the fresh column.  Applying such a
functional to Cramer's vector identity gives the characteristic-two
cross-bracket identity used by the factorial-free stress recursion.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Generic

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_Auxiliary (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

abbrev AuxiliaryPolynomial
    (k : Type u) [Field k] (n m : ℕ) :=
  Generic.Brion.ParameterPolynomial (K_Auxiliary k n m) (n + 1)

abbrev AuxiliaryField
    (k : Type u) [Field k] (n m : ℕ) :=
  Generic.Brion.ParameterFraction (K_Auxiliary k n m) (n + 1)

noncomputable def auxiliaryColumn
    (k : Type u) [Field k] {n m : ℕ} :
    Fin (n + 1) → AuxiliaryField k n m :=
  fun i ↦ algebraMap (AuxiliaryPolynomial k n m)
    (AuxiliaryField k n m) (MvPolynomial.X i)

noncomputable def auxiliaryGenericCoefficient
    (k : Type u) [Field k] {n m : ℕ}
    (i : Fin (n + 1)) (v : Fin m) : AuxiliaryField k n m :=
  algebraMap (K_Auxiliary k n m) (AuxiliaryField k n m)
    (SimplicialSphereAnisotropicity.genericCoefficient k i v)

noncomputable def auxiliaryGenericMatrix
    (k : Type u) [Field k] {n m : ℕ} :
    Matrix (Fin (n + 1)) (Fin m) (AuxiliaryField k n m) :=
  fun i v ↦ auxiliaryGenericCoefficient k i v

noncomputable def auxiliaryFacetMatrix
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) (AuxiliaryField k n m) :=
  Generic.Brion.facetMatrix (AuxiliaryField k n m) (n + 1)
    (auxiliaryGenericMatrix k) F hF

theorem auxiliaryFacetMatrix_eq_map
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    auxiliaryFacetMatrix k F hF =
      (algebraMap (K_Auxiliary k n m) (AuxiliaryField k n m)).mapMatrix
        (Generic.faceCoefficientMatrix k F hF) := by
  rfl

noncomputable def auxiliaryFacetBracket
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : ↥F) : AuxiliaryField k n m :=
  algebraMap (AuxiliaryPolynomial k n m) (AuxiliaryField k n m)
    (Generic.Brion.facetCramerPolynomial (K_Auxiliary k n m) (n + 1)
      (Generic.Brion.genericCoefficientMatrix k) F hF v)

theorem genericFacetMatrix_det_ne_zero_raw
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    (Generic.Brion.facetMatrix (K_Auxiliary k n m) (n + 1)
      (Generic.Brion.genericCoefficientMatrix k) F hF).det ≠ 0 := by
  change (Generic.faceCoefficientMatrix k F hF).det ≠ 0
  exact Generic.faceMinor_ne_zero k F hF

theorem auxiliaryFacetBracket_ne_zero
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : ↥F) : auxiliaryFacetBracket k F hF v ≠ 0 := by
  apply (map_ne_zero_iff _
    (IsFractionRing.injective
      (AuxiliaryPolynomial k n m) (AuxiliaryField k n m))).mpr
  exact Generic.Brion.facetCramerPolynomial_ne_zero
    (K_Auxiliary k n m) (n + 1) (Generic.Brion.genericCoefficientMatrix k)
    F hF (genericFacetMatrix_det_ne_zero_raw k F hF) v

@[simp]
theorem auxiliary_algebraMap_C
    (k : Type u) [Field k] {n m : ℕ} (x : K_Auxiliary k n m) :
    algebraMap (AuxiliaryPolynomial k n m) (AuxiliaryField k n m)
        (MvPolynomial.C x) =
      algebraMap (K_Auxiliary k n m) (AuxiliaryField k n m) x := by
  simpa using
    (IsScalarTower.algebraMap_apply (K_Auxiliary k n m)
      (AuxiliaryPolynomial k n m) (AuxiliaryField k n m) x).symm

theorem auxiliaryFacetBracket_eq_cramer
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : ↥F) :
    auxiliaryFacetBracket k F hF v =
      Matrix.cramer (auxiliaryFacetMatrix k F hF)
        (auxiliaryColumn k) ((F.orderIsoOfFin hF).symm v) := by
  rw [auxiliaryFacetBracket,
    Generic.Brion.facetCramerPolynomial_eq_updateCol_det,
    Matrix.cramer_apply]
  let φ : AuxiliaryPolynomial k n m →+* AuxiliaryField k n m :=
    algebraMap (AuxiliaryPolynomial k n m) (AuxiliaryField k n m)
  change φ
      (((MvPolynomial.C : K_Auxiliary k n m →+* AuxiliaryPolynomial k n m).mapMatrix
          (Generic.Brion.facetMatrix (K_Auxiliary k n m) (n + 1)
            (Generic.Brion.genericCoefficientMatrix k) F hF)).updateCol
        ((F.orderIsoOfFin hF).symm v) (fun i ↦ MvPolynomial.X i)).det = _
  rw [φ.map_det]
  congr 1
  ext i j
  simp [Matrix.updateCol_apply, auxiliaryFacetMatrix,
    auxiliaryGenericMatrix, auxiliaryGenericCoefficient, auxiliaryColumn,
    Generic.Brion.facetMatrix, φ]
  split_ifs <;> simp [Generic.Brion.genericCoefficientMatrix]

noncomputable def auxiliaryCompletionMatrix
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t : ↥F) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) (AuxiliaryField k n m) :=
  (auxiliaryFacetMatrix k F hF).updateCol
    ((F.orderIsoOfFin hF).symm t) (auxiliaryColumn k)

theorem auxiliaryCompletionMatrix_det_ne_zero
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t : ↥F) :
    (auxiliaryCompletionMatrix k F hF t).det ≠ 0 := by
  rw [auxiliaryCompletionMatrix, ← Matrix.cramer_apply,
    ← auxiliaryFacetBracket_eq_cramer]
  exact auxiliaryFacetBracket_ne_zero k F hF t

noncomputable def normalizedCompletionFunctional
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t c : ↥F) :
    (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m :=
  let B := auxiliaryCompletionMatrix k F hF t
  B.det⁻¹ • ((LinearMap.proj ((F.orderIsoOfFin hF).symm c)).comp B.cramer)

theorem normalizedCompletionFunctional_apply
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t c : ↥F) (y : Fin (n + 1) → AuxiliaryField k n m) :
    normalizedCompletionFunctional k F hF t c y =
      (auxiliaryCompletionMatrix k F hF t).det⁻¹ *
        Matrix.cramer (auxiliaryCompletionMatrix k F hF t) y
          ((F.orderIsoOfFin hF).symm c) := by
  rfl

theorem normalizedCompletionFunctional_genericColumn
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t c v : ↥F) (hvt : v ≠ t) :
    normalizedCompletionFunctional k F hF t c
        (fun i ↦ auxiliaryGenericCoefficient k i v.1) =
      if c = v then 1 else 0 := by
  let o := F.orderIsoOfFin hF
  let B := auxiliaryCompletionMatrix k F hF t
  have hpos : o.symm v ≠ o.symm t := by
    intro h
    exact hvt (o.symm.injective h)
  have hov : F.orderEmbOfFin hF (o.symm v) = v.1 :=
    congrArg Subtype.val (o.apply_symm_apply v)
  have hcol :
      (fun i ↦ auxiliaryGenericCoefficient k i v.1) = B.col (o.symm v) := by
    funext i
    simp [B, auxiliaryCompletionMatrix,
      hpos, auxiliaryFacetMatrix, Generic.Brion.facetMatrix,
      auxiliaryGenericMatrix, o, hov]
  have hcramer :
      Matrix.cramer B (fun i ↦ auxiliaryGenericCoefficient k i v.1) =
        Pi.single (o.symm v) B.det := by
    apply Matrix.cramer_row_self B
      (fun i ↦ auxiliaryGenericCoefficient k i v.1) (o.symm v)
    intro i
    exact congrFun hcol i
  rw [normalizedCompletionFunctional_apply]
  change B.det⁻¹ *
      Matrix.cramer B (fun i ↦ auxiliaryGenericCoefficient k i v.1)
        (o.symm c) = _
  rw [hcramer]
  by_cases hcv : c = v
  · subst v
    simp
    exact inv_mul_cancel₀
      (auxiliaryCompletionMatrix_det_ne_zero k F hF t)
  · have hposcv : o.symm c ≠ o.symm v := by
      intro h
      exact hcv (o.symm.injective h)
    simp [hcv, hposcv]

theorem normalizedCompletionFunctional_auxiliaryColumn
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (t c : ↥F) (hct : c ≠ t) :
    normalizedCompletionFunctional k F hF t c (auxiliaryColumn k) = 0 := by
  let o := F.orderIsoOfFin hF
  let B := auxiliaryCompletionMatrix k F hF t
  have hcol : auxiliaryColumn k = B.col (o.symm t) := by
    funext i
    simp [B, auxiliaryCompletionMatrix, o]
  have hcramer : Matrix.cramer B (auxiliaryColumn k) =
      Pi.single (o.symm t) B.det := by
    apply Matrix.cramer_row_self B (auxiliaryColumn k) (o.symm t)
    intro i
    exact congrFun hcol i
  have hposct : o.symm c ≠ o.symm t := by
    intro h
    exact hct (o.symm.injective h)
  rw [normalizedCompletionFunctional_apply]
  change B.det⁻¹ * Matrix.cramer B (auxiliaryColumn k) (o.symm c) = 0
  rw [hcramer]
  simp [hposct]

theorem linearMap_mulVec_eq_sum
    {E ι : Type*} [Field E] [Fintype ι]
    (A : Matrix ι ι E) (x : ι → E)
    (ell : (ι → E) →ₗ[E] E) :
    ell (A *ᵥ x) = ∑ j : ι, x j * ell (A.col j) := by
  have hvec : A *ᵥ x = ∑ j : ι, x j • A.col j := by
    funext i
    simp [Matrix.mulVec, dotProduct, mul_comm]
  rw [hvec, map_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  rw [map_smul]
  rfl

theorem linearMap_cramer_sum
    {E ι : Type*} [Field E] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι E) (z : ι → E)
    (ell : (ι → E) →ₗ[E] E) :
    (∑ j : ι, Matrix.cramer A z j * ell (A.col j)) =
      A.det * ell z := by
  rw [← linearMap_mulVec_eq_sum A (Matrix.cramer A z) ell,
    Matrix.mulVec_cramer, map_smul]
  rfl

@[simp]
theorem auxiliaryFacetBracket_ordered
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) :
    auxiliaryFacetBracket k F hF ((F.orderIsoOfFin hF) j) =
      Matrix.cramer (auxiliaryFacetMatrix k F hF)
        (auxiliaryColumn k) j := by
  rw [auxiliaryFacetBracket_eq_cramer]
  exact congrArg
    (fun q ↦ Matrix.cramer (auxiliaryFacetMatrix k F hF)
      (auxiliaryColumn k) q)
    ((F.orderIsoOfFin hF).symm_apply_apply j)

@[simp]
theorem auxiliaryFacetMatrix_col
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) :
    (auxiliaryFacetMatrix k F hF).col j =
      fun i ↦ auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF j) := by
  rfl

theorem auxiliaryFacet_cramer_sum
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m) :
    (∑ j : Fin (n + 1),
      auxiliaryFacetBracket k F hF ((F.orderIsoOfFin hF) j) *
        ell (fun i ↦ auxiliaryGenericCoefficient k i
          (F.orderEmbOfFin hF j))) =
      (auxiliaryFacetMatrix k F hF).det * ell (auxiliaryColumn k) := by
  have h := linearMap_cramer_sum
    (auxiliaryFacetMatrix k F hF) (auxiliaryColumn k) ell
  simpa only [auxiliaryFacetBracket_ordered,
    auxiliaryFacetMatrix_col] using h

def IsSupportPivotFunctional
    (k : Type u) [Field k] {n m : ℕ}
    (S : Finset (Fin m)) (c : Fin m)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m) : Prop :=
  ell (auxiliaryColumn k) = 0 ∧
    ∀ v ∈ S,
      ell (fun i ↦ auxiliaryGenericCoefficient k i v) =
        if c = v then 1 else 0

theorem normalizedCompletionFunctional_isSupportPivotFunctional
    (k : Type u) [Field k] {n m : ℕ}
    (S H : Finset (Fin m)) (hH : H.card = n + 1)
    (hSH : S ⊆ H) (t : ↥H) (htS : t.1 ∉ S)
    (c : Fin m) (hcS : c ∈ S) :
    IsSupportPivotFunctional k S c
      (normalizedCompletionFunctional k H hH t ⟨c, hSH hcS⟩) := by
  constructor
  · apply normalizedCompletionFunctional_auxiliaryColumn
    intro h
    exact htS (congrArg Subtype.val h ▸ hcS)
  · intro v hvS
    let cv : ↥H := ⟨c, hSH hcS⟩
    let vv : ↥H := ⟨v, hSH hvS⟩
    have hvt : vv ≠ t := by
      intro h
      exact htS (congrArg Subtype.val h ▸ hvS)
    simpa [cv, vv, Subtype.ext_iff] using
      (normalizedCompletionFunctional_genericColumn
        k H hH t cv vv hvt)

theorem supportPivot_crossBracket
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (S F : Finset (Fin m)) (hF : F.card = n + 1)
    (hSF : S ⊆ F) (c : Fin m) (hcS : c ∈ S)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m)
    (hell : IsSupportPivotFunctional k S c ell) :
    (∑ j ∈ Finset.univ.filter
        (fun j : Fin (n + 1) ↦ F.orderEmbOfFin hF j ∉ S),
      auxiliaryFacetBracket k F hF ((F.orderIsoOfFin hF) j) *
        ell (fun i ↦ auxiliaryGenericCoefficient k i
          (F.orderEmbOfFin hF j))) =
      auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩ := by
  let o := F.orderIsoOfFin hF
  let term : Fin (n + 1) → AuxiliaryField k n m := fun j ↦
    auxiliaryFacetBracket k F hF (o j) *
      ell (fun i ↦ auxiliaryGenericCoefficient k i
        (F.orderEmbOfFin hF j))
  have htotal : (∑ j : Fin (n + 1), term j) = 0 := by
    change (∑ j : Fin (n + 1),
      auxiliaryFacetBracket k F hF ((F.orderIsoOfFin hF) j) *
        ell (fun i ↦ auxiliaryGenericCoefficient k i
          (F.orderEmbOfFin hF j))) = 0
    rw [auxiliaryFacet_cramer_sum, hell.1, mul_zero]
  let jc : Fin (n + 1) := o.symm ⟨c, hSF hcS⟩
  have hjcvertex : F.orderEmbOfFin hF jc = c := by
    exact congrArg Subtype.val (o.apply_symm_apply ⟨c, hSF hcS⟩)
  have hinside :
      (∑ j ∈ Finset.univ.filter
        (fun j : Fin (n + 1) ↦ F.orderEmbOfFin hF j ∈ S), term j) =
        auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩ := by
    rw [Finset.sum_eq_single jc]
    · change auxiliaryFacetBracket k F hF (o jc) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i
            (F.orderEmbOfFin hF jc)) =
        auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩
      have hvalue := hell.2 c hcS
      rw [hjcvertex, hvalue, if_pos rfl, mul_one]
      congr 1
      exact o.apply_symm_apply ⟨c, hSF hcS⟩
    · intro j hj hne
      have hjS : F.orderEmbOfFin hF j ∈ S :=
        (Finset.mem_filter.mp hj).2
      have hvc : c ≠ F.orderEmbOfFin hF j := by
        intro hcv
        apply hne
        apply o.injective
        apply Subtype.ext
        change F.orderEmbOfFin hF j = F.orderEmbOfFin hF jc
        exact hcv.symm.trans hjcvertex.symm
      change auxiliaryFacetBracket k F hF (o j) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i
            (F.orderEmbOfFin hF j)) = 0
      rw [hell.2 _ hjS, if_neg hvc, mul_zero]
    · simp [jc, hjcvertex, hcS]
  have hsplit := Finset.sum_filter_add_sum_filter_not
    (s := Finset.univ)
    (p := fun j : Fin (n + 1) ↦ F.orderEmbOfFin hF j ∈ S) term
  have hsumoutside :
      auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩ +
        ∑ j ∈ Finset.univ.filter
          (fun j : Fin (n + 1) ↦ F.orderEmbOfFin hF j ∉ S), term j = 0 := by
    rw [← hinside, ← htotal]
    exact hsplit
  have hneg := eq_neg_of_add_eq_zero_left hsumoutside
  rw [CharTwo.neg_eq] at hneg
  exact hneg.symm

end SimplicialSphereAnisotropicity.Stress

end

end

section

/-!
# Factorial-free reverse-support top-stress expansion

The normalized top-stress coefficients are embedded into the one-column
auxiliary rational-function field.  A normalized facet completion gives the
support-pivot recurrence.  The characteristic-two cross-bracket identity then
proves, by reverse induction on support cardinality, the exact facet expansion
for every exponent of top total degree.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Generic SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_TopCoefficient (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

noncomputable def auxiliaryFacetBracketAt
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : Fin m) : AuxiliaryField k n m :=
  if hv : v ∈ F then auxiliaryFacetBracket k F hF ⟨v, hv⟩ else 0

@[simp]
theorem auxiliaryFacetBracketAt_of_mem
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : Fin m) (hv : v ∈ F) :
    auxiliaryFacetBracketAt k F hF v =
      auxiliaryFacetBracket k F hF ⟨v, hv⟩ := by
  simp [auxiliaryFacetBracketAt, hv]

@[simp]
theorem auxiliaryFacetBracketAt_of_not_mem
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : Fin m) (hv : v ∉ F) :
    auxiliaryFacetBracketAt k F hF v = 0 := by
  simp [auxiliaryFacetBracketAt, hv]

theorem supportPivot_crossBracket_global
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (S F : Finset (Fin m)) (hF : F.card = n + 1)
    (hSF : S ⊆ F) (c : Fin m) (hcS : c ∈ S)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m)
    (hell : IsSupportPivotFunctional k S c ell) :
    (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ S),
      auxiliaryFacetBracketAt k F hF v *
        ell (fun i ↦ auxiliaryGenericCoefficient k i v)) =
      auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩ := by
  classical
  let term : Fin m → AuxiliaryField k n m := fun v ↦
    if v ∉ S then
      auxiliaryFacetBracketAt k F hF v *
        ell (fun i ↦ auxiliaryGenericCoefficient k i v)
    else 0
  have hrestrict :
      (∑ v : Fin m, term v) = ∑ v : ↥F, term v.1 := by
    calc
      (∑ v : Fin m, term v) = ∑ v ∈ F, term v := by
        symm
        apply Finset.sum_subset (Finset.subset_univ F)
        intro v _hvuniv hvF
        simp [term, auxiliaryFacetBracketAt, hvF]
      _ = ∑ v : ↥F, term v.1 :=
        (Finset.sum_attach F term).symm
  let o := F.orderIsoOfFin hF
  have hreindex :
      (∑ v : ↥F, term v.1) =
        ∑ j : Fin (n + 1),
          if (o j).1 ∉ S then
            auxiliaryFacetBracket k F hF (o j) *
              ell (fun i ↦ auxiliaryGenericCoefficient k i
                (o j).1)
          else 0 := by
    rw [← Equiv.sum_comp o.toEquiv]
    apply Finset.sum_congr rfl
    intro j _hj
    by_cases hjS : (o j).1 ∈ S
    · simp [term, hjS]
    · simp [term, hjS, auxiliaryFacetBracketAt, (o j).2]
  calc
    (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ S),
      auxiliaryFacetBracketAt k F hF v *
        ell (fun i ↦ auxiliaryGenericCoefficient k i v)) =
        ∑ v : Fin m, term v := by
      simp [term, Finset.sum_filter]
    _ = ∑ v : ↥F, term v.1 := hrestrict
    _ = ∑ j : Fin (n + 1),
          if (o j).1 ∉ S then
            auxiliaryFacetBracket k F hF (o j) *
              ell (fun i ↦ auxiliaryGenericCoefficient k i
                (o j).1)
          else 0 := hreindex
    _ = ∑ j ∈ Finset.univ.filter
          (fun j : Fin (n + 1) ↦ F.orderEmbOfFin hF j ∉ S),
        auxiliaryFacetBracket k F hF ((F.orderIsoOfFin hF) j) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i
            (F.orderEmbOfFin hF j)) := by
      simp [Finset.sum_filter, o]
    _ = auxiliaryFacetBracket k F hF ⟨c, hSF hcS⟩ :=
      supportPivot_crossBracket k S F hF hSF c hcS ell hell

noncomputable def auxiliaryTopStressCoefficient
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) : AuxiliaryField k n m :=
  algebraMap (K_TopCoefficient k n m) (AuxiliaryField k n m)
    (Generic.Brion.topStressCoefficient k D hd hpm rho)

theorem auxiliaryTopStressCoefficient_nonface
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ)
    (hrho : rho.support ∉ AugmentedComplex.ofAbstract D) :
    auxiliaryTopStressCoefficient k D hd hpm rho = 0 := by
  rw [auxiliaryTopStressCoefficient,
    Generic.Brion.topStressCoefficient_eq_zero_of_support_not_face
      k D hd hpm rho hrho,
    map_zero]

theorem auxiliaryTopStressCoefficient_equilibrium
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (s : Fin m →₀ ℕ) :
    (∑ v : Fin m,
      auxiliaryTopStressCoefficient k D hd hpm
          (s + Finsupp.single v 1) •
        (fun i : Fin (n + 1) ↦
          auxiliaryGenericCoefficient k (n := n) i v)) = 0 := by
  funext i
  have h := congrArg
    (algebraMap (K_TopCoefficient k n m) (AuxiliaryField k n m))
    (Generic.Brion.topStressCoefficient_equilibrium k D hd hpm s i)
  rw [map_sum, map_zero] at h
  simp_rw [map_mul] at h
  simpa only [Finset.sum_apply, Pi.smul_apply, Pi.zero_apply,
    smul_eq_mul, auxiliaryTopStressCoefficient,
    auxiliaryGenericCoefficient, mul_comm] using h

noncomputable def auxiliaryFacetWeight
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (rho : Fin m →₀ ℕ) : AuxiliaryField k n m :=
  (∏ v : ↥F, auxiliaryFacetBracket k F hF v ^ rho v.1) /
    ∏ v : ↥F, auxiliaryFacetBracket k F hF v

theorem auxiliaryFacetBracket_product_ne_zero
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    (∏ v : ↥F, auxiliaryFacetBracket k F hF v) ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr fun v _hv ↦
    auxiliaryFacetBracket_ne_zero k F hF v

theorem auxiliaryFacetWeight_add_single
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (rho : Fin m →₀ ℕ) (v : Fin m) (hvF : v ∈ F) :
    auxiliaryFacetWeight k F hF (rho + Finsupp.single v 1) =
      auxiliaryFacetWeight k F hF rho *
        auxiliaryFacetBracket k F hF ⟨v, hvF⟩ := by
  classical
  let cv : ↥F := ⟨v, hvF⟩
  have hsingle :
      (∏ w : ↥F,
        auxiliaryFacetBracket k F hF w ^
          (Finsupp.single v 1 : Fin m →₀ ℕ) w.1) =
        auxiliaryFacetBracket k F hF cv := by
    rw [Finset.prod_eq_single cv]
    · simp [cv]
    · intro w _hw hwcv
      have hvw : v ≠ w.1 := by
        intro hvweq
        apply hwcv
        apply Subtype.ext
        exact hvweq.symm
      simp [hvw]
    · simp
  have hfactor :
      (∏ w : ↥F,
        auxiliaryFacetBracket k F hF w ^
          ((rho + (Finsupp.single v 1 : Fin m →₀ ℕ)) w.1)) =
        (∏ w : ↥F, auxiliaryFacetBracket k F hF w ^ rho w.1) *
          auxiliaryFacetBracket k F hF cv := by
    simp_rw [Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
    rw [hsingle]
  rw [auxiliaryFacetWeight, auxiliaryFacetWeight, hfactor]
  field_simp
  rfl

theorem auxiliaryFacetWeight_squarefree
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    auxiliaryFacetWeight k F hF (squarefreeExponent F) = 1 := by
  rw [auxiliaryFacetWeight]
  have hnum :
      (∏ v : ↥F,
        auxiliaryFacetBracket k F hF v ^ squarefreeExponent F v.1) =
        ∏ v : ↥F, auxiliaryFacetBracket k F hF v := by
    apply Finset.prod_congr rfl
    intro v _hv
    rw [squarefreeExponent_apply, if_pos v.2, pow_one]
  rw [hnum, div_self (auxiliaryFacetBracket_product_ne_zero k F hF)]

theorem auxiliaryTopStressCoefficient_pivot
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) (c : Fin m)
    (hcSupport : c ∈ rho.support) (hcTwo : 2 ≤ rho c)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m)
    (hell : IsSupportPivotFunctional k rho.support c ell) :
    auxiliaryTopStressCoefficient k D hd hpm rho =
      ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
        auxiliaryTopStressCoefficient k D hd hpm
            (rho - Finsupp.single c 1 + Finsupp.single v 1) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i v) := by
  let s : Fin m →₀ ℕ := rho - Finsupp.single c 1
  have hsSupport : s.support = rho.support :=
    Generic.finsupp_sub_single_support_eq_of_two_le rho c hcTwo
  have hsAdd : s + Finsupp.single c 1 = rho :=
    Generic.finsupp_sub_single_add_single rho c (by omega)
  let term : Fin m → AuxiliaryField k n m := fun v ↦
    auxiliaryTopStressCoefficient k D hd hpm
        (s + Finsupp.single v 1) *
      ell (fun i ↦ auxiliaryGenericCoefficient k i v)
  have htotal : (∑ v : Fin m, term v) = 0 := by
    have h := congrArg ell
      (auxiliaryTopStressCoefficient_equilibrium k D hd hpm s)
    rw [map_sum, map_zero] at h
    simpa only [map_smul, smul_eq_mul, term] using h
  have hinside :
      (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∈ rho.support),
        term v) = auxiliaryTopStressCoefficient k D hd hpm rho := by
    rw [Finset.sum_eq_single c]
    · simp only [term]
      rw [hsAdd, hell.2 c hcSupport, if_pos rfl, mul_one]
    · intro v hv hvc
      have hvSupport : v ∈ rho.support := (Finset.mem_filter.mp hv).2
      simp only [term]
      rw [hell.2 v hvSupport, if_neg hvc.symm, mul_zero]
    · intro hcNot
      exact False.elim (hcNot
        (Finset.mem_filter.mpr ⟨Finset.mem_univ c, hcSupport⟩))
  have hsplit := Finset.sum_filter_add_sum_filter_not
    (s := Finset.univ) (p := fun v : Fin m ↦ v ∈ rho.support) term
  have hsumoutside :
      auxiliaryTopStressCoefficient k D hd hpm rho +
        ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
          term v = 0 := by
    rw [← hinside, ← htotal]
    exact hsplit
  have hneg := eq_neg_of_add_eq_zero_left hsumoutside
  rw [CharTwo.neg_eq] at hneg
  rw [hneg]

noncomputable def auxiliaryFacetExpansionTerm
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1))
    (rho : Fin m →₀ ℕ) : AuxiliaryField k n m :=
  if rho.support ⊆ F.1 then
    auxiliaryTopStressCoefficient k D hd hpm
        (squarefreeExponent F.1) *
      auxiliaryFacetWeight k F.1 F.2.2 rho
  else 0

noncomputable def auxiliaryFacetExpansion
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) : AuxiliaryField k n m :=
  ∑ F : FacetOfCard D (n + 1),
    auxiliaryFacetExpansionTerm k D hd hpm F rho

theorem auxiliaryFacetExpansion_nonface
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ)
    (hrho : rho.support ∉ AugmentedComplex.ofAbstract D) :
    auxiliaryFacetExpansion k D hd hpm rho = 0 := by
  rw [auxiliaryFacetExpansion]
  apply Finset.sum_eq_zero
  intro F _hF
  rw [auxiliaryFacetExpansionTerm, if_neg]
  intro hsub
  apply hrho
  rw [AugmentedComplex.mem_ofAbstract]
  by_cases hempty : rho.support = ∅
  · exact Or.inl hempty
  · exact Or.inr ((D.isRelLowerSet_faces F.2.1).2 hsub
      (Finset.nonempty_iff_ne_empty.mpr hempty))

theorem auxiliaryFacetExpansion_squarefree_facet
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    auxiliaryFacetExpansion k D hd hpm (squarefreeExponent F.1) =
      auxiliaryTopStressCoefficient k D hd hpm
        (squarefreeExponent F.1) := by
  rw [auxiliaryFacetExpansion, Finset.sum_eq_single F]
  · rw [auxiliaryFacetExpansionTerm, squarefreeExponent_support, if_pos (by
        intro v hv
        exact hv),
      auxiliaryFacetWeight_squarefree, mul_one]
  · intro G _hG hGF
    rw [auxiliaryFacetExpansionTerm, squarefreeExponent_support, if_neg]
    intro hsub
    apply hGF
    apply Subtype.ext
    have hFG : F.1 = G.1 := Finset.eq_of_subset_of_card_le hsub (by
      rw [G.2.2, F.2.2])
    exact hFG.symm
  · simp

theorem auxiliaryFacetExpansionTerm_pivot
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) (c : Fin m)
    (hcSupport : c ∈ rho.support) (hcTwo : 2 ≤ rho c)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m)
    (hell : IsSupportPivotFunctional k rho.support c ell)
    (F : FacetOfCard D (n + 1)) :
    (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
      auxiliaryFacetExpansionTerm k D hd hpm F
          (rho - Finsupp.single c 1 + Finsupp.single v 1) *
        ell (fun i ↦ auxiliaryGenericCoefficient k i v)) =
      auxiliaryFacetExpansionTerm k D hd hpm F rho := by
  classical
  let s : Fin m →₀ ℕ := rho - Finsupp.single c 1
  have hsDef : rho - Finsupp.single c 1 = s := rfl
  have hsSupport : s.support = rho.support :=
    Generic.finsupp_sub_single_support_eq_of_two_le rho c hcTwo
  have hsAdd : s + Finsupp.single c 1 = rho :=
    Generic.finsupp_sub_single_add_single rho c (by omega)
  rw [hsDef]
  by_cases hSF : rho.support ⊆ F.1
  · rw [auxiliaryFacetExpansionTerm, if_pos hSF]
    have hcF : c ∈ F.1 := hSF hcSupport
    let bF : AuxiliaryField k n m :=
      auxiliaryTopStressCoefficient k D hd hpm (squarefreeExponent F.1)
    let qS : AuxiliaryField k n m :=
      auxiliaryFacetWeight k F.1 F.2.2 s
    have hweightRho :
        auxiliaryFacetWeight k F.1 F.2.2 rho =
          qS *
            auxiliaryFacetBracket k F.1 F.2.2 ⟨c, hcF⟩ := by
      simp only [qS]
      rw [← hsAdd]
      exact auxiliaryFacetWeight_add_single k F.1 F.2.2 s c hcF
    have hpoint (v : Fin m) (hvNot : v ∉ rho.support) :
        auxiliaryFacetExpansionTerm k D hd hpm F
            (s + Finsupp.single v 1) =
          bF * (qS * auxiliaryFacetBracketAt k F.1 F.2.2 v) := by
      have hvNotS : v ∉ s.support := by simpa [hsSupport] using hvNot
      have hnewSupport :
          (s + Finsupp.single v 1).support = insert v rho.support := by
        rw [Generic.finsupp_support_add_new_single s v hvNotS, hsSupport]
      rw [auxiliaryFacetExpansionTerm]
      by_cases hvF : v ∈ F.1
      · have hnewF : (s + Finsupp.single v 1).support ⊆ F.1 := by
          rw [hnewSupport]
          exact Finset.insert_subset hvF hSF
        rw [if_pos hnewF,
          auxiliaryFacetWeight_add_single k F.1 F.2.2 s v hvF,
          auxiliaryFacetBracketAt_of_mem k F.1 F.2.2 v hvF]
      · have hnewNotF : ¬(s + Finsupp.single v 1).support ⊆ F.1 := by
          intro hnewF
          apply hvF
          apply hnewF
          rw [hnewSupport]
          exact Finset.mem_insert_self v rho.support
        rw [if_neg hnewNotF,
          auxiliaryFacetBracketAt_of_not_mem k F.1 F.2.2 v hvF]
        ring
    calc
      (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
        auxiliaryFacetExpansionTerm k D hd hpm F
            (s + Finsupp.single v 1) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i v)) =
        ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
          (bF * (qS * auxiliaryFacetBracketAt k F.1 F.2.2 v)) *
            ell (fun i ↦ auxiliaryGenericCoefficient k i v) := by
        apply Finset.sum_congr rfl
        intro v hv
        have hvNot : v ∉ rho.support := (Finset.mem_filter.mp hv).2
        rw [hpoint v hvNot]
      _ = ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
          (bF * qS) *
            (auxiliaryFacetBracketAt k F.1 F.2.2 v *
              ell (fun i ↦ auxiliaryGenericCoefficient k i v)) := by
        apply Finset.sum_congr rfl
        intro v _hv
        ring
      _ = (bF * qS) *
          (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
            auxiliaryFacetBracketAt k F.1 F.2.2 v *
              ell (fun i ↦ auxiliaryGenericCoefficient k i v)) := by
        rw [Finset.mul_sum]
      _ = (bF * qS) *
          auxiliaryFacetBracket k F.1 F.2.2 ⟨c, hcF⟩ := by
        rw [supportPivot_crossBracket_global k rho.support F.1 F.2.2
          hSF c hcSupport ell hell]
      _ = auxiliaryTopStressCoefficient k D hd hpm
              (squarefreeExponent F.1) *
            auxiliaryFacetWeight k F.1 F.2.2 rho := by
        rw [hweightRho]
        ring
  · rw [auxiliaryFacetExpansionTerm, if_neg hSF]
    apply Finset.sum_eq_zero
    intro v hv
    have hvNot : v ∉ rho.support := (Finset.mem_filter.mp hv).2
    have hvNotS : v ∉ s.support := by simpa [hsSupport] using hvNot
    have hnewSupport :
        (s + Finsupp.single v 1).support = insert v rho.support := by
      rw [Generic.finsupp_support_add_new_single s v hvNotS, hsSupport]
    rw [auxiliaryFacetExpansionTerm, if_neg]
    · simp
    · intro hnewF
      apply hSF
      intro w hw
      apply hnewF
      rw [hnewSupport]
      exact Finset.mem_insert_of_mem hw

theorem auxiliaryFacetExpansion_pivot
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) (c : Fin m)
    (hcSupport : c ∈ rho.support) (hcTwo : 2 ≤ rho c)
    (ell : (Fin (n + 1) → AuxiliaryField k n m) →ₗ[AuxiliaryField k n m]
      AuxiliaryField k n m)
    (hell : IsSupportPivotFunctional k rho.support c ell) :
    auxiliaryFacetExpansion k D hd hpm rho =
      ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
        auxiliaryFacetExpansion k D hd hpm
            (rho - Finsupp.single c 1 + Finsupp.single v 1) *
          ell (fun i ↦ auxiliaryGenericCoefficient k i v) := by
  classical
  symm
  calc
    (∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
      auxiliaryFacetExpansion k D hd hpm
          (rho - Finsupp.single c 1 + Finsupp.single v 1) *
        ell (fun i ↦ auxiliaryGenericCoefficient k i v)) =
      ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
        ∑ F : FacetOfCard D (n + 1),
          auxiliaryFacetExpansionTerm k D hd hpm F
              (rho - Finsupp.single c 1 + Finsupp.single v 1) *
            ell (fun i ↦ auxiliaryGenericCoefficient k i v) := by
      apply Finset.sum_congr rfl
      intro v _hv
      rw [auxiliaryFacetExpansion, Finset.sum_mul]
    _ = ∑ F : FacetOfCard D (n + 1),
        ∑ v ∈ Finset.univ.filter (fun v : Fin m ↦ v ∉ rho.support),
          auxiliaryFacetExpansionTerm k D hd hpm F
              (rho - Finsupp.single c 1 + Finsupp.single v 1) *
            ell (fun i ↦ auxiliaryGenericCoefficient k i v) := by
      rw [Finset.sum_comm]
    _ = ∑ F : FacetOfCard D (n + 1),
        auxiliaryFacetExpansionTerm k D hd hpm F rho := by
      apply Finset.sum_congr rfl
      intro F _hF
      exact auxiliaryFacetExpansionTerm_pivot k D hd hpm rho c
        hcSupport hcTwo ell hell F
    _ = auxiliaryFacetExpansion k D hd hpm rho := by
      rw [auxiliaryFacetExpansion]

theorem auxiliaryTopStressCoefficient_eq_facetExpansion
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (rho : Fin m →₀ ℕ) (hrhoDegree : rho.degree = n + 1) :
    auxiliaryTopStressCoefficient k D hd hpm rho =
      auxiliaryFacetExpansion k D hd hpm rho := by
  classical
  generalize he : n + 1 - rho.support.card = e
  induction e using Nat.strong_induction_on generalizing rho with
  | h e ih =>
      by_cases hface : rho.support ∈ AugmentedComplex.ofAbstract D
      · have hcardle : rho.support.card ≤ rho.degree :=
          Generic.finsupp_card_support_le_degree rho
        by_cases hcardeq : rho.support.card = n + 1
        · have hcarddegree : rho.support.card = rho.degree := by omega
          have hsquarefree :=
            Generic.finsupp_eq_squarefreeExponent_support_of_card_eq_degree
              rho hcarddegree
          have hsupportNonempty : rho.support.Nonempty :=
            Finset.card_pos.mp (by omega)
          have hsupportD : rho.support ∈ D :=
            (AugmentedComplex.nonempty_mem_ofAbstract_iff
              D hsupportNonempty).mp hface
          let F : FacetOfCard D (n + 1) :=
            ⟨rho.support, hsupportD, hcardeq⟩
          rw [hsquarefree]
          simpa [F] using
            (auxiliaryFacetExpansion_squarefree_facet k D hd hpm F).symm
        · have hcardlt : rho.support.card < rho.degree := by omega
          obtain ⟨c, hcSupport, hcTwo⟩ :=
            Generic.finsupp_exists_repeated_of_card_support_lt_degree
              rho hcardlt
          have hsupportNonempty : rho.support.Nonempty := ⟨c, hcSupport⟩
          have hsupportD : rho.support ∈ D :=
            (AugmentedComplex.nonempty_mem_ofAbstract_iff
              D hsupportNonempty).mp hface
          obtain ⟨H, hHD, hsupportH, hHcard⟩ := hpm.pure hsupportD
          have hHnotSupport : ¬H ⊆ rho.support := by
            intro hHsupport
            have hEq : H = rho.support :=
              Finset.Subset.antisymm hHsupport hsupportH
            have hcards := congrArg Finset.card hEq
            omega
          obtain ⟨t, htH, htNotSupport⟩ :
              ∃ t, t ∈ H ∧ t ∉ rho.support := by
            by_contra hnone
            apply hHnotSupport
            intro t htH'
            by_contra htSupport
            exact hnone ⟨t, htH', htSupport⟩
          let tH : ↥H := ⟨t, htH⟩
          let ell := normalizedCompletionFunctional k H hHcard tH
            ⟨c, hsupportH hcSupport⟩
          have hell : IsSupportPivotFunctional k rho.support c ell := by
            simpa [ell, tH] using
              (normalizedCompletionFunctional_isSupportPivotFunctional
                k rho.support H hHcard hsupportH tH htNotSupport
                c hcSupport)
          let s : Fin m →₀ ℕ := rho - Finsupp.single c 1
          have hsSupport : s.support = rho.support :=
            Generic.finsupp_sub_single_support_eq_of_two_le rho c hcTwo
          have hsAdd : s + Finsupp.single c 1 = rho :=
            Generic.finsupp_sub_single_add_single rho c (by omega)
          have hsDegree : s.degree + 1 = n + 1 := by
            have hdegree := congrArg Finsupp.degree hsAdd
            simpa only [map_add, Finsupp.degree_single,
              hrhoDegree] using hdegree
          rw [auxiliaryTopStressCoefficient_pivot k D hd hpm rho c
              hcSupport hcTwo ell hell,
            auxiliaryFacetExpansion_pivot k D hd hpm rho c
              hcSupport hcTwo ell hell]
          apply Finset.sum_congr rfl
          intro v hv
          have hvNot : v ∉ rho.support := (Finset.mem_filter.mp hv).2
          have hvNotS : v ∉ s.support := by simpa [hsSupport] using hvNot
          have hnewSupport :
              (s + Finsupp.single v 1).support =
                insert v rho.support := by
            rw [Generic.finsupp_support_add_new_single s v hvNotS,
              hsSupport]
          have hnewCard :
              (s + Finsupp.single v 1).support.card =
                rho.support.card + 1 := by
            rw [hnewSupport, Finset.card_insert_of_notMem hvNot]
          have hnewDegree :
              (s + Finsupp.single v 1).degree = n + 1 := by
            rw [map_add, Finsupp.degree_single]
            omega
          have hnewMeasure :
              n + 1 - (s + Finsupp.single v 1).support.card < e := by
            omega
          rw [ih _ hnewMeasure _ hnewDegree rfl]
      · rw [auxiliaryTopStressCoefficient_nonface k D hd hpm rho hface,
          auxiliaryFacetExpansion_nonface k D hd hpm rho hface]

end SimplicialSphereAnisotropicity.Stress

end

end

section

/-!
# Two-one specialization of the top-stress expansion

This module specializes the factorial-free top-stress formula to an exponent
which is two on a finset `T`, one on a disjoint finset `B`, and zero elsewhere.
It proves the exact facet numerator/denominator expression used by the later
displacement and derivative arguments.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Generic SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_SpecializedCoefficient (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

def twoOneExponent {m : ℕ}
    (T B : Finset (Fin m)) : Fin m →₀ ℕ :=
  squarefreeExponent T + squarefreeExponent T + squarefreeExponent B

@[simp]
theorem twoOneExponent_apply {m : ℕ}
    (T B : Finset (Fin m)) (hTB : Disjoint T B) (v : Fin m) :
    twoOneExponent T B v =
      if v ∈ T then 2 else if v ∈ B then 1 else 0 := by
  classical
  by_cases hvT : v ∈ T <;> by_cases hvB : v ∈ B
  · exact False.elim ((Finset.disjoint_left.mp hTB) hvT hvB)
  · simp [twoOneExponent, squarefreeExponent_apply, hvT, hvB]
  · simp [twoOneExponent, squarefreeExponent_apply, hvT, hvB]
  · simp [twoOneExponent, squarefreeExponent_apply, hvT, hvB]

@[simp]
theorem twoOneExponent_support {m : ℕ}
    (T B : Finset (Fin m)) :
    (twoOneExponent T B).support = T ∪ B := by
  classical
  ext v
  rw [Finsupp.mem_support_iff]
  by_cases hvT : v ∈ T <;> by_cases hvB : v ∈ B <;>
    simp [twoOneExponent, squarefreeExponent_apply, hvT, hvB]

@[simp]
theorem twoOneExponent_degree {m : ℕ}
    (T B : Finset (Fin m)) :
    (twoOneExponent T B).degree = 2 * T.card + B.card := by
  rw [twoOneExponent, map_add, map_add,
    Generic.squarefreeExponent_degree,
    Generic.squarefreeExponent_degree]
  omega

theorem auxiliaryTopStressCoefficient_squarefree_facet
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    auxiliaryTopStressCoefficient k D hd hpm (squarefreeExponent F.1) =
      (algebraMap (K_SpecializedCoefficient k n m) (AuxiliaryField k n m)
        (Generic.faceMinor k F.1 F.2.2))⁻¹ := by
  rw [auxiliaryTopStressCoefficient,
    Generic.Brion.topStressCoefficient_squarefree_facet, map_inv₀]

noncomputable def auxiliarySpecialFacetWeight
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (T B : Finset (Fin m)) : AuxiliaryField k n m :=
  (∏ t ∈ T, auxiliaryFacetBracketAt k F hF t) /
    ∏ g ∈ F \ (T ∪ B), auxiliaryFacetBracketAt k F hF g

theorem auxiliaryFacetWeight_eq_ambientProduct
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (rho : Fin m →₀ ℕ) :
    auxiliaryFacetWeight k F hF rho =
      (∏ v ∈ F, auxiliaryFacetBracketAt k F hF v ^ rho v) /
        ∏ v ∈ F, auxiliaryFacetBracketAt k F hF v := by
  rw [auxiliaryFacetWeight]
  congr 1
  · simpa using
      (Finset.prod_attach F
        (fun v ↦ auxiliaryFacetBracketAt k F hF v ^ rho v))
  · simpa using
      (Finset.prod_attach F
        (fun v ↦ auxiliaryFacetBracketAt k F hF v))

theorem auxiliaryFacetBracketAt_ne_zero_of_mem
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v : Fin m) (hvF : v ∈ F) :
    auxiliaryFacetBracketAt k F hF v ≠ 0 := by
  rw [auxiliaryFacetBracketAt_of_mem k F hF v hvF]
  exact auxiliaryFacetBracket_ne_zero k F hF ⟨v, hvF⟩

theorem auxiliaryFacetWeight_twoOne
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (T B : Finset (Fin m)) (hTB : Disjoint T B)
    (hsub : T ∪ B ⊆ F) :
    auxiliaryFacetWeight k F hF (twoOneExponent T B) =
      auxiliarySpecialFacetWeight k F hF T B := by
  classical
  rw [auxiliaryFacetWeight_eq_ambientProduct,
    auxiliarySpecialFacetWeight]
  let C : Fin m → AuxiliaryField k n m :=
    fun v ↦ auxiliaryFacetBracketAt k F hF v
  change ((∏ v ∈ F, C v ^ twoOneExponent T B v) /
      ∏ v ∈ F, C v) =
    (∏ t ∈ T, C t) / ∏ g ∈ F \ (T ∪ B), C g
  have hTsub : T ⊆ F := by
    intro v hv
    exact hsub (Finset.mem_union_left B hv)
  have hBsub : B ⊆ F := by
    intro v hv
    exact hsub (Finset.mem_union_right T hv)
  have hTprod :
      (∏ v ∈ T, C v ^ twoOneExponent T B v) =
        (∏ v ∈ T, C v) ^ 2 := by
    calc
      (∏ v ∈ T, C v ^ twoOneExponent T B v) =
          ∏ v ∈ T, C v ^ 2 := by
        apply Finset.prod_congr rfl
        intro v hv
        rw [twoOneExponent_apply T B hTB v, if_pos hv]
      _ = (∏ v ∈ T, C v) ^ 2 := by
        rw [Finset.prod_pow]
  have hBprod :
      (∏ v ∈ B, C v ^ twoOneExponent T B v) =
        ∏ v ∈ B, C v := by
    apply Finset.prod_congr rfl
    intro v hvB
    have hvNotT : v ∉ T := by
      intro hvT
      exact (Finset.disjoint_left.mp hTB) hvT hvB
    rw [twoOneExponent_apply T B hTB v, if_neg hvNotT,
      if_pos hvB, pow_one]
  have hRprod :
      (∏ v ∈ F \ (T ∪ B), C v ^ twoOneExponent T B v) = 1 := by
    apply Finset.prod_eq_one
    intro v hv
    have hvNotUnion : v ∉ T ∪ B := (Finset.mem_sdiff.mp hv).2
    have hvNotT : v ∉ T := by
      intro hvT
      exact hvNotUnion (Finset.mem_union_left B hvT)
    have hvNotB : v ∉ B := by
      intro hvB
      exact hvNotUnion (Finset.mem_union_right T hvB)
    rw [twoOneExponent_apply T B hTB v, if_neg hvNotT,
      if_neg hvNotB, pow_zero]
  have hnum :
      (∏ v ∈ F, C v ^ twoOneExponent T B v) =
        (∏ v ∈ T, C v) ^ 2 * ∏ v ∈ B, C v := by
    calc
      (∏ v ∈ F, C v ^ twoOneExponent T B v) =
          (∏ v ∈ F \ (T ∪ B), C v ^ twoOneExponent T B v) *
            ∏ v ∈ T ∪ B, C v ^ twoOneExponent T B v :=
        (Finset.prod_sdiff hsub).symm
      _ = (∏ v ∈ F \ (T ∪ B), C v ^ twoOneExponent T B v) *
          ((∏ v ∈ T, C v ^ twoOneExponent T B v) *
            ∏ v ∈ B, C v ^ twoOneExponent T B v) := by
        rw [Finset.prod_union hTB]
      _ = (∏ v ∈ T, C v) ^ 2 * ∏ v ∈ B, C v := by
        rw [hRprod, hTprod, hBprod, one_mul]
  have hden :
      (∏ v ∈ F, C v) =
        (∏ v ∈ T, C v) * (∏ v ∈ B, C v) *
          ∏ v ∈ F \ (T ∪ B), C v := by
    calc
      (∏ v ∈ F, C v) =
          (∏ v ∈ F \ (T ∪ B), C v) * ∏ v ∈ T ∪ B, C v :=
        (Finset.prod_sdiff hsub).symm
      _ = (∏ v ∈ F \ (T ∪ B), C v) *
          ((∏ v ∈ T, C v) * ∏ v ∈ B, C v) := by
        rw [Finset.prod_union hTB]
      _ = (∏ v ∈ T, C v) * (∏ v ∈ B, C v) *
          ∏ v ∈ F \ (T ∪ B), C v := by ring
  have hTne : (∏ v ∈ T, C v) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro v hv
    exact auxiliaryFacetBracketAt_ne_zero_of_mem k F hF v (hTsub hv)
  have hBne : (∏ v ∈ B, C v) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro v hv
    exact auxiliaryFacetBracketAt_ne_zero_of_mem k F hF v (hBsub hv)
  have hRne : (∏ v ∈ F \ (T ∪ B), C v) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro v hv
    exact auxiliaryFacetBracketAt_ne_zero_of_mem k F hF v
      (Finset.mem_sdiff.mp hv).1
  rw [hnum, hden]
  field_simp [hTne, hBne, hRne]

theorem auxiliaryTopStressCoefficient_twoOne_formula
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (T B : Finset (Fin m)) (hTB : Disjoint T B)
    (hdegree : 2 * T.card + B.card = n + 1) :
    auxiliaryTopStressCoefficient k D hd hpm (twoOneExponent T B) =
      ∑ F : FacetOfCard D (n + 1),
        if T ∪ B ⊆ F.1 then
          (algebraMap (K_SpecializedCoefficient k n m) (AuxiliaryField k n m)
              (Generic.faceMinor k F.1 F.2.2))⁻¹ *
            auxiliarySpecialFacetWeight k F.1 F.2.2 T B
        else 0 := by
  have hrhoDegree : (twoOneExponent T B).degree = n + 1 := by
    rw [twoOneExponent_degree, hdegree]
  rw [auxiliaryTopStressCoefficient_eq_facetExpansion
      k D hd hpm (twoOneExponent T B) hrhoDegree,
    auxiliaryFacetExpansion]
  apply Finset.sum_congr rfl
  intro F _hF
  rw [auxiliaryFacetExpansionTerm, twoOneExponent_support]
  by_cases hsub : T ∪ B ⊆ F.1
  · simp only [if_pos hsub]
    rw [
      auxiliaryTopStressCoefficient_squarefree_facet k D hd hpm F,
      auxiliaryFacetWeight_twoOne k F.1 F.2.2 T B hTB hsub]
  · simp only [if_neg hsub]

theorem auxiliaryTopStressCoefficient_twoOne_formula_of_card
    (k : Type u) [Field k] [CharP k 2] {n m ell : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (T B : Finset (Fin m)) (hTB : Disjoint T B)
    (hT : T.card = ell) (h2ell : 2 * ell ≤ n + 1)
    (hB : B.card = n + 1 - 2 * ell) :
    auxiliaryTopStressCoefficient k D hd hpm (twoOneExponent T B) =
      ∑ F : FacetOfCard D (n + 1),
        if T ∪ B ⊆ F.1 then
          (algebraMap (K_SpecializedCoefficient k n m) (AuxiliaryField k n m)
              (Generic.faceMinor k F.1 F.2.2))⁻¹ *
            auxiliarySpecialFacetWeight k F.1 F.2.2 T B
        else 0 := by
  apply auxiliaryTopStressCoefficient_twoOne_formula k D hd hpm T B hTB
  omega

end SimplicialSphereAnisotropicity.Stress

end

end

section

/-!
# Displacement away from a forbidden face

This module formalizes the first displacement induction.  A generic pivot on
an arbitrary completion of `support ∪ Gamma` replaces either a repeated
variable or a variable in `Gamma` by a new vertex.  Strong induction on the
exact support/intersection complexity reduces every homogeneous monomial class
to the span of square-free face monomials disjoint from `Gamma`.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_DisplacementAway (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

def displacementComplexity {m : ℕ}
    (Gamma : Finset (Fin m)) (a : Fin m →₀ ℕ) : ℕ :=
  a.degree - a.support.card + (a.support ∩ Gamma).card

theorem finsupp_sub_single_support_eq_erase_of_eq_one
    {m : ℕ} (a : Fin m →₀ ℕ) (c : Fin m) (hc : a c = 1) :
    (a - Finsupp.single c 1).support = a.support.erase c := by
  ext w
  rw [Finsupp.mem_support_iff, Finset.mem_erase,
    Finsupp.mem_support_iff]
  by_cases hwc : w = c
  · subst w
    simp [Finsupp.tsub_apply, hc]
  · simp [Finsupp.tsub_apply, hwc]

theorem displacementComplexity_replace_lt
    {m : ℕ} (Gamma : Finset (Fin m)) (a : Fin m →₀ ℕ)
    (c w : Fin m) (hcSupport : c ∈ a.support)
    (hcPivot : 2 ≤ a c ∨ c ∈ Gamma)
    (hwSupport : w ∉ a.support) (hwGamma : w ∉ Gamma) :
    displacementComplexity Gamma
        (a - Finsupp.single c 1 + Finsupp.single w 1) <
      displacementComplexity Gamma a := by
  classical
  let b : Fin m →₀ ℕ := a - Finsupp.single c 1
  have hbDef : a - Finsupp.single c 1 = b := rfl
  rw [hbDef]
  have hbAdd : b + Finsupp.single c 1 = a :=
    SimplicialSphereAnisotropicity.Generic.finsupp_sub_single_add_single a c (by
      exact Finsupp.mem_support_iff.mp hcSupport |> Nat.one_le_iff_ne_zero.mpr)
  have hbDegree : b.degree + 1 = a.degree := by
    have hdegree := congrArg Finsupp.degree hbAdd
    simpa only [map_add, Finsupp.degree_single] using hdegree
  have hnewDegree :
      (b + Finsupp.single w 1).degree = a.degree := by
    rw [map_add, Finsupp.degree_single]
    omega
  by_cases hcTwo : 2 ≤ a c
  · have hbSupport : b.support = a.support :=
      SimplicialSphereAnisotropicity.Generic.finsupp_sub_single_support_eq_of_two_le a c hcTwo
    have hwB : w ∉ b.support := by simpa [hbSupport] using hwSupport
    have hnewSupport :
        (b + Finsupp.single w 1).support = insert w a.support := by
      rw [SimplicialSphereAnisotropicity.Generic.finsupp_support_add_new_single b w hwB,
        hbSupport]
    have hnewCard :
        (b + Finsupp.single w 1).support.card =
          a.support.card + 1 := by
      rw [hnewSupport, Finset.card_insert_of_notMem hwSupport]
    have hinter :
        (b + Finsupp.single w 1).support ∩ Gamma =
          a.support ∩ Gamma := by
      rw [hnewSupport]
      ext x
      by_cases hxw : x = w
      · subst x
        simp [hwSupport, hwGamma]
      · simp [hxw]
    rw [displacementComplexity, displacementComplexity,
      hnewDegree, hnewCard, hinter]
    have hcardlt :=
      SimplicialSphereAnisotropicity.Generic.finsupp_card_support_lt_degree_of_two_le
        a c hcSupport hcTwo
    omega
  · have hcOne : a c = 1 := by
      have hcNe : a c ≠ 0 := Finsupp.mem_support_iff.mp hcSupport
      omega
    have hcGamma : c ∈ Gamma := hcPivot.resolve_left hcTwo
    have hbSupport : b.support = a.support.erase c :=
      finsupp_sub_single_support_eq_erase_of_eq_one a c hcOne
    have hwB : w ∉ b.support := by
      rw [hbSupport]
      exact fun hw ↦ hwSupport (Finset.mem_of_mem_erase hw)
    have hnewSupport :
        (b + Finsupp.single w 1).support =
          insert w (a.support.erase c) := by
      rw [SimplicialSphereAnisotropicity.Generic.finsupp_support_add_new_single b w hwB,
        hbSupport]
    have hwErase : w ∉ a.support.erase c := by
      simpa [hbSupport] using hwB
    have hnewCard :
        (b + Finsupp.single w 1).support.card = a.support.card := by
      have hsupportPos : 0 < a.support.card :=
        Finset.card_pos.mpr ⟨c, hcSupport⟩
      rw [hnewSupport, Finset.card_insert_of_notMem hwErase,
        Finset.card_erase_of_mem hcSupport]
      omega
    have hwc : w ≠ c := by
      intro hwc
      exact hwSupport (hwc ▸ hcSupport)
    have hinter :
        (b + Finsupp.single w 1).support ∩ Gamma =
          (a.support ∩ Gamma).erase c := by
      rw [hnewSupport]
      ext x
      simp only [Finset.mem_inter, Finset.mem_insert,
        Finset.mem_erase]
      constructor
      · rintro ⟨hxw | ⟨hxc, hxa⟩, hxG⟩
        · subst x
          exact False.elim (hwGamma hxG)
        · exact ⟨hxc, hxa, hxG⟩
      · rintro ⟨hxc, hxa, hxG⟩
        exact ⟨Or.inr ⟨hxc, hxa⟩, hxG⟩
    have hcInter : c ∈ a.support ∩ Gamma :=
      Finset.mem_inter.mpr ⟨hcSupport, hcGamma⟩
    have hinterPos : 0 < (a.support ∩ Gamma).card :=
      Finset.card_pos.mpr ⟨c, hcInter⟩
    have hinterCard :
        ((b + Finsupp.single w 1).support ∩ Gamma).card + 1 =
          (a.support ∩ Gamma).card := by
      rw [hinter, Finset.card_erase_of_mem hcInter]
      omega
    have hinterLt :
        ((b + Finsupp.single w 1).support ∩ Gamma).card <
          (a.support ∩ Gamma).card := by omega
    have hadd := Nat.add_lt_add_left hinterLt
      (a.degree - a.support.card)
    simpa only [displacementComplexity, hnewDegree, hnewCard] using hadd

abbrev AwayFace {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m)) (r : ℕ) :=
  {F : AugmentedSimplex (AugmentedComplex.ofAbstract D) r //
    Disjoint F.1 Gamma}

noncomputable def awaySquarefreeReductionSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m)) :
    Submodule (K_DisplacementAway k n m) (SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D) :=
  Submodule.span (K_DisplacementAway k n m)
    (Set.range (fun F : AwayFace D Gamma r ↦
      SimplicialSphereAnisotropicity.Generic.squarefreeReductionVector k D F.1))

theorem reduction_monomial_mem_awaySquarefreeReductionSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGammaCard : Gamma.card + r = n + 1)
    (hdm : n + 1 ≤ m)
    (a : Fin m →₀ ℕ) (haDegree : a.degree = r) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
      (MvPolynomial.monomial a 1) ∈
      awaySquarefreeReductionSpan k (n := n) (r := r) D Gamma := by
  classical
  generalize he : displacementComplexity Gamma a = e
  induction e using Nat.strong_induction_on generalizing a with
  | h e ih =>
      by_cases hface : a.support ∈ AugmentedComplex.ofAbstract D
      · have hcardle : a.support.card ≤ a.degree :=
          SimplicialSphereAnisotropicity.Generic.finsupp_card_support_le_degree a
        by_cases hbase :
            a.support.card = a.degree ∧ Disjoint a.support Gamma
        · have hasquarefree :=
            SimplicialSphereAnisotropicity.Generic.finsupp_eq_squarefreeExponent_support_of_card_eq_degree
              a hbase.1
          let Fq : AugmentedSimplex
              (AugmentedComplex.ofAbstract D) r :=
            ⟨a.support, hface, by omega⟩
          let AF : AwayFace D Gamma r := ⟨Fq, hbase.2⟩
          rw [hasquarefree,
            ← faceMonomial_eq_monomial_squarefreeExponent]
          apply Submodule.subset_span
          exact Set.mem_range_self AF
        · obtain ⟨c, hcSupport, hcPivot⟩ :
              ∃ c ∈ a.support, 2 ≤ a c ∨ c ∈ Gamma := by
            by_cases hcardlt : a.support.card < a.degree
            · obtain ⟨c, hcSupport, hcTwo⟩ :=
                SimplicialSphereAnisotropicity.Generic.finsupp_exists_repeated_of_card_support_lt_degree
                  a hcardlt
              exact ⟨c, hcSupport, Or.inl hcTwo⟩
            · have hcardeq : a.support.card = a.degree := by omega
              have hnotDisjoint : ¬Disjoint a.support Gamma := by
                intro hdisj
                exact hbase ⟨hcardeq, hdisj⟩
              have hinterNonempty : (a.support ∩ Gamma).Nonempty := by
                apply Finset.nonempty_iff_ne_empty.mpr
                intro hinterEmpty
                apply hnotDisjoint
                exact Finset.disjoint_iff_inter_eq_empty.mpr hinterEmpty
              obtain ⟨c, hcInter⟩ := hinterNonempty
              exact ⟨c, (Finset.mem_inter.mp hcInter).1,
                Or.inr (Finset.mem_inter.mp hcInter).2⟩
          have hsupportCard : a.support.card ≤ r := by omega
          have hUnionCard : (a.support ∪ Gamma).card ≤ n + 1 := by
            have hcardUnion :=
              Finset.card_union_add_card_inter a.support Gamma
            omega
          obtain ⟨F, hUnionF, _hFuniv, hFcard⟩ :=
            Finset.exists_subsuperset_card_eq
              (Finset.subset_univ (a.support ∪ Gamma)) hUnionCard (by
                simpa using hdm)
          have hcF : c ∈ F := hUnionF
            (Finset.mem_union_left Gamma hcSupport)
          let j : Fin (n + 1) :=
            (F.orderIsoOfFin hFcard).symm ⟨c, hcF⟩
          let b : Fin m →₀ ℕ := a - Finsupp.single c 1
          have hbAdd : b + Finsupp.single c 1 = a :=
            SimplicialSphereAnisotropicity.Generic.finsupp_sub_single_add_single a c (by
              exact Nat.pos_of_ne_zero
                (Finsupp.mem_support_iff.mp hcSupport))
          have hbDegree : b.degree + 1 = r := by
            have hdegree := congrArg Finsupp.degree hbAdd
            simpa only [map_add, Finsupp.degree_single,
              haDegree] using hdegree
          have hjc : SimplicialSphereAnisotropicity.Generic.orderedFaceEmbedding F hFcard j = c := by
            change ((F.orderIsoOfFin hFcard)
              ((F.orderIsoOfFin hFcard).symm ⟨c, hcF⟩)).1 = c
            exact congrArg Subtype.val
              ((F.orderIsoOfFin hFcard).apply_symm_apply ⟨c, hcF⟩)
          let term : Fin m → SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D :=
            fun w ↦ SimplicialSphereAnisotropicity.Generic.facetPivotCoefficient k F hFcard j w •
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                (MvPolynomial.monomial (b + Finsupp.single w 1) 1)
          have hsum : (∑ w : Fin m, term w) = 0 := by
            exact SimplicialSphereAnisotropicity.Generic.facetPivot_monomial_relation
              k D F hFcard j b
          have hcoeffC :
              SimplicialSphereAnisotropicity.Generic.facetPivotCoefficient k F hFcard j c = 1 := by
            rw [← hjc,
              SimplicialSphereAnisotropicity.Generic.facetPivotCoefficient_orderedFaceEmbedding]
            simp
          have htermC : term c =
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                (MvPolynomial.monomial a 1) := by
            simp only [term, hcoeffC, one_smul, hbAdd]
          have htermMem (w : Fin m) (hwc : w ≠ c) :
              term w ∈ awaySquarefreeReductionSpan k (n := n) (r := r)
                D Gamma := by
            by_cases hwF : w ∈ F
            · let l : Fin (n + 1) :=
                (F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩
              have hlw : SimplicialSphereAnisotropicity.Generic.orderedFaceEmbedding F hFcard l =
                  w := by
                change ((F.orderIsoOfFin hFcard)
                  ((F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩)).1 = w
                exact congrArg Subtype.val
                  ((F.orderIsoOfFin hFcard).apply_symm_apply ⟨w, hwF⟩)
              have hjl : j ≠ l := by
                intro hjl
                apply hwc
                rw [← hjc, ← hlw, hjl]
              have hcoeffW :
                  SimplicialSphereAnisotropicity.Generic.facetPivotCoefficient k F hFcard j w =
                    0 := by
                rw [← hlw,
                  SimplicialSphereAnisotropicity.Generic.facetPivotCoefficient_orderedFaceEmbedding,
                  if_neg hjl]
              simp only [term, hcoeffW, zero_smul]
              exact Submodule.zero_mem _
            · have hwSupport : w ∉ a.support := by
                intro hw
                exact hwF (hUnionF (Finset.mem_union_left Gamma hw))
              have hwGamma : w ∉ Gamma := by
                intro hw
                exact hwF (hUnionF (Finset.mem_union_right a.support hw))
              have hnewDegree :
                  (b + Finsupp.single w 1).degree = r := by
                rw [map_add, Finsupp.degree_single]
                omega
              have hnewMeasure :
                  displacementComplexity Gamma
                      (b + Finsupp.single w 1) < e := by
                have hlt := displacementComplexity_replace_lt
                  Gamma a c w hcSupport hcPivot hwSupport hwGamma
                simpa only [b, he] using hlt
              apply Submodule.smul_mem
              exact ih _ hnewMeasure _ hnewDegree rfl
          have hrest :
              (∑ w ∈ Finset.univ.erase c, term w) ∈
                awaySquarefreeReductionSpan k (n := n) (r := r) D Gamma := by
            apply Submodule.sum_mem
            intro w hw
            exact htermMem w (Finset.ne_of_mem_erase hw)
          have hdecomp :
              term c + ∑ w ∈ Finset.univ.erase c, term w = 0 := by
            rw [add_comm,
              Finset.sum_erase_add _ _ (Finset.mem_univ c)]
            exact hsum
          rw [htermC] at hdecomp
          have hneg :
              Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
                  (MvPolynomial.monomial a 1) =
                -(∑ w ∈ Finset.univ.erase c, term w) :=
            eq_neg_of_add_eq_zero_left hdecomp
          rw [hneg]
          exact Submodule.neg_mem _ hrest
      · rw [SimplicialSphereAnisotropicity.Generic.reduction_monomial_eq_zero_of_support_not_face
            k D a hface]
        exact Submodule.zero_mem _

end SimplicialSphereAnisotropicity.Stress

end

end

section

/-!
# Displacement along augmented links

Generic Cramer pivot relations propagate square-free reduction classes across
augmented facet adjacency, including the empty-ridge case.  Facet connectivity
then reduces every homogeneous class to a distinguished link facet together
with faces outside the link.
-/

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner


namespace SimplicialSphereAnisotropicity.Generic

universe u

theorem facetPivotCoefficient_ne_zero_of_not_mem
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (j : Fin (n + 1)) (w : Fin m) (hw : w ∉ F) :
    facetPivotCoefficient k F hF j w ≠ 0 := by
  let A := faceCoefficientMatrix k F hF
  let t := genericColumn (n := n) (m := m) k w
  let e : Fin (n + 1) ↪ Fin m :=
    { toFun := fun l ↦ if l = j then w else orderedFaceEmbedding F hF l
      inj' := by
        intro a b hab
        by_cases ha : a = j
        · by_cases hb : b = j
          · exact ha.trans hb.symm
          · have hEq : w = orderedFaceEmbedding F hF b := by
              simpa [ha, hb] using hab
            exact False.elim (hw (hEq ▸ Finset.orderEmbOfFin_mem F hF b))
        · by_cases hb : b = j
          · have hEq : orderedFaceEmbedding F hF a = w := by
              simpa [ha, hb] using hab
            exact False.elim (hw (hEq ▸ Finset.orderEmbOfFin_mem F hF a))
          · exact (orderedFaceEmbedding F hF).injective (by
              simpa [ha, hb] using hab) }
  have hmatrix : A.updateCol j t =
      fun i l ↦ SimplicialSphereAnisotropicity.genericCoefficient k i (e l) := by
    ext i l
    by_cases hlj : l = j
    · subst l
      rw [Matrix.updateCol_self]
      rw [show e j = w by
        change (if j = j then w else orderedFaceEmbedding F hF j) = w
        rw [if_pos rfl]]
      rfl
    · rw [Matrix.updateCol_ne hlj]
      rw [show e l = orderedFaceEmbedding F hF l by
        change (if l = j then w else orderedFaceEmbedding F hF l) =
          orderedFaceEmbedding F hF l
        rw [if_neg hlj]]
      rfl
  have hcr := congrFun
    (Matrix.det_smul_inv_mulVec_eq_cramer A t
      (faceCoefficientMatrix_isUnit_det k F hF)) j
  have hcoeff : (A⁻¹ *ᵥ t) j = facetPivotCoefficient k F hF j w := by
    simp [A, t, Matrix.mulVec, dotProduct, facetPivotCoefficient,
      genericColumn]
  rw [Pi.smul_apply, smul_eq_mul, hcoeff, Matrix.cramer_apply,
    hmatrix] at hcr
  have hdet : Matrix.det (fun i l : Fin (n + 1) ↦
      SimplicialSphereAnisotropicity.genericCoefficient k i (e l)) ≠ 0 := genericMinor_ne_zero k e
  intro hz
  apply hdet
  symm
  simpa [hz] using hcr

end SimplicialSphereAnisotropicity.Generic

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_DisplacementLink (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev Q_DisplacementLink (k : Type u) [Field k] (n m : ℕ)
    (D : AbstractSimplicialComplex (Fin m)) :=
  SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D

theorem squarefreeExponent_add_single_of_not_mem
    {m : ℕ} (R : Finset (Fin m)) (v : Fin m) (hv : v ∉ R) :
    squarefreeExponent R + Finsupp.single v 1 =
      squarefreeExponent (insert v R) := by
  ext w
  by_cases hwv : w = v
  · subst w
    simp [squarefreeExponent_apply, hv]
  · simp [squarefreeExponent_apply, hwv]

noncomputable def faceReductionClass
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (F : Finset (Fin m)) :
    Q_DisplacementLink k n m D :=
  Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
    (SimplicialSphereAnisotropicity.faceMonomial F)

noncomputable def outsideLinkReductionSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m)) : Submodule (K_DisplacementLink k n m) (Q_DisplacementLink k n m D) :=
  Submodule.span (K_DisplacementLink k n m)
    {x | ∃ F : Finset (Fin m),
      F ∈ AugmentedComplex.ofAbstract D ∧
      F.card = r ∧ Disjoint F Gamma ∧
      Gamma ∪ F ∉ AugmentedComplex.ofAbstract D ∧
      x = faceReductionClass k D F}

noncomputable def linkFacetReductionClass
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (F : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    Q_DisplacementLink k n m D :=
  faceReductionClass k D F.1

theorem outside_faceReductionClass_mem
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma F : Finset (Fin m))
    (hF : F ∈ AugmentedComplex.ofAbstract D) (hFcard : F.card = r)
    (hdisj : Disjoint F Gamma)
    (hout : Gamma ∪ F ∉ AugmentedComplex.ofAbstract D) :
    faceReductionClass k D F ∈
      outsideLinkReductionSpan k (n := n) (r := r) D Gamma := by
  apply Submodule.subset_span
  exact ⟨F, hF, hFcard, hdisj, hout, rfl⟩

theorem linkFacetAdjacent_mem_of_mem
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hpm : IsAugmentedPseudomanifold
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (M : Submodule (K_DisplacementLink k n m) (Q_DisplacementLink k n m D))
    (hout : outsideLinkReductionSpan k (n := n) (r := r) D Gamma ≤ M)
    {E G : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r}
    (hEG : AugmentedFacetAdjacent
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r E G)
    (hGmem : linkFacetReductionClass k D Gamma hGamma G ∈ M) :
    linkFacetReductionClass k D Gamma hGamma E ∈ M := by
  classical
  by_cases hEq : E = G
  · simpa [hEq] using hGmem
  rcases hEG with ⟨R, hRlink, hRcard, hRE, hRG⟩
  obtain ⟨v, hvR, hvE⟩ := Finset.exists_eq_insert_iff.mpr
    ⟨hRE, by omega⟩
  let F : Finset (Fin m) := Gamma ∪ E.1
  have hFcard : F.card = n + 1 := by
    dsimp only [F]
    rw [Finset.card_union_of_disjoint E.2.1.1, E.2.2]
    exact hGammaCard
  have hvEset : v ∈ E.1 := by
    rw [← hvE]
    exact Finset.mem_insert_self v R
  have hvF : v ∈ F := by
    exact Finset.mem_union_right Gamma hvEset
  let j : Fin (n + 1) :=
    (F.orderIsoOfFin hFcard).symm ⟨v, hvF⟩
  have hjv : Generic.orderedFaceEmbedding F hFcard j = v := by
    change ((F.orderIsoOfFin hFcard)
      ((F.orderIsoOfFin hFcard).symm ⟨v, hvF⟩)).1 = v
    exact congrArg Subtype.val
      ((F.orderIsoOfFin hFcard).apply_symm_apply ⟨v, hvF⟩)
  let b : Fin m →₀ ℕ := squarefreeExponent R
  let term : Fin m → Q_DisplacementLink k n m D := fun w ↦
    Generic.facetPivotCoefficient k F hFcard j w •
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (MvPolynomial.monomial (b + Finsupp.single w 1) 1)
  have hsum : (∑ w : Fin m, term w) = 0 := by
    exact Generic.facetPivot_monomial_relation k D F hFcard j b
  have hcoeffV : Generic.facetPivotCoefficient k F hFcard j v = 1 := by
    rw [← hjv, Generic.facetPivotCoefficient_orderedFaceEmbedding]
    simp
  have hbV : b + Finsupp.single v 1 = squarefreeExponent E.1 := by
    rw [show b = squarefreeExponent R by rfl,
      squarefreeExponent_add_single_of_not_mem R v hvR, hvE]
  have htermV : term v = linkFacetReductionClass k D Gamma hGamma E := by
    rw [show term v = Generic.facetPivotCoefficient k F hFcard j v •
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (MvPolynomial.monomial (b + Finsupp.single v 1) 1) by rfl,
      hcoeffV, one_smul, hbV,
      ← faceMonomial_eq_monomial_squarefreeExponent]
    rfl
  have htermMem (w : Fin m) (hwv : w ≠ v) : term w ∈ M := by
    by_cases hwF : w ∈ F
    · let l : Fin (n + 1) :=
        (F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩
      have hlw : Generic.orderedFaceEmbedding F hFcard l = w := by
        change ((F.orderIsoOfFin hFcard)
          ((F.orderIsoOfFin hFcard).symm ⟨w, hwF⟩)).1 = w
        exact congrArg Subtype.val
          ((F.orderIsoOfFin hFcard).apply_symm_apply ⟨w, hwF⟩)
      have hjl : j ≠ l := by
        intro hjl
        apply hwv
        rw [← hjv, ← hlw, hjl]
      have hcoeffW :
          Generic.facetPivotCoefficient k F hFcard j w = 0 := by
        rw [← hlw, Generic.facetPivotCoefficient_orderedFaceEmbedding,
          if_neg hjl]
      rw [show term w = Generic.facetPivotCoefficient k F hFcard j w •
        Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
          (MvPolynomial.monomial (b + Finsupp.single w 1) 1) by rfl,
        hcoeffW, zero_smul]
      exact M.zero_mem
    · have hwR : w ∉ R := by
        intro hw
        exact hwF (Finset.mem_union_right Gamma (hRE hw))
      let H : Finset (Fin m) := insert w R
      have hHcard : H.card = r := by
        dsimp only [H]
        rw [Finset.card_insert_of_notMem hwR]
        omega
      have hHdisj : Disjoint H Gamma := by
        rw [Finset.disjoint_left]
        intro x hxH hxGamma
        rcases Finset.mem_insert.mp hxH with h'x | hxR
        · subst x
          exact hwF (Finset.mem_union_left E.1 hxGamma)
        · exact (Finset.disjoint_left.mp E.2.1.1) hxGamma (hRE hxR)
      have hbW : b + Finsupp.single w 1 = squarefreeExponent H := by
        rw [show b = squarefreeExponent R by rfl,
          squarefreeExponent_add_single_of_not_mem R w hwR]
      by_cases hHface : H ∈ AugmentedComplex.ofAbstract D
      · by_cases hHout : Gamma ∪ H ∉ AugmentedComplex.ofAbstract D
        · apply M.smul_mem
          apply hout
          rw [hbW, ← faceMonomial_eq_monomial_squarefreeExponent]
          exact outside_faceReductionClass_mem k D Gamma H
            hHface hHcard hHdisj hHout
        · have hHlink : H ∈
              (AugmentedComplex.ofAbstract D).link Gamma hGamma :=
            ⟨hHdisj.symm, not_not.mp hHout⟩
          have htwo := hpm.ridge_two hRlink hRcard
          rw [Set.ncard_eq_two] at htwo
          obtain ⟨X, Y, hXY, hset⟩ := htwo
          have hEpair : E.1 = X ∨ E.1 = Y := by
            have hmem : E.1 ∈ {J : Finset (Fin m) |
                J ∈ (AugmentedComplex.ofAbstract D).link Gamma hGamma ∧
                J.card = r ∧ R ⊆ J} := ⟨E.2.1, E.2.2, hRE⟩
            rw [hset] at hmem
            simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hmem
          have hGpair : G.1 = X ∨ G.1 = Y := by
            have hmem : G.1 ∈ {J : Finset (Fin m) |
                J ∈ (AugmentedComplex.ofAbstract D).link Gamma hGamma ∧
                J.card = r ∧ R ⊆ J} := ⟨G.2.1, G.2.2, hRG⟩
            rw [hset] at hmem
            simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hmem
          have hHpair : H = X ∨ H = Y := by
            have hmem : H ∈ {J : Finset (Fin m) |
                J ∈ (AugmentedComplex.ofAbstract D).link Gamma hGamma ∧
                J.card = r ∧ R ⊆ J} := by
              refine ⟨hHlink, hHcard, ?_⟩
              exact Finset.subset_insert w R
            rw [hset] at hmem
            simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hmem
          have hHEorG : H = E.1 ∨ H = G.1 := by
            rcases hEpair with hEX | hEY
            · have hGY : G.1 = Y := hGpair.resolve_left (fun hGX ↦ by
                apply hEq
                apply Subtype.ext
                exact hEX.trans hGX.symm)
              exact hHpair.imp (fun hHX ↦ hHX.trans hEX.symm)
                (fun hHY ↦ hHY.trans hGY.symm)
            · have hGX : G.1 = X := hGpair.resolve_right (fun hGY ↦ by
                apply hEq
                apply Subtype.ext
                exact hEY.trans hGY.symm)
              rcases hHpair with hHX | hHY
              · exact Or.inr (hHX.trans hGX.symm)
              · exact Or.inl (hHY.trans hEY.symm)
          have hHG : H = G.1 := hHEorG.resolve_left (fun hHE ↦ by
            apply hwF
            exact Finset.mem_union_right Gamma (hHE ▸ Finset.mem_insert_self w R))
          rw [show term w = Generic.facetPivotCoefficient k F hFcard j w •
            Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
              (MvPolynomial.monomial (b + Finsupp.single w 1) 1) by rfl,
            hbW, ← faceMonomial_eq_monomial_squarefreeExponent]
          change Generic.facetPivotCoefficient k F hFcard j w •
            faceReductionClass k D H ∈ M
          rw [hHG]
          exact M.smul_mem _ hGmem
      · rw [show term w = Generic.facetPivotCoefficient k F hFcard j w •
          Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
            (MvPolynomial.monomial (b + Finsupp.single w 1) 1) by rfl,
          hbW,
          Generic.reduction_monomial_eq_zero_of_support_not_face
            k D (squarefreeExponent H) (by simpa using hHface),
          smul_zero]
        exact M.zero_mem
  have hrest : (∑ w ∈ Finset.univ.erase v, term w) ∈ M := by
    apply Submodule.sum_mem
    intro w hw
    exact htermMem w (Finset.ne_of_mem_erase hw)
  have hdecomp : term v + ∑ w ∈ Finset.univ.erase v, term w = 0 := by
    rw [add_comm, Finset.sum_erase_add _ _ (Finset.mem_univ v)]
    exact hsum
  rw [htermV] at hdecomp
  rw [eq_neg_of_add_eq_zero_left hdecomp]
  exact M.neg_mem hrest

theorem linkFacetReach_mem_of_mem
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hpm : IsAugmentedPseudomanifold
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (M : Submodule (K_DisplacementLink k n m) (Q_DisplacementLink k n m D))
    (hout : outsideLinkReductionSpan k (n := n) (r := r) D Gamma ≤ M)
    {E G : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r}
    (hreach : Relation.ReflTransGen
      (AugmentedFacetAdjacent
        ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) E G)
    (hGmem : linkFacetReductionClass k D Gamma hGamma G ∈ M) :
    linkFacetReductionClass k D Gamma hGamma E ∈ M := by
  induction hreach with
  | refl => exact hGmem
  | tail hAB hBC ih =>
      apply ih
      exact linkFacetAdjacent_mem_of_mem k D Gamma hGamma
        hGammaCard hpm M hout hBC hGmem

theorem all_linkFacet_mem_of_distinguished
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hpm : IsAugmentedPseudomanifold
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (M : Submodule (K_DisplacementLink k n m) (Q_DisplacementLink k n m D))
    (hout : outsideLinkReductionSpan k (n := n) (r := r) D Gamma ≤ M)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (htau : linkFacetReductionClass k D Gamma hGamma tau ∈ M)
    (E : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    linkFacetReductionClass k D Gamma hGamma E ∈ M := by
  exact linkFacetReach_mem_of_mem k D Gamma hGamma hGammaCard hpm M hout
    (hpm.facet_connected E tau) htau

noncomputable def displacementSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    Submodule (K_DisplacementLink k n m) (Q_DisplacementLink k n m D) :=
  outsideLinkReductionSpan k (n := n) (r := r) D Gamma ⊔
    Submodule.span (K_DisplacementLink k n m)
      {linkFacetReductionClass k D Gamma hGamma tau}

theorem outsideLinkReductionSpan_le_displacementSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    outsideLinkReductionSpan k (n := n) (r := r) D Gamma ≤
      displacementSpan k D Gamma hGamma tau := by
  exact le_sup_left

theorem distinguished_mem_displacementSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    linkFacetReductionClass k (n := n) D Gamma hGamma tau ∈
      displacementSpan k (n := n) D Gamma hGamma tau := by
  exact (show Submodule.span (K_DisplacementLink k n m)
      {linkFacetReductionClass k (n := n) D Gamma hGamma tau} ≤
        displacementSpan k (n := n) D Gamma hGamma tau from le_sup_right)
    (Submodule.subset_span (Set.mem_singleton _))

theorem awaySquarefreeReductionSpan_le_displacementSpan
    (k : Type u) [Field k] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hpm : IsAugmentedPseudomanifold
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    awaySquarefreeReductionSpan k (n := n) (r := r) D Gamma ≤
      displacementSpan k D Gamma hGamma tau := by
  apply Submodule.span_le.mpr
  rintro x ⟨F, rfl⟩
  by_cases hUnion : Gamma ∪ F.1.1 ∈ AugmentedComplex.ofAbstract D
  · let E : AugmentedFacetOfCard
        ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r :=
      ⟨F.1.1, ⟨F.2.symm, hUnion⟩, F.1.2.2⟩
    have hmem := all_linkFacet_mem_of_distinguished
      k D Gamma hGamma hGammaCard hpm
      (displacementSpan k D Gamma hGamma tau)
      (outsideLinkReductionSpan_le_displacementSpan
        k D Gamma hGamma tau)
      tau (distinguished_mem_displacementSpan k D Gamma hGamma tau) E
    exact hmem
  · apply outsideLinkReductionSpan_le_displacementSpan
    exact outside_faceReductionClass_mem k D Gamma F.1.1
      F.1.2.1 F.1.2.2 F.2 hUnion

theorem reduction_monomial_mem_displacementSpan
    (k : Type u) [Field k] [CharP k 2] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hdm : n + 1 ≤ m)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r)
    (a : Fin m →₀ ℕ) (haDegree : a.degree = r) :
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k (n := n) D)
        (MvPolynomial.monomial a 1) ∈
      displacementSpan k (n := n) D Gamma hGamma tau := by
  let C := AugmentedComplex.ofAbstract D
  have hpm : IsAugmentedPseudomanifold (C.link Gamma hGamma) r :=
    SimplicialSphereAnisotropicity.Topology.allLinks_isAugmentedPseudomanifold k C (n + 1)
      (SimplicialSphereAnisotropicity.Topology.simplicialSphere_facesBoundedBy D hD)
      (SimplicialSphereAnisotropicity.Topology.simplicialSphere_allLinkHomologySphere k D hD)
      Gamma hGamma r hGammaCard
  apply awaySquarefreeReductionSpan_le_displacementSpan
    k D Gamma hGamma hGammaCard hpm tau
  exact reduction_monomial_mem_awaySquarefreeReductionSpan
    k D Gamma hGammaCard hdm a haDegree

end SimplicialSphereAnisotropicity.Stress


end

section

/-!
# Directional derivations on the generic and auxiliary coefficient fields

The derivation `moveDerivation k v w` infinitesimally replaces the generic
column at `v` by the column at `w`.  Its auxiliary extension acts
coefficientwise on the old coefficient field and kills the fresh auxiliary
column.
-/

set_option autoImplicit false

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity SimplicialSphereAnisotropicity.Generic

namespace SimplicialSphereAnisotropicity.Stress

universe u

variable (k : Type u) [Field k] {n m : ℕ}

/-- Infinitesimally replace the generic coefficient column at `v` by that at `w`. -/
noncomputable def moveDerivation (v w : Fin m) :
    Derivation k (GenericField k n m) (GenericField k n m) :=
  ∑ i : Fin (n + 1),
    (genericCoefficient k i w) • genericCoordinateDerivation k i v

@[simp]
theorem moveDerivation_apply_coefficient
    (v w u : Fin m) (r : Fin (n + 1)) :
    moveDerivation k v w (genericCoefficient k r u) =
      if v = u then genericCoefficient k r w else 0 := by
  classical
  rw [moveDerivation]
  rw [show (∑ i : Fin (n + 1),
      (genericCoefficient k i w) • genericCoordinateDerivation k i v)
        (genericCoefficient k r u) =
      ∑ i : Fin (n + 1),
        ((genericCoefficient k i w) • genericCoordinateDerivation k i v)
          (genericCoefficient k r u) by
    exact derivation_finsetSum_apply Finset.univ _ _]
  simp only [Derivation.smul_apply,
    genericCoordinateDerivation_apply_coefficient, smul_eq_mul]
  by_cases h : v = u
  · subst u
    simp
  · have hp : ∀ i : Fin (n + 1), (i, v) ≠ (r, u) := by
      intro i hi
      exact h (congrArg Prod.snd hi)
    simp [hp, h]

/-- Extend `moveDerivation` to the auxiliary rational-function field, killing its variables. -/
noncomputable def auxiliaryMoveDerivation (v w : Fin m) :
    Derivation k (AuxiliaryField k n m) (AuxiliaryField k n m) :=
  coefficientwiseFractionDerivation (sigma := Fin (n + 1))
    (moveDerivation k v w)

@[simp]
theorem auxiliaryMoveDerivation_auxiliaryColumn
    (v w : Fin m) (i : Fin (n + 1)) :
    auxiliaryMoveDerivation k v w (auxiliaryColumn k i) = 0 := by
  simp [auxiliaryMoveDerivation, auxiliaryColumn]

@[simp]
theorem auxiliaryMoveDerivation_auxiliaryGenericCoefficient
    (v w u : Fin m) (r : Fin (n + 1)) :
    auxiliaryMoveDerivation k v w
        (auxiliaryGenericCoefficient k r u) =
      if v = u then auxiliaryGenericCoefficient k r w else 0 := by
  unfold auxiliaryMoveDerivation
  rw [auxiliaryGenericCoefficient]
  conv_lhs => rw [← auxiliary_algebraMap_C]
  rw [coefficientwiseFractionDerivation_algebraMap,
    coefficientwisePolynomialDerivation_C,
    auxiliary_algebraMap_C, moveDerivation_apply_coefficient]
  by_cases h : v = u
  · simp [h, auxiliaryGenericCoefficient]
  · simp [h]

/-- The determinant obtained by replacing one selected generic column. -/
noncomputable def genericMinorReplaceColumn
    (e : Fin (n + 1) ↪ Fin m) (j : Fin (n + 1)) (w : Fin m) :
    GenericField k n m :=
  Matrix.det (Matrix.updateCol
    ((fun i l : Fin (n + 1) ↦ genericCoefficient k i (e l)) :
      Matrix (Fin (n + 1)) (Fin (n + 1)) (GenericField k n m))
    j (Generic.genericColumn k w))

/-- A move derivation replaces its selected column in a generic minor. -/
theorem moveDerivation_genericMinor_of_column
    (e : Fin (n + 1) ↪ Fin m) (j : Fin (n + 1)) (w : Fin m) :
    moveDerivation k (e j) w (Generic.genericMinor k e) =
      genericMinorReplaceColumn k e j w := by
  classical
  let M : Matrix (Fin (n + 1)) (Fin (n + 1)) (GenericField k n m) :=
    fun i l ↦ genericCoefficient k i (e l)
  change moveDerivation k (e j) w M.det = _
  calc
    moveDerivation k (e j) w M.det =
        ∑ l, (M.updateCol l (fun i ↦
          moveDerivation k (e j) w (M i l))).det :=
      derivation_det (moveDerivation k (e j) w) M
    _ = genericMinorReplaceColumn k e j w := by
      rw [Finset.sum_eq_single j]
      · have hcol :
            (fun i ↦ moveDerivation k (e j) w (M i j)) =
              Generic.genericColumn k w := by
          funext i
          simp [M, moveDerivation_apply_coefficient, Generic.genericColumn]
        rw [hcol]
        rfl
      · intro l _hl hlj
        apply Matrix.det_eq_zero_of_column_eq_zero l
        intro i
        have hne : e j ≠ e l := fun h ↦ hlj (e.injective h.symm)
        rw [Matrix.updateCol_self]
        simp [M, moveDerivation_apply_coefficient, hne]
      · simp

/-- A move derivation kills a generic minor when its source column is absent. -/
theorem moveDerivation_genericMinor_of_not_range
    (e : Fin (n + 1) ↪ Fin m) (v w : Fin m)
    (hv : v ∉ Set.range e) :
    moveDerivation k v w (Generic.genericMinor k e) = 0 := by
  classical
  let M : Matrix (Fin (n + 1)) (Fin (n + 1)) (GenericField k n m) :=
    fun i l ↦ genericCoefficient k i (e l)
  change moveDerivation k v w M.det = 0
  calc
    moveDerivation k v w M.det =
        ∑ j, (M.updateCol j (fun i ↦ moveDerivation k v w (M i j))).det :=
      derivation_det (moveDerivation k v w) M
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro j _hj
      apply Matrix.det_eq_zero_of_column_eq_zero j
      intro i
      have hne : v ≠ e j := fun h ↦ hv ⟨j, h.symm⟩
      rw [Matrix.updateCol_self]
      simp [M, moveDerivation_apply_coefficient, hne]

/-- A move derivation kills a minor when the new column duplicates another selected column. -/
theorem moveDerivation_genericMinor_eq_zero_of_target_column
    (e : Fin (n + 1) ↪ Fin m) (j l : Fin (n + 1)) (hjl : j ≠ l) :
    moveDerivation k (e j) (e l) (Generic.genericMinor k e) = 0 := by
  rw [moveDerivation_genericMinor_of_column]
  unfold genericMinorReplaceColumn
  exact Matrix.det_updateCol_eq_zero
    (M := (fun i r : Fin (n + 1) ↦ genericCoefficient k i (e r)))
    (i := l) (j := j) hjl.symm

/-- The auxiliary move derivation commutes with the embedded generic coefficient field. -/
@[simp]
theorem auxiliaryMoveDerivation_algebraMap
    (v w : Fin m) (x : GenericField k n m) :
    auxiliaryMoveDerivation k v w
        (algebraMap (GenericField k n m) (AuxiliaryField k n m) x) =
      algebraMap (GenericField k n m) (AuxiliaryField k n m)
        (moveDerivation k v w x) := by
  unfold auxiliaryMoveDerivation
  rw [← auxiliary_algebraMap_C]
  rw [coefficientwiseFractionDerivation_algebraMap,
    coefficientwisePolynomialDerivation_C, auxiliary_algebraMap_C]

/-- A move between two distinct facet columns kills that facet's minor. -/
theorem moveDerivation_faceMinor_eq_zero
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (s t : ↥F) (hst : s ≠ t) :
    moveDerivation k s.1 t.1 (Generic.faceMinor k F hF) = 0 := by
  let o := F.orderIsoOfFin hF
  let js : Fin (n + 1) := o.symm s
  let jt : Fin (n + 1) := o.symm t
  have hjsjt : js ≠ jt := fun h ↦ hst (o.symm.injective h)
  have hos : Generic.orderedFaceEmbedding F hF js = s.1 := by
    change (o js).1 = s.1
    simp [js]
  have hot : Generic.orderedFaceEmbedding F hF jt = t.1 := by
    change (o jt).1 = t.1
    simp [jt]
  rw [Generic.faceMinor_eq_genericMinor]
  rw [← hos, ← hot]
  exact moveDerivation_genericMinor_eq_zero_of_target_column
    k (Generic.orderedFaceEmbedding F hF) js jt hjsjt

/-- The auxiliary move also kills the embedded facet minor. -/
theorem auxiliaryMoveDerivation_faceMinor_algebraMap_eq_zero
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (s t : ↥F) (hst : s ≠ t) :
    auxiliaryMoveDerivation k s.1 t.1
        (algebraMap (GenericField k n m) (AuxiliaryField k n m)
          (Generic.faceMinor k F hF)) = 0 := by
  rw [auxiliaryMoveDerivation_algebraMap,
    moveDerivation_faceMinor_eq_zero k F hF s t hst, map_zero]

/-- Moving `s` to `t` sends the bracket with auxiliary column at `t` to that at `s`. -/
theorem auxiliaryMoveDerivation_auxiliaryFacetBracket_swap
    [CharP k 2]
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (s t : ↥F) (hst : s ≠ t) :
    auxiliaryMoveDerivation k s.1 t.1
        (auxiliaryFacetBracket k F hF t) =
      auxiliaryFacetBracket k F hF s := by
  classical
  let o := F.orderIsoOfFin hF
  let js : Fin (n + 1) := o.symm s
  let jt : Fin (n + 1) := o.symm t
  let A := auxiliaryFacetMatrix k F hF
  let z := auxiliaryColumn (n := n) (m := m) k
  let B := A.updateCol jt z
  have hjsjt : js ≠ jt := fun h ↦ hst (o.symm.injective h)
  have hos : F.orderEmbOfFin hF js = s.1 := by
    change (o js).1 = s.1
    simp [js]
  have hot : F.orderEmbOfFin hF jt = t.1 := by
    change (o jt).1 = t.1
    simp [jt]
  rw [auxiliaryFacetBracket_eq_cramer, auxiliaryFacetBracket_eq_cramer,
    Matrix.cramer_apply, Matrix.cramer_apply]
  change auxiliaryMoveDerivation k s.1 t.1 B.det =
    (A.updateCol js z).det
  calc
    auxiliaryMoveDerivation k s.1 t.1 B.det =
        ∑ j, (B.updateCol j (fun i ↦
          auxiliaryMoveDerivation k s.1 t.1 (B i j))).det :=
      derivation_det (auxiliaryMoveDerivation k s.1 t.1) B
    _ = (B.updateCol js (fun r ↦ A r jt)).det := by
      rw [Finset.sum_eq_single js]
      · have hcol :
            (fun i ↦ auxiliaryMoveDerivation k s.1 t.1 (B i js)) =
              (fun r ↦ A r jt) := by
          funext i
          change auxiliaryMoveDerivation k s.1 t.1
              ((A.updateCol jt z) i js) = A i jt
          rw [Matrix.updateCol_ne hjsjt]
          change auxiliaryMoveDerivation k s.1 t.1
              (auxiliaryGenericCoefficient k i
                (F.orderEmbOfFin hF js)) =
            auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF jt)
          rw [hos, hot, auxiliaryMoveDerivation_auxiliaryGenericCoefficient]
          simp
        rw [hcol]
      · intro j _hj hjs
        apply Matrix.det_eq_zero_of_column_eq_zero j
        intro i
        rw [Matrix.updateCol_self]
        by_cases hjt : j = jt
        · subst j
          change auxiliaryMoveDerivation k s.1 t.1
              ((A.updateCol jt z) i jt) = 0
          rw [Matrix.updateCol_self]
          exact auxiliaryMoveDerivation_auxiliaryColumn k s.1 t.1 i
        · change auxiliaryMoveDerivation k s.1 t.1
              ((A.updateCol jt z) i j) = 0
          rw [Matrix.updateCol_ne hjt]
          have hsne : s.1 ≠ F.orderEmbOfFin hF j := by
            rw [← hos]
            exact (F.orderEmbOfFin hF).injective.ne hjs.symm
          change auxiliaryMoveDerivation k s.1 t.1
              (auxiliaryGenericCoefficient k i
                (F.orderEmbOfFin hF j)) = 0
          rw [auxiliaryMoveDerivation_auxiliaryGenericCoefficient]
          simp [hsne]
      · simp
    _ = (A.updateCol js z).det := by
      exact det_updateCol_swap_charTwo A js jt hjsjt z

/-- Two move derivations commute when neither differentiates the other's coefficient column. -/
theorem moveDerivation_comm
    (v w u z : Fin m) (hvz : v ≠ z) (huw : u ≠ w)
    (x : GenericField k n m) :
    moveDerivation k v w (moveDerivation k u z x) =
      moveDerivation k u z (moveDerivation k v w x) := by
  let Dv := moveDerivation (n := n) k v w
  let Du := moveDerivation (n := n) k u z
  have hbracket : ⁅Dv, Du⁆ =
      (0 : Derivation k (GenericField k n m) (GenericField k n m)) := by
    apply fractionDerivation_ext
      (R := MvPolynomial (Fin (n + 1) × Fin m) k)
    have hrestricted :
        ⁅Dv, Du⁆.compAlgebraMap
            (MvPolynomial (Fin (n + 1) × Fin m) k) =
          (0 : Derivation k
            (MvPolynomial (Fin (n + 1) × Fin m) k)
            (GenericField k n m)) := by
      apply MvPolynomial.derivation_ext
      intro ir
      rcases ir with ⟨i, r⟩
      simp only [Derivation.compAlgebraMap_apply, Derivation.commutator_apply,
        Dv, Du]
      change moveDerivation k v w
          (moveDerivation k u z (genericCoefficient k i r)) -
        moveDerivation k u z
          (moveDerivation k v w (genericCoefficient k i r)) = 0
      rw [moveDerivation_apply_coefficient,
        moveDerivation_apply_coefficient]
      by_cases hur : u = r
      · by_cases hvr : v = r
        · have hrz : r ≠ z := fun hrz ↦ hvz (hvr.trans hrz)
          have hrw : r ≠ w := fun hrw ↦ huw (hur.trans hrw)
          simp [hur, hvr, moveDerivation_apply_coefficient, hrz, hrw]
        · simp [hur, hvr, moveDerivation_apply_coefficient, hvz]
      · by_cases hvr : v = r
        · simp [hur, hvr, moveDerivation_apply_coefficient, huw]
        · simp [hur, hvr]
    intro p
    exact Derivation.congr_fun hrestricted p
  have hx := Derivation.congr_fun hbracket x
  simpa [Derivation.commutator_apply, Dv, Du] using sub_eq_zero.mp hx

/-- The auxiliary extensions of disjoint move derivations commute. -/
theorem auxiliaryMoveDerivation_comm
    (v w u z : Fin m) (hvz : v ≠ z) (huw : u ≠ w)
    (x : AuxiliaryField k n m) :
    auxiliaryMoveDerivation k v w (auxiliaryMoveDerivation k u z x) =
      auxiliaryMoveDerivation k u z (auxiliaryMoveDerivation k v w x) := by
  exact coefficientwiseFractionDerivation_comm
    (moveDerivation k v w) (moveDerivation k u z)
    (moveDerivation_comm k v w u z hvz huw) x

/-- A move whose source is absent from a facet kills every auxiliary bracket on it. -/
theorem auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_source_not_mem
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v w : Fin m) (hvF : v ∉ F) (g : ↥F) :
    auxiliaryMoveDerivation k v w (auxiliaryFacetBracket k F hF g) = 0 := by
  classical
  let jg : Fin (n + 1) := (F.orderIsoOfFin hF).symm g
  let A := auxiliaryFacetMatrix k F hF
  let z := auxiliaryColumn (n := n) (m := m) k
  let B := A.updateCol jg z
  rw [auxiliaryFacetBracket_eq_cramer, Matrix.cramer_apply]
  change auxiliaryMoveDerivation k v w B.det = 0
  rw [derivation_det]
  apply Finset.sum_eq_zero
  intro j _hj
  apply Matrix.det_eq_zero_of_column_eq_zero j
  intro i
  rw [Matrix.updateCol_self]
  by_cases hjg : j = jg
  · subst j
    change auxiliaryMoveDerivation k v w ((A.updateCol jg z) i jg) = 0
    rw [Matrix.updateCol_self]
    exact auxiliaryMoveDerivation_auxiliaryColumn k v w i
  · change auxiliaryMoveDerivation k v w ((A.updateCol jg z) i j) = 0
    rw [Matrix.updateCol_ne hjg]
    have hvne : v ≠ F.orderEmbOfFin hF j := by
      intro h
      exact hvF (h ▸ (F.orderIsoOfFin hF j).2)
    change auxiliaryMoveDerivation k v w
        (auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF j)) = 0
    rw [auxiliaryMoveDerivation_auxiliaryGenericCoefficient]
    simp [hvne]

/-- Within a facet, only the bracket at the target column can survive a move. -/
theorem auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_ne_target
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (s t g : ↥F) (hst : s ≠ t) (hgt : g ≠ t) :
    auxiliaryMoveDerivation k s.1 t.1
        (auxiliaryFacetBracket k F hF g) = 0 := by
  classical
  let o := F.orderIsoOfFin hF
  let js : Fin (n + 1) := o.symm s
  let jt : Fin (n + 1) := o.symm t
  let jg : Fin (n + 1) := o.symm g
  let A := auxiliaryFacetMatrix k F hF
  let z := auxiliaryColumn (n := n) (m := m) k
  let B := A.updateCol jg z
  have hjsjt : js ≠ jt := fun h ↦ hst (o.symm.injective h)
  have hjgjt : jg ≠ jt := fun h ↦ hgt (o.symm.injective h)
  have hos : F.orderEmbOfFin hF js = s.1 := by
    change (o js).1 = s.1
    simp [js]
  have hot : F.orderEmbOfFin hF jt = t.1 := by
    change (o jt).1 = t.1
    simp [jt]
  rw [auxiliaryFacetBracket_eq_cramer, Matrix.cramer_apply]
  change auxiliaryMoveDerivation k s.1 t.1 B.det = 0
  rw [derivation_det]
  apply Finset.sum_eq_zero
  intro j _hj
  by_cases hjs : j = js
  · subst j
    by_cases hjsg : js = jg
    · apply Matrix.det_eq_zero_of_column_eq_zero js
      intro i
      rw [Matrix.updateCol_self]
      change auxiliaryMoveDerivation k s.1 t.1
          ((A.updateCol jg z) i js) = 0
      rw [hjsg, Matrix.updateCol_self]
      exact auxiliaryMoveDerivation_auxiliaryColumn k s.1 t.1 i
    · have hcol :
          (fun i ↦ auxiliaryMoveDerivation k s.1 t.1 (B i js)) =
            fun i ↦ B i jt := by
        funext i
        change auxiliaryMoveDerivation k s.1 t.1
            ((A.updateCol jg z) i js) = (A.updateCol jg z) i jt
        rw [Matrix.updateCol_ne hjsg, Matrix.updateCol_ne hjgjt.symm]
        change auxiliaryMoveDerivation k s.1 t.1
            (auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF js)) =
          auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF jt)
        rw [hos, hot, auxiliaryMoveDerivation_auxiliaryGenericCoefficient]
        simp
      rw [hcol]
      exact Matrix.det_updateCol_eq_zero
        (M := B) (i := jt) (j := js) hjsjt.symm
  · apply Matrix.det_eq_zero_of_column_eq_zero j
    intro i
    rw [Matrix.updateCol_self]
    by_cases hjg : j = jg
    · subst j
      change auxiliaryMoveDerivation k s.1 t.1
          ((A.updateCol jg z) i jg) = 0
      rw [Matrix.updateCol_self]
      exact auxiliaryMoveDerivation_auxiliaryColumn k s.1 t.1 i
    · change auxiliaryMoveDerivation k s.1 t.1
          ((A.updateCol jg z) i j) = 0
      rw [Matrix.updateCol_ne hjg]
      have hsne : s.1 ≠ F.orderEmbOfFin hF j := by
        rw [← hos]
        exact (F.orderEmbOfFin hF).injective.ne (fun h ↦ hjs h.symm)
      change auxiliaryMoveDerivation k s.1 t.1
          (auxiliaryGenericCoefficient k i (F.orderEmbOfFin hF j)) = 0
      rw [auxiliaryMoveDerivation_auxiliaryGenericCoefficient]
      simp [hsne]

/-- A move whose source is absent from a facet kills its generic minor. -/
theorem moveDerivation_faceMinor_eq_zero_of_not_mem
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v w : Fin m) (hvF : v ∉ F) :
    moveDerivation k v w (Generic.faceMinor k F hF) = 0 := by
  rw [Generic.faceMinor_eq_genericMinor]
  apply moveDerivation_genericMinor_of_not_range
  intro hvRange
  obtain ⟨i, hi⟩ := hvRange
  apply hvF
  rw [← hi]
  exact (F.orderIsoOfFin hF i).2

/-- The auxiliary extension also kills an embedded facet minor whose source is absent. -/
theorem auxiliaryMoveDerivation_faceMinor_algebraMap_eq_zero_of_not_mem
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v w : Fin m) (hvF : v ∉ F) :
    auxiliaryMoveDerivation k v w
        (algebraMap (GenericField k n m) (AuxiliaryField k n m)
          (Generic.faceMinor k F hF)) = 0 := by
  rw [auxiliaryMoveDerivation_algebraMap,
    moveDerivation_faceMinor_eq_zero_of_not_mem k F hF v w hvF, map_zero]

end SimplicialSphereAnisotropicity.Stress

end

end

section

/-!
# Iterated restricted-stress derivative identities

This module canonically pairs two equicardinal vertex sets, composes their
auxiliary move derivations, and proves the unique-surviving-facet and nonface
vanishing identities for the specialized top-stress expansion.
-/

set_option autoImplicit false

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity SimplicialSphereAnisotropicity.Generic SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Stress

universe u

variable (k : Type u) [Field k] {n m : ℕ}

/-- The fixed-order auxiliary move family associated to paired source and target columns. -/
noncomputable def pairedAuxiliaryMoveDerivations
    {q : ℕ} (source target : Fin q → Fin m) :
    List (Derivation k (AuxiliaryField k n m) (AuxiliaryField k n m)) :=
  List.ofFn fun i ↦ auxiliaryMoveDerivation k (source i) (target i)

/-- Canonically pair two equicardinal finsets in increasing order. -/
noncomputable def finsetAuxiliaryMoveDerivations
    {q : ℕ} (source target : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q) :
    List (Derivation k (AuxiliaryField k n m) (AuxiliaryField k n m)) :=
  pairedAuxiliaryMoveDerivations (n := n) k
    (source.orderEmbOfFin hsource) (target.orderEmbOfFin htarget)

/-- Product reindexing through the canonical increasing enumeration of a finset. -/
theorem prod_orderEmbOfFin
    {α M : Type*} [LinearOrder α] [CommMonoid M]
    {q : ℕ} (S : Finset α) (hS : S.card = q) (f : α → M) :
    (∏ i : Fin q, f (S.orderEmbOfFin hS i)) = ∏ x ∈ S, f x := by
  calc
    (∏ i : Fin q, f (S.orderEmbOfFin hS i)) =
        ∏ x : ↥S, f x.1 := by
      rw [← Equiv.prod_comp (S.orderIsoOfFin hS).toEquiv]
      rfl
    _ = ∏ x ∈ S, f x := by
      simpa using (Finset.prod_attach S f)

/-- A fixed-order composition preserves finite sums. -/
theorem iterDerivation_finset_sum
    {A ι : Type*} [CommRing A] [Algebra k A]
    (derivatives : List (Derivation k A A))
    (s : Finset ι) (f : ι → A) :
    iterDerivation derivatives (∑ i ∈ s, f i) =
      ∑ i ∈ s, iterDerivation derivatives (f i) := by
  induction derivatives with
  | nil => rfl
  | cons D derivatives ih =>
      simp only [iterDerivation, ih, map_sum]

@[simp]
theorem iterDerivation_zero
    {A : Type*} [CommRing A] [Algebra k A]
    (derivatives : List (Derivation k A A)) :
    iterDerivation derivatives 0 = 0 := by
  induction derivatives with
  | nil => rfl
  | cons D derivatives ih => simp [iterDerivation, ih]

/-- A derivation commutes through a list of pointwise commuting derivations. -/
theorem derivation_iterDerivation_comm
    {A : Type*} [CommRing A] [Algebra k A]
    (D : Derivation k A A) (derivatives : List (Derivation k A A))
    (hcomm : ∀ E ∈ derivatives, ∀ x, D (E x) = E (D x))
    (x : A) :
    D (iterDerivation derivatives x) =
      iterDerivation derivatives (D x) := by
  induction derivatives with
  | nil => rfl
  | cons E derivatives ih =>
      simp only [iterDerivation]
      rw [hcomm E (by simp)]
      rw [ih]
      intro G hG
      exact hcomm G (by simp [hG])

/-- If a commuting member of a derivative list kills the input, the whole composition vanishes. -/
theorem iterDerivation_eq_zero_of_mem
    {A : Type*} [CommRing A] [Algebra k A]
    (D : Derivation k A A) (derivatives : List (Derivation k A A))
    (hD : D ∈ derivatives)
    (hcomm : ∀ E ∈ derivatives, ∀ x, D (E x) = E (D x))
    {x : A} (hx : D x = 0) :
    iterDerivation derivatives x = 0 := by
  induction derivatives with
  | nil => simp at hD
  | cons E derivatives ih =>
      rw [List.mem_cons] at hD
      rcases hD with rfl | hD
      · simp only [iterDerivation]
        rw [derivation_iterDerivation_comm]
        · rw [hx, iterDerivation_zero]
        · intro G hG
          exact hcomm G (by simp [hG])
      · simp only [iterDerivation]
        rw [ih hD]
        · exact E.map_zero
        · intro G hG
          exact hcomm G (by simp [hG])

/-- Pairwise disjoint move operators commute, including their variable coefficients. -/
theorem pairedAuxiliaryMoveDerivations_comm
    {q : ℕ} (source target : Fin q → Fin m)
    (hcross : ∀ i j, source i ≠ target j)
    (i j : Fin q) (x : AuxiliaryField k n m) :
    auxiliaryMoveDerivation k (source i) (target i)
        (auxiliaryMoveDerivation k (source j) (target j) x) =
      auxiliaryMoveDerivation k (source j) (target j)
        (auxiliaryMoveDerivation k (source i) (target i) x) := by
  exact auxiliaryMoveDerivation_comm k _ _ _ _
    (hcross i j) (hcross j i) x

/-- Each paired move differentiates exactly its matched target bracket. -/
theorem iterDerivation_paired_facetBracket_prod
    [CharP k 2] {q : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (source target : Fin q → ↥F)
    (htarget : Function.Injective target)
    (hcross : ∀ i j, source i ≠ target j) :
    iterDerivation
        (pairedAuxiliaryMoveDerivations k
          (fun i ↦ (source i).1) (fun i ↦ (target i).1))
        (∏ i, auxiliaryFacetBracket k F hF (target i)) =
      ∏ i, auxiliaryFacetBracket k F hF (source i) := by
  apply iterDerivation_ofFn_prod
  · intro i
    exact auxiliaryMoveDerivation_auxiliaryFacetBracket_swap
      k F hF (source i) (target i) (hcross i i)
  · intro i j hij
    apply auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_ne_target
      k F hF (source i) (target i) (target j) (hcross i i)
    intro h
    exact hij (Eq.symm (htarget h))
  · intro i j _hij
    exact auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_ne_target
      k F hF (source i) (target i) (source j)
        (hcross i i) (hcross j i)

/-- The unique surviving bracket assignment cancels its source-bracket denominator. -/
theorem iterDerivation_paired_facetTerm
    [CharP k 2] {q : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (source target : Fin q → ↥F)
    (htarget : Function.Injective target)
    (hcross : ∀ i j, source i ≠ target j) :
    iterDerivation
        (pairedAuxiliaryMoveDerivations k
          (fun i ↦ (source i).1) (fun i ↦ (target i).1))
        ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
            (Generic.faceMinor k F hF))⁻¹ *
          ((∏ i, auxiliaryFacetBracket k F hF (target i)) /
            ∏ i, auxiliaryFacetBracket k F hF (source i))) =
      (algebraMap (GenericField k n m) (AuxiliaryField k n m)
        (Generic.faceMinor k F hF))⁻¹ := by
  let Delta : AuxiliaryField k n m :=
    algebraMap (GenericField k n m) (AuxiliaryField k n m)
      (Generic.faceMinor k F hF)
  let S : AuxiliaryField k n m :=
    ∏ i, auxiliaryFacetBracket k F hF (source i)
  let N : AuxiliaryField k n m :=
    ∏ i, auxiliaryFacetBracket k F hF (target i)
  let derivatives :
      List (Derivation k (AuxiliaryField k n m) (AuxiliaryField k n m)) :=
    pairedAuxiliaryMoveDerivations (n := n) k
      (fun i ↦ (source i).1) (fun i ↦ (target i).1)
  have hSzero : ∀ i, auxiliaryMoveDerivation k (source i).1 (target i).1 S = 0 := by
    intro i
    apply derivation_finset_prod_eq_zero
    intro j _hj
    exact auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_ne_target
      k F hF (source i) (target i) (source j)
        (hcross i i) (hcross j i)
  have hDeltaZero : ∀ i,
      auxiliaryMoveDerivation k (source i).1 (target i).1 Delta = 0 := by
    intro i
    exact auxiliaryMoveDerivation_faceMinor_algebraMap_eq_zero
      k F hF (source i) (target i) (hcross i i)
  have hconst : ∀ D ∈ derivatives, D (Delta⁻¹ * S⁻¹) = 0 := by
    intro D hD
    change D ∈ List.ofFn (fun i ↦
      auxiliaryMoveDerivation k (source i).1 (target i).1) at hD
    rw [List.mem_ofFn] at hD
    obtain ⟨i, rfl⟩ := hD
    rw [(auxiliaryMoveDerivation k (source i).1 (target i).1).leibniz,
      (auxiliaryMoveDerivation k (source i).1 (target i).1).leibniz_inv,
      (auxiliaryMoveDerivation k (source i).1 (target i).1).leibniz_inv,
      hDeltaZero i, hSzero i]
    simp [smul_eq_mul]
  have hS : S ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro i _hi
    exact auxiliaryFacetBracket_ne_zero k F hF (source i)
  change iterDerivation derivatives (Delta⁻¹ * (N / S)) = Delta⁻¹
  rw [show Delta⁻¹ * (N / S) = (Delta⁻¹ * S⁻¹) * N by
    simp only [div_eq_mul_inv]
    ring]
  rw [iterDerivation_const_mul_of_forall derivatives _ _ hconst]
  rw [iterDerivation_paired_facetBracket_prod k F hF source target htarget hcross]
  change (Delta⁻¹ * S⁻¹) * S = Delta⁻¹
  rw [mul_assoc, inv_mul_cancel₀ hS, mul_one]

/-- Exact cancellation for a facet partitioned into sources, targets, and untouched vertices. -/
theorem iterDerivation_finset_specialFacetTerm
    [CharP k 2] {q : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (source target B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (hsourceRest : Disjoint source (target ∪ B))
    (hpartition : F = source ∪ (target ∪ B)) :
    iterDerivation
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
            (Generic.faceMinor k F hF))⁻¹ *
          auxiliarySpecialFacetWeight k F hF target B) =
      (algebraMap (GenericField k n m) (AuxiliaryField k n m)
        (Generic.faceMinor k F hF))⁻¹ := by
  have hsourceF : source ⊆ F := by
    rw [hpartition]
    exact Finset.subset_union_left
  have htargetF : target ⊆ F := by
    rw [hpartition]
    exact Finset.Subset.trans Finset.subset_union_left Finset.subset_union_right
  let source' : Fin q → ↥F := fun i ↦
    ⟨source.orderEmbOfFin hsource i,
      hsourceF (source.orderIsoOfFin hsource i).2⟩
  let target' : Fin q → ↥F := fun i ↦
    ⟨target.orderEmbOfFin htarget i,
      htargetF (target.orderIsoOfFin htarget i).2⟩
  have htargetInj : Function.Injective target' := by
    intro i j hij
    apply (target.orderEmbOfFin htarget).injective
    simpa [target'] using congrArg Subtype.val hij
  have hcross : ∀ i j, source' i ≠ target' j := by
    intro i j hij
    have hval : source.orderEmbOfFin hsource i =
        target.orderEmbOfFin htarget j := congrArg Subtype.val hij
    have hs : source.orderEmbOfFin hsource i ∈ source :=
      (source.orderIsoOfFin hsource i).2
    have ht : target.orderEmbOfFin htarget j ∈ target :=
      (target.orderIsoOfFin htarget j).2
    exact (Finset.disjoint_left.mp
      (hsourceRest.mono_right Finset.subset_union_left)) hs (hval ▸ ht)
  have hden : F \ (target ∪ B) = source := by
    rw [hpartition]
    ext v
    simp only [Finset.mem_sdiff, Finset.mem_union]
    constructor
    · rintro ⟨hsourceOrRest, hnotRest⟩
      exact hsourceOrRest.resolve_right hnotRest
    · intro hs
      refine ⟨Or.inl hs, ?_⟩
      simpa only [Finset.mem_union] using
        (Finset.disjoint_left.mp hsourceRest) hs
  have hN :
      (∏ i, auxiliaryFacetBracket k F hF (target' i)) =
        ∏ t ∈ target, auxiliaryFacetBracketAt k F hF t := by
    calc
      (∏ i, auxiliaryFacetBracket k F hF (target' i)) =
          ∏ i, auxiliaryFacetBracketAt k F hF
            (target.orderEmbOfFin htarget i) := by
        apply Finset.prod_congr rfl
        intro i _hi
        change auxiliaryFacetBracket k F hF (target' i) =
          auxiliaryFacetBracketAt k F hF
            ((target.orderIsoOfFin htarget i).1)
        rw [auxiliaryFacetBracketAt_of_mem k F hF _
          (htargetF (target.orderIsoOfFin htarget i).2)]
        rfl
      _ = ∏ t ∈ target, auxiliaryFacetBracketAt k F hF t :=
        prod_orderEmbOfFin target htarget _
  have hS :
      (∏ i, auxiliaryFacetBracket k F hF (source' i)) =
        ∏ s ∈ source, auxiliaryFacetBracketAt k F hF s := by
    calc
      (∏ i, auxiliaryFacetBracket k F hF (source' i)) =
          ∏ i, auxiliaryFacetBracketAt k F hF
            (source.orderEmbOfFin hsource i) := by
        apply Finset.prod_congr rfl
        intro i _hi
        change auxiliaryFacetBracket k F hF (source' i) =
          auxiliaryFacetBracketAt k F hF
            ((source.orderIsoOfFin hsource i).1)
        rw [auxiliaryFacetBracketAt_of_mem k F hF _
          (hsourceF (source.orderIsoOfFin hsource i).2)]
        rfl
      _ = ∏ s ∈ source, auxiliaryFacetBracketAt k F hF s :=
        prod_orderEmbOfFin source hsource _
  change iterDerivation
      (pairedAuxiliaryMoveDerivations k
        (fun i ↦ (source' i).1) (fun i ↦ (target' i).1))
      ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
          (Generic.faceMinor k F hF))⁻¹ *
        auxiliarySpecialFacetWeight k F hF target B) = _
  rw [auxiliarySpecialFacetWeight, hden]
  rw [← hN, ← hS]
  exact iterDerivation_paired_facetTerm
    k F hF source' target' htargetInj hcross

/-- A source absent from a facet kills every ambiently indexed bracket on it. -/
theorem auxiliaryMoveDerivation_auxiliaryFacetBracketAt_eq_zero_of_source_not_mem
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (v w g : Fin m) (hvF : v ∉ F) :
    auxiliaryMoveDerivation k v w
        (auxiliaryFacetBracketAt k F hF g) = 0 := by
  by_cases hgF : g ∈ F
  · rw [auxiliaryFacetBracketAt_of_mem k F hF g hgF]
    exact auxiliaryMoveDerivation_auxiliaryFacetBracket_eq_zero_of_source_not_mem
      k F hF v w hvF ⟨g, hgF⟩
  · rw [auxiliaryFacetBracketAt_of_not_mem k F hF g hgF, map_zero]

/-- A source absent from a facet kills its complete specialized rational summand. -/
theorem auxiliaryMoveDerivation_specialFacetTerm_eq_zero_of_source_not_mem
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (T B : Finset (Fin m)) (v w : Fin m) (hvF : v ∉ F) :
    auxiliaryMoveDerivation k v w
        ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
            (Generic.faceMinor k F hF))⁻¹ *
          auxiliarySpecialFacetWeight k F hF T B) = 0 := by
  let Dv := auxiliaryMoveDerivation (n := n) k v w
  let Delta : AuxiliaryField k n m :=
    algebraMap (GenericField k n m) (AuxiliaryField k n m)
      (Generic.faceMinor k F hF)
  let N : AuxiliaryField k n m :=
    ∏ t ∈ T, auxiliaryFacetBracketAt k F hF t
  let Q : AuxiliaryField k n m :=
    ∏ g ∈ F \ (T ∪ B), auxiliaryFacetBracketAt k F hF g
  have hDelta : Dv Delta = 0 :=
    auxiliaryMoveDerivation_faceMinor_algebraMap_eq_zero_of_not_mem
      k F hF v w hvF
  have hN : Dv N = 0 := by
    apply derivation_finset_prod_eq_zero
    intro t _ht
    exact auxiliaryMoveDerivation_auxiliaryFacetBracketAt_eq_zero_of_source_not_mem
      k F hF v w t hvF
  have hQ : Dv Q = 0 := by
    apply derivation_finset_prod_eq_zero
    intro g _hg
    exact auxiliaryMoveDerivation_auxiliaryFacetBracketAt_eq_zero_of_source_not_mem
      k F hF v w g hvF
  change Dv (Delta⁻¹ * (N / Q)) = 0
  rw [Dv.leibniz, Dv.leibniz_inv, Dv.leibniz_div, hDelta, hN, hQ]
  simp [smul_eq_mul]

/-- A fixed family of disjoint moves kills a facet summand missing any source. -/
theorem iterDerivation_finset_specialFacetTerm_eq_zero_of_not_subset
    {q : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1)
    (source target T B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (hdisjoint : Disjoint source target)
    (hnot : ¬ source ⊆ F) :
    iterDerivation
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
            (Generic.faceMinor k F hF))⁻¹ *
          auxiliarySpecialFacetWeight k F hF T B) = 0 := by
  obtain ⟨v, hvSource, hvF⟩ := Finset.not_subset.mp hnot
  have hvRange : v ∈ Set.range (source.orderEmbOfFin hsource) := by
    rw [Finset.range_orderEmbOfFin]
    exact hvSource
  obtain ⟨i, hi⟩ := hvRange
  let derivatives := finsetAuxiliaryMoveDerivations (n := n) k
    source target hsource htarget
  let Di := auxiliaryMoveDerivation (n := n) k
    (source.orderEmbOfFin hsource i) (target.orderEmbOfFin htarget i)
  have hcross : ∀ a b,
      source.orderEmbOfFin hsource a ≠ target.orderEmbOfFin htarget b := by
    intro a b hab
    exact (Finset.disjoint_left.mp hdisjoint)
      (source.orderEmbOfFin_mem hsource a)
      (hab ▸ target.orderEmbOfFin_mem htarget b)
  have hDi : Di ∈ derivatives := by
    change Di ∈ List.ofFn (fun j ↦ auxiliaryMoveDerivation k
      (source.orderEmbOfFin hsource j) (target.orderEmbOfFin htarget j))
    rw [List.mem_ofFn]
    exact ⟨i, rfl⟩
  apply iterDerivation_eq_zero_of_mem k Di derivatives hDi
  · intro E hE x
    change E ∈ List.ofFn (fun j ↦ auxiliaryMoveDerivation k
      (source.orderEmbOfFin hsource j) (target.orderEmbOfFin htarget j)) at hE
    rw [List.mem_ofFn] at hE
    obtain ⟨j, rfl⟩ := hE
    exact auxiliaryMoveDerivation_comm k _ _ _ _
      (hcross i j) (hcross j i) x
  · change auxiliaryMoveDerivation k
        (source.orderEmbOfFin hsource i) (target.orderEmbOfFin htarget i)
        ((algebraMap (GenericField k n m) (AuxiliaryField k n m)
            (Generic.faceMinor k F hF))⁻¹ *
          auxiliarySpecialFacetWeight k F hF T B) = 0
    rw [hi]
    exact auxiliaryMoveDerivation_specialFacetTerm_eq_zero_of_source_not_mem
      k F hF T B v (target.orderEmbOfFin htarget i) hvF

/-- The specialized top-stress expansion has exactly one surviving partitioned facet. -/
theorem iterDerivation_auxiliaryTopStressCoefficient_twoOne_exact
    [CharP k 2] {q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source target B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (htargetB : Disjoint target B)
    (hsourceRest : Disjoint source (target ∪ B))
    (hdegree : 2 * q + B.card = n + 1)
    (sigma : FacetOfCard D (n + 1))
    (hpartition : sigma.1 = source ∪ (target ∪ B)) :
    iterDerivation
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        (auxiliaryTopStressCoefficient k D hd hpm
          (twoOneExponent target B)) =
      (algebraMap (GenericField k n m) (AuxiliaryField k n m)
        (Generic.faceMinor k sigma.1 sigma.2.2))⁻¹ := by
  have hformulaDegree : 2 * target.card + B.card = n + 1 := by
    omega
  rw [auxiliaryTopStressCoefficient_twoOne_formula
    k D hd hpm target B htargetB hformulaDegree]
  rw [iterDerivation_finset_sum]
  rw [Finset.sum_eq_single sigma]
  · rw [if_pos]
    · exact iterDerivation_finset_specialFacetTerm
        k sigma.1 sigma.2.2 source target B hsource htarget
          hsourceRest hpartition
    · rw [hpartition]
      exact Finset.subset_union_right
  · intro F _hF hFsigma
    by_cases hsub : target ∪ B ⊆ F.1
    · rw [if_pos hsub]
      apply iterDerivation_finset_specialFacetTerm_eq_zero_of_not_subset
        k F.1 F.2.2 source target target B hsource htarget
          (hsourceRest.mono_right Finset.subset_union_left)
      intro hsourceF
      apply hFsigma
      apply Subtype.ext
      have hsigmaF : sigma.1 ⊆ F.1 := by
        rw [hpartition]
        exact Finset.union_subset hsourceF hsub
      exact (Finset.eq_of_subset_of_card_le hsigmaF (by
        rw [F.2.2, sigma.2.2])).symm
    · rw [if_neg hsub, iterDerivation_zero]
  · simp

/-- If sources together with the specialized support form a nonface, every facet summand dies. -/
theorem iterDerivation_auxiliaryTopStressCoefficient_twoOne_eq_zero
    [CharP k 2] {q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source target T B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (hsourceTarget : Disjoint source target)
    (hTB : Disjoint T B)
    (hdegree : 2 * T.card + B.card = n + 1)
    (hnonface : source ∪ (T ∪ B) ∉ AugmentedComplex.ofAbstract D) :
    iterDerivation
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        (auxiliaryTopStressCoefficient k D hd hpm
          (twoOneExponent T B)) = 0 := by
  rw [auxiliaryTopStressCoefficient_twoOne_formula
    k D hd hpm T B hTB hdegree]
  rw [iterDerivation_finset_sum]
  apply Finset.sum_eq_zero
  intro F _hF
  by_cases hsub : T ∪ B ⊆ F.1
  · rw [if_pos hsub]
    apply iterDerivation_finset_specialFacetTerm_eq_zero_of_not_subset
      k F.1 F.2.2 source target T B hsource htarget hsourceTarget
    intro hsourceF
    apply hnonface
    rw [AugmentedComplex.mem_ofAbstract]
    by_cases hempty : source ∪ (T ∪ B) = ∅
    · exact Or.inl hempty
    · exact Or.inr ((D.isRelLowerSet_faces F.2.1).2
        (Finset.union_subset hsourceF hsub)
        (Finset.nonempty_iff_ne_empty.mpr hempty))
  · rw [if_neg hsub, iterDerivation_zero]

end SimplicialSphereAnisotropicity.Stress

end

end

section

set_option autoImplicit false

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity SimplicialSphereAnisotropicity.Generic SimplicialSphereAnisotropicity.Generic.Brion
open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Stress

universe u

private abbrev K_Parity (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev Q_Parity (k : Type u) [Field k] (n m : ℕ)
    (D : AbstractSimplicialComplex (Fin m)) :=
  SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D

private abbrev E_Parity (k : Type u) [Field k] (n m : ℕ) :=
  AuxiliaryField k n m

theorem faceReductionClass_eq_monomial
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (F : Finset (Fin m)) :
    faceReductionClass k (n := n) D F =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (MvPolynomial.monomial (squarefreeExponent F) 1) := by
  rw [faceReductionClass, faceMonomial_eq_monomial_squarefreeExponent]

theorem faceReductionClass_mul_sq
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (T B : Finset (Fin m)) :
    faceReductionClass k (n := n) D B *
        faceReductionClass k (n := n) D T ^ 2 =
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (MvPolynomial.monomial (twoOneExponent T B) 1) := by
  rw [faceReductionClass_eq_monomial, faceReductionClass_eq_monomial]
  rw [← map_pow, ← map_mul]
  simp [twoOneExponent, pow_two, add_assoc, add_comm]

theorem auxiliaryReductionBrionFunctional_face_mul_sq
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (T B : Finset (Fin m)) :
    algebraMap (K_Parity k n m) (E_Parity k n m)
        (reductionBrionFunctional k D hd hpm
          (faceReductionClass k D B * faceReductionClass k D T ^ 2)) =
      auxiliaryTopStressCoefficient k D hd hpm (twoOneExponent T B) := by
  rw [faceReductionClass_mul_sq]
  rfl

theorem reductionBrionFunctional_mul
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (x y : Q_Parity k n m D) :
    reductionBrionFunctional k D hd hpm (x * y) =
      reductionBrionPairing k D hd hpm x y := by
  induction x, y using Quotient.inductionOn₂ with
  | _ p q =>
      change reductionBrionFunctional k D hd hpm
          (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) (p * q)) =
        reductionBrionPairing k D hd hpm
          (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p)
          (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) q)
      rw [reductionBrionFunctional_mk, reductionBrionPairing_mk_mk]

theorem faceReductionClass_mul_of_disjoint
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F G : Finset (Fin m)) (hFG : Disjoint F G) :
    faceReductionClass k (n := n) D F * faceReductionClass k D G =
      faceReductionClass k D (F ∪ G) := by
  simp only [faceReductionClass, ← map_mul]
  congr 1
  exact (Finset.prod_union hFG).symm

theorem faceReductionClass_eq_zero_of_not_face
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m))
    (hF : F ∉ AugmentedComplex.ofAbstract D) :
    faceReductionClass k (n := n) D F = 0 := by
  rw [faceReductionClass_eq_monomial]
  apply reduction_monomial_eq_zero_of_support_not_face
  simpa using hF

noncomputable def multipliedReductionBrionFunctional
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : Q_Parity k n m D) : Q_Parity k n m D →ₗ[K_Parity k n m] K_Parity k n m :=
  (reductionBrionFunctional k D hd hpm).comp
    (LinearMap.mul (K_Parity k n m) (Q_Parity k n m D) b)

@[simp]
theorem multipliedReductionBrionFunctional_apply
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b x : Q_Parity k n m D) :
    multipliedReductionBrionFunctional k D hd hpm b x =
      reductionBrionFunctional k D hd hpm (b * x) := by
  rfl

theorem iterDerivation_add
    (k : Type u) [CommRing k]
    {A : Type*} [CommRing A] [Algebra k A]
    (derivatives : List (Derivation k A A)) (x y : A) :
    iterDerivation derivatives (x + y) =
      iterDerivation derivatives x + iterDerivation derivatives y := by
  induction derivatives with
  | nil => rfl
  | cons D derivatives ih =>
      simp only [iterDerivation, ih, map_add]

noncomputable def restrictedSquareIdentitySubmodule
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (derivatives : List (Derivation k (E_Parity k n m) (E_Parity k n m)))
    (squareFunctional pairingFunctional :
      Q_Parity k n m D →ₗ[K_Parity k n m] K_Parity k n m)
    (Delta : E_Parity k n m) :
    Submodule (K_Parity k n m) (Q_Parity k n m D) where
  carrier := {x |
    iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional (x ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional x)) ^ 2}
  zero_mem' := by
    simp [iterDerivation_zero]
  add_mem' := by
    intro x y hx hy
    change iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional ((x + y) ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional (x + y))) ^ 2
    change iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional (x ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional x)) ^ 2 at hx
    change iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional (y ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional y)) ^ 2 at hy
    have htwo : (2 : Q_Parity k n m D) = 0 := by
      change algebraMap (K_Parity k n m) (Q_Parity k n m D) (2 : K_Parity k n m) = 0
      rw [show (2 : K_Parity k n m) = 0 by
        exact CharP.cast_eq_zero (K_Parity k n m) 2, map_zero]
    have haddsq : (x + y) ^ 2 = x ^ 2 + y ^ 2 := by
      calc
        (x + y) ^ 2 = x ^ 2 + 2 * x * y + y ^ 2 := by ring
        _ = x ^ 2 + y ^ 2 := by rw [htwo]; ring
    rw [haddsq]
    simpa only [CharTwo.add_sq, map_add, iterDerivation_add, mul_add]
      using congrArg₂ (· + ·) hx hy
  smul_mem' := by
    intro c x hx
    change iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional (x ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional x)) ^ 2 at hx
    change iterDerivation derivatives
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (squareFunctional ((c • x) ^ 2))) =
      Delta *
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (pairingFunctional (c • x))) ^ 2
    rw [smul_pow, map_smul]
    simp only [smul_eq_mul, map_mul, map_pow]
    rw [iterDerivation_sq_mul, hx]
    rw [map_smul]
    simp only [smul_eq_mul, map_mul, mul_pow]
    ring

theorem mem_restrictedSquareIdentitySubmodule
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (derivatives : List (Derivation k (E_Parity k n m) (E_Parity k n m)))
    (squareFunctional pairingFunctional :
      Q_Parity k n m D →ₗ[K_Parity k n m] K_Parity k n m)
    (Delta : E_Parity k n m) (x : Q_Parity k n m D) :
    x ∈ restrictedSquareIdentitySubmodule k D derivatives
        squareFunctional pairingFunctional Delta ↔
      iterDerivation derivatives
          (algebraMap (K_Parity k n m) (E_Parity k n m)
            (squareFunctional (x ^ 2))) =
        Delta *
          (algebraMap (K_Parity k n m) (E_Parity k n m)
            (pairingFunctional x)) ^ 2 := by
  rfl

theorem sq_ne_zero_of_mem_restrictedSquareIdentitySubmodule
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (derivatives : List (Derivation k (E_Parity k n m) (E_Parity k n m)))
    (squareFunctional pairingFunctional :
      Q_Parity k n m D →ₗ[K_Parity k n m] K_Parity k n m)
    (Delta : E_Parity k n m) (hDelta : Delta ≠ 0)
    (x : Q_Parity k n m D)
    (hx : x ∈ restrictedSquareIdentitySubmodule k D derivatives
      squareFunctional pairingFunctional Delta)
    (hpair : pairingFunctional x ≠ 0) :
    x ^ 2 ≠ 0 := by
  intro hsquare
  have heq := (mem_restrictedSquareIdentitySubmodule
    k D derivatives squareFunctional pairingFunctional Delta x).mp hx
  rw [hsquare, map_zero, map_zero, iterDerivation_zero] at heq
  have hpairMap : algebraMap (K_Parity k n m) (E_Parity k n m)
      (pairingFunctional x) ≠ 0 := by
    intro hzero
    apply hpair
    apply FaithfulSMul.algebraMap_injective (K_Parity k n m) (E_Parity k n m)
    simpa using hzero
  exact (mul_ne_zero hDelta (pow_ne_zero 2 hpairMap)) heq.symm

theorem faceReductionClass_mem_restrictedSquareIdentitySubmodule_exact
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source target B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (htargetB : Disjoint target B)
    (hsourceRest : Disjoint source (target ∪ B))
    (hdegree : 2 * q + B.card = n + 1)
    (sigma : FacetOfCard D (n + 1))
    (hpartition : sigma.1 = source ∪ (target ∪ B)) :
    faceReductionClass k (n := n) D target ∈
      restrictedSquareIdentitySubmodule k D
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D B))
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D (source ∪ B)))
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (Generic.faceMinor k sigma.1 sigma.2.2)) := by
  rw [mem_restrictedSquareIdentitySubmodule]
  simp only [multipliedReductionBrionFunctional_apply]
  rw [auxiliaryReductionBrionFunctional_face_mul_sq]
  rw [iterDerivation_auxiliaryTopStressCoefficient_twoOne_exact
    k D hd hpm source target B hsource htarget htargetB
      hsourceRest hdegree sigma hpartition]
  have hsourceTarget : Disjoint source target :=
    hsourceRest.mono_right Finset.subset_union_left
  have hBTarget : Disjoint B target := htargetB.symm
  have hGammaTarget : Disjoint (source ∪ B) target :=
    Finset.disjoint_union_left.mpr ⟨hsourceTarget, hBTarget⟩
  rw [faceReductionClass_mul_of_disjoint
    k D (source ∪ B) target hGammaTarget]
  have hunion : (source ∪ B) ∪ target = sigma.1 := by
    calc
      (source ∪ B) ∪ target = source ∪ (target ∪ B) := by ac_rfl
      _ = sigma.1 := hpartition.symm
  rw [hunion]
  have hW : reductionBrionFunctional k D hd hpm
      (faceReductionClass k D sigma.1) =
      (Generic.faceMinor k sigma.1 sigma.2.2)⁻¹ := by
    simpa only [faceReductionClass] using
      reductionBrionFunctional_faceMonomial k D hd hpm sigma
  rw [hW, map_inv₀]
  have hDelta : algebraMap (K_Parity k n m) (E_Parity k n m)
      (Generic.faceMinor k sigma.1 sigma.2.2) ≠ 0 := by
    intro hzero
    apply Generic.faceMinor_ne_zero k sigma.1 sigma.2.2
    apply FaithfulSMul.algebraMap_injective (K_Parity k n m) (E_Parity k n m)
    simpa using hzero
  field_simp

theorem faceReductionClass_mem_restrictedSquareIdentitySubmodule_zero
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source target T B : Finset (Fin m))
    (hsource : source.card = q) (htarget : target.card = q)
    (hsourceTarget : Disjoint source target)
    (hsourceT : Disjoint source T) (hTB : Disjoint T B)
    (hdegree : 2 * T.card + B.card = n + 1)
    (hnonface : source ∪ (T ∪ B) ∉ AugmentedComplex.ofAbstract D)
    (Delta : E_Parity k n m) :
    faceReductionClass k (n := n) D T ∈
      restrictedSquareIdentitySubmodule k D
        (finsetAuxiliaryMoveDerivations (n := n) k
          source target hsource htarget)
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D B))
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D (source ∪ B)))
        Delta := by
  rw [mem_restrictedSquareIdentitySubmodule]
  simp only [multipliedReductionBrionFunctional_apply]
  rw [auxiliaryReductionBrionFunctional_face_mul_sq]
  rw [iterDerivation_auxiliaryTopStressCoefficient_twoOne_eq_zero
    k D hd hpm source target T B hsource htarget hsourceTarget
      hTB hdegree hnonface]
  have hBTarget : Disjoint B T := hTB.symm
  have hGammaT : Disjoint (source ∪ B) T :=
    Finset.disjoint_union_left.mpr ⟨hsourceT, hBTarget⟩
  rw [faceReductionClass_mul_of_disjoint
    k D (source ∪ B) T hGammaT]
  have hunion : (source ∪ B) ∪ T = source ∪ (T ∪ B) := by ac_rfl
  rw [hunion, faceReductionClass_eq_zero_of_not_face k D _ hnonface,
    map_zero, map_zero, pow_two, zero_mul, mul_zero]

theorem displacementSpan_le_restrictedSquareIdentitySubmodule
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source B : Finset (Fin m))
    (hsource : source.card = q) (hsourceB : Disjoint source B)
    (hdegree : 2 * q + B.card = n + 1)
    (hGamma : source ∪ B ∈ AugmentedComplex.ofAbstract D)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link (source ∪ B) hGamma) q)
    (sigma : FacetOfCard D (n + 1))
    (hpartition : sigma.1 = source ∪ (tau.1 ∪ B)) :
    displacementSpan k (n := n) D (source ∪ B) hGamma tau ≤
      restrictedSquareIdentitySubmodule k D
        (finsetAuxiliaryMoveDerivations (n := n) k
          source tau.1 hsource tau.2.2)
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D B))
        (multipliedReductionBrionFunctional k D hd hpm
          (faceReductionClass k D (source ∪ B)))
        (algebraMap (K_Parity k n m) (E_Parity k n m)
          (Generic.faceMinor k sigma.1 sigma.2.2)) := by
  have hGammaTarget : Disjoint (source ∪ B) tau.1 := tau.2.1.1
  have hsourceTarget : Disjoint source tau.1 :=
    hGammaTarget.mono_left Finset.subset_union_left
  have hBTarget : Disjoint B tau.1 :=
    hGammaTarget.mono_left Finset.subset_union_right
  have htargetB : Disjoint tau.1 B := hBTarget.symm
  have hsourceRest : Disjoint source (tau.1 ∪ B) :=
    Finset.disjoint_union_right.mpr ⟨hsourceTarget, hsourceB⟩
  rw [displacementSpan]
  apply sup_le
  · rw [outsideLinkReductionSpan]
    apply Submodule.span_le.mpr
    rintro _ ⟨T, _hTface, hTcard, hTGamma, hout, rfl⟩
    have hsourceT : Disjoint source T :=
      (hTGamma.mono_right Finset.subset_union_left).symm
    have hTB : Disjoint T B :=
      hTGamma.mono_right Finset.subset_union_right
    have hdegreeT : 2 * T.card + B.card = n + 1 := by
      rw [hTcard]
      exact hdegree
    have hnonface :
        source ∪ (T ∪ B) ∉ AugmentedComplex.ofAbstract D := by
      intro hface
      apply hout
      have hreorder : (source ∪ B) ∪ T = source ∪ (T ∪ B) := by
        ac_rfl
      rw [hreorder]
      exact hface
    exact faceReductionClass_mem_restrictedSquareIdentitySubmodule_zero
      k D hd hpm source tau.1 T B hsource tau.2.2
        hsourceTarget hsourceT hTB hdegreeT hnonface _
  · apply Submodule.span_le.mpr
    intro x hx
    have hx' : x = linkFacetReductionClass k D
        (source ∪ B) hGamma tau := by simpa using hx
    subst x
    change faceReductionClass k D tau.1 ∈ _
    exact faceReductionClass_mem_restrictedSquareIdentitySubmodule_exact
      k D hd hpm source tau.1 B hsource tau.2.2 htargetB
        hsourceRest hdegree sigma hpartition

theorem quotientDegree_le_displacementSpan
    (k : Type u) [Field k] [CharP k 2] {n m r : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (Gamma : Finset (Fin m))
    (hGamma : Gamma ∈ AugmentedComplex.ofAbstract D)
    (hGammaCard : Gamma.card + r = n + 1)
    (hdm : n + 1 ≤ m)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link Gamma hGamma) r) :
    SimplicialSphereAnisotropicity.quotientDegree (n := n) k D r ≤
      displacementSpan k D Gamma hGamma tau := by
  rintro _ ⟨p, hp, rfl⟩
  let Qmap : MvPolynomial (Fin m) (K_Parity k n m) →ₗ[K_Parity k n m]
      Q_Parity k n m D :=
    (Ideal.Quotient.mkₐ (K_Parity k n m)
      (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toLinearMap
  change Qmap p ∈ displacementSpan k D Gamma hGamma tau
  rw [← p.support_sum_monomial_coeff, map_sum]
  apply Submodule.sum_mem
  intro a ha
  have hadegree : a.degree = r := by
    rw [Finsupp.degree_eq_weight_one]
    exact hp (MvPolynomial.mem_support_iff.mp ha)
  have hmonomial :
      MvPolynomial.monomial a (MvPolynomial.coeff a p) =
        MvPolynomial.coeff a p • MvPolynomial.monomial a 1 := by
    rw [MvPolynomial.smul_monomial]
    simp
  rw [hmonomial, map_smul]
  exact Submodule.smul_mem _ (MvPolynomial.coeff a p)
    (reduction_monomial_mem_displacementSpan
      k D hD Gamma hGamma hGammaCard hdm tau a hadegree)

theorem exists_augmentedSimplex_reductionBrionPairing_ne_zero
    (k : Type u) [Field k] [CharP k 2] {n m q s : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (hp : (quotientDegreeBrionPairing k D hd hpm q s).IsPerfPair)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q) (hx : x ≠ 0) :
    ∃ F : AugmentedSimplex (AugmentedComplex.ofAbstract D) s,
      reductionBrionPairing k D hd hpm x.1
        (squarefreeReductionVector k D F) ≠ 0 := by
  by_contra hExists
  push Not at hExists
  let L : Q_Parity k n m D →ₗ[K_Parity k n m] K_Parity k n m :=
    reductionBrionPairing k D hd hpm x.1
  have hspan : squarefreeReductionSpan k (n := n) D s ≤
      LinearMap.ker L := by
    apply Submodule.span_le.mpr
    rintro _ ⟨F, rfl⟩
    change L (squarefreeReductionVector k D F) = 0
    exact hExists F
  have hdegree : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D s ≤
      LinearMap.ker L := by
    rw [quotientDegree_eq_squarefreeReductionSpan k D hpm.pure s]
    exact hspan
  have hpzero : quotientDegreeBrionPairing k D hd hpm q s x = 0 := by
    apply LinearMap.ext
    intro y
    rw [quotientDegreeBrionPairing_apply]
    have hy := hdegree y.2
    change L y.1 = 0 at hy
    exact hy
  have hxzero : x = 0 := by
    apply hp.bijective_left.1
    simpa using hpzero
  exact hx hxzero

theorem quotientDegree_sq_ne_zero_of_partitioned_face_pairing
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (source B : Finset (Fin m))
    (hsource : source.card = q) (hsourceB : Disjoint source B)
    (hdegree : 2 * q + B.card = n + 1)
    (hGamma : source ∪ B ∈ AugmentedComplex.ofAbstract D)
    (tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link (source ∪ B) hGamma) q)
    (sigma : FacetOfCard D (n + 1))
    (hpartition : sigma.1 = source ∪ (tau.1 ∪ B))
    (hdm : n + 1 ≤ m)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q)
    (hpair : reductionBrionPairing k D hd hpm x.1
      (faceReductionClass k D (source ∪ B)) ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  let derivatives := finsetAuxiliaryMoveDerivations (n := n) k
    source tau.1 hsource tau.2.2
  let squareFunctional := multipliedReductionBrionFunctional k D hd hpm
    (faceReductionClass k D B)
  let pairingFunctional := multipliedReductionBrionFunctional k D hd hpm
    (faceReductionClass k D (source ∪ B))
  let Delta : E_Parity k n m := algebraMap (K_Parity k n m) (E_Parity k n m)
    (Generic.faceMinor k sigma.1 sigma.2.2)
  have hGammaCard : (source ∪ B).card + q = n + 1 := by
    rw [Finset.card_union_of_disjoint hsourceB, hsource]
    omega
  have hxDisplacement : x.1 ∈
      displacementSpan k D (source ∪ B) hGamma tau :=
    quotientDegree_le_displacementSpan
      k D hD (source ∪ B) hGamma hGammaCard hdm tau x.2
  have hxIdentity : x.1 ∈
      restrictedSquareIdentitySubmodule k D derivatives
        squareFunctional pairingFunctional Delta := by
    apply displacementSpan_le_restrictedSquareIdentitySubmodule
      k D hd hpm source B hsource hsourceB hdegree hGamma tau
        sigma hpartition
    exact hxDisplacement
  have hpairFunctional : pairingFunctional x.1 ≠ 0 := by
    change reductionBrionFunctional k D hd hpm
      (faceReductionClass k D (source ∪ B) * x.1) ≠ 0
    have heq : reductionBrionFunctional k D hd hpm
        (faceReductionClass k D (source ∪ B) * x.1) =
        reductionBrionPairing k D hd hpm x.1
          (faceReductionClass k D (source ∪ B)) := by
      calc
        reductionBrionFunctional k D hd hpm
            (faceReductionClass k D (source ∪ B) * x.1) =
          reductionBrionFunctional k D hd hpm
            (x.1 * faceReductionClass k D (source ∪ B)) :=
              congrArg (reductionBrionFunctional k D hd hpm)
                (mul_comm _ _)
        _ = reductionBrionPairing k D hd hpm x.1
              (faceReductionClass k D (source ∪ B)) :=
          reductionBrionFunctional_mul k D hd hpm _ _
    exact ne_of_eq_of_ne heq hpair
  have hDelta : Delta ≠ 0 := by
    intro hzero
    apply Generic.faceMinor_ne_zero k sigma.1 sigma.2.2
    apply FaithfulSMul.algebraMap_injective (K_Parity k n m) (E_Parity k n m)
    simpa [Delta] using hzero
  exact sq_ne_zero_of_mem_restrictedSquareIdentitySubmodule
    k D derivatives squareFunctional pairingFunctional Delta hDelta
      x.1 hxIdentity hpairFunctional

theorem quotientDegree_sq_ne_zero_of_separating_face
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (hq : 1 ≤ q)
    (source B : Finset (Fin m))
    (hsource : source.card = q) (hsourceB : Disjoint source B)
    (hdegree : 2 * q + B.card = n + 1)
    (hGamma : source ∪ B ∈ AugmentedComplex.ofAbstract D)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q)
    (hpair : reductionBrionPairing k D hd hpm x.1
      (faceReductionClass k D (source ∪ B)) ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  have hGammaCard : (source ∪ B).card + q = n + 1 := by
    rw [Finset.card_union_of_disjoint hsourceB, hsource]
    omega
  have hGammaNonempty : (source ∪ B).Nonempty := by
    apply Finset.card_pos.mp
    rw [Finset.card_union_of_disjoint hsourceB, hsource]
    omega
  have hGammaD : source ∪ B ∈ D :=
    (AugmentedComplex.nonempty_mem_ofAbstract_iff
      D hGammaNonempty).mp hGamma
  obtain ⟨G, hGD, hGammaG, hGcard⟩ := hpm.pure hGammaD
  let sigma : FacetOfCard D (n + 1) := ⟨G, hGD, hGcard⟩
  let target : Finset (Fin m) := G \ (source ∪ B)
  have hGammaTarget : Disjoint (source ∪ B) target := by
    rw [Finset.disjoint_left]
    intro v hvGamma hvTarget
    have hvTarget' : v ∈ G \ (source ∪ B) := by
      simpa [target] using hvTarget
    exact (Finset.mem_sdiff.mp hvTarget').2 hvGamma
  have hGammaUnionTarget : (source ∪ B) ∪ target = G := by
    exact Finset.union_sdiff_of_subset hGammaG
  have htargetCard : target.card = q := by
    change (G \ (source ∪ B)).card = q
    rw [Finset.card_sdiff_of_subset hGammaG, hGcard]
    omega
  have htargetLink : target ∈
      (AugmentedComplex.ofAbstract D).link (source ∪ B) hGamma := by
    refine ⟨hGammaTarget, ?_⟩
    rw [hGammaUnionTarget]
    exact Or.inr hGD
  let tau : AugmentedFacetOfCard
      ((AugmentedComplex.ofAbstract D).link (source ∪ B) hGamma) q :=
    ⟨target, htargetLink, htargetCard⟩
  have hpartition : sigma.1 = source ∪ (tau.1 ∪ B) := by
    change G = source ∪ (target ∪ B)
    calc
      G = (source ∪ B) ∪ target := hGammaUnionTarget.symm
      _ = source ∪ (target ∪ B) := by ac_rfl
  have hdm : n + 1 ≤ m := by
    have hcardle := Finset.card_le_univ G
    simpa [hGcard] using hcardle
  exact quotientDegree_sq_ne_zero_of_partitioned_face_pairing
    k D hD hd hpm source B hsource hsourceB hdegree hGamma tau
      sigma hpartition hdm x hpair

set_option linter.style.haveILetI false in
theorem quotientDegree_sq_ne_zero_even_middle
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (heven : 2 * q = n + 1)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q) (hx : x ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  have hd : 2 ≤ n + 1 := by omega
  let hpm : IsPseudomanifold D (n + 1) :=
    SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_Parity k n m) hn D hD
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (K_Parity k n m) (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  obtain ⟨N, b, r, hb, _⟩ :=
    exists_homogeneous_faceRingModel_basisObject_sphere_degreeStatistics
      k D hD
  have hp : (quotientDegreeBrionPairing k D hd hpm q q).IsPerfPair :=
    sphereQuotientDegreeBrionPairing_isPerfPair
      k hn D hD b r hb (by omega)
  obtain ⟨F, hpair⟩ :=
    exists_augmentedSimplex_reductionBrionPairing_ne_zero
      k D hd hpm hp x hx
  have hq : 1 ≤ q := by omega
  apply quotientDegree_sq_ne_zero_of_separating_face
    k D hD hd hpm hq F.1 ∅ F.2.2 (by simp)
      (by simpa using heven) (by simpa using F.2.1) x
  simpa [squarefreeReductionVector, faceReductionClass] using hpair

set_option linter.style.haveILetI false in
theorem quotientDegree_sq_ne_zero_odd_middle
    (k : Type u) [Field k] [CharP k 2] {n m q : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (hodd : 2 * q + 1 = n + 1)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q) (hx : x ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  have hd : 2 ≤ n + 1 := by omega
  let hpm : IsPseudomanifold D (n + 1) :=
    SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_Parity k n m) hn D hD
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (K_Parity k n m) (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  obtain ⟨N, b, r, hb, _⟩ :=
    exists_homogeneous_faceRingModel_basisObject_sphere_degreeStatistics
      k D hD
  have hp :
      (quotientDegreeBrionPairing k D hd hpm q (q + 1)).IsPerfPair :=
    sphereQuotientDegreeBrionPairing_isPerfPair
      k hn D hD b r hb (by omega)
  obtain ⟨F, hpair⟩ :=
    exists_augmentedSimplex_reductionBrionPairing_ne_zero
      k D hd hpm hp x hx
  have hq : 1 ≤ q := by omega
  have hFnonempty : F.1.Nonempty := by
    apply Finset.card_pos.mp
    rw [F.2.2]
    omega
  obtain ⟨v, hv⟩ := hFnonempty
  let source := F.1.erase v
  let B : Finset (Fin m) := {v}
  have hsource : source.card = q := by
    change (F.1.erase v).card = q
    rw [Finset.card_erase_of_mem hv, F.2.2]
    omega
  have hsourceB : Disjoint source B := by
    rw [Finset.disjoint_singleton_right]
    exact Finset.notMem_erase v F.1
  have hunion : source ∪ B = F.1 := by
    change F.1.erase v ∪ {v} = F.1
    rw [Finset.union_singleton, Finset.insert_erase hv]
  apply quotientDegree_sq_ne_zero_of_separating_face
    k D hD hd hpm hq source B hsource hsourceB
      (by simpa [B] using hodd)
      (by rw [hunion]; exact F.2.1) x
  simpa [hunion, squarefreeReductionVector, faceReductionClass] using hpair

theorem quotientDegree_mul_mem
    (k : Type u) [Field k] {n m p q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    {x y : Q_Parity k n m D}
    (hx : x ∈ SimplicialSphereAnisotropicity.quotientDegree (n := n) k D p)
    (hy : y ∈ SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q) :
    x * y ∈ SimplicialSphereAnisotropicity.quotientDegree (n := n) k D (p + q) := by
  obtain ⟨f, hf, rfl⟩ := hx
  obtain ⟨g, hg, rfl⟩ := hy
  refine ⟨f * g, hf.mul hg, ?_⟩
  change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) (f * g) =
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) f *
      Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) g
  exact (Ideal.Quotient.mkₐ (K_Parity k n m)
    (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).map_mul f g

theorem faceReductionClass_mem_quotientDegree
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (F : Finset (Fin m)) :
    faceReductionClass k (n := n) D F ∈
      SimplicialSphereAnisotropicity.quotientDegree (n := n) k D F.card := by
  rw [SimplicialSphereAnisotropicity.mem_quotientDegree_iff]
  exact ⟨SimplicialSphereAnisotropicity.faceMonomial F,
    SimplicialSphereAnisotropicity.faceMonomial_isHomogeneous (K_Parity k n m) F, rfl⟩

set_option linter.style.haveILetI false in
theorem quotientDegree_sq_ne_zero_of_middle
    (k : Type u) [Field k] [CharP k 2] {n m j q : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (hjq : j ≤ q) (hqd : q ≤ n + 1)
    (hmiddle : ∀ z : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q,
      z ≠ 0 → z.1 ^ 2 ≠ 0)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D j) (hx : x ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  have hd : 2 ≤ n + 1 := by omega
  let hpm : IsPseudomanifold D (n + 1) :=
    SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
      (K_Parity k n m) hn D hD
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (K_Parity k n m) (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  obtain ⟨N, b, r, hb, _⟩ :=
    exists_homogeneous_faceRingModel_basisObject_sphere_degreeStatistics
      k D hD
  have hp :
      (quotientDegreeBrionPairing k D hd hpm j (n + 1 - j)).IsPerfPair :=
    sphereQuotientDegreeBrionPairing_isPerfPair
      k hn D hD b r hb (by omega)
  obtain ⟨F, hpairRaw⟩ :=
    exists_augmentedSimplex_reductionBrionPairing_ne_zero
      k D hd hpm hp x hx
  have hpair : reductionBrionPairing k D hd hpm x.1
      (faceReductionClass k D F.1) ≠ 0 := by
    simpa [squarefreeReductionVector, faceReductionClass] using hpairRaw
  have hchoose : q - j ≤ F.1.card := by
    rw [F.2.2]
    omega
  obtain ⟨H, hHF, hHcard⟩ :=
    Finset.exists_subset_card_eq hchoose
  let G : Finset (Fin m) := F.1 \ H
  have hHG : Disjoint H G := by
    change Disjoint H (F.1 \ H)
    exact Finset.disjoint_sdiff
  have hunion : H ∪ G = F.1 := by
    change H ∪ F.1 \ H = F.1
    exact Finset.union_sdiff_of_subset hHF
  have hfaceFactor : faceReductionClass k (n := n) D F.1 =
      faceReductionClass k (n := n) D H *
        faceReductionClass k (n := n) D G := by
    rw [faceReductionClass_mul_of_disjoint k (n := n) D H G hHG,
      hunion]
  have hfull : x.1 * faceReductionClass k (n := n) D F.1 ≠ 0 := by
    intro hzero
    apply hpair
    rw [← reductionBrionFunctional_mul k D hd hpm, hzero, map_zero]
  have hfirst : x.1 * faceReductionClass k (n := n) D H ≠ 0 := by
    intro hzero
    apply hfull
    rw [hfaceFactor, ← mul_assoc, hzero, zero_mul]
  have hHmem : faceReductionClass k (n := n) D H ∈
      SimplicialSphereAnisotropicity.quotientDegree (n := n) k D (q - j) := by
    simpa [hHcard] using
      (faceReductionClass_mem_quotientDegree k (n := n) D H)
  let z : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q :=
    ⟨x.1 * faceReductionClass k (n := n) D H, by
      have hzmem := quotientDegree_mul_mem k D x.2 hHmem
      simpa [Nat.add_sub_of_le hjq] using hzmem⟩
  have hz : z ≠ 0 := by
    intro hzero
    apply hfirst
    simpa [z] using congrArg Subtype.val hzero
  have hzsq := hmiddle z hz
  intro hxsq
  apply hzsq
  change (x.1 * faceReductionClass k (n := n) D H) ^ 2 = 0
  calc
    (x.1 * faceReductionClass k (n := n) D H) ^ 2 =
        x.1 ^ 2 * faceReductionClass k D H ^ 2 := by ring
    _ = 0 := by rw [hxsq, zero_mul]

theorem sphere_quotientDegree_sq_ne_zero
    (k : Type u) [Field k] [CharP k 2] {n m j : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (htwo : 2 * j ≤ n + 1)
    (x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D j) (hx : x ≠ 0) :
    x.1 ^ 2 ≠ 0 := by
  obtain ⟨q, heven | hodd⟩ := Nat.even_or_odd' (n + 1)
  · apply quotientDegree_sq_ne_zero_of_middle
      k hn D hD (q := q) (by omega) (by omega) _ x hx
    intro z hz
    exact quotientDegree_sq_ne_zero_even_middle
      k hn D hD heven.symm z hz
  · apply quotientDegree_sq_ne_zero_of_middle
      k hn D hD (q := q) (by omega) (by omega) _ x hx
    intro z hz
    exact quotientDegree_sq_ne_zero_odd_middle
      k hn D hD hodd.symm z hz

theorem sphere_genericallyAnisotropic
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    SimplicialSphereAnisotropicity.GenericallyAnisotropic k D n := by
  intro j _hj htwo u huHom hu
  have huDegree : u ∈ SimplicialSphereAnisotropicity.quotientDegree (n := n) k D j :=
    (SimplicialSphereAnisotropicity.mem_quotientDegree_iff k D j u).2 huHom
  let x : SimplicialSphereAnisotropicity.quotientDegree (n := n) k D j := ⟨u, huDegree⟩
  have hx : x ≠ 0 := by
    intro hzero
    apply hu
    simpa [x] using congrArg Subtype.val hzero
  exact sphere_quotientDegree_sq_ne_zero k hn D hD htwo x hx

end SimplicialSphereAnisotropicity.Stress

end

