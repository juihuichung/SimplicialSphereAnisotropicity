section

/-!
# Cancellation of the global Brion denominator

This file assembles the local ridge-pairing calculation into a global
denominator-cancellation theorem.  For each irreducible pole, the incident
facets are paired by the ridge flip.  The paired cross-numerators acquire two
copies of that pole, while the common denominator contains it exactly once
for each incident facet.  Unique factorization then proves that the full
common denominator divides the common numerator.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v

theorem dvd_sum_of_fixedPointFree_involution
    {R : Type u} [CommRing R]
    {ι : Type v} [DecidableEq ι]
    (a : R) (s : Finset ι) (f : ι → R) (g : ι → ι)
    (hpair : ∀ i ∈ s, a ∣ f i + f (g i))
    (hne : ∀ i ∈ s, g i ≠ i)
    (hmem : ∀ i ∈ s, g i ∈ s)
    (hinv : ∀ i ∈ s, g (g i) = i) :
    a ∣ ∑ i ∈ s, f i := by
  classical
  induction s using Finset.strongInduction with
  | H s ih =>
      obtain rfl | ⟨x, hx⟩ := s.eq_empty_or_nonempty
      · exact dvd_zero a
      have hpairSub : {x, g x} ⊆ s := by
        intro y hy
        rw [Finset.mem_insert, Finset.mem_singleton] at hy
        rcases hy with rfl | rfl
        · exact hx
        · exact hmem x hx
      have hrestMem :
          ∀ i ∈ s \ {x, g x}, g i ∈ s \ {x, g x} := by
        intro i hi
        have his : i ∈ s := (Finset.mem_sdiff.mp hi).1
        have hgis : g i ∈ s := hmem i his
        have hix : i ≠ x := by
          intro hix
          apply (Finset.mem_sdiff.mp hi).2
          simp [hix]
        have higx : i ≠ g x := by
          intro higx
          apply (Finset.mem_sdiff.mp hi).2
          simp [higx]
        have hgix : g i ≠ x := by
          intro heq
          apply higx
          rw [← heq, hinv i his]
        have hgigx : g i ≠ g x := by
          intro heq
          apply hix
          rw [← hinv i his, heq, hinv x hx]
        exact Finset.mem_sdiff.mpr ⟨hgis, by simp [hgix, hgigx]⟩
      have hrest : a ∣ ∑ i ∈ s \ {x, g x}, f i := by
        apply ih (s \ {x, g x})
        · exact Finset.ssubset_iff.mpr
            ⟨x, by simp [Finset.insert_subset_iff, hx]⟩
        · intro i hi
          exact hpair i (Finset.mem_sdiff.mp hi).1
        · intro i hi
          exact hne i (Finset.mem_sdiff.mp hi).1
        · exact hrestMem
        · intro i hi
          exact hinv i (Finset.mem_sdiff.mp hi).1
      rw [← Finset.sum_sdiff hpairSub]
      exact dvd_add hrest (by
        simpa [hne x hx, (hne x hx).symm] using hpair x hx)

theorem pow_card_dvd_prod_of_dvd
    {R : Type u} [CommMonoid R]
    {ι : Type v} [DecidableEq ι]
    (q : R) (s : Finset ι) (e : ι → R)
    (h : ∀ i ∈ s, q ∣ e i) :
    q ^ s.card ∣ ∏ i ∈ s, e i := by
  rw [← Finset.prod_const]
  exact Finset.prod_dvd_prod_of_dvd _ _ h

theorem pow_card_dvd_prod_of_subset
    {R : Type u} [CommMonoid R]
    {ι : Type v} [DecidableEq ι]
    (q : R) (p s : Finset ι) (e : ι → R)
    (hps : p ⊆ s) (h : ∀ i ∈ p, q ∣ e i) :
    q ^ p.card ∣ ∏ i ∈ s, e i :=
  (pow_card_dvd_prod_of_dvd q p e h).trans
    (Finset.prod_dvd_prod_of_subset p s e hps)

def commonDenominatorNumerator
    {R : Type u} [CommRing R]
    {ι : Type v} [DecidableEq ι]
    (s : Finset ι) (b e : ι → R) : R :=
  ∑ i ∈ s, b i * ∏ j ∈ s.erase i, e j

theorem commonDenominatorTerm_add_flip
    {R : Type u} [CommRing R]
    {ι : Type v} [DecidableEq ι]
    (s : Finset ι) (b e : ι → R)
    {i k : ι} (hi : i ∈ s) (hk : k ∈ s) (hik : i ≠ k) :
    b i * (∏ j ∈ s.erase i, e j) +
        b k * (∏ j ∈ s.erase k, e j) =
      (b i * e k + b k * e i) *
        ∏ j ∈ (s.erase i).erase k, e j := by
  have hki : k ∈ s.erase i := Finset.mem_erase.mpr ⟨hik.symm, hk⟩
  have hik' : i ∈ s.erase k := Finset.mem_erase.mpr ⟨hik, hi⟩
  rw [← Finset.mul_prod_erase (s.erase i) e hki]
  rw [← Finset.mul_prod_erase (s.erase k) e hik']
  have herase : (s.erase k).erase i = (s.erase i).erase k := by
    ext x
    simp only [Finset.mem_erase]
    aesop
  rw [herase]
  ring

theorem pow_card_dvd_commonDenominatorNumerator
    {R : Type u} [CommRing R]
    {ι : Type v} [DecidableEq ι]
    (q : R) (s pole : Finset ι) (b e : ι → R) (g : ι → ι)
    (hpole : pole ⊆ s)
    (hq : ∀ i ∈ pole, q ∣ e i)
    (hgmem : ∀ i ∈ pole, g i ∈ pole)
    (hgne : ∀ i ∈ pole, g i ≠ i)
    (hginv : ∀ i ∈ pole, g (g i) = i)
    (hpair : ∀ i ∈ pole,
      q ^ 2 ∣ b i * e (g i) + b (g i) * e i) :
    q ^ pole.card ∣ commonDenominatorNumerator s b e := by
  classical
  let term : ι → R := fun i ↦
    b i * ∏ j ∈ s.erase i, e j
  have hpoleTerms : q ^ pole.card ∣ ∑ i ∈ pole, term i := by
    apply dvd_sum_of_fixedPointFree_involution
      (q ^ pole.card) pole term g
    · intro i hi
      have hgi : g i ∈ pole := hgmem i hi
      have his : i ∈ s := hpole hi
      have hgis : g i ∈ s := hpole hgi
      have hneig : i ≠ g i := (hgne i hi).symm
      let restPole := (pole.erase i).erase (g i)
      let rest := (s.erase i).erase (g i)
      have hrestSubset : restPole ⊆ rest := by
        intro j hj
        have hjp : j ∈ pole := Finset.mem_of_mem_erase
          (Finset.mem_of_mem_erase hj)
        have hjs : j ∈ s := hpole hjp
        have hji : j ≠ i := by
          exact (Finset.mem_erase.mp (Finset.mem_of_mem_erase hj)).1
        have hjg : j ≠ g i := (Finset.mem_erase.mp hj).1
        exact Finset.mem_erase.mpr ⟨hjg,
          Finset.mem_erase.mpr ⟨hji, hjs⟩⟩
      have hrestDvd : q ^ restPole.card ∣ ∏ j ∈ rest, e j :=
        pow_card_dvd_prod_of_subset q restPole rest e hrestSubset
          (fun j hj ↦ hq j (Finset.mem_of_mem_erase
            (Finset.mem_of_mem_erase hj)))
      have hcard : restPole.card + 2 = pole.card := by
        have hcardOuter := Finset.card_erase_add_one
          (Finset.mem_erase.mpr ⟨hgne i hi, hgi⟩)
        have hcardInner := Finset.card_erase_add_one hi
        dsimp only [restPole]
        omega
      have hmul := mul_dvd_mul (hpair i hi) hrestDvd
      rw [← pow_add] at hmul
      rw [add_comm 2 restPole.card, hcard] at hmul
      rw [commonDenominatorTerm_add_flip s b e his hgis hneig]
      exact hmul
    · exact hgne
    · exact hgmem
    · exact hginv
  have houtsideTerms : q ^ pole.card ∣
      ∑ i ∈ s \ pole, term i := by
    apply Finset.dvd_sum
    intro i hi
    have his : i ∈ s := (Finset.mem_sdiff.mp hi).1
    have hip : i ∉ pole := (Finset.mem_sdiff.mp hi).2
    have hsubset : pole ⊆ s.erase i := by
      intro j hj
      exact Finset.mem_erase.mpr ⟨by
        intro hji
        exact hip (hji ▸ hj), hpole hj⟩
    exact (pow_card_dvd_prod_of_subset q pole (s.erase i) e hsubset hq).mul_left _
  change q ^ pole.card ∣ ∑ i ∈ s, term i
  rw [← Finset.sum_sdiff hpole]
  exact dvd_add houtsideTerms hpoleTerms

noncomputable def incidenceEulerDenominator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (x : RidgeFacetIncidence D d) : ParameterPolynomial L d :=
  facetEuler L d a x.2.1.1 x.2.1.2.2 (ha x.2.1)

theorem incidenceEulerDenominator_factor
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (x : RidgeFacetIncidence D d) :
    incidenceEulerDenominator L d a ha x =
      incidenceCramerPolynomial L d a x *
        incidenceTangentialProduct L d a ha x := by
  have h := facetEuler_eq_cramer_mul_faceCoordinateProduct_erase
    L d a x.2.1.1 x.2.1.2.2 (ha x.2.1)
      (incidenceExtraVertex x) (incidenceExtraVertex_mem x)
  simpa only [incidenceEulerDenominator, incidenceCramerPolynomial,
    incidenceTangentialProduct, incidenceExtraVertex_erase] using h

theorem irreduciblePoleIncidence_sq_dvd_crossEuler
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (q : ParameterPolynomial L d)
    (x : IrreduciblePoleIncidence L D d a q) :
    q ^ 2 ∣
      incidenceFacetRestriction L d a ha f x.1 *
          incidenceEulerDenominator L d a ha
            (ridgeFlip D d hpm x.1) +
        incidenceFacetRestriction L d a ha f
            (ridgeFlip D d hpm x.1) *
          incidenceEulerDenominator L d a ha x.1 := by
  let y := ridgeFlip D d hpm x.1
  let c := incidenceCramerPolynomial L d a x.1
  let bF := incidenceFacetRestriction L d a ha f x.1
  let bG := incidenceFacetRestriction L d a ha f y
  let tF := incidenceTangentialProduct L d a ha x.1
  let tG := incidenceTangentialProduct L d a ha y
  have hcross : c ∣ bF * tG + bG * tF := by
    simpa only [c, bF, bG, tF, tG, y] using
      (incidenceCramerPolynomial_dvd_crossNumerator_flip
        L D d hpm a ha f x.1)
  have hc2 : c ^ 2 ∣ bF *
        incidenceEulerDenominator L d a ha y +
      bG * incidenceEulerDenominator L d a ha x.1 := by
    rw [incidenceEulerDenominator_factor,
      incidenceEulerDenominator_factor,
      incidenceCramerPolynomial_flip L D d hpm a]
    change c ^ 2 ∣ bF * (c * tG) + bG * (c * tF)
    have hm : c * c ∣ c * (bF * tG + bG * tF) :=
      mul_dvd_mul (dvd_refl c) hcross
    convert hm using 1 <;> ring
  exact (pow_dvd_pow_of_dvd x.2 2).trans hc2

noncomputable def facetBrionNumerator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (F : FacetOfCard D d) : ParameterPolynomial L d :=
  facetRestriction L d a F.1 F.2.2 (ha F) f

noncomputable def facetBrionDenominator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F : FacetOfCard D d) : ParameterPolynomial L d :=
  facetEuler L d a F.1 F.2.2 (ha F)

noncomputable instance brionFacetOfCardFintype
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ) :
    Fintype (FacetOfCard D d) :=
  Fintype.ofFinite _

theorem irreduciblePoleFacet_sq_dvd_crossEuler
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : IrreduciblePoleFacet L D d a ha q) :
    q ^ 2 ∣
      facetBrionNumerator L d a ha f F.1 *
          facetBrionDenominator L d a ha
            (irreduciblePoleFacetFlip L D d hd hpm a ha q hq F).1 +
        facetBrionNumerator L d a ha f
            (irreduciblePoleFacetFlip L D d hd hpm a ha q hq F).1 *
          facetBrionDenominator L d a ha F.1 := by
  let e := irreduciblePoleIncidenceEquivFacet L D d hd a ha q hq
  let x := e.symm F
  have h := irreduciblePoleIncidence_sq_dvd_crossEuler
    L D d hpm a ha f q x
  have hex : e x = F := e.apply_symm_apply F
  have heflip : e (irreduciblePoleFlip L D d hpm a q x) =
      irreduciblePoleFacetFlip L D d hd hpm a ha q hq F := by
    rfl
  rw [← heflip, ← hex]
  change q ^ 2 ∣
    incidenceFacetRestriction L d a ha f x.1 *
        incidenceEulerDenominator L d a ha
          (ridgeFlip D d hpm x.1) +
      incidenceFacetRestriction L d a ha f
          (ridgeFlip D d hpm x.1) *
        incidenceEulerDenominator L d a ha x.1
  exact h

noncomputable def facetPoleFinset
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) : Finset (FacetOfCard D d) :=
  by
    classical
    exact Finset.univ.filter fun F ↦
      q ∣ facetBrionDenominator L d a ha F

noncomputable def facetPoleFlipTotal
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : FacetOfCard D d) : FacetOfCard D d :=
  by
    classical
    exact if hF : q ∣ facetBrionDenominator L d a ha F then
      (irreduciblePoleFacetFlip L D d hd hpm a ha q hq ⟨F, hF⟩).1
    else F

theorem facetPoleFlipTotal_of_dvd
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : FacetOfCard D d)
    (hF : q ∣ facetBrionDenominator L d a ha F) :
    facetPoleFlipTotal L D d hd hpm a ha q hq F =
      (irreduciblePoleFacetFlip L D d hd hpm a ha q hq ⟨F, hF⟩).1 := by
  simp [facetPoleFlipTotal, hF]

theorem facetPoleFlipTotal_dvd
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : FacetOfCard D d)
    (hF : q ∣ facetBrionDenominator L d a ha F) :
    q ∣ facetBrionDenominator L d a ha
      (facetPoleFlipTotal L D d hd hpm a ha q hq F) := by
  rw [facetPoleFlipTotal_of_dvd L D d hd hpm a ha q hq F hF]
  exact (irreduciblePoleFacetFlip L D d hd hpm a ha q hq ⟨F, hF⟩).2

theorem facetPoleFlipTotal_ne
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : FacetOfCard D d)
    (hF : q ∣ facetBrionDenominator L d a ha F) :
    facetPoleFlipTotal L D d hd hpm a ha q hq F ≠ F := by
  rw [facetPoleFlipTotal_of_dvd L D d hd hpm a ha q hq F hF]
  intro h
  apply irreduciblePoleFacetFlip_ne L D d hd hpm a ha q hq ⟨F, hF⟩
  exact Subtype.ext h

theorem facetPoleFlipTotal_involutive_of_dvd
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : FacetOfCard D d)
    (hF : q ∣ facetBrionDenominator L d a ha F) :
    facetPoleFlipTotal L D d hd hpm a ha q hq
        (facetPoleFlipTotal L D d hd hpm a ha q hq F) = F := by
  let PF : IrreduciblePoleFacet L D d a ha q := ⟨F, hF⟩
  let PG := irreduciblePoleFacetFlip L D d hd hpm a ha q hq PF
  have hfirst : facetPoleFlipTotal L D d hd hpm a ha q hq F = PG.1 := by
    exact facetPoleFlipTotal_of_dvd L D d hd hpm a ha q hq F hF
  rw [hfirst]
  rw [facetPoleFlipTotal_of_dvd L D d hd hpm a ha q hq PG.1 PG.2]
  exact congrArg Subtype.val
    (irreduciblePoleFacetFlip_involutive L D d hd hpm a ha q hq PF)

noncomputable def brionCommonDenominator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    ParameterPolynomial L d :=
  ∏ F : FacetOfCard D d, facetBrionDenominator L d a ha F

noncomputable def brionCommonNumerator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) : ParameterPolynomial L d :=
  commonDenominatorNumerator Finset.univ
    (facetBrionNumerator L d a ha f)
    (facetBrionDenominator L d a ha)

theorem irreducible_pow_poleCard_dvd_brionCommonNumerator
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (q : ParameterPolynomial L d) (hq : Irreducible q) :
    q ^ (facetPoleFinset L D d a ha q).card ∣
      brionCommonNumerator L D d a ha f := by
  classical
  let pole := facetPoleFinset L D d a ha q
  let b := facetBrionNumerator L d a ha f
  let e := facetBrionDenominator L d a ha
  let g := facetPoleFlipTotal L D d hd hpm a ha q hq
  have h := pow_card_dvd_commonDenominatorNumerator
    q (Finset.univ : Finset (FacetOfCard D d)) pole b e g
  apply h
  · exact Finset.subset_univ _
  · intro F hF
    exact (Finset.mem_filter.mp hF).2
  · intro F hF
    have hFd : q ∣ facetBrionDenominator L d a ha F :=
      (Finset.mem_filter.mp hF).2
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      facetPoleFlipTotal_dvd L D d hd hpm a ha q hq F hFd⟩
  · intro F hF
    exact facetPoleFlipTotal_ne L D d hd hpm a ha q hq F
      (Finset.mem_filter.mp hF).2
  · intro F hF
    exact facetPoleFlipTotal_involutive_of_dvd
      L D d hd hpm a ha q hq F (Finset.mem_filter.mp hF).2
  · intro F hF
    have hFd : q ∣ facetBrionDenominator L d a ha F :=
      (Finset.mem_filter.mp hF).2
    have hp := irreduciblePoleFacet_sq_dvd_crossEuler
      L D d hd hpm a ha f q hq ⟨F, hFd⟩
    simpa only [b, e, g,
      facetPoleFlipTotal_of_dvd L D d hd hpm a ha q hq F hFd] using hp

theorem inverseCoordinate_factor_unique
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    {q : ParameterPolynomial L d} (hq : Irreducible q)
    {v w : ↥F}
    (hqv : q ∣ inverseCoordinate L d a F hF hdet v)
    (hqw : q ∣ inverseCoordinate L d a F hF hdet w) :
    v = w := by
  apply facetCramerPolynomial_factor_unique L d a F hF hdet hq
  · rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F hF hdet v]
    exact hqv.mul_left _
  · rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F hF hdet w]
    exact hqw.mul_left _

theorem prime_emultiplicity_facetBrionDenominator_of_dvd
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (p : ParameterPolynomial L d) (hp : Prime p)
    (F : FacetOfCard D d)
    (hpd : p ∣ facetBrionDenominator L d a ha F) :
    emultiplicity p (facetBrionDenominator L d a ha F) = 1 := by
  classical
  let c : ParameterPolynomial L d :=
    MvPolynomial.C (facetMatrix L d a F.1 F.2.2).det
  let ell : ↥F.1 → ParameterPolynomial L d :=
    inverseCoordinate L d a F.1 F.2.2 (ha F)
  have hcunit : IsUnit c :=
    (isUnit_iff_ne_zero.mpr (ha F)).map MvPolynomial.C
  change p ∣ c * ∏ v : ↥F.1, ell v at hpd
  have hpprod : p ∣ ∏ v : ↥F.1, ell v := by
    rcases hp.dvd_or_dvd hpd with hpc | hpprod
    · exact (hp.not_isUnit (isUnit_of_dvd_unit hpc hcunit)).elim
    · exact hpprod
  obtain ⟨v, _hv, hpv⟩ := hp.exists_mem_finset_dvd hpprod
  have hvassoc : Associated p (ell v) :=
    hp.irreducible.associated_of_dvd
      (inverseCoordinate_irreducible L d a F.1 F.2.2 (ha F) v) hpv
  have hvone : emultiplicity p (ell v) = 1 := by
    calc
      emultiplicity p (ell v) = emultiplicity p p :=
        (emultiplicity_eq_of_associated_right hvassoc).symm
      _ = 1 := by
        simpa using emultiplicity_pow_self_of_prime hp 1
  change emultiplicity p (c * ∏ v : ↥F.1, ell v) = 1
  rw [emultiplicity_mul hp,
    emultiplicity_of_isUnit_right hp.not_isUnit hcunit,
    Finset.emultiplicity_prod hp, zero_add]
  rw [Finset.sum_eq_single v]
  · exact hvone
  · intro w _hw hwv
    apply emultiplicity_eq_zero.mpr
    intro hpw
    exact hwv (inverseCoordinate_factor_unique
      L d a F.1 F.2.2 (ha F) hp.irreducible hpv hpw).symm
  · simp

theorem prime_emultiplicity_brionCommonDenominator
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (p : ParameterPolynomial L d) (hp : Prime p) :
    emultiplicity p (brionCommonDenominator L D d a ha) =
      (facetPoleFinset L D d a ha p).card := by
  classical
  rw [brionCommonDenominator, Finset.emultiplicity_prod hp]
  calc
    ∑ F : FacetOfCard D d,
          emultiplicity p (facetBrionDenominator L d a ha F) =
        ∑ F : FacetOfCard D d,
          if p ∣ facetBrionDenominator L d a ha F then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro F _hF
      by_cases hpd : p ∣ facetBrionDenominator L d a ha F
      · rw [if_pos hpd]
        exact prime_emultiplicity_facetBrionDenominator_of_dvd
          L d a ha p hp F hpd
      · rw [if_neg hpd]
        exact emultiplicity_eq_zero.mpr hpd
    _ = (facetPoleFinset L D d a ha p).card := by
      simp [facetPoleFinset]

theorem brionCommonDenominator_ne_zero
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    brionCommonDenominator L D d a ha ≠ 0 := by
  rw [brionCommonDenominator]
  exact Finset.prod_ne_zero_iff.mpr fun F _hF ↦
    facetEuler_ne_zero L d a F.1 F.2.2 (ha F)

theorem brionCommonDenominator_dvd_brionCommonNumerator
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) :
    brionCommonDenominator L D d a ha ∣
      brionCommonNumerator L D d a ha f := by
  apply (UniqueFactorizationMonoid.dvd_iff_emultiplicity_le
    (brionCommonDenominator_ne_zero L D d a ha)).mpr
  intro p hp
  rw [prime_emultiplicity_brionCommonDenominator L D d a ha p hp]
  exact pow_dvd_iff_le_emultiplicity.mp
    (irreducible_pow_poleCard_dvd_brionCommonNumerator
      L D d hd hpm a ha f p hp.irreducible)

end SimplicialSphereAnisotropicity.Generic.Brion

end

