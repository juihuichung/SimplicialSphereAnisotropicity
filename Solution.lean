/-!
# Facet-monomial normalization of Brion integration

An unequal facet restriction kills a top-face squarefree monomial, while the
matching restriction cancels its inverse-coordinate product against the Euler
denominator.  Thus the Brion sum of a facet monomial is the inverse facet
determinant.  The final statements specialize this normalization to the
trusted generic coefficient matrix and canonical face-ring model.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

theorem facetRestriction_faceMonomial_eq_zero_of_ne
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F G : FacetOfCard D d) (hFG : F ≠ G) :
    facetRestriction L d a G.1 G.2.2 (ha G)
        (∏ v ∈ F.1, MvPolynomial.X v) = 0 := by
  have hnot : ¬ F.1 ⊆ G.1 := by
    intro hsub
    apply hFG
    apply Subtype.ext
    exact Finset.eq_of_subset_of_card_le hsub (by
      rw [F.2.2, G.2.2])
  obtain ⟨v, hvF, hvG⟩ := Finset.not_subset.mp hnot
  rw [map_prod]
  apply Finset.prod_eq_zero hvF
  exact facetRestriction_X_not_mem L d a G.1 G.2.2 (ha G) v hvG

theorem facetBrionFraction_faceMonomial_self
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F : FacetOfCard D d) :
    facetBrionFraction L d a ha
        (∏ v ∈ F.1, MvPolynomial.X v) F =
      algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
        (MvPolynomial.C (((facetMatrix L d a F.1 F.2.2).det)⁻¹)) := by
  rw [facetBrionFraction, facetBrionNumerator,
    facetBrionDenominator, facetRestriction_faceProduct, facetEuler]
  rw [map_mul]
  rw [div_eq_iff]
  · have hcancel :
        algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
              (MvPolynomial.C (((facetMatrix L d a F.1 F.2.2).det)⁻¹)) *
            algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
              (MvPolynomial.C ((facetMatrix L d a F.1 F.2.2).det)) = 1 := by
        rw [← map_mul, ← MvPolynomial.C.map_mul,
          inv_mul_cancel₀ (ha F), MvPolynomial.C_1, map_one]
    rw [← mul_assoc, hcancel, one_mul]
  · apply mul_ne_zero
    · exact (map_ne_zero_iff _
        (IsFractionRing.injective
          (ParameterPolynomial L d) (ParameterFraction L d))).mpr
        (MvPolynomial.C_ne_zero.mpr (ha F))
    · apply (map_ne_zero_iff _
        (IsFractionRing.injective
          (ParameterPolynomial L d) (ParameterFraction L d))).mpr
      exact Finset.prod_ne_zero_iff.mpr fun v _hv ↦
        inverseCoordinate_ne_zero L d a F.1 F.2.2 (ha F) v

theorem facetBrionFraction_faceMonomial_eq_zero_of_ne
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F G : FacetOfCard D d) (hFG : F ≠ G) :
    facetBrionFraction L d a ha
        (∏ v ∈ F.1, MvPolynomial.X v) G = 0 := by
  simp [facetBrionFraction, facetBrionNumerator,
    facetRestriction_faceMonomial_eq_zero_of_ne L d a ha F G hFG]

theorem brionRational_faceMonomial
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F : FacetOfCard D d) :
    brionRational L D d a ha
        (∏ v ∈ F.1, MvPolynomial.X v) =
      algebraMap (ParameterPolynomial L d) (ParameterFraction L d)
        (MvPolynomial.C (((facetMatrix L d a F.1 F.2.2).det)⁻¹)) := by
  rw [brionRational, Finset.sum_eq_single F]
  · exact facetBrionFraction_faceMonomial_self L d a ha F
  · intro G _hG hGF
    exact facetBrionFraction_faceMonomial_eq_zero_of_ne
      L d a ha F G (Ne.symm hGF)
  · simp

theorem brionPolynomial_faceMonomial
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (F : FacetOfCard D d) :
    brionPolynomial L D d hd hpm a ha
        (∏ v ∈ F.1, MvPolynomial.X v) =
      MvPolynomial.C (((facetMatrix L d a F.1 F.2.2).det)⁻¹) := by
  apply IsFractionRing.injective
    (ParameterPolynomial L d) (ParameterFraction L d)
  rw [← brionRational_eq_algebraMap_brionPolynomial
      L D d hd hpm a ha,
    brionRational_faceMonomial]

theorem genericFacetMatrix_eq_faceCoefficientMatrix
    (k : Type*) [Field k] {n m : ℕ}
    {D : AbstractSimplicialComplex (Fin m)}
    (F : FacetOfCard D (n + 1)) :
    facetMatrix (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) F.1 F.2.2 =
      Generic.faceCoefficientMatrix k F.1 F.2.2 := by
  ext i j
  rfl

theorem genericBrionPolynomial_faceMonomial
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
        (genericCoefficientMatrix k) (genericFacetMatrix_det_ne_zero k)
        (SimplicialSphereAnisotropicity.faceMonomial F.1) =
      MvPolynomial.C ((Generic.faceMinor k F.1 F.2.2)⁻¹) := by
  have h := brionPolynomial_faceMonomial
    (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
    (genericCoefficientMatrix k) (genericFacetMatrix_det_ne_zero k) F
  rw [genericFacetMatrix_eq_faceCoefficientMatrix k F] at h
  simpa [SimplicialSphereAnisotropicity.faceMonomial, Generic.faceMinor] using h

set_option linter.style.haveILetI false in
theorem faceRingBrionLinearMap_faceMonomial
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (F : FacetOfCard D (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    (faceRingBrionLinearMap k D hd hpm)
        (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) (SimplicialSphereAnisotropicity.faceMonomial F.1)) =
      MvPolynomial.C ((Generic.faceMinor k F.1 F.2.2)⁻¹) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  change brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
      (genericCoefficientMatrix k) (genericFacetMatrix_det_ne_zero k)
      (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)
        (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) (SimplicialSphereAnisotropicity.faceMonomial F.1))) = _
  rw [genericBrionPolynomial_facePart]
  exact genericBrionPolynomial_faceMonomial k D hd hpm F

set_option linter.style.haveILetI false in
theorem sphereFaceRingBrionLinearMap_faceMonomial
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : FacetOfCard D (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    (sphereFaceRingBrionLinearMap k hn D hD)
        (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) (SimplicialSphereAnisotropicity.faceMonomial F.1)) =
      MvPolynomial.C ((Generic.faceMinor k F.1 F.2.2)⁻¹) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  exact faceRingBrionLinearMap_faceMonomial k D (by omega)
