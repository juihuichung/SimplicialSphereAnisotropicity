theorem boundaryOnSimplex_liftLastNeg (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) (q + 1)) :
    boundaryOnSimplex K (crossAug (d + 1)) (q + 1)
        (liftLastNegSimplex d F) =
      Finsupp.single (liftCrossSimplex d F) 1 +
        ∑ v : ↥F.1,
          Finsupp.single
            (liftLastNegSimplex d (eraseSimplex (crossAug d) F v)) 1 := by
  let oldTerm : ↥F.1 → AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    fun v ↦ Finsupp.single
      (liftLastNegSimplex d (eraseSimplex (crossAug d) F v)) 1
  let splitTerm : ↥F.1 ⊕ PUnit →
      AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    Sum.elim oldTerm (fun _ ↦ Finsupp.single (liftCrossSimplex d F) 1)
