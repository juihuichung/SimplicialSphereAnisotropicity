    (faceRingModelPositiveSubmoduleK k D)).mpr
      (parameter_smul_sub_constant_mem_positive k D p z)

set_option linter.style.haveILetI false in
theorem faceRingModelResidue_span_mk_image
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (S : Finset (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D))) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    Submodule.span (Generic.ParameterRing k n m)
        (↑S : Set (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D))) = ⊤ →
      Submodule.span (SimplicialSphereAnisotropicity.GenericField k n m)
        ((fun z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) ↦
          (Submodule.Quotient.mk z : FaceRingModelResidue k n m D)) ''
          (↑S : Set (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)))) = ⊤ := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  intro hS
  apply top_unique
  intro q hq
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective
    (p := faceRingModelPositiveSubmoduleK k D) q
  clear hq
  have hz : z ∈ Submodule.span (Generic.ParameterRing k n m)
      (↑S : Set (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D))) := by
    rw [hS]
    exact Submodule.mem_top
  induction hz using Submodule.span_induction with
  | mem z hz =>
      apply Submodule.subset_span
      exact ⟨z, hz, rfl⟩
  | zero => exact Submodule.zero_mem _
  | add x y hx hy ihx ihy =>
      rw [Submodule.Quotient.mk_add]
      exact Submodule.add_mem _ ihx ihy
  | smul p z hz ih =>
      rw [faceRingModelResidue_mk_parameter_smul]
      exact Submodule.smul_mem _ _ ih

set_option linter.style.haveILetI false in
theorem faceRingModelResidue_finiteDimensional
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy (AugmentedComplex.ofAbstract D) (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (n + 1)) :
    FiniteDimensional (SimplicialSphereAnisotropicity.GenericField k n m)
      (FaceRingModelResidue k n m D) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  obtain ⟨S, hS, hhom⟩ :=
    exists_finset_homogeneous_faceRingModel_span k D hbound hall
  apply Module.Finite.of_fg_top
  rw [Submodule.fg_def]
  refine ⟨(fun z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D) ↦
    (Submodule.Quotient.mk z : FaceRingModelResidue k n m D)) ''
      (↑S : Set (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D))),
    Set.Finite.image _ S.finite_toSet, ?_⟩
  exact faceRingModelResidue_span_mk_image k D S hS

set_option linter.style.haveILetI false in
theorem exists_homogeneous_faceRingModel_residueBasis
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy (AugmentedComplex.ofAbstract D) (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    ∃ (N : ℕ)
        (e : Fin N → FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D))
        (r : Fin N → ℕ),
      (∀ i, FaceRingModelHomogeneous
        (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
        (r i) (e i)) ∧
      LinearIndependent (SimplicialSphereAnisotropicity.GenericField k n m)
        (fun i ↦ (Submodule.Quotient.mk (e i) :
          FaceRingModelResidue k n m D)) ∧
      Submodule.span (SimplicialSphereAnisotropicity.GenericField k n m)
        (Set.range fun i ↦ (Submodule.Quotient.mk (e i) :
          FaceRingModelResidue k n m D)) = ⊤ := by
  classical
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  letI : FiniteDimensional (SimplicialSphereAnisotropicity.GenericField k n m)
      (FaceRingModelResidue k n m D) :=
    faceRingModelResidue_finiteDimensional k D hbound hall
  obtain ⟨S, hS, hhom⟩ :=
    exists_finset_homogeneous_faceRingModel_span k D hbound hall
  let V : Set (FaceRingModelResidue k n m D) :=
    (fun z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D) ↦
      (Submodule.Quotient.mk z : FaceRingModelResidue k n m D)) '' ↑S
  have hVspan : Submodule.span (SimplicialSphereAnisotropicity.GenericField k n m) V = ⊤ :=
    faceRingModelResidue_span_mk_image k D S hS
  obtain ⟨f, hfmem, hfspan, hfli⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq
      (SimplicialSphereAnisotropicity.GenericField k n m) V
  have hfpre : ∀ i, ∃ z, z ∈ S ∧
      (Submodule.Quotient.mk z : FaceRingModelResidue k n m D) = f i := by
    intro i
    exact hfmem i
  choose e heS he using hfpre
  have hehom : ∀ i, ∃ r : ℕ,
      FaceRingModelHomogeneous
        (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
        r (e i) := fun i ↦ hhom (e i) (heS i)
  choose r hr using hehom
  refine ⟨_, e, r, hr, ?_, ?_⟩
  · simpa only [he] using hfli
  · simpa only [he] using hfspan.trans hVspan

end SimplicialSphereAnisotropicity.StanleyReisner

