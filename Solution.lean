/-!
# Trusted algebra facade

This module records elementary bridges to the exact objects in
`SimplicialSphereAnisotropicity.Definitions`.  It introduces no alternate quotient and no mathematical
hypothesis used by the final theorem.
-/

noncomputable section

open scoped BigOperators

namespace SimplicialSphereAnisotropicity

open SimplicialSphereAnisotropicity MvPolynomial

abbrev CoeffRing (k : Type*) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.CoefficientPolynomial k n m

abbrev CoeffField (k : Type*) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

abbrev VertexRing (k : Type*) [Field k] (n m : ℕ) :=
  MvPolynomial (Fin m) (CoeffField k n m)

abbrev Reduction (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :=
  SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The image of the degree-`j` homogeneous subspace in the exact trusted
quotient. -/
noncomputable def quotientDegree
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (j : ℕ) :
    Submodule (CoeffField k n m)
      (SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D) :=
  (MvPolynomial.homogeneousSubmodule (Fin m) (CoeffField k n m) j).map
    (Ideal.Quotient.mkₐ (CoeffField k n m)
      (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toLinearMap

set_option linter.style.haveILetI false in
noncomputable instance quotientDegree_finiteDimensional
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (j : ℕ) :
    FiniteDimensional (CoeffField k n m)
      (quotientDegree (n := n) k D j) := by
  haveI : Module.Finite (CoeffField k n m)
      (MvPolynomial.homogeneousSubmodule (Fin m) (CoeffField k n m) j) :=
    Module.Finite.of_fg
      (MvPolynomial.homogeneousSubmodule_fg (Fin m) (CoeffField k n m) j)
  change Module.Finite (CoeffField k n m)
    ↥((MvPolynomial.homogeneousSubmodule (Fin m) (CoeffField k n m) j).map
      (Ideal.Quotient.mkₐ (CoeffField k n m)
        (SimplicialSphereAnisotropicity.genericReductionIdeal k D)).toLinearMap)
  exact Module.Finite.map _ _

/-- The facade degree subspace is exactly the trusted existential notion of a
homogeneous quotient class. -/
theorem mem_quotientDegree_iff
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (j : ℕ)
    (u : SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D) :
    u ∈ quotientDegree (n := n) k D j ↔
      SimplicialSphereAnisotropicity.IsHomogeneousClass k D j u := by
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p, hp, rfl⟩
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p, hp, rfl⟩

theorem faceMonomial_isHomogeneous
    (K : Type*) [CommSemiring K] {m : ℕ} (s : Finset (Fin m)) :
    (SimplicialSphereAnisotropicity.faceMonomial (K := K) s).IsHomogeneous s.card := by
  classical
  simp only [SimplicialSphereAnisotropicity.faceMonomial]
  simpa using MvPolynomial.IsHomogeneous.prod s
    (fun v : Fin m ↦ MvPolynomial.X v)
    (fun _ : Fin m ↦ 1)
    (fun v _ ↦ MvPolynomial.isHomogeneous_X K v)

theorem genericLinearForm_isHomogeneous
    (k : Type*) [Field k] {n m : ℕ} (i : Fin (n + 1)) :
    (SimplicialSphereAnisotropicity.genericLinearForm k (n := n) (m := m) i).IsHomogeneous 1 := by
  apply MvPolynomial.IsHomogeneous.sum
  intro j hj
  exact MvPolynomial.isHomogeneous_C_mul_X _ _

theorem stanleyReisnerIdeal_isHomogeneous
    (K : Type*) [CommRing K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) K) := by
  apply Ideal.homogeneous_span
  intro p hp
  obtain ⟨s, -, -, rfl⟩ := hp
  exact ⟨s.card, faceMonomial_isHomogeneous K s⟩

theorem genericParameterIdeal_isHomogeneous
    (k : Type*) [Field k] (n m : ℕ) :
    (SimplicialSphereAnisotropicity.genericParameterIdeal k n m).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) (CoeffField k n m)) := by
  apply Ideal.homogeneous_span
  intro p hp
  obtain ⟨i, rfl⟩ := hp
  exact ⟨1, genericLinearForm_isHomogeneous k i⟩

theorem genericReductionIdeal_isHomogeneous
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    (SimplicialSphereAnisotropicity.genericReductionIdeal k D).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) (CoeffField k n m)) := by
  apply Ideal.IsHomogeneous.sup
  · exact stanleyReisnerIdeal_isHomogeneous (CoeffField k n m) D
  · exact genericParameterIdeal_isHomogeneous k n m

/-- The trusted quotient statement is exactly homogeneous ideal-membership
anisotropy on representatives. -/
theorem genericallyAnisotropic_iff_representatives
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    SimplicialSphereAnisotropicity.GenericallyAnisotropic k D n ↔
      ∀ j : ℕ, 1 ≤ j → 2 * j ≤ n + 1 →
        ∀ p : VertexRing k n m, p.IsHomogeneous j →
          p ∉ SimplicialSphereAnisotropicity.genericReductionIdeal k D →
            p ^ 2 ∉ SimplicialSphereAnisotropicity.genericReductionIdeal k D := by
  constructor
  · intro h j hj h2 p hp hp0 hp2
    have hu := h j hj h2
      (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p)
      ⟨p, hp, rfl⟩
      (Ideal.Quotient.eq_zero_iff_mem.not.mpr hp0)
    apply hu
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact hp2
  · intro h j hj h2 u huHom hu0
    obtain ⟨p, hp, rfl⟩ := huHom
    have hp0 : p ∉ SimplicialSphereAnisotropicity.genericReductionIdeal k D :=
      Ideal.Quotient.eq_zero_iff_mem.not.mp hu0
    have hp2 := h j hj h2 p hp hp0
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.not.mpr hp2

end SimplicialSphereAnisotropicity

end

