section

/-!
# Ridge compatibility for generic Brion coordinates

This module proves that adjacent facets have the same Cramer normal in
characteristic two and that their restrictions agree modulo that normal.
It also packages the denominator factorization and cross-numerator
divisibility used by factorwise Brion pole cancellation.
-/

noncomputable section

open scoped BigOperators
open Matrix MvPolynomial

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v

def finsetExchangeEquiv
    {V : Type v} [DecidableEq V]
    {F G : Finset V} {v w : V}
    (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w) : ↥F ≃ ↥G where
  toFun x := if hx : x.1 = v then ⟨w, hw⟩ else ⟨x.1, by
    have hxe : x.1 ∈ F.erase v := Finset.mem_erase.mpr ⟨hx, x.2⟩
    rw [hFG] at hxe
    exact (Finset.mem_erase.mp hxe).2⟩
  invFun y := if hy : y.1 = w then ⟨v, hv⟩ else ⟨y.1, by
    have hye : y.1 ∈ G.erase w := Finset.mem_erase.mpr ⟨hy, y.2⟩
    rw [← hFG] at hye
    exact (Finset.mem_erase.mp hye).2⟩
  left_inv x := by
    by_cases hx : x.1 = v
    · apply Subtype.ext
      simp [hx]
    · have hxe : x.1 ∈ F.erase v := Finset.mem_erase.mpr ⟨hx, x.2⟩
      have hxge : x.1 ∈ G.erase w := by simpa [hFG] using hxe
      have hxw : x.1 ≠ w := (Finset.mem_erase.mp hxge).1
      apply Subtype.ext
      simp [hx, hxw]
  right_inv y := by
    by_cases hy : y.1 = w
    · apply Subtype.ext
      simp [hy]
    · have hye : y.1 ∈ G.erase w := Finset.mem_erase.mpr ⟨hy, y.2⟩
      have hyfe : y.1 ∈ F.erase v := by simpa [hFG] using hye
      have hyv : y.1 ≠ v := (Finset.mem_erase.mp hyfe).1
      apply Subtype.ext
      simp [hy, hyv]

noncomputable def finsetExchangePerm
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w) : Equiv.Perm (Fin d) :=
  (F.orderIsoOfFin hF).toEquiv |>.trans
    (finsetExchangeEquiv hv hw hFG) |>.trans
      (G.orderIsoOfFin hG).symm.toEquiv

@[simp]
theorem finsetExchangePerm_missing
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w) :
    finsetExchangePerm d hF hG hv hw hFG
        ((F.orderIsoOfFin hF).symm ⟨v, hv⟩) =
      (G.orderIsoOfFin hG).symm ⟨w, hw⟩ := by
  simp [finsetExchangePerm, finsetExchangeEquiv]

theorem finsetExchangePerm_vertex
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w)
    (j : Fin d)
    (hj : F.orderEmbOfFin hF j ≠ v) :
    G.orderEmbOfFin hG (finsetExchangePerm d hF hG hv hw hFG j) =
      F.orderEmbOfFin hF j := by
  unfold finsetExchangePerm
  simp only [Equiv.trans_apply]
  have hje : F.orderEmbOfFin hF j ∈ F.erase v :=
    Finset.mem_erase.mpr ⟨hj, Finset.orderEmbOfFin_mem F hF j⟩
  have hjG : F.orderEmbOfFin hF j ∈ G := by
    rw [hFG] at hje
    exact (Finset.mem_erase.mp hje).2
  have hexc :
      finsetExchangeEquiv hv hw hFG ((F.orderIsoOfFin hF) j) =
        ⟨F.orderEmbOfFin hF j, hjG⟩ := by
    apply Subtype.ext
    simp [finsetExchangeEquiv, hj]
  change G.orderEmbOfFin hG
      ((G.orderIsoOfFin hG).symm
        (finsetExchangeEquiv hv hw hFG ((F.orderIsoOfFin hF) j))) = _
  rw [hexc]
  exact congrArg Subtype.val
    ((G.orderIsoOfFin hG).apply_symm_apply
      ⟨F.orderEmbOfFin hF j, hjG⟩)

theorem intUnit_cast_eq_one_of_char_two
    (R : Type u) [Ring R] [CharP R 2] (z : ℤˣ) :
    ((z : ℤ) : R) = 1 := by
  rcases Int.units_eq_one_or z with hz | hz
  · subst z
    simp
  · subst z
    simpa using (CharTwo.neg_eq (1 : R))

theorem facetCramerPolynomial_eq_of_erase_eq
    (L : Type u) [Field L] [CharP L 2]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w) :
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ =
      facetCramerPolynomial L d a G hG ⟨w, hw⟩ := by
  let P := ParameterPolynomial L d
  let φ : L →+* P := MvPolynomial.C
  let jF : Fin d := (F.orderIsoOfFin hF).symm ⟨v, hv⟩
  let jG : Fin d := (G.orderIsoOfFin hG).symm ⟨w, hw⟩
  let σ : Equiv.Perm (Fin d) := finsetExchangePerm d hF hG hv hw hFG
  let t : Fin d → P := fun i ↦ MvPolynomial.X i
  let MF : Matrix (Fin d) (Fin d) P :=
    (φ.mapMatrix (facetMatrix L d a F hF)).updateCol jF t
  let MG : Matrix (Fin d) (Fin d) P :=
    (φ.mapMatrix (facetMatrix L d a G hG)).updateCol jG t
  have hmissing : σ jF = jG := by
    exact finsetExchangePerm_missing d hF hG hv hw hFG
  have hmatrix : MG.submatrix id σ = MF := by
    apply Matrix.ext
    intro i j
    simp only [Matrix.submatrix_apply, id_eq, MF, MG,
      Matrix.updateCol_apply]
    by_cases hj : j = jF
    · subst j
      rw [if_pos hmissing, if_pos rfl]
    · have hjv : F.orderEmbOfFin hF j ≠ v := by
        intro heq
        apply hj
        apply (F.orderEmbOfFin hF).injective
        exact heq.trans (congrArg Subtype.val
          ((F.orderIsoOfFin hF).apply_symm_apply ⟨v, hv⟩)).symm
      have hσj : σ j ≠ jG := by
        intro heq
        apply hj
        exact σ.injective (heq.trans hmissing.symm)
      have hvertex : G.orderEmbOfFin hG (σ j) =
          F.orderEmbOfFin hF j :=
        finsetExchangePerm_vertex d hF hG hv hw hFG j hjv
      rw [if_neg hσj, if_neg hj]
      change φ (a i (G.orderEmbOfFin hG (σ j))) =
        φ (a i (F.orderEmbOfFin hF j))
      rw [hvertex]
  rw [facetCramerPolynomial_eq_updateCol_det,
    facetCramerPolynomial_eq_updateCol_det]
  change MF.det = MG.det
  rw [← hmatrix, Matrix.det_permute']
  rw [intUnit_cast_eq_one_of_char_two P (Equiv.Perm.sign σ)]
  exact one_mul _

def finsetSubsetEmbedding
    {V : Type v} {R F : Finset V} (hRF : R ⊆ F) : ↥R ↪ ↥F where
  toFun r := ⟨r.1, hRF r.2⟩
  inj' := fun _ _ h ↦
    Subtype.ext (congrArg (fun z : ↥F ↦ z.1) h)

noncomputable def parameterFaceAlgHomViaFacet
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    ParameterPolynomial L d →ₐ[L] MvPolynomial ↥R L :=
  (MvPolynomial.killCompl (finsetSubsetEmbedding hRF).injective).comp
    (facetParameterAlgEquiv L d a F hF hdet).toAlgHom

@[simp]
theorem parameterFaceAlgHomViaFacet_X
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (i : Fin d) :
    parameterFaceAlgHomViaFacet L d a R F hRF hF hdet
        (MvPolynomial.X i) =
      ∑ r : ↥R, MvPolynomial.C (a i r.1) * MvPolynomial.X r := by
  change MvPolynomial.killCompl (finsetSubsetEmbedding hRF).injective
      (facetParameterAlgEquiv L d a F hF hdet (MvPolynomial.X i)) = _
  rw [facetParameterAlgEquiv_X_subtype]
  exact SimplicialSphereAnisotropicity.Generic.killCompl_sum_C_mul_X
    (finsetSubsetEmbedding hRF) (fun f : ↥F ↦ a i f.1)

theorem parameterFaceAlgHomViaFacet_eq
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F G : Finset V) (hRF : R ⊆ F) (hRG : R ⊆ G)
    (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0) :
    parameterFaceAlgHomViaFacet L d a R F hRF hF hdetF =
      parameterFaceAlgHomViaFacet L d a R G hRG hG hdetG := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [parameterFaceAlgHomViaFacet_X,
    parameterFaceAlgHomViaFacet_X]

@[simp]
theorem parameterFaceAlgHomViaFacet_inverseCoordinate
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (r : ↥R) :
    parameterFaceAlgHomViaFacet L d a R F hRF hF hdet
        (inverseCoordinate L d a F hF hdet
          (finsetSubsetEmbedding hRF r)) =
      MvPolynomial.X r := by
  change MvPolynomial.killCompl (finsetSubsetEmbedding hRF).injective
      (facetParameterAlgEquiv L d a F hF hdet
        ((facetParameterAlgEquiv L d a F hF hdet).symm
          (MvPolynomial.X (finsetSubsetEmbedding hRF r)))) = _
  rw [(facetParameterAlgEquiv L d a F hF hdet).apply_symm_apply]
  exact SimplicialSphereAnisotropicity.Generic.killCompl_X_embedding
    (finsetSubsetEmbedding hRF) r

theorem parameterFaceAlgHomViaFacet_inverseCoordinate_not_mem
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (f : ↥F) (hf : f.1 ∉ R) :
    parameterFaceAlgHomViaFacet L d a R F hRF hF hdet
        (inverseCoordinate L d a F hF hdet f) = 0 := by
  change MvPolynomial.killCompl (finsetSubsetEmbedding hRF).injective
      (facetParameterAlgEquiv L d a F hF hdet
        ((facetParameterAlgEquiv L d a F hF hdet).symm
          (MvPolynomial.X f))) = 0
  rw [(facetParameterAlgEquiv L d a F hF hdet).apply_symm_apply]
  apply SimplicialSphereAnisotropicity.Generic.killCompl_X_eq_zero
  rintro ⟨r, hr⟩
  apply hf
  rw [← congrArg Subtype.val hr]
  exact r.2

def finsetValEmbedding
    {V : Type v} (R : Finset V) : ↥R ↪ V where
  toFun r := r.1
  inj' := Subtype.val_injective

noncomputable def ambientFaceRestriction
    (L : Type u) [Field L]
    {V : Type v} [Fintype V]
    (R : Finset V) : MvPolynomial V L →ₐ[L] MvPolynomial ↥R L :=
  MvPolynomial.killCompl (finsetValEmbedding R).injective

theorem parameterFaceAlgHomViaFacet_comp_facetRestriction
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    (parameterFaceAlgHomViaFacet L d a R F hRF hF hdet).comp
        (facetRestriction L d a F hF hdet) =
      ambientFaceRestriction L R := by
  apply MvPolynomial.algHom_ext
  intro x
  by_cases hxR : x ∈ R
  · let r : ↥R := ⟨x, hxR⟩
    have hxF : x ∈ F := hRF hxR
    rw [AlgHom.comp_apply, facetRestriction_X_mem L d a F hF hdet x hxF]
    have hcoord : (⟨x, hxF⟩ : ↥F) = finsetSubsetEmbedding hRF r := by
      apply Subtype.ext
      rfl
    rw [hcoord, parameterFaceAlgHomViaFacet_inverseCoordinate]
    symm
    change MvPolynomial.killCompl (R := L) (finsetValEmbedding R).injective
      (MvPolynomial.X x) = (MvPolynomial.X r : MvPolynomial ↥R L)
    exact SimplicialSphereAnisotropicity.Generic.killCompl_X_embedding (finsetValEmbedding R) r
  · have hxrange : x ∉ Set.range (finsetValEmbedding R) := by
      rintro ⟨r, hr⟩
      apply hxR
      rw [← hr]
      exact r.2
    have hright : ambientFaceRestriction L R (MvPolynomial.X x) = 0 := by
      exact SimplicialSphereAnisotropicity.Generic.killCompl_X_eq_zero
        (finsetValEmbedding R) x hxrange
    rw [hright]
    rw [AlgHom.comp_apply]
    by_cases hxF : x ∈ F
    · rw [facetRestriction_X_mem L d a F hF hdet x hxF]
      exact parameterFaceAlgHomViaFacet_inverseCoordinate_not_mem
        L d a R F hRF hF hdet ⟨x, hxF⟩ hxR
    · rw [facetRestriction_X_not_mem L d a F hF hdet x hxF,
        map_zero]

theorem parameterFaceAlgHomViaFacet_ker
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    RingHom.ker
        (parameterFaceAlgHomViaFacet L d a R F hRF hF hdet).toRingHom =
      (Ideal.span
        (MvPolynomial.X ''
          {i : ↥F | i ∉ Set.range (finsetSubsetEmbedding hRF)} :
          Set (MvPolynomial ↥F L))).comap
        (facetParameterAlgEquiv L d a F hF hdet).toRingEquiv.toRingHom := by
  ext p
  rw [RingHom.mem_ker, Ideal.mem_comap]
  change MvPolynomial.killCompl (finsetSubsetEmbedding hRF).injective
      (facetParameterAlgEquiv L d a F hF hdet p) = 0 ↔ _
  rw [← SimplicialSphereAnisotropicity.Algebra.ker_killCompl_eq_span_complement
      (finsetSubsetEmbedding hRF) (finsetSubsetEmbedding hRF).injective,
    RingHom.mem_ker]
  rfl

theorem finsetSubsetEmbedding_erase_complement
    {V : Type v} [DecidableEq V]
    (F : Finset V) (v : V) (hv : v ∈ F) :
    {i : ↥F | i ∉ Set.range
        (finsetSubsetEmbedding (F.erase_subset v))} =
      {(⟨v, hv⟩ : ↥F)} := by
  ext x
  change (x ∉ Set.range (finsetSubsetEmbedding (F.erase_subset v))) ↔
    x = (⟨v, hv⟩ : ↥F)
  constructor
  · intro hx
    apply Subtype.ext
    by_contra hxv
    apply hx
    refine ⟨⟨x.1, Finset.mem_erase.mpr ⟨hxv, x.2⟩⟩, ?_⟩
    apply Subtype.ext
    rfl
  · intro hx
    rintro ⟨y, hy⟩
    have hyv : y.1 = v := by
      have hval := congrArg Subtype.val hy
      exact hval.trans (congrArg Subtype.val hx)
    exact (Finset.mem_erase.mp y.2).1 hyv

theorem inverseCoordinate_dvd_of_eraseRestriction_eq_zero
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : V) (hv : v ∈ F) (p : ParameterPolynomial L d)
    (hp : parameterFaceAlgHomViaFacet L d a (F.erase v) F
        (F.erase_subset v) hF hdet p = 0) :
    inverseCoordinate L d a F hF hdet ⟨v, hv⟩ ∣ p := by
  have hpker : p ∈ RingHom.ker
      (parameterFaceAlgHomViaFacet L d a (F.erase v) F
        (F.erase_subset v) hF hdet).toRingHom := by
    exact (RingHom.mem_ker).mpr hp
  rw [parameterFaceAlgHomViaFacet_ker] at hpker
  rw [finsetSubsetEmbedding_erase_complement F v hv,
    Set.image_singleton] at hpker
  have hd : MvPolynomial.X (⟨v, hv⟩ : ↥F) ∣
      facetParameterAlgEquiv L d a F hF hdet p :=
    Ideal.mem_span_singleton.mp hpker
  rw [← map_dvd_iff (facetParameterAlgEquiv L d a F hF hdet)]
  simpa using hd

theorem inverseCoordinate_dvd_sub_of_erase_eq
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0)
    {v w : V} (hv : v ∈ F) (_hw : w ∈ G)
    (hFG : F.erase v = G.erase w)
    (r : ↥(F.erase v)) :
    inverseCoordinate L d a F hF hdetF ⟨v, hv⟩ ∣
      inverseCoordinate L d a F hF hdetF
          (finsetSubsetEmbedding (F.erase_subset v) r) -
        inverseCoordinate L d a G hG hdetG
          ⟨r.1, by
            have hr : r.1 ∈ G.erase w := by simpa [hFG] using r.2
            exact (Finset.mem_erase.mp hr).2⟩ := by
  let R := F.erase v
  have hRG : R ⊆ G := by
    intro x hx
    have hx' : x ∈ G.erase w := by simpa [R, hFG] using hx
    exact (Finset.mem_erase.mp hx').2
  let eF := finsetSubsetEmbedding (F.erase_subset v)
  let eG := finsetSubsetEmbedding hRG
  have hhom := parameterFaceAlgHomViaFacet_eq
    L d a R F G (F.erase_subset v) hRG hF hG hdetF hdetG
  have hzero : parameterFaceAlgHomViaFacet L d a R F
      (F.erase_subset v) hF hdetF
        (inverseCoordinate L d a F hF hdetF (eF r) -
          inverseCoordinate L d a G hG hdetG (eG r)) = 0 := by
    rw [map_sub, parameterFaceAlgHomViaFacet_inverseCoordinate]
    rw [hhom]
    rw [parameterFaceAlgHomViaFacet_inverseCoordinate, sub_self]
  have hd := inverseCoordinate_dvd_of_eraseRestriction_eq_zero
    L d a F hF hdetF v hv _ hzero
  change inverseCoordinate L d a F hF hdetF ⟨v, hv⟩ ∣
    inverseCoordinate L d a F hF hdetF (eF r) -
      inverseCoordinate L d a G hG hdetG (eG r) at hd
  have heF : finsetSubsetEmbedding (F.erase_subset v) r = eF r := rfl
  have heG :
      (⟨r.1, by
        have hr : r.1 ∈ G.erase w := by simpa [hFG] using r.2
        exact (Finset.mem_erase.mp hr).2⟩ : ↥G) = eG r := by
    apply Subtype.ext
    rfl
  rw [heF, heG]
  exact hd

theorem facetCramerPolynomial_dvd_inverseCoordinate_sub_of_erase_eq
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w)
    (r : ↥(F.erase v)) :
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ ∣
      inverseCoordinate L d a F hF hdetF
          (finsetSubsetEmbedding (F.erase_subset v) r) -
        inverseCoordinate L d a G hG hdetG
          ⟨r.1, by
            have hr : r.1 ∈ G.erase w := by simpa [hFG] using r.2
            exact (Finset.mem_erase.mp hr).2⟩ := by
  have hd := inverseCoordinate_dvd_sub_of_erase_eq
    L d a hF hG hdetF hdetG hv hw hFG r
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
    L d a F hF hdetF ⟨v, hv⟩]
  have hu : IsUnit
      (MvPolynomial.C (facetMatrix L d a F hF).det :
        ParameterPolynomial L d) :=
    (isUnit_iff_ne_zero.mpr hdetF).map MvPolynomial.C
  exact ((associated_unit_mul_left _ _ hu).dvd_iff_dvd_left).mpr hd

theorem facetCramerPolynomial_dvd_facetRestriction_sub_of_erase_eq
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0)
    {v w : V} (hv : v ∈ F) (_hw : w ∈ G)
    (hFG : F.erase v = G.erase w)
    (f : MvPolynomial V L) :
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ ∣
      facetRestriction L d a F hF hdetF f -
        facetRestriction L d a G hG hdetG f := by
  let R := F.erase v
  have hRG : R ⊆ G := by
    intro x hx
    have hx' : x ∈ G.erase w := by simpa [R, hFG] using hx
    exact (Finset.mem_erase.mp hx').2
  let ρF := parameterFaceAlgHomViaFacet L d a R F
    (F.erase_subset v) hF hdetF
  let ρG := parameterFaceAlgHomViaFacet L d a R G hRG hG hdetG
  have hhom : ρF = ρG := parameterFaceAlgHomViaFacet_eq
    L d a R F G (F.erase_subset v) hRG hF hG hdetF hdetG
  have hcompF := parameterFaceAlgHomViaFacet_comp_facetRestriction
    L d a R F (F.erase_subset v) hF hdetF
  have hcompG := parameterFaceAlgHomViaFacet_comp_facetRestriction
    L d a R G hRG hG hdetG
  have hfirst : ρF (facetRestriction L d a F hF hdetF f) =
      ambientFaceRestriction L R f :=
    congrArg (fun h : MvPolynomial V L →ₐ[L] MvPolynomial ↥R L ↦ h f)
      hcompF
  have hsecond : ρF (facetRestriction L d a G hG hdetG f) =
      ambientFaceRestriction L R f := by
    rw [hhom]
    exact congrArg
      (fun h : MvPolynomial V L →ₐ[L] MvPolynomial ↥R L ↦ h f) hcompG
  have hzero : ρF
      (facetRestriction L d a F hF hdetF f -
        facetRestriction L d a G hG hdetG f) = 0 := by
    rw [map_sub, hfirst, hsecond, sub_self]
  have hd := inverseCoordinate_dvd_of_eraseRestriction_eq_zero
    L d a F hF hdetF v hv _ hzero
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
    L d a F hF hdetF ⟨v, hv⟩]
  have hu : IsUnit
      (MvPolynomial.C (facetMatrix L d a F hF).det :
        ParameterPolynomial L d) :=
    (isUnit_iff_ne_zero.mpr hdetF).map MvPolynomial.C
  exact ((associated_unit_mul_left _ _ hu).dvd_iff_dvd_left).mpr hd

noncomputable def facetFaceCoordinateProduct
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    ParameterPolynomial L d :=
  ∏ r : ↥R,
    inverseCoordinate L d a F hF hdet (finsetSubsetEmbedding hRF r)

theorem facetRestriction_faceProduct_subset
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (R F : Finset V) (hRF : R ⊆ F)
    (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    facetRestriction L d a F hF hdet
        (∏ x ∈ R, MvPolynomial.X x) =
      facetFaceCoordinateProduct L d a R F hRF hF hdet := by
  rw [map_prod]
  apply Finset.prod_bij
      (fun x hx ↦ (⟨x, hx⟩ : ↥R))
  · intro x hx
    simp
  · intro x₁ hx₁ x₂ hx₂ heq
    exact congrArg Subtype.val heq
  · intro r _hr
    exact ⟨r.1, r.2, rfl⟩
  · intro x hx
    exact facetRestriction_X_mem L d a F hF hdet x (hRF hx)

theorem facetEuler_eq_cramer_mul_faceCoordinateProduct_erase
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : V) (hv : v ∈ F) :
    facetEuler L d a F hF hdet =
      facetCramerPolynomial L d a F hF ⟨v, hv⟩ *
        facetFaceCoordinateProduct L d a (F.erase v) F
          (F.erase_subset v) hF hdet := by
  have hmonomial := Finset.mul_prod_erase F
    (fun x : V ↦ (MvPolynomial.X x : MvPolynomial V L)) hv
  have hrestricted := congrArg (facetRestriction L d a F hF hdet) hmonomial
  rw [map_mul, facetRestriction_X_mem L d a F hF hdet v hv,
    facetRestriction_faceProduct_subset L d a (F.erase v) F
      (F.erase_subset v) hF hdet,
    facetRestriction_faceProduct] at hrestricted
  rw [facetEuler,
    ← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F hF hdet ⟨v, hv⟩]
  rw [← hrestricted]
  ring

theorem facetCramerPolynomial_dvd_faceCoordinateProduct_sub_of_erase_eq
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w) :
    let R := F.erase v
    let hRG : R ⊆ G := by
      intro x hx
      apply Finset.mem_of_mem_erase
      rw [← hFG]
      exact hx
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ ∣
      facetFaceCoordinateProduct L d a R F
          (F.erase_subset v) hF hdetF -
        facetFaceCoordinateProduct L d a R G hRG hG hdetG := by
  dsimp only
  let R := F.erase v
  have hRG : R ⊆ G := by
    intro x hx
    have hx' : x ∈ G.erase w := by simpa [R, hFG] using hx
    exact Finset.mem_of_mem_erase hx'
  have hd := facetCramerPolynomial_dvd_facetRestriction_sub_of_erase_eq
    L d a hF hG hdetF hdetG hv hw hFG
      (∏ x ∈ R, MvPolynomial.X x)
  rw [facetRestriction_faceProduct_subset,
    facetRestriction_faceProduct_subset] at hd
  convert hd using 1

theorem facetCramerPolynomial_dvd_crossNumerator_of_erase_eq
    (L : Type u) [Field L] [CharP L 2]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    (hdetF : (facetMatrix L d a F hF).det ≠ 0)
    (hdetG : (facetMatrix L d a G hG).det ≠ 0)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F.erase v = G.erase w)
    (f : MvPolynomial V L) :
    let R := F.erase v
    let hRG : R ⊆ G := by
      intro x hx
      apply Finset.mem_of_mem_erase
      rw [← hFG]
      exact hx
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ ∣
      facetRestriction L d a F hF hdetF f *
          facetFaceCoordinateProduct L d a R G hRG hG hdetG +
        facetRestriction L d a G hG hdetG f *
          facetFaceCoordinateProduct L d a R F
            (F.erase_subset v) hF hdetF := by
  dsimp only
  let R := F.erase v
  have hRG : R ⊆ G := by
    intro x hx
    have hx' : x ∈ G.erase w := by simpa [R, hFG] using hx
    exact Finset.mem_of_mem_erase hx'
  let q := facetCramerPolynomial L d a F hF ⟨v, hv⟩
  let bF := facetRestriction L d a F hF hdetF f
  let bG := facetRestriction L d a G hG hdetG f
  let tF := facetFaceCoordinateProduct L d a R F
    (F.erase_subset v) hF hdetF
  let tG := facetFaceCoordinateProduct L d a R G hRG hG hdetG
  have hb : q ∣ bF - bG :=
    facetCramerPolynomial_dvd_facetRestriction_sub_of_erase_eq
      L d a hF hG hdetF hdetG hv hw hFG f
  have ht : q ∣ tF - tG := by
    simpa [q, tF, tG, R, hRG] using
      (facetCramerPolynomial_dvd_faceCoordinateProduct_sub_of_erase_eq
        L d a hF hG hdetF hdetG hv hw hFG)
  change q ∣ bF * tG + bG * tF
  rw [← CharTwo.sub_eq_add]
  convert dvd_sub (hb.mul_right tG) (ht.mul_left bG) using 1
  ring

end SimplicialSphereAnisotropicity.Generic.Brion

end

end

section

/-!
# Global ridge incidences and factorwise Brion poles

This module packages ridge--facet incidences, the fixed-point-free ridge flip,
irreducibility and facetwise uniqueness of Cramer coordinate factors, and the
induced fixed-point-free involution on the facets having a prescribed
irreducible denominator factor.  These are the finite combinatorial and UFD
ingredients for global factorwise Brion pole cancellation.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

abbrev RidgeOfCard
    {V : Type u} (D : AbstractSimplicialComplex V) (d : ℕ) :=
  {R : Finset V // R ∈ D ∧ R.card + 1 = d}

abbrev IncidentFacet
    {V : Type u} (D : AbstractSimplicialComplex V) (d : ℕ)
    (R : RidgeOfCard D d) :=
  {F : FacetOfCard D d // R.1 ⊆ F.1}

abbrev RidgeFacetIncidence
    {V : Type u} (D : AbstractSimplicialComplex V) (d : ℕ) :=
  Σ R : RidgeOfCard D d, IncidentFacet D d R

noncomputable instance ridgeOfCardFintype
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ) :
    Fintype (RidgeOfCard D d) :=
  Fintype.ofFinite _

noncomputable instance incidentFacetFintype
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (R : RidgeOfCard D d) : Fintype (IncidentFacet D d R) :=
  Fintype.ofFinite _

def incidentFacetEquivSetSubtype
    {V : Type u}
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (R : RidgeOfCard D d) :
    IncidentFacet D d R ≃
      {F : Finset V // F ∈ D ∧ F.card = d ∧ R.1 ⊆ F} where
  toFun F := ⟨F.1.1, F.1.2.1, F.1.2.2, F.2⟩
  invFun F := ⟨⟨F.1, F.2.1, F.2.2.1⟩, F.2.2.2⟩
  left_inv _F := rfl
  right_inv _F := rfl

set_option linter.style.haveILetI false in
theorem card_incidentFacet_eq_two
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (R : RidgeOfCard D d) :
    Fintype.card (IncidentFacet D d R) = 2 := by
  let s : Set (Finset V) :=
    {F | F ∈ D ∧ F.card = d ∧ R.1 ⊆ F}
  letI : Fintype ↑s := Fintype.ofFinite _
  let e : IncidentFacet D d R ≃ ↑s :=
    incidentFacetEquivSetSubtype D d R
  rw [Fintype.card_congr e, Set.fintypeCard_eq_ncard]
  exact hpm.ridge_two R.2.1 R.2.2

noncomputable def otherOfCardTwo
    {alpha : Type u} [Fintype alpha]
    (hcard : Fintype.card alpha = 2) (x : alpha) : alpha :=
  Classical.choose ((Nat.card_eq_two_iff' x).mp
    (Nat.card_eq_fintype_card.trans hcard))

theorem otherOfCardTwo_ne
    {alpha : Type u} [Fintype alpha]
    (hcard : Fintype.card alpha = 2) (x : alpha) :
    otherOfCardTwo hcard x ≠ x :=
  (Classical.choose_spec ((Nat.card_eq_two_iff' x).mp
    (Nat.card_eq_fintype_card.trans hcard))).1

theorem otherOfCardTwo_other
    {alpha : Type u} [Fintype alpha]
    (hcard : Fintype.card alpha = 2) (x : alpha) :
    otherOfCardTwo hcard (otherOfCardTwo hcard x) = x := by
  let y := otherOfCardTwo hcard x
  have hxy : x ≠ y := (otherOfCardTwo_ne hcard x).symm
  exact ((Classical.choose_spec ((Nat.card_eq_two_iff' y).mp
    (Nat.card_eq_fintype_card.trans hcard))).2 x hxy).symm

noncomputable def ridgeFlip
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (x : RidgeFacetIncidence D d) : RidgeFacetIncidence D d :=
  ⟨x.1, otherOfCardTwo (card_incidentFacet_eq_two D d hpm x.1) x.2⟩

@[simp]
theorem ridgeFlip_fst
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (x : RidgeFacetIncidence D d) :
    (ridgeFlip D d hpm x).1 = x.1 := rfl

theorem ridgeFlip_ne
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (x : RidgeFacetIncidence D d) :
    ridgeFlip D d hpm x ≠ x := by
  rcases x with ⟨R, F⟩
  intro h
  apply otherOfCardTwo_ne (card_incidentFacet_eq_two D d hpm R) F
  exact eq_of_heq (Sigma.ext_iff.mp h).2

theorem ridgeFlip_involutive
    {V : Type u} [Fintype V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d) :
    Function.Involutive (ridgeFlip D d hpm) := by
  rintro ⟨R, F⟩
  rw [Sigma.ext_iff]
  exact ⟨rfl, heq_of_eq
    (otherOfCardTwo_other (card_incidentFacet_eq_two D d hpm R) F)⟩

theorem exists_facetExtraVertex
    {V : Type u} [Fintype V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card) :
    ∃ x : V, x ∈ F ∧ x ∉ R := by
  have hnsub : ¬F ⊆ R := by
    intro hFR
    have heq : R = F := Finset.Subset.antisymm hRF hFR
    rw [heq] at hcard
    omega
  exact Finset.not_subset.mp hnsub

noncomputable def facetExtraVertex
    {V : Type u} [Fintype V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card) : V :=
  Classical.choose (exists_facetExtraVertex R F hRF hcard)

theorem facetExtraVertex_mem
    {V : Type u} [Fintype V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card) :
    facetExtraVertex R F hRF hcard ∈ F :=
  (Classical.choose_spec (exists_facetExtraVertex R F hRF hcard)).1

theorem facetExtraVertex_not_mem
    {V : Type u} [Fintype V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card) :
    facetExtraVertex R F hRF hcard ∉ R :=
  (Classical.choose_spec (exists_facetExtraVertex R F hRF hcard)).2

theorem erase_facetExtraVertex
    {V : Type u} [Fintype V] [DecidableEq V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card) :
    F.erase (facetExtraVertex R F hRF hcard) = R := by
  classical
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro y hy
    exact Finset.mem_erase.mpr ⟨by
      intro hyx
      apply facetExtraVertex_not_mem R F hRF hcard
      simpa only [hyx] using hy, hRF hy⟩
  · rw [Finset.card_erase_of_mem
      (facetExtraVertex_mem R F hRF hcard)]
    omega

theorem facetExtraVertex_unique
    {V : Type u} [Fintype V] [DecidableEq V]
    (R F : Finset V) (hRF : R ⊆ F)
    (hcard : R.card + 1 = F.card)
    {x : V} (hxF : x ∈ F) (hxR : x ∉ R) :
    facetExtraVertex R F hRF hcard = x := by
  classical
  by_contra hne
  apply hxR
  rw [← erase_facetExtraVertex R F hRF hcard]
  exact Finset.mem_erase.mpr ⟨Ne.symm hne,
    hxF⟩

noncomputable def incidenceExtraVertex
    {V : Type u} [Fintype V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    (x : RidgeFacetIncidence D d) : V :=
  facetExtraVertex x.1.1 x.2.1.1 x.2.2
    (x.1.2.2.trans x.2.1.2.2.symm)

theorem incidenceExtraVertex_mem
    {V : Type u} [Fintype V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    (x : RidgeFacetIncidence D d) :
    incidenceExtraVertex x ∈ x.2.1.1 :=
  facetExtraVertex_mem x.1.1 x.2.1.1 x.2.2
    (x.1.2.2.trans x.2.1.2.2.symm)

theorem incidenceExtraVertex_not_mem
    {V : Type u} [Fintype V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    (x : RidgeFacetIncidence D d) :
    incidenceExtraVertex x ∉ x.1.1 :=
  facetExtraVertex_not_mem x.1.1 x.2.1.1 x.2.2
    (x.1.2.2.trans x.2.1.2.2.symm)

theorem incidenceExtraVertex_erase
    {V : Type u} [Fintype V] [DecidableEq V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    (x : RidgeFacetIncidence D d) :
    x.2.1.1.erase (incidenceExtraVertex x) = x.1.1 :=
  erase_facetExtraVertex x.1.1 x.2.1.1 x.2.2
    (x.1.2.2.trans x.2.1.2.2.symm)

noncomputable def incidenceCramerPolynomial
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (x : RidgeFacetIncidence D d) : ParameterPolynomial L d :=
  facetCramerPolynomial L d a x.2.1.1 x.2.1.2.2
    ⟨incidenceExtraVertex x, incidenceExtraVertex_mem x⟩

theorem incidenceCramerPolynomial_flip
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (x : RidgeFacetIncidence D d) :
    incidenceCramerPolynomial L d a (ridgeFlip D d hpm x) =
      incidenceCramerPolynomial L d a x := by
  let y := ridgeFlip D d hpm x
  have herase :
      y.2.1.1.erase (incidenceExtraVertex y) =
        x.2.1.1.erase (incidenceExtraVertex x) := by
    rw [incidenceExtraVertex_erase, incidenceExtraVertex_erase]
    rfl
  exact facetCramerPolynomial_eq_of_erase_eq L d a
    y.2.1.2.2 x.2.1.2.2
    (incidenceExtraVertex_mem y) (incidenceExtraVertex_mem x) herase

noncomputable def incidenceFacetRestriction
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (x : RidgeFacetIncidence D d) : ParameterPolynomial L d :=
  facetRestriction L d a x.2.1.1 x.2.1.2.2 (ha x.2.1) f

noncomputable def incidenceTangentialProduct
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (x : RidgeFacetIncidence D d) : ParameterPolynomial L d :=
  facetFaceCoordinateProduct L d a x.1.1 x.2.1.1 x.2.2
    x.2.1.2.2 (ha x.2.1)

theorem incidenceCramerPolynomial_dvd_crossNumerator_flip
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L)
    (x : RidgeFacetIncidence D d) :
    incidenceCramerPolynomial L d a x ∣
      incidenceFacetRestriction L d a ha f x *
          incidenceTangentialProduct L d a ha (ridgeFlip D d hpm x) +
        incidenceFacetRestriction L d a ha f (ridgeFlip D d hpm x) *
          incidenceTangentialProduct L d a ha x := by
  let y := ridgeFlip D d hpm x
  have herase :
      x.2.1.1.erase (incidenceExtraVertex x) =
        y.2.1.1.erase (incidenceExtraVertex y) := by
    rw [incidenceExtraVertex_erase, incidenceExtraVertex_erase]
    rfl
  have h := facetCramerPolynomial_dvd_crossNumerator_of_erase_eq
    L d a x.2.1.2.2 y.2.1.2.2 (ha x.2.1) (ha y.2.1)
    (incidenceExtraVertex_mem x) (incidenceExtraVertex_mem y) herase f
  simpa only [incidenceCramerPolynomial, incidenceFacetRestriction,
    incidenceTangentialProduct, incidenceExtraVertex_erase,
    ridgeFlip_fst, y] using h

theorem inverseCoordinate_irreducible
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    Irreducible (inverseCoordinate L d a F hF hdet v) := by
  apply Irreducible.of_map
    (f := facetParameterAlgEquiv L d a F hF hdet)
  rw [facetParameterAlgEquiv_inverseCoordinate]
  exact (MvPolynomial.X_prime (R := L) (i := v)).irreducible

theorem facetCramerPolynomial_irreducible
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    Irreducible (facetCramerPolynomial L d a F hF v) := by
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
    L d a F hF hdet v]
  exact (irreducible_isUnit_mul
    ((isUnit_iff_ne_zero.mpr hdet).map
      (MvPolynomial.C : L →+* ParameterPolynomial L d))).2
      (inverseCoordinate_irreducible L d a F hF hdet v)

theorem facetCramerPolynomial_prime
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    Prime (facetCramerPolynomial L d a F hF v) :=
  (facetCramerPolynomial_irreducible L d a F hF hdet v).prime

theorem inverseCoordinate_dvd_iff
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v w : ↥F) :
    inverseCoordinate L d a F hF hdet v ∣
        inverseCoordinate L d a F hF hdet w ↔
      v = w := by
  rw [← map_dvd_iff (facetParameterAlgEquiv L d a F hF hdet),
    facetParameterAlgEquiv_inverseCoordinate,
    facetParameterAlgEquiv_inverseCoordinate,
    MvPolynomial.X_dvd_X]

theorem facetCramerPolynomial_dvd_iff
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v w : ↥F) :
    facetCramerPolynomial L d a F hF v ∣
        facetCramerPolynomial L d a F hF w ↔
      v = w := by
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F hF hdet v,
    ← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F hF hdet w,
    mul_dvd_mul_iff_left (MvPolynomial.C_ne_zero.mpr hdet),
    inverseCoordinate_dvd_iff]

theorem facetCramerPolynomial_factor_unique
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    {q : ParameterPolynomial L d} (hq : Irreducible q)
    {v w : ↥F}
    (hqv : q ∣ facetCramerPolynomial L d a F hF v)
    (hqw : q ∣ facetCramerPolynomial L d a F hF w) :
    v = w := by
  apply (facetCramerPolynomial_dvd_iff L d a F hF hdet v w).mp
  have hv := hq.associated_of_dvd
    (facetCramerPolynomial_irreducible L d a F hF hdet v) hqv
  have hw := hq.associated_of_dvd
    (facetCramerPolynomial_irreducible L d a F hF hdet w) hqw
  exact (hv.symm.trans hw).dvd

theorem facetCramerPolynomial_congr
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    {F G : Finset V} (hF : F.card = d) (hG : G.card = d)
    {v w : V} (hv : v ∈ F) (hw : w ∈ G)
    (hFG : F = G) (hvw : v = w) :
    facetCramerPolynomial L d a F hF ⟨v, hv⟩ =
      facetCramerPolynomial L d a G hG ⟨w, hw⟩ := by
  subst G
  subst w
  rfl

abbrev IrreduciblePoleIncidence
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d) :=
  {x : RidgeFacetIncidence D d //
    q ∣ incidenceCramerPolynomial L d a x}

noncomputable instance irreduciblePoleIncidenceFintype
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d) :
    Fintype (IrreduciblePoleIncidence L D d a q) :=
  Fintype.ofFinite _

noncomputable def irreduciblePoleFlip
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d)
    (x : IrreduciblePoleIncidence L D d a q) :
    IrreduciblePoleIncidence L D d a q :=
  ⟨ridgeFlip D d hpm x.1, by
    rw [incidenceCramerPolynomial_flip L D d hpm a]
    exact x.2⟩

@[simp]
theorem irreduciblePoleFlip_val
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d)
    (x : IrreduciblePoleIncidence L D d a q) :
    (irreduciblePoleFlip L D d hpm a q x).1 =
      ridgeFlip D d hpm x.1 := rfl

theorem irreduciblePoleFlip_ne
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d)
    (x : IrreduciblePoleIncidence L D d a q) :
    irreduciblePoleFlip L D d hpm a q x ≠ x := by
  intro h
  exact ridgeFlip_ne D d hpm x.1 (congrArg Subtype.val h)

theorem irreduciblePoleFlip_involutive
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (q : ParameterPolynomial L d) :
    Function.Involutive
      (irreduciblePoleFlip L D d hpm a q) := by
  intro x
  apply Subtype.ext
  exact ridgeFlip_involutive D d hpm x.1

def irreduciblePoleFacet
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    {a : Matrix (Fin d) V L}
    {q : ParameterPolynomial L d}
    (x : IrreduciblePoleIncidence L D d a q) : FacetOfCard D d :=
  x.1.2.1

theorem ridgeFacetIncidence_eq_of_facet_eq_of_extra_eq
    {V : Type u} [Fintype V] [DecidableEq V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    {x y : RidgeFacetIncidence D d}
    (hF : x.2.1 = y.2.1)
    (hv : incidenceExtraVertex x = incidenceExtraVertex y) :
    x = y := by
  have hRval : x.1.1 = y.1.1 := by
    calc
      x.1.1 = x.2.1.1.erase (incidenceExtraVertex x) :=
        (incidenceExtraVertex_erase x).symm
      _ = y.2.1.1.erase (incidenceExtraVertex y) := by rw [hF, hv]
      _ = y.1.1 := incidenceExtraVertex_erase y
  have hR : x.1 = y.1 := Subtype.ext hRval
  rw [Sigma.ext_iff]
  refine ⟨hR, ?_⟩
  rw [Subtype.heq_iff_coe_eq (by
    intro F
    rw [hRval])]
  exact hF

theorem irreduciblePoleFacet_injective
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    {D : AbstractSimplicialComplex V} {d : ℕ}
    {a : Matrix (Fin d) V L}
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    {q : ParameterPolynomial L d} (hq : Irreducible q) :
    Function.Injective
      (irreduciblePoleFacet L (D := D) (d := d) (a := a) (q := q)) := by
  intro x y hF
  apply Subtype.ext
  apply ridgeFacetIncidence_eq_of_facet_eq_of_extra_eq hF
  have hqx := x.2
  have hqy := y.2
  change x.1.2.1 = y.1.2.1 at hF
  change q ∣ facetCramerPolynomial L d a
    x.1.2.1.1 x.1.2.1.2.2
      ⟨incidenceExtraVertex x.1, incidenceExtraVertex_mem x.1⟩ at hqx
  change q ∣ facetCramerPolynomial L d a
    y.1.2.1.1 y.1.2.1.2.2
      ⟨incidenceExtraVertex y.1, incidenceExtraVertex_mem y.1⟩ at hqy
  let wy : ↥x.1.2.1.1 := ⟨incidenceExtraVertex y.1, by
    rw [hF]
    exact incidenceExtraVertex_mem y.1⟩
  have hpoly : facetCramerPolynomial L d a
      x.1.2.1.1 x.1.2.1.2.2 wy =
      facetCramerPolynomial L d a
        y.1.2.1.1 y.1.2.1.2.2
          ⟨incidenceExtraVertex y.1, incidenceExtraVertex_mem y.1⟩ := by
    apply facetCramerPolynomial_congr L d a
    · exact congrArg (fun F : FacetOfCard D d ↦ F.1) hF
    · rfl
  rw [← hpoly] at hqy
  have hv := facetCramerPolynomial_factor_unique L d a
    x.1.2.1.1 x.1.2.1.2.2 (ha x.1.2.1) hq hqx hqy
  exact congrArg Subtype.val hv

abbrev IrreduciblePoleFacet
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) :=
  {F : FacetOfCard D d //
    q ∣ facetEuler L d a F.1 F.2.2 (ha F)}

noncomputable instance irreduciblePoleFacetFintype
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) :
    Fintype (IrreduciblePoleFacet L D d a ha q) :=
  Fintype.ofFinite _

noncomputable def irreduciblePoleIncidenceToFacet
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d)
    (x : IrreduciblePoleIncidence L D d a q) :
    IrreduciblePoleFacet L D d a ha q :=
  ⟨x.1.2.1, by
    have hx := x.2
    change q ∣ facetCramerPolynomial L d a
      x.1.2.1.1 x.1.2.1.2.2
        ⟨incidenceExtraVertex x.1, incidenceExtraVertex_mem x.1⟩ at hx
    rw [facetEuler_eq_cramer_mul_faceCoordinateProduct_erase L d a
      x.1.2.1.1 x.1.2.1.2.2 (ha x.1.2.1)
      (incidenceExtraVertex x.1) (incidenceExtraVertex_mem x.1)]
    exact hx.mul_right _⟩

theorem irreduciblePoleIncidenceToFacet_injective
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    {q : ParameterPolynomial L d} (hq : Irreducible q) :
    Function.Injective
      (irreduciblePoleIncidenceToFacet L D d a ha q) := by
  intro x y h
  apply irreduciblePoleFacet_injective L ha hq
  exact congrArg Subtype.val h

theorem irreduciblePoleIncidenceToFacet_surjective
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    {q : ParameterPolynomial L d} (hq : Irreducible q) :
    Function.Surjective
      (irreduciblePoleIncidenceToFacet L D d a ha q) := by
  intro F
  have hEuler := F.2
  rw [facetEuler] at hEuler
  have hCunit : IsUnit
      (MvPolynomial.C
        (facetMatrix L d a F.1.1 F.1.2.2).det :
          ParameterPolynomial L d) :=
    (isUnit_iff_ne_zero.mpr (ha F.1)).map MvPolynomial.C
  have hprod : q ∣ ∏ v : ↥F.1.1,
      inverseCoordinate L d a F.1.1 F.1.2.2 (ha F.1) v := by
    rcases hq.prime.dvd_or_dvd hEuler with hqC | hqprod
    · exact (hq.not_isUnit (isUnit_of_dvd_unit hqC hCunit)).elim
    · exact hqprod
  obtain ⟨v, _hv, hqv⟩ := hq.prime.exists_mem_finset_dvd hprod
  have hqcr : q ∣ facetCramerPolynomial L d a
      F.1.1 F.1.2.2 v := by
    rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
      L d a F.1.1 F.1.2.2 (ha F.1) v]
    exact hqv.mul_left _
  have hRcard : (F.1.1.erase v.1).card + 1 = d := by
    rw [Finset.card_erase_of_mem v.2, F.1.2.2]
    omega
  have hRne : (F.1.1.erase v.1).Nonempty := by
    apply Finset.card_pos.mp
    rw [Finset.card_erase_of_mem v.2, F.1.2.2]
    omega
  have hRmem : F.1.1.erase v.1 ∈ D :=
    (D.toPreAbstractSimplicialComplex.isRelLowerSet_faces F.1.2.1).2
      (Finset.erase_subset _ _) hRne
  let R : RidgeOfCard D d :=
    ⟨F.1.1.erase v.1, hRmem, hRcard⟩
  let x : RidgeFacetIncidence D d :=
    ⟨R, ⟨F.1, Finset.erase_subset _ _⟩⟩
  have hextra : incidenceExtraVertex x = v.1 := by
    apply facetExtraVertex_unique
    · exact v.2
    · change v.1 ∉ F.1.1.erase v.1
      intro hv'
      exact (Finset.mem_erase.mp hv').1 rfl
  let px : IrreduciblePoleIncidence L D d a q := ⟨x, by
    change q ∣ facetCramerPolynomial L d a
      x.2.1.1 x.2.1.2.2
        ⟨incidenceExtraVertex x, incidenceExtraVertex_mem x⟩
    simpa only [x, hextra] using hqcr⟩
  refine ⟨px, ?_⟩
  apply Subtype.ext
  rfl

noncomputable def irreduciblePoleIncidenceEquivFacet
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q) :
    IrreduciblePoleIncidence L D d a q ≃
      IrreduciblePoleFacet L D d a ha q :=
  Equiv.ofBijective
    (irreduciblePoleIncidenceToFacet L D d a ha q)
    ⟨irreduciblePoleIncidenceToFacet_injective L D d a ha hq,
      irreduciblePoleIncidenceToFacet_surjective L D d hd a ha hq⟩

noncomputable def irreduciblePoleFacetFlip
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : IrreduciblePoleFacet L D d a ha q) :
    IrreduciblePoleFacet L D d a ha q :=
  let e := irreduciblePoleIncidenceEquivFacet L D d hd a ha q hq
  e (irreduciblePoleFlip L D d hpm a q (e.symm F))

theorem irreduciblePoleFacetFlip_ne
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q)
    (F : IrreduciblePoleFacet L D d a ha q) :
    irreduciblePoleFacetFlip L D d hd hpm a ha q hq F ≠ F := by
  let e := irreduciblePoleIncidenceEquivFacet L D d hd a ha q hq
  intro h
  apply irreduciblePoleFlip_ne L D d hpm a q (e.symm F)
  apply e.injective
  simpa only [irreduciblePoleFacetFlip, e, e.apply_symm_apply] using h

theorem irreduciblePoleFacetFlip_involutive
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (q : ParameterPolynomial L d) (hq : Irreducible q) :
    Function.Involutive
      (irreduciblePoleFacetFlip L D d hd hpm a ha q hq) := by
  let e := irreduciblePoleIncidenceEquivFacet L D d hd a ha q hq
  intro F
  change e (irreduciblePoleFlip L D d hpm a q
      (e.symm (e (irreduciblePoleFlip L D d hpm a q (e.symm F))))) =
    F
  rw [e.symm_apply_apply,
    irreduciblePoleFlip_involutive L D d hpm a q,
    e.apply_symm_apply]

end SimplicialSphereAnisotropicity.Generic.Brion

end

