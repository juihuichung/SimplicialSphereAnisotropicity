    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ)
    (Q : Submodule (MvPolynomial (Fin d) K)
      (Fin N → MvPolynomial (Fin d) K))
    {p : Fin N → MvPolynomial (Fin d) K}
