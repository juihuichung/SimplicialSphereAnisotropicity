section

noncomputable section

open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V]

theorem quasiIso_g_of_shortExact_of_acyclic_left
    (K : Type v) [Field K]
    (S : ShortComplex (ChainComplex (ModuleCat K) ℕ))
    (hS : S.ShortExact) (hA : S.X₁.Acyclic) : QuasiIso S.g := by
  rw [quasiIso_iff]
  intro q
  rw [quasiIsoAt_iff_isIso_homologyMap]
  let gq := HomologicalComplex.homologyMap S.g q
  have : Mono gq := by
    apply (hS.homology_exact₂ q).mono_g
    exact (hA q).isZero_homology.eq_of_src _ _
  have : Epi gq := by
    rcases q with _ | q
    · have := hS.epi_g
      exact HomologicalComplex.epi_homologyMap_of_epi_of_not_rel S.g 0 (by simp)
    · apply (hS.homology_exact₃ (q + 1) q (by simp)).epi_f
      exact (hA q).isZero_homology.eq_of_tgt _ _
  exact isIso_of_mono_of_epi gq

theorem relativeProjectionQuasiIso
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m)) (hF : F ∈ D) (hFne : F.Nonempty) :
    QuasiIso (relativeProjection K (AugmentedComplex.ofAbstract D) F) := by
  apply quasiIso_g_of_shortExact_of_acyclic_left K
    (costarRelativeShortComplex K (AugmentedComplex.ofAbstract D) F hFne)
    (costarRelativeShortExact K (AugmentedComplex.ofAbstract D) F hFne)
  exact costarFaceChainAcyclic K D hD F hF hFne

noncomputable def relativeProjectionHomologyIso
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m)) (hF : F ∈ D) (hFne : F.Nonempty)
    (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofAbstract D)).homology q ≅
      (relativeFaceChainComplex K (AugmentedComplex.ofAbstract D) F).homology q := by
  letI : QuasiIso
      (relativeProjection K (AugmentedComplex.ofAbstract D) F) :=
    relativeProjectionQuasiIso K D hD F hF hFne
  exact isoOfQuasiIsoAt
    (relativeProjection K (AugmentedComplex.ofAbstract D) F) q

noncomputable def relativeRestrictionHomologyIsoPositive
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V)
    (a : ℕ) (ha : 0 < a) :
    (relativeShiftedRestriction K (relativeFaceChainComplexDown' K C F)
        F.card).homology a ≅
      (relativeFaceChainComplex K C F).homology (F.card + a) := by
  let Q := relativeFaceChainComplexDown' K C F
  let e := relativeLeftShiftEmbedding F.card
  exact Q.restrictionHomologyIso e
    (a + 1) a (a - 1)
    (by
      apply (ComplexShape.down' (1 : ℕ)).prev_eq'
      rfl)
    (by
      apply (ComplexShape.down' (1 : ℕ)).next_eq'
      change a - 1 + 1 = a
      omega)
    rfl rfl rfl
    (by
      apply (ComplexShape.down' (1 : ℕ)).prev_eq'
      change F.card + a + 1 = F.card + (a + 1)
      omega)
    (by
      apply (ComplexShape.down' (1 : ℕ)).next_eq'
      change F.card + (a - 1) + 1 = F.card + a
      omega)

noncomputable def relativeHomologyIsoLinkPositive
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    (a : ℕ) (ha : 0 < a) :
    (relativeFaceChainComplex K C F).homology (F.card + a) ≅
      (faceChainComplex K (C.link F hF)).homology a :=
  (relativeRestrictionHomologyIsoPositive K C F a ha).symm ≪≫
    HomologicalComplex.homologyMapIso
      (relativeRestrictionLinkIso K C F hF) a

noncomputable def relativeHomologyIsoLink
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    (hFne : F.Nonempty) (a : ℕ) :
    (relativeFaceChainComplex K C F).homology (F.card + a) ≅
      (faceChainComplex K (C.link F hF)).homology a := by
  rcases a with _ | a
  · simpa using relativeHomologyCardIsoLinkZero K C F hF hFne
  · exact relativeHomologyIsoLinkPositive K C F hF (a + 1) (by omega)

noncomputable def simplicialSphereLinkHomologyIsoNonempty
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ AugmentedComplex.ofAbstract D) (hFne : F.Nonempty)
    (a : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofAbstract D)).homology
        (F.card + a) ≅
      (faceChainComplex K
        ((AugmentedComplex.ofAbstract D).link F hF)).homology a :=
  relativeProjectionHomologyIso K D hD F
      ((AugmentedComplex.nonempty_mem_ofAbstract_iff D hFne).mp hF)
      hFne (F.card + a) ≪≫
    relativeHomologyIsoLink K (AugmentedComplex.ofAbstract D) F hF hFne a

theorem simplicialSphereHomology_finrank
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) (q : ℕ) :
    Module.finrank K
        ((faceChainComplex K (AugmentedComplex.ofAbstract D)).homology q) =
      if q = n + 1 then 1 else 0 := by
  by_cases hq : q = n + 1
  · subst q
    rw [if_pos rfl]
    simpa using
      (simplicialSphereTopHomologyIso K D hD).toLinearEquiv.finrank_eq
  · rw [if_neg hq]
    let hzero := simplicialSphereHomology_isZero K D hD q hq
    let _ : Subsingleton
        ((faceChainComplex K
          (AugmentedComplex.ofAbstract D)).homology q) :=
      ModuleCat.subsingleton_of_isZero hzero
    exact Module.finrank_zero_of_subsingleton

theorem link_empty (C : AugmentedComplex V) :
    C.link ∅ C.empty_mem = C := by
  apply AugmentedComplex.ext
  ext G
  simp

theorem faceHomologyFinrank_congr
    (K : Type v) [Field K] [CharP K 2]
    {C C' : AugmentedComplex V} (e : C = C') (a : ℕ) :
    Module.finrank K ((faceChainComplex K C).homology a) =
      Module.finrank K ((faceChainComplex K C').homology a) := by
  subst C'
  rfl

def IsAllLinkHomologySphere (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ) : Prop :=
  ∀ (F : Finset V) (hF : F ∈ C) (a : ℕ),
    Module.finrank K ((faceChainComplex K (C.link F hF)).homology a) =
      if F.card + a = d then 1 else 0

theorem simplicialSphere_allLinkHomologySphere
    (K : Type v) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    IsAllLinkHomologySphere K (AugmentedComplex.ofAbstract D) (n + 1) := by
  intro F hF a
  by_cases hFempty : F = ∅
  · subst F
    have hlink :
        (AugmentedComplex.ofAbstract D).link ∅ hF =
          AugmentedComplex.ofAbstract D := by
      apply AugmentedComplex.ext
      ext G
      simp
    exact (faceHomologyFinrank_congr K hlink a).trans (by
      simpa using simplicialSphereHomology_finrank K D hD a)
  · have hFne : F.Nonempty := Finset.nonempty_iff_ne_empty.mpr hFempty
    have e := simplicialSphereLinkHomologyIsoNonempty
      K D hD F hF hFne a
    rw [← e.toLinearEquiv.finrank_eq]
    exact simplicialSphereHomology_finrank K D hD (F.card + a)

end SimplicialSphereAnisotropicity.Topology

end

