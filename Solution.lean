  Generic.ParameterRing k n m

private abbrev Model_ReductionGrading (k : Type u) [Field k] (n m : ℕ)
    (D : AbstractSimplicialComplex (Fin m)) :=
  FaceRingModel (K_ReductionGrading k n m) (AugmentedComplex.ofAbstract D)

private theorem coe_linearEquiv_ofEq_ReductionGrading
    {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    (p q : Submodule R M) (h : p = q) (x : p) :
    ((LinearEquiv.ofEq p q h x : q) : M) = x := by
  subst q
  rfl

set_option linter.style.haveILetI false in
theorem faceRingModelToReduction_mem_span_degree_of_homogeneous
    (k : Type u) [Field k] {n m N q : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (b : letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionGrading k n m) (Model_ReductionGrading k n m D))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous (K_ReductionGrading k n m)
      (AugmentedComplex.ofAbstract D) (r i) (b i))
    (z : Model_ReductionGrading k n m D)
    (hz : FaceRingModelHomogeneous (K_ReductionGrading k n m)
      (AugmentedComplex.ofAbstract D) q z) :
    faceRingModelToReduction k D z ∈
      Submodule.span (K_ReductionGrading k n m)
        (Set.range fun i : DegreeIndex r q ↦
          faceRingModelToReduction k D (b i.1)) := by
  letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
    faceRingModelCanonicalModule k D
  let coeff : Fin N → T_ReductionGrading k n m := fun i ↦ b.repr z i
  let c : Fin N → T_ReductionGrading k n m :=
    weightedFreeComponent (K_ReductionGrading k n m) r q coeff
  have hgen : faceRingGeneratorMap k D (fun i ↦ b i) coeff = z := by
    change (∑ i, coeff i • b i) = z
    simpa only [coeff] using b.sum_repr z
  have hcgen : faceRingGeneratorMap k D (fun i ↦ b i) c = z := by
    calc
      faceRingGeneratorMap k D (fun i ↦ b i) c =
          faceRingModelComponent (K_ReductionGrading k n m)
            (AugmentedComplex.ofAbstract D) q
            (faceRingGeneratorMap k D (fun i ↦ b i) coeff) :=
        faceRingGeneratorMap_weightedFreeComponent
          k D (fun i ↦ b i) r hb coeff
      _ = faceRingModelComponent (K_ReductionGrading k n m)
          (AugmentedComplex.ofAbstract D) q z := by rw [hgen]
      _ = z := faceRingModelComponent_eq_self
        (K_ReductionGrading k n m) (AugmentedComplex.ofAbstract D) z hz
  rw [← hcgen]
  change faceRingModelToReduction k D (∑ i, c i • b i) ∈ _
  rw [map_sum]
  apply Submodule.sum_mem
  intro i _hi
  rw [faceRingModelToReduction_parameter_smul]
  by_cases hiq : r i = q
  · apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨⟨i, hiq⟩, rfl⟩
  · have hcc : MvPolynomial.constantCoeff (c i) = 0 := by
      rw [show c i = weightedFreeComponent (K_ReductionGrading k n m) r q coeff i by rfl,
        weightedFreeComponent_apply]
      by_cases hle : r i ≤ q
      · rw [dif_pos hle]
        exact MvPolynomial.constantCoeff_eq_zero_of_isHomogeneous_pos
          (MvPolynomial.homogeneousComponent_isHomogeneous
            (q - r i) (coeff i)) (by omega)
      · rw [dif_neg hle, map_zero]
    rw [hcc, zero_smul]
    exact Submodule.zero_mem _

set_option linter.style.haveILetI false in
theorem quotientDegree_eq_span_reductionBasis_degree
    (k : Type u) [Field k] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (b : letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionGrading k n m) (Model_ReductionGrading k n m D))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous (K_ReductionGrading k n m)
