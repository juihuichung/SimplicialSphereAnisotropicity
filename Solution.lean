noncomputable section

open scoped BigOperators
open Matrix

namespace SimplicialSphereAnisotropicity.Generic

variable (k : Type*) [Field k]

noncomputable def matrixLinearAlgHom
    {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι K) : MvPolynomial ι K →ₐ[K] MvPolynomial ι K :=
  MvPolynomial.aeval fun i ↦
    ∑ j, MvPolynomial.C (A i j) * MvPolynomial.X j

@[simp]
theorem matrixLinearAlgHom_X
    {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι K) (i : ι) :
    matrixLinearAlgHom A (MvPolynomial.X i) =
      ∑ j, MvPolynomial.C (A i j) * MvPolynomial.X j := by
  simp [matrixLinearAlgHom]

theorem matrixLinearAlgHom_comp
    {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
    (A B : Matrix ι ι K) :
    (matrixLinearAlgHom B).comp (matrixLinearAlgHom A) =
      matrixLinearAlgHom (A * B) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp only [AlgHom.comp_apply, matrixLinearAlgHom_X, map_sum, map_mul,
    MvPolynomial.algHom_C]
  change (∑ x, MvPolynomial.C (A i x) *
      ∑ j, MvPolynomial.C (B x j) * MvPolynomial.X j) =
    ∑ j, MvPolynomial.C ((A * B) i j) * MvPolynomial.X j
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro x _
  rw [MvPolynomial.C_mul]
  ring

theorem matrixLinearAlgHom_one
    {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι] :
    matrixLinearAlgHom (1 : Matrix ι ι K) = AlgHom.id K (MvPolynomial ι K) := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [matrixLinearAlgHom_X, Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    rw [Matrix.one_apply_ne' hji]
    simp
  · simp

noncomputable def matrixLinearAlgEquiv
    {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι K) (hA : IsUnit A.det) :
    MvPolynomial ι K ≃ₐ[K] MvPolynomial ι K :=
  AlgEquiv.ofAlgHom (matrixLinearAlgHom A) (matrixLinearAlgHom A⁻¹)
    (by
      rw [matrixLinearAlgHom_comp, Matrix.nonsing_inv_mul A hA,
        matrixLinearAlgHom_one])
    (by
      rw [matrixLinearAlgHom_comp, Matrix.mul_nonsing_inv A hA,
        matrixLinearAlgHom_one])

def orderedFaceEmbedding {m d : ℕ}
    (F : Finset (Fin m)) (hF : F.card = d) : Fin d ↪ Fin m where
  toFun i := F.orderEmbOfFin hF i
  inj' := (F.orderEmbOfFin hF).injective

noncomputable def genericMinorPolynomial {n m : ℕ}
    (e : Fin (n + 1) ↪ Fin m) : SimplicialSphereAnisotropicity.CoefficientPolynomial k n m :=
  Matrix.det (fun i j : Fin (n + 1) ↦ MvPolynomial.X (i, e j))

noncomputable def genericMinor {n m : ℕ}
    (e : Fin (n + 1) ↪ Fin m) : SimplicialSphereAnisotropicity.GenericField k n m :=
  Matrix.det (fun i j : Fin (n + 1) ↦ SimplicialSphereAnisotropicity.genericCoefficient k i (e j))

theorem genericMinor_eq_algebraMap {n m : ℕ}
    (e : Fin (n + 1) ↪ Fin m) :
    genericMinor k e =
      algebraMap (SimplicialSphereAnisotropicity.CoefficientPolynomial k n m)
        (SimplicialSphereAnisotropicity.GenericField k n m) (genericMinorPolynomial k e) := by
  let φ : SimplicialSphereAnisotropicity.CoefficientPolynomial k n m →+*
      SimplicialSphereAnisotropicity.GenericField k n m :=
    algebraMap (SimplicialSphereAnisotropicity.CoefficientPolynomial k n m)
      (SimplicialSphereAnisotropicity.GenericField k n m)
  change Matrix.det (φ.mapMatrix (fun i j : Fin (n + 1) ↦
      MvPolynomial.X (i, e j))) =
    φ (Matrix.det (fun i j : Fin (n + 1) ↦ MvPolynomial.X (i, e j)))
  exact (φ.map_det _).symm

theorem genericMinorPolynomial_ne_zero {n m : ℕ}
    (e : Fin (n + 1) ↪ Fin m) :
    genericMinorPolynomial k e ≠ 0 := by
  let f : (Fin (n + 1) × Fin (n + 1)) →
      (Fin (n + 1) × Fin m) := fun ij ↦ (ij.1, e ij.2)
  have hf : Function.Injective f := by
    rintro ⟨i, j⟩ ⟨i', j'⟩ h
    simp only [f, Prod.mk.injEq] at h
    exact Prod.ext h.1 (e.injective h.2)
  have hren :
      (MvPolynomial.rename f).mapMatrix
          (Matrix.mvPolynomialX (Fin (n + 1)) (Fin (n + 1)) k) =
        (fun i j : Fin (n + 1) ↦
          (MvPolynomial.X (i, e j) : SimplicialSphereAnisotropicity.CoefficientPolynomial k n m)) := by
    ext i j
    simp [f, Matrix.mvPolynomialX]
  rw [genericMinorPolynomial, ← hren]
  intro hz
  apply Matrix.det_mvPolynomialX_ne_zero (Fin (n + 1)) k
  apply MvPolynomial.rename_injective f hf
  let rf : MvPolynomial (Fin (n + 1) × Fin (n + 1)) k →+*
      SimplicialSphereAnisotropicity.CoefficientPolynomial k n m := (MvPolynomial.rename f).toRingHom
  exact (rf.map_det
    (Matrix.mvPolynomialX (Fin (n + 1)) (Fin (n + 1)) k)).trans hz

theorem genericMinor_ne_zero {n m : ℕ}
    (e : Fin (n + 1) ↪ Fin m) : genericMinor k e ≠ 0 := by
  rw [genericMinor_eq_algebraMap]
  intro h
  apply genericMinorPolynomial_ne_zero k e
  apply IsFractionRing.injective
    (SimplicialSphereAnisotropicity.CoefficientPolynomial k n m)
    (SimplicialSphereAnisotropicity.GenericField k n m)
  simpa using h

noncomputable def faceCoefficientMatrix {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) (SimplicialSphereAnisotropicity.GenericField k n m) :=
  fun i j ↦ SimplicialSphereAnisotropicity.genericCoefficient k i (orderedFaceEmbedding F hF j)

noncomputable def faceMinor {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    SimplicialSphereAnisotropicity.GenericField k n m :=
  (faceCoefficientMatrix k F hF).det

theorem faceMinor_eq_genericMinor {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    faceMinor k F hF = genericMinor k (orderedFaceEmbedding F hF) := rfl

theorem faceMinor_ne_zero {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    faceMinor k F hF ≠ 0 := by
  rw [faceMinor_eq_genericMinor]
  exact genericMinor_ne_zero k (orderedFaceEmbedding F hF)

theorem faceCoefficientMatrix_isUnit_det {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    IsUnit (faceCoefficientMatrix k F hF).det :=
  isUnit_iff_ne_zero.mpr (faceMinor_ne_zero k F hF)

noncomputable def faceCoefficientLinearEquiv {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    (Fin (n + 1) → SimplicialSphereAnisotropicity.GenericField k n m) ≃ₗ[SimplicialSphereAnisotropicity.GenericField k n m]
      (Fin (n + 1) → SimplicialSphereAnisotropicity.GenericField k n m) :=
  Matrix.toLinearEquiv (Pi.basisFun (SimplicialSphereAnisotropicity.GenericField k n m) (Fin (n + 1)))
    (faceCoefficientMatrix k F hF)
    (faceCoefficientMatrix_isUnit_det k F hF)

noncomputable def genericColumn {n m : ℕ} (v : Fin m) :
    Fin (n + 1) → SimplicialSphereAnisotropicity.GenericField k n m :=
  fun i ↦ SimplicialSphereAnisotropicity.genericCoefficient k i v

theorem orderedFaceColumns_linearIndependent {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    LinearIndependent (SimplicialSphereAnisotropicity.GenericField k n m)
      (fun j : Fin (n + 1) ↦
        genericColumn (n := n) (m := m) k (orderedFaceEmbedding F hF j)) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg j
  have hzero : faceCoefficientLinearEquiv k F hF g = 0 := by
    change Matrix.toLin
      (Pi.basisFun (SimplicialSphereAnisotropicity.GenericField k n m) (Fin (n + 1)))
      (Pi.basisFun (SimplicialSphereAnisotropicity.GenericField k n m) (Fin (n + 1)))
      (faceCoefficientMatrix k F hF) g = 0
    rw [Matrix.toLin_eq_toLin', Matrix.toLin'_apply]
    apply funext
    intro i
    have hi := congrFun hg i
    simpa [faceCoefficientMatrix, genericColumn,
      Matrix.mulVec, dotProduct, mul_comm] using hi
  have hgzero : g = 0 :=
    (faceCoefficientLinearEquiv k F hF).injective (by simpa using hzero)
  exact congrFun hgzero j

theorem faceColumns_linearIndependent {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    LinearIndependent (SimplicialSphereAnisotropicity.GenericField k n m)
      (fun v : ↥F ↦ genericColumn (n := n) (m := m) k v.1) := by
  let e := F.orderIsoOfFin hF
  have h := (orderedFaceColumns_linearIndependent k F hF).comp
    e.symm e.symm.injective
  have heq :
      ((fun j : Fin (n + 1) ↦
          genericColumn (n := n) (m := m) k (orderedFaceEmbedding F hF j)) ∘
        e.symm) =
      (fun v : ↥F ↦ genericColumn (n := n) (m := m) k v.1) := by
    funext v
    apply funext
    intro i
    change SimplicialSphereAnisotropicity.genericCoefficient k i
      ((F.orderIsoOfFin hF) ((F.orderIsoOfFin hF).symm v)).1 =
        SimplicialSphereAnisotropicity.genericCoefficient k i v.1
    rw [e.apply_symm_apply]
  rw [heq] at h
  exact h

theorem subfaceColumns_linearIndependent {n m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    LinearIndependent (SimplicialSphereAnisotropicity.GenericField k n m)
      (fun v : ↥F ↦ genericColumn (n := n) (m := m) k v.1) := by
  let e : ↥F ↪ ↥G :=
    ⟨fun v ↦ ⟨v.1, hFG v.2⟩,
      fun _ _ h ↦ Subtype.ext (congrArg (fun z : ↥G ↦ z.1) h)⟩
  have h := (faceColumns_linearIndependent k G hGcard).comp e e.injective
  have heq :
      ((fun v : ↥G ↦ genericColumn (n := n) (m := m) k v.1) ∘ e) =
        (fun v : ↥F ↦ genericColumn (n := n) (m := m) k v.1) := by
    rfl
  rw [heq] at h
  exact h

theorem simplexColumns_linearIndependent {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hpure : SimplicialSphereAnisotropicity.Simplicial.IsPureOfCard D (n + 1))
    {F : Finset (Fin m)} (hF : F ∈ D) :
    LinearIndependent (SimplicialSphereAnisotropicity.GenericField k n m)
      (fun v : ↥F ↦ genericColumn (n := n) (m := m) k v.1) := by
  obtain ⟨G, hG, hFG, hGcard⟩ := hpure hF
  exact subfaceColumns_linearIndependent k hFG hGcard

abbrev ParameterRing (n m : ℕ) :=
  MvPolynomial (Fin (n + 1)) (SimplicialSphereAnisotropicity.GenericField k n m)

noncomputable def facetParameterAlgEquiv {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) :
    ParameterRing k n m ≃ₐ[SimplicialSphereAnisotropicity.GenericField k n m]
      MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m) :=
  (matrixLinearAlgEquiv (faceCoefficientMatrix k F hF)
      (faceCoefficientMatrix_isUnit_det k F hF)).trans
    (MvPolynomial.renameEquiv (SimplicialSphereAnisotropicity.GenericField k n m)
      (F.orderIsoOfFin hF).toEquiv)

@[simp]
theorem facetParameterAlgEquiv_X {n m : ℕ}
    (F : Finset (Fin m)) (hF : F.card = n + 1) (i : Fin (n + 1)) :
    facetParameterAlgEquiv k F hF (MvPolynomial.X i) =
      ∑ j : Fin (n + 1),
        MvPolynomial.C
            (SimplicialSphereAnisotropicity.genericCoefficient k i (orderedFaceEmbedding F hF j)) *
          MvPolynomial.X (F.orderIsoOfFin hF j) := by
  simp [facetParameterAlgEquiv, matrixLinearAlgEquiv,
    faceCoefficientMatrix, orderedFaceEmbedding]

end SimplicialSphereAnisotropicity.Generic

end

