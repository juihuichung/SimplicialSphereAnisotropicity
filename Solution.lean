section

/-!
# The face-ring model as a projective parameter module

The established top source is transported into face-polynomial coordinates.
It is an additive equivalence from the allowed-exponent model of the face ring
onto the top boundary kernel.  The parameter action and projectivity are then
transported across this equivalence.
-/

noncomputable section

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

noncomputable def faceCoordinateSource
    (k : Type u) [Field k] {n m d : ℕ}
    (C : AugmentedComplex (Fin m)) :
    FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C →ₗ[
        SimplicialSphereAnisotropicity.GenericField k n m]
      FaceCoordinateTerm k (n := n) (m := m) C d :=
  (faceResolutionTermEquivCoordinate k C).toLinearMap.comp
    (faceResolutionSource (SimplicialSphereAnisotropicity.GenericField k n m) C d)

theorem faceCoordinateSource_injective
    (k : Type u) [Field k] [CharP k 2] {n m d : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C d) :
    Function.Injective
      (faceCoordinateSource k (n := n) (m := m) (d := d) C) := by
  intro x y hxy
  apply faceResolutionSource_injective
    (SimplicialSphereAnisotropicity.GenericField k n m) C d hbound hall
  apply (faceResolutionTermEquivCoordinate k C).injective
  exact hxy

set_option linter.style.haveILetI false in
noncomputable def faceCoordinateSourceToTopKernel
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (n + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C n) :=
      faceCoordinateTermModule k C
    FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C →+
      LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m) C n) where
  toFun z := ⟨faceCoordinateSource k C z, by
    rw [LinearMap.mem_ker]
    have hmem : faceResolutionSource
        (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1) z ∈
        LinearMap.ker
          (faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C n) := by
      rw [← faceResolutionSource_range_eq_ker
        (SimplicialSphereAnisotropicity.GenericField k n m) C n hbound hall]
      exact ⟨z, rfl⟩
    rw [LinearMap.mem_ker] at hmem
    simpa [faceCoordinateSource, hmem] using
      (faceResolutionTermEquivCoordinate_boundary k C
        (faceResolutionSource
          (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1) z)).symm⟩
  map_zero' := by
    apply Subtype.ext
    exact map_zero _
  map_add' x y := by
    apply Subtype.ext
    exact map_add _ _ _

theorem faceCoordinateSourceToTopKernel_bijective
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (n + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C n) :=
      faceCoordinateTermModule k C
    Function.Bijective
      (faceCoordinateSourceToTopKernel k C hbound hall) := by
  constructor
  · intro x y hxy
    apply faceCoordinateSource_injective k C hbound hall
    exact congrArg Subtype.val hxy
  · rintro ⟨z, hz⟩
    rw [LinearMap.mem_ker] at hz
    have hzold : faceResolutionBoundary
        (SimplicialSphereAnisotropicity.GenericField k n m) C n
        ((faceResolutionTermEquivCoordinate k C).symm z) = 0 := by
      rw [← faceResolutionTermEquivCoordinate_symm_boundary,
        hz, map_zero]
    have hmem :
        (faceResolutionTermEquivCoordinate k C).symm z ∈
          LinearMap.ker
            (faceResolutionBoundary (SimplicialSphereAnisotropicity.GenericField k n m) C n) := hzold
    rw [← faceResolutionSource_range_eq_ker
      (SimplicialSphereAnisotropicity.GenericField k n m) C n hbound hall] at hmem
    obtain ⟨c, hc⟩ := hmem
    refine ⟨c, Subtype.ext ?_⟩
    apply (faceResolutionTermEquivCoordinate k C).symm.injective
    simpa [faceCoordinateSourceToTopKernel,
      faceCoordinateSource] using hc

set_option linter.style.haveILetI false in
noncomputable def faceRingModelAddEquivTopKernel
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C (n + 1)) :=
      faceCoordinateTermModule k C
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m) C n) :=
      faceCoordinateTermModule k C
    FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C ≃+
      LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m) C n) :=
  AddEquiv.ofBijective
    (faceCoordinateSourceToTopKernel k C hbound hall)
    (faceCoordinateSourceToTopKernel_bijective k C hbound hall)

@[instance_reducible]
noncomputable def faceRingModelParameterModule
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C) :=
  (faceRingModelAddEquivTopKernel k C hbound hall).module
    (Generic.ParameterRing k n m)

set_option linter.style.haveILetI false in
theorem faceRingModel_projective
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C (n + 1))
    (hpure : ∀ {F : Finset (Fin m)}, F ∈ C →
      ∃ G : Finset (Fin m), G ∈ C ∧ F ⊆ G ∧ G.card = n + 1)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) C (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C) :=
      faceRingModelParameterModule k C hbound hall
    Module.Projective (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C) :=
    faceRingModelParameterModule k C hbound hall
  letI : Module (Generic.ParameterRing k n m)
      (FaceCoordinateTerm k (n := n) (m := m) C (n + 1)) :=
    faceCoordinateTermModule k C
  letI : Module (Generic.ParameterRing k n m)
      (FaceCoordinateTerm k (n := n) (m := m) C n) :=
    faceCoordinateTermModule k C
  let hproj := faceCoordinateTopKernel_projective k C hpure hall
  letI : Module.Projective (Generic.ParameterRing k n m)
      (LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m) C n)) := hproj
  exact Module.Projective.of_equiv'
    ((faceRingModelAddEquivTopKernel k C hbound hall).linearEquiv
      (Generic.ParameterRing k n m)).symm

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

section

/-!
# The Stanley--Reisner quotient and its monomial normal form

The trusted Stanley--Reisner ideal consists exactly of polynomials supported
on nonface exponents. Consequently restriction to face-supported exponents
identifies its quotient with the allowed-exponent face-ring model.
-/

noncomputable section

open scoped BigOperators
open MvPolynomial
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

def squarefreeExponent {m : ℕ} (s : Finset (Fin m)) :
    Fin m →₀ ℕ :=
  Finsupp.indicator s (fun _ _ ↦ 1)

@[simp]
theorem squarefreeExponent_apply {m : ℕ}
    (s : Finset (Fin m)) (v : Fin m) :
    squarefreeExponent s v = if v ∈ s then 1 else 0 := by
  classical
  simp [squarefreeExponent, Finsupp.indicator]

@[simp]
theorem squarefreeExponent_support {m : ℕ}
    (s : Finset (Fin m)) :
    (squarefreeExponent s).support = s := by
  classical
  ext v
  simp [Finsupp.mem_support_iff]

theorem faceMonomial_eq_monomial_squarefreeExponent
    (K : Type u) [CommSemiring K] {m : ℕ} (s : Finset (Fin m)) :
    SimplicialSphereAnisotropicity.faceMonomial (K := K) s =
      MvPolynomial.monomial (squarefreeExponent s) 1 := by
  classical
  simpa [SimplicialSphereAnisotropicity.faceMonomial, squarefreeExponent] using
    (MvPolynomial.prod_X_pow (R := K) (fun _ : Fin m ↦ 1) s)

def nonfaceGeneratorExponent {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) : Set (Fin m →₀ ℕ) :=
  {α | ∃ s : Finset (Fin m), s.Nonempty ∧ s ∉ D ∧
    α = squarefreeExponent s}

theorem stanleyReisnerIdeal_eq_span_nonfaceExponent
    (K : Type u) [CommRing K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D =
      Ideal.span
        ((fun α : Fin m →₀ ℕ ↦ MvPolynomial.monomial α (1 : K)) ''
          nonfaceGeneratorExponent D) := by
  rw [SimplicialSphereAnisotropicity.stanleyReisnerIdeal]
  congr 1
  ext p
  constructor
  · rintro ⟨s, hsne, hsnot, rfl⟩
    refine ⟨squarefreeExponent s, ?_, ?_⟩
    · exact ⟨s, hsne, hsnot, rfl⟩
    · exact (faceMonomial_eq_monomial_squarefreeExponent K s).symm
  · rintro ⟨α, ⟨s, hsne, hsnot, rfl⟩, rfl⟩
    exact ⟨s, hsne, hsnot,
      (faceMonomial_eq_monomial_squarefreeExponent K s).symm⟩

theorem mem_stanleyReisnerIdeal_iff_support_not_face
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : MvPolynomial (Fin m) K) :
    p ∈ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D ↔
      ∀ α ∈ p.support, α.support ∉ AugmentedComplex.ofAbstract D := by
  rw [stanleyReisnerIdeal_eq_span_nonfaceExponent,
    MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h α hα hface
    obtain ⟨β, ⟨s, hsne, hsnot, rfl⟩, hle⟩ := h α hα
    have hsubset : s ⊆ α.support := by
      intro v hv
      rw [Finsupp.mem_support_iff]
      have hvle := hle v
      simp [squarefreeExponent_apply, hv] at hvle
      omega
    have hD : α.support ∈ D :=
      (AugmentedComplex.nonempty_mem_ofAbstract_iff D
        (hsne.mono hsubset)).mp hface
    exact hsnot ((D.isRelLowerSet_faces hD).2 hsubset hsne)
  · intro h α hα
    have hnot := h α hα
    have hsne : α.support.Nonempty := by
      by_contra hempty
      apply hnot
      simp [Finset.not_nonempty_iff_eq_empty.mp hempty]
    have hsnot : α.support ∉ D := by
      intro hs
      exact hnot (Or.inr hs)
    refine ⟨squarefreeExponent α.support,
      ⟨α.support, hsne, hsnot, rfl⟩, ?_⟩
    intro v
    by_cases hv : v ∈ α.support
    · have hpos : 0 < α v := by
        exact Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv)
      simp [squarefreeExponent_apply, hv]
      omega
    · simp [squarefreeExponent_apply, hv]

/-- Embed the coefficient function on allowed exponents into the ambient
polynomial coefficient function. -/
noncomputable def faceRingModelToPolynomial
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) :
    FaceRingModel K C →ₗ[K] MvPolynomial (Fin m) K :=
  (AddMonoidAlgebra.coeffLinearEquiv K).symm.toLinearMap.comp
    (Finsupp.lmapDomain K K (fun a : AllowedExponent C ↦ a.1))

@[simp]
theorem faceRingModelToPolynomial_apply_allowed
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceRingModel K C) (a : AllowedExponent C) :
    MvPolynomial.coeff a.1 (faceRingModelToPolynomial K C z) = z a := by
  exact Finsupp.mapDomain_apply Subtype.val_injective z a

theorem faceRingModelToPolynomial_apply_not_allowed
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceRingModel K C) (a : Fin m →₀ ℕ)
    (ha : a.support ∉ C) :
    MvPolynomial.coeff a (faceRingModelToPolynomial K C z) = 0 := by
  apply Finsupp.mapDomain_of_notMem_range
  rintro ⟨b, hb⟩
  exact ha (hb ▸ b.2)

/-- Restrict an ambient polynomial coefficient function to allowed
exponents. -/
noncomputable def polynomialFacePart
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m))
    (p : MvPolynomial (Fin m) K) : FaceRingModel K C :=
  Finsupp.comapDomain (fun a : AllowedExponent C ↦ a.1)
    (AddMonoidAlgebra.coeff p)
    Subtype.val_injective.injOn

@[simp]
theorem polynomialFacePart_apply
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m))
    (p : MvPolynomial (Fin m) K) (a : AllowedExponent C) :
    polynomialFacePart K C p a = MvPolynomial.coeff a.1 p := by
  rfl

theorem polynomial_sub_facePart_mem_stanleyReisnerIdeal
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : MvPolynomial (Fin m) K) :
    p - faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p) ∈
      SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D := by
  rw [mem_stanleyReisnerIdeal_iff_support_not_face]
  intro a ha hface
  have hzero : MvPolynomial.coeff a
      (p - faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p)) = 0 := by
    rw [MvPolynomial.coeff_sub,
      faceRingModelToPolynomial_apply_allowed
        K (AugmentedComplex.ofAbstract D)
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p)
        ⟨a, hface⟩,
      polynomialFacePart_apply]
    exact sub_self _
  exact (MvPolynomial.mem_support_iff.mp ha) hzero

noncomputable def faceRingModelToStanleyReisner
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    FaceRingModel K (AugmentedComplex.ofAbstract D) →ₗ[K]
      MvPolynomial (Fin m) K ⧸ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D :=
  (Ideal.Quotient.mkₐ K (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D)).toLinearMap.comp
    (faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D))

theorem faceRingModelToStanleyReisner_injective
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Function.Injective (faceRingModelToStanleyReisner K D) := by
  intro x y hxy
  apply sub_eq_zero.mp
  apply Finsupp.ext
  intro a
  by_contra hne
  have hmem : faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
      (x - y) ∈ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change faceRingModelToStanleyReisner K D (x - y) = 0
    rw [map_sub, hxy, sub_self]
  have hsupport : a.1 ∈
      (faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
        (x - y)).support := by
    rw [MvPolynomial.mem_support_iff,
      faceRingModelToPolynomial_apply_allowed]
    exact hne
  exact (mem_stanleyReisnerIdeal_iff_support_not_face K D _).mp
    hmem a.1 hsupport a.2

theorem faceRingModelToStanleyReisner_surjective
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Function.Surjective (faceRingModelToStanleyReisner K D) := by
  intro q
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  refine ⟨polynomialFacePart K (AugmentedComplex.ofAbstract D) p, ?_⟩
  change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D)
      (faceRingModelToPolynomial K (AugmentedComplex.ofAbstract D)
        (polynomialFacePart K (AugmentedComplex.ofAbstract D) p)) =
    Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D) p
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  simpa only [neg_sub] using
    (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D).neg_mem
      (polynomial_sub_facePart_mem_stanleyReisnerIdeal K D p)

noncomputable def faceRingModelLinearEquivStanleyReisner
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    FaceRingModel K (AugmentedComplex.ofAbstract D) ≃ₗ[K]
      MvPolynomial (Fin m) K ⧸ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D :=
  LinearEquiv.ofBijective (faceRingModelToStanleyReisner K D)
    ⟨faceRingModelToStanleyReisner_injective K D,
      faceRingModelToStanleyReisner_surjective K D⟩

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

section

/-!
# The canonical face ring as a projective parameter module

Top-face restriction descends from the trusted Stanley--Reisner quotient and
agrees with the established face-resolution source.  It is linear for the
canonical generic-parameter action, identifies the quotient with the top
boundary kernel, and therefore proves projectivity of the actual face ring.
-/

noncomputable section

open scoped BigOperators
open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

noncomputable def ambientFaceRestriction
    (K : Type u) [Field K] {m : ℕ} (F : Finset (Fin m)) :
    MvPolynomial (Fin m) K →ₐ[K] MvPolynomial ↑F K :=
  MvPolynomial.killCompl (f := fun v : ↑F ↦ v.1)
    Subtype.val_injective

@[simp]
theorem ambientFaceRestriction_coeff
    (K : Type u) [Field K] {m : ℕ} (F : Finset (Fin m))
    (p : MvPolynomial (Fin m) K) (β : ↑F →₀ ℕ) :
    (ambientFaceRestriction K F p).coeff β =
      p.coeff (β.mapDomain Subtype.val) := by
  exact MvPolynomial.coeff_killCompl
    (p := p) (s := β) Subtype.val_injective

theorem faceCoordinateSource_eq_ambientFaceRestriction
    (k : Type u) [Field k] {n m d : ℕ}
    (C : AugmentedComplex (Fin m))
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m) C)
    (F : AugmentedSimplex C d) :
    faceCoordinateSource k C z F =
      ambientFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) F.1
        (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) C z) := by
  classical
  ext β
  let α : Fin m →₀ ℕ := β.mapDomain Subtype.val
  have hsupp : α.support ⊆ F.1 := by
    intro v hv
    have hv' := Finsupp.mapDomain_support hv
    obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hv'
    exact w.2
  have hface : α.support ∈ C := C.down_closed F.2.1 hsupp
  let a : AllowedExponent C := ⟨α, hface⟩
  let G : ContainingSimplex C α.support d := ⟨F, hsupp⟩
  have hsource' :
      (faceCoordinateSource k C z F).coeff β = z a := by
    change (faceResolutionTermEquivCoordinate k C
      (faceResolutionSource (SimplicialSphereAnisotropicity.GenericField k n m) C d z) F).coeff β =
        z a
    rw [faceResolutionTermEquivCoordinate_apply_coeff]
    have hidx :
        (faceMonomialIndexEquivSigma C d).symm ⟨F, β⟩ =
          (faceMonomialIndexSigmaContainingEquiv C d).symm ⟨α, G⟩ := by
      apply FaceMonomialIndex.ext <;> rfl
    rw [hidx]
    change faceResolutionSource (SimplicialSphereAnisotropicity.GenericField k n m) C d z
        ((faceMonomialIndexSigmaContainingEquiv C d).symm ⟨α, G⟩) = z a
    rw [← faceResolutionByExponentEquiv_apply
      (SimplicialSphereAnisotropicity.GenericField k n m) C d]
    rw [faceResolutionByExponentEquiv_source]
    change (faceResolutionByExponentSource
      (SimplicialSphereAnisotropicity.GenericField k n m) C d z a.1) G = z a
    rw [faceResolutionByExponentSource_apply_allowed,
      Finsupp.smul_apply,
      relativeAllTopFacesChain_apply,
      smul_eq_mul, mul_one]
  rw [hsource', ambientFaceRestriction_coeff,
    faceRingModelToPolynomial_apply_allowed
      (SimplicialSphereAnisotropicity.GenericField k n m) C z a]

theorem stanleyReisnerIdeal_le_ker_ambientFaceRestriction
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ D) :
    SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D ≤
      RingHom.ker (ambientFaceRestriction K F).toRingHom := by
  rw [SimplicialSphereAnisotropicity.stanleyReisnerIdeal]
  apply Ideal.span_le.mpr
  rintro p ⟨s, hsne, hsnot, rfl⟩
  change ambientFaceRestriction K F (SimplicialSphereAnisotropicity.faceMonomial s) = 0
  rw [faceMonomial_eq_monomial_squarefreeExponent,
    ambientFaceRestriction]
  apply MvPolynomial.killCompl_monomial_eq_zero_of_not_subset
  intro hsubset
  apply hsnot
  apply (D.isRelLowerSet_faces hF).2 _ hsne
  intro v hv
  obtain ⟨w, hw⟩ := hsubset (by simpa using hv)
  simp [← hw, w.2]

noncomputable def stanleyReisnerFaceRestriction
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ D) :
    (MvPolynomial (Fin m) K ⧸ SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D) →ₐ[K]
      MvPolynomial ↑F K :=
  Ideal.Quotient.liftₐ (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D)
    (ambientFaceRestriction K F)
    (fun p hp ↦ by
      have h :=
        stanleyReisnerIdeal_le_ker_ambientFaceRestriction K D F hF hp
      change ambientFaceRestriction K F p = 0 at h
      exact h)

@[simp]
theorem stanleyReisnerFaceRestriction_mk
    (K : Type u) [Field K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ D)
    (p : MvPolynomial (Fin m) K) :
    stanleyReisnerFaceRestriction K D F hF
        (Ideal.Quotient.mk (SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := K) D) p) =
      ambientFaceRestriction K F p := by
  rfl

noncomputable def stanleyReisnerTopRestriction
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) →ₐ[
          SimplicialSphereAnisotropicity.GenericField k n m]
      FaceCoordinateTerm k (n := n) (m := m)
        (AugmentedComplex.ofAbstract D) (n + 1) :=
  AlgHom.pi fun F ↦
    stanleyReisnerFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) D F.1
      ((AugmentedComplex.nonempty_mem_ofAbstract_iff D (by
        rw [Finset.nonempty_iff_ne_empty]
        intro hzero
        have := F.2.2
        simp [hzero] at this)).mp F.2.1)

theorem stanleyReisnerTopRestriction_faceRingModel
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :
    stanleyReisnerTopRestriction k D
        (faceRingModelToStanleyReisner
          (SimplicialSphereAnisotropicity.GenericField k n m) D z) =
      faceCoordinateSource k (AugmentedComplex.ofAbstract D) z := by
  classical
  funext F
  rw [faceCoordinateSource_eq_ambientFaceRestriction]
  rfl

noncomputable def ambientParameterAlgHom
    (k : Type u) [Field k] {n m : ℕ} :
    Generic.ParameterRing k n m →ₐ[SimplicialSphereAnisotropicity.GenericField k n m]
      MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) :=
  MvPolynomial.aeval (fun i ↦
    SimplicialSphereAnisotropicity.genericLinearForm k (n := n) (m := m) i)

@[simp]
theorem ambientParameterAlgHom_X
    (k : Type u) [Field k] {n m : ℕ} (i : Fin (n + 1)) :
    ambientParameterAlgHom k (n := n) (m := m) (MvPolynomial.X i) =
      SimplicialSphereAnisotropicity.genericLinearForm k i := by
  simp [ambientParameterAlgHom]

theorem ambientFaceRestriction_genericLinearForm
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (i : Fin (n + 1)) :
    ambientFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) F
        (SimplicialSphereAnisotropicity.genericLinearForm k i) =
      Generic.restrictedGenericLinearForm k F i := by
  classical
  rw [ambientFaceRestriction, SimplicialSphereAnisotropicity.genericLinearForm,
    Generic.restrictedGenericLinearForm]
  exact Generic.killCompl_sum_C_mul_X
    (R := SimplicialSphereAnisotropicity.GenericField k n m)
    (Function.Embedding.subtype fun v : Fin m ↦ v ∈ F)
    (fun v ↦ SimplicialSphereAnisotropicity.genericCoefficient k i v)

noncomputable def stanleyReisnerParameterAlgHom
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Generic.ParameterRing k n m →ₐ[SimplicialSphereAnisotropicity.GenericField k n m]
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
  (Ideal.Quotient.mkₐ (SimplicialSphereAnisotropicity.GenericField k n m)
      (SimplicialSphereAnisotropicity.stanleyReisnerIdeal
        (K := SimplicialSphereAnisotropicity.GenericField k n m) D)).comp
    (ambientParameterAlgHom k)

@[instance_reducible]
noncomputable def stanleyReisnerParameterAlgebra
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    Algebra (Generic.ParameterRing k n m)
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
  RingHom.toAlgebra'
    ((stanleyReisnerParameterAlgHom k D).toRingHom :
      Generic.ParameterRing k n m →+*
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D))
    (fun c x ↦ by
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        ((stanleyReisnerParameterAlgHom k D).toRingHom c)
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective x
      rw [← ha, ← hb]
      change Ideal.Quotient.mk
          (SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) (a * b) =
        Ideal.Quotient.mk
          (SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) (b * a)
      rw [mul_comm])

set_option linter.style.haveILetI false in
@[simp]
theorem stanleyReisnerParameterAlgebra_algebraMap_apply
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : Generic.ParameterRing k n m) :
    letI : Algebra (Generic.ParameterRing k n m)
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
      stanleyReisnerParameterAlgebra k D
    algebraMap (Generic.ParameterRing k n m)
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) p =
      stanleyReisnerParameterAlgHom k D p := by
  rw [RingHom.algebraMap_toAlgebra']
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]

theorem stanleyReisnerFaceRestriction_comp_parameter
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ D) :
    (stanleyReisnerFaceRestriction
        (SimplicialSphereAnisotropicity.GenericField k n m) D F hF).comp
        (stanleyReisnerParameterAlgHom k D) =
      Generic.faceParameterAlgHom k F := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [stanleyReisnerParameterAlgHom,
    ambientFaceRestriction_genericLinearForm]

set_option linter.style.haveILetI false in
noncomputable def stanleyReisnerFaceRestrictionLinear
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ D) :
    letI : Algebra (Generic.ParameterRing k n m)
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
      stanleyReisnerParameterAlgebra k D
    letI : Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑F (SimplicialSphereAnisotropicity.GenericField k n m)) :=
      faceCoordinateModule k F
    (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) →ₗ[
          Generic.ParameterRing k n m]
      MvPolynomial ↑F (SimplicialSphereAnisotropicity.GenericField k n m) := by
  letI : Algebra (Generic.ParameterRing k n m)
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
    stanleyReisnerParameterAlgebra k D
  letI : Module (Generic.ParameterRing k n m)
      (MvPolynomial ↑F (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    faceCoordinateModule k F
  exact {
    toFun := stanleyReisnerFaceRestriction
      (SimplicialSphereAnisotropicity.GenericField k n m) D F hF
    map_add' := map_add _
    map_smul' := by
      intro p z
      simp only [Algebra.smul_def,
        Generic.faceParameterAlgebra_algebraMap_apply,
        stanleyReisnerParameterAlgebra_algebraMap_apply]
      rw [map_mul]
      congr 1
      exact AlgHom.congr_fun
        (stanleyReisnerFaceRestriction_comp_parameter k D F hF) p }

set_option linter.style.haveILetI false in
noncomputable def stanleyReisnerTopRestrictionLinear
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    letI : Algebra (Generic.ParameterRing k n m)
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
      stanleyReisnerParameterAlgebra k D
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m)
          (AugmentedComplex.ofAbstract D) (n + 1)) :=
      faceCoordinateTermModule k (AugmentedComplex.ofAbstract D)
    (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) →ₗ[
          Generic.ParameterRing k n m]
      FaceCoordinateTerm k (n := n) (m := m)
        (AugmentedComplex.ofAbstract D) (n + 1) := by
  letI : Algebra (Generic.ParameterRing k n m)
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
    stanleyReisnerParameterAlgebra k D
  letI : ∀ F : AugmentedSimplex (AugmentedComplex.ofAbstract D) (n + 1),
      Module (Generic.ParameterRing k n m)
        (MvPolynomial ↑F.1 (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    fun F ↦ faceCoordinateModule k F.1
  exact LinearMap.pi fun F ↦
    stanleyReisnerFaceRestrictionLinear k D F.1
      ((AugmentedComplex.nonempty_mem_ofAbstract_iff D (by
        rw [Finset.nonempty_iff_ne_empty]
        intro hzero
        have := F.2.2
        simp [hzero] at this)).mp F.2.1)

set_option linter.style.haveILetI false in
noncomputable def stanleyReisnerToTopKernel
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy (AugmentedComplex.ofAbstract D) (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (n + 1)) :
    letI : Algebra (Generic.ParameterRing k n m)
        (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
          SimplicialSphereAnisotropicity.stanleyReisnerIdeal
            (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
      stanleyReisnerParameterAlgebra k D
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m)
          (AugmentedComplex.ofAbstract D) (n + 1)) :=
      faceCoordinateTermModule k (AugmentedComplex.ofAbstract D)
    letI : Module (Generic.ParameterRing k n m)
        (FaceCoordinateTerm k (n := n) (m := m)
          (AugmentedComplex.ofAbstract D) n) :=
      faceCoordinateTermModule k (AugmentedComplex.ofAbstract D)
    (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) →ₗ[
          Generic.ParameterRing k n m]
      LinearMap.ker
        (faceCoordinateBoundary k (n := n) (m := m)
          (AugmentedComplex.ofAbstract D) n) := by
  letI : Algebra (Generic.ParameterRing k n m)
      (MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) ⧸
        SimplicialSphereAnisotropicity.stanleyReisnerIdeal (K := SimplicialSphereAnisotropicity.GenericField k n m) D) :=
    stanleyReisnerParameterAlgebra k D
  letI : Module (Generic.ParameterRing k n m)
      (FaceCoordinateTerm k (n := n) (m := m)
        (AugmentedComplex.ofAbstract D) (n + 1)) :=
