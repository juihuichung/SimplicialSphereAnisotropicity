section

/-!
# Combinatorics extracted from all-link homology

This file turns the cardinal-graded homology formula for every augmented link
into purity and the two-facets-through-each-ridge property.  The degree-zero
face and the empty ridge are retained throughout.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v w

variable {V : Type u} [DecidableEq V]

/-- Cardinal degree zero has exactly the formal empty face. -/
instance uniqueAugmentedSimplexZero (C : AugmentedComplex V) :
    Unique (AugmentedSimplex C 0) where
  default := emptyAugmentedSimplex C
  uniq F := by
    apply Subtype.ext
    exact Finset.card_eq_zero.mp F.2.2

omit [DecidableEq V] in
@[simp]
theorem card_augmentedSimplex_zero [Finite V] (C : AugmentedComplex V) :
    Fintype.card (AugmentedSimplex C 0) = 1 :=
  Fintype.card_unique

/-- Every cardinal-degree-one basis face augments to the empty-face basis
generator. -/
theorem faceBoundary_single_one (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : AugmentedSimplex C 1) (a : K) :
    faceBoundary K C 0 (Finsupp.single F a) =
      Finsupp.single (emptyAugmentedSimplex C) a := by
  rw [faceBoundary_single]
  obtain ⟨v, hv⟩ := Finset.card_eq_one.mp F.2.2
  let w₀ : ↥F.1 := ⟨v, by rw [hv]; simp⟩
  let huniq : Unique ↥F.1 := {
    default := w₀
    uniq w := by
      apply Subtype.ext
      have hw : w.1 = v := by
        have hwmem : w.1 ∈ ({v} : Finset V) := by
          simpa only [← hv] using w.2
        simpa using hwmem
      exact hw.trans (show w₀.1 = v from rfl).symm }
  rw [show boundaryOnSimplex K C 0 F =
      Finsupp.single (emptyAugmentedSimplex C) 1 by
    rw [boundaryOnSimplex,
      @Fintype.sum_unique (AugmentedChain K C 0) ↥F.1 _ _ huniq]
    congr 1
    apply Subtype.ext
    exact Finset.card_eq_zero.mp (eraseSimplex C F huniq.default).2.2]
  simp

theorem faceBoundary_zero_surjective_of_nonempty_one
    (K : Type v) [Field K] (C : AugmentedComplex V)
    (h₁ : Nonempty (AugmentedSimplex C 1)) :
    Function.Surjective (faceBoundary K C 0) := by
  obtain ⟨F⟩ := h₁
  intro y
  refine ⟨Finsupp.single F (y (emptyAugmentedSimplex C)), ?_⟩
  rw [faceBoundary_single_one]
  apply Finsupp.ext
  intro G
  have hG : G = emptyAugmentedSimplex C := Subsingleton.elim _ _
  subst G
  simp

/-- The upper-cardinality bound available from `HasDimension`. -/
def FacesBoundedBy (C : AugmentedComplex V) (d : ℕ) : Prop :=
  ∀ F : Finset V, F ∈ C → F.card ≤ d

/-- The augmented complex with only the formal empty face. -/
def emptyOnly (V : Type u) : AugmentedComplex V where
  faces := {F | F = ∅}
  empty_mem := rfl
  down_closed := by
    rintro F G rfl h
    exact Finset.subset_empty.mp h

omit [DecidableEq V] in
@[simp]
theorem mem_emptyOnly (F : Finset V) : F ∈ emptyOnly V ↔ F = ∅ :=
  Iff.rfl

/-- Link composition is union of the two disjoint faces. -/
theorem link_link (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    (G : Finset V) (hG : G ∈ C.link F hF) :
    (C.link F hF).link G hG = C.link (F ∪ G) hG.2 := by
  apply AugmentedComplex.ext
  ext H
  change (Disjoint G H ∧ Disjoint F (G ∪ H) ∧ F ∪ (G ∪ H) ∈ C) ↔
    (Disjoint (F ∪ G) H ∧ (F ∪ G) ∪ H ∈ C)
  simp [Finset.disjoint_union_left, Finset.disjoint_union_right,
    Finset.union_assoc, hG.1, and_left_comm, and_assoc]

/-- A top-cardinality face has the empty-only complex as its link. -/
theorem link_top_eq_emptyOnly (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d) (F : Finset V) (hF : F ∈ C)
    (hcard : F.card = d) :
    C.link F hF = emptyOnly V := by
  apply AugmentedComplex.ext
  ext G
  constructor
  · intro hG
    have hle := hbound (F ∪ G) hG.2
    have hdisj := hG.1
    have hGcard : G.card = 0 := by
      rw [Finset.card_union_of_disjoint hdisj, hcard] at hle
      omega
    exact Finset.card_eq_zero.mp hGcard
  · intro hG
    have : G = ∅ := hG
    subst G
    exact ⟨by simp, by simpa using hF⟩

/-- A ridge link has no cardinal-degree-two faces. -/
theorem isEmpty_link_simplex_two_of_ridge
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (R : Finset V) (hR : R ∈ C) (hridge : R.card + 1 = d) :
    IsEmpty (AugmentedSimplex (C.link R hR) 2) := by
  constructor
  intro H
  have hle := hbound (R ∪ H.1) H.2.1.2
  rw [Finset.card_union_of_disjoint H.2.1.1, H.2.2] at hle
  omega

/-- Positive homology in cardinal degree `q` forces an actual cardinal-`q`
face. -/
theorem nonempty_augmentedSimplex_of_homology_finrank_pos
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (hpos : 0 < Module.finrank K ((faceChainComplex K C).homology q)) :
    Nonempty (AugmentedSimplex C q) := by
  by_contra hne
  let hsub : Subsingleton (AugmentedChain K C q) :=
    ⟨fun x y ↦ Finsupp.ext fun i ↦ (hne ⟨i⟩).elim⟩
  have hX : IsZero ((faceChainComplex K C).X q) := by
    change IsZero (ModuleCat.of K (AugmentedChain K C q))
    exact ModuleCat.isZero_of_iff_subsingleton.mpr hsub
  have hH : IsZero ((faceChainComplex K C).homology q) :=
    (HomologicalComplex.ExactAt.of_isZero hX).isZero_homology
  have hsubH : Subsingleton ((faceChainComplex K C).homology q) :=
    ModuleCat.subsingleton_of_isZero hH
  have hzero :
      Module.finrank K ((faceChainComplex K C).homology q) = 0 :=
    @Module.finrank_zero_of_subsingleton K
      ((faceChainComplex K C).homology q) _ _ _ _ hsubH
  rw [hzero] at hpos
  omega

/-- The all-link homology profile plus an upper-cardinality bound implies
augmented purity. -/
theorem pure_of_allLinkHomologySphere
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    {F : Finset V} (hF : F ∈ C) :
    ∃ G : Finset V, G ∈ C ∧ F ⊆ G ∧ G.card = d := by
  have hle : F.card ≤ d := hbound F hF
  let a := d - F.card
  have htop : F.card + a = d := by
    dsimp [a]
    omega
  have hfin := hall F hF a
  rw [if_pos htop] at hfin
  have hpos :
      0 < Module.finrank K
        ((faceChainComplex K (C.link F hF)).homology a) := by
    omega
  obtain ⟨H⟩ :=
    nonempty_augmentedSimplex_of_homology_finrank_pos
      K (C.link F hF) a hpos
  refine ⟨F ∪ H.1, H.2.1.2, Finset.subset_union_left, ?_⟩
  rw [Finset.card_union_of_disjoint H.2.1.1, H.2.2]
  exact htop

/-- If the chain object above degree `q` vanishes, degree-`q` homology is the
kernel of its outgoing differential. -/
noncomputable def homologyIsoKerOfNextXZero
    (K : Type v) [Field K]
    (A : ChainComplex (ModuleCat.{w} K) ℕ) (q : ℕ)
    (hq : 0 < q)
    (hX : IsZero (A.X (q + 1))) :
    A.homology q ≅ ModuleCat.of K (LinearMap.ker (A.d q (q - 1)).hom) := by
  have hd : A.d (q + 1) q = 0 := hX.eq_of_src _ _
  let S := A.sc' (q + 1) q (q - 1)
  have hnext : (ComplexShape.down ℕ).next q = q - 1 := by
    rw [show q = (q - 1) + 1 by omega]
    simp
  exact A.homologyIsoSc' (q + 1) q (q - 1)
      (by simp) hnext ≪≫
    (S.asIsoHomologyπ hd).symm ≪≫ S.cyclesIsoKernel ≪≫
    ModuleCat.kernelIsoKer (A.d q (q - 1))

theorem finrank_homology_eq_finrank_ker_of_next_X_zero
    (K : Type v) [Field K]
    (A : ChainComplex (ModuleCat.{w} K) ℕ) (q : ℕ)
    (hq : 0 < q)
    (hX : IsZero (A.X (q + 1))) :
    Module.finrank K (A.homology q) =
      Module.finrank K (LinearMap.ker (A.d q (q - 1)).hom) :=
  (homologyIsoKerOfNextXZero K A q hq hX).toLinearEquiv.finrank_eq

/-- The homology profile of a ridge link forces exactly two link vertices. -/
theorem card_link_vertices_eq_two
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    (R : Finset V) (hR : R ∈ C) (hridge : R.card + 1 = d) :
    Fintype.card (AugmentedSimplex (C.link R hR) 1) = 2 := by
  let L := C.link R hR
  let A := faceChainComplex K L
  have hH : Module.finrank K (A.homology 1) = 1 := by
    simpa [A, L, hridge] using hall R hR 1
  have h₁ : Nonempty (AugmentedSimplex L 1) :=
    nonempty_augmentedSimplex_of_homology_finrank_pos K L 1 (by rw [hH]; omega)
  let hEmpty₂ : IsEmpty (AugmentedSimplex L 2) := by
    dsimp [L]
    exact isEmpty_link_simplex_two_of_ridge C d hbound R hR hridge
  let hsub₂ : Subsingleton (AugmentedChain K L 2) :=
    ⟨fun x y ↦ Finsupp.ext fun i ↦ (hEmpty₂.false i).elim⟩
  have hX₂ : IsZero (A.X 2) := by
    change IsZero (ModuleCat.of K (AugmentedChain K L 2))
    exact ModuleCat.isZero_of_iff_subsingleton.mpr hsub₂
  have hker : Module.finrank K (LinearMap.ker (A.d 1 0).hom) = 1 :=
    (finrank_homology_eq_finrank_ker_of_next_X_zero K A 1 (by omega) hX₂).symm.trans hH
  change Module.finrank K (LinearMap.ker (faceBoundary K L 0)) = 1 at hker
  have hsurj : Function.Surjective (faceBoundary K L 0) :=
    faceBoundary_zero_surjective_of_nonempty_one K L h₁
  have hrange : Module.finrank K (LinearMap.range (faceBoundary K L 0)) = 1 := by
    rw [LinearMap.range_eq_top.mpr hsurj, finrank_top]
    rw [Module.finrank_finsupp_self, card_augmentedSimplex_zero]
  have hrank := LinearMap.finrank_range_add_finrank_ker (faceBoundary K L 0)
  rw [hrange, hker] at hrank
  rw [Module.finrank_finsupp_self] at hrank
  simpa [L] using hrank.symm

/-- Link vertices of a ridge are exactly top-cardinality faces containing the
ridge. -/
def incidentFacetEquivLinkVertex
    (C : AugmentedComplex V) (d : ℕ)
    (R : Finset V) (hR : R ∈ C) (hridge : R.card + 1 = d) :
    {F : Finset V // F ∈ C ∧ F.card = d ∧ R ⊆ F} ≃
      AugmentedSimplex (C.link R hR) 1 where
  toFun F :=
    ⟨F.1 \ R,
      ⟨⟨Finset.disjoint_sdiff,
        by simpa [Finset.union_sdiff_of_subset F.2.2.2] using F.2.1⟩,
        by rw [Finset.card_sdiff_of_subset F.2.2.2, F.2.2.1]
           omega⟩⟩
  invFun H :=
    ⟨R ∪ H.1, H.2.1.2,
      by rw [Finset.card_union_of_disjoint H.2.1.1, H.2.2]
         exact hridge,
      Finset.subset_union_left⟩
  left_inv F := by
    apply Subtype.ext
    exact Finset.union_sdiff_of_subset F.2.2.2
  right_inv H := by
    apply Subtype.ext
    exact Finset.union_sdiff_cancel_left H.2.1.1

set_option linter.style.haveILetI false in
/-- Exactly two top-cardinality faces contain every ridge. -/
theorem ridge_two_of_allLinkHomologySphere
    (K : Type v) [Field K] [CharP K 2] [Finite V]
    (C : AugmentedComplex V) (d : ℕ)
    (hbound : FacesBoundedBy C d)
    (hall : IsAllLinkHomologySphere K C d)
    {R : Finset V} (hR : R ∈ C) (hridge : R.card + 1 = d) :
    Set.ncard {F : Finset V | F ∈ C ∧ F.card = d ∧ R ⊆ F} = 2 := by
  let s : Set (Finset V) :=
    {F : Finset V | F ∈ C ∧ F.card = d ∧ R ⊆ F}
  letI : Fintype V := Fintype.ofFinite V
  letI : Fintype ↑s := Fintype.ofFinite _
  let e : ↑s ≃ AugmentedSimplex (C.link R hR) 1 := by
    change {F : Finset V // F ∈ C ∧ F.card = d ∧ R ⊆ F} ≃ _
    exact incidentFacetEquivLinkVertex C d R hR hridge
  have hcardLink := card_link_vertices_eq_two K C d hbound hall R hR hridge
  have hcardS : Fintype.card ↑s = 2 := by
    rw [Fintype.card_congr e]
    exact hcardLink
  rw [← Set.fintypeCard_eq_ncard s]
  exact hcardS

/-- The all-link formula is inherited by a link, with top cardinality reduced
by the cardinality of the fixed face. -/
theorem allLinkHomologySphere_link (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (h : IsAllLinkHomologySphere K C d)
    (F : Finset V) (hF : F ∈ C) (s : ℕ)
    (hds : F.card + s = d) :
    IsAllLinkHomologySphere K (C.link F hF) s := by
  intro G hG a
  have hh := h (F ∪ G) hG.2 a
  have hcard : (F ∪ G).card = F.card + G.card :=
    Finset.card_union_of_disjoint hG.1
  rw [hcard] at hh
  by_cases htop : G.card + a = s
  · rw [if_pos htop]
    rw [if_pos (by omega)] at hh
    exact (faceHomologyFinrank_congr K (link_link C F hF G hG) a).trans hh
  · rw [if_neg htop]
    rw [if_neg (by omega)] at hh
    exact (faceHomologyFinrank_congr K (link_link C F hF G hG) a).trans hh

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Concrete exactness consequences for augmented links

The all-link homology profile is converted here into the two linear-algebra
interfaces needed by the monomial strands of the face resolution.  Cardinal
degree zero is stated separately because the Nat-indexed chain complex has no
negative chain object.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V] [Finite V]

/-- A zero-finrank homology object of a finite augmented face complex is the
zero object. -/
theorem faceHomology_isZero_of_finrank_zero
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (q : ℕ)
    (h : Module.finrank K ((faceChainComplex K C).homology q) = 0) :
    IsZero ((faceChainComplex K C).homology q) := by
  let _ : FiniteDimensional K (AugmentedChain K C q) := by infer_instance
  let _ : FiniteDimensional K ((faceChainComplex K C).homology q) := by
    let S := (faceChainComplex K C).sc q
    let _ : FiniteDimensional K S.X₂ := by
      change FiniteDimensional K (AugmentedChain K C q)
      infer_instance
    let _ : FiniteDimensional K S.moduleCatLeftHomologyData.H := by
      change FiniteDimensional K
        (LinearMap.ker S.g.hom ⧸ LinearMap.range S.moduleCatToCycles)
      infer_instance
    exact FiniteDimensional.of_injective
      S.moduleCatHomologyIso.hom.hom
      S.moduleCatHomologyIso.toLinearEquiv.injective
  have hs : Subsingleton ((faceChainComplex K C).homology q) :=
    Module.finrank_zero_iff.mp h
  exact ModuleCat.isZero_of_iff_subsingleton.mpr hs

/-- Every non-top cardinal degree of every link is exact. -/
theorem allLink_exactAt_of_not_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (F : Finset V) (hF : F ∈ C) (q : ℕ)
    (hq : F.card + q ≠ d) :
    (faceChainComplex K (C.link F hF)).ExactAt q := by
  rw [HomologicalComplex.exactAt_iff_isZero_homology]
  apply faceHomology_isZero_of_finrank_zero K
  simpa [hq] using hall F hF q

/-- In a positive non-top link degree, the incoming boundary has range equal
to the kernel of the outgoing boundary. -/
theorem link_boundary_range_eq_ker_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (F : Finset V) (hF : F ∈ C) (a : ℕ)
    (hq : F.card + (a + 1) ≠ d) :
    LinearMap.range (faceBoundary K (C.link F hF) (a + 1)) =
      LinearMap.ker (faceBoundary K (C.link F hF) a) := by
  have hexact := allLink_exactAt_of_not_top K C d hall F hF (a + 1) hq
  let A := faceChainComplex K (C.link F hF)
  have hprev : (ComplexShape.down ℕ).prev (a + 1) = a + 2 := by simp
  have hnext : (ComplexShape.down ℕ).next (a + 1) = a := by simp
  have hsc : (A.sc' (a + 2) (a + 1) a).Exact :=
    (A.exactAt_iff' (a + 2) (a + 1) a hprev hnext).mp hexact
  have hrange := hsc.moduleCat_range_eq_ker
  change LinearMap.range (A.d (a + 2) (a + 1)).hom =
    LinearMap.ker (A.d (a + 1) a).hom at hrange
  dsimp [A] at hrange
  rw [show a + 2 = (a + 1) + 1 by omega, faceChainComplex_d,
    faceChainComplex_d] at hrange
  exact hrange

/-- In cardinal degree zero below the link top, the vertex-to-empty-face
augmentation is surjective. -/
theorem link_boundary_zero_surjective_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (F : Finset V) (hF : F ∈ C) (hq : F.card ≠ d) :
    Function.Surjective (faceBoundary K (C.link F hF) 0) := by
  have hexact := allLink_exactAt_of_not_top K C d hall F hF 0 (by simpa using hq)
  let A := faceChainComplex K (C.link F hF)
  have hprev : (ComplexShape.down ℕ).prev 0 = 1 := by simp
  have hnext : (ComplexShape.down ℕ).next 0 = 0 := by simp
  have hsc : (A.sc' 1 0 0).Exact :=
    (A.exactAt_iff' 1 0 0 hprev hnext).mp hexact
  have hrange := hsc.moduleCat_range_eq_ker
  change LinearMap.range (A.d 1 0).hom = LinearMap.ker (A.d 0 0).hom at hrange
  have hout : A.d 0 0 = 0 := A.shape 0 0 (by simp)
  have hker : LinearMap.ker (A.d 0 0).hom = ⊤ := by
    rw [LinearMap.ker_eq_top]
    exact congrArg ModuleCat.Hom.hom hout
  rw [hker] at hrange
  rw [LinearMap.range_eq_top] at hrange
  dsimp [A] at hrange
  rw [faceChainComplex_d] at hrange
  exact hrange

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Monomial strands of the face resolution

The resolution is decomposed by its ambient exponent.  The strand for an
exponent `α` is the relative face chain module on faces containing
`α.support`, and the resolution boundary becomes the componentwise relative
boundary.
-/

noncomputable section

open scoped BigOperators DirectSum
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u v

variable {V : Type u} [DecidableEq V]

abbrev FaceResolutionByExponent
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ) :=
  Π₀ α : V →₀ ℕ, SimplicialSphereAnisotropicity.Topology.RelativeChain K C α.support q

def faceMonomialIndexSigmaContainingEquiv
    (C : AugmentedComplex V) (q : ℕ) :
    FaceMonomialIndex C q ≃
      Σ α : V →₀ ℕ, SimplicialSphereAnisotropicity.Topology.ContainingSimplex C α.support q where
  toFun I := ⟨I.exponent, I.face, I.support_subset⟩
  invFun I :=
    { face := I.2.1
      exponent := I.1
      support_subset := I.2.2 }
  left_inv I := by cases I; rfl
  right_inv I := by rcases I with ⟨α, I⟩; cases I; rfl

noncomputable def faceResolutionByExponentEquiv
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ) :
    FaceResolutionTerm K C q ≃ₗ[K] FaceResolutionByExponent K C q :=
  (Finsupp.domLCongr (faceMonomialIndexSigmaContainingEquiv C q)).trans
    (sigmaFinsuppLequivDFinsupp K)

omit [DecidableEq V] in
@[simp]
theorem faceResolutionByExponentEquiv_apply
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (z : FaceResolutionTerm K C q) (α : V →₀ ℕ)
    (G : SimplicialSphereAnisotropicity.Topology.ContainingSimplex C α.support q) :
    faceResolutionByExponentEquiv K C q z α G =
      z ((faceMonomialIndexSigmaContainingEquiv C q).symm ⟨α, G⟩) := by
  change (Finsupp.equivMapDomain
      (faceMonomialIndexSigmaContainingEquiv C q) z).split α G = _
  rw [Finsupp.split_apply, Finsupp.equivMapDomain_apply]

@[simp]
theorem faceResolutionByExponentEquiv_single
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (I : FaceMonomialIndex C q) (a : K) :
    faceResolutionByExponentEquiv K C q (Finsupp.single I a) =
      DFinsupp.single I.exponent
        (Finsupp.single ⟨I.face, I.support_subset⟩ a) := by
  classical
  simp [faceResolutionByExponentEquiv,
    faceMonomialIndexSigmaContainingEquiv]

def faceResolutionByExponentBoundary
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ) :
    FaceResolutionByExponent K C (q + 1) →ₗ[K]
      FaceResolutionByExponent K C q :=
  DFinsupp.mapRange.linearMap
    (fun α ↦ SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support q)

@[simp]
theorem faceResolutionByExponentBoundary_apply
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (z : FaceResolutionByExponent K C (q + 1)) (α : V →₀ ℕ) :
    faceResolutionByExponentBoundary K C q z α =
      SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support q (z α) := by
  rfl

theorem faceResolutionByExponentEquiv_boundaryOnIndex
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ)
    (I : FaceMonomialIndex C (q + 1)) :
    faceResolutionByExponentEquiv K C q
        (faceResolutionBoundaryOnIndex K C q I) =
      DFinsupp.single I.exponent
        (SimplicialSphereAnisotropicity.Topology.relativeBoundary K C I.exponent.support q
          (Finsupp.single ⟨I.face, I.support_subset⟩ 1)) := by
  classical
  ext α G
  by_cases hα : I.exponent = α
  · subst α
    simp only [faceResolutionByExponentEquiv_apply,
      faceResolutionBoundaryOnIndex, Finsupp.finsetSum_apply,
      DFinsupp.single_eq_same]
    rw [SimplicialSphereAnisotropicity.Topology.relativeBoundary, LinearMap.comp_apply,
      LinearMap.comp_apply, SimplicialSphereAnisotropicity.Topology.relativeSectionDegree_single,
      faceBoundary_single, one_smul, boundaryOnSimplex, map_sum]
    simp only [SimplicialSphereAnisotropicity.Topology.relativeProjectionDegree_single]
    rw [Finsupp.finsetSum_apply]
    simp only [one_smul]
    apply Finset.sum_congr rfl
    intro x _
    by_cases hx : x.1 ∉ I.exponent.support
    · have hsubset : I.exponent.support ⊆ I.face.1.erase x.1 :=
        Finset.subset_erase.mpr ⟨I.support_subset, hx⟩
      have hsubset' : I.exponent.support ⊆ (eraseSimplex C I.face x).1 := by
        simpa only [eraseSimplex_val] using hsubset
      rw [dif_pos hx, SimplicialSphereAnisotropicity.Topology.relativeProjectOnSimplex,
        dif_pos hsubset']
      have hsingle := congrArg
        (fun z : FaceResolutionByExponent K C q ↦ z I.exponent G)
        (faceResolutionByExponentEquiv_single K C q
          (eraseFaceMonomialIndex C I x hx) 1)
      rw [faceResolutionByExponentEquiv_apply] at hsingle
      simp only [eraseFaceMonomialIndex_exponent,
        DFinsupp.single_eq_same] at hsingle
      have hcont :
          (⟨(eraseFaceMonomialIndex C I x hx).face,
              (eraseFaceMonomialIndex C I x hx).support_subset⟩ :
            SimplicialSphereAnisotropicity.Topology.ContainingSimplex C I.exponent.support q) =
            ⟨eraseSimplex C I.face x, hsubset'⟩ := by
        apply Subtype.ext
        rfl
      rw [hcont] at hsingle
      exact hsingle
    · have hsubset : ¬ I.exponent.support ⊆ I.face.1.erase x.1 := by
        intro h
        exact hx (Finset.subset_erase.mp h).2
      have hsubset' : ¬ I.exponent.support ⊆ (eraseSimplex C I.face x).1 := by
        simpa only [eraseSimplex_val] using hsubset
      rw [dif_neg hx, SimplicialSphereAnisotropicity.Topology.relativeProjectOnSimplex,
        dif_neg hsubset']
      simp
  · simp only [faceResolutionByExponentEquiv_apply,
      faceResolutionBoundaryOnIndex, Finsupp.finsetSum_apply,
      DFinsupp.single_apply, hα]
    apply Finset.sum_eq_zero
    intro x _
    split
    · simp only [Finsupp.single_apply]
      rw [if_neg]
      intro heq
      exact hα (congrArg FaceMonomialIndex.exponent heq)
    · rfl

theorem faceResolutionByExponentEquiv_boundary
    (K : Type v) [Field K] (C : AugmentedComplex V) (q : ℕ) :
    (faceResolutionByExponentEquiv K C q).toLinearMap.comp
        (faceResolutionBoundary K C q) =
      (faceResolutionByExponentBoundary K C q).comp
        (faceResolutionByExponentEquiv K C (q + 1)).toLinearMap := by
  apply Finsupp.lhom_ext
  intro I a
  simp only [LinearMap.comp_apply, faceResolutionBoundary_single, map_smul]
  change a • (faceResolutionByExponentEquiv K C q)
      (faceResolutionBoundaryOnIndex K C q I) = _
  rw [faceResolutionByExponentEquiv_boundaryOnIndex]
  change _ = faceResolutionByExponentBoundary K C q
      (faceResolutionByExponentEquiv K C (q + 1) (Finsupp.single I a))
  rw [faceResolutionByExponentEquiv_single]
  let GI : SimplicialSphereAnisotropicity.Topology.ContainingSimplex C I.exponent.support (q + 1) :=
    ⟨I.face, I.support_subset⟩
  change a • DFinsupp.single I.exponent
      (SimplicialSphereAnisotropicity.Topology.relativeBoundary K C I.exponent.support q
        (Finsupp.single GI 1)) =
    faceResolutionByExponentBoundary K C q
      (DFinsupp.single I.exponent (Finsupp.single GI a))
  rw [show Finsupp.single GI a = a • Finsupp.single GI 1 by simp]
  rw [DFinsupp.single_smul, map_smul]
  congr 1
  change DFinsupp.single I.exponent
      (SimplicialSphereAnisotropicity.Topology.relativeBoundary K C I.exponent.support q
        (Finsupp.single GI 1)) =
    DFinsupp.mapRange
      (fun α (z : SimplicialSphereAnisotropicity.Topology.RelativeChain K C α.support (q + 1)) ↦
        SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support q z)
      (fun α ↦ (SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support q).map_zero)
      (DFinsupp.single I.exponent (Finsupp.single GI 1))
  rw [DFinsupp.mapRange_single]

end SimplicialSphereAnisotropicity.StanleyReisner

end

end

section

/-!
# Exactness of the monomial face resolution below its top degree

Each exponent strand is identified with the augmented chain complex of the
link of its support.  The zero link degree and positive link degrees are
handled separately, then recombined through the finitely supported exponent
decomposition.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V] [Finite V]

/-- At the lowest relative degree for a face `H`, the relative boundary is
the vertex augmentation of the link and is therefore surjective below top. -/
theorem relativeBoundary_surjective_at_support
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (hH : H ∈ C) (hHtop : H.card ≠ d) :
    Function.Surjective (relativeBoundary K C H H.card) := by
  intro z
  have hsurj := link_boundary_zero_surjective_below_top
    K C d hall H hH hHtop
  obtain ⟨y, hy⟩ := hsurj (relativeDegreeEquivLink K C H hH 0 z)
  let w := (relativeDegreeEquivLink K C H hH 1).symm y
  refine ⟨w, ?_⟩
  apply (relativeDegreeEquivLink K C H hH 0).injective
  have hcomm := LinearMap.congr_fun
    (relativeDegreeEquivLink_boundary K C H hH 0) w
  simpa [w, hy] using hcomm

/-- Exactness of a relative strand in a positive link degree. -/
theorem relativeBoundary_range_eq_ker_positiveLink
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (hH : H ∈ C) (s : ℕ)
    (hnotTop : H.card + s + 1 ≠ d) :
    LinearMap.range (relativeBoundary K C H (H.card + s + 1)) =
      LinearMap.ker (relativeBoundary K C H (H.card + s)) := by
  apply le_antisymm
  · rintro z ⟨w, rfl⟩
    rw [LinearMap.mem_ker]
    have hzero := LinearMap.congr_fun
      (relativeBoundary_boundary K C H (H.card + s)) w
    simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using hzero
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    have hrange := link_boundary_range_eq_ker_below_top
      K C d hall H hH s (by omega)
    have hcycle : faceBoundary K (C.link H hH) s
        (relativeDegreeEquivLink K C H hH (s + 1) z) = 0 := by
      have hcomm := LinearMap.congr_fun
        (relativeDegreeEquivLink_boundary K C H hH s) z
      simpa [hz] using hcomm.symm
    have hmem : relativeDegreeEquivLink K C H hH (s + 1) z ∈
        LinearMap.ker (faceBoundary K (C.link H hH) s) := hcycle
    rw [← hrange] at hmem
    obtain ⟨y, hy⟩ := hmem
    let w := (relativeDegreeEquivLink K C H hH (s + 2)).symm y
    refine ⟨w, ?_⟩
    apply (relativeDegreeEquivLink K C H hH (s + 1)).injective
    have hcomm := LinearMap.congr_fun
      (relativeDegreeEquivLink_boundary K C H hH (s + 1)) w
    have hidx : H.card + s + 1 = H.card + (s + 1) := by omega
    have hbval :
        relativeBoundary K C H (H.card + s + 1) w =
          relativeBoundary K C H (H.card + (s + 1)) w := by
      cases hidx
      rfl
    rw [hbval]
    simpa [w, hy] using hcomm

/-- Every positive total degree strictly below `d` is exact in every relative
strand, including nonface supports and supports too large for the degree. -/
theorem relativeBoundary_range_eq_ker_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (H : Finset V) (a : ℕ) (ha : a + 1 < d) :
    LinearMap.range (relativeBoundary K C H (a + 1)) =
      LinearMap.ker (relativeBoundary K C H a) := by
  apply le_antisymm
  · rintro z ⟨w, rfl⟩
    rw [LinearMap.mem_ker]
    have hzero := LinearMap.congr_fun
      (relativeBoundary_boundary K C H a) w
    simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using hzero
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    by_cases hH : H ∈ C
    · by_cases hcard : H.card ≤ a + 1
      · let r := a + 1 - H.card
        have hsum : H.card + r = a + 1 := by
          dsimp [r]
          omega
        rcases r with _ | s
        · have hHcard : H.card = a + 1 := by omega
          have hHtop : H.card ≠ d := by omega
          have hsurj := relativeBoundary_surjective_at_support
            K C d hall H hH hHtop
          rw [hHcard] at hsurj
          exact hsurj z
        · have haEq : a = H.card + s := by omega
          subst a
          have hexact := relativeBoundary_range_eq_ker_positiveLink
            K C d hall H hH s (by omega)
          have hzmem : z ∈ LinearMap.ker
              (relativeBoundary K C H (H.card + s)) := hz
          rw [← hexact] at hzmem
          exact hzmem
      · have hempty : IsEmpty (ContainingSimplex C H (a + 1)) :=
          isEmpty_containingSimplex_of_lt C H (a + 1) (by omega)
        have hz0 : z = 0 := by
          apply Finsupp.ext
          intro G
          exact (hempty.false G).elim
        subst z
        exact ⟨0, map_zero _⟩
    · have hempty : IsEmpty (ContainingSimplex C H (a + 1)) := by
        constructor
        intro G
        exact hH (C.down_closed G.1.2.1 G.2)
      have hz0 : z = 0 := by
        apply Finsupp.ext
        intro G
        exact (hempty.false G).elim
      subst z
      exact ⟨0, map_zero _⟩

/-- The total degree-zero relative boundary is surjective for every support;
only the empty support has a nonzero target. -/
theorem relativeBoundary_zero_surjective_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (hd : 0 < d) (H : Finset V) :
    Function.Surjective (relativeBoundary K C H 0) := by
  by_cases hHempty : H = ∅
  · subst H
    exact relativeBoundary_surjective_at_support
      K C d hall ∅ C.empty_mem (Nat.ne_of_lt hd)
  · intro z
    have hempty : IsEmpty (ContainingSimplex C H 0) := by
      constructor
      intro G
      apply hHempty
      apply Finset.subset_empty.mp
      exact G.2.trans (Finset.card_eq_zero.mp G.1.2.2).le
    have hz0 : z = 0 := by
      apply Finsupp.ext
      intro G
      exact (hempty.false G).elim
    subst z
    exact ⟨0, map_zero _⟩

end SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

open SimplicialSphereAnisotropicity.Topology

universe u v

variable {V : Type u} [DecidableEq V] [Finite V]

/-- Componentwise exactness recombines to exactness of the exponent-indexed
direct sum. -/
theorem faceResolutionByExponentBoundary_range_eq_ker_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (a : ℕ) (ha : a + 1 < d) :
    LinearMap.range (faceResolutionByExponentBoundary K C (a + 1)) =
      LinearMap.ker (faceResolutionByExponentBoundary K C a) := by
  unfold faceResolutionByExponentBoundary
  rw [DFinsupp.range_mapRangeLinearMap, DFinsupp.ker_mapRangeLinearMap]
  congr 2
  funext α
  exact relativeBoundary_range_eq_ker_below_top
    K C d hall α.support a ha

theorem faceResolutionByExponentBoundary_zero_surjective
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d) (hd : 0 < d) :
    Function.Surjective (faceResolutionByExponentBoundary K C 0) := by
  change Function.Surjective
    (DFinsupp.mapRange
      (fun (α : V →₀ ℕ)
          (z : SimplicialSphereAnisotropicity.Topology.RelativeChain K C α.support 1) ↦
        SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support 0 z)
      (fun (α : V →₀ ℕ) ↦
        (SimplicialSphereAnisotropicity.Topology.relativeBoundary K C α.support 0).map_zero))
  rw [DFinsupp.mapRange_surjective]
  intro α
  exact relativeBoundary_zero_surjective_below_top
    K C d hall hd α.support

/-- The concrete monomial face-resolution boundary is exact in every positive
degree strictly below `d`. -/
theorem faceResolutionBoundary_range_eq_ker_below_top
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d)
    (a : ℕ) (ha : a + 1 < d) :
    LinearMap.range (faceResolutionBoundary K C (a + 1)) =
      LinearMap.ker (faceResolutionBoundary K C a) := by
  apply le_antisymm
  · rintro z ⟨w, rfl⟩
    rw [LinearMap.mem_ker]
    have hzero := LinearMap.congr_fun
      (faceResolutionBoundary_boundary K C a) w
    simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using hzero
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    have hcycle : faceResolutionByExponentBoundary K C a
        (faceResolutionByExponentEquiv K C (a + 1) z) = 0 := by
      have hcomm := LinearMap.congr_fun
        (faceResolutionByExponentEquiv_boundary K C a) z
      simpa [hz] using hcomm.symm
    have hmem : faceResolutionByExponentEquiv K C (a + 1) z ∈
        LinearMap.ker (faceResolutionByExponentBoundary K C a) := hcycle
    rw [← faceResolutionByExponentBoundary_range_eq_ker_below_top
      K C d hall a ha] at hmem
    obtain ⟨y, hy⟩ := hmem
    let w := (faceResolutionByExponentEquiv K C (a + 2)).symm y
    refine ⟨w, ?_⟩
    apply (faceResolutionByExponentEquiv K C (a + 1)).injective
    have hcomm := LinearMap.congr_fun
      (faceResolutionByExponentEquiv_boundary K C (a + 1)) w
    simpa [w, hy] using hcomm

/-- The degree-one-to-degree-zero face-resolution boundary is surjective. -/
theorem faceResolutionBoundary_zero_surjective
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (d : ℕ)
    (hall : IsAllLinkHomologySphere K C d) (hd : 0 < d) :
    Function.Surjective (faceResolutionBoundary K C 0) := by
  intro z
  have hsurj := faceResolutionByExponentBoundary_zero_surjective
    K C d hall hd
  obtain ⟨y, hy⟩ := hsurj (faceResolutionByExponentEquiv K C 0 z)
  let w := (faceResolutionByExponentEquiv K C 1).symm y
  refine ⟨w, ?_⟩
  apply (faceResolutionByExponentEquiv K C 0).injective
  have hcomm := LinearMap.congr_fun
    (faceResolutionByExponentEquiv_boundary K C 0) w
  simpa [w, hy] using hcomm

end SimplicialSphereAnisotropicity.StanleyReisner

