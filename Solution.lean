open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

abbrev TopCardFace {m : ℕ} (C : AugmentedComplex (Fin m)) (d : ℕ) :=
  {F : ComplexFace C // F.1.card = d}

abbrev RidgeCardFace {m : ℕ} (C : AugmentedComplex (Fin m)) (d : ℕ) :=
  {R : ComplexFace C // R.1.card + 1 = d}

abbrev IncidentTopCardFace {m : ℕ}
    (C : AugmentedComplex (Fin m)) (d : ℕ) (R : RidgeCardFace C d) :=
  {F : TopCardFace C d // R.1.1 ⊆ F.1.1}

abbrev IncidentRidgeCardFace {m : ℕ}
    (C : AugmentedComplex (Fin m)) (d : ℕ) (F : TopCardFace C d) :=
  {R : RidgeCardFace C d // R.1.1 ⊆ F.1.1}

abbrev RidgeFacetIncidence {m : ℕ}
    (C : AugmentedComplex (Fin m)) (d : ℕ) :=
  Σ R : RidgeCardFace C d, IncidentTopCardFace C d R

theorem card_topCardFace_eq_faceCardCount
    {m d : ℕ} (C : AugmentedComplex (Fin m)) :
    Fintype.card (TopCardFace C d) = faceCardCount C d := by
  rw [Fintype.card_subtype]
  rfl

theorem card_ridgeCardFace_eq_ridgeCardCount
    {m d : ℕ} (C : AugmentedComplex (Fin m)) :
    Fintype.card (RidgeCardFace C d) = ridgeCardCount C d := by
  rw [Fintype.card_subtype]
  rfl

def incidentTopCardFaceEquivSetSubtype
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (R : RidgeCardFace C d) :
    IncidentTopCardFace C d R ≃
      {F : Finset (Fin m) //
        F ∈ C ∧ F.card = d ∧ R.1.1 ⊆ F} where
  toFun F := ⟨F.1.1.1, F.1.1.2, F.1.2, F.2⟩
  invFun F := ⟨⟨⟨F.1, F.2.1⟩, F.2.2.1⟩, F.2.2.2⟩
  left_inv _F := rfl
  right_inv _F := rfl

set_option linter.style.haveILetI false in
theorem card_incidentTopCardFace_eq_two
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hpm : IsAugmentedPseudomanifold C d)
    (R : RidgeCardFace C d) :
    Fintype.card (IncidentTopCardFace C d R) = 2 := by
  let s : Set (Finset (Fin m)) :=
    {F | F ∈ C ∧ F.card = d ∧ R.1.1 ⊆ F}
  letI : Fintype ↑s := Fintype.ofFinite _
  let e : IncidentTopCardFace C d R ≃ ↑s :=
    incidentTopCardFaceEquivSetSubtype C R
  rw [Fintype.card_congr e, Set.fintypeCard_eq_ncard]
  exact hpm.ridge_two R.1.2 R.2

def incidentRidgeCardFaceEquivPowerset
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hd : 0 < d) (F : TopCardFace C d) :
    IncidentRidgeCardFace C d F ≃
      ↥(F.1.1.powersetCard (d - 1)) where
  toFun R := ⟨R.1.1,
    Finset.mem_powersetCard.mpr ⟨R.2, by
      have hcard := R.1.2
      omega⟩⟩
  invFun R := by
    have hR := Finset.mem_powersetCard.mp R.2
    exact ⟨⟨⟨R.1, C.down_closed F.1.2 hR.1⟩, by
      have hcard : R.1.card = d - 1 := hR.2
      show R.1.card + 1 = d
      omega⟩, hR.1⟩
  left_inv _R := rfl
  right_inv _R := rfl

theorem card_incidentRidgeCardFace
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hd : 0 < d) (F : TopCardFace C d) :
    Fintype.card (IncidentRidgeCardFace C d F) = d := by
  rw [Fintype.card_congr (incidentRidgeCardFaceEquivPowerset C hd F),
    Fintype.card_coe, Finset.card_powersetCard, F.2]
  obtain ⟨t, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hd)
  simp

def ridgeFacetIncidenceEquivFacetRidge
    {m d : ℕ} (C : AugmentedComplex (Fin m)) :
    RidgeFacetIncidence C d ≃
      Σ F : TopCardFace C d, IncidentRidgeCardFace C d F where
  toFun x := ⟨x.2.1, ⟨x.1, x.2.2⟩⟩
  invFun x := ⟨x.2.1, ⟨x.1, x.2.2⟩⟩
  left_inv x := by cases x; rfl
  right_inv x := by cases x; rfl

theorem card_ridgeFacetIncidence_eq_two_mul
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hpm : IsAugmentedPseudomanifold C d) :
    Fintype.card (RidgeFacetIncidence C d) =
      2 * ridgeCardCount C d := by
  rw [Fintype.card_sigma]
  calc
    (∑ R : RidgeCardFace C d,
        Fintype.card (IncidentTopCardFace C d R)) =
        ∑ _R : RidgeCardFace C d, 2 := by
          apply Finset.sum_congr rfl
          intro R _hR
          exact card_incidentTopCardFace_eq_two C hpm R
    _ = 2 * ridgeCardCount C d := by
      rw [← card_ridgeCardFace_eq_ridgeCardCount C]
      simp [Nat.mul_comm]

theorem card_ridgeFacetIncidence_eq_card_mul
    {m d : ℕ} (C : AugmentedComplex (Fin m)) (hd : 0 < d) :
    Fintype.card (RidgeFacetIncidence C d) =
      d * faceCardCount C d := by
  rw [Fintype.card_congr (ridgeFacetIncidenceEquivFacetRidge C),
    Fintype.card_sigma]
  calc
    (∑ F : TopCardFace C d,
        Fintype.card (IncidentRidgeCardFace C d F)) =
        ∑ _F : TopCardFace C d, d := by
          apply Finset.sum_congr rfl
          intro F _hF
          exact card_incidentRidgeCardFace C hd F
    _ = d * faceCardCount C d := by
      rw [← card_topCardFace_eq_faceCardCount C]
      simp [Nat.mul_comm]

theorem two_mul_ridgeCardCount_eq_card_mul_faceCardCount
    {m d : ℕ} (C : AugmentedComplex (Fin m)) (hd : 0 < d)
    (hpm : IsAugmentedPseudomanifold C d) :
    2 * ridgeCardCount C d = d * faceCardCount C d := by
  calc
    2 * ridgeCardCount C d =
        Fintype.card (RidgeFacetIncidence C d) :=
      (card_ridgeFacetIncidence_eq_two_mul C hpm).symm
    _ = d * faceCardCount C d :=
      card_ridgeFacetIncidence_eq_card_mul C hd

theorem degreeStatistics_of_multichoose_identity_pseudomanifold
    {m d N : ℕ} (C : AugmentedComplex (Fin m))
    (hd : 0 < d) (hbound : FacesBoundedBy C d)
    (hpm : IsAugmentedPseudomanifold C d) (r : Fin N → ℕ)
    (h : ∀ q,
      (∑ i, if r i ≤ q then d.multichoose (q - r i) else 0) =
        ∑ F : ComplexFace C,
          if F.1.card ≤ q then
            F.1.card.multichoose (q - F.1.card) else 0) :
    (∀ i, r i ≤ d) ∧
      N = faceCardCount C d ∧
      2 * (∑ i, (r i : ℤ)) = (d : ℤ) * N := by
  obtain ⟨hr, hN, hsum⟩ :=
    degreeStatistics_of_multichoose_identity C hbound r h
  refine ⟨hr, hN, ?_⟩
  have hincNat :=
    two_mul_ridgeCardCount_eq_card_mul_faceCardCount C hd hpm
  have hinc :
      (2 : ℤ) * ridgeCardCount C d =
        (d : ℤ) * faceCardCount C d := by
    exact_mod_cast hincNat
  rw [hsum, hN]
  linarith

