    (q : ℕ) :
    SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q =
      Submodule.span (K_ReductionGrading k n m)
        (Set.range fun i : DegreeIndex r q ↦
          faceRingModelToReduction k D (b i.1)) := by
  letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
    faceRingModelCanonicalModule k D
  apply le_antisymm
  · rintro _ ⟨p, hp, rfl⟩
    change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D) p ∈ _
    rw [← reduction_mk_facePart k D p]
    exact faceRingModelToReduction_mem_span_degree_of_homogeneous
      k D b r hb _
        (polynomialFacePart_isHomogeneous (K_ReductionGrading k n m)
          (AugmentedComplex.ofAbstract D) p hp)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change Ideal.Quotient.mk (SimplicialSphereAnisotropicity.genericReductionIdeal k D)
        (faceRingModelToPolynomial (K_ReductionGrading k n m)
          (AugmentedComplex.ofAbstract D) (b i.1)) ∈
      SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q
    refine ⟨faceRingModelToPolynomial (K_ReductionGrading k n m)
      (AugmentedComplex.ofAbstract D) (b i.1), ?_, rfl⟩
    change (faceRingModelToPolynomial (K_ReductionGrading k n m)
      (AugmentedComplex.ofAbstract D) (b i.1)).IsHomogeneous q
    simpa only [i.2] using
      (faceRingModelToPolynomial_isHomogeneous
        (K_ReductionGrading k n m) (AugmentedComplex.ofAbstract D) (b i.1) (hb i.1))

set_option linter.style.haveILetI false in
noncomputable def quotientDegreeBasis
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionGrading k n m) (Model_ReductionGrading k n m D))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous (K_ReductionGrading k n m)
      (AugmentedComplex.ofAbstract D) (r i) (b i))
    (hdet : IsUnit (faceRingBrionResidueGramMatrix
      k D hd hpm b).det) (q : ℕ) :
    Module.Basis (DegreeIndex r q) (K_ReductionGrading k n m)
      (SimplicialSphereAnisotropicity.quotientDegree (n := n) k D q) := by
  letI : Module (T_ReductionGrading k n m) (Model_ReductionGrading k n m D) :=
    faceRingModelCanonicalModule k D
  let a : DegreeIndex r q →
