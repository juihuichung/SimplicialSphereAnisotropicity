/-- A face-ring model vector is homogeneous when every allowed exponent in
its support has the same total degree. -/
def FaceRingModelHomogeneous
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ)
    (z : FaceRingModel K C) : Prop :=
  ∀ a ∈ z.support, a.1.degree = r

theorem faceRingModelHomogeneous_single
    (K : Type u) [Field K] {m r : ℕ}
    (C : AugmentedComplex (Fin m))
    (a : AllowedExponent C) (c : K)
    (ha : a.1.degree = r) :
    FaceRingModelHomogeneous K C r (Finsupp.single a c) := by
  intro b hb
  rw [Finsupp.mem_support_iff] at hb
  by_cases hba : b = a
  · simpa [hba] using ha
  · simp [hba] at hb

set_option linter.style.haveILetI false in
theorem exists_finset_homogeneous_faceRingModel_span
    (k : Type u) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy (AugmentedComplex.ofAbstract D) (n + 1))
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    ∃ S : Finset (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)),
      Submodule.span (Generic.ParameterRing k n m)
        (↑S : Set (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D))) = ⊤ ∧
      ∀ z ∈ S, ∃ r : ℕ,
        FaceRingModelHomogeneous
          (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) r z := by
  classical
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  letI : Module.Finite (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonical_finite k D hbound hall
  obtain ⟨G, hG⟩ := Module.Finite.fg_top
    (R := Generic.ParameterRing k n m)
    (M := FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D))
  let S : Finset (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :=
    G.biUnion fun z ↦ z.support.image fun a ↦ Finsupp.single a (z a)
  refine ⟨S, ?_, ?_⟩
  · apply top_unique
    rw [← hG]
    apply Submodule.span_le.mpr
    intro z hz
    have hzG : z ∈ G := by simpa using hz
    rw [← Finsupp.sum_single z]
    apply Submodule.sum_mem
    intro a ha
    apply Submodule.subset_span
    change Finsupp.single a (z a) ∈ S
    simp only [S, Finset.mem_biUnion]
    exact ⟨z, hzG, Finset.mem_image.mpr ⟨a, ha, rfl⟩⟩
  · intro z hz
    obtain ⟨g, hg, hzg⟩ := Finset.mem_biUnion.mp hz
    obtain ⟨a, ha, hza⟩ := Finset.mem_image.mp hzg
    subst z
    exact ⟨a.1.degree,
      faceRingModelHomogeneous_single
        (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
        a (g a) rfl⟩

end SimplicialSphereAnisotropicity.StanleyReisner

