            F.1.card.multichoose (q - F.1.card) else 0 :=
      card_faceRingDegreeIndex (AugmentedComplex.ofAbstract D)

set_option linter.style.haveILetI false in
theorem exists_hilbert_multichoose_identity
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy (AugmentedComplex.ofAbstract D) (n + 1))
    (hpure : ∀ {F : Finset (Fin m)},
      F ∈ AugmentedComplex.ofAbstract D →
        ∃ G : Finset (Fin m), G ∈ AugmentedComplex.ofAbstract D ∧
          F ⊆ G ∧ G.card = n + 1)
    (hall : IsAllLinkHomologySphere
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (n + 1)) :
    ∃ (N : ℕ) (r : Fin N → ℕ), ∀ q,
      (∑ i, if r i ≤ q then
          (n + 1).multichoose (q - r i) else 0) =
        ∑ F : ComplexFace (AugmentedComplex.ofAbstract D),
          if F.1.card ≤ q then
            F.1.card.multichoose (q - F.1.card) else 0 := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  obtain ⟨N, b, r, hb⟩ :=
    exists_homogeneous_faceRingModel_basisObject
      k D hbound hpure hall
  exact ⟨N, r, fun q ↦
    homogeneous_faceRingModel_basis_multichoose_identity
      k D b r hb q⟩

