section

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

noncomputable def singularCarrierComparison
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C) ⟶
      augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) :=
  augmentedLiftedSmallToSmall K C ≫ augmentedReverse K C ≫
    augmentedAffineFaceMap K C

noncomputable def singularCarrierInclusion
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C) ⟶
      augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) :=
  augmentedSmallSingularInclusion K (liftedOpenStar.{u} C)

noncomputable def singularCarrierCorrection
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) : (q : ℕ) →
    ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 1) :=
  fun q ↦ Nat.rec
    (motive := fun q ↦
      ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 1))
    (fun σ ↦ localAffineReverseChain K C σ + localOriginalChain K C σ)
    (fun q _ σ ↦
      localAffineReverseChain K C σ + localOriginalChain K C σ +
        ∑ i : Fin (q + 2),
          ((augmentedSingularMap K
            (liftedPreGeomMapOfLE
              (liftedSupportCarrier_face_le C σ i))).f
                (q + 2)).hom
            (singularCarrierHomotopyLocalOn K C q
              ((liftedStarSmallSingularSSet.{u} C).δ i σ)))
    q

theorem singularCarrierHomotopyLocalOn_eq_contraction
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    singularCarrierHomotopyLocalOn K C q σ =
      ((liftedSupportCarrierAugmentedContraction K C σ).hom
        (q + 1) (q + 2)).hom (singularCarrierCorrection K C q σ) := by
  rcases q with _ | q <;> rfl

noncomputable def singularCarrierHomotopyOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X (q + 2) :=
  ((augmentedSingularMap K
    (liftedPreGeomMapOfLE
      (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
        (q + 2)).hom
    (singularCarrierHomotopyLocalOn K C q σ)

noncomputable def singularCarrierHomotopyGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ModuleCat.of K K ⟶
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).X (q + 1) :=
  ModuleCat.ofHom
    (LinearMap.toSpanSingleton K _ (singularCarrierHomotopyOn K C σ))

noncomputable def singularCarrierHomotopyDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (sSetChainComplex K (liftedStarSmallSingularSSet.{u} C)).X q ⟶
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).X (q + 1) :=
  Sigma.desc (singularCarrierHomotopyGenerator K C)

@[reassoc]
theorem iota_singularCarrierHomotopyDegree
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
        ModuleCat.of K K ⟶
          (sSetChainComplex K
            (liftedStarSmallSingularSSet.{u} C)).X q) ≫
        singularCarrierHomotopyDegree K C q =
      singularCarrierHomotopyGenerator K C σ := by
  exact Sigma.ι_desc _ σ

theorem iota_singularCarrierHomotopyDegree_apply_one
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (singularCarrierHomotopyDegree K C q).hom
        ((((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
          ModuleCat.of K K ⟶
            (sSetChainComplex K
              (liftedStarSmallSingularSSet.{u} C)).X q)).hom 1) =
      singularCarrierHomotopyOn K C σ := by
  have h := congrArg (fun f ↦ f.hom (1 : K))
    (iota_singularCarrierHomotopyDegree K C σ)
  rw [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  change _ = (LinearMap.toSpanSingleton K _
    (singularCarrierHomotopyOn K C σ)) 1 at h
  rw [LinearMap.toSpanSingleton_apply_one] at h
  exact h

noncomputable def singularCarrierSmallGeneratorOn
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X (q + 1) :=
  (ιAugmentedSSet K (liftedStarSmallSingularSSet.{u} C) σ).hom 1

noncomputable def singularCarrierComparisonOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X (q + 1) :=
  (affineFaceDegree K C q).hom
    (reverseOn K C (liftedSmallToSmall C σ))

noncomputable def singularCarrierOriginalOn
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X (q + 1) :=
  (ιAugmentedSSet K
    (singularSSet (liftedPreGeomTop.{u} C)) σ.1).hom 1

noncomputable def singularCarrierHomotopyLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a →ₗ[K]
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X (a + 1) :=
  match a with
  | 0 => 0
  | q + 1 => (singularCarrierHomotopyDegree K C q).hom

@[simp]
theorem singularCarrierHomotopyLinear_smallGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    singularCarrierHomotopyLinear K C (q + 1)
        (singularCarrierSmallGeneratorOn K C σ) =
      singularCarrierHomotopyOn K C σ := by
  exact iota_singularCarrierHomotopyDegree_apply_one K C σ

noncomputable def singularCarrierComparisonRawLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a →ₗ[K]
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X a :=
  match a with
  | 0 => LinearMap.id
  | q + 1 => (affineFaceDegree K C q).hom.comp
      ((reverseDegree K C q).hom.comp
        (liftedSmallToSmallDegree K C q).hom)

noncomputable def singularCarrierInclusionRawLinear
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a →ₗ[K]
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X a :=
  match a with
  | 0 => LinearMap.id
  | q + 1 =>
      ((SSet.chainComplexMap
        (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
        (ModuleCat.of K K)).f q).hom

noncomputable def singularCarrierBoundaryOn
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X q :=
  ((augmentedSmallSingularChainComplex K
    (liftedOpenStar.{u} C)).d (q + 1) q).hom
      (singularCarrierSmallGeneratorOn K C σ)

@[simp]
theorem singularCarrierComparisonRawLinear_smallGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    singularCarrierComparisonRawLinear K C (q + 1)
        (singularCarrierSmallGeneratorOn K C σ) =
      singularCarrierComparisonOn K C σ := by
  change (affineFaceDegree K C q).hom
      ((reverseDegree K C q).hom
        ((liftedSmallToSmallDegree K C q).hom
          ((((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
            ModuleCat.of K K ⟶
              (sSetChainComplex K
                (liftedStarSmallSingularSSet.{u} C)).X q)).hom 1))) = _
  have hlow := congrArg (fun f ↦ f.hom (1 : K))
    (iota_liftedSmallToSmallDegree K C σ)
  change (liftedSmallToSmallDegree K C q).hom
      ((((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
        ModuleCat.of K K ⟶
          (sSetChainComplex K
            (liftedStarSmallSingularSSet.{u} C)).X q)).hom 1) =
    ((((starSmallSingularSSet C).ιChainComplex
      (liftedSmallToSmall C σ) : ModuleCat.of K K ⟶
        ((starSmallSingularSSet C).chainComplex
          (ModuleCat.of K K)).X q)).hom 1) at hlow
  rw [hlow]
  have hrev := congrArg (fun f ↦ f.hom (1 : K))
    (iota_reverseDegree K C q (liftedSmallToSmall C σ))
  change (reverseDegree K C q).hom
      ((((starSmallSingularSSet C).ιChainComplex
        (liftedSmallToSmall C σ) : ModuleCat.of K K ⟶
          ((starSmallSingularSSet C).chainComplex
            (ModuleCat.of K K)).X q)).hom 1) =
    (reverseGenerator K C (liftedSmallToSmall C σ)).hom 1 at hrev
  rw [hrev]
  change (affineFaceDegree K C q).hom
      ((LinearMap.toSpanSingleton K _
        (reverseOn K C (liftedSmallToSmall C σ))) 1) = _
  rw [LinearMap.toSpanSingleton_apply_one]
  rfl

@[simp]
theorem singularCarrierInclusionRawLinear_smallGenerator
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    singularCarrierInclusionRawLinear K C (q + 1)
        (singularCarrierSmallGeneratorOn K C σ) =
      singularCarrierOriginalOn K C σ := by
  let X := liftedStarSmallSingularSSet.{u} C
  let Y := singularSSet (liftedPreGeomTop.{u} C)
  let f := (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
  have hmorph :
      (X.ιChainComplex σ : ModuleCat.of K K ⟶
        (sSetChainComplex K X).X q) ≫
          (SSet.chainComplexMap f (ModuleCat.of K K)).f q =
        Y.ιChainComplex σ.1 := by
    rw [SSet.ι_chainComplexMap_f]
    rfl
  have h := congrArg (fun g ↦ g.hom (1 : K)) hmorph
  rw [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  exact h

@[simp]
theorem singularCarrierBoundaryOn_zero
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋0⦌) :
    (show K from singularCarrierBoundaryOn K C σ) = 1 := by
  have h := congrArg (fun f ↦ f.hom (1 : K))
    (ιAugmentedSSet_d_one_zero K
      (liftedStarSmallSingularSSet.{u} C) σ)
  exact h

theorem singularCarrierBoundaryOn_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q + 1⦌) :
    singularCarrierBoundaryOn K C σ =
      ∑ i : Fin (q + 2), singularCarrierSmallGeneratorOn K C
        ((liftedStarSmallSingularSSet.{u} C).δ i σ) := by
  have h := congrArg (fun f ↦ f.hom (1 : K))
    (iota_chainComplex_d_charTwo_sameUniverse K
      (liftedStarSmallSingularSSet.{u} C) q σ)
  rw [ModuleCat.hom_comp, ModuleCat.hom_sum,
    LinearMap.comp_apply, LinearMap.sum_apply] at h
  exact h

theorem liftedPreGeomMapOfLE_comp
    {m : ℕ} {B L C : PreAbstractSimplicialComplex (Fin m)}
    (hBL : B ≤ L) (hLC : L ≤ C) (hBC : B ≤ C) :
    liftedPreGeomMapOfLE.{u} hBL ≫ liftedPreGeomMapOfLE hLC =
      liftedPreGeomMapOfLE hBC := by
  ext x
  apply (preGeomTop C).uliftFunctorObjHomeo.symm.injective
  apply Subtype.ext
  rfl

theorem liftedSupportCarrier_face_ambient_comp {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q + 1⦌)
    (i : Fin (q + 2)) :
    liftedPreGeomMapOfLE (liftedSupportCarrier_face_le C σ i) ≫
        liftedPreGeomMapOfLE
          (supportCarrier_le C (liftedSmallToSmall C σ).1) =
      liftedPreGeomMapOfLE
        (supportCarrier_le C
          (liftedSmallToSmall C
            ((liftedStarSmallSingularSSet.{u} C).δ i σ)).1) := by
  exact liftedPreGeomMapOfLE_comp _ _ _

theorem singularCarrierFaceFiller_map_ambient
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q + 1⦌)
    (i : Fin (q + 2)) :
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
          (q + 2)).hom
      (((augmentedSingularMap K
        (liftedPreGeomMapOfLE
          (liftedSupportCarrier_face_le C σ i))).f
            (q + 2)).hom
        (singularCarrierHomotopyLocalOn K C q
          ((liftedStarSmallSingularSSet.{u} C).δ i σ))) =
      singularCarrierHomotopyOn K C
        ((liftedStarSmallSingularSSet.{u} C).δ i σ) := by
  let f := liftedPreGeomMapOfLE (liftedSupportCarrier_face_le C σ i)
  let g := liftedPreGeomMapOfLE
    (supportCarrier_le C (liftedSmallToSmall C σ).1)
  let h := liftedPreGeomMapOfLE
    (supportCarrier_le C
      (liftedSmallToSmall C
        ((liftedStarSmallSingularSSet.{u} C).δ i σ)).1)
  have hmaps : augmentedSingularMap K f ≫ augmentedSingularMap K g =
      augmentedSingularMap K h := by
    rw [← augmentedSingularMap_comp_probe]
    congr 1
  have hcomponent := congrArg
    (fun F ↦ (F.f (q + 2)).hom
      (singularCarrierHomotopyLocalOn K C q
        ((liftedStarSmallSingularSSet.{u} C).δ i σ))) hmaps
  simpa only [f, g, h, HomologicalComplex.comp_f, ModuleCat.hom_comp,
    LinearMap.comp_apply, singularCarrierHomotopyOn] using hcomponent

theorem singularCarrierCorrection_map_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
          (q + 1)).hom (singularCarrierCorrection K C q σ) =
      singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ +
        singularCarrierHomotopyLinear K C q
          (singularCarrierBoundaryOn K C σ) := by
  rcases q with _ | q
  · change ((augmentedSingularMap K
        (liftedPreGeomMapOfLE
          (supportCarrier_le C (liftedSmallToSmall C σ).1))).f 1).hom
        (localAffineReverseChain K C σ + localOriginalChain K C σ) =
      singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ + 0
    rw [map_add, localAffineReverseChain_map_inclusion,
      localOriginalChain_map_inclusion, add_zero]
    rfl
  · rw [singularCarrierBoundaryOn_succ]
    change ((augmentedSingularMap K
        (liftedPreGeomMapOfLE
          (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
            (q + 2)).hom
        (localAffineReverseChain K C σ + localOriginalChain K C σ +
          ∑ i : Fin (q + 2),
            ((augmentedSingularMap K
              (liftedPreGeomMapOfLE
                (liftedSupportCarrier_face_le C σ i))).f
                  (q + 2)).hom
              (singularCarrierHomotopyLocalOn K C q
                ((liftedStarSmallSingularSSet.{u} C).δ i σ))) =
      singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ +
        singularCarrierHomotopyLinear K C (q + 1)
          (∑ i : Fin (q + 2), singularCarrierSmallGeneratorOn K C
            ((liftedStarSmallSingularSSet.{u} C).δ i σ))
    rw [map_add, map_add, localAffineReverseChain_map_inclusion,
      localOriginalChain_map_inclusion, map_sum, map_sum]
    apply congrArg (fun z ↦ singularCarrierComparisonOn K C σ +
      singularCarrierOriginalOn K C σ + z)
    apply Finset.sum_congr rfl
    intro i hi
    rw [singularCarrierHomotopyLinear_smallGenerator]
    exact singularCarrierFaceFiller_map_ambient K C σ i

@[simp]
theorem singularCarrierComparison_f_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (singularCarrierComparison K C).f 0 = 𝟙 (ModuleCat.of K K) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro (a : K)
  change affineFaceZeroLinear K C ((faceEmptyDegree K C).hom a) = a
  change affineFaceZeroLinear K C
      ((LinearMap.toSpanSingleton K _
        (Finsupp.single
          (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1)) a) = a
  rw [LinearMap.toSpanSingleton_apply]
  simp only [Finsupp.smul_single, smul_eq_mul, mul_one]
  exact affineFaceZeroLinear_single K C _ a

theorem singularCarrierComparison_f_apply_eq_raw
    (K : Type u) [Field K] [CharP K 2] {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (x : (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a) :
    ((singularCarrierComparison K C).f a).hom x =
      singularCarrierComparisonRawLinear K C a x := by
  rcases a with _ | q
  · rw [singularCarrierComparison_f_zero]
    rfl
  · rfl

theorem singularCarrierInclusion_f_apply_eq_raw
    (K : Type u) [Field K] {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (x : (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a) :
    ((singularCarrierInclusion K C).f a).hom x =
      singularCarrierInclusionRawLinear K C a x := by
  rcases a with _ | q <;> rfl

theorem singularCarrierComparisonOn_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 1) q).hom
        (singularCarrierComparisonOn K C σ) =
      singularCarrierComparisonRawLinear K C q
        (singularCarrierBoundaryOn K C σ) := by
  have hcomm := (singularCarrierComparison K C).comm (q + 1) q
  have h := congrArg (fun f ↦ f.hom
    (singularCarrierSmallGeneratorOn K C σ)) hcomm
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  rw [singularCarrierComparison_f_apply_eq_raw,
    singularCarrierComparison_f_apply_eq_raw,
    singularCarrierComparisonRawLinear_smallGenerator] at h
  exact h

theorem singularCarrierOriginalOn_boundary
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 1) q).hom
        (singularCarrierOriginalOn K C σ) =
      singularCarrierInclusionRawLinear K C q
        (singularCarrierBoundaryOn K C σ) := by
  have hcomm := (singularCarrierInclusion K C).comm (q + 1) q
  have h := congrArg (fun f ↦ f.hom
    (singularCarrierSmallGeneratorOn K C σ)) hcomm
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  rw [singularCarrierInclusion_f_apply_eq_raw,
    singularCarrierInclusion_f_apply_eq_raw,
    singularCarrierInclusionRawLinear_smallGenerator] at h
  exact h

noncomputable def singularCarrierHomotopyAugmentedDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a ⟶
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X (a + 1) :=
  match a with
  | 0 => 0
  | q + 1 => singularCarrierHomotopyDegree K C q

@[simp]
theorem singularCarrierHomotopyAugmentedDegree_hom
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (singularCarrierHomotopyAugmentedDegree K C a).hom =
      singularCarrierHomotopyLinear K C a := by
  rcases a with _ | q <;> rfl

noncomputable def singularCarrierHomotopyPrevBoundary
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X a ⟶
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).X a :=
  match a with
  | 0 => 0
  | q + 1 =>
      (augmentedSmallSingularChainComplex K
        (liftedOpenStar.{u} C)).d (q + 1) q ≫
          singularCarrierHomotopyAugmentedDegree K C q

def SingularCarrierHomotopyEquation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) : Prop :=
  singularCarrierHomotopyAugmentedDegree K C a ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d (a + 1) a +
      singularCarrierHomotopyPrevBoundary K C a =
    (singularCarrierComparison K C).f a +
      (singularCarrierInclusion K C).f a

theorem singularCarrierHomotopyEquation_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    SingularCarrierHomotopyEquation K C 0 := by
  rw [SingularCarrierHomotopyEquation]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro (a : K)
  simp only [singularCarrierHomotopyAugmentedDegree,
    singularCarrierHomotopyPrevBoundary, zero_comp, zero_add,
    singularCarrierComparison_f_zero, singularCarrierInclusion,
    augmentedSmallSingularInclusion_f_zero, ModuleCat.hom_zero]
  change 0 = a + a
  exact (charTwo_module_add_self_eq_zero K a).symm

theorem singularCarrierHomotopyPrevBoundary_on_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (singularCarrierHomotopyPrevBoundary K C q).hom
      (singularCarrierBoundaryOn K C σ) = 0 := by
  rcases q with _ | q
  · rfl
  · let S := augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C)
    have hsq := S.d_comp_d (q + 2) (q + 1) q
    have hz := congrArg (fun f ↦ f.hom
      (singularCarrierSmallGeneratorOn K C σ)) hsq
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply,
      ModuleCat.hom_zero, LinearMap.zero_apply] at hz
    change (singularCarrierHomotopyAugmentedDegree K C q).hom
      ((S.d (q + 1) q).hom
        ((S.d (q + 2) (q + 1)).hom
          (singularCarrierSmallGeneratorOn K C σ))) = 0
    rw [hz, map_zero]

theorem augmentedSingularMap_liftedPreGeomMapOfLE_injective_all
    (K : Type u) [Field K] {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (a : ℕ) :
    Function.Injective
      ((augmentedSingularMap K (liftedPreGeomMapOfLE.{u} h)).f a) := by
  rcases a with _ | q
  · rw [augmentedSingularMap_f_zero]
    exact Function.injective_id
  · exact augmentedSingularMap_liftedPreGeomMapOfLE_injective K h q

theorem singularCarrierCorrection_cycle_of_equation
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (heq : SingularCarrierHomotopyEquation K C q)
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
        (q + 1) q).hom (singularCarrierCorrection K C q σ) = 0 := by
  let S := augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C)
  let T := augmentedSingularChainComplex K (liftedPreGeomTop.{u} C)
  let x : S.X q := singularCarrierBoundaryOn K C σ
  have hlower :
      (singularCarrierHomotopyPrevBoundary K C q).hom x = 0 := by
    exact singularCarrierHomotopyPrevBoundary_on_boundary K C σ
  have hx := congrArg (fun f ↦ f.hom x) heq
  simp only [ModuleCat.hom_add, ModuleCat.hom_comp,
    LinearMap.add_apply, LinearMap.comp_apply] at hx
  rw [singularCarrierHomotopyAugmentedDegree_hom,
    singularCarrierComparison_f_apply_eq_raw,
    singularCarrierInclusion_f_apply_eq_raw, hlower, add_zero] at hx
  let hLC := supportCarrier_le C (liftedSmallToSmall C σ).1
  let inc := augmentedSingularMap K (liftedPreGeomMapOfLE.{u} hLC)
  apply augmentedSingularMap_liftedPreGeomMapOfLE_injective_all K hLC q
  rw [map_zero]
  have hcomm := inc.comm (q + 1) q
  have hboundary := congrArg
    (fun f ↦ f.hom (singularCarrierCorrection K C q σ)) hcomm
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at hboundary
  rw [← hboundary, singularCarrierCorrection_map_inclusion,
    map_add, map_add, singularCarrierComparisonOn_boundary,
    singularCarrierOriginalOn_boundary]
  change singularCarrierComparisonRawLinear K C q x +
      singularCarrierInclusionRawLinear K C q x +
      (T.d (q + 1) q).hom
        (singularCarrierHomotopyLinear K C q x) = 0
  rw [hx]
  have hc := charTwo_module_add_self_eq_zero K
    (singularCarrierComparisonRawLinear K C q x)
  have hi := charTwo_module_add_self_eq_zero K
    (singularCarrierInclusionRawLinear K C q x)
  calc
    singularCarrierComparisonRawLinear K C q x +
          singularCarrierInclusionRawLinear K C q x +
        (singularCarrierComparisonRawLinear K C q x +
          singularCarrierInclusionRawLinear K C q x) =
      (singularCarrierComparisonRawLinear K C q x +
          singularCarrierComparisonRawLinear K C q x) +
        (singularCarrierInclusionRawLinear K C q x +
          singularCarrierInclusionRawLinear K C q x) := by
      abel
    _ = 0 := by rw [hc, hi, zero_add]

theorem singularCarrierHomotopyLocalOn_boundary_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌)
    (hcycle :
      ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
          (q + 1) q).hom (singularCarrierCorrection K C q σ) = 0) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
        (q + 2) (q + 1)).hom
          (singularCarrierHomotopyLocalOn K C q σ) =
      singularCarrierCorrection K C q σ := by
  rw [singularCarrierHomotopyLocalOn_eq_contraction]
  exact contraction_fills_cycle K
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ)))
    (liftedSupportCarrierAugmentedContraction K C σ) q
    (singularCarrierCorrection K C q σ) hcycle

theorem singularCarrierHomotopyOn_boundary_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌)
    (hcycle :
      ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
          (q + 1) q).hom (singularCarrierCorrection K C q σ) = 0) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
        (singularCarrierHomotopyOn K C σ) =
      singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ +
        singularCarrierHomotopyLinear K C q
          (singularCarrierBoundaryOn K C σ) := by
  let hLC := supportCarrier_le C (liftedSmallToSmall C σ).1
  let inc := augmentedSingularMap K (liftedPreGeomMapOfLE.{u} hLC)
  have hcomm := inc.comm (q + 2) (q + 1)
  have hboundary := congrArg
    (fun f ↦ f.hom (singularCarrierHomotopyLocalOn K C q σ)) hcomm
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at hboundary
  change ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
        (((inc.f (q + 2)).hom
          (singularCarrierHomotopyLocalOn K C q σ))) = _
  calc
    ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
          ((inc.f (q + 2)).hom
            (singularCarrierHomotopyLocalOn K C q σ)) =
      (inc.f (q + 1)).hom
        (((augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
            (q + 2) (q + 1)).hom
              (singularCarrierHomotopyLocalOn K C q σ)) := hboundary
    _ = (inc.f (q + 1)).hom
        (singularCarrierCorrection K C q σ) := by
      rw [singularCarrierHomotopyLocalOn_boundary_of_cycle K C σ hcycle]
    _ = singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ +
        singularCarrierHomotopyLinear K C q
          (singularCarrierBoundaryOn K C σ) :=
      singularCarrierCorrection_map_inclusion K C σ

@[simp]
theorem singularCarrierHomotopyPrevBoundary_smallGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (singularCarrierHomotopyPrevBoundary K C (q + 1)).hom
        (singularCarrierSmallGeneratorOn K C σ) =
      singularCarrierHomotopyLinear K C q
        (singularCarrierBoundaryOn K C σ) := by
  change (singularCarrierHomotopyAugmentedDegree K C q).hom
      (((augmentedSmallSingularChainComplex K
        (liftedOpenStar.{u} C)).d (q + 1) q).hom
          (singularCarrierSmallGeneratorOn K C σ)) = _
  rw [singularCarrierHomotopyAugmentedDegree_hom]
  rfl

@[simp]
theorem singularCarrierHomotopyPrevBoundary_apply_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (x : (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X (q + 1)) :
    (singularCarrierHomotopyPrevBoundary K C (q + 1)).hom x =
      singularCarrierHomotopyLinear K C q
        (((augmentedSmallSingularChainComplex K
          (liftedOpenStar.{u} C)).d (q + 1) q).hom x) := by
  change (singularCarrierHomotopyAugmentedDegree K C q).hom
      (((augmentedSmallSingularChainComplex K
        (liftedOpenStar.{u} C)).d (q + 1) q).hom x) = _
  rw [singularCarrierHomotopyAugmentedDegree_hom]

theorem singularCarrierHomotopyEquation_succ_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (hcycle : ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
      ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
          (q + 1) q).hom (singularCarrierCorrection K C q σ) = 0) :
    SingularCarrierHomotopyEquation K C (q + 1) := by
  rw [SingularCarrierHomotopyEquation]
  apply SSet.chainComplex_hom_ext
  intro σ
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro a
  have hiota :
      (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
        ModuleCat.of K K ⟶
          (sSetChainComplex K
            (liftedStarSmallSingularSSet.{u} C)).X q).hom a) =
        a • singularCarrierSmallGeneratorOn K C σ := by
    change _ = a •
      (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
        ModuleCat.of K K ⟶
          (sSetChainComplex K
            (liftedStarSmallSingularSSet.{u} C)).X q).hom 1)
    rw [← map_smul]
    simp
  change
    ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
          ((singularCarrierHomotopyAugmentedDegree K C (q + 1)).hom
            (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
              ModuleCat.of K K ⟶
                (sSetChainComplex K
                  (liftedStarSmallSingularSSet.{u} C)).X q).hom a)) +
      (singularCarrierHomotopyPrevBoundary K C (q + 1)).hom
        (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
          ModuleCat.of K K ⟶
            (sSetChainComplex K
              (liftedStarSmallSingularSSet.{u} C)).X q).hom a) =
    ((singularCarrierComparison K C).f (q + 1)).hom
        (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
          ModuleCat.of K K ⟶
            (sSetChainComplex K
              (liftedStarSmallSingularSSet.{u} C)).X q).hom a) +
      ((singularCarrierInclusion K C).f (q + 1)).hom
        (((liftedStarSmallSingularSSet.{u} C).ιChainComplex σ :
          ModuleCat.of K K ⟶
            (sSetChainComplex K
              (liftedStarSmallSingularSSet.{u} C)).X q).hom a)
  rw [hiota, map_smul, map_smul, map_smul, map_smul, map_smul,
    ← smul_add, ← smul_add]
  rw [singularCarrierHomotopyAugmentedDegree_hom,
    singularCarrierHomotopyPrevBoundary_smallGenerator,
    singularCarrierComparison_f_apply_eq_raw,
    singularCarrierInclusion_f_apply_eq_raw]
  rw [singularCarrierHomotopyLinear_smallGenerator,
    singularCarrierHomotopyOn_boundary_of_cycle K C σ (hcycle σ),
    singularCarrierComparisonRawLinear_smallGenerator,
    singularCarrierInclusionRawLinear_smallGenerator]
  have hL := charTwo_module_add_self_eq_zero K
    (singularCarrierHomotopyLinear K C q
      (singularCarrierBoundaryOn K C σ))
  apply congrArg (fun z ↦ a • z)
  calc
    (singularCarrierComparisonOn K C σ +
          singularCarrierOriginalOn K C σ +
          singularCarrierHomotopyLinear K C q
            (singularCarrierBoundaryOn K C σ)) +
        singularCarrierHomotopyLinear K C q
          (singularCarrierBoundaryOn K C σ) =
      singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ +
        (singularCarrierHomotopyLinear K C q
            (singularCarrierBoundaryOn K C σ) +
          singularCarrierHomotopyLinear K C q
            (singularCarrierBoundaryOn K C σ)) := by
      abel
    _ = singularCarrierComparisonOn K C σ +
        singularCarrierOriginalOn K C σ := by rw [hL, add_zero]

theorem singularCarrierHomotopyEquation_and_cycle
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ∀ q : ℕ, SingularCarrierHomotopyEquation K C q ∧
      ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
        ((augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
            (q + 1) q).hom
              (singularCarrierCorrection K C q σ) = 0 := by
  intro q
  induction q with
  | zero =>
      have heq := singularCarrierHomotopyEquation_zero K C
      exact ⟨heq, singularCarrierCorrection_cycle_of_equation K C heq⟩
  | succ q ih =>
      have heq := singularCarrierHomotopyEquation_succ_of_cycle K C ih.2
      exact ⟨heq, singularCarrierCorrection_cycle_of_equation K C heq⟩

theorem singularCarrierHomotopyEquation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    SingularCarrierHomotopyEquation K C q :=
  (singularCarrierHomotopyEquation_and_cycle K C q).1

theorem singularCarrierCorrection_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
        (q + 1) q).hom (singularCarrierCorrection K C q σ) = 0 :=
  (singularCarrierHomotopyEquation_and_cycle K C q).2 σ

theorem singularCarrierHomotopyLocalOn_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).d
        (q + 2) (q + 1)).hom
          (singularCarrierHomotopyLocalOn K C q σ) =
      singularCarrierCorrection K C q σ :=
  singularCarrierHomotopyLocalOn_boundary_of_cycle K C σ
    (singularCarrierCorrection_cycle K C σ)

set_option maxHeartbeats 2000000 in
theorem singularCarrierHomotopyAugmentedDegree_equation_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (augmentedSmallSingularChainComplex K
        (liftedOpenStar.{u} C)).d (q + 1) q ≫
          singularCarrierHomotopyAugmentedDegree K C q +
        singularCarrierHomotopyAugmentedDegree K C (q + 1) ≫
          (augmentedSingularChainComplex K
            (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1) =
      (singularCarrierComparison K C).f (q + 1) -
        (singularCarrierInclusion K C).f (q + 1) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  have heq := singularCarrierHomotopyEquation K C (q + 1)
  have heqx := congrArg (fun f ↦ f.hom x) heq
  simp only [ModuleCat.hom_add, ModuleCat.hom_comp,
    LinearMap.add_apply, LinearMap.comp_apply] at heqx
  rw [singularCarrierHomotopyAugmentedDegree_hom,
    singularCarrierComparison_f_apply_eq_raw,
    singularCarrierInclusion_f_apply_eq_raw,
    singularCarrierHomotopyPrevBoundary_apply_succ] at heqx
  change
    ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
        (singularCarrierHomotopyLinear K C (q + 1) x) +
      singularCarrierHomotopyLinear K C q
        (((augmentedSmallSingularChainComplex K
          (liftedOpenStar.{u} C)).d (q + 1) q).hom x) =
    singularCarrierComparisonRawLinear K C (q + 1) x +
      singularCarrierInclusionRawLinear K C (q + 1) x at heqx
  have hneg :
      -singularCarrierInclusionRawLinear K C (q + 1) x =
        singularCarrierInclusionRawLinear K C (q + 1) x := by
    calc
      -singularCarrierInclusionRawLinear K C (q + 1) x =
          (-1 : K) •
            singularCarrierInclusionRawLinear K C (q + 1) x :=
        (neg_one_smul K _).symm
      _ = (1 : K) •
          singularCarrierInclusionRawLinear K C (q + 1) x := by
        rw [CharTwo.neg_eq]
      _ = singularCarrierInclusionRawLinear K C (q + 1) x :=
        one_smul _ _
  simp only [ModuleCat.hom_add, ModuleCat.hom_comp, ModuleCat.hom_sub,
    singularCarrierHomotopyAugmentedDegree_hom,
    LinearMap.add_apply, LinearMap.comp_apply, LinearMap.sub_apply]
  rw [singularCarrierComparison_f_apply_eq_raw,
    singularCarrierInclusion_f_apply_eq_raw]
  change singularCarrierHomotopyLinear K C q
        (((augmentedSmallSingularChainComplex K
          (liftedOpenStar.{u} C)).d (q + 1) q).hom x) +
      ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom
          (singularCarrierHomotopyLinear K C (q + 1) x) =
    singularCarrierComparisonRawLinear K C (q + 1) x -
      singularCarrierInclusionRawLinear K C (q + 1) x
  rw [sub_eq_add_neg, hneg]
  simpa only [add_comm] using heqx

@[simp]
theorem singularCarrierHomotopyAugmentedDegree_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    singularCarrierHomotopyAugmentedDegree K C 0 = 0 := rfl

noncomputable def singularCarrierHomotopyToPrev
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (i : ℕ) :
    (augmentedSmallSingularChainComplex K
      (liftedOpenStar.{u} C)).X i ⟶
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).xPrev i :=
  match i with
  | 0 => 0
  | r + 1 => singularCarrierHomotopyAugmentedDegree K C (r + 1) ≫
      ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).xPrevIso
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv

@[simp]
theorem singularCarrierHomotopyToPrev_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    singularCarrierHomotopyToPrev K C 0 = 0 := rfl

@[simp]
theorem singularCarrierHomotopyToPrev_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (r : ℕ) :
    singularCarrierHomotopyToPrev K C (r + 1) =
      singularCarrierHomotopyAugmentedDegree K C (r + 1) ≫
        ((augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).xPrevIso
            (show (ComplexShape.down ℕ).Rel
              (r + 2) (r + 1) by rfl)).inv := rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
set_option maxHeartbeats 2000000 in
noncomputable def singularCarrierHomotopy
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    _root_.Homotopy (singularCarrierComparison K C)
      (singularCarrierInclusion K C) := by
  let S := augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C)
  let T := augmentedSingularChainComplex K (liftedPreGeomTop.{u} C)
  let hrel : ∀ i j, (ComplexShape.down ℕ).Rel j i →
      (S.X i ⟶ T.X j) :=
    fun i j hij ↦ singularCarrierHomotopyToPrev K C i ≫
      (T.xPrevIso hij).hom
  have hrel_zero : hrel 0 1 (by rfl) = 0 := by
    dsimp [hrel]
    rw [zero_comp]
  have hrel_succ (r : ℕ) : hrel (r + 1) (r + 2) (by rfl) =
      singularCarrierHomotopyAugmentedDegree K C (r + 1) := by
    dsimp [hrel]
    let hr : (ComplexShape.down ℕ).Rel (r + 2) (r + 1) := by rfl
    change (singularCarrierHomotopyAugmentedDegree K C (r + 1) ≫
        (T.xPrevIso hr).inv) ≫ (T.xPrevIso hr).hom = _
    rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hmap : Homotopy.nullHomotopicMap' hrel =
      singularCarrierComparison K C - singularCarrierInclusion K C := by
    apply HomologicalComplex.hom_ext
    intro i
    rcases i with _ | r
    · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left
          (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
      · rw [hrel_zero, zero_comp, HomologicalComplex.sub_f_apply,
          singularCarrierComparison_f_zero, singularCarrierInclusion,
          augmentedSmallSingularInclusion_f_zero]
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        simp
      · intro l hl
        simp at hl
    · rw [Homotopy.nullHomotopicMap'_f
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)
          (show (ComplexShape.down ℕ).Rel (r + 1) r by rfl)]
      simp only [HomologicalComplex.sub_f_apply]
      rcases r with _ | r
      · rw [hrel_zero, comp_zero, hrel_succ]
        simpa only [singularCarrierHomotopyAugmentedDegree_zero,
          comp_zero, zero_add] using
            (singularCarrierHomotopyAugmentedDegree_equation_succ K C 0)
      · rw [hrel_succ r, hrel_succ (r + 1)]
        exact singularCarrierHomotopyAugmentedDegree_equation_succ K C (r + 1)
  have hnull : _root_.Homotopy
      (singularCarrierComparison K C - singularCarrierInclusion K C) 0 := by
    rw [← hmap]
    exact Homotopy.nullHomotopy' hrel
  exact Homotopy.equivSubZero.symm hnull

