theorem sub_C_constantCoeff_mem_idealOfVars
    (K : Type u) [Field K] {d : ℕ}
    (p : MvPolynomial (Fin d) K) :
    p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      MvPolynomial.idealOfVars (Fin d) K := by
  have hpow : p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      MvPolynomial.idealOfVars (Fin d) K ^ 1 := by
    rw [MvPolynomial.mem_pow_idealOfVars_iff']
    intro a ha
    have hdegree : a.degree = 0 := by omega
    have ha0 : a = 0 := (Finsupp.degree_eq_zero_iff a).mp hdegree
    subst a
    simp [MvPolynomial.constantCoeff_eq]
  simpa using hpow

set_option linter.style.haveILetI false in
theorem parameter_smul_sub_constant_mem_positive
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : Generic.ParameterRing k n m)
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    p • z - MvPolynomial.constantCoeff p • z ∈
      faceRingModelPositiveSubmoduleK k D := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  letI : IsScalarTower (SimplicialSphereAnisotropicity.GenericField k n m)
      (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonical_isScalarTower k D
  rw [← faceRingModelCanonical_C_smul k D, ← sub_smul]
  change (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) • z ∈
    faceRingModelPositiveSubmodule k D
  exact Submodule.mem_set_smul_of_mem_mem
    (sub_C_constantCoeff_mem_idealOfVars
      (SimplicialSphereAnisotropicity.GenericField k n m) p)
    (Submodule.mem_top)

set_option linter.style.haveILetI false in
theorem faceRingModelResidue_mk_parameter_smul
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (p : Generic.ParameterRing k n m)
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :
    letI : Module (Generic.ParameterRing k n m)
