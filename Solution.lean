          rw [MvPolynomial.homogeneousComponent_of_mem hp, if_neg hdiff,
            zero_smul]
        · rw [dif_neg hrle]
  | add p₁ p₂ ih₁ ih₂ =>
      rw [add_smul, LinearMap.map_add, ih₁, ih₂]
      by_cases hrle : r ≤ q
      · rw [dif_pos hrle, dif_pos hrle, dif_pos hrle,
          LinearMap.map_add, add_smul]
      · rw [dif_neg hrle, dif_neg hrle, dif_neg hrle, add_zero]

