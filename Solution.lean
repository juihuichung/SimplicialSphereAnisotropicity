noncomputable instance finsuppDegreeFintype
    (α : Type*) [Fintype α] (q : ℕ) :
    Fintype {a : α →₀ ℕ // a.degree = q} :=
  (Finsupp.finite_of_degree_eq q).fintype

noncomputable def finsuppDegreeEquivAntidiag
    (α : Type*) [Fintype α] [DecidableEq α] (q : ℕ) :
    {a : α →₀ ℕ // a.degree = q} ≃
      (Finset.univ : Finset α).finsuppAntidiag q where
  toFun a := ⟨a.1, by
    rw [Finset.mem_finsuppAntidiag]
    constructor
    · simpa [Finsupp.degree_eq_sum] using a.2
    · simp⟩
  invFun a := ⟨a.1, by
    have ha := (Finset.mem_finsuppAntidiag.mp a.2).1
    simpa [Finsupp.degree_eq_sum] using ha⟩
  left_inv a := by
    apply Subtype.ext
    rfl
  right_inv a := by
    apply Subtype.ext
    rfl

theorem card_finsupp_degree_eq
    (α : Type*) [Fintype α] (q : ℕ) :
    Fintype.card {a : α →₀ ℕ // a.degree = q} =
      (Fintype.card α).multichoose q := by
  classical
  calc
    Fintype.card {a : α →₀ ℕ // a.degree = q} =
        Fintype.card ((Finset.univ : Finset α).finsuppAntidiag q) :=
      Fintype.card_congr (finsuppDegreeEquivAntidiag α q)
    _ = (Fintype.card α).multichoose q := by
      simpa using Finset.card_finsuppAntidiag_nat_eq_multichoose
        (s := (Finset.univ : Finset α)) q

abbrev WeightedDegreeFiber (d s q : ℕ) :=
  {a : Fin d →₀ ℕ // s + a.degree = q}

noncomputable instance weightedDegreeFiberFintype (d s q : ℕ) :
    Fintype (WeightedDegreeFiber d s q) := by
  let E := {a : Fin d →₀ ℕ // a.degree ≤ q}
  letI : Fintype E := (Finsupp.finite_of_degree_le q).fintype
  let f : WeightedDegreeFiber d s q → E := fun a ↦
    ⟨a.1, by omega⟩
  letI : Finite (WeightedDegreeFiber d s q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      exact congrArg (fun z : E ↦ z.1) h)
  exact Fintype.ofFinite _

noncomputable def weightedDegreeFiberEquiv
    {d s q : ℕ} (h : s ≤ q) :
    WeightedDegreeFiber d s q ≃
      {a : Fin d →₀ ℕ // a.degree = q - s} where
  toFun a := ⟨a.1, by omega⟩
  invFun a := ⟨a.1, by omega⟩
  left_inv a := by
    apply Subtype.ext
    rfl
  right_inv a := by
    apply Subtype.ext
    rfl

set_option linter.style.haveILetI false in
theorem card_weightedDegreeFiber (d s q : ℕ) :
    Fintype.card (WeightedDegreeFiber d s q) =
      if s ≤ q then d.multichoose (q - s) else 0 := by
  by_cases hsq : s ≤ q
  · rw [if_pos hsq]
    letI : Fintype {a : Fin d →₀ ℕ // a.degree = q - s} :=
      (Finsupp.finite_of_degree_eq (q - s)).fintype
    rw [Fintype.card_congr (weightedDegreeFiberEquiv hsq)]
    simpa using card_finsupp_degree_eq (Fin d) (q - s)
  · rw [if_neg hsq]
    apply Fintype.card_eq_zero_iff.mpr
    exact ⟨fun a ↦ hsq (by omega)⟩

noncomputable def weightedFreeDegreeIndexEquivSigma
    (d N : ℕ) (r : Fin N → ℕ) (q : ℕ) :
    WeightedFreeDegreeIndex d N r q ≃
      Σ i : Fin N, WeightedDegreeFiber d (r i) q where
  toFun ia := ⟨ia.1.1, ⟨ia.1.2, ia.2⟩⟩
  invFun ia := ⟨⟨ia.1, ia.2.1⟩, ia.2.2⟩
  left_inv ia := by
    apply Subtype.ext
    rfl
  right_inv ia := by
    cases ia
    rfl

theorem card_weightedFreeDegreeIndex
    (d N : ℕ) (r : Fin N → ℕ) (q : ℕ) :
    Fintype.card (WeightedFreeDegreeIndex d N r q) =
      ∑ i, if r i ≤ q then d.multichoose (q - r i) else 0 := by
  rw [Fintype.card_congr (weightedFreeDegreeIndexEquivSigma d N r q),
    Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro i _hi
  exact card_weightedDegreeFiber d (r i) q

abbrev ExactSupportDegree {α : Type*}
    (F : Finset α) (q : ℕ) :=
  {a : α →₀ ℕ // a.support = F ∧ a.degree = q}

noncomputable instance exactSupportDegreeFintype
    {α : Type*} [Fintype α] (F : Finset α) (q : ℕ) :
    Fintype (ExactSupportDegree F q) := by
  let E := {a : α →₀ ℕ // a.degree = q}
  let f : ExactSupportDegree F q → E := fun a ↦ ⟨a.1, a.2.2⟩
  letI : Finite (ExactSupportDegree F q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      exact congrArg (fun z : E ↦ z.1) h)
  exact Fintype.ofFinite _

abbrev PositiveComposition {α : Type*}
    (F : Finset α) (q : ℕ) :=
  {f : F → ℕ // (∀ i, 0 < f i) ∧ ∑ i, f i = q}

abbrev NatComposition {α : Type*}
    (F : Finset α) (q : ℕ) :=
  {f : F → ℕ // ∑ i, f i = q}

noncomputable instance natCompositionFintype {α : Type*}
    [Fintype α] (F : Finset α) (q : ℕ) :
    Fintype (NatComposition F q) := by
  let E := F → Fin (q + 1)
  let f : NatComposition F q → E := fun a i ↦
    ⟨a.1 i, by
      have hle : a.1 i ≤ ∑ j, a.1 j :=
        Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
      omega⟩
  letI : Finite (NatComposition F q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      funext i
      exact congrArg (fun z : E ↦ (z i).1) h)
  exact Fintype.ofFinite _

noncomputable instance positiveCompositionFintype {α : Type*}
    [Fintype α] (F : Finset α) (q : ℕ) :
    Fintype (PositiveComposition F q) := by
  let f : PositiveComposition F q → NatComposition F q := fun a ↦
    ⟨a.1, a.2.2⟩
  letI : Finite (PositiveComposition F q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      exact congrArg (fun z : NatComposition F q ↦ z.1) h)
  exact Fintype.ofFinite _

noncomputable def faceFunFinsupp {α : Type*}
    (F : Finset α) (f : F → ℕ) : α →₀ ℕ := by
  classical
  exact Finsupp.onFinset F
    (fun x ↦ if hx : x ∈ F then f ⟨x, hx⟩ else 0) (by
      intro x hx
      by_contra hnot
      simp [hnot] at hx)

@[simp]
theorem faceFunFinsupp_apply_mem {α : Type*}
    (F : Finset α) (f : F → ℕ) {x : α} (hx : x ∈ F) :
    faceFunFinsupp F f x = f ⟨x, hx⟩ := by
  simp [faceFunFinsupp, hx]

theorem faceFunFinsupp_support {α : Type*}
    (F : Finset α) (f : F → ℕ)
    (hf : ∀ i, 0 < f i) :
    (faceFunFinsupp F f).support = F := by
  classical
  ext x
  rw [Finsupp.mem_support_iff]
  by_cases hx : x ∈ F
  · simp [faceFunFinsupp, hx, (hf ⟨x, hx⟩).ne']
  · simp [faceFunFinsupp, hx]

theorem faceFunFinsupp_degree {α : Type*}
    (F : Finset α) (f : F → ℕ)
    (hf : ∀ i, 0 < f i) :
    (faceFunFinsupp F f).degree = ∑ i, f i := by
  rw [Finsupp.degree_apply, faceFunFinsupp_support F f hf]
  simpa [faceFunFinsupp] using
    (Finset.sum_attach F (fun x ↦ faceFunFinsupp F f x)).symm

noncomputable def exactSupportDegreeEquivPositiveComposition
    {α : Type*} [Fintype α] (F : Finset α) (q : ℕ) :
    ExactSupportDegree F q ≃ PositiveComposition F q where
  toFun a := ⟨fun i ↦ a.1 i.1, by
    constructor
    · intro i
      apply Nat.pos_of_ne_zero
      apply Finsupp.mem_support_iff.mp
      rw [a.2.1]
      exact i.2
    · calc
        ∑ i : F, a.1 i.1 = a.1.degree := by
          rw [Finsupp.degree_apply, a.2.1]
          exact Finset.sum_attach F (fun x ↦ a.1 x)
        _ = q := a.2.2⟩
  invFun f := ⟨faceFunFinsupp F f.1, by
    exact ⟨faceFunFinsupp_support F f.1 f.2.1,
      (faceFunFinsupp_degree F f.1 f.2.1).trans f.2.2⟩⟩
  left_inv a := by
    apply Subtype.ext
    ext x
    by_cases hx : x ∈ F
    · simp [faceFunFinsupp, hx]
    · have hxs : x ∉ a.1.support := by
        rwa [a.2.1]
      rw [Finsupp.notMem_support_iff.mp hxs]
      simp [faceFunFinsupp, hx]
  right_inv f := by
    apply Subtype.ext
    funext i
    simp [faceFunFinsupp, i.2]

noncomputable def positiveCompositionEquivNatComposition
    {α : Type*} [Fintype α] (F : Finset α) {q : ℕ}
    (hFq : F.card ≤ q) :
    PositiveComposition F q ≃ NatComposition F (q - F.card) where
  toFun f := ⟨fun i ↦ f.1 i - 1, by
    have hsumadd : (∑ i, (f.1 i - 1)) + F.card = q := by
      calc
        (∑ i, (f.1 i - 1)) + F.card =
            ∑ i, ((f.1 i - 1) + 1) := by
          simp [Finset.sum_add_distrib]
        _ = ∑ i, f.1 i := by
          apply Finset.sum_congr rfl
          intro i _hi
          exact Nat.sub_add_cancel (f.2.1 i)
        _ = q := f.2.2
    calc
      ∑ i, (f.1 i - 1) =
          ((∑ i, (f.1 i - 1)) + F.card) - F.card := by
        rw [Nat.add_sub_cancel]
      _ = q - F.card := congrArg (fun t ↦ t - F.card) hsumadd⟩
  invFun f := ⟨fun i ↦ f.1 i + 1, by
    constructor
    · intro i
      exact Nat.zero_lt_succ (f.1 i)
    · calc
        ∑ i, (f.1 i + 1) = (∑ i, f.1 i) + F.card := by
          simp [Finset.sum_add_distrib]
        _ = (q - F.card) + F.card := by rw [f.2]
        _ = q := Nat.sub_add_cancel hFq⟩
  left_inv f := by
    apply Subtype.ext
    funext i
    exact Nat.sub_add_cancel (f.2.1 i)
  right_inv f := by
    apply Subtype.ext
    funext i
    simp

noncomputable def natCompositionEquivFinsuppDegree
    (α : Type*) [Fintype α] (q : ℕ) :
    {f : α → ℕ // ∑ i, f i = q} ≃
      {a : α →₀ ℕ // a.degree = q} where
  toFun f := ⟨Finsupp.equivFunOnFinite.symm f.1, by
    simpa [Finsupp.degree_eq_sum] using f.2⟩
  invFun a := ⟨Finsupp.equivFunOnFinite a.1, by
    simpa [Finsupp.degree_eq_sum] using a.2⟩
  left_inv f := by
    apply Subtype.ext
    exact Finsupp.equivFunOnFinite.apply_symm_apply f.1
  right_inv a := by
    apply Subtype.ext
    exact Finsupp.equivFunOnFinite.symm_apply_apply a.1

theorem card_exactSupportDegree {α : Type*} [Fintype α]
    (F : Finset α) (q : ℕ) :
    Fintype.card (ExactSupportDegree F q) =
      if F.card ≤ q then F.card.multichoose (q - F.card) else 0 := by
  by_cases hFq : F.card ≤ q
  · rw [if_pos hFq]
    calc
      Fintype.card (ExactSupportDegree F q) =
          Fintype.card (PositiveComposition F q) :=
        Fintype.card_congr
          (exactSupportDegreeEquivPositiveComposition F q)
      _ = Fintype.card (NatComposition F (q - F.card)) :=
        Fintype.card_congr (positiveCompositionEquivNatComposition F hFq)
      _ = Fintype.card
          {a : F →₀ ℕ // a.degree = q - F.card} :=
        Fintype.card_congr
          (natCompositionEquivFinsuppDegree F (q - F.card))
      _ = F.card.multichoose (q - F.card) := by
        simpa using card_finsupp_degree_eq F (q - F.card)
  · rw [if_neg hFq]
    apply Fintype.card_eq_zero_iff.mpr
    refine ⟨fun a ↦ hFq ?_⟩
    calc
      F.card = a.1.support.card := congrArg Finset.card a.2.1.symm
      _ ≤ a.1.degree := by
        rw [Finsupp.degree_apply]
        calc
          a.1.support.card = ∑ _i ∈ a.1.support, 1 := by simp
          _ ≤ ∑ i ∈ a.1.support, a.1 i := by
            apply Finset.sum_le_sum
            intro i hi
            exact Nat.one_le_iff_ne_zero.mpr
              (Finsupp.mem_support_iff.mp hi)
      _ = q := a.2.2

abbrev ComplexFace {m : ℕ} (C : AugmentedComplex (Fin m)) :=
  {F : Finset (Fin m) // F ∈ C}

noncomputable instance complexFaceFintype {m : ℕ}
    (C : AugmentedComplex (Fin m)) : Fintype (ComplexFace C) := by
  let f : ComplexFace C → Finset (Fin m) := fun F ↦ F.1
  letI : Finite (ComplexFace C) :=
    Finite.of_injective f (fun F G h ↦ Subtype.ext h)
  exact Fintype.ofFinite _

noncomputable def faceRingDegreeIndexEquivSigma {m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    FaceRingDegreeIndex C q ≃
      Σ F : ComplexFace C, ExactSupportDegree F.1 q where
  toFun a := ⟨⟨a.1.1.support, a.1.2⟩,
    ⟨a.1.1, rfl, a.2⟩⟩
  invFun Fa := ⟨⟨Fa.2.1, by
    rw [Fa.2.2.1]
    exact Fa.1.2⟩, Fa.2.2.2⟩
  left_inv a := by
    apply Subtype.ext
    apply Subtype.ext
    rfl
  right_inv Fa := by
    rcases Fa with ⟨⟨F, hFC⟩, ⟨a, haF, haq⟩⟩
    dsimp
    change a.support = F at haF
    subst F
    rfl

theorem card_faceRingDegreeIndex {m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    Fintype.card (FaceRingDegreeIndex C q) =
      ∑ F : ComplexFace C,
        if F.1.card ≤ q then
          F.1.card.multichoose (q - F.1.card) else 0 := by
  rw [Fintype.card_congr (faceRingDegreeIndexEquivSigma C),
    Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro F _hF
  exact card_exactSupportDegree F.1 q

set_option linter.style.haveILetI false in
theorem homogeneous_faceRingModel_basis_multichoose_identity
    (k : Type*) [Field k] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
