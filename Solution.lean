theorem augmentedAffineSubdivisionLiftedSmall_inclusion
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedAffineSubdivisionLiftedSmall K C ≫
        augmentedSmallSingularInclusion K (liftedOpenStar.{u} C) =
      augmentedAffineFaceMap K C ≫
        augmentedSingularSubdivisionIter K
          (liftedPreGeomTop.{u} C) 1 := by
  apply HomologicalComplex.hom_ext
  intro i
  rcases i with _ | q
  · simp only [HomologicalComplex.comp_f,
      augmentedAffineSubdivisionLiftedSmall_f_zero,
      augmentedSmallSingularInclusion_f_zero,
      augmentedAffineFaceMap_f_zero]
    change affineFaceZero K C ≫ 𝟙 _ = affineFaceZero K C ≫ 𝟙 _
    rfl
  · simp only [HomologicalComplex.comp_f,
      augmentedAffineSubdivisionLiftedSmall_f_succ,
      augmentedSmallSingularInclusion_f_succ,
      augmentedAffineFaceMap_f_succ]
    change affineSubdivisionLiftedSmallDegree K C q ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      affineFaceDegree K C q ≫
        singularSubdivisionIterDegree K
          (liftedPreGeomTop.{u} C) 1 q
    have hX :
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).X (q + 1) =
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).X q := by
      exact augmentedSSetChainComplex_X_succ K
        (singularSSet (liftedPreGeomTop.{u} C)) q
    cases hX
    exact affineSubdivisionLiftedSmallDegree_inclusion K C q

noncomputable def liftedAdaptiveSmallRetraction
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) ⟶
      augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C) :=
  augmentedAdaptiveRhoSmall K (liftedPreGeomTop.{u} C)
    (liftedOpenStar.{u} C) (isOpen_liftedOpenStar C)
    (iUnion_liftedOpenStar C)

noncomputable def liftedAdaptiveRho
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) ⟶
      augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) :=
  augmentedAdaptiveRho K (liftedPreGeomTop.{u} C)
    (liftedOpenStar.{u} C) (isOpen_liftedOpenStar C)
    (iUnion_liftedOpenStar C)

noncomputable def finiteAffineComparison_inv_hom_id
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    _root_.Homotopy
      (liftedAdaptiveFaceRetraction K C ≫ augmentedAffineFaceMap K C)
      (𝟙 (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C))) := by
  have hcarrier : _root_.Homotopy
      (liftedAdaptiveFaceRetraction K C ≫ augmentedAffineFaceMap K C)
      (liftedAdaptiveSmallRetraction K C ≫
        singularCarrierInclusion K C) := by
    simpa only [liftedAdaptiveFaceRetraction,
      liftedAdaptiveSmallRetraction, singularCarrierComparison,
      Category.assoc] using
        (singularCarrierHomotopy K C).compLeft
          (liftedAdaptiveSmallRetraction K C)
  have hstrict : liftedAdaptiveSmallRetraction K C ≫
      singularCarrierInclusion K C = liftedAdaptiveRho K C := by
    simpa only [liftedAdaptiveSmallRetraction, liftedAdaptiveRho,
      singularCarrierInclusion] using
        (augmentedAdaptiveRhoSmall_inclusion K
          (liftedPreGeomTop.{u} C) (liftedOpenStar.{u} C)
          (isOpen_liftedOpenStar C) (iUnion_liftedOpenStar C))
  exact hcarrier.trans ((Homotopy.ofEq hstrict).trans
    (augmentedAdaptiveRhoHomotopy K (liftedPreGeomTop.{u} C)
      (liftedOpenStar.{u} C) (isOpen_liftedOpenStar C)
      (iUnion_liftedOpenStar C)))

theorem affineSubdivision_adaptiveSmall
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (augmentedAffineFaceMap K C ≫
        augmentedSingularSubdivisionIter K
          (liftedPreGeomTop.{u} C) 1) ≫
        liftedAdaptiveSmallRetraction K C =
      augmentedAffineSubdivisionLiftedSmall K C := by
  have hfix :
      augmentedSmallSingularInclusion K (liftedOpenStar.{u} C) ≫
          liftedAdaptiveSmallRetraction K C =
        𝟙 (augmentedSmallSingularChainComplex K
          (liftedOpenStar.{u} C)) := by
    simpa only [liftedAdaptiveSmallRetraction] using
      (augmentedSmallInclusion_adaptiveRhoSmall K
        (liftedPreGeomTop.{u} C) (liftedOpenStar.{u} C)
        (isOpen_liftedOpenStar C) (iUnion_liftedOpenStar C))
  calc
    (augmentedAffineFaceMap K C ≫
          augmentedSingularSubdivisionIter K
            (liftedPreGeomTop.{u} C) 1) ≫
        liftedAdaptiveSmallRetraction K C =
      (augmentedAffineSubdivisionLiftedSmall K C ≫
          augmentedSmallSingularInclusion K (liftedOpenStar.{u} C)) ≫
        liftedAdaptiveSmallRetraction K C := by
      rw [augmentedAffineSubdivisionLiftedSmall_inclusion]
    _ = augmentedAffineSubdivisionLiftedSmall K C ≫
        (augmentedSmallSingularInclusion K (liftedOpenStar.{u} C) ≫
          liftedAdaptiveSmallRetraction K C) := by
      rw [Category.assoc]
    _ = augmentedAffineSubdivisionLiftedSmall K C ≫ 𝟙 _ := by
      rw [hfix]
    _ = augmentedAffineSubdivisionLiftedSmall K C := by simp

noncomputable def finiteAffineComparison_hom_inv_id
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    _root_.Homotopy
      (augmentedAffineFaceMap K C ≫ liftedAdaptiveFaceRetraction K C)
      (𝟙 (faceChainComplex K (AugmentedComplex.ofPre C))) := by
  let tail := liftedAdaptiveSmallRetraction K C ≫
    augmentedLiftedSmallToSmall K C ≫ augmentedReverse K C
  have hsub :=
    ((augmentedSingularSubdivisionHomotopy K
      (liftedPreGeomTop.{u} C) 1).compLeft
        (augmentedAffineFaceMap K C)).compRight tail
  have hsource :
      augmentedAffineFaceMap K C ≫ liftedAdaptiveFaceRetraction K C =
        (augmentedAffineFaceMap K C ≫
          𝟙 (augmentedSingularChainComplex K
            (liftedPreGeomTop.{u} C))) ≫ tail := by
    simp only [tail, liftedAdaptiveFaceRetraction, Category.comp_id,
      liftedAdaptiveSmallRetraction]
  have htarget :
      (augmentedAffineFaceMap K C ≫
        augmentedSingularSubdivisionIter K
          (liftedPreGeomTop.{u} C) 1) ≫ tail =
        reverseSubdivisionAffine K C := by
    calc
      (augmentedAffineFaceMap K C ≫
          augmentedSingularSubdivisionIter K
            (liftedPreGeomTop.{u} C) 1) ≫ tail =
        (((augmentedAffineFaceMap K C ≫
            augmentedSingularSubdivisionIter K
              (liftedPreGeomTop.{u} C) 1) ≫
          liftedAdaptiveSmallRetraction K C) ≫
            augmentedLiftedSmallToSmall K C) ≫
              augmentedReverse K C := by
        simp only [tail, Category.assoc]
      _ = (augmentedAffineSubdivisionLiftedSmall K C ≫
            augmentedLiftedSmallToSmall K C) ≫
          augmentedReverse K C := by
        rw [affineSubdivision_adaptiveSmall]
      _ = reverseSubdivisionAffine K C := rfl
  exact (Homotopy.ofEq hsource).trans
    (hsub.trans ((Homotopy.ofEq htarget).trans
      (finiteFaceCarrierHomotopy K C)))

noncomputable def finiteAffineComparison
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    HomotopyEquiv
      (faceChainComplex K (AugmentedComplex.ofPre C))
      (augmentedSingularChainComplex K (liftedPreGeomTop.{u} C)) where
  hom := augmentedAffineFaceMap K C
  inv := liftedAdaptiveFaceRetraction K C
  homotopyHomInvId := finiteAffineComparison_hom_inv_id K C
  homotopyInvHomId := finiteAffineComparison_inv_hom_id K C

@[simp]
theorem finiteAffineComparison_hom
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (finiteAffineComparison K C).hom = augmentedAffineFaceMap K C := rfl

@[simp]
theorem finiteAffineComparison_inv
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (finiteAffineComparison K C).inv = liftedAdaptiveFaceRetraction K C := rfl

noncomputable def finiteAffineComparisonHomologyIso
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).homology q ≅
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).homology q :=
  (finiteAffineComparison K C).toHomologyIso q

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Costar deformation and acyclicity

The realization of a nonempty-face costar is a strong deformation retract of
the ambient realization punctured at the face barycenter.  Transport through
the trusted sphere homeomorphism makes the costar contractible, and the finite
affine comparison then makes its augmented face complex acyclic.
-/

noncomputable section

open scoped BigOperators unitInterval ContinuousMap
open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

/-- Nonempty faces not containing all of `F`. -/
def preCostar {m : ℕ} (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) : PreAbstractSimplicialComplex (Fin m) where
  faces := {G | G ∈ C ∧ ¬ F ⊆ G}
  isRelLowerSet_faces := by
    rintro G ⟨hG, hnG⟩
    refine ⟨(C.isRelLowerSet_faces hG).1, ?_⟩
    intro H hHG hHne
    exact ⟨(C.isRelLowerSet_faces hG).2 hHG hHne,
      fun hFH ↦ hnG (hFH.trans hHG)⟩

/-- Adding the formal empty face commutes with taking a nonempty costar. -/
theorem ofPre_preCostar_toPre {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) (F : Finset (Fin m))
    (hFne : F.Nonempty) :
    AugmentedComplex.ofPre
        (preCostar D.toPreAbstractSimplicialComplex F) =
      (AugmentedComplex.ofAbstract D).costar F hFne := by
  apply AugmentedComplex.ext
  ext G
  simp only [AugmentedComplex.ofPre, AugmentedComplex.costar,
    preCostar, Set.mem_ofPred_eq]
  constructor
  · rintro (rfl | ⟨hG, hn⟩)
    · exact ⟨Or.inl rfl,
        fun h ↦ hFne.ne_empty (Finset.subset_empty.mp h)⟩
    · exact ⟨Or.inr hG, hn⟩
  · rintro ⟨rfl | hG, hn⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨hG, hn⟩

/-- Minimum coordinate over `F`. -/
def faceMin {m : ℕ} (F : Finset (Fin m)) (hFne : F.Nonempty)
    (x : Fin m → ℝ) : ℝ :=
  F.inf' hFne fun v ↦ x v

theorem continuous_faceMin {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) : Continuous (faceMin F hFne) := by
  change Continuous (fun x : Fin m → ℝ ↦ F.inf' hFne fun v ↦ x v)
  exact Continuous.finset_inf'_apply hFne fun v _ ↦
    (continuous_apply v : Continuous (fun x : Fin m → ℝ ↦ x v))

theorem faceMin_le_coord {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) (x : Fin m → ℝ) {v : Fin m} (hv : v ∈ F) :
    faceMin F hFne x ≤ x v := by
  exact Finset.inf'_le _ hv

theorem faceMin_nonneg {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    0 ≤ faceMin F hFne x.1 := by
  exact Finset.le_inf' hFne _ fun v _ ↦ x.2.1 v

theorem faceMin_eq_zero_iff_exists_coord_eq_zero {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    faceMin F hFne x.1 = 0 ↔ ∃ v ∈ F, x.1 v = 0 := by
  constructor
  · intro hzero
    obtain ⟨v, hv, hvmin⟩ := Finset.exists_mem_eq_inf' hFne x.1
    exact ⟨v, hv, hvmin.symm.trans hzero⟩
  · rintro ⟨v, hv, hvzero⟩
    apply le_antisymm
    · simpa [hvzero] using faceMin_le_coord F hFne x.1 hv
    · exact faceMin_nonneg C F hFne x

theorem card_mul_faceMin_le_one {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    (F.card : ℝ) * faceMin F hFne x.1 ≤ 1 := by
  calc
    (F.card : ℝ) * faceMin F hFne x.1 =
        ∑ v ∈ F, faceMin F hFne x.1 := by simp
    _ ≤ ∑ v ∈ F, x.1 v := by
      exact Finset.sum_le_sum fun v hv ↦ faceMin_le_coord F hFne x.1 hv
    _ ≤ ∑ v, x.1 v := by
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ F)
        fun v _ _ ↦ x.2.1 v
    _ = 1 := x.2.2.1

/-- Barycenter of a nonempty face in ambient coordinates. -/
def faceBarycenter {m : ℕ} (F : Finset (Fin m)) (v : Fin m) : ℝ :=
  if v ∈ F then (F.card : ℝ)⁻¹ else 0

@[simp]
theorem barycentricSupport_faceBarycenter {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty) :
    SimplicialSphereAnisotropicity.barycentricSupport (faceBarycenter F) = F := by
  have hcard : (F.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hFne
  ext v
  simp [SimplicialSphereAnisotropicity.barycentricSupport, faceBarycenter, hcard]

theorem faceBarycenter_nonneg {m : ℕ}
    (F : Finset (Fin m)) (v : Fin m) :
    0 ≤ faceBarycenter F v := by
  by_cases hv : v ∈ F
  · simp only [faceBarycenter, if_pos hv]
    positivity
  · simp [faceBarycenter, hv]

theorem sum_faceBarycenter {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty) :
    (∑ v, faceBarycenter F v) = 1 := by
  have hcard : (F.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hFne
  classical
  simp [faceBarycenter, hcard]

def faceBarycenterPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    preGeomTop C :=
  ⟨faceBarycenter F, faceBarycenter_nonneg F,
    sum_faceBarycenter F hFne, by
      simpa [barycentricSupport_faceBarycenter F hFne] using hF⟩

theorem eq_faceBarycenter_of_card_mul_faceMin_eq_one {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C)
    (heq : (F.card : ℝ) * faceMin F hFne x.1 = 1) :
    x.1 = faceBarycenter F := by
  let μ := faceMin F hFne x.1
  have hle : ∀ v ∈ F, μ ≤ x.1 v := fun v hv ↦
    faceMin_le_coord F hFne x.1 hv
  have hconst : (∑ _v ∈ F, μ) = 1 := by
    simpa [μ] using heq
  have hsumF_le : (∑ v ∈ F, x.1 v) ≤ 1 := by
    calc
      (∑ v ∈ F, x.1 v) ≤ ∑ v, x.1 v := by
        exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ F)
          fun v _ _ ↦ x.2.1 v
      _ = 1 := x.2.2.1
  have hsumEq : (∑ _v ∈ F, μ) = ∑ v ∈ F, x.1 v := by
    apply le_antisymm
    · exact Finset.sum_le_sum hle
    · rw [hconst]
      exact hsumF_le
  have hcoord : ∀ v ∈ F, x.1 v = μ := by
    have h := (Finset.sum_eq_sum_iff_of_le hle).mp hsumEq
    exact fun v hv ↦ (h v hv).symm
  have hsumF : (∑ v ∈ F, x.1 v) = 1 := hsumEq.symm.trans hconst
  have hsumOutside : (∑ v ∈ Finset.univ \ F, x.1 v) = 0 := by
    have hsplit := Finset.sum_sdiff (f := fun v ↦ x.1 v)
      (Finset.subset_univ F)
    rw [hsumF, x.2.2.1] at hsplit
    linarith
  have hzeroOutside : ∀ v ∈ Finset.univ \ F, x.1 v = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg
      (fun v _ ↦ x.2.1 v)).mp hsumOutside
  have hcard : (F.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hFne
  have hμ : μ = (F.card : ℝ)⁻¹ := by
    rw [show (F.card : ℝ)⁻¹ = 1 / (F.card : ℝ) by simp]
    apply (eq_div_iff hcard).2
    simpa [μ, mul_comm] using heq
  funext v
  by_cases hv : v ∈ F
  · simp [faceBarycenter, hv, hcoord v hv, hμ]
  · have hvout : v ∈ Finset.univ \ F := by simp [hv]
    simp [faceBarycenter, hv, hzeroOutside v hvout]

def radialDenominator {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) (x : Fin m → ℝ) : ℝ :=
  1 - (F.card : ℝ) * faceMin F hFne x

theorem continuous_radialDenominator {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) : Continuous (radialDenominator F hFne) := by
  exact continuous_const.sub
    (continuous_const.mul (continuous_faceMin F hFne))

theorem radialDenominator_pos_of_ne_barycenter {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C)
    (hne : x.1 ≠ faceBarycenter F) :
    0 < radialDenominator F hFne x.1 := by
  have hle := card_mul_faceMin_le_one C F hFne x
  have hlt : (F.card : ℝ) * faceMin F hFne x.1 < 1 := by
    apply lt_of_le_of_ne hle
    intro heq
    exact hne (eq_faceBarycenter_of_card_mul_faceMin_eq_one
      C F hFne x heq)
  dsimp [radialDenominator]
  linarith

/-! ## The explicit radial endpoint -/

/-- The punctured realization, with the pole recorded as a realization
point rather than merely as an ambient coordinate vector. -/
abbrev puncturedRealization {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :=
  {x : preGeomTop C // x ≠ faceBarycenterPoint C F hF hFne}

/-- Endpoint coordinates `b_F + δ⁻¹(x-b_F)`. -/
def costarEndpointCoords {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) (x : Fin m → ℝ) : Fin m → ℝ :=
  fun v ↦ faceBarycenter F v +
    (radialDenominator F hFne x)⁻¹ * (x v - faceBarycenter F v)

theorem costarEndpointCoords_of_mem {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (x : Fin m → ℝ) {v : Fin m} (hv : v ∈ F)
    (hδ : radialDenominator F hFne x ≠ 0) :
    costarEndpointCoords F hFne x v =
      (x v - faceMin F hFne x) / radialDenominator F hFne x := by
  have hr : (F.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hFne
  simp only [costarEndpointCoords, faceBarycenter, if_pos hv]
  field_simp [radialDenominator, hr, hδ]
  simp only [radialDenominator]
  ring

theorem costarEndpointCoords_of_not_mem {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (x : Fin m → ℝ) {v : Fin m} (hv : v ∉ F) :
    costarEndpointCoords F hFne x v =
      x v / radialDenominator F hFne x := by
  simp [costarEndpointCoords, faceBarycenter, hv, div_eq_mul_inv,
    mul_comm]

theorem costarEndpointCoords_nonneg {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C)
    (hδ : 0 < radialDenominator F hFne x.1) (v : Fin m) :
    0 ≤ costarEndpointCoords F hFne x.1 v := by
  by_cases hv : v ∈ F
  · rw [costarEndpointCoords_of_mem F hFne x.1 hv hδ.ne']
    exact div_nonneg
      (sub_nonneg.mpr (faceMin_le_coord F hFne x.1 hv)) hδ.le
  · rw [costarEndpointCoords_of_not_mem F hFne x.1 hv]
    exact div_nonneg (x.2.1 v) hδ.le

theorem sum_costarEndpointCoords {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    (∑ v, costarEndpointCoords F hFne x.1 v) = 1 := by
  simp only [costarEndpointCoords, Finset.sum_add_distrib,
    ← Finset.mul_sum, Finset.sum_sub_distrib, x.2.2.1,
    sum_faceBarycenter F hFne, sub_self, mul_zero, add_zero]

theorem costarEndpointCoords_eq_zero_of_coord_eq_zero {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C)
    {v : Fin m} (hvzero : x.1 v = 0) :
    costarEndpointCoords F hFne x.1 v = 0 := by
  by_cases hv : v ∈ F
  · have hμ : faceMin F hFne x.1 = 0 := by
      apply le_antisymm
      · simpa [hvzero] using faceMin_le_coord F hFne x.1 hv
      · exact faceMin_nonneg C F hFne x
    simp [costarEndpointCoords, radialDenominator, faceBarycenter, hv,
      hμ, hvzero]
  · simp [costarEndpointCoords, faceBarycenter, hv, hvzero]

theorem barycentricSupport_costarEndpointCoords_subset {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    SimplicialSphereAnisotropicity.barycentricSupport (costarEndpointCoords F hFne x.1) ⊆
      SimplicialSphereAnisotropicity.barycentricSupport x.1 := by
  intro v hv
  simp only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
    Finset.mem_univ, true_and] at hv ⊢
  contrapose! hv
  exact costarEndpointCoords_eq_zero_of_coord_eq_zero C F hFne x hv

theorem barycentricSupport_costarEndpointCoords_nonempty {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C) :
    (SimplicialSphereAnisotropicity.barycentricSupport
      (costarEndpointCoords F hFne x.1)).Nonempty := by
  have hsum : (∑ v, costarEndpointCoords F hFne x.1 v) ≠ 0 := by
    rw [sum_costarEndpointCoords C F hFne x]
    norm_num
  obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  exact ⟨v, by simpa [SimplicialSphereAnisotropicity.barycentricSupport] using hv⟩

theorem costarEndpointCoords_mem_preCostar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : preGeomTop C)
    (hδ : 0 < radialDenominator F hFne x.1) :
    SimplicialSphereAnisotropicity.barycentricSupport (costarEndpointCoords F hFne x.1) ∈
      preCostar C F := by
  have hsubset := barycentricSupport_costarEndpointCoords_subset
    C F hFne x
  have hne := barycentricSupport_costarEndpointCoords_nonempty C F hFne x
  refine ⟨(C.isRelLowerSet_faces x.2.2.2).2 hsubset hne, ?_⟩
  obtain ⟨v, hvF, hvmin⟩ := Finset.exists_mem_eq_inf' hFne x.1
  have hvmin' : faceMin F hFne x.1 = x.1 v := by
    simpa [faceMin] using hvmin
  have hvzero : costarEndpointCoords F hFne x.1 v = 0 := by
    rw [costarEndpointCoords_of_mem F hFne x.1 hvF hδ.ne', hvmin']
    simp
  intro hFsubset
  have hv := hFsubset hvF
  simp only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
    Finset.mem_univ, true_and] at hv
  exact hv hvzero

/-- The radial endpoint as a point of the costar realization. -/
def costarEndpoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (x : puncturedRealization C F hF hFne) :
    preGeomTop (preCostar C F) := by
  have hxne : x.1.1 ≠ faceBarycenter F := by
    intro h
    apply x.2
    apply Subtype.ext
    exact h
  have hδ := radialDenominator_pos_of_ne_barycenter
    C F hFne x.1 hxne
  exact ⟨costarEndpointCoords F hFne x.1.1,
    costarEndpointCoords_nonneg C F hFne x.1 hδ,
    sum_costarEndpointCoords C F hFne x.1,
    costarEndpointCoords_mem_preCostar C F hFne x.1 hδ⟩

theorem punctured_radialDenominator_pos {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (x : puncturedRealization C F hF hFne) :
    0 < radialDenominator F hFne x.1.1 := by
  apply radialDenominator_pos_of_ne_barycenter C F hFne x.1
  intro h
  apply x.2
  apply Subtype.ext
  exact h

theorem continuous_costarEndpoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    Continuous (costarEndpoint C F hF hFne) := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro v
  have hx : Continuous (fun x : puncturedRealization C F hF hFne ↦
      x.1.1) :=
    continuous_subtype_val.comp continuous_subtype_val
  have hδ : Continuous (fun x : puncturedRealization C F hF hFne ↦
      radialDenominator F hFne x.1.1) :=
    (continuous_radialDenominator F hFne).comp hx
  have hδinv : Continuous (fun x : puncturedRealization C F hF hFne ↦
      (radialDenominator F hFne x.1.1)⁻¹) :=
    hδ.inv₀ fun x ↦ (punctured_radialDenominator_pos
      C F hF hFne x).ne'
  change Continuous (fun x : puncturedRealization C F hF hFne ↦
    faceBarycenter F v +
      (radialDenominator F hFne x.1.1)⁻¹ *
        (x.1.1 v - faceBarycenter F v))
  exact continuous_const.add
    (hδinv.mul (((continuous_apply v).comp hx).sub continuous_const))

/-- The endpoint map into the costar realization. -/
def costarEndpointMap {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    C(puncturedRealization C F hF hFne,
      preGeomTop (preCostar C F)) :=
  ⟨costarEndpoint C F hF hFne,
    continuous_costarEndpoint C F hF hFne⟩

theorem preCostar_le {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) : preCostar C F ≤ C := by
  intro G hG
  exact hG.1

theorem costarPoint_ne_faceBarycenterPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (y : preGeomTop (preCostar C F)) :
    preGeomMapOfLE (preCostar_le C F) y ≠
      faceBarycenterPoint C F hF hFne := by
  intro h
  have hcoords : y.1 = faceBarycenter F :=
    congrArg (fun z : preGeomTop C ↦ z.1) h
  have hsupp : SimplicialSphereAnisotropicity.barycentricSupport y.1 = F := by
    rw [hcoords, barycentricSupport_faceBarycenter F hFne]
  exact y.2.2.2.2 (by rw [hsupp])

/-- Inclusion of the costar realization into the punctured realization. -/
def costarInclusionMap {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    C(preGeomTop (preCostar C F),
      puncturedRealization C F hF hFne) where
  toFun y := ⟨preGeomMapOfLE (preCostar_le C F) y,
    costarPoint_ne_faceBarycenterPoint C F hF hFne y⟩
  continuous_toFun := Continuous.subtype_mk
    (preGeomMapOfLE (preCostar_le C F)).hom.continuous _

theorem exists_coord_zero_of_mem_costar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (y : preGeomTop (preCostar C F)) :
    ∃ v ∈ F, y.1 v = 0 := by
  have hnsub : ¬F ⊆ SimplicialSphereAnisotropicity.barycentricSupport y.1 := y.2.2.2.2
  rw [Finset.not_subset] at hnsub
  obtain ⟨v, hvF, hv⟩ := hnsub
  exact ⟨v, hvF, by
    simpa [SimplicialSphereAnisotropicity.barycentricSupport] using hv⟩

theorem costarEndpointCoords_eq_self_of_faceMin_eq_zero {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty) (x : Fin m → ℝ)
    (hμ : faceMin F hFne x = 0) :
    costarEndpointCoords F hFne x = x := by
  funext v
  simp [costarEndpointCoords, radialDenominator, hμ]

@[simp]
theorem costarEndpoint_costarInclusionMap {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (y : preGeomTop (preCostar C F)) :
    costarEndpoint C F hF hFne (costarInclusionMap C F hF hFne y) = y := by
  apply Subtype.ext
  apply costarEndpointCoords_eq_self_of_faceMin_eq_zero F hFne
  apply (faceMin_eq_zero_iff_exists_coord_eq_zero C F hFne
    (costarInclusionMap C F hF hFne y).1).2
  exact exists_coord_zero_of_mem_costar C F y

theorem costarEndpointMap_comp_costarInclusionMap {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    (costarEndpointMap C F hF hFne).comp
        (costarInclusionMap C F hF hFne) =
      ContinuousMap.id (preGeomTop (preCostar C F)) := by
  apply ContinuousMap.ext
  intro y
  exact costarEndpoint_costarInclusionMap C F hF hFne y

/-! ## The radial homotopy on the puncture -/

/-- Convex interpolation from `x` to the radial endpoint. -/
def costarHomotopyCoords {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) (t : ℝ) (x : Fin m → ℝ) : Fin m → ℝ :=
  fun v ↦ (1 - t) * x v + t * costarEndpointCoords F hFne x v

def radialScale {m : ℕ} (F : Finset (Fin m))
    (hFne : F.Nonempty) (t : ℝ) (x : Fin m → ℝ) : ℝ :=
  (1 - t) + t * (radialDenominator F hFne x)⁻¹

theorem costarHomotopyCoords_eq_radial {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : Fin m → ℝ) (v : Fin m) :
    costarHomotopyCoords F hFne t x v =
      faceBarycenter F v +
        radialScale F hFne t x * (x v - faceBarycenter F v) := by
  simp only [costarHomotopyCoords, costarEndpointCoords, radialScale]
  ring

theorem radialScale_pos {m : ℕ}
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (x : Fin m → ℝ)
    (hδ : 0 < radialDenominator F hFne x) :
    0 < radialScale F hFne t x := by
  by_cases ht : t = 1
  · simp [radialScale, ht, inv_pos.mpr hδ]
  · have hlt : t < 1 := lt_of_le_of_ne ht1 ht
    exact add_pos_of_pos_of_nonneg (sub_pos.mpr hlt)
      (mul_nonneg ht0 (inv_nonneg.mpr hδ.le))

theorem costarHomotopyCoords_nonneg {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (x : preGeomTop C)
    (hδ : 0 < radialDenominator F hFne x.1) (v : Fin m) :
    0 ≤ costarHomotopyCoords F hFne t x.1 v := by
  exact add_nonneg
    (mul_nonneg (sub_nonneg.mpr ht1) (x.2.1 v))
    (mul_nonneg ht0 (costarEndpointCoords_nonneg C F hFne x hδ v))

theorem sum_costarHomotopyCoords {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : preGeomTop C) :
    (∑ v, costarHomotopyCoords F hFne t x.1 v) = 1 := by
  simp only [costarHomotopyCoords, Finset.sum_add_distrib,
    ← Finset.mul_sum, x.2.2.1, sum_costarEndpointCoords C F hFne x]
  ring

theorem costarHomotopyCoords_eq_zero_of_coord_eq_zero {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : preGeomTop C) {v : Fin m} (hv : x.1 v = 0) :
    costarHomotopyCoords F hFne t x.1 v = 0 := by
  simp [costarHomotopyCoords, hv,
    costarEndpointCoords_eq_zero_of_coord_eq_zero C F hFne x hv]

theorem barycentricSupport_costarHomotopyCoords_subset {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : preGeomTop C) :
    SimplicialSphereAnisotropicity.barycentricSupport (costarHomotopyCoords F hFne t x.1) ⊆
      SimplicialSphereAnisotropicity.barycentricSupport x.1 := by
  intro v hv
  simp only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
    Finset.mem_univ, true_and] at hv ⊢
  contrapose! hv
  exact costarHomotopyCoords_eq_zero_of_coord_eq_zero
    C F hFne t x hv

theorem barycentricSupport_costarHomotopyCoords_nonempty {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : preGeomTop C) :
    (SimplicialSphereAnisotropicity.barycentricSupport
      (costarHomotopyCoords F hFne t x.1)).Nonempty := by
  have hsum : (∑ v, costarHomotopyCoords F hFne t x.1 v) ≠ 0 := by
    rw [sum_costarHomotopyCoords C F hFne t x]
    norm_num
  obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  exact ⟨v, by simpa [SimplicialSphereAnisotropicity.barycentricSupport] using hv⟩

theorem costarHomotopyCoords_mem_ambient {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (x : preGeomTop C) :
    SimplicialSphereAnisotropicity.barycentricSupport (costarHomotopyCoords F hFne t x.1) ∈ C := by
  exact (C.isRelLowerSet_faces x.2.2.2).2
    (barycentricSupport_costarHomotopyCoords_subset C F hFne t x)
    (barycentricSupport_costarHomotopyCoords_nonempty C F hFne t x)

theorem costarHomotopyCoords_ne_faceBarycenter {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hFne : F.Nonempty)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (x : preGeomTop C)
    (hx : x.1 ≠ faceBarycenter F) :
    costarHomotopyCoords F hFne t x.1 ≠ faceBarycenter F := by
  have hδ := radialDenominator_pos_of_ne_barycenter C F hFne x hx
  have hs := radialScale_pos F hFne t ht0 ht1 x.1 hδ
  intro h
  apply hx
  funext v
  have hv := congrFun h v
  rw [costarHomotopyCoords_eq_radial F hFne t x.1 v] at hv
  have hmul : radialScale F hFne t x.1 *
      (x.1 v - faceBarycenter F v) = 0 := by
    linarith
  exact sub_eq_zero.mp ((mul_eq_zero.mp hmul).resolve_left hs.ne')

/-- The path as a point of the ambient realization. -/
def costarHomotopyPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (p : Set.Icc (0 : ℝ) 1 × puncturedRealization C F hF hFne) :
    preGeomTop C := by
  have hxne : p.2.1.1 ≠ faceBarycenter F := by
    intro h
    apply p.2.2
    apply Subtype.ext
    exact h
  have hδ := radialDenominator_pos_of_ne_barycenter
    C F hFne p.2.1 hxne
  exact ⟨costarHomotopyCoords F hFne p.1 p.2.1.1,
    costarHomotopyCoords_nonneg C F hFne p.1 p.1.2.1 p.1.2.2
      p.2.1 hδ,
    sum_costarHomotopyCoords C F hFne p.1 p.2.1,
    costarHomotopyCoords_mem_ambient C F hFne p.1 p.2.1⟩

theorem continuous_costarHomotopyPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    Continuous (costarHomotopyPoint C F hF hFne) := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro v
  have ht : Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
      puncturedRealization C F hF hFne ↦ (p.1 : ℝ)) :=
    continuous_subtype_val.comp continuous_fst
  have hx : Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
      puncturedRealization C F hF hFne ↦ p.2.1.1) :=
    (continuous_subtype_val.comp continuous_subtype_val).comp continuous_snd
  have he : Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
      puncturedRealization C F hF hFne ↦
        (costarEndpoint C F hF hFne p.2).1) :=
    continuous_subtype_val.comp
      ((continuous_costarEndpoint C F hF hFne).comp continuous_snd)
  change Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
      puncturedRealization C F hF hFne ↦
    (1 - (p.1 : ℝ)) * p.2.1.1 v +
      (p.1 : ℝ) * (costarEndpoint C F hF hFne p.2).1 v)
  exact (continuous_const.sub ht).mul ((continuous_apply v).comp hx) |>.add
    (ht.mul ((continuous_apply v).comp he))

/-- The path never reaches the removed barycenter. -/
def costarHomotopyPuncturedPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (p : Set.Icc (0 : ℝ) 1 × puncturedRealization C F hF hFne) :
    puncturedRealization C F hF hFne := by
  refine ⟨costarHomotopyPoint C F hF hFne p, ?_⟩
  intro h
  have hcoords := congrArg (fun z : preGeomTop C ↦ z.1) h
  have hxne : p.2.1.1 ≠ faceBarycenter F := by
    intro hx
    apply p.2.2
    apply Subtype.ext
    exact hx
  exact costarHomotopyCoords_ne_faceBarycenter C F hFne p.1
    p.1.2.1 p.1.2.2 p.2.1 hxne hcoords

theorem continuous_costarHomotopyPuncturedPoint {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    Continuous (costarHomotopyPuncturedPoint C F hF hFne) :=
  Continuous.subtype_mk
    (continuous_costarHomotopyPoint C F hF hFne) _

/-- Strong deformation from the identity of the puncture to inclusion after
radial retraction. -/
def costarRadialHomotopy {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    ContinuousMap.Homotopy
      (ContinuousMap.id (puncturedRealization C F hF hFne))
      ((costarInclusionMap C F hF hFne).comp
        (costarEndpointMap C F hF hFne)) where
  toFun := costarHomotopyPuncturedPoint C F hF hFne
  continuous_toFun := continuous_costarHomotopyPuncturedPoint C F hF hFne
  map_zero_left x := by
    apply Subtype.ext
    apply Subtype.ext
    funext v
    simp [costarHomotopyPuncturedPoint, costarHomotopyPoint,
      costarHomotopyCoords]
  map_one_left x := by
    apply Subtype.ext
    apply Subtype.ext
    funext v
    simp [costarHomotopyPuncturedPoint, costarHomotopyPoint,
      costarHomotopyCoords, costarInclusionMap, costarEndpointMap]
    rw [preGeomMapOfLE_apply]
    rfl

/-- The radial homotopy fixes the included costar pointwise. -/
theorem costarRadialHomotopy_fixed {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty)
    (t : Set.Icc (0 : ℝ) 1) (y : preGeomTop (preCostar C F)) :
    costarRadialHomotopy C F hF hFne
        (t, costarInclusionMap C F hF hFne y) =
      costarInclusionMap C F hF hFne y := by
  apply Subtype.ext
  apply Subtype.ext
  funext v
  change costarHomotopyCoords F hFne (t : ℝ) y.1 v = y.1 v
  have he := congrArg (fun z : preGeomTop (preCostar C F) ↦ z.1)
    (costarEndpoint_costarInclusionMap C F hF hFne y)
  change costarEndpointCoords F hFne y.1 = y.1 at he
  rw [costarHomotopyCoords, he]
  ring

/-- The costar realization and the punctured realization are homotopy
equivalent by the explicit strong deformation retract. -/
def costarPunctureHomotopyEquiv {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : Finset (Fin m)) (hF : F ∈ C) (hFne : F.Nonempty) :
    preGeomTop (preCostar C F) ≃ₕ
      puncturedRealization C F hF hFne where
  toFun := costarInclusionMap C F hF hFne
  invFun := costarEndpointMap C F hF hFne
  left_inv := by
    rw [costarEndpointMap_comp_costarInclusionMap C F hF hFne]
  right_inv := ⟨(costarRadialHomotopy C F hF hFne).symm⟩

/-! ## Contractibility from the trusted sphere homeomorphism -/

section Stereographic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def puncturedSphereHomeomorphOrthogonal
    (p : Metric.sphere (0 : E) 1) :
    {x : Metric.sphere (0 : E) 1 // x ≠ p} ≃ₜ
      (ℝ ∙ (p : E))ᗮ :=
  (Homeomorph.setCongr (by
      ext x
      rfl)).trans
    ((stereographic (norm_eq_of_mem_sphere p)).toHomeomorphSourceTarget.trans
      (Homeomorph.Set.univ _))

theorem puncturedSphereContractible
    (p : Metric.sphere (0 : E) 1) :
    ContractibleSpace {x : Metric.sphere (0 : E) 1 // x ≠ p} :=
  (puncturedSphereHomeomorphOrthogonal p).contractibleSpace

def puncturedHomeomorph {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (e : X ≃ₜ Y) (p : X) :
    {x : X // x ≠ p} ≃ₜ {y : Y // y ≠ e p} :=
  e.subtype fun x ↦ by
    constructor
    · intro hx heq
      exact hx (e.injective heq)
    · exact fun hx heq ↦ hx (congrArg e heq)

theorem puncturedSphereTransportContractible
    {X : Type*} [TopologicalSpace X]
    (e : X ≃ₜ Metric.sphere (0 : E) 1) (p : X) :
    ContractibleSpace {x : X // x ≠ p} := by
  let : ContractibleSpace
      {y : Metric.sphere (0 : E) 1 // y ≠ e p} :=
    puncturedSphereContractible (e p)
  exact (puncturedHomeomorph e p).contractibleSpace

end Stereographic

/-- The exact trusted homeomorphism, with `preGeomTop` unfolded only through
its definitional equality with the trusted geometric realization. -/
noncomputable def trustedSphereHomeomorph
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    preGeomTop D.toPreAbstractSimplicialComplex ≃ₜ
      Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1 :=
  Classical.choice hD.2

noncomputable def puncturedRealizationSphereHomeomorph
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    puncturedRealization D.toPreAbstractSimplicialComplex F hF hFne ≃ₜ
      {z : Metric.sphere
          (0 : EuclideanSpace ℝ (Fin (n + 1))) 1 //
        z ≠ trustedSphereHomeomorph D hD
          (faceBarycenterPoint D.toPreAbstractSimplicialComplex
            F hF hFne)} :=
  puncturedHomeomorph (trustedSphereHomeomorph D hD)
    (faceBarycenterPoint D.toPreAbstractSimplicialComplex F hF hFne)

theorem puncturedRealizationContractible
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    ContractibleSpace
      (puncturedRealization D.toPreAbstractSimplicialComplex F hF hFne) :=
  puncturedSphereTransportContractible (trustedSphereHomeomorph D hD)
    (faceBarycenterPoint D.toPreAbstractSimplicialComplex F hF hFne)

/-- Every nonempty-face costar realization is contractible. -/
theorem costarRealizationContractible
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    ContractibleSpace
      (preGeomTop
        (preCostar D.toPreAbstractSimplicialComplex F)) := by
  let : ContractibleSpace
      (puncturedRealization D.toPreAbstractSimplicialComplex F hF hFne) :=
    puncturedRealizationContractible D hD F hF hFne
  exact (costarPunctureHomotopyEquiv
    D.toPreAbstractSimplicialComplex F hF hFne).contractibleSpace

/-! ## Universe lift and augmented face-chain acyclicity -/

/-- Contractibility survives the canonical universe lift used by the
production augmented singular complex. -/
theorem liftedCostarRealizationContractible
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    ContractibleSpace
      (liftedPreGeomTop.{u}
        (preCostar D.toPreAbstractSimplicialComplex F)) := by
  let : ContractibleSpace
      (preGeomTop
        (preCostar D.toPreAbstractSimplicialComplex F)) :=
    costarRealizationContractible D hD F hF hFne
  exact (preGeomTop
    (preCostar D.toPreAbstractSimplicialComplex F)).uliftFunctorObjHomeo.symm
      |>.contractibleSpace

/-- A contracting homotopy kills every homology object. -/
theorem acyclic_of_contractingHomotopy
    (K : Type u) [Field K]
    (A : ChainComplex (ModuleCat K) ℕ)
    (h : Homotopy (𝟙 A) 0) : A.Acyclic := by
  intro q
  rw [A.exactAt_iff_isZero_homology, IsZero.iff_id_eq_zero]
  simpa using h.homologyMap_eq q

/-- Acyclicity transports backwards through a chain-homotopy equivalence. -/
theorem acyclic_of_homotopyEquiv
    (K : Type u) [Field K]
    {A B : ChainComplex (ModuleCat K) ℕ}
    (e : HomotopyEquiv A B) (hB : B.Acyclic) : A.Acyclic := by
  intro q
  rw [A.exactAt_iff_isZero_homology]
  exact IsZero.of_iso (hB q).isZero_homology (e.toHomologyIso q)

/-- The exact production augmented singular contraction of the lifted costar.
The point and topological nullhomotopy are chosen from contractibility; no
extra axiom or homology theorem is used. -/
noncomputable def liftedCostarAugmentedContraction
    (K : Type u) [Field K]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    _root_.Homotopy
      (𝟙 (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u}
          (preCostar D.toPreAbstractSimplicialComplex F)))) 0 := by
  let : ContractibleSpace
      (liftedPreGeomTop.{u}
        (preCostar D.toPreAbstractSimplicialComplex F)) :=
    liftedCostarRealizationContractible D hD F hF hFne
  let hnull := id_nullhomotopic
    (liftedPreGeomTop.{u}
      (preCostar D.toPreAbstractSimplicialComplex F))
  let y := Classical.choose hnull
  let H := Classical.choice (Classical.choose_spec hnull)
  exact augmentedContractionOfHomotopy K y H

theorem liftedCostarAugmentedSingularAcyclic
    (K : Type u) [Field K]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m))
    (hF : F ∈ D.toPreAbstractSimplicialComplex) (hFne : F.Nonempty) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u}
        (preCostar D.toPreAbstractSimplicialComplex F))).Acyclic :=
  acyclic_of_contractingHomotopy K _
    (liftedCostarAugmentedContraction K D hD F hF hFne)

/-- Final costar endpoint: the augmented face complex of every nonempty-face
costar is acyclic, using the production affine comparison. -/
theorem costarFaceChainAcyclic
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (F : Finset (Fin m)) (hF : F ∈ D) (hFne : F.Nonempty) :
    (faceChainComplex K
      ((AugmentedComplex.ofAbstract D).costar F hFne)).Acyclic := by
  have hpre :
      (faceChainComplex K
        (AugmentedComplex.ofPre
          (preCostar D.toPreAbstractSimplicialComplex F))).Acyclic :=
    acyclic_of_homotopyEquiv K
      (finiteAffineComparison K
        (preCostar D.toPreAbstractSimplicialComplex F))
      (liftedCostarAugmentedSingularAcyclic K D hD F hF hFne)
  rw [ofPre_preCostar_toPre D F hFne] at hpre
  exact hpre

end SimplicialSphereAnisotropicity.Topology

end

end

section

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u v w

variable {V : Type u} [DecidableEq V]

abbrev ContainingSimplex (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :=
  {G : AugmentedSimplex C q // F ⊆ G.1}

abbrev RelativeChain (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :=
  ContainingSimplex C F q →₀ K

def facePartitionEquiv (C : AugmentedComplex V) (F : Finset V)
    (hFne : F.Nonempty) (q : ℕ) :
    AugmentedSimplex C q ≃
      AugmentedSimplex (C.costar F hFne) q ⊕ ContainingSimplex C F q where
  toFun G := if h : F ⊆ G.1 then
      Sum.inr ⟨G, h⟩
    else
      Sum.inl ⟨G.1, ⟨G.2.1, h⟩, G.2.2⟩
  invFun
    | Sum.inl G => ⟨G.1, G.2.1.1, G.2.2⟩
    | Sum.inr G => G.1
  left_inv G := by
    by_cases h : F ⊆ G.1 <;> simp [h]
  right_inv G := by
    rcases G with G | G
    · simp only
      rw [dif_neg G.2.1.2]
    · simp only
      rw [dif_pos G.2]

def faceChainSplitEquiv (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ) :
    AugmentedChain K C q ≃ₗ[K]
      AugmentedChain K (C.costar F hFne) q × RelativeChain K C F q :=
  (Finsupp.domLCongr (facePartitionEquiv C F hFne q)).trans
    (Finsupp.sumFinsuppLEquivProdFinsupp K)

omit [DecidableEq V] in
theorem costarLE (C : AugmentedComplex V) (F : Finset V)
    (hFne : F.Nonempty) :
    ∀ ⦃G : Finset V⦄, G ∈ C.costar F hFne → G ∈ C :=
  fun _ hG ↦ hG.1

theorem faceChainSplitEquiv_inclusion_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ)
    (G : AugmentedSimplex (C.costar F hFne) q) (a : K) :
    faceChainSplitEquiv K C F hFne q
        (faceChainInclusionDegree K (costarLE C F hFne) q
          (Finsupp.single G a)) =
      (Finsupp.single G a, 0) := by
  simp [faceChainSplitEquiv, facePartitionEquiv,
    faceChainInclusionDegree_single, G.2.1.2]

theorem faceChainSplitEquiv_containing_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ)
    (G : AugmentedSimplex C q) (hG : F ⊆ G.1) (a : K) :
    faceChainSplitEquiv K C F hFne q (Finsupp.single G a) =
      (0, Finsupp.single ⟨G, hG⟩ a) := by
  simp [faceChainSplitEquiv, facePartitionEquiv, hG]

theorem faceChainSplitEquiv_costar_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ)
    (G : AugmentedSimplex C q) (hG : ¬F ⊆ G.1) (a : K) :
    faceChainSplitEquiv K C F hFne q (Finsupp.single G a) =
      (Finsupp.single ⟨G.1, ⟨G.2.1, hG⟩, G.2.2⟩ a, 0) := by
  simp [faceChainSplitEquiv, facePartitionEquiv, hG]

theorem faceChainSplitEquiv_inclusion (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ) :
    (faceChainSplitEquiv K C F hFne q).toLinearMap.comp
        (faceChainInclusionDegree K (costarLE C F hFne) q) =
      LinearMap.inl K _ _ := by
  apply Finsupp.lhom_ext
  intro G a
  change faceChainSplitEquiv K C F hFne q
      (faceChainInclusionDegree K (costarLE C F hFne) q
        (Finsupp.single G a)) = (Finsupp.single G a, 0)
  exact faceChainSplitEquiv_inclusion_single K C F hFne q G a

def relativeProjectOnSimplex (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ)
    (G : AugmentedSimplex C q) : RelativeChain K C F q :=
  if h : F ⊆ G.1 then Finsupp.single ⟨G, h⟩ 1 else 0

def relativeProjectionDegree (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    AugmentedChain K C q →ₗ[K] RelativeChain K C F q :=
  Finsupp.linearCombination K (relativeProjectOnSimplex K C F q)

@[simp]
theorem relativeProjectionDegree_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ)
    (G : AugmentedSimplex C q) (a : K) :
    relativeProjectionDegree K C F q (Finsupp.single G a) =
      a • relativeProjectOnSimplex K C F q G := by
  exact Finsupp.linearCombination_single K a G

def relativeSectionOnSimplex (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ)
    (G : ContainingSimplex C F q) : AugmentedChain K C q :=
  Finsupp.single G.1 1

def relativeSectionDegree (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    RelativeChain K C F q →ₗ[K] AugmentedChain K C q :=
  Finsupp.linearCombination K (relativeSectionOnSimplex K C F q)

omit [DecidableEq V] in
@[simp]
theorem relativeSectionDegree_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ)
    (G : ContainingSimplex C F q) (a : K) :
    relativeSectionDegree K C F q (Finsupp.single G a) =
      Finsupp.single G.1 a := by
  rw [relativeSectionDegree, Finsupp.linearCombination_single]
  simp [relativeSectionOnSimplex]

theorem relativeProjection_section (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    (relativeProjectionDegree K C F q).comp
        (relativeSectionDegree K C F q) = LinearMap.id := by
  apply Finsupp.lhom_ext
  intro G a
  simp [relativeProjectOnSimplex, G.2]

theorem relativeProjection_surjective (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    Function.Surjective (relativeProjectionDegree K C F q) := by
  intro y
  exact ⟨relativeSectionDegree K C F q y,
    LinearMap.congr_fun (relativeProjection_section K C F q) y⟩

theorem faceChainSplitEquiv_snd (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ) :
    (LinearMap.snd K _ _).comp
        (faceChainSplitEquiv K C F hFne q).toLinearMap =
      relativeProjectionDegree K C F q := by
  apply Finsupp.lhom_ext
  intro G a
  by_cases hG : F ⊆ G.1
  · simp [LinearMap.comp_apply, faceChainSplitEquiv_containing_single,
      relativeProjectionDegree_single, relativeProjectOnSimplex, hG]
  · simp [LinearMap.comp_apply, faceChainSplitEquiv_costar_single,
      relativeProjectionDegree_single, relativeProjectOnSimplex, hG]

theorem relativeDegree_exact (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) (q : ℕ) :
    Function.Exact
      (faceChainInclusionDegree K (costarLE C F hFne) q)
      (relativeProjectionDegree K C F q) := by
  intro x
  constructor
  · intro hx
    let e := faceChainSplitEquiv K C F hFne q
    let y : AugmentedChain K (C.costar F hFne) q := (e x).1
    refine ⟨y, ?_⟩
    apply e.injective
    have hi := LinearMap.congr_fun
      (faceChainSplitEquiv_inclusion K C F hFne q) y
    have hp := LinearMap.congr_fun
      (faceChainSplitEquiv_snd K C F hFne q) x
    change e (faceChainInclusionDegree K (costarLE C F hFne) q y) = e x
    rw [show e (faceChainInclusionDegree K (costarLE C F hFne) q y) =
        (y, 0) by simpa [e, LinearMap.comp_apply] using hi]
    apply Prod.ext
    · rfl
    · simpa [e, y, LinearMap.comp_apply, hx] using hp.symm
  · rintro ⟨y, rfl⟩
    have hi := LinearMap.congr_fun
      (faceChainSplitEquiv_inclusion K C F hFne q) y
    have hp := LinearMap.congr_fun
      (faceChainSplitEquiv_snd K C F hFne q)
        (faceChainInclusionDegree K (costarLE C F hFne) q y)
    have hsnd :
        (faceChainSplitEquiv K C F hFne q
          (faceChainInclusionDegree K (costarLE C F hFne) q y)).2 = 0 := by
      simpa [LinearMap.comp_apply] using congrArg Prod.snd hi
    simpa [LinearMap.comp_apply, hsnd] using hp.symm

def relativeBoundary (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    RelativeChain K C F (q + 1) →ₗ[K] RelativeChain K C F q :=
  (relativeProjectionDegree K C F q).comp
    ((faceBoundary K C q).comp (relativeSectionDegree K C F (q + 1)))

theorem relativeProjection_boundary (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    (relativeProjectionDegree K C F q).comp (faceBoundary K C q) =
      (relativeBoundary K C F q).comp
        (relativeProjectionDegree K C F (q + 1)) := by
  apply Finsupp.lhom_ext
  intro G a
  by_cases hG : F ⊆ G.1
  · simp only [LinearMap.comp_apply, relativeProjectionDegree_single,
      relativeProjectOnSimplex, dif_pos hG, relativeBoundary,
      relativeSectionDegree_single, Finsupp.smul_single, smul_eq_mul, mul_one]
  · simp only [LinearMap.comp_apply, relativeProjectionDegree_single,
      relativeProjectOnSimplex, dif_neg hG, smul_zero, map_zero]
    rw [faceBoundary_single]
    simp only [boundaryOnSimplex, map_smul, map_sum,
      relativeProjectionDegree_single]
    have hsum :
        (∑ x : ↥G.1,
          (1 : K) • relativeProjectOnSimplex K C F q
            (eraseSimplex C G x)) = 0 := by
      apply Finset.sum_eq_zero
      intro x hx
      simp only [one_smul, relativeProjectOnSimplex]
      rw [dif_neg]
      intro hErase
      exact hG (hErase.trans (Finset.erase_subset x.1 G.1))
    rw [hsum, smul_zero]

theorem relativeBoundary_boundary (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    (relativeBoundary K C F q).comp
        (relativeBoundary K C F (q + 1)) = 0 := by
  apply LinearMap.ext
  intro y
  obtain ⟨x, rfl⟩ := relativeProjection_surjective K C F (q + 2) y
  simp only [LinearMap.comp_apply, LinearMap.zero_apply]
  have h₁ :
      relativeBoundary K C F (q + 1)
          (relativeProjectionDegree K C F (q + 2) x) =
        relativeProjectionDegree K C F (q + 1)
          (faceBoundary K C (q + 1) x) := by
    simpa only [LinearMap.comp_apply] using
      (LinearMap.congr_fun
        (relativeProjection_boundary K C F (q + 1)) x).symm
  rw [h₁]
  have h₂ :
      relativeBoundary K C F q
          (relativeProjectionDegree K C F (q + 1)
            (faceBoundary K C (q + 1) x)) =
        relativeProjectionDegree K C F q
          (faceBoundary K C q (faceBoundary K C (q + 1) x)) := by
    simpa only [LinearMap.comp_apply] using
      (LinearMap.congr_fun (relativeProjection_boundary K C F q)
        (faceBoundary K C (q + 1) x)).symm
  rw [h₂]
  have hdd := LinearMap.congr_fun (faceBoundary_boundary K C q) x
  simp only [LinearMap.comp_apply, LinearMap.zero_apply] at hdd
  rw [hdd, map_zero]

def relativeFaceChainComplex (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) :
    ChainComplex (ModuleCat K) ℕ :=
  ChainComplex.of
    (fun q ↦ ModuleCat.of K (RelativeChain K C F q))
    (fun q ↦ ModuleCat.ofHom (relativeBoundary K C F q))
    (fun q ↦ by
      apply ModuleCat.hom_ext
      exact relativeBoundary_boundary K C F q)

@[simp]
theorem relativeFaceChainComplex_d (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (q : ℕ) :
    (relativeFaceChainComplex K C F).d (q + 1) q =
      ModuleCat.ofHom (relativeBoundary K C F q) := by
  simp [relativeFaceChainComplex]

def relativeProjection (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) :
    faceChainComplex K C ⟶ relativeFaceChainComplex K C F where
  f q := ModuleCat.ofHom (relativeProjectionDegree K C F q)
  comm' i j hij := by
    have hi : j + 1 = i := by simpa using hij
    subst i
    unfold faceChainComplex relativeFaceChainComplex
    simp only [ChainComplex.of_d]
    simpa only [ModuleCat.ofHom_comp] using
      congrArg (fun f ↦ ModuleCat.ofHom f)
        (relativeProjection_boundary K C F j).symm

def costarFaceChainInclusion (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) :
    faceChainComplex K (C.costar F hFne) ⟶ faceChainComplex K C :=
  faceChainInclusion K (costarLE C F hFne)

theorem relativeProjectionDegree_comp_costarInclusion (K : Type v)
    [Field K] (C : AugmentedComplex V) (F : Finset V)
    (hFne : F.Nonempty) (q : ℕ) :
    (relativeProjectionDegree K C F q).comp
        (faceChainInclusionDegree K (costarLE C F hFne) q) = 0 := by
  apply LinearMap.ext
  intro x
  exact (relativeDegree_exact K C F hFne q).apply_apply_eq_zero x

theorem costarInclusion_relativeProjection_zero (K : Type v)
    [Field K] [CharP K 2] (C : AugmentedComplex V) (F : Finset V)
    (hFne : F.Nonempty) :
    costarFaceChainInclusion K C F hFne ≫ relativeProjection K C F = 0 := by
  apply HomologicalComplex.hom_ext
  intro q
  simp only [HomologicalComplex.comp_f, costarFaceChainInclusion,
    faceChainInclusion_f, relativeProjection, HomologicalComplex.zero_f]
  unfold faceChainComplex relativeFaceChainComplex
  simpa only [ModuleCat.ofHom_comp, ModuleCat.ofHom_zero] using
    congrArg (fun f ↦ ModuleCat.ofHom f)
      (relativeProjectionDegree_comp_costarInclusion K C F hFne q)

def costarRelativeShortComplex (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) :
    ShortComplex (ChainComplex (ModuleCat K) ℕ) :=
  ShortComplex.mk (costarFaceChainInclusion K C F hFne)
    (relativeProjection K C F)
    (costarInclusion_relativeProjection_zero K C F hFne)

theorem costarRelativeShortExact (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) :
    (costarRelativeShortComplex K C F hFne).ShortExact := by
  apply HomologicalComplex.shortExact_of_degreewise_shortExact
  intro q
  apply ModuleCat.shortComplex_shortExact
  · exact relativeDegree_exact K C F hFne q
  · exact faceChainInclusionDegree_injective K (costarLE C F hFne) q
  · exact relativeProjection_surjective K C F q

omit [DecidableEq V] in
theorem isEmpty_containingSimplex_of_lt (C : AugmentedComplex V)
    (F : Finset V) (q : ℕ) (hq : q < F.card) :
    IsEmpty (ContainingSimplex C F q) := by
  constructor
  rintro ⟨G, hFG⟩
  have := Finset.card_le_card hFG
  omega

omit [DecidableEq V] in
theorem isEmpty_containingSimplex_card_sub_one (C : AugmentedComplex V)
    (F : Finset V) (hFne : F.Nonempty) :
    IsEmpty (ContainingSimplex C F (F.card - 1)) := by
  apply isEmpty_containingSimplex_of_lt
  have hpos : 0 < F.card := Finset.card_pos.mpr hFne
  omega

def containingSimplexEquivLink (C : AugmentedComplex V)
    (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    ContainingSimplex C F (F.card + a) ≃
      AugmentedSimplex (C.link F hF) a where
  toFun G :=
    ⟨G.1.1 \ F,
      ⟨Finset.disjoint_sdiff,
        by simpa [Finset.union_sdiff_of_subset G.2] using G.1.2.1⟩,
      by rw [Finset.card_sdiff_of_subset G.2, G.1.2.2]
         omega⟩
  invFun H :=
    ⟨⟨F ∪ H.1, H.2.1.2,
        by rw [Finset.card_union_of_disjoint H.2.1.1, H.2.2]⟩,
      Finset.subset_union_left⟩
  left_inv G := by
    apply Subtype.ext
    apply Subtype.ext
    exact Finset.union_sdiff_of_subset G.2
  right_inv H := by
    apply Subtype.ext
    exact Finset.union_sdiff_cancel_left H.2.1.1

def relativeDegreeEquivLink (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    RelativeChain K C F (F.card + a) ≃ₗ[K]
      AugmentedChain K (C.link F hF) a :=
  Finsupp.domLCongr (containingSimplexEquivLink C F hF a)

@[simp]
theorem relativeDegreeEquivLink_single (K : Type v) [Field K]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) (a : ℕ)
    (G : ContainingSimplex C F (F.card + a)) (b : K) :
    relativeDegreeEquivLink K C F hF a (Finsupp.single G b) =
      Finsupp.single (containingSimplexEquivLink C F hF a G) b := by
  simp [relativeDegreeEquivLink]

noncomputable def containingVertexEquiv (C : AugmentedComplex V)
    (F : Finset V) {q : ℕ} (G : ContainingSimplex C F q) :
    ↥G.1.1 ≃ ↥F ⊕ ↥(G.1.1 \ F) :=
  (Equiv.setCongr (by
      ext x
      simp only [Finset.mem_coe]
      rw [Finset.mem_union, Finset.mem_sdiff]
      constructor
      · intro hx
        by_cases hxF : x ∈ F
        · exact Or.inl hxF
        · exact Or.inr ⟨hx, hxF⟩
      · rintro (hxF | ⟨hx, -⟩)
        · exact G.2 hxF
        · exact hx)).trans
    (Equiv.Finset.union F (G.1.1 \ F) Finset.disjoint_sdiff).symm

@[simp]
theorem containingVertexEquiv_symm_inl (C : AugmentedComplex V)
    (F : Finset V) {q : ℕ} (G : ContainingSimplex C F q) (v : ↥F) :
    (containingVertexEquiv C F G).symm (Sum.inl v) =
      ⟨v.1, G.2 v.2⟩ := by
  apply Subtype.ext
  rfl

@[simp]
theorem containingVertexEquiv_symm_inr (C : AugmentedComplex V)
    (F : Finset V) {q : ℕ} (G : ContainingSimplex C F q)
    (w : ↥(G.1.1 \ F)) :
    (containingVertexEquiv C F G).symm (Sum.inr w) =
      ⟨w.1, (Finset.mem_sdiff.mp w.2).1⟩ := by
  apply Subtype.ext
  rfl

def eraseContainingSimplex (C : AugmentedComplex V)
    (F : Finset V) {q : ℕ} (G : ContainingSimplex C F (q + 1))
    (w : ↥(G.1.1 \ F)) : ContainingSimplex C F q :=
  ⟨eraseSimplex C G.1
      ⟨w.1, (Finset.mem_sdiff.mp w.2).1⟩,
    (Finset.subset_erase.mpr
      ⟨G.2, (Finset.mem_sdiff.mp w.2).2⟩)⟩

@[simp]
theorem containingSimplexEquivLink_eraseContainingSimplex
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    {a : ℕ} (G : ContainingSimplex C F (F.card + (a + 1)))
    (w : ↥(G.1.1 \ F)) :
    containingSimplexEquivLink C F hF a
        (eraseContainingSimplex C F G w) =
      eraseSimplex (C.link F hF)
        (containingSimplexEquivLink C F hF (a + 1) G) w := by
  apply Subtype.ext
  exact Finset.erase_sdiff_comm G.1.1 F w.1

theorem relativeProjection_boundaryOn_containing_one
    (K : Type v) [Field K] (C : AugmentedComplex V)
    (F : Finset V) (a : ℕ)
    (G : ContainingSimplex C F (F.card + (a + 1))) :
    relativeProjectionDegree K C F (F.card + a)
        (boundaryOnSimplex K C (F.card + a) G.1) =
      ∑ w : ↥(G.1.1 \ F),
        Finsupp.single (eraseContainingSimplex C F G w) 1 := by
  unfold boundaryOnSimplex
  simp only [map_sum, relativeProjectionDegree_single, one_smul]
  let splitTerm : ↥F ⊕ ↥(G.1.1 \ F) →
      RelativeChain K C F (F.card + a) :=
    Sum.elim (fun _ ↦ 0)
      (fun w ↦ Finsupp.single (eraseContainingSimplex C F G w) 1)
  calc
    (∑ x : ↥G.1.1,
        relativeProjectOnSimplex K C F (F.card + a)
          (eraseSimplex C G.1 x)) =
        ∑ z : ↥F ⊕ ↥(G.1.1 \ F), splitTerm z := by
      symm
      apply Fintype.sum_equiv (containingVertexEquiv C F G).symm
      intro z
      rcases z with v | w
      · simp only [splitTerm, Sum.elim_inl,
          containingVertexEquiv_symm_inl]
        rw [relativeProjectOnSimplex, dif_neg]
        intro hsubset
        have hnot := (Finset.subset_erase.mp hsubset).2
        exact hnot v.2
      · simp only [splitTerm, Sum.elim_inr,
          containingVertexEquiv_symm_inr]
        have hsubset :
            F ⊆ (eraseSimplex C G.1
              ⟨w.1, (Finset.mem_sdiff.mp w.2).1⟩).1 :=
          Finset.subset_erase.mpr
            ⟨G.2, (Finset.mem_sdiff.mp w.2).2⟩
        rw [relativeProjectOnSimplex, dif_pos hsubset]
        congr 1
    _ = ∑ w : ↥(G.1.1 \ F),
          Finsupp.single (eraseContainingSimplex C F G w) 1 := by
      simp [splitTerm, Fintype.sum_sum_type]

theorem relativeDegreeEquivLink_relativeBoundary_single_one
    (K : Type v) [Field K] (C : AugmentedComplex V)
    (F : Finset V) (hF : F ∈ C) (a : ℕ)
    (G : ContainingSimplex C F (F.card + (a + 1))) :
    relativeDegreeEquivLink K C F hF a
        (relativeBoundary K C F (F.card + a)
          (Finsupp.single G 1)) =
      boundaryOnSimplex K (C.link F hF) a
        (containingSimplexEquivLink C F hF (a + 1) G) := by
  rw [relativeBoundary, LinearMap.comp_apply, LinearMap.comp_apply,
    relativeSectionDegree_single, faceBoundary_single, one_smul,
    relativeProjection_boundaryOn_containing_one]
  simp only [map_sum, relativeDegreeEquivLink_single,
    containingSimplexEquivLink_eraseContainingSimplex]
  rfl

theorem relativeDegreeEquivLink_relativeBoundary_single
    (K : Type v) [Field K] (C : AugmentedComplex V)
    (F : Finset V) (hF : F ∈ C) (a : ℕ)
    (G : ContainingSimplex C F (F.card + (a + 1))) (b : K) :
    relativeDegreeEquivLink K C F hF a
        (relativeBoundary K C F (F.card + a)
          (Finsupp.single G b)) =
      faceBoundary K (C.link F hF) a
        (relativeDegreeEquivLink K C F hF (a + 1)
          (Finsupp.single G b)) := by
  rw [show Finsupp.single G b = b • Finsupp.single G 1 by simp]
  simp only [map_smul]
  rw [relativeDegreeEquivLink_relativeBoundary_single_one]
  simp only [relativeDegreeEquivLink_single, faceBoundary_single, one_smul]

theorem relativeDegreeEquivLink_boundary
    (K : Type v) [Field K] (C : AugmentedComplex V)
    (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    (relativeDegreeEquivLink K C F hF a).toLinearMap.comp
        (relativeBoundary K C F (F.card + a)) =
      (faceBoundary K (C.link F hF) a).comp
        (relativeDegreeEquivLink K C F hF (a + 1)).toLinearMap := by
  apply Finsupp.lhom_ext
  intro G b
  exact relativeDegreeEquivLink_relativeBoundary_single
    K C F hF a G b

def relativeLeftShiftEmbedding (r : ℕ) :
    (ComplexShape.down' (1 : ℕ)).Embedding
      (ComplexShape.down' (1 : ℕ)) :=
  ComplexShape.Embedding.mk' _ _ (fun a ↦ r + a)
    (fun _ _ h ↦ Nat.add_left_cancel h)
    (fun i j ↦ by
      change (j + 1 = i) ↔ (r + j) + 1 = r + i
      omega)

instance relativeLeftShiftEmbedding_isRelIff (r : ℕ) :
    (relativeLeftShiftEmbedding r).IsRelIff := by
  constructor
  intro i j h
  change j + 1 = i
  change (r + j) + 1 = r + i at h
  omega

abbrev relativeShiftedRestriction (K : Type v) [Field K]
    (Q : HomologicalComplex (ModuleCat K) (ComplexShape.down' (1 : ℕ)))
    (r : ℕ) :=
  Q.restriction (relativeLeftShiftEmbedding r)

abbrev relativeFaceChainComplexDown'
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) :
    HomologicalComplex (ModuleCat K) (ComplexShape.down' (1 : ℕ)) :=
  relativeFaceChainComplex K C F

noncomputable def relativeRestrictionLinkComponentIso
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    (relativeShiftedRestriction K (relativeFaceChainComplexDown' K C F)
      F.card).X a ≅
        (faceChainComplex K (C.link F hF)).X a := by
  change ModuleCat.of K (RelativeChain K C F (F.card + a)) ≅
    ModuleCat.of K (AugmentedChain K (C.link F hF) a)
  exact (relativeDegreeEquivLink K C F hF a).toModuleIso

@[simp]
theorem relativeRestrictionLinkComponentIso_hom
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    (relativeRestrictionLinkComponentIso K C F hF a).hom =
      ModuleCat.ofHom
        (relativeDegreeEquivLink K C F hF a).toLinearMap := by
  rfl

theorem relativeShiftedRestriction_d
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (r a : ℕ) :
    (relativeShiftedRestriction K (relativeFaceChainComplexDown' K C F) r).d
        (a + 1) a =
      ModuleCat.ofHom (relativeBoundary K C F (r + a)) := by
  change (relativeFaceChainComplex K C F).d
      (r + (a + 1)) (r + a) = _
  simpa only [Nat.add_succ] using
    relativeFaceChainComplex_d K C F (r + a)

theorem relativeRestrictionLink_d_comm
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) (a : ℕ) :
    (relativeRestrictionLinkComponentIso K C F hF (a + 1)).hom ≫
        (faceChainComplex K (C.link F hF)).d (a + 1) a =
      (relativeShiftedRestriction K (relativeFaceChainComplexDown' K C F)
          F.card).d (a + 1) a ≫
        (relativeRestrictionLinkComponentIso K C F hF a).hom := by
  rw [relativeRestrictionLinkComponentIso_hom,
    relativeRestrictionLinkComponentIso_hom,
    faceChainComplex_d, relativeShiftedRestriction_d]
  apply ModuleCat.hom_ext
  exact (relativeDegreeEquivLink_boundary K C F hF a).symm

noncomputable def relativeRestrictionLinkIso
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) :
    relativeShiftedRestriction K (relativeFaceChainComplexDown' K C F)
        F.card ≅
      faceChainComplex K (C.link F hF) :=
  HomologicalComplex.Hom.isoOfComponents
    (relativeRestrictionLinkComponentIso K C F hF) (by
      intro i j hij
      change j + 1 = i at hij
      subst i
      exact relativeRestrictionLink_d_comm K C F hF j)

/-! ## Link-degree-zero homology seam -/

abbrev lowRestrictionModel (K : Type v) [Field K]
    (Q : HomologicalComplex (ModuleCat.{w} K) (ComplexShape.down' (1 : ℕ)))
    (r : ℕ) : ShortComplex (ModuleCat.{w} K) :=
  ShortComplex.mk (Q.d (r + 1) r) (0 : Q.X r ⟶ Q.X r) (by simp)

def lowRestrictionScHom (K : Type v) [Field K]
    (Q : HomologicalComplex (ModuleCat.{w} K) (ComplexShape.down' (1 : ℕ)))
    (r : ℕ) : Q.sc' (r + 1) r (r - 1) ⟶
      lowRestrictionModel K Q r where
  τ₁ := CategoryStruct.id _
  τ₂ := CategoryStruct.id _
  τ₃ := 0
  comm₁₂ := by
    change CategoryStruct.id (Q.X (r + 1)) ≫ Q.d (r + 1) r =
      Q.d (r + 1) r ≫ CategoryStruct.id (Q.X r)
    rw [Category.id_comp, Category.comp_id]
  comm₂₃ := by
    change CategoryStruct.id (Q.X r) ≫ 0 = Q.d r (r - 1) ≫ 0
    rw [Category.id_comp, comp_zero]

theorem lowRestrictionScHom_isIso_homologyMap
    (K : Type v) [Field K]
    (Q : HomologicalComplex (ModuleCat.{w} K) (ComplexShape.down' (1 : ℕ)))
    (r : ℕ) (hzero : IsZero (Q.X (r - 1))) :
    IsIso (ShortComplex.homologyMap (lowRestrictionScHom K Q r)) := by
  let φ := lowRestrictionScHom K Q r
  have : Epi φ.τ₁ := by
    dsimp [φ, lowRestrictionScHom]
    change Epi (CategoryStruct.id (Q.X (r + 1)))
    infer_instance
  have : IsIso φ.τ₂ := by
    dsimp [φ, lowRestrictionScHom]
    change IsIso (CategoryStruct.id (Q.X r))
    infer_instance
  have : Mono φ.τ₃ := by
    apply hzero.mono
  exact ShortComplex.isIso_homologyMap_of_epi_of_isIso_of_mono φ

theorem relativeFaceChainComplex_card_sub_one_isZero
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) :
    IsZero ((relativeFaceChainComplex K C F).X (F.card - 1)) := by
  let hempty := isEmpty_containingSimplex_card_sub_one C F hFne
  rw [ModuleCat.isZero_iff_subsingleton]
  constructor
  intro x y
  apply Finsupp.ext
  intro G
  exact (hempty.false G).elim

theorem relativeLowRestrictionScHom_isIso_homologyMap
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hFne : F.Nonempty) :
    IsIso (ShortComplex.homologyMap
      (lowRestrictionScHom K
        (relativeFaceChainComplexDown' K C F) F.card)) := by
  apply lowRestrictionScHom_isIso_homologyMap
  exact relativeFaceChainComplex_card_sub_one_isZero K C F hFne

def relativeLowModelIsoShiftZeroSc
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) :
    lowRestrictionModel K (relativeFaceChainComplexDown' K C F) F.card ≅
      (relativeShiftedRestriction K
        (relativeFaceChainComplexDown' K C F) F.card).sc' 1 0 0 :=
  ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
    (by
      change (relativeShiftedRestriction K
          (relativeFaceChainComplexDown' K C F) F.card).d 1 0 =
        (relativeFaceChainComplex K C F).d (F.card + 1) F.card
      rfl)
    (by
      change (relativeShiftedRestriction K
          (relativeFaceChainComplexDown' K C F) F.card).d 0 0 = 0
      apply (relativeShiftedRestriction K
        (relativeFaceChainComplexDown' K C F) F.card).shape
      change ¬(0 + 1 = 0)
      omega)

noncomputable def relativeLowModelHomologyIsoLinkZero
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C) :
    (lowRestrictionModel K
        (relativeFaceChainComplexDown' K C F) F.card).homology ≅
      (faceChainComplex K (C.link F hF)).homology 0 :=
  ShortComplex.homologyMapIso (relativeLowModelIsoShiftZeroSc K C F) ≪≫
    ((relativeShiftedRestriction K
        (relativeFaceChainComplexDown' K C F) F.card).homologyIsoSc'
      1 0 0
      (by
        apply (ComplexShape.down' (1 : ℕ)).prev_eq'
        rfl)
      (by
        apply (ComplexShape.down' (1 : ℕ)).next_eq_self'
        intro k hk
        change k + 1 = 0 at hk
        omega)).symm ≪≫
    HomologicalComplex.homologyMapIso
      (relativeRestrictionLinkIso K C F hF) 0

noncomputable def relativeHomologyCardIsoLinkZero
    (K : Type v) [Field K] [CharP K 2]
    (C : AugmentedComplex V) (F : Finset V) (hF : F ∈ C)
    (hFne : F.Nonempty) :
    (relativeFaceChainComplex K C F).homology F.card ≅
      (faceChainComplex K (C.link F hF)).homology 0 := by
  let φ := lowRestrictionScHom K
    (relativeFaceChainComplexDown' K C F) F.card
  let hφ : IsIso (ShortComplex.homologyMap φ) :=
    relativeLowRestrictionScHom_isIso_homologyMap K C F hFne
  let eφ := @asIso _ _ _ _ (ShortComplex.homologyMap φ) hφ
  exact ((relativeFaceChainComplex K C F).homologyIsoSc'
      (F.card + 1) F.card (F.card - 1)
      (by
        apply (ComplexShape.down ℕ).prev_eq'
        simp only [ComplexShape.down_Rel])
      (by
        apply (ComplexShape.down ℕ).next_eq'
        simp only [ComplexShape.down_Rel]
        have hpos : 0 < F.card := Finset.card_pos.mpr hFne
        omega)) ≪≫
    eφ ≪≫
    relativeLowModelHomologyIsoLinkZero K C F hF


end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Crosspolytope geometry and last-coordinate face plumbing

This module constructs the literal crosspolytope realization homeomorphism,
transports augmented singular chains across the trusted sphere homeomorphism,
and provides the finite-face operations used by the recursive chain
deformation retract.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.Topology

universe u

abbrev cpEquiv (d : ℕ) : Fin d ⊕ Fin d ≃ Fin (d + d) :=
  @finSumFinEquiv d d

def cpPos (d : ℕ) (i : Fin d) : Fin (d + d) :=
  Fin.castAdd d i

def cpNeg (d : ℕ) (i : Fin d) : Fin (d + d) :=
  Fin.natAdd d i

@[simp]
theorem cpPos_ne_cpNeg (d : ℕ) (i : Fin d) : cpPos d i ≠ cpNeg d i := by
  intro h
  have h' := congrArg Fin.val h
  simp only [cpPos, cpNeg, Fin.val_castAdd, Fin.val_natAdd] at h'
  omega

def crosspolytope (d : ℕ) : AbstractSimplicialComplex (Fin (d + d)) where
  faces := {F | F.Nonempty ∧ ∀ i : Fin d, ¬(cpPos d i ∈ F ∧ cpNeg d i ∈ F)}
  isRelLowerSet_faces := by
    rintro F ⟨hFne, hF⟩
    refine ⟨hFne, ?_⟩
    intro G hGF hGne
    exact ⟨hGne, fun i hi => hF i ⟨hGF hi.1, hGF hi.2⟩⟩
  singleton_mem := by
    intro v
    refine ⟨Finset.singleton_nonempty v, fun i hi => ?_⟩
    simp only [Finset.mem_singleton] at hi
    exact cpPos_ne_cpNeg d i (hi.1.trans hi.2.symm)

@[simp]
theorem mem_crosspolytope (d : ℕ) (F : Finset (Fin (d + d))) :
    F ∈ crosspolytope d ↔
      F.Nonempty ∧ ∀ i : Fin d, ¬(cpPos d i ∈ F ∧ cpNeg d i ∈ F) :=
  Iff.rfl

abbrev crossAug (d : ℕ) : AugmentedComplex (Fin (d + d)) :=
  AugmentedComplex.ofAbstract (crosspolytope d)

def signedCoord (d : ℕ) (x : Fin (d + d) → ℝ) (i : Fin d) : ℝ :=
  x (cpPos d i) - x (cpNeg d i)

theorem cross_point_one_side_zero (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex)
    (i : Fin d) : x.1 (cpPos d i) = 0 ∨ x.1 (cpNeg d i) = 0 := by
  have hop := (mem_crosspolytope d (SimplicialSphereAnisotropicity.barycentricSupport x.1)).mp x.2.2.2 |>.2 i
  simpa [SimplicialSphereAnisotropicity.barycentricSupport] using (not_and_or.mp hop)

theorem abs_signedCoord (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex)
    (i : Fin d) :
    |signedCoord d x.1 i| = x.1 (cpPos d i) + x.1 (cpNeg d i) := by
  rcases cross_point_one_side_zero d x i with hp | hn
  · simp [signedCoord, hp, abs_of_nonneg (x.2.1 _)]
  · simp [signedCoord, hn, abs_of_nonneg (x.2.1 _)]

theorem sum_abs_signedCoord (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex) :
    (∑ i : Fin d, |signedCoord d x.1 i|) = 1 := by
  rw [Finset.sum_congr rfl (fun i _ => abs_signedCoord d x i),
    Finset.sum_add_distrib]
  change (∑ i : Fin d, x.1 (Fin.castAdd d i)) +
    (∑ i : Fin d, x.1 (Fin.natAdd d i)) = 1
  rw [← Fin.sum_univ_add]
  exact x.2.2.1

abbrev lOneSphere (d : ℕ) :=
  {y : Fin d → ℝ // (∑ i : Fin d, |y i|) = 1}

def crossToLOne (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex) :
    lOneSphere d :=
  ⟨signedCoord d x.1, sum_abs_signedCoord d x⟩

def baryOfSigned (d : ℕ) (y : Fin d → ℝ) (v : Fin (d + d)) : ℝ :=
  @Fin.addCases d d (fun _ => ℝ) (fun i : Fin d => max (y i) 0)
    (fun i : Fin d => max (-y i) 0) v

@[simp]
theorem baryOfSigned_castAdd (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    baryOfSigned d y (Fin.castAdd d i) = max (y i) 0 := by
  unfold baryOfSigned
  exact Fin.addCases_left i

@[simp]
theorem baryOfSigned_natAdd (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    baryOfSigned d y (Fin.natAdd d i) = max (-y i) 0 := by
  unfold baryOfSigned
  exact Fin.addCases_right i

@[simp]
theorem baryOfSigned_pos (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    baryOfSigned d y (cpPos d i) = max (y i) 0 := by
  exact baryOfSigned_castAdd d y i

@[simp]
theorem baryOfSigned_neg (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    baryOfSigned d y (cpNeg d i) = max (-y i) 0 := by
  exact baryOfSigned_natAdd d y i

theorem baryOfSigned_nonneg (d : ℕ) (y : Fin d → ℝ) (v : Fin (d + d)) :
    0 ≤ baryOfSigned d y v := by
  refine @Fin.addCases d d (fun v => 0 ≤ baryOfSigned d y v)
    (fun i => ?_) (fun i => ?_) v
  · rw [baryOfSigned_castAdd]
    exact le_max_right (y i) 0
  · rw [baryOfSigned_natAdd]
    exact le_max_right (-y i) 0

theorem max_add_max_neg_eq_abs (a : ℝ) :
    max a 0 + max (-a) 0 = |a| := by
  rcases le_total 0 a with ha | ha
  · simp [max_eq_left ha, max_eq_right (neg_nonpos.mpr ha), abs_of_nonneg ha]
  · simp [max_eq_right ha, max_eq_left (neg_nonneg.mpr ha), abs_of_nonpos ha]

theorem not_both_max_ne_zero (a : ℝ) :
    ¬(max a 0 ≠ 0 ∧ max (-a) 0 ≠ 0) := by
  rcases le_total 0 a with ha | ha
  · simp [max_eq_right (neg_nonpos.mpr ha)]
  · simp [max_eq_right ha]

theorem sum_baryOfSigned (d : ℕ) (y : lOneSphere d) :
    (∑ v : Fin (d + d), baryOfSigned d y.1 v) = 1 := by
  rw [Fin.sum_univ_add, ← Finset.sum_add_distrib]
  simp only [baryOfSigned_castAdd, baryOfSigned_natAdd]
  rw [Finset.sum_congr rfl (fun i _ => max_add_max_neg_eq_abs (y.1 i))]
  exact y.2

def crossFromLOne (d : ℕ) (y : lOneSphere d) :
    preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex := by
  refine ⟨baryOfSigned d y.1, baryOfSigned_nonneg d y.1, sum_baryOfSigned d y, ?_⟩
  apply (mem_crosspolytope d _).mpr
  constructor
  · have hsum : (∑ v : Fin (d + d), baryOfSigned d y.1 v) ≠ 0 := by
      rw [sum_baryOfSigned]
      norm_num
    obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
    exact ⟨v, by simpa [SimplicialSphereAnisotropicity.barycentricSupport] using hv⟩
  · intro i
    simpa [SimplicialSphereAnisotropicity.barycentricSupport] using not_both_max_ne_zero (y.1 i)

@[simp]
theorem crossFromLOne_val (d : ℕ) (y : lOneSphere d) :
    (crossFromLOne d y).1 = baryOfSigned d y.1 := rfl

theorem signedCoord_baryOfSigned (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    signedCoord d (baryOfSigned d y) i = y i := by
  simp [signedCoord]

theorem max_signed_eq_pos (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex)
    (i : Fin d) :
    max (signedCoord d x.1 i) 0 = x.1 (cpPos d i) := by
  rcases cross_point_one_side_zero d x i with hp | hn
  · simp [signedCoord, hp, x.2.1]
  · simp [signedCoord, hn, x.2.1]

theorem max_neg_signed_eq_neg (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex)
    (i : Fin d) :
    max (-signedCoord d x.1 i) 0 = x.1 (cpNeg d i) := by
  rcases cross_point_one_side_zero d x i with hp | hn
  · simp [signedCoord, hp, x.2.1]
  · simp [signedCoord, hn, x.2.1]

theorem baryOfSigned_signedCoord (d : ℕ)
    (x : preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex) :
    baryOfSigned d (signedCoord d x.1) = x.1 := by
  funext v
  refine @Fin.addCases d d (fun v => baryOfSigned d (signedCoord d x.1) v = x.1 v)
    (fun i => ?_) (fun i => ?_) v
  · rw [baryOfSigned_castAdd]
    simpa [cpPos] using max_signed_eq_pos d x i
  · rw [baryOfSigned_natAdd]
    simpa [cpNeg] using max_neg_signed_eq_neg d x i

def crossLOneHomeomorph (d : ℕ) :
    preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex ≃ₜ lOneSphere d where
  toFun := crossToLOne d
  invFun := crossFromLOne d
  left_inv x := by
    apply Subtype.ext
    exact baryOfSigned_signedCoord d x
  right_inv y := by
    apply Subtype.ext
    funext i
    exact signedCoord_baryOfSigned d y.1 i
  continuous_toFun := by
    apply continuous_induced_rng.2
    apply continuous_pi
    intro i
    exact ((continuous_apply (cpPos d i)).comp continuous_subtype_val).sub
      ((continuous_apply (cpNeg d i)).comp continuous_subtype_val)
  continuous_invFun := by
    apply continuous_induced_rng.2
    rw [show (Subtype.val ∘ crossFromLOne d) =
      (fun y : lOneSphere d => baryOfSigned d y.1) by
        funext y
        exact crossFromLOne_val d y]
    apply continuous_pi
    intro v
    refine @Fin.addCases d d
      (fun v => Continuous (fun y : lOneSphere d => baryOfSigned d y.1 v))
      (fun i => ?_) (fun i => ?_) v
    · simp only [baryOfSigned_castAdd]
      exact (((continuous_apply i).comp continuous_subtype_val).max continuous_const)
    · simp only [baryOfSigned_natAdd]
      exact (((continuous_apply i).comp continuous_subtype_val).neg.max continuous_const)

/-! A direct radial comparison between the explicit `L¹` sphere above and the exact
Euclidean sphere occurring in `IsSimplicialSphere`. -/

abbrev exactEuclideanSphere (d : ℕ) :=
  Metric.sphere (0 : EuclideanSpace ℝ (Fin d)) 1

def toEuclidean (d : ℕ) (y : Fin d → ℝ) : EuclideanSpace ℝ (Fin d) :=
  WithLp.toLp 2 y

@[simp]
theorem toEuclidean_apply (d : ℕ) (y : Fin d → ℝ) (i : Fin d) :
    toEuclidean d y i = y i := rfl

theorem toEuclidean_ne_zero (d : ℕ) (y : lOneSphere d) :
    toEuclidean d y.1 ≠ 0 := by
  intro hzero
  have hyzero : y.1 = 0 := by
    funext i
    have hi := congrArg (fun z : EuclideanSpace ℝ (Fin d) => z i) hzero
    simpa using hi
  have : (0 : ℝ) = 1 := by simpa [hyzero] using y.2
  norm_num at this

def lOneToExactSphere (d : ℕ) (y : lOneSphere d) : exactEuclideanSphere d :=
  ⟨(‖toEuclidean d y.1‖⁻¹ : ℝ) • toEuclidean d y.1,
    mem_sphere_zero_iff_norm.mpr (norm_smul_inv_norm (toEuclidean_ne_zero d y))⟩

def lOneMass (d : ℕ) (z : EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∑ i : Fin d, |z i|

theorem exactSphere_ne_zero (d : ℕ) (z : exactEuclideanSphere d) : z.1 ≠ 0 := by
  intro hzero
  have hnorm := mem_sphere_zero_iff_norm.mp z.2
  rw [hzero, norm_zero] at hnorm
  norm_num at hnorm

theorem lOneMass_pos (d : ℕ) (z : exactEuclideanSphere d) :
    0 < lOneMass d z.1 := by
  let zOne : PiLp 1 (fun _ : Fin d => ℝ) := WithLp.toLp 1 (fun i => z.1 i)
  have hzOne : zOne ≠ 0 := by
    intro hzero
    apply exactSphere_ne_zero d z
    apply PiLp.ext
    intro i
    have hi := congrArg (fun w : PiLp 1 (fun _ : Fin d => ℝ) => w i) hzero
    simpa [zOne] using hi
  have hnorm : ‖zOne‖ = lOneMass d z.1 := by
    simpa [lOneMass, zOne, Real.norm_eq_abs] using PiLp.norm_eq_of_L1 zOne
  rw [← hnorm]
  exact norm_pos_iff.mpr hzOne

def exactSphereToLOne (d : ℕ) (z : exactEuclideanSphere d) : lOneSphere d := by
  let m := lOneMass d z.1
  have hm : 0 < m := lOneMass_pos d z
  refine ⟨fun i => m⁻¹ * z.1 i, ?_⟩
  simp only [abs_mul, abs_inv, abs_of_pos hm, ← Finset.mul_sum]
  exact inv_mul_cancel₀ hm.ne'

theorem lOneMass_lOneToExactSphere (d : ℕ) (y : lOneSphere d) :
    lOneMass d (lOneToExactSphere d y).1 = ‖toEuclidean d y.1‖⁻¹ := by
  let r := ‖toEuclidean d y.1‖
  have hr : 0 < r := norm_pos_iff.mpr (toEuclidean_ne_zero d y)
  change (∑ i : Fin d, |r⁻¹ * y.1 i|) = r⁻¹
  simp only [abs_mul, abs_inv, abs_of_pos hr, ← Finset.mul_sum, y.2, mul_one]

theorem norm_toEuclidean_exactSphereToLOne (d : ℕ) (z : exactEuclideanSphere d) :
    ‖toEuclidean d (exactSphereToLOne d z).1‖ = (lOneMass d z.1)⁻¹ := by
  let m := lOneMass d z.1
  have hm : 0 < m := lOneMass_pos d z
  have hraw : toEuclidean d (exactSphereToLOne d z).1 = m⁻¹ • z.1 := by
    apply PiLp.ext
    intro i
    rfl
  rw [hraw, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hm),
    mem_sphere_zero_iff_norm.mp z.2, mul_one]

@[simp]
theorem exactSphereToLOne_lOneToExactSphere (d : ℕ) (y : lOneSphere d) :
    exactSphereToLOne d (lOneToExactSphere d y) = y := by
  apply Subtype.ext
  funext i
  rw [show (exactSphereToLOne d (lOneToExactSphere d y)).1 i =
    (lOneMass d (lOneToExactSphere d y).1)⁻¹ *
      (‖toEuclidean d y.1‖⁻¹ * y.1 i) by rfl,
    lOneMass_lOneToExactSphere]
  have hr : ‖toEuclidean d y.1‖ ≠ 0 := norm_ne_zero_iff.mpr (toEuclidean_ne_zero d y)
  field_simp

@[simp]
theorem lOneToExactSphere_exactSphereToLOne (d : ℕ) (z : exactEuclideanSphere d) :
    lOneToExactSphere d (exactSphereToLOne d z) = z := by
  apply Subtype.ext
  apply PiLp.ext
  intro i
  rw [show (lOneToExactSphere d (exactSphereToLOne d z)).1 i =
    ‖toEuclidean d (exactSphereToLOne d z).1‖⁻¹ *
      ((lOneMass d z.1)⁻¹ * z.1 i) by rfl,
    norm_toEuclidean_exactSphereToLOne]
  have hm : lOneMass d z.1 ≠ 0 := (lOneMass_pos d z).ne'
  field_simp

def lOneExactSphereHomeomorph (d : ℕ) :
    lOneSphere d ≃ₜ exactEuclideanSphere d where
  toFun := lOneToExactSphere d
  invFun := exactSphereToLOne d
  left_inv := exactSphereToLOne_lOneToExactSphere d
  right_inv := lOneToExactSphere_exactSphereToLOne d
  continuous_toFun := by
    apply continuous_induced_rng.2
    have hraw : Continuous (fun y : lOneSphere d => toEuclidean d y.1) :=
      (PiLp.homeomorph 2 (fun _ : Fin d => ℝ)).symm.continuous.comp continuous_subtype_val
    exact (hraw.norm.inv₀ (fun y => norm_ne_zero_iff.mpr (toEuclidean_ne_zero d y))).smul hraw
  continuous_invFun := by
    apply continuous_induced_rng.2
    apply continuous_pi
    intro i
    have hmass : Continuous (fun z : exactEuclideanSphere d => lOneMass d z.1) := by
      unfold lOneMass
      fun_prop
    have hcoord : Continuous (fun z : exactEuclideanSphere d => z.1 i) := by
      fun_prop
    exact (hmass.inv₀ (fun z => (lOneMass_pos d z).ne')).mul hcoord

def crossExactSphereHomeomorph (d : ℕ) :
    preGeomTop (crosspolytope d).toPreAbstractSimplicialComplex ≃ₜ
      exactEuclideanSphere d :=
  (crossLOneHomeomorph d).trans (lOneExactSphereHomeomorph d)

/-! Exact chain-level transport APIs needed after the geometric model is built. -/

noncomputable def augmentedSingularIsoOfTopIso
    (K : Type*) [Field K] {X Y : TopCat} (e : X ≅ Y) :
    augmentedSingularChainComplex K X ≅ augmentedSingularChainComplex K Y where
  hom := augmentedSingularMap K e.hom
  inv := augmentedSingularMap K e.inv
  hom_inv_id := by
    unfold augmentedSingularMap
    rw [← augmentedSSetMap_comp]
    simp
  inv_hom_id := by
    unfold augmentedSingularMap
    rw [← augmentedSSetMap_comp]
    simp

noncomputable def liftedCrossExactSphereIso (d : ℕ) :
    liftedPreGeomTop.{u} (crosspolytope d).toPreAbstractSimplicialComplex ≅
      TopCat.uliftFunctor.{u}.obj (TopCat.of (exactEuclideanSphere d)) :=
  TopCat.uliftFunctor.mapIso (TopCat.isoOfHomeo (crossExactSphereHomeomorph d))

noncomputable def augmentedSingularCrossExactSphereIso
    (K : Type u) [Field K] (d : ℕ) :
    augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (crosspolytope d).toPreAbstractSimplicialComplex) ≅
      augmentedSingularChainComplex K
        (TopCat.uliftFunctor.{u}.obj (TopCat.of (exactEuclideanSphere d))) :=
  augmentedSingularIsoOfTopIso K (liftedCrossExactSphereIso d)

noncomputable def sphereRealizationCrossHomeomorph
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    preGeomTop D.toPreAbstractSimplicialComplex ≃ₜ
      preGeomTop (crosspolytope (n + 1)).toPreAbstractSimplicialComplex :=
  (Classical.choice hD.2).trans (crossExactSphereHomeomorph (n + 1)).symm

noncomputable def liftedSphereCrossIso
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    liftedPreGeomTop.{u} D.toPreAbstractSimplicialComplex ≅
      liftedPreGeomTop.{u}
        (crosspolytope (n + 1)).toPreAbstractSimplicialComplex :=
  TopCat.uliftFunctor.mapIso
    (TopCat.isoOfHomeo (sphereRealizationCrossHomeomorph D hD))

noncomputable def augmentedSingularSphereCrossIso
    (K : Type u) [Field K]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n) :
    augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} D.toPreAbstractSimplicialComplex) ≅
      augmentedSingularChainComplex K
        (liftedPreGeomTop.{u}
          (crosspolytope (n + 1)).toPreAbstractSimplicialComplex) :=
  augmentedSingularIsoOfTopIso K (liftedSphereCrossIso D hD)

/-- The exact composition needed once the finite affine comparison is exposed.
This probe takes the two comparison equivalences as arguments so it does not
depend on the still-in-progress production declaration. -/
noncomputable def faceSphereCrossHomotopyEquiv
    (K : Type u) [Field K] [CharP K 2]
    {m n : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (comparisonD :
      HomotopyEquiv
        (faceChainComplex K (AugmentedComplex.ofAbstract D))
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} D.toPreAbstractSimplicialComplex)))
    (comparisonCross :
      HomotopyEquiv
        (faceChainComplex K (crossAug (n + 1)))
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u}
            (crosspolytope (n + 1)).toPreAbstractSimplicialComplex))) :
    HomotopyEquiv
      (faceChainComplex K (AugmentedComplex.ofAbstract D))
      (faceChainComplex K (crossAug (n + 1))) :=
  comparisonD.trans
    ((HomotopyEquiv.ofIso (augmentedSingularSphereCrossIso K D hD)).trans
      comparisonCross.symm)

/-! The recursive last-coordinate decomposition used for the face-chain calculation. -/

def crossIncl (d : ℕ) : Fin (d + d) ↪ Fin ((d + 1) + (d + 1)) :=
  (cpEquiv d).symm.toEmbedding |>.trans
    (Function.Embedding.sumMap Fin.castSuccEmb Fin.castSuccEmb) |>.trans
    (cpEquiv (d + 1)).toEmbedding

@[simp]
theorem crossIncl_pos (d : ℕ) (i : Fin d) :
    crossIncl d (cpPos d i) = cpPos (d + 1) i.castSucc := by
  change finSumFinEquiv
    (Sum.map Fin.castSucc Fin.castSucc
      (finSumFinEquiv.symm (Fin.castAdd d i))) =
    Fin.castAdd (d + 1) i.castSucc
  rw [finSumFinEquiv_symm_apply_castAdd, Sum.map_inl,
    finSumFinEquiv_apply_left]

@[simp]
theorem crossIncl_neg (d : ℕ) (i : Fin d) :
    crossIncl d (cpNeg d i) = cpNeg (d + 1) i.castSucc := by
  change finSumFinEquiv
    (Sum.map Fin.castSucc Fin.castSucc
      (finSumFinEquiv.symm (Fin.natAdd d i))) =
    Fin.natAdd (d + 1) i.castSucc
  rw [finSumFinEquiv_symm_apply_natAdd, Sum.map_inr,
    finSumFinEquiv_apply_right]

def crossLastPos (d : ℕ) : Fin ((d + 1) + (d + 1)) :=
  cpPos (d + 1) (Fin.last d)

def crossLastNeg (d : ℕ) : Fin ((d + 1) + (d + 1)) :=
  cpNeg (d + 1) (Fin.last d)

@[simp]
theorem crossIncl_ne_lastPos (d : ℕ) (v : Fin (d + d)) :
    crossIncl d v ≠ crossLastPos d := by
  refine @Fin.addCases d d
    (fun v => crossIncl d v ≠ crossLastPos d)
    (fun i h => ?_) (fun i h => ?_) v
  · have hinc : crossIncl d (Fin.castAdd d i) =
        cpPos (d + 1) i.castSucc := by
      simpa [cpPos] using crossIncl_pos d i
    rw [hinc] at h
    have hval := congrArg Fin.val h
    simp [cpPos, crossLastPos] at hval
    omega
  · have hinc : crossIncl d (Fin.natAdd d i) =
        cpNeg (d + 1) i.castSucc := by
      simpa [cpNeg] using crossIncl_neg d i
    rw [hinc] at h
    have hval := congrArg Fin.val h
    simp [cpNeg, crossLastPos, cpPos] at hval
    omega

@[simp]
theorem crossIncl_ne_lastNeg (d : ℕ) (v : Fin (d + d)) :
    crossIncl d v ≠ crossLastNeg d := by
  refine @Fin.addCases d d
    (fun v => crossIncl d v ≠ crossLastNeg d)
    (fun i h => ?_) (fun i h => ?_) v
  · have hinc : crossIncl d (Fin.castAdd d i) =
        cpPos (d + 1) i.castSucc := by
      simpa [cpPos] using crossIncl_pos d i
    rw [hinc] at h
    have hval := congrArg Fin.val h
    simp [cpPos, crossLastNeg, cpNeg] at hval
    omega
  · have hinc : crossIncl d (Fin.natAdd d i) =
        cpNeg (d + 1) i.castSucc := by
      simpa [cpNeg] using crossIncl_neg d i
    rw [hinc] at h
    have hval := congrArg Fin.val h
    simp [cpNeg, crossLastNeg] at hval
    omega

theorem crossVertex_cases (d : ℕ) (v : Fin ((d + 1) + (d + 1))) :
    (∃ w : Fin (d + d), crossIncl d w = v) ∨
      v = crossLastPos d ∨ v = crossLastNeg d := by
  obtain ⟨s, rfl⟩ := (cpEquiv (d + 1)).surjective v
  rcases s with i | i
  · rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · exact Or.inl ⟨cpPos d j, crossIncl_pos d j⟩
    · exact Or.inr (Or.inl rfl)
  · rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · exact Or.inl ⟨cpNeg d j, crossIncl_neg d j⟩
    · exact Or.inr (Or.inr rfl)

theorem mem_range_crossIncl_iff (d : ℕ) (v : Fin ((d + 1) + (d + 1))) :
    v ∈ Set.range (crossIncl d) ↔
      v ≠ crossLastPos d ∧ v ≠ crossLastNeg d := by
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨crossIncl_ne_lastPos d w, crossIncl_ne_lastNeg d w⟩
  · rintro ⟨hp, hn⟩
    rcases crossVertex_cases d v with h | hpneg
    · exact h
    · exact False.elim (hpneg.elim hp hn)

def liftCrossFace (d : ℕ) (F : Finset (Fin (d + d))) :
    Finset (Fin ((d + 1) + (d + 1))) :=
  F.map (crossIncl d)

@[simp]
theorem card_liftCrossFace (d : ℕ) (F : Finset (Fin (d + d))) :
    (liftCrossFace d F).card = F.card := by
  exact Finset.card_map _

@[simp]
theorem lastPos_not_mem_liftCrossFace (d : ℕ) (F : Finset (Fin (d + d))) :
    crossLastPos d ∉ liftCrossFace d F := by
  simp [liftCrossFace]

@[simp]
theorem lastNeg_not_mem_liftCrossFace (d : ℕ) (F : Finset (Fin (d + d))) :
    crossLastNeg d ∉ liftCrossFace d F := by
  simp [liftCrossFace]

theorem liftCrossFace_mem (d : ℕ) (F : Finset (Fin (d + d)))
    (hF : F ∈ crossAug d) : liftCrossFace d F ∈ crossAug (d + 1) := by
  rw [AugmentedComplex.mem_ofAbstract] at hF ⊢
  rcases hF with rfl | hF
  · exact Or.inl (by simp [liftCrossFace])
  · refine Or.inr ((mem_crosspolytope (d + 1) _).mpr ⟨?_, ?_⟩)
    · exact hF.1.map
    · intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · change ¬(crossLastPos d ∈ liftCrossFace d F ∧
          crossLastNeg d ∈ liftCrossFace d F)
        simp
      · intro hboth
        apply hF.2 j
        constructor
        · rcases Finset.mem_map.mp hboth.1 with ⟨v, hv, heq⟩
          have hvEq : v = cpPos d j :=
            (crossIncl d).injective (heq.trans (crossIncl_pos d j).symm)
          simpa [hvEq] using hv
        · rcases Finset.mem_map.mp hboth.2 with ⟨v, hv, heq⟩
          have hvEq : v = cpNeg d j :=
            (crossIncl d).injective (heq.trans (crossIncl_neg d j).symm)
          simpa [hvEq] using hv

def lowerCrossFace (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1)))) : Finset (Fin (d + d)) :=
  F.preimage (crossIncl d) (crossIncl d).injective.injOn

@[simp]
theorem lowerCrossFace_liftCrossFace (d : ℕ) (F : Finset (Fin (d + d))) :
    lowerCrossFace d (liftCrossFace d F) = F := by
  exact Finset.preimage_map (crossIncl d) F

theorem liftCrossFace_lowerCrossFace_of_noLast (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1))))
    (hp : crossLastPos d ∉ F) (hn : crossLastNeg d ∉ F) :
    liftCrossFace d (lowerCrossFace d F) = F := by
  ext v
  constructor
  · rintro hv
    rcases Finset.mem_map.mp hv with ⟨w, hw, rfl⟩
    exact Finset.mem_preimage.mp hw
  · intro hv
    have hvRange : v ∈ Set.range (crossIncl d) :=
      (mem_range_crossIncl_iff d v).mpr
        ⟨fun h => hp (h ▸ hv), fun h => hn (h ▸ hv)⟩
    rcases hvRange with ⟨w, rfl⟩
    exact Finset.mem_map.mpr
      ⟨w, Finset.mem_preimage.mpr hv, rfl⟩

theorem lowerCrossFace_mem (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1))))
    (hF : F ∈ crossAug (d + 1)) : lowerCrossFace d F ∈ crossAug d := by
  rw [AugmentedComplex.mem_ofAbstract] at hF ⊢
  by_cases hL : lowerCrossFace d F = ∅
  · exact Or.inl hL
  · refine Or.inr ((mem_crosspolytope d _).mpr
      ⟨Finset.nonempty_iff_ne_empty.mpr hL, ?_⟩)
    intro i hboth
    have hp : cpPos (d + 1) i.castSucc ∈ F := by
      rw [← crossIncl_pos d i]
      exact Finset.mem_preimage.mp hboth.1
    have hn : cpNeg (d + 1) i.castSucc ∈ F := by
      rw [← crossIncl_neg d i]
      exact Finset.mem_preimage.mp hboth.2
    rcases hF with rfl | hF
    · simp at hp
    · exact hF.2 i.castSucc ⟨hp, hn⟩

theorem card_lowerCrossFace_of_noLast (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1))))
    (hp : crossLastPos d ∉ F) (hn : crossLastNeg d ∉ F) :
    (lowerCrossFace d F).card = F.card := by
  rw [← card_liftCrossFace d (lowerCrossFace d F),
    liftCrossFace_lowerCrossFace_of_noLast d F hp hn]

@[simp]
theorem mem_liftCrossFace (d : ℕ) (F : Finset (Fin (d + d)))
    (v : Fin (d + d)) :
    crossIncl d v ∈ liftCrossFace d F ↔ v ∈ F := by
  simp [liftCrossFace]

theorem crossAug_pair_condition (d : ℕ) (F : Finset (Fin (d + d)))
    (hF : F ∈ crossAug d) (i : Fin d) :
    ¬(cpPos d i ∈ F ∧ cpNeg d i ∈ F) := by
  rw [AugmentedComplex.mem_ofAbstract] at hF
  rcases hF with rfl | hF
  · simp
  · exact hF.2 i

@[simp]
theorem crossLastPos_ne_crossLastNeg (d : ℕ) :
    crossLastPos d ≠ crossLastNeg d := by
  exact cpPos_ne_cpNeg (d + 1) (Fin.last d)

theorem insertLastPos_liftCrossFace_mem (d : ℕ)
    (F : Finset (Fin (d + d))) (hF : F ∈ crossAug d) :
    insert (crossLastPos d) (liftCrossFace d F) ∈ crossAug (d + 1) := by
  rw [AugmentedComplex.mem_ofAbstract]
  refine Or.inr ((mem_crosspolytope (d + 1) _).mpr
    ⟨Finset.insert_nonempty _ _, ?_⟩)
  intro i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · intro hboth
    have hnmem : crossLastNeg d ∉
        insert (crossLastPos d) (liftCrossFace d F) := by
      simp [Ne.symm (crossLastPos_ne_crossLastNeg d)]
    exact hnmem hboth.2
  · intro hboth
    apply crossAug_pair_condition d F hF j
    constructor
    · have hne : cpPos (d + 1) j.castSucc ≠ crossLastPos d := by
        rw [← crossIncl_pos d j]
        exact crossIncl_ne_lastPos d (cpPos d j)
      have hmem := (Finset.mem_insert.mp hboth.1).resolve_left hne
      rw [← crossIncl_pos d j] at hmem
      exact (mem_liftCrossFace d F (cpPos d j)).mp hmem
    · have hne : cpNeg (d + 1) j.castSucc ≠ crossLastPos d := by
        rw [← crossIncl_neg d j]
        exact crossIncl_ne_lastPos d (cpNeg d j)
      have hmem := (Finset.mem_insert.mp hboth.2).resolve_left hne
      rw [← crossIncl_neg d j] at hmem
      exact (mem_liftCrossFace d F (cpNeg d j)).mp hmem

theorem insertLastNeg_liftCrossFace_mem (d : ℕ)
    (F : Finset (Fin (d + d))) (hF : F ∈ crossAug d) :
    insert (crossLastNeg d) (liftCrossFace d F) ∈ crossAug (d + 1) := by
  rw [AugmentedComplex.mem_ofAbstract]
  refine Or.inr ((mem_crosspolytope (d + 1) _).mpr
    ⟨Finset.insert_nonempty _ _, ?_⟩)
  intro i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · intro hboth
    have hpmem : crossLastPos d ∉
        insert (crossLastNeg d) (liftCrossFace d F) := by
      simp [crossLastPos_ne_crossLastNeg d]
    exact hpmem hboth.1
  · intro hboth
    apply crossAug_pair_condition d F hF j
    constructor
    · have hne : cpPos (d + 1) j.castSucc ≠ crossLastNeg d := by
        rw [← crossIncl_pos d j]
        exact crossIncl_ne_lastNeg d (cpPos d j)
      have hmem := (Finset.mem_insert.mp hboth.1).resolve_left hne
      rw [← crossIncl_pos d j] at hmem
      exact (mem_liftCrossFace d F (cpPos d j)).mp hmem
    · have hne : cpNeg (d + 1) j.castSucc ≠ crossLastNeg d := by
        rw [← crossIncl_neg d j]
        exact crossIncl_ne_lastNeg d (cpNeg d j)
      have hmem := (Finset.mem_insert.mp hboth.2).resolve_left hne
      rw [← crossIncl_neg d j] at hmem
      exact (mem_liftCrossFace d F (cpNeg d j)).mp hmem

@[simp]
theorem erase_lastPos_insert_liftCrossFace (d : ℕ)
    (F : Finset (Fin (d + d))) :
    (insert (crossLastPos d) (liftCrossFace d F)).erase (crossLastPos d) =
      liftCrossFace d F := by
  simp

@[simp]
theorem erase_lastNeg_insert_liftCrossFace (d : ℕ)
    (F : Finset (Fin (d + d))) :
    (insert (crossLastNeg d) (liftCrossFace d F)).erase (crossLastNeg d) =
      liftCrossFace d F := by
  simp

theorem erase_old_insert_lastPos (d : ℕ)
    (F : Finset (Fin (d + d))) (v : Fin (d + d)) :
    (insert (crossLastPos d) (liftCrossFace d F)).erase (crossIncl d v) =
      insert (crossLastPos d) (liftCrossFace d (F.erase v)) := by
  rw [Finset.erase_insert_of_ne (crossIncl_ne_lastPos d v).symm]
  simp [liftCrossFace]

theorem erase_old_insert_lastNeg (d : ℕ)
    (F : Finset (Fin (d + d))) (v : Fin (d + d)) :
    (insert (crossLastNeg d) (liftCrossFace d F)).erase (crossIncl d v) =
      insert (crossLastNeg d) (liftCrossFace d (F.erase v)) := by
  rw [Finset.erase_insert_of_ne (crossIncl_ne_lastNeg d v).symm]
  simp [liftCrossFace]

def liftCrossSimplex (d : ℕ) {q : ℕ} (F : AugmentedSimplex (crossAug d) q) :
    AugmentedSimplex (crossAug (d + 1)) q :=
  ⟨liftCrossFace d F.1, liftCrossFace_mem d F.1 F.2.1,
    (card_liftCrossFace d F.1).trans F.2.2⟩

def liftLastPosSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    AugmentedSimplex (crossAug (d + 1)) (q + 1) := by
  refine ⟨insert (crossLastPos d) (liftCrossFace d F.1),
    insertLastPos_liftCrossFace_mem d F.1 F.2.1, ?_⟩
  rw [Finset.card_insert_of_notMem (lastPos_not_mem_liftCrossFace d F.1),
    card_liftCrossFace, F.2.2]

def liftLastNegSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    AugmentedSimplex (crossAug (d + 1)) (q + 1) := by
  refine ⟨insert (crossLastNeg d) (liftCrossFace d F.1),
    insertLastNeg_liftCrossFace_mem d F.1 F.2.1, ?_⟩
  rw [Finset.card_insert_of_notMem (lastNeg_not_mem_liftCrossFace d F.1),
    card_liftCrossFace, F.2.2]

def lastPosVertex (d : ℕ) {q : ℕ} (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastPosSimplex d F).1 :=
  ⟨crossLastPos d, Finset.mem_insert_self _ _⟩

def lastNegVertex (d : ℕ) {q : ℕ} (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastNegSimplex d F).1 :=
  ⟨crossLastNeg d, Finset.mem_insert_self _ _⟩

def oldPosVertex (d : ℕ) {q : ℕ} (F : AugmentedSimplex (crossAug d) q)
    (v : ↥F.1) : ↥(liftLastPosSimplex d F).1 :=
  ⟨crossIncl d v.1, Finset.mem_insert_of_mem
    ((mem_liftCrossFace d F.1 v.1).mpr v.2)⟩

def oldNegVertex (d : ℕ) {q : ℕ} (F : AugmentedSimplex (crossAug d) q)
    (v : ↥F.1) : ↥(liftLastNegSimplex d F).1 :=
  ⟨crossIncl d v.1, Finset.mem_insert_of_mem
    ((mem_liftCrossFace d F.1 v.1).mpr v.2)⟩

@[simp]
theorem erase_liftLastPos_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    eraseSimplex (crossAug (d + 1)) (liftLastPosSimplex d F)
      (lastPosVertex d F) = liftCrossSimplex d F := by
  apply Subtype.ext
  exact erase_lastPos_insert_liftCrossFace d F.1

@[simp]
theorem erase_liftLastNeg_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    eraseSimplex (crossAug (d + 1)) (liftLastNegSimplex d F)
      (lastNegVertex d F) = liftCrossSimplex d F := by
  apply Subtype.ext
  exact erase_lastNeg_insert_liftCrossFace d F.1

theorem erase_liftLastPos_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) (q + 1)) (v : ↥F.1) :
    eraseSimplex (crossAug (d + 1)) (liftLastPosSimplex d F)
      (oldPosVertex d F v) =
        liftLastPosSimplex d (eraseSimplex (crossAug d) F v) := by
  apply Subtype.ext
  exact erase_old_insert_lastPos d F.1 v.1

theorem erase_liftLastNeg_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) (q + 1)) (v : ↥F.1) :
    eraseSimplex (crossAug (d + 1)) (liftLastNegSimplex d F)
      (oldNegVertex d F v) =
        liftLastNegSimplex d (eraseSimplex (crossAug d) F v) := by
  apply Subtype.ext
  exact erase_old_insert_lastNeg d F.1 v.1

theorem lastPos_not_mem_of_lastNeg_mem (d : ℕ)
    (F : Finset (Fin ((d + 1) + (d + 1))))
    (hF : F ∈ crossAug (d + 1)) (hn : crossLastNeg d ∈ F) :
    crossLastPos d ∉ F := by
  intro hp
  exact crossAug_pair_condition (d + 1) F hF (Fin.last d)
    ⟨by simpa [crossLastPos] using hp, by simpa [crossLastNeg] using hn⟩

def projectLastNegSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1))
    (hn : crossLastNeg d ∈ F.1) : AugmentedSimplex (crossAug d) q := by
  let E := F.1.erase (crossLastNeg d)
  have hE : E ∈ crossAug (d + 1) :=
    (crossAug (d + 1)).erase_mem F.2.1 (crossLastNeg d)
  have hpF : crossLastPos d ∉ F.1 :=
    lastPos_not_mem_of_lastNeg_mem d F.1 F.2.1 hn
  have hpE : crossLastPos d ∉ E := fun h => hpF (Finset.mem_of_mem_erase h)
  have hnE : crossLastNeg d ∉ E := by simp [E]
  refine ⟨lowerCrossFace d E, lowerCrossFace_mem d E hE, ?_⟩
  rw [card_lowerCrossFace_of_noLast d E hpE hnE,
    Finset.card_erase_of_mem hn, F.2.2]
  omega

@[simp]
theorem projectLastNegSimplex_liftLastNeg (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    projectLastNegSimplex d (liftLastNegSimplex d F)
      (Finset.mem_insert_self _ _) = F := by
  apply Subtype.ext
  simp [projectLastNegSimplex, liftLastNegSimplex]

def coneLastPosSimplex (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) q)
    (hp : crossLastPos d ∉ F.1) (hn : crossLastNeg d ∉ F.1) :
    AugmentedSimplex (crossAug (d + 1)) (q + 1) := by
  have hLower : lowerCrossFace d F.1 ∈ crossAug d :=
    lowerCrossFace_mem d F.1 F.2.1
  have heq : liftCrossFace d (lowerCrossFace d F.1) = F.1 :=
    liftCrossFace_lowerCrossFace_of_noLast d F.1 hp hn
  refine ⟨insert (crossLastPos d) F.1, ?_, ?_⟩
  · rw [← heq]
    exact insertLastPos_liftCrossFace_mem d _ hLower
  · rw [Finset.card_insert_of_notMem hp, F.2.2]

@[simp]
theorem erase_coneLastPos_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug (d + 1)) q)
    (hp : crossLastPos d ∉ F.1) (hn : crossLastNeg d ∉ F.1) :
    eraseSimplex (crossAug (d + 1)) (coneLastPosSimplex d F hp hn)
      ⟨crossLastPos d, Finset.mem_insert_self _ _⟩ = F := by
  apply Subtype.ext
  simp [coneLastPosSimplex, hp]

def crossProjectOnSimplex (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1)) :
    AugmentedChain K (crossAug d) q :=
  if hn : crossLastNeg d ∈ F.1 then
    Finsupp.single (projectLastNegSimplex d F hn) 1
  else 0

def crossProjection (K : Type*) [Field K] (d q : ℕ) :
    AugmentedChain K (crossAug (d + 1)) (q + 1) →ₗ[K]
      AugmentedChain K (crossAug d) q :=
  Finsupp.linearCombination K (crossProjectOnSimplex K d q)

def crossIncludeOnSimplex (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) q) :
    AugmentedChain K (crossAug (d + 1)) (q + 1) :=
  Finsupp.single (liftLastPosSimplex d F) 1 +
    Finsupp.single (liftLastNegSimplex d F) 1

def crossInclusion (K : Type*) [Field K] (d q : ℕ) :
    AugmentedChain K (crossAug d) q →ₗ[K]
      AugmentedChain K (crossAug (d + 1)) (q + 1) :=
  Finsupp.linearCombination K (crossIncludeOnSimplex K d q)

def crossConeOnSimplex (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) q) :
    AugmentedChain K (crossAug (d + 1)) (q + 1) :=
  if hp : crossLastPos d ∈ F.1 then 0
  else if hn : crossLastNeg d ∈ F.1 then 0
  else Finsupp.single (coneLastPosSimplex d F hp hn) 1

def crossCone (K : Type*) [Field K] (d q : ℕ) :
    AugmentedChain K (crossAug (d + 1)) q →ₗ[K]
      AugmentedChain K (crossAug (d + 1)) (q + 1) :=
  Finsupp.linearCombination K (crossConeOnSimplex K d q)

@[simp]
theorem crossProjection_single (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) (q + 1)) (a : K) :
    crossProjection K d q (Finsupp.single F a) =
      a • crossProjectOnSimplex K d q F := by
  exact Finsupp.linearCombination_single K a F

@[simp]
theorem crossInclusion_single (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug d) q) (a : K) :
    crossInclusion K d q (Finsupp.single F a) =
      a • crossIncludeOnSimplex K d q F := by
  exact Finsupp.linearCombination_single K a F

@[simp]
theorem crossCone_single (K : Type*) [Field K] (d q : ℕ)
    (F : AugmentedSimplex (crossAug (d + 1)) q) (a : K) :
    crossCone K d q (Finsupp.single F a) =
      a • crossConeOnSimplex K d q F := by
  exact Finsupp.linearCombination_single K a F

@[simp]
theorem crossProjectOnSimplex_liftLastPos (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossProjectOnSimplex K d q (liftLastPosSimplex d F) = 0 := by
  simp [crossProjectOnSimplex, liftLastPosSimplex,
    Ne.symm (crossLastPos_ne_crossLastNeg d)]

@[simp]
theorem crossProjectOnSimplex_liftLastNeg (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossProjectOnSimplex K d q (liftLastNegSimplex d F) =
      Finsupp.single F 1 := by
  unfold crossProjectOnSimplex
  rw [dif_pos (show crossLastNeg d ∈ (liftLastNegSimplex d F).1 from
    Finset.mem_insert_self _ _)]
  rw [projectLastNegSimplex_liftLastNeg]

theorem crossProjection_inclusion_single_one (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) q) :
    crossProjection K d q
      (crossInclusion K d q (Finsupp.single F 1)) = Finsupp.single F 1 := by
  simp [crossIncludeOnSimplex]

theorem crossProjection_comp_crossInclusion (K : Type*) [Field K]
    (d q : ℕ) :
    (crossProjection K d q).comp (crossInclusion K d q) = LinearMap.id := by
  apply Finsupp.lhom_ext
  intro F a
  simp [crossIncludeOnSimplex]

/-! The exact dimension-zero base of the recursive calculation. -/

def crossZeroEmptySimplex : AugmentedSimplex (crossAug 0) 0 :=
  ⟨∅, (crossAug 0).empty_mem, by simp⟩

instance crossZeroSimplexZeroUnique :
    Unique (AugmentedSimplex (crossAug 0) 0) where
  default := crossZeroEmptySimplex
  uniq F := by
    apply Subtype.ext
    exact Finset.eq_empty_of_forall_notMem fun v _ => Fin.elim0 v

instance crossZeroSimplexIsEmpty (q : ℕ) [NeZero q] :
    IsEmpty (AugmentedSimplex (crossAug 0) q) where
  false F := by
    have hF : F.1 = ∅ := by
      exact Finset.eq_empty_of_forall_notMem fun v _ => Fin.elim0 v
    have : q = 0 := by
      rw [← F.2.2, hF]
      simp
    exact NeZero.ne q this

variable (K : Type u) [Field K] [CharP K 2]

abbrev singleKZero : ChainComplex (ModuleCat K) ℕ :=
  (HomologicalComplex.single (ModuleCat K) (.down ℕ) 0).obj
    (ModuleCat.of K K)

noncomputable def crossZeroComponentIso (q : ℕ) :
    (faceChainComplex K (crossAug 0)).X q ≅ (singleKZero K).X q := by
  by_cases hq : q = 0
  · subst q
    exact (Finsupp.uniqueLinearEquiv K K crossZeroEmptySimplex).toModuleIso ≪≫
      (HomologicalComplex.singleObjXSelf (.down ℕ) 0
        (ModuleCat.of K K)).symm
  · letI : NeZero q := ⟨hq⟩
    have hs : IsZero ((faceChainComplex K (crossAug 0)).X q) := by
      change IsZero (ModuleCat.of K (AugmentedChain K (crossAug 0) q))
      exact ModuleCat.isZero_of_subsingleton _
    have ht : IsZero ((singleKZero K).X q) :=
      HomologicalComplex.isZero_single_obj_X (.down ℕ) 0
        (ModuleCat.of K K) q hq
    exact hs.iso ht

noncomputable def crossZeroComplexIso :
    faceChainComplex K (crossAug 0) ≅ singleKZero K :=
  HomologicalComplex.Hom.isoOfComponents (crossZeroComponentIso K) (by
    intro i j hij
    simp only [HomologicalComplex.single_obj_d, comp_zero]
    rw [ComplexShape.down_Rel] at hij
    subst i
    let _ : NeZero (j + 1) := ⟨Nat.succ_ne_zero j⟩
    have hs : IsZero ((faceChainComplex K (crossAug 0)).X (j + 1)) := by
      change IsZero (ModuleCat.of K
        (AugmentedChain K (crossAug 0) (j + 1)))
      exact ModuleCat.isZero_of_subsingleton _
    exact (hs.eq_of_src _ _).symm)

noncomputable def crossZeroHomotopyEquiv :
    HomotopyEquiv (faceChainComplex K (crossAug 0)) (singleKZero K) :=
  HomotopyEquiv.ofIso (crossZeroComplexIso K)

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Cardinal-degree suspension

Pinned Mathlib implements the suspension needed by the recursive
crosspolytope deformation retract as extension along
`ComplexShape.embeddingDown'Add 1 1`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace SimplicialSphereAnisotropicity.Topology

universe u

/-- `q ↦ q+1` as an embedding of the chain-complex shape into itself. -/
abbrev cardinalSuccEmbedding :
    (ComplexShape.down ℕ).Embedding (ComplexShape.down ℕ) :=
  ComplexShape.embeddingDown'Add (1 : ℕ) 1

instance : cardinalSuccEmbedding.IsRelIff := by
  change (ComplexShape.embeddingDown'Add (1 : ℕ) 1).IsRelIff
  infer_instance

variable (K : Type u) [Field K]

/-- Prepend a zero object in cardinal degree zero. -/
noncomputable abbrev cardinalSuspension
    (C : ChainComplex (ModuleCat K) ℕ) : ChainComplex (ModuleCat K) ℕ :=
  C.extend cardinalSuccEmbedding

noncomputable def cardinalSuspensionXIso
    (C : ChainComplex (ModuleCat K) ℕ) (q : ℕ) :
    (cardinalSuspension K C).X (q + 1) ≅ C.X q :=
  C.extendXIso cardinalSuccEmbedding rfl

theorem cardinalSuspensionXZero_isZero
    (C : ChainComplex (ModuleCat K) ℕ) :
    IsZero ((cardinalSuspension K C).X 0) := by
  apply C.isZero_extend_X cardinalSuccEmbedding
  intro q hq
  simp [cardinalSuccEmbedding] at hq

theorem cardinalSuspension_d_eq
    (C : ChainComplex (ModuleCat K) ℕ) (q : ℕ) :
    (cardinalSuspension K C).d (q + 2) (q + 1) =
      (cardinalSuspensionXIso K C (q + 1)).hom ≫ C.d (q + 1) q ≫
        (cardinalSuspensionXIso K C q).inv := by
  exact C.extend_d_eq cardinalSuccEmbedding rfl rfl

/-- The suspension functor is already additive in pinned Mathlib. -/
noncomputable abbrev cardinalSuspensionFunctor :
    ChainComplex (ModuleCat K) ℕ ⥤ ChainComplex (ModuleCat K) ℕ :=
  cardinalSuccEmbedding.extendFunctor (ModuleCat K)

noncomputable def cardinalSuspensionHomotopy
    {C D : ChainComplex (ModuleCat K) ℕ} {f g : C ⟶ D}
    (h : _root_.Homotopy f g) :
    _root_.Homotopy
      ((cardinalSuspensionFunctor K).map f)
      ((cardinalSuspensionFunctor K).map g) :=
  h.extend cardinalSuccEmbedding

noncomputable def cardinalSuspensionHomotopyEquiv
    {C D : ChainComplex (ModuleCat K) ℕ} (h : HomotopyEquiv C D) :
    HomotopyEquiv ((cardinalSuspensionFunctor K).obj C)
      ((cardinalSuspensionFunctor K).obj D) where
  hom := (cardinalSuspensionFunctor K).map h.hom
  inv := (cardinalSuspensionFunctor K).map h.inv
  homotopyHomInvId := by
    rw [← (cardinalSuspensionFunctor K).map_comp,
      ← (cardinalSuspensionFunctor K).map_id]
    exact cardinalSuspensionHomotopy K h.homotopyHomInvId
  homotopyInvHomId := by
    rw [← (cardinalSuspensionFunctor K).map_comp,
      ← (cardinalSuspensionFunctor K).map_id]
    exact cardinalSuspensionHomotopy K h.homotopyInvHomId

/-- Suspension carries a single complex in degree `q` to one in degree `q+1`. -/
noncomputable def cardinalSuspensionSingleIso (q : ℕ) :
    (cardinalSuspensionFunctor K).obj
        ((HomologicalComplex.single (ModuleCat K) (.down ℕ) q).obj
          (ModuleCat.of K K)) ≅
      (HomologicalComplex.single (ModuleCat K) (.down ℕ) (q + 1)).obj
        (ModuleCat.of K K) :=
  HomologicalComplex.extendSingleIso cardinalSuccEmbedding
    (ModuleCat.of K K) q (q + 1) rfl

end SimplicialSphereAnisotropicity.Topology

end

end

section

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

noncomputable def liftCrossVertexEquiv (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    ↥F.1 ≃ ↥(liftCrossFace d F.1) :=
  (Equiv.Set.image (crossIncl d) (F.1 : Set _) (crossIncl d).injective).trans
    (Equiv.setCongr (by
      ext v
      simp [liftCrossFace]))

@[simp]
theorem liftCrossVertexEquiv_apply (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    (liftCrossVertexEquiv d F v).1 = crossIncl d v.1 := rfl

noncomputable def lastPosVertexCast (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastPosSimplex d F).1 ≃
      ↥(insert (crossLastPos d) (liftCrossFace d F.1) : Set _) where
  toFun v := ⟨v.1, by simpa [liftLastPosSimplex] using v.2⟩
  invFun v := ⟨v.1, by
    change v.1 ∈ insert (crossLastPos d) (liftCrossFace d F.1)
    rcases v.2 with h | h
    · exact Finset.mem_insert.mpr (Or.inl h)
    · exact Finset.mem_insert.mpr (Or.inr h)⟩
  left_inv v := Subtype.ext rfl
  right_inv v := Subtype.ext rfl

@[simp]
theorem lastPosVertexCast_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    lastPosVertexCast d F (lastPosVertex d F) =
      (⟨crossLastPos d, Or.inl rfl⟩ :
        ↥(insert (crossLastPos d) (liftCrossFace d F.1) : Set _)) := by
  apply Subtype.ext
  rfl

@[simp]
theorem lastPosVertexCast_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    lastPosVertexCast d F (oldPosVertex d F v) =
      (⟨(liftCrossVertexEquiv d F v).1,
          Or.inr (liftCrossVertexEquiv d F v).2⟩ :
        ↥(insert (crossLastPos d) (liftCrossFace d F.1) : Set _)) := by
  apply Subtype.ext
  rfl

noncomputable def lastPosVertexEquiv (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastPosSimplex d F).1 ≃ ↥F.1 ⊕ PUnit :=
  (lastPosVertexCast d F).trans
    ((Equiv.Set.insert (lastPos_not_mem_liftCrossFace d F.1)).trans
      (Equiv.sumCongr (liftCrossVertexEquiv d F).symm (Equiv.refl _)))

@[simp]
theorem lastPosVertexEquiv_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    lastPosVertexEquiv d F (lastPosVertex d F) = Sum.inr PUnit.unit := by
  simp only [lastPosVertexEquiv, Equiv.trans_apply,
    lastPosVertexCast_last]
  rw [Equiv.Set.insert_apply_left]
  rfl

@[simp]
theorem lastPosVertexEquiv_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    lastPosVertexEquiv d F (oldPosVertex d F v) = Sum.inl v := by
  simp only [lastPosVertexEquiv, Equiv.trans_apply,
    lastPosVertexCast_old]
  rw [Equiv.Set.insert_apply_right]
  simpa only [Equiv.sumCongr_apply, Sum.map_inl] using
    congrArg Sum.inl ((liftCrossVertexEquiv d F).symm_apply_apply v)

@[simp]
theorem lastPosVertexEquiv_symm_inl (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    (lastPosVertexEquiv d F).symm (Sum.inl v) = oldPosVertex d F v := by
  apply (lastPosVertexEquiv d F).injective
  simp

@[simp]
theorem lastPosVertexEquiv_symm_inr (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    (lastPosVertexEquiv d F).symm (Sum.inr PUnit.unit) =
      lastPosVertex d F := by
  apply (lastPosVertexEquiv d F).injective
  simp

noncomputable def lastNegVertexCast (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastNegSimplex d F).1 ≃
      ↥(insert (crossLastNeg d) (liftCrossFace d F.1) : Set _) where
  toFun v := ⟨v.1, by simpa [liftLastNegSimplex] using v.2⟩
  invFun v := ⟨v.1, by
    change v.1 ∈ insert (crossLastNeg d) (liftCrossFace d F.1)
    rcases v.2 with h | h
    · exact Finset.mem_insert.mpr (Or.inl h)
    · exact Finset.mem_insert.mpr (Or.inr h)⟩
  left_inv v := Subtype.ext rfl
  right_inv v := Subtype.ext rfl

@[simp]
theorem lastNegVertexCast_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    lastNegVertexCast d F (lastNegVertex d F) =
      (⟨crossLastNeg d, Or.inl rfl⟩ :
        ↥(insert (crossLastNeg d) (liftCrossFace d F.1) : Set _)) := by
  apply Subtype.ext
  rfl

@[simp]
theorem lastNegVertexCast_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    lastNegVertexCast d F (oldNegVertex d F v) =
      (⟨(liftCrossVertexEquiv d F v).1,
          Or.inr (liftCrossVertexEquiv d F v).2⟩ :
        ↥(insert (crossLastNeg d) (liftCrossFace d F.1) : Set _)) := by
  apply Subtype.ext
  rfl

noncomputable def lastNegVertexEquiv (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    ↥(liftLastNegSimplex d F).1 ≃ ↥F.1 ⊕ PUnit :=
  (lastNegVertexCast d F).trans
    ((Equiv.Set.insert (lastNeg_not_mem_liftCrossFace d F.1)).trans
      (Equiv.sumCongr (liftCrossVertexEquiv d F).symm (Equiv.refl _)))

@[simp]
theorem lastNegVertexEquiv_last (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    lastNegVertexEquiv d F (lastNegVertex d F) = Sum.inr PUnit.unit := by
  simp only [lastNegVertexEquiv, Equiv.trans_apply,
    lastNegVertexCast_last]
  rw [Equiv.Set.insert_apply_left]
  rfl

@[simp]
theorem lastNegVertexEquiv_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    lastNegVertexEquiv d F (oldNegVertex d F v) = Sum.inl v := by
  simp only [lastNegVertexEquiv, Equiv.trans_apply,
    lastNegVertexCast_old]
  rw [Equiv.Set.insert_apply_right]
  simpa only [Equiv.sumCongr_apply, Sum.map_inl] using
    congrArg Sum.inl ((liftCrossVertexEquiv d F).symm_apply_apply v)

@[simp]
theorem lastNegVertexEquiv_symm_inl (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) (v : ↥F.1) :
    (lastNegVertexEquiv d F).symm (Sum.inl v) = oldNegVertex d F v := by
  apply (lastNegVertexEquiv d F).injective
  simp

@[simp]
theorem lastNegVertexEquiv_symm_inr (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) q) :
    (lastNegVertexEquiv d F).symm (Sum.inr PUnit.unit) =
      lastNegVertex d F := by
  apply (lastNegVertexEquiv d F).injective
  simp

@[simp]
theorem erase_liftCross_old (d : ℕ) {q : ℕ}
    (F : AugmentedSimplex (crossAug d) (q + 1)) (v : ↥F.1) :
    eraseSimplex (crossAug (d + 1)) (liftCrossSimplex d F)
        (liftCrossVertexEquiv d F v) =
      liftCrossSimplex d (eraseSimplex (crossAug d) F v) := by
  apply Subtype.ext
  change (liftCrossFace d F.1).erase (crossIncl d v.1) =
    liftCrossFace d (F.1.erase v.1)
  exact (Finset.map_erase (crossIncl d) F.1 v.1).symm

theorem boundaryOnSimplex_liftLastPos (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) (q + 1)) :
    boundaryOnSimplex K (crossAug (d + 1)) (q + 1)
        (liftLastPosSimplex d F) =
      Finsupp.single (liftCrossSimplex d F) 1 +
        ∑ v : ↥F.1,
          Finsupp.single
            (liftLastPosSimplex d (eraseSimplex (crossAug d) F v)) 1 := by
  let oldTerm : ↥F.1 → AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    fun v ↦ Finsupp.single
      (liftLastPosSimplex d (eraseSimplex (crossAug d) F v)) 1
  let splitTerm : ↥F.1 ⊕ PUnit →
      AugmentedChain K (crossAug (d + 1)) (q + 1) :=
    Sum.elim oldTerm (fun _ ↦ Finsupp.single (liftCrossSimplex d F) 1)
  unfold boundaryOnSimplex
  calc
    (∑ w : ↥(liftLastPosSimplex d F).1,
        Finsupp.single
          (eraseSimplex (crossAug (d + 1)) (liftLastPosSimplex d F) w) 1) =
        ∑ z : ↥F.1 ⊕ PUnit, splitTerm z := by
      symm
      apply Fintype.sum_equiv (lastPosVertexEquiv d F).symm
      intro z
      rcases z with v | p
      · simp [splitTerm, oldTerm, erase_liftLastPos_old]
      · rcases p with ⟨⟩
        simp [splitTerm]
    _ = Finsupp.single (liftCrossSimplex d F) 1 + ∑ v : ↥F.1,
          Finsupp.single
            (liftLastPosSimplex d (eraseSimplex (crossAug d) F v)) 1 := by
      simp [splitTerm, oldTerm, Fintype.sum_sum_type, add_comm]

theorem boundaryOnSimplex_liftCross (K : Type*) [Field K]
    (d q : ℕ) (F : AugmentedSimplex (crossAug d) (q + 1)) :
    boundaryOnSimplex K (crossAug (d + 1)) q
        (liftCrossSimplex d F) =
      ∑ v : ↥F.1,
        Finsupp.single
          (liftCrossSimplex d (eraseSimplex (crossAug d) F v)) 1 := by
  unfold boundaryOnSimplex
  symm
  apply Fintype.sum_equiv (liftCrossVertexEquiv d F)
  intro v
  simp [erase_liftCross_old]

theorem boundaryOnSimplex_liftLastPos_zero (K : Type*) [Field K]
    (d : ℕ) (F : AugmentedSimplex (crossAug d) 0) :
    boundaryOnSimplex K (crossAug (d + 1)) 0
        (liftLastPosSimplex d F) =
      Finsupp.single (liftCrossSimplex d F) 1 := by
  have hF : F.1 = ∅ := Finset.card_eq_zero.mp F.2.2
  let hEmpty : IsEmpty ↥F.1 := ⟨fun v ↦ by simpa [hF] using v.2⟩
  let splitTerm : ↥F.1 ⊕ PUnit →
      AugmentedChain K (crossAug (d + 1)) 0 :=
    Sum.elim (fun v ↦ False.elim (hEmpty.false v))
      (fun _ ↦ Finsupp.single (liftCrossSimplex d F) 1)
  unfold boundaryOnSimplex
  calc
    (∑ w : ↥(liftLastPosSimplex d F).1,
        Finsupp.single
          (eraseSimplex (crossAug (d + 1)) (liftLastPosSimplex d F) w) 1) =
        ∑ z : ↥F.1 ⊕ PUnit, splitTerm z := by
      symm
      apply Fintype.sum_equiv (lastPosVertexEquiv d F).symm
      intro z
      rcases z with v | p
      · exact False.elim (hEmpty.false v)
      · rcases p with ⟨⟩
        simp [splitTerm]
    _ = Finsupp.single (liftCrossSimplex d F) 1 := by
      simp [splitTerm, Fintype.sum_sum_type]

