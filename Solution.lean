/-!
# Parameter-linearity and canonical face-ring descent of Brion integration

The fraction-field characterization makes the chosen polynomial Brion value
additive and linear over the parameter polynomial ring.  This file then
specializes the coefficient matrix to the trusted generic coefficients and
proves that deleting nonface terms does not change any facet restriction.
Consequently Brion integration defines a linear map on the canonical
allowed-exponent face-ring model.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

theorem brionRational_add
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f g : MvPolynomial V L) :
    brionRational L D d a ha (f + g) =
      brionRational L D d a ha f + brionRational L D d a ha g := by
  simp [brionRational, facetBrionFraction, facetBrionNumerator,
    add_div, Finset.sum_add_distrib]

theorem brionRational_zero
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    brionRational L D d a ha 0 = 0 := by
  simp [brionRational, facetBrionFraction, facetBrionNumerator]

noncomputable def parameterActionAlgHom
    (L : Type*) [Field L]
    {V : Type u} [Fintype V]
    (d : ℕ) (a : Matrix (Fin d) V L) :
    ParameterPolynomial L d →ₐ[L] MvPolynomial V L :=
  MvPolynomial.aeval (parameterLinearForm L d a)

@[simp]
theorem parameterActionAlgHom_X
    (L : Type*) [Field L]
    {V : Type u} [Fintype V]
    (d : ℕ) (a : Matrix (Fin d) V L) (i : Fin d) :
    parameterActionAlgHom L d a (MvPolynomial.X i) =
      parameterLinearForm L d a i := by
  simp [parameterActionAlgHom]

theorem facetRestriction_parameterActionAlgHom
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (p : ParameterPolynomial L d) :
    facetRestriction L d a F hF hdet
        (parameterActionAlgHom L d a p) = p := by
  let comp : ParameterPolynomial L d →ₐ[L] ParameterPolynomial L d :=
    (facetRestriction L d a F hF hdet).comp
      (parameterActionAlgHom L d a)
  have hcomp : comp = AlgHom.id L (ParameterPolynomial L d) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [comp, facetRestriction_parameterLinearForm]
  change comp p = p
  rw [hcomp]
  rfl

theorem brionRational_parameterAction_mul
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (p : ParameterPolynomial L d) (f : MvPolynomial V L) :
    brionRational L D d a ha
        (parameterActionAlgHom L d a p * f) =
      algebraMap (ParameterPolynomial L d) (ParameterFraction L d) p *
        brionRational L D d a ha f := by
  rw [brionRational, brionRational, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro F _hF
  simp [facetBrionFraction, facetBrionNumerator,
    facetRestriction_parameterActionAlgHom,
    div_eq_mul_inv, mul_assoc]

theorem brionPolynomial_add
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f g : MvPolynomial V L) :
    brionPolynomial L D d hd hpm a ha (f + g) =
      brionPolynomial L D d hd hpm a ha f +
        brionPolynomial L D d hd hpm a ha g := by
  apply IsFractionRing.injective
    (ParameterPolynomial L d) (ParameterFraction L d)
  rw [map_add,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha]
  exact brionRational_add L D d a ha f g

theorem brionPolynomial_zero
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    brionPolynomial L D d hd hpm a ha 0 = 0 := by
  apply IsFractionRing.injective
    (ParameterPolynomial L d) (ParameterFraction L d)
  rw [map_zero,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha]
  exact brionRational_zero L D d a ha

theorem brionPolynomial_parameterAction_mul
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (p : ParameterPolynomial L d) (f : MvPolynomial V L) :
    brionPolynomial L D d hd hpm a ha
        (parameterActionAlgHom L d a p * f) =
      p * brionPolynomial L D d hd hpm a ha f := by
  apply IsFractionRing.injective
    (ParameterPolynomial L d) (ParameterFraction L d)
  rw [map_mul,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha,
    ← brionRational_eq_algebraMap_brionPolynomial L D d hd hpm a ha]
  exact brionRational_parameterAction_mul L D d a ha p f

@[instance_reducible]
noncomputable def parameterActionAlgebra
    (L : Type*) [Field L]
    {V : Type u} [Fintype V]
    (d : ℕ) (a : Matrix (Fin d) V L) :
    Algebra (ParameterPolynomial L d) (MvPolynomial V L) :=
  (parameterActionAlgHom L d a).toRingHom.toAlgebra

noncomputable def brionPolynomialLinearMap
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    letI : Algebra (ParameterPolynomial L d) (MvPolynomial V L) :=
      parameterActionAlgebra L d a
    MvPolynomial V L →ₗ[ParameterPolynomial L d]
      ParameterPolynomial L d := by
  letI : Algebra (ParameterPolynomial L d) (MvPolynomial V L) :=
    parameterActionAlgebra L d a
  exact
    { toFun := brionPolynomial L D d hd hpm a ha
      map_add' := brionPolynomial_add L D d hd hpm a ha
      map_smul' := by
        intro p f
        change brionPolynomial L D d hd hpm a ha
            (parameterActionAlgHom L d a p * f) =
          p * brionPolynomial L D d hd hpm a ha f
        exact brionPolynomial_parameterAction_mul
          L D d hd hpm a ha p f }

noncomputable def genericCoefficientMatrix
    (k : Type*) [Field k] {n m : ℕ} :
    Matrix (Fin (n + 1)) (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m) :=
  fun i v ↦ SimplicialSphereAnisotropicity.genericCoefficient k i v

theorem genericFacetMatrix_det_ne_zero
    (k : Type*) [Field k] {n m : ℕ}
    {D : AbstractSimplicialComplex (Fin m)}
    (F : FacetOfCard D (n + 1)) :
    (facetMatrix (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
      (genericCoefficientMatrix k) F.1 F.2.2).det ≠ 0 := by
  have hmatrix :
      facetMatrix (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
          (genericCoefficientMatrix k) F.1 F.2.2 =
        Generic.faceCoefficientMatrix k F.1 F.2.2 := by
    ext i j
    rfl
  rw [hmatrix]
  exact Generic.faceMinor_ne_zero k F.1 F.2.2

theorem parameterActionAlgHom_genericCoefficientMatrix
    (k : Type*) [Field k] {n m : ℕ} :
    parameterActionAlgHom (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) =
      ambientParameterAlgHom k := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [parameterActionAlgHom_X, ambientParameterAlgHom_X,
    parameterLinearForm, genericCoefficientMatrix,
    SimplicialSphereAnisotropicity.genericLinearForm]

theorem facetRestriction_facePart
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (F : FacetOfCard D (n + 1))
    (q : MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m)) :
    facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) F.1 F.2.2
        (genericFacetMatrix_det_ne_zero k F)
        (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)
          (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) q)) =
      facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) F.1 F.2.2
        (genericFacetMatrix_det_ne_zero k F) q := by
  let qface := faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
    (AugmentedComplex.ofAbstract D)
    (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D) q)
  have hideal : q - qface ∈
      SimplicialSphereAnisotropicity.stanleyReisnerIdeal
        (K := SimplicialSphereAnisotropicity.GenericField k n m) D := by
    exact polynomial_sub_facePart_mem_stanleyReisnerIdeal
      (SimplicialSphereAnisotropicity.GenericField k n m) D q
  have hambient : ambientFaceRestriction
      (SimplicialSphereAnisotropicity.GenericField k n m) F.1 (q - qface) = 0 := by
    have hker := stanleyReisnerIdeal_le_ker_ambientFaceRestriction
      (SimplicialSphereAnisotropicity.GenericField k n m) D F.1 F.2.1 hideal
    exact hker
  have hzero : facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
      (genericCoefficientMatrix k) F.1 F.2.2
      (genericFacetMatrix_det_ne_zero k F) (q - qface) = 0 := by
    change (facetParameterAlgEquiv (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
      (genericCoefficientMatrix k) F.1 F.2.2
      (genericFacetMatrix_det_ne_zero k F)).symm
        (ambientFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) F.1
          (q - qface)) = 0
    rw [hambient]
    simp
  rw [map_sub] at hzero
  exact (sub_eq_zero.mp hzero).symm

theorem genericBrionPolynomial_facePart
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (q : MvPolynomial (Fin m) (SimplicialSphereAnisotropicity.GenericField k n m)) :
    brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
        (genericCoefficientMatrix k)
        (genericFacetMatrix_det_ne_zero k)
        (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)
          (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) q)) =
      brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
        (genericCoefficientMatrix k)
        (genericFacetMatrix_det_ne_zero k) q := by
  apply IsFractionRing.injective
    (ParameterPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1))
    (ParameterFraction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1))
  rw [← brionRational_eq_algebraMap_brionPolynomial
      (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
      (genericCoefficientMatrix k) (genericFacetMatrix_det_ne_zero k),
    ← brionRational_eq_algebraMap_brionPolynomial
      (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
      (genericCoefficientMatrix k) (genericFacetMatrix_det_ne_zero k)]
  unfold brionRational
  apply Finset.sum_congr rfl
  intro F _hF
  simp only [facetBrionFraction, facetBrionNumerator]
  rw [facetRestriction_facePart k D F q]

set_option linter.style.haveILetI false in
noncomputable def faceRingBrionLinearMap
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D) →ₗ[Generic.ParameterRing k n m]
      Generic.ParameterRing k n m := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  exact
    { toFun := fun z ↦
        brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k)
          (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) z)
      map_add' := by
        intro x y
        rw [map_add]
        exact brionPolynomial_add
          (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) _ _
      map_smul' := by
        intro p z
        rw [faceRingModelCanonical_smul_eq_facePart]
        change brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1)
            hd hpm (genericCoefficientMatrix k)
            (genericFacetMatrix_det_ne_zero k)
            (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
              (AugmentedComplex.ofAbstract D)
              (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
                (AugmentedComplex.ofAbstract D)
                (ambientParameterAlgHom k p *
                  faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
                    (AugmentedComplex.ofAbstract D) z))) =
          p * brionPolynomial (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1)
            hd hpm (genericCoefficientMatrix k)
            (genericFacetMatrix_det_ne_zero k)
            (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
              (AugmentedComplex.ofAbstract D) z)
        rw [genericBrionPolynomial_facePart]
        rw [← parameterActionAlgHom_genericCoefficientMatrix k]
        exact brionPolynomial_parameterAction_mul
          (SimplicialSphereAnisotropicity.GenericField k n m) D (n + 1) hd hpm
          (genericCoefficientMatrix k)
          (genericFacetMatrix_det_ne_zero k) p _ }

end SimplicialSphereAnisotropicity.Generic.Brion

