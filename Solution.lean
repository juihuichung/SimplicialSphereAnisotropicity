section

noncomputable section

open scoped BigOperators
open MvPolynomial CategoryTheory

namespace SimplicialSphereAnisotropicity.Generic

universe u v

def subfaceEmbedding {m : ℕ} {F G : Finset (Fin m)} (hFG : F ⊆ G) :
    ↥F ↪ ↥G where
  toFun v := ⟨v.1, hFG v.2⟩
  inj' := fun _ _ h ↦
    Subtype.ext (congrArg (fun z : ↥G ↦ z.1) h)

noncomputable def faceParameterAlgHomViaFacet
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    ParameterRing k n m →ₐ[SimplicialSphereAnisotropicity.GenericField k n m]
      MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m) :=
  (MvPolynomial.killCompl
      (subfaceEmbedding hFG).injective).comp
    (facetParameterAlgEquiv k G hGcard).toAlgHom

theorem faceParameterAlgHomViaFacet_surjective
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    Function.Surjective
      (faceParameterAlgHomViaFacet k F G hFG hGcard) := by
  intro p
  let e := subfaceEmbedding hFG
  let q : MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m) :=
    MvPolynomial.rename e p
  refine ⟨(facetParameterAlgEquiv k G hGcard).symm q, ?_⟩
  simp [faceParameterAlgHomViaFacet, q, e]

@[simp]
theorem killCompl_X_embedding
    {R : Type u} [CommSemiring R]
    {sigma tau : Type v} (e : sigma ↪ tau) (i : sigma) :
    MvPolynomial.killCompl (R := R) e.injective
        (MvPolynomial.X (e i)) = MvPolynomial.X i := by
  simpa using MvPolynomial.killCompl_rename_app
    (R := R) e.injective (MvPolynomial.X i)

theorem killCompl_X_eq_zero
    {R : Type u} [CommSemiring R]
    {sigma tau : Type v} (e : sigma ↪ tau) (j : tau)
    (hj : j ∉ Set.range e) :
    MvPolynomial.killCompl (R := R) e.injective
        (MvPolynomial.X j) = 0 := by
  simp [MvPolynomial.killCompl, hj]

theorem killCompl_sum_C_mul_X
    {R : Type u} [CommSemiring R]
    {sigma tau : Type v} [Fintype sigma] [Fintype tau]
    (e : sigma ↪ tau) (a : tau → R) :
    MvPolynomial.killCompl e.injective
        (∑ j : tau, MvPolynomial.C (a j) * MvPolynomial.X j) =
      ∑ i : sigma,
        MvPolynomial.C (a (e i)) * MvPolynomial.X i := by
  classical
  rw [map_sum]
  let term : tau → MvPolynomial sigma R := fun j ↦
    MvPolynomial.killCompl e.injective
      (MvPolynomial.C (a j) * MvPolynomial.X j)
  calc
    _ = ∑ j : tau, term j := by rfl
    _ = ∑ j ∈ Finset.univ.filter (fun j : tau ↦ j ∈ Set.range e),
        term j := by
      symm
      apply Finset.sum_subset (Finset.filter_subset _ _)
      intro j _ hj
      have hnot : j ∉ Set.range e := by simpa using hj
      dsimp only [term]
      rw [map_mul, MvPolynomial.killCompl_C,
        killCompl_X_eq_zero e j hnot, mul_zero]
    _ = ∑ i : sigma,
        MvPolynomial.C (a (e i)) * MvPolynomial.X i := by
      symm
      apply Finset.sum_bij
          (s := Finset.univ)
          (t := Finset.univ.filter (fun j : tau ↦ j ∈ Set.range e))
          (fun i _ ↦ e i)
      · intro i _
        simp
      · intro i₁ _ i₂ _ hi
        exact e.injective hi
      · intro j hj
        rw [Finset.mem_filter] at hj
        obtain ⟨i, rfl⟩ := hj.2
        exact ⟨i, Finset.mem_univ i, rfl⟩
      · intro i _
        dsimp only [term]
        rw [map_mul, MvPolynomial.killCompl_C,
          killCompl_X_embedding]

noncomputable def restrictedGenericLinearForm
    (k : Type u) [Field k] {n m : ℕ} (F : Finset (Fin m))
    (i : Fin (n + 1)) :
    MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m) :=
  ∑ v : ↥F,
    MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i v.1) *
      MvPolynomial.X v

noncomputable def faceParameterAlgHom
    (k : Type u) [Field k] {n m : ℕ} (F : Finset (Fin m)) :
    ParameterRing k n m →ₐ[SimplicialSphereAnisotropicity.GenericField k n m]
      MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m) :=
  MvPolynomial.aeval (restrictedGenericLinearForm k F)

@[simp]
theorem faceParameterAlgHom_X
    (k : Type u) [Field k] {n m : ℕ}
    (F : Finset (Fin m)) (i : Fin (n + 1)) :
    faceParameterAlgHom k F (MvPolynomial.X i) =
      restrictedGenericLinearForm k F i := by
  simp [faceParameterAlgHom]

theorem faceParameterAlgHomViaFacet_X
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1)
    (i : Fin (n + 1)) :
    faceParameterAlgHomViaFacet k F G hFG hGcard (MvPolynomial.X i) =
      restrictedGenericLinearForm k F i := by
  classical
  rw [faceParameterAlgHomViaFacet, AlgHom.comp_apply]
  change MvPolynomial.killCompl (subfaceEmbedding hFG).injective
      (facetParameterAlgEquiv k G hGcard (MvPolynomial.X i)) = _
  have hfacet : facetParameterAlgEquiv k G hGcard (MvPolynomial.X i) =
      ∑ g : ↥G,
        MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i g.1) *
          MvPolynomial.X g := by
    rw [facetParameterAlgEquiv_X]
    let o := G.orderIsoOfFin hGcard
    simpa [o, orderedFaceEmbedding] using
      (Equiv.sum_comp o.toEquiv
        (fun g : ↥G ↦
          MvPolynomial.C (SimplicialSphereAnisotropicity.genericCoefficient k i g.1) *
            MvPolynomial.X g))
  rw [hfacet, restrictedGenericLinearForm]
  exact killCompl_sum_C_mul_X
    (subfaceEmbedding hFG)
    (fun g : ↥G ↦ SimplicialSphereAnisotropicity.genericCoefficient k i g.1)

theorem faceParameterAlgHom_eq_viaFacet
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    faceParameterAlgHom k F =
      faceParameterAlgHomViaFacet k F G hFG hGcard := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [faceParameterAlgHom_X,
    faceParameterAlgHomViaFacet_X]

theorem faceParameterAlgHom_surjective
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    Function.Surjective (faceParameterAlgHom k (n := n) (m := m) F) := by
  rw [faceParameterAlgHom_eq_viaFacet k F G hFG hGcard]
  exact faceParameterAlgHomViaFacet_surjective
    k F G hFG hGcard

noncomputable def faceCoordinateRestriction
    {K : Type u} [Field K] {m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G) :
    MvPolynomial ↥G K →ₐ[K] MvPolynomial ↥F K :=
  MvPolynomial.killCompl (subfaceEmbedding hFG).injective

theorem faceCoordinateRestriction_restrictedGenericLinearForm
    (k : Type u) [Field k] {n m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G) (i : Fin (n + 1)) :
    faceCoordinateRestriction (K := SimplicialSphereAnisotropicity.GenericField k n m) hFG
        (restrictedGenericLinearForm k G i) =
      restrictedGenericLinearForm k F i := by
  rw [faceCoordinateRestriction, restrictedGenericLinearForm,
    restrictedGenericLinearForm]
  exact killCompl_sum_C_mul_X
    (subfaceEmbedding hFG)
    (fun g : ↥G ↦ SimplicialSphereAnisotropicity.genericCoefficient k i g.1)

theorem faceCoordinateRestriction_comp_parameter
    (k : Type u) [Field k] {n m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G) :
    (faceCoordinateRestriction (K := SimplicialSphereAnisotropicity.GenericField k n m) hFG).comp
        (faceParameterAlgHom k G) =
      faceParameterAlgHom k F := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [AlgHom.comp_apply, faceParameterAlgHom_X,
    faceCoordinateRestriction_restrictedGenericLinearForm,
    faceParameterAlgHom_X]

theorem faceParameterAlgHomViaFacet_ker
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    RingHom.ker (faceParameterAlgHomViaFacet k F G hFG hGcard).toRingHom =
      (Ideal.span
        (MvPolynomial.X ''
          {i : ↥G | i ∉ Set.range (subfaceEmbedding hFG)} :
          Set (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m)))).comap
        (facetParameterAlgEquiv k G hGcard).toRingEquiv.toRingHom := by
  ext p
  rw [RingHom.mem_ker, Ideal.mem_comap]
  change MvPolynomial.killCompl
      (R := SimplicialSphereAnisotropicity.GenericField k n m)
      (subfaceEmbedding hFG).injective
      (facetParameterAlgEquiv k G hGcard p) = 0 ↔ _
  rw [← SimplicialSphereAnisotropicity.Algebra.ker_killCompl_eq_span_complement
      (subfaceEmbedding hFG) (subfaceEmbedding hFG).injective,
    RingHom.mem_ker]
  rfl

theorem faceParameterAlgHom_ker
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    RingHom.ker (faceParameterAlgHom k F).toRingHom =
      (Ideal.span
        (MvPolynomial.X ''
          {i : ↥G | i ∉ Set.range (subfaceEmbedding hFG)} :
          Set (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m)))).comap
        (facetParameterAlgEquiv k G hGcard).toRingEquiv.toRingHom := by
  rw [faceParameterAlgHom_eq_viaFacet k F G hFG hGcard]
  exact faceParameterAlgHomViaFacet_ker
    k F G hFG hGcard

theorem subfaceEmbedding_complement_card
    {m : ℕ} {F G : Finset (Fin m)} (hFG : F ⊆ G) :
    Fintype.card
        {g : ↥G // g ∉ Set.range (subfaceEmbedding hFG)} =
      G.card - F.card := by
  rw [Fintype.card_subtype_compl, Fintype.card_coe,
    Fintype.card_range, Fintype.card_coe]

noncomputable instance faceParameterAlgebra
    (k : Type u) [Field k] {n m : ℕ} (F : Finset (Fin m)) :
    Algebra (ParameterRing k n m)
      (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)) :=
  (faceParameterAlgHom k F).toRingHom.toAlgebra

@[simp]
theorem faceParameterAlgebra_algebraMap_apply
    (k : Type u) [Field k] {n m : ℕ} (F : Finset (Fin m))
    (p : ParameterRing k n m) :
    algebraMap (ParameterRing k n m)
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)) p =
      faceParameterAlgHom k F p := rfl

noncomputable def faceCoordinateRestrictionLinear
    (k : Type u) [Field k] {n m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G) :
    MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m) →ₗ[ParameterRing k n m]
      MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m) where
  toFun := faceCoordinateRestriction
    (K := SimplicialSphereAnisotropicity.GenericField k n m) hFG
  map_add' := map_add _
  map_smul' p z := by
    simp only [Algebra.smul_def,
      faceParameterAlgebra_algebraMap_apply]
    rw [map_mul]
    congr 1
    exact AlgHom.congr_fun
      (faceCoordinateRestriction_comp_parameter k hFG) p

@[simp]
theorem faceCoordinateRestrictionLinear_apply
    (k : Type u) [Field k] {n m : ℕ}
    {F G : Finset (Fin m)} (hFG : F ⊆ G)
    (p : MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m)) :
    faceCoordinateRestrictionLinear k hFG p =
      faceCoordinateRestriction (K := SimplicialSphereAnisotropicity.GenericField k n m) hFG p := rfl


set_option linter.style.haveILetI false in
attribute [local instance] RingHomInvPair.of_ringEquiv in
theorem faceCoordinate_hasProjectiveDimensionLT
    (k : Type u) [Field k] {n m : ℕ}
    (F G : Finset (Fin m)) (hFG : F ⊆ G) (hGcard : G.card = n + 1) :
    HasProjectiveDimensionLT
      (ModuleCat.of (ParameterRing k n m)
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)))
      (n + 1 - F.card + 1) := by
  classical
  let eFG := subfaceEmbedding hFG
  letI : Algebra
      (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m))
      (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)) :=
    (MvPolynomial.killCompl
      (R := SimplicialSphereAnisotropicity.GenericField k n m) eFG.injective).toRingHom.toAlgebra
  have hstandard : HasProjectiveDimensionLT
      (ModuleCat.of
        (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m))
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)))
      (G.card - F.card + 1) := by
    simpa [eFG] using
      (SimplicialSphereAnisotropicity.Algebra.coordinateRestriction_hasProjectiveDimensionLT
        (K := SimplicialSphereAnisotropicity.GenericField k n m) eFG)
  let eR : ParameterRing k n m ≃+*
      MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m) :=
    (facetParameterAlgEquiv k G hGcard).toRingEquiv
  let eM :
      (ModuleCat.of (ParameterRing k n m)
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)))
        ≃ₛₗ[RingHomClass.toRingHom eR]
      (ModuleCat.of
        (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m))
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m))) :=
    { __ := AddEquiv.refl _
      map_smul' p z := by
        simp only [Algebra.smul_def]
        change faceParameterAlgHom k F p * z =
          MvPolynomial.killCompl eFG.injective
            (facetParameterAlgEquiv k G hGcard p) * z
        congr 1
        rw [faceParameterAlgHom_eq_viaFacet k F G hFG hGcard]
        rfl }
  let _ : HasProjectiveDimensionLE
      (ModuleCat.of
        (MvPolynomial ↥G (SimplicialSphereAnisotropicity.GenericField k n m))
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)))
      (G.card - F.card) := hstandard
  have hout : HasProjectiveDimensionLE
      (ModuleCat.of (ParameterRing k n m)
        (MvPolynomial ↥F (SimplicialSphereAnisotropicity.GenericField k n m)))
      (G.card - F.card) :=
    ModuleCat.hasProjectiveDimensionLE_of_semiLinearEquiv
      eR.symm eM.symm (G.card - F.card)
  simpa [HasProjectiveDimensionLE, hGcard] using hout

end SimplicialSphereAnisotropicity.Generic
end

