noncomputable def splitKernelProjection
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
    (f : P →ₗ[R] M) (g : M →ₗ[R] P) : P →ₗ[R] P :=
  LinearMap.id - g.comp f

theorem splitKernelProjection_mem_ker
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
    (f : P →ₗ[R] M) (g : M →ₗ[R] P)
    (hg : f.comp g = LinearMap.id) (p : P) :
    splitKernelProjection f g p ∈ LinearMap.ker f := by
  rw [LinearMap.mem_ker]
  have hgf : ∀ x, f (g x) = x := by
    intro x
    exact DFunLike.congr_fun hg x
  simp only [splitKernelProjection, LinearMap.sub_apply,
    LinearMap.id_apply, map_sub, LinearMap.comp_apply, hgf, sub_self]

theorem splitKernelProjection_eq_self_of_mem_ker
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
    (f : P →ₗ[R] M) (g : M →ₗ[R] P)
    {p : P} (hp : p ∈ LinearMap.ker f) :
    splitKernelProjection f g p = p := by
  rw [LinearMap.mem_ker] at hp
  simp only [splitKernelProjection, LinearMap.sub_apply,
    LinearMap.id_apply, LinearMap.comp_apply, hp, LinearMap.map_zero, sub_zero]

theorem splitKernelProjection_mem_set_smul_ker_of_mem_set_smul_top
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
    (f : P →ₗ[R] M) (g : M →ₗ[R] P)
    (hg : f.comp g = LinearMap.id) (s : Set R)
    {p : P} (hp : p ∈ s • (⊤ : Submodule R P)) :
    splitKernelProjection f g p ∈ s • LinearMap.ker f := by
  induction p, hp using Submodule.set_smul_inductionOn with
  | @smul₀ a x ha hx =>
      rw [LinearMap.map_smul]
      exact Submodule.mem_set_smul_of_mem_mem ha
        (splitKernelProjection_mem_ker f g hg x)
  | @smul₁ a x hx ih =>
      rw [LinearMap.map_smul]
      exact Submodule.smul_mem _ a ih
  | add hx hy ihx ihy =>
      rw [LinearMap.map_add]
      exact Submodule.add_mem _ ihx ihy
  | zero =>
      rw [LinearMap.map_zero]
      exact Submodule.zero_mem _

theorem ker_le_set_smul_ker_of_split_of_ker_le_set_smul_top
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
    (f : P →ₗ[R] M) (g : M →ₗ[R] P)
    (hg : f.comp g = LinearMap.id) (s : Set R)
    (hker : LinearMap.ker f ≤ s • (⊤ : Submodule R P)) :
    LinearMap.ker f ≤ s • LinearMap.ker f := by
  intro p hp
  have hproj :=
    splitKernelProjection_mem_set_smul_ker_of_mem_set_smul_top
      f g hg s (hker hp)
  rw [splitKernelProjection_eq_self_of_mem_ker f g hp] at hproj
  exact hproj

noncomputable def polynomialVariableSubmoduleK
    (K : Type u) [Field K] (d : ℕ)
    {P : Type*} [AddCommGroup P]
    [Module (MvPolynomial (Fin d) K) P] [Module K P]
    [IsScalarTower K (MvPolynomial (Fin d) K) P]
    (Q : Submodule (MvPolynomial (Fin d) K) P) : Submodule K P :=
  Submodule.span K (Set.range fun iq : Fin d × Q ↦
    (MvPolynomial.X iq.1 : MvPolynomial (Fin d) K) • iq.2.1)

theorem polynomialVariableSubmoduleK_parameter_smul_mem
    (K : Type u) [Field K] (d : ℕ)
    {P : Type*} [AddCommGroup P]
    [Module (MvPolynomial (Fin d) K) P] [Module K P]
    [IsScalarTower K (MvPolynomial (Fin d) K) P]
    (Q : Submodule (MvPolynomial (Fin d) K) P)
    (p : MvPolynomial (Fin d) K) {x : P}
    (hx : x ∈ polynomialVariableSubmoduleK K d Q) :
    p • x ∈ polynomialVariableSubmoduleK K d Q := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨i, ⟨y, hy⟩⟩, rfl⟩ := hx
      apply Submodule.subset_span
      refine ⟨⟨i, ⟨p • y, Q.smul_mem p hy⟩⟩, ?_⟩
      simp only [smul_smul]
      rw [mul_comm]
  | zero =>
      simpa only [smul_zero] using
        (polynomialVariableSubmoduleK K d Q).zero_mem
  | add x y hx hy ihx ihy =>
      rw [smul_add]
      exact Submodule.add_mem _ ihx ihy
  | smul c x hx ih =>
      rw [smul_comm p c x]
      exact Submodule.smul_mem _ c ih

theorem restrictScalars_set_smul_eq_polynomialVariableSubmoduleK
    (K : Type u) [Field K] (d : ℕ)
    {P : Type*} [AddCommGroup P]
    [Module (MvPolynomial (Fin d) K) P] [Module K P]
    [IsScalarTower K (MvPolynomial (Fin d) K) P]
    (Q : Submodule (MvPolynomial (Fin d) K) P) :
    ((MvPolynomial.idealOfVars (Fin d) K :
        Set (MvPolynomial (Fin d) K)) • Q).restrictScalars K =
      polynomialVariableSubmoduleK K d Q := by
  let V := polynomialVariableSubmoduleK K d Q
  let VT : Submodule (MvPolynomial (Fin d) K) P :=
    { carrier := V
      zero_mem' := V.zero_mem
      add_mem' := fun hx hy => V.add_mem hx hy
      smul_mem' := fun p _ hx =>
        polynomialVariableSubmoduleK_parameter_smul_mem K d Q p hx }
  have hleft : (MvPolynomial.idealOfVars (Fin d) K :
      Set (MvPolynomial (Fin d) K)) • Q ≤ VT := by
    apply Submodule.set_smul_le
    intro p x hp hx
    change p ∈ Submodule.span (MvPolynomial (Fin d) K)
      (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) K)) at hp
    induction hp using Submodule.span_induction with
    | mem p hp =>
        obtain ⟨i, rfl⟩ := hp
        apply Submodule.subset_span
        exact ⟨⟨i, ⟨x, hx⟩⟩, rfl⟩
    | zero =>
        rw [zero_smul]
        change (0 : P) ∈ V
        exact V.zero_mem
    | add p q hp hq ihp ihq =>
        rw [add_smul]
        exact V.add_mem ihp ihq
    | smul q p hp ih =>
        simpa only [smul_eq_mul, smul_smul] using VT.smul_mem q ih
  apply le_antisymm
  · intro x hx
    exact hleft hx
  · apply Submodule.span_le.mpr
    rintro x ⟨⟨i, ⟨y, hy⟩⟩, rfl⟩
    exact Submodule.mem_set_smul_of_mem_mem
      (Submodule.subset_span (Set.mem_range_self i)) hy

