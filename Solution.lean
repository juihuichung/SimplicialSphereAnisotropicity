open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

def backwardDiff (a : ℕ → ℤ) : ℕ → ℤ
  | 0 => a 0
  | q + 1 => a (q + 1) - a q

@[simp]
theorem backwardDiff_zero (a : ℕ → ℤ) :
    backwardDiff a 0 = a 0 := rfl

@[simp]
theorem backwardDiff_succ (a : ℕ → ℤ) (q : ℕ) :
    backwardDiff a (q + 1) = a (q + 1) - a q := rfl

def iteratedBackwardDiff : ℕ → (ℕ → ℤ) → (ℕ → ℤ)
  | 0, a => a
  | t + 1, a => iteratedBackwardDiff t (backwardDiff a)

@[simp]
theorem iteratedBackwardDiff_zero (a : ℕ → ℤ) :
    iteratedBackwardDiff 0 a = a := rfl

@[simp]
theorem iteratedBackwardDiff_succ (t : ℕ) (a : ℕ → ℤ) :
    iteratedBackwardDiff (t + 1) a =
      iteratedBackwardDiff t (backwardDiff a) := rfl

def shiftedMultichoose (k r : ℕ) : ℕ → ℤ := fun q ↦
  if r ≤ q then (k.multichoose (q - r) : ℤ) else 0

def pointMass (r : ℕ) : ℕ → ℤ := fun q ↦
  if q = r then 1 else 0

theorem backwardDiff_shiftedMultichoose_succ (k r : ℕ) :
    backwardDiff (shiftedMultichoose (k + 1) r) =
      shiftedMultichoose k r := by
  funext q
  cases q with
  | zero =>
      simp [backwardDiff, shiftedMultichoose]
  | succ q =>
      rw [backwardDiff_succ]
      by_cases hrq : r ≤ q
      · have hrs : r ≤ q + 1 := hrq.trans (Nat.le_succ q)
        have hsub : q + 1 - r = (q - r) + 1 := by omega
        rw [shiftedMultichoose, if_pos hrs,
          shiftedMultichoose, if_pos hrq,
          shiftedMultichoose, if_pos hrs, hsub,
          Nat.multichoose_succ_succ]
        push_cast
        ring
      · by_cases hrs : r ≤ q + 1
        · have hre : r = q + 1 := by omega
          simp [shiftedMultichoose, hre]
        · simp [shiftedMultichoose, hrq, hrs]

theorem shiftedMultichoose_zero_eq_pointMass (r : ℕ) :
    shiftedMultichoose 0 r = pointMass r := by
  funext q
  by_cases hrq : r ≤ q
  · by_cases heq : q = r
    · simp [shiftedMultichoose, pointMass, heq]
    · have hpos : 0 < q - r := by omega
      obtain ⟨t, ht⟩ := Nat.exists_eq_succ_of_ne_zero hpos.ne'
      simp [shiftedMultichoose, pointMass, heq, ht]
  · have heq : q ≠ r := by omega
    simp [shiftedMultichoose, pointMass, hrq, heq]

theorem iteratedBackwardDiff_shiftedMultichoose_self
    (k r : ℕ) :
    iteratedBackwardDiff k (shiftedMultichoose k r) =
      pointMass r := by
  induction k with
  | zero => exact shiftedMultichoose_zero_eq_pointMass r
  | succ k ih =>
      rw [iteratedBackwardDiff_succ,
        backwardDiff_shiftedMultichoose_succ]
      exact ih

theorem backwardDiff_finset_sum {ι : Type*}
    (s : Finset ι) (a : ι → ℕ → ℤ) :
    backwardDiff (fun q ↦ ∑ i ∈ s, a i q) =
      fun q ↦ ∑ i ∈ s, backwardDiff (a i) q := by
  funext q
  cases q with
  | zero => simp
  | succ q => simp [Finset.sum_sub_distrib]

theorem backwardDiff_fintype_sum {ι : Type*} [Fintype ι]
    (a : ι → ℕ → ℤ) :
    backwardDiff (fun q ↦ ∑ i, a i q) =
      fun q ↦ ∑ i, backwardDiff (a i) q := by
  exact backwardDiff_finset_sum (Finset.univ : Finset ι) a

theorem iteratedBackwardDiff_fintype_sum {ι : Type*} [Fintype ι]
    (t : ℕ) (a : ι → ℕ → ℤ) :
    iteratedBackwardDiff t (fun q ↦ ∑ i, a i q) =
      fun q ↦ ∑ i, iteratedBackwardDiff t (a i) q := by
  induction t generalizing a with
  | zero => rfl
  | succ t ih =>
      rw [iteratedBackwardDiff_succ,
        backwardDiff_fintype_sum, ih]
      simp only [iteratedBackwardDiff_succ]

theorem iteratedBackwardDiff_add (s t : ℕ) (a : ℕ → ℤ) :
    iteratedBackwardDiff (s + t) a =
      iteratedBackwardDiff s (iteratedBackwardDiff t a) := by
  induction t generalizing a with
  | zero => simp
  | succ t ih =>
      rw [Nat.add_succ, iteratedBackwardDiff_succ,
        iteratedBackwardDiff_succ, ih]

theorem iteratedBackwardDiff_shiftedMultichoose_of_le
    {k d r : ℕ} (hkd : k ≤ d) :
    iteratedBackwardDiff d (shiftedMultichoose k r) =
      iteratedBackwardDiff (d - k) (pointMass r) := by
  conv_lhs => rw [← Nat.sub_add_cancel hkd]
  rw [iteratedBackwardDiff_add,
    iteratedBackwardDiff_shiftedMultichoose_self]

theorem backwardDiff_eq_zero_above
    {a : ℕ → ℤ} {L : ℕ}
    (ha : ∀ q, L < q → a q = 0) :
    ∀ q, L + 1 < q → backwardDiff a q = 0 := by
  intro q hq
  cases q with
  | zero => omega
  | succ q =>
      rw [backwardDiff_succ, ha (q + 1) (by omega), ha q (by omega), sub_zero]

theorem iteratedBackwardDiff_eq_zero_above
    {a : ℕ → ℤ} {L : ℕ}
    (ha : ∀ q, L < q → a q = 0) (t : ℕ) :
    ∀ q, L + t < q → iteratedBackwardDiff t a q = 0 := by
  induction t generalizing a L with
  | zero =>
      intro q hq
      exact ha q (by simpa using hq)
  | succ t ih =>
      rw [iteratedBackwardDiff_succ]
      intro q hq
      exact ih (a := backwardDiff a) (L := L + 1)
        (backwardDiff_eq_zero_above ha) q (by omega)

theorem pointMass_eq_zero_above (r : ℕ) :
    ∀ q, r < q → pointMass r q = 0 := by
  intro q hq
  simp [pointMass, ne_of_gt hq]

theorem iteratedBackwardDiff_pointMass_eq_zero_above
    (r t : ℕ) :
    ∀ q, r + t < q →
      iteratedBackwardDiff t (pointMass r) q = 0 :=
  iteratedBackwardDiff_eq_zero_above (pointMass_eq_zero_above r) t

def basisHilbertSequence {N : ℕ}
    (d : ℕ) (r : Fin N → ℕ) : ℕ → ℤ := fun q ↦
  ∑ i, shiftedMultichoose d (r i) q

def faceHilbertSequence {m : ℕ}
    (C : AugmentedComplex (Fin m)) : ℕ → ℤ := fun q ↦
  ∑ F : ComplexFace C,
    shiftedMultichoose F.1.card F.1.card q

def basisNumeratorSequence {N : ℕ}
    (r : Fin N → ℕ) : ℕ → ℤ := fun q ↦
  ∑ i, pointMass (r i) q

def faceNumeratorSequence {m : ℕ}
    (d : ℕ) (C : AugmentedComplex (Fin m)) : ℕ → ℤ := fun q ↦
  ∑ F : ComplexFace C,
    iteratedBackwardDiff (d - F.1.card)
      (pointMass F.1.card) q

theorem hilbertSequence_eq_of_multichoose_identity
    {m d N : ℕ} (C : AugmentedComplex (Fin m))
    (r : Fin N → ℕ)
    (h : ∀ q,
      (∑ i, if r i ≤ q then d.multichoose (q - r i) else 0) =
        ∑ F : ComplexFace C,
          if F.1.card ≤ q then
            F.1.card.multichoose (q - F.1.card) else 0) :
    basisHilbertSequence d r = faceHilbertSequence C := by
  funext q
  simp only [basisHilbertSequence, faceHilbertSequence,
    shiftedMultichoose]
  exact_mod_cast h q

theorem iteratedBackwardDiff_basisHilbertSequence
    {d N : ℕ} (r : Fin N → ℕ) :
    iteratedBackwardDiff d (basisHilbertSequence d r) =
      basisNumeratorSequence r := by
  change iteratedBackwardDiff d
      (fun q ↦ ∑ i, shiftedMultichoose d (r i) q) =
    fun q ↦ ∑ i, pointMass (r i) q
  rw [iteratedBackwardDiff_fintype_sum]
  funext q
  apply Finset.sum_congr rfl
  intro i _hi
  exact congrFun
    (iteratedBackwardDiff_shiftedMultichoose_self d (r i)) q

theorem iteratedBackwardDiff_faceHilbertSequence
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) :
    iteratedBackwardDiff d (faceHilbertSequence C) =
      faceNumeratorSequence d C := by
  change iteratedBackwardDiff d
      (fun q ↦ ∑ F : ComplexFace C,
        shiftedMultichoose F.1.card F.1.card q) =
    fun q ↦ ∑ F : ComplexFace C,
      iteratedBackwardDiff (d - F.1.card)
        (pointMass F.1.card) q
  rw [iteratedBackwardDiff_fintype_sum]
  funext q
  apply Finset.sum_congr rfl
  intro F _hF
  exact congrFun
    (iteratedBackwardDiff_shiftedMultichoose_of_le
      (hbound F.1 F.2)) q

theorem numeratorSequence_eq_of_multichoose_identity
    {m d N : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) (r : Fin N → ℕ)
    (h : ∀ q,
      (∑ i, if r i ≤ q then d.multichoose (q - r i) else 0) =
        ∑ F : ComplexFace C,
          if F.1.card ≤ q then
            F.1.card.multichoose (q - F.1.card) else 0) :
    basisNumeratorSequence r = faceNumeratorSequence d C := by
  rw [← iteratedBackwardDiff_basisHilbertSequence,
    ← iteratedBackwardDiff_faceHilbertSequence C hbound,
    hilbertSequence_eq_of_multichoose_identity C r h]

def sequenceMass (L : ℕ) (a : ℕ → ℤ) : ℤ :=
  ∑ q ∈ Finset.range (L + 1), a q

def sequenceMoment (L : ℕ) (a : ℕ → ℤ) : ℤ :=
  ∑ q ∈ Finset.range (L + 1), (q : ℤ) * a q

theorem sequenceMass_backwardDiff (a : ℕ → ℤ) (L : ℕ) :
    sequenceMass L (backwardDiff a) = a L := by
  induction L with
  | zero => simp [sequenceMass]
  | succ L ih =>
      calc
        sequenceMass (L + 1) (backwardDiff a) =
            sequenceMass L (backwardDiff a) +
              backwardDiff a (L + 1) := by
                simp [sequenceMass, Finset.sum_range_succ]
        _ = a L + (a (L + 1) - a L) := by
              rw [ih, backwardDiff_succ]
        _ = a (L + 1) := by ring

theorem sequenceMoment_backwardDiff (a : ℕ → ℤ) (L : ℕ) :
    sequenceMoment L (backwardDiff a) =
      (L : ℤ) * a L - ∑ q ∈ Finset.range L, a q := by
  induction L with
  | zero => simp [sequenceMoment]
  | succ L ih =>
      calc
        sequenceMoment (L + 1) (backwardDiff a) =
            sequenceMoment L (backwardDiff a) +
              ((L + 1 : ℕ) : ℤ) * backwardDiff a (L + 1) := by
                simp [sequenceMoment, Finset.sum_range_succ]
        _ = (L : ℤ) * a L - ∑ q ∈ Finset.range L, a q +
              ((L + 1 : ℕ) : ℤ) * (a (L + 1) - a L) := by
                rw [ih, backwardDiff_succ]
        _ = ((L + 1 : ℕ) : ℤ) * a (L + 1) -
              ∑ q ∈ Finset.range (L + 1), a q := by
                rw [Finset.sum_range_succ]
                push_cast
                ring

theorem iteratedBackwardDiff_succ_apply (t : ℕ) (a : ℕ → ℤ) :
    iteratedBackwardDiff (t + 1) a =
      backwardDiff (iteratedBackwardDiff t a) := by
  calc
    iteratedBackwardDiff (t + 1) a =
        iteratedBackwardDiff (1 + t) a := by rw [Nat.add_comm]
    _ = iteratedBackwardDiff 1 (iteratedBackwardDiff t a) :=
      iteratedBackwardDiff_add 1 t a
    _ = backwardDiff (iteratedBackwardDiff t a) := rfl

theorem sequenceMass_pointMass_of_le {r L : ℕ} (hrL : r ≤ L) :
    sequenceMass L (pointMass r) = 1 := by
  classical
  simp [sequenceMass, pointMass, hrL]

theorem sequenceMoment_pointMass_of_le {r L : ℕ} (hrL : r ≤ L) :
    sequenceMoment L (pointMass r) = r := by
  classical
  simp [sequenceMoment, pointMass, hrL]

theorem sequenceMass_iterated_pointMass_succ (r t : ℕ) :
    sequenceMass (r + (t + 1))
        (iteratedBackwardDiff (t + 1) (pointMass r)) = 0 := by
  rw [iteratedBackwardDiff_succ_apply,
    sequenceMass_backwardDiff]
  exact iteratedBackwardDiff_pointMass_eq_zero_above r t
    (r + (t + 1)) (by omega)

theorem sequenceMoment_iterated_pointMass_one (r : ℕ) :
    sequenceMoment (r + 1)
        (iteratedBackwardDiff 1 (pointMass r)) = -1 := by
  rw [iteratedBackwardDiff_succ_apply 0,
    sequenceMoment_backwardDiff]
  simp only [iteratedBackwardDiff_zero]
  rw [pointMass_eq_zero_above r (r + 1) (by omega)]
  have hmass := sequenceMass_pointMass_of_le (r := r) (L := r) (by omega)
  change (∑ q ∈ Finset.range (r + 1), pointMass r q) = 1 at hmass
  rw [hmass]
  ring

theorem sequenceMoment_iterated_pointMass_add_two (r t : ℕ) :
    sequenceMoment (r + (t + 2))
        (iteratedBackwardDiff (t + 2) (pointMass r)) = 0 := by
  rw [show t + 2 = (t + 1) + 1 by omega,
    iteratedBackwardDiff_succ_apply,
    sequenceMoment_backwardDiff]
  rw [iteratedBackwardDiff_pointMass_eq_zero_above r (t + 1)
    (r + (t + 2)) (by omega)]
  have hmass := sequenceMass_iterated_pointMass_succ r t
  change (∑ q ∈ Finset.range (r + (t + 1) + 1),
    iteratedBackwardDiff (t + 1) (pointMass r) q) = 0 at hmass
  rw [show r + (t + 2) = r + (t + 1) + 1 by omega]
  rw [hmass]
  ring

theorem sequenceMass_faceTerm {k d : ℕ} (hkd : k ≤ d) :
    sequenceMass d
        (iteratedBackwardDiff (d - k) (pointMass k)) =
      if k = d then 1 else 0 := by
  by_cases htop : k = d
  · subst d
    simp [sequenceMass_pointMass_of_le]
  · have hsub : d - k ≠ 0 := by omega
    obtain ⟨t, ht⟩ := Nat.exists_eq_succ_of_ne_zero hsub
    rw [if_neg htop, ht]
    have hd : d = k + (t + 1) := by omega
    rw [hd]
    exact sequenceMass_iterated_pointMass_succ k t

theorem sequenceMoment_faceTerm {k d : ℕ} (hkd : k ≤ d) :
    sequenceMoment d
        (iteratedBackwardDiff (d - k) (pointMass k)) =
      if k = d then (d : ℤ) else if k + 1 = d then -1 else 0 := by
  by_cases htop : k = d
  · subst d
    simp [sequenceMoment_pointMass_of_le]
  · rw [if_neg htop]
    by_cases hridge : k + 1 = d
    · rw [if_pos hridge]
      have hsub : d - k = 1 := by omega
      rw [hsub]
      rw [← hridge]
      exact sequenceMoment_iterated_pointMass_one k
    · rw [if_neg hridge]
      obtain ⟨t, ht⟩ : ∃ t, d - k = t + 2 := by
        use d - k - 2
        omega
      rw [ht]
      have hd : d = k + (t + 2) := by omega
      rw [hd]
      exact sequenceMoment_iterated_pointMass_add_two k t

theorem faceNumeratorSequence_eq_zero_above
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) {q : ℕ} (hdq : d < q) :
    faceNumeratorSequence d C q = 0 := by
  apply Finset.sum_eq_zero
  intro F _hF
  apply iteratedBackwardDiff_pointMass_eq_zero_above
  have hcard := hbound F.1 F.2
  omega

theorem basisDegrees_le_of_numeratorSequence_eq
    {m d N : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) (r : Fin N → ℕ)
    (hnum : basisNumeratorSequence r = faceNumeratorSequence d C) :
    ∀ i, r i ≤ d := by
  intro i
  by_contra hle
  have hdri : d < r i := by omega
  have hzero : basisNumeratorSequence r (r i) = 0 := by
    rw [congrFun hnum (r i)]
    exact faceNumeratorSequence_eq_zero_above C hbound hdri
  have hone : (1 : ℤ) ≤ basisNumeratorSequence r (r i) := by
    change 1 ≤ ∑ j : Fin N, pointMass (r j) (r i)
    calc
      (1 : ℤ) = pointMass (r i) (r i) := by simp [pointMass]
      _ ≤ ∑ j : Fin N, pointMass (r j) (r i) := by
        exact Finset.single_le_sum
          (f := fun j : Fin N ↦ pointMass (r j) (r i))
          (s := Finset.univ)
          (fun j _hj ↦ by
            simp only [pointMass]
            split <;> norm_num) (Finset.mem_univ i)
  omega

def faceCardCount {m : ℕ} (C : AugmentedComplex (Fin m))
    (k : ℕ) : ℕ :=
  ((Finset.univ : Finset (ComplexFace C)).filter
    (fun F ↦ F.1.card = k)).card

def ridgeCardCount {m : ℕ} (C : AugmentedComplex (Fin m))
    (d : ℕ) : ℕ :=
  ((Finset.univ : Finset (ComplexFace C)).filter
    (fun F ↦ F.1.card + 1 = d)).card

theorem sequenceMass_fintype_sum {ι : Type*} [Fintype ι]
    (L : ℕ) (a : ι → ℕ → ℤ) :
    sequenceMass L (fun q ↦ ∑ i, a i q) =
      ∑ i, sequenceMass L (a i) := by
  simp only [sequenceMass]
  rw [Finset.sum_comm]

theorem sequenceMoment_fintype_sum {ι : Type*} [Fintype ι]
    (L : ℕ) (a : ι → ℕ → ℤ) :
    sequenceMoment L (fun q ↦ ∑ i, a i q) =
      ∑ i, sequenceMoment L (a i) := by
  simp only [sequenceMoment, Finset.mul_sum]
  rw [Finset.sum_comm]

theorem sequenceMass_basisNumeratorSequence
    {N d : ℕ} (r : Fin N → ℕ) (hr : ∀ i, r i ≤ d) :
    sequenceMass d (basisNumeratorSequence r) = N := by
  change sequenceMass d (fun q ↦ ∑ i, pointMass (r i) q) = (N : ℤ)
  rw [sequenceMass_fintype_sum]
  simp_rw [sequenceMass_pointMass_of_le (hr _)]
  simp

theorem sequenceMoment_basisNumeratorSequence
    {N d : ℕ} (r : Fin N → ℕ) (hr : ∀ i, r i ≤ d) :
    sequenceMoment d (basisNumeratorSequence r) =
      ∑ i, (r i : ℤ) := by
  change sequenceMoment d (fun q ↦ ∑ i, pointMass (r i) q) = _
  rw [sequenceMoment_fintype_sum]
  apply Finset.sum_congr rfl
  intro i _hi
  exact sequenceMoment_pointMass_of_le (hr i)

theorem sequenceMass_faceNumeratorSequence
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) :
    sequenceMass d (faceNumeratorSequence d C) =
      faceCardCount C d := by
  change sequenceMass d
      (fun q ↦ ∑ F : ComplexFace C,
        iteratedBackwardDiff (d - F.1.card)
          (pointMass F.1.card) q) = _
  rw [sequenceMass_fintype_sum]
  calc
    (∑ F : ComplexFace C,
        sequenceMass d
          (iteratedBackwardDiff (d - F.1.card)
            (pointMass F.1.card))) =
        ∑ F : ComplexFace C,
          if F.1.card = d then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro F _hF
            exact sequenceMass_faceTerm (hbound F.1 F.2)
    _ = faceCardCount C d := by simp [faceCardCount]

theorem sequenceMoment_faceNumeratorSequence
    {m d : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) :
    sequenceMoment d (faceNumeratorSequence d C) =
      (d : ℤ) * faceCardCount C d - ridgeCardCount C d := by
  change sequenceMoment d
      (fun q ↦ ∑ F : ComplexFace C,
        iteratedBackwardDiff (d - F.1.card)
          (pointMass F.1.card) q) = _
  rw [sequenceMoment_fintype_sum]
  have heval :
      (∑ F : ComplexFace C,
        sequenceMoment d
          (iteratedBackwardDiff (d - F.1.card)
            (pointMass F.1.card))) =
      ∑ F : ComplexFace C,
        if F.1.card = d then (d : ℤ)
        else if F.1.card + 1 = d then -1 else 0 := by
    apply Finset.sum_congr rfl
    intro F _hF
    exact sequenceMoment_faceTerm (hbound F.1 F.2)
  rw [heval]
  have hsplit : ∀ F : ComplexFace C,
      (if F.1.card = d then (d : ℤ)
        else if F.1.card + 1 = d then -1 else 0) =
      (if F.1.card = d then (d : ℤ) else 0) -
        (if F.1.card + 1 = d then 1 else 0) := by
    intro F
    split_ifs <;> omega
  simp_rw [hsplit, Finset.sum_sub_distrib]
  simp [faceCardCount, ridgeCardCount, Finset.sum_ite]
  ring

theorem degreeStatistics_of_multichoose_identity
    {m d N : ℕ} (C : AugmentedComplex (Fin m))
    (hbound : FacesBoundedBy C d) (r : Fin N → ℕ)
    (h : ∀ q,
      (∑ i, if r i ≤ q then d.multichoose (q - r i) else 0) =
        ∑ F : ComplexFace C,
          if F.1.card ≤ q then
            F.1.card.multichoose (q - F.1.card) else 0) :
    (∀ i, r i ≤ d) ∧
      N = faceCardCount C d ∧
      (∑ i, (r i : ℤ)) =
        (d : ℤ) * faceCardCount C d - ridgeCardCount C d := by
  have hnum := numeratorSequence_eq_of_multichoose_identity C hbound r h
  have hr := basisDegrees_le_of_numeratorSequence_eq C hbound r hnum
  refine ⟨hr, ?_, ?_⟩
  · have hmass := congrArg (sequenceMass d) hnum
    rw [sequenceMass_basisNumeratorSequence r hr,
      sequenceMass_faceNumeratorSequence C hbound] at hmass
    exact_mod_cast hmass
  · have hmoment := congrArg (sequenceMoment d) hnum
    rw [sequenceMoment_basisNumeratorSequence r hr,
      sequenceMoment_faceNumeratorSequence C hbound] at hmoment
    exact hmoment

