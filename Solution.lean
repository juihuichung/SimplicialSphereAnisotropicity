section

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

def erasePositiveFaceAtIndex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (i : Fin (q + 1)) :
    AugmentedSimplex (AugmentedComplex.ofPre C) q :=
  eraseSimplex (AugmentedComplex.ofPre C) F
    ⟨faceOrderEmb C F i, faceOrderEmb_mem C F i⟩

@[simp]
theorem erasePositiveFaceAtIndex_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (i : Fin (q + 1)) :
    (erasePositiveFaceAtIndex C F i).1 =
      F.1.erase (faceOrderEmb C F i) := rfl

theorem boundaryOnSimplex_eq_sum_erasePositiveFaceAtIndex
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    boundaryOnSimplex K (AugmentedComplex.ofPre C) q F =
      ∑ i : Fin (q + 1),
        Finsupp.single (erasePositiveFaceAtIndex C F i) 1 := by
  rw [boundaryOnSimplex]
  symm
  exact Fintype.sum_equiv (F.1.orderIsoOfFin F.2.2)
    (fun i ↦ Finsupp.single
      (erasePositiveFaceAtIndex C F i) (1 : K))
    (fun v ↦ Finsupp.single
      (eraseSimplex (AugmentedComplex.ofPre C) F v) (1 : K))
    (fun i ↦ by rfl)

theorem augmentedFaceSimplex_self_le_ambient {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) a) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ AugmentedComplex.ofPre (faceSimplex F.1) →
        G ∈ AugmentedComplex.ofPre C := by
  intro G hG
  apply (AugmentedComplex.ofPre C).down_closed F.2.1
  rcases hG with rfl | hG
  · exact Finset.empty_subset _
  · exact hG.2

theorem augmentedFaceSimplex_erasePositive_le {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (i : Fin (q + 1)) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ AugmentedComplex.ofPre
          (faceSimplex (erasePositiveFaceAtIndex C F i).1) →
        G ∈ AugmentedComplex.ofPre (faceSimplex F.1) :=
  augmentedFaceSimplex_mono (by
    rw [erasePositiveFaceAtIndex_val]
    exact Finset.erase_subset _ _)

def faceSelfSimplex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    AugmentedSimplex
      (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1) :=
  ⟨F.1, Or.inr ⟨Finset.card_pos.mp (by rw [F.2.2]; omega),
      Finset.Subset.rfl⟩, F.2.2⟩

@[simp]
theorem faceSelfSimplex_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    (faceSelfSimplex C F).1 = F.1 := rfl

noncomputable def finiteFaceCarrierHomotopyLocalOn
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    ∀ F : AugmentedSimplex (AugmentedComplex.ofPre C) a,
      AugmentedChain K
        (AugmentedComplex.ofPre (faceSimplex F.1)) (a + 1) :=
  Nat.rec (motive := fun a ↦
      ∀ F : AugmentedSimplex (AugmentedComplex.ofPre C) a,
        AugmentedChain K
          (AugmentedComplex.ofPre (faceSimplex F.1)) (a + 1))
    (fun _ ↦ 0)
    (fun q ih F ↦
      faceCone K (AugmentedComplex.ofPre (faceSimplex F.1))
        (faceApex F.1 F.2.2)
        (faceSimplexAugmented_insert_apex F.1 F.2.2) (q + 1)
        (reverseSubdivisionAffineLocalOn K C F +
          Finsupp.single (faceSelfSimplex C F) 1 +
          ∑ i : Fin (q + 1),
            faceChainInclusionDegree K
              (augmentedFaceSimplex_erasePositive_le C F i) (q + 1)
              (ih (erasePositiveFaceAtIndex C F i))))
    a

@[simp]
theorem finiteFaceCarrierHomotopyLocalOn_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) 0) :
    finiteFaceCarrierHomotopyLocalOn K C 0 F = 0 := rfl

noncomputable def finiteFaceCarrierCorrection
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    AugmentedChain K
      (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1) :=
  reverseSubdivisionAffineLocalOn K C F +
    Finsupp.single (faceSelfSimplex C F) 1 +
    ∑ i : Fin (q + 1),
      faceChainInclusionDegree K
        (augmentedFaceSimplex_erasePositive_le C F i) (q + 1)
        (finiteFaceCarrierHomotopyLocalOn K C q
          (erasePositiveFaceAtIndex C F i))

theorem finiteFaceCarrierHomotopyLocalOn_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    finiteFaceCarrierHomotopyLocalOn K C (q + 1) F =
      faceCone K (AugmentedComplex.ofPre (faceSimplex F.1))
        (faceApex F.1 F.2.2)
        (faceSimplexAugmented_insert_apex F.1 F.2.2) (q + 1)
        (finiteFaceCarrierCorrection K C F) := rfl

noncomputable def finiteFaceCarrierHomotopyOn
    (K : Type u) [Field K] [CharP K 2] {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) a) :
    AugmentedChain K (AugmentedComplex.ofPre C) (a + 1) :=
  faceChainInclusionDegree K
    (augmentedFaceSimplex_self_le_ambient C F) (a + 1)
    (finiteFaceCarrierHomotopyLocalOn K C a F)

noncomputable def finiteFaceCarrierHomotopyDegreeLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) a →ₗ[K]
      AugmentedChain K (AugmentedComplex.ofPre C) (a + 1) :=
  Finsupp.linearCombination K (finiteFaceCarrierHomotopyOn K C)

@[simp]
theorem finiteFaceCarrierHomotopyDegreeLinear_single
    (K : Type u) [Field K] [CharP K 2] {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) a) (c : K) :
    finiteFaceCarrierHomotopyDegreeLinear K C a (Finsupp.single F c) =
      c • finiteFaceCarrierHomotopyOn K C F := by
  exact Finsupp.linearCombination_single K c F

theorem faceSelfSimplex_inclusion
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceChainInclusionDegree K
        (augmentedFaceSimplex_self_le_ambient C F) (q + 1)
        (Finsupp.single (faceSelfSimplex C F) 1) =
      Finsupp.single F 1 := by
  rw [faceChainInclusionDegree_single]
  congr 1

theorem finiteFaceCarrierCorrection_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceChainInclusionDegree K
        (augmentedFaceSimplex_self_le_ambient C F) (q + 1)
        (finiteFaceCarrierCorrection K C F) =
      reverseSubdivisionAffineOn K C F + Finsupp.single F 1 +
        finiteFaceCarrierHomotopyDegreeLinear K C q
          (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) := by
  rw [finiteFaceCarrierCorrection, map_add, map_add]
  have hphi :
      faceChainInclusionDegree K
          (augmentedFaceSimplex_self_le_ambient C F) (q + 1)
          (reverseSubdivisionAffineLocalOn K C F) =
        reverseSubdivisionAffineOn K C F := by
    simpa using reverseSubdivisionAffineLocalOn_inclusion K C F
  rw [hphi, faceSelfSimplex_inclusion]
  congr 1
  rw [boundaryOnSimplex_eq_sum_erasePositiveFaceAtIndex, map_sum,
    map_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [finiteFaceCarrierHomotopyDegreeLinear_single, one_smul]
  let E := erasePositiveFaceAtIndex C F i
  let hEF := augmentedFaceSimplex_erasePositive_le C F i
  let hFA := augmentedFaceSimplex_self_le_ambient C F
  let hEA := augmentedFaceSimplex_self_le_ambient C E
  have hcomp := LinearMap.congr_fun
    (faceChainInclusionDegree_comp K hEF hFA hEA (q + 1))
    (finiteFaceCarrierHomotopyLocalOn K C q E)
  simpa only [E, hEF, hFA, hEA, LinearMap.comp_apply,
    finiteFaceCarrierHomotopyOn] using hcomp

theorem reverseSubdivisionAffineOn_boundary_positive
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceBoundary K (AugmentedComplex.ofPre C) q
        (reverseSubdivisionAffineOn K C F) =
      ((reverseSubdivisionAffine K C).f q).hom
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) := by
  have hcomm := (reverseSubdivisionAffine K C).comm (q + 1) q
  have hlin := congrArg ModuleCat.Hom.hom hcomm
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom] at hlin
  have h := LinearMap.congr_fun hlin (Finsupp.single F (1 : K))
  change faceBoundary K (AugmentedComplex.ofPre C) q
      (((reverseSubdivisionAffine K C).f (q + 1)).hom
        (Finsupp.single F 1)) =
    ((reverseSubdivisionAffine K C).f q).hom
      (faceBoundary K (AugmentedComplex.ofPre C) q
        (Finsupp.single F 1)) at h
  rw [reverseSubdivisionAffine_single, one_smul,
    faceBoundary_single, one_smul] at h
  exact h

theorem reverseSubdivisionAffine_f_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (reverseSubdivisionAffine K C).f 0 =
      𝟙 ((faceChainComplex K (AugmentedComplex.ofPre C)).X 0) := by
  apply ModuleCat.hom_ext
  apply Finsupp.lhom_ext
  intro F a
  simp only [reverseSubdivisionAffine, augmentedAffineSubdivisionSmall,
    HomologicalComplex.comp_f, augmentedAffineSubdivisionLiftedSmall_f_zero]
  change (faceEmptyDegree K C).hom
      ((affineFaceZeroLinear K C) (Finsupp.single F a)) =
    Finsupp.single F a
  rw [affineFaceZeroLinear_single]
  change (LinearMap.toSpanSingleton K _
      (Finsupp.single
        (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1)) a =
    Finsupp.single F a
  rw [LinearMap.toSpanSingleton_apply]
  simp only [Finsupp.smul_single, smul_eq_mul, mul_one]
  congr 1
  apply Subtype.ext
  exact (Finset.card_eq_zero.mp F.2.2).symm

noncomputable def reverseSubdivisionAffineRawLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) a →ₗ[K]
      AugmentedChain K (AugmentedComplex.ofPre C) a :=
  match a with
  | 0 => LinearMap.id
  | q + 1 => (reverseDegree K C q).hom.comp
      ((liftedSmallToSmallDegree K C q).hom.comp
        (affineSubdivisionLiftedSmallDegreeLinear K C q))

@[simp]
theorem reverseSubdivisionAffineRawLinear_single_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) (a : K) :
    reverseSubdivisionAffineRawLinear K C (q + 1)
        (Finsupp.single F a) =
      a • reverseSubdivisionAffineOn K C F := by
  change ((reverseSubdivisionAffine K C).f (q + 1)).hom
      (Finsupp.single F a) = _
  exact reverseSubdivisionAffine_single K C F a

theorem reverseSubdivisionAffine_f_apply_eq_raw
    (K : Type u) [Field K] [CharP K 2] {m a : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (x : AugmentedChain K (AugmentedComplex.ofPre C) a) :
    ((reverseSubdivisionAffine K C).f a).hom x =
      reverseSubdivisionAffineRawLinear K C a x := by
  rcases a with _ | q
  · rw [reverseSubdivisionAffine_f_zero]
    rfl
  · rfl

theorem reverseSubdivisionAffineOn_boundary_positive_raw
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceBoundary K (AugmentedComplex.ofPre C) q
        (reverseSubdivisionAffineOn K C F) =
      reverseSubdivisionAffineRawLinear K C q
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) := by
  rw [reverseSubdivisionAffineOn_boundary_positive]
  exact reverseSubdivisionAffine_f_apply_eq_raw K C _

noncomputable def finiteFaceCarrierHomotopyPrevBoundaryLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) a →ₗ[K]
      AugmentedChain K (AugmentedComplex.ofPre C) a :=
  match a with
  | 0 => 0
  | q + 1 => (finiteFaceCarrierHomotopyDegreeLinear K C q).comp
      (faceBoundary K (AugmentedComplex.ofPre C) q)

theorem finiteFaceCarrierHomotopyDegreeLinear_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    finiteFaceCarrierHomotopyDegreeLinear K C 0 = 0 := by
  apply Finsupp.lhom_ext
  intro F a
  rw [finiteFaceCarrierHomotopyDegreeLinear_single]
  simp only [finiteFaceCarrierHomotopyOn,
    finiteFaceCarrierHomotopyLocalOn_zero, map_zero, smul_zero,
    LinearMap.zero_apply]

theorem finiteFaceCarrierHomotopyPrevBoundary_on_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    finiteFaceCarrierHomotopyPrevBoundaryLinear K C q
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) = 0 := by
  rcases q with _ | q
  · rfl
  · change finiteFaceCarrierHomotopyDegreeLinear K C q
      (faceBoundary K (AugmentedComplex.ofPre C) q
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) (q + 1) F)) = 0
    rw [faceBoundary_boundary_on, map_zero]

def FiniteFaceCarrierHomotopyEquation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) : Prop :=
  (faceBoundary K (AugmentedComplex.ofPre C) a).comp
        (finiteFaceCarrierHomotopyDegreeLinear K C a) +
      finiteFaceCarrierHomotopyPrevBoundaryLinear K C a =
    reverseSubdivisionAffineRawLinear K C a +
      (LinearMap.id :
        AugmentedChain K (AugmentedComplex.ofPre C) a →ₗ[K]
          AugmentedChain K (AugmentedComplex.ofPre C) a)

theorem finiteFaceCarrierHomotopyEquation_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    FiniteFaceCarrierHomotopyEquation K C 0 := by
  rw [FiniteFaceCarrierHomotopyEquation,
    finiteFaceCarrierHomotopyDegreeLinear_zero]
  change 0 + 0 =
    (LinearMap.id : AugmentedChain K (AugmentedComplex.ofPre C) 0 →ₗ[K]
      AugmentedChain K (AugmentedComplex.ofPre C) 0) + LinearMap.id
  rw [zero_add]
  exact (charTwo_module_add_self_eq_zero K
    (LinearMap.id : AugmentedChain K (AugmentedComplex.ofPre C) 0 →ₗ[K]
      AugmentedChain K (AugmentedComplex.ofPre C) 0)).symm

theorem finiteFaceCarrierCorrection_cycle_of_equation
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (heq : FiniteFaceCarrierHomotopyEquation K C q)
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) q
        (finiteFaceCarrierCorrection K C F) = 0 := by
  let A := AugmentedComplex.ofPre C
  let x : AugmentedChain K A q := boundaryOnSimplex K A q F
  have hlower :
      finiteFaceCarrierHomotopyPrevBoundaryLinear K C q x = 0 := by
    exact finiteFaceCarrierHomotopyPrevBoundary_on_boundary K C F
  have hx := LinearMap.congr_fun heq x
  change faceBoundary K A q
        (finiteFaceCarrierHomotopyDegreeLinear K C q x) +
      finiteFaceCarrierHomotopyPrevBoundaryLinear K C q x =
    reverseSubdivisionAffineRawLinear K C q x + x at hx
  rw [hlower, add_zero] at hx
  let hFA := augmentedFaceSimplex_self_le_ambient C F
  apply faceChainInclusionDegree_injective K hFA q
  rw [map_zero]
  have hboundary := LinearMap.congr_fun
    (faceChainInclusion_boundary K hFA q)
    (finiteFaceCarrierCorrection K C F)
  change faceBoundary K A q
      (faceChainInclusionDegree K hFA (q + 1)
        (finiteFaceCarrierCorrection K C F)) =
    faceChainInclusionDegree K hFA q
      (faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) q
        (finiteFaceCarrierCorrection K C F)) at hboundary
  rw [← hboundary, finiteFaceCarrierCorrection_inclusion,
    map_add, map_add, faceBoundary_single, one_smul,
    reverseSubdivisionAffineOn_boundary_positive_raw]
  change reverseSubdivisionAffineRawLinear K C q x + x +
      faceBoundary K A q
        (finiteFaceCarrierHomotopyDegreeLinear K C q x) = 0
  rw [hx]
  have hphi := charTwo_module_add_self_eq_zero K
    (reverseSubdivisionAffineRawLinear K C q x)
  have hxx := charTwo_module_add_self_eq_zero K x
  calc
    reverseSubdivisionAffineRawLinear K C q x + x +
        (reverseSubdivisionAffineRawLinear K C q x + x) =
      (reverseSubdivisionAffineRawLinear K C q x +
          reverseSubdivisionAffineRawLinear K C q x) + (x + x) := by
        abel
    _ = 0 := by rw [hphi, hxx, zero_add]

theorem finiteFaceCarrierHomotopyLocalOn_boundary_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (hcycle : faceBoundary K
      (AugmentedComplex.ofPre (faceSimplex F.1)) q
      (finiteFaceCarrierCorrection K C F) = 0) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1)
        (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F) =
      finiteFaceCarrierCorrection K C F := by
  rw [finiteFaceCarrierHomotopyLocalOn_succ]
  exact faceSimplex_cone_fills_cycle K F.1 F.2.2
    (finiteFaceCarrierCorrection K C F) hcycle

theorem finiteFaceCarrierHomotopyOn_boundary_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (hcycle : faceBoundary K
      (AugmentedComplex.ofPre (faceSimplex F.1)) q
      (finiteFaceCarrierCorrection K C F) = 0) :
    faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (finiteFaceCarrierHomotopyOn K C F) =
      reverseSubdivisionAffineOn K C F + Finsupp.single F 1 +
        finiteFaceCarrierHomotopyDegreeLinear K C q
          (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) := by
  let hFA := augmentedFaceSimplex_self_le_ambient C F
  have hboundary := LinearMap.congr_fun
    (faceChainInclusion_boundary K hFA (q + 1))
    (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F)
  change faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
      (faceChainInclusionDegree K hFA (q + 2)
        (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F)) =
    faceChainInclusionDegree K hFA (q + 1)
      (faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1)
        (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F)) at hboundary
  rw [finiteFaceCarrierHomotopyOn]
  calc
    faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (faceChainInclusionDegree K hFA (q + 2)
          (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F)) =
      faceChainInclusionDegree K hFA (q + 1)
        (faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1)
          (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F)) := hboundary
    _ = faceChainInclusionDegree K hFA (q + 1)
        (finiteFaceCarrierCorrection K C F) := by
      rw [finiteFaceCarrierHomotopyLocalOn_boundary_of_cycle K C F hcycle]
    _ = reverseSubdivisionAffineOn K C F + Finsupp.single F 1 +
        finiteFaceCarrierHomotopyDegreeLinear K C q
          (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) :=
      finiteFaceCarrierCorrection_inclusion K C F

theorem finiteFaceCarrierHomotopyEquation_succ_of_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (hcycle : ∀ F : AugmentedSimplex
        (AugmentedComplex.ofPre C) (q + 1),
      faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) q
        (finiteFaceCarrierCorrection K C F) = 0) :
    FiniteFaceCarrierHomotopyEquation K C (q + 1) := by
  rw [FiniteFaceCarrierHomotopyEquation]
  apply Finsupp.lhom_ext
  intro F a
  change faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (finiteFaceCarrierHomotopyDegreeLinear K C (q + 1)
          (Finsupp.single F a)) +
      finiteFaceCarrierHomotopyDegreeLinear K C q
        (faceBoundary K (AugmentedComplex.ofPre C) q
          (Finsupp.single F a)) =
    reverseSubdivisionAffineRawLinear K C (q + 1)
        (Finsupp.single F a) + Finsupp.single F a
  rw [finiteFaceCarrierHomotopyDegreeLinear_single, map_smul,
    finiteFaceCarrierHomotopyOn_boundary_of_cycle K C F (hcycle F),
    faceBoundary_single, map_smul,
    reverseSubdivisionAffineRawLinear_single_succ,
    smul_add, smul_add]
  have hL := charTwo_module_add_self_eq_zero K
    (a • finiteFaceCarrierHomotopyDegreeLinear K C q
      (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F))
  calc
    (a • reverseSubdivisionAffineOn K C F +
          a • Finsupp.single F 1 +
        a • finiteFaceCarrierHomotopyDegreeLinear K C q
          (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F)) +
        a • finiteFaceCarrierHomotopyDegreeLinear K C q
          (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) =
      a • reverseSubdivisionAffineOn K C F +
        a • Finsupp.single F 1 +
        (a • finiteFaceCarrierHomotopyDegreeLinear K C q
            (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F) +
          a • finiteFaceCarrierHomotopyDegreeLinear K C q
            (boundaryOnSimplex K (AugmentedComplex.ofPre C) q F)) := by
      abel
    _ = a • reverseSubdivisionAffineOn K C F +
        a • Finsupp.single F 1 := by rw [hL, add_zero]
    _ = a • reverseSubdivisionAffineOn K C F +
        Finsupp.single F a := by
      simp only [Finsupp.smul_single, smul_eq_mul, mul_one]

theorem finiteFaceCarrierHomotopyEquation_and_cycle
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ∀ a : ℕ, FiniteFaceCarrierHomotopyEquation K C a ∧
      ∀ F : AugmentedSimplex (AugmentedComplex.ofPre C) (a + 1),
        faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) a
          (finiteFaceCarrierCorrection K C F) = 0 := by
  intro a
  induction a with
  | zero =>
      have heq := finiteFaceCarrierHomotopyEquation_zero K C
      exact ⟨heq, finiteFaceCarrierCorrection_cycle_of_equation K C heq⟩
  | succ q ih =>
      have heq := finiteFaceCarrierHomotopyEquation_succ_of_cycle K C ih.2
      exact ⟨heq, finiteFaceCarrierCorrection_cycle_of_equation K C heq⟩

theorem finiteFaceCarrierHomotopyEquation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    FiniteFaceCarrierHomotopyEquation K C a :=
  (finiteFaceCarrierHomotopyEquation_and_cycle K C a).1

theorem finiteFaceCarrierCorrection_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) q
      (finiteFaceCarrierCorrection K C F) = 0 :=
  (finiteFaceCarrierHomotopyEquation_and_cycle K C q).2 F

theorem finiteFaceCarrierHomotopyLocalOn_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1)
        (finiteFaceCarrierHomotopyLocalOn K C (q + 1) F) =
      finiteFaceCarrierCorrection K C F :=
  finiteFaceCarrierHomotopyLocalOn_boundary_of_cycle K C F
    (finiteFaceCarrierCorrection_cycle K C F)

noncomputable def finiteFaceCarrierHomotopyDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X a ⟶
      (faceChainComplex K (AugmentedComplex.ofPre C)).X (a + 1) :=
  ModuleCat.ofHom (finiteFaceCarrierHomotopyDegreeLinear K C a)

@[simp]
theorem finiteFaceCarrierHomotopyDegree_hom
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (a : ℕ) :
    (finiteFaceCarrierHomotopyDegree K C a).hom =
      finiteFaceCarrierHomotopyDegreeLinear K C a := rfl

set_option maxHeartbeats 800000 in
theorem finiteFaceCarrierHomotopyDegree_equation_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).d (q + 1) q ≫
          finiteFaceCarrierHomotopyDegree K C q +
        finiteFaceCarrierHomotopyDegree K C (q + 1) ≫
          (faceChainComplex K (AugmentedComplex.ofPre C)).d
            (q + 2) (q + 1) =
      (reverseSubdivisionAffine K C).f (q + 1) -
        𝟙 ((faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1)) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro (x : AugmentedChain K (AugmentedComplex.ofPre C) (q + 1))
  have heq := finiteFaceCarrierHomotopyEquation K C (q + 1)
  have heqx := LinearMap.congr_fun heq x
  change faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (finiteFaceCarrierHomotopyDegreeLinear K C (q + 1) x) +
      finiteFaceCarrierHomotopyDegreeLinear K C q
        (faceBoundary K (AugmentedComplex.ofPre C) q x) =
    reverseSubdivisionAffineRawLinear K C (q + 1) x + x at heqx
  have hneg : -x = x := by
    calc
      -x = (-1 : K) • x := (neg_one_smul K x).symm
      _ = (1 : K) • x := by rw [CharTwo.neg_eq]
      _ = x := one_smul _ _
  simp only [ModuleCat.hom_add, ModuleCat.hom_comp, ModuleCat.hom_sub,
    ModuleCat.hom_id, faceChainComplex_d_hom,
    finiteFaceCarrierHomotopyDegree_hom]
  change finiteFaceCarrierHomotopyDegreeLinear K C q
        (faceBoundary K (AugmentedComplex.ofPre C) q x) +
      faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (finiteFaceCarrierHomotopyDegreeLinear K C (q + 1) x) =
    reverseSubdivisionAffineRawLinear K C (q + 1) x - x
  rw [sub_eq_add_neg, hneg]
  simpa only [add_comm] using heqx

@[simp]
theorem finiteFaceCarrierHomotopyDegree_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    finiteFaceCarrierHomotopyDegree K C 0 = 0 := by
  apply ModuleCat.hom_ext
  rw [finiteFaceCarrierHomotopyDegree_hom,
    finiteFaceCarrierHomotopyDegreeLinear_zero, ModuleCat.hom_zero]
  rfl

noncomputable def finiteFaceCarrierHomotopyToPrev
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (i : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X i ⟶
      (faceChainComplex K (AugmentedComplex.ofPre C)).xPrev i :=
  match i with
  | 0 => 0
  | r + 1 => finiteFaceCarrierHomotopyDegree K C (r + 1) ≫
      ((faceChainComplex K (AugmentedComplex.ofPre C)).xPrevIso
        (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv

@[simp]
theorem finiteFaceCarrierHomotopyToPrev_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    finiteFaceCarrierHomotopyToPrev K C 0 = 0 := rfl

@[simp]
theorem finiteFaceCarrierHomotopyToPrev_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (r : ℕ) :
    finiteFaceCarrierHomotopyToPrev K C (r + 1) =
      finiteFaceCarrierHomotopyDegree K C (r + 1) ≫
        ((faceChainComplex K (AugmentedComplex.ofPre C)).xPrevIso
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv := rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
set_option maxHeartbeats 800000 in
noncomputable def finiteFaceCarrierHomotopy
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    _root_.Homotopy (reverseSubdivisionAffine K C)
      (𝟙 (faceChainComplex K (AugmentedComplex.ofPre C))) := by
  let hrel : ∀ i j, (ComplexShape.down ℕ).Rel j i →
      ((faceChainComplex K (AugmentedComplex.ofPre C)).X i ⟶
        (faceChainComplex K (AugmentedComplex.ofPre C)).X j) :=
    fun i j hij ↦ finiteFaceCarrierHomotopyToPrev K C i ≫
      ((faceChainComplex K (AugmentedComplex.ofPre C)).xPrevIso hij).hom
  have hrel_zero : hrel 0 1 (by rfl) = 0 := by
    dsimp [hrel]
    rw [zero_comp]
  have hrel_succ (r : ℕ) : hrel (r + 1) (r + 2) (by rfl) =
      finiteFaceCarrierHomotopyDegree K C (r + 1) := by
    dsimp [hrel]
    let hr : (ComplexShape.down ℕ).Rel (r + 2) (r + 1) := by rfl
    change (finiteFaceCarrierHomotopyDegree K C (r + 1) ≫
        ((faceChainComplex K (AugmentedComplex.ofPre C)).xPrevIso hr).inv) ≫
          ((faceChainComplex K (AugmentedComplex.ofPre C)).xPrevIso hr).hom = _
    rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hmap : Homotopy.nullHomotopicMap' hrel =
      reverseSubdivisionAffine K C -
        𝟙 (faceChainComplex K (AugmentedComplex.ofPre C)) := by
    apply HomologicalComplex.hom_ext
    intro i
    rcases i with _ | r
    · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left
          (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
      · rw [hrel_zero, zero_comp,
          HomologicalComplex.sub_f_apply, HomologicalComplex.id_f,
          reverseSubdivisionAffine_f_zero, sub_self]
      · intro l hl
        simp at hl
    · rw [Homotopy.nullHomotopicMap'_f
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)
          (show (ComplexShape.down ℕ).Rel (r + 1) r by rfl)]
      simp only [HomologicalComplex.sub_f_apply, HomologicalComplex.id_f]
      rcases r with _ | r
      · rw [hrel_zero, comp_zero, hrel_succ]
        simpa only [finiteFaceCarrierHomotopyDegree_zero, comp_zero,
          zero_add] using
            (finiteFaceCarrierHomotopyDegree_equation_succ K C 0)
      · rw [hrel_succ r, hrel_succ (r + 1)]
        exact finiteFaceCarrierHomotopyDegree_equation_succ K C (r + 1)
  have hnull : _root_.Homotopy
      (reverseSubdivisionAffine K C -
        𝟙 (faceChainComplex K (AugmentedComplex.ofPre C))) 0 := by
    rw [← hmap]
    exact Homotopy.nullHomotopy' hrel
  exact Homotopy.equivSubZero.symm hnull

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Local contractions for the singular carrier homotopy

The pointwise support carrier of each lifted star-small simplex is explicitly
contracted in augmented unnormalized singular chains.  Affine reverse chains,
original generators, and recursive face fillers are retained inside those
local carriers before inclusion into the ambient realization.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

abbrev pointTop : TopCat.{u} := TopCat.of PUnit

noncomputable def pointSimplex (q : ℕ) :
    (singularSSet pointTop).obj
      (Opposite.op (SimplexCategory.mk q)) :=
  (pointTop.toSSetObjEquiv _).symm
    ⟨fun _ ↦ PUnit.unit, continuous_const⟩

theorem eq_pointSimplex (q : ℕ)
    (σ : (singularSSet pointTop).obj
      (Opposite.op (SimplexCategory.mk q))) :
    σ = pointSimplex q := by
  apply Equiv.injective (pointTop.toSSetObjEquiv _)
  ext t

example (q : ℕ) (i : Fin (q + 2)) :
    (singularSSet pointTop).δ i (pointSimplex (q + 1)) =
      pointSimplex q := by
  exact eq_pointSimplex q _

noncomputable def pointRaiseDegree
    (K : Type u) [Field K] (q : ℕ) :
    (sSetChainComplex K (singularSSet pointTop)).X q ⟶
      (sSetChainComplex K (singularSSet pointTop)).X (q + 1) :=
  Sigma.desc (fun _ : (singularSSet pointTop).obj
      (Opposite.op (SimplexCategory.mk q)) ↦
    (singularSSet pointTop).ιChainComplex (pointSimplex (q + 1)))

@[reassoc]
theorem iota_pointRaiseDegree
    (K : Type u) [Field K] (q : ℕ)
    (σ : (singularSSet pointTop).obj
      (Opposite.op (SimplexCategory.mk q))) :
    (singularSSet pointTop).ιChainComplex σ ≫
        pointRaiseDegree K q =
      (singularSSet pointTop).ιChainComplex (pointSimplex (q + 1)) := by
  exact Sigma.ι_desc _ σ

theorem pointRaiseDegree_boundary_of_odd
    (K : Type u) [Field K] (q : ℕ) (hq : Odd q) :
    pointRaiseDegree K q ≫
        (sSetChainComplex K (singularSSet pointTop)).d (q + 1) q =
      𝟙 _ := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_pointRaiseDegree,
    SSet.ιChainComplex_d]
  simp_rw [eq_pointSimplex q]
  rw [← Finset.sum_smul, Fin.sum_neg_one_pow]
  have hodd : Odd (q + 2) := hq.add_even (by simp)
  rw [if_neg (by simpa using hodd)]
  simp

theorem boundary_pointRaiseDegree_of_even_succ
    (K : Type u) [Field K] (q : ℕ) (hq : Even (q + 1)) :
    (sSetChainComplex K (singularSSet pointTop)).d (q + 1) q ≫
        pointRaiseDegree K q =
      𝟙 _ := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [SSet.ιChainComplex_d_assoc]
  rw [Preadditive.sum_comp]
  simp_rw [Preadditive.zsmul_comp, iota_pointRaiseDegree]
  rw [eq_pointSimplex (q + 1) σ]
  rw [← Finset.sum_smul, Fin.sum_neg_one_pow]
  have hodd : Odd (q + 2) := hq.add_one
  rw [if_neg (by simpa using hodd)]
  simp

noncomputable def pointContractDegree
    (K : Type u) [Field K] : (p : ℕ) →
    (augmentedSSetChainComplex K (singularSSet pointTop)).X p ⟶
      (augmentedSSetChainComplex K (singularSSet pointTop)).X (p + 1) :=
  fun p ↦ match p with
    | 0 => ιAugmentedSSet K (singularSSet pointTop) (pointSimplex 0)
    | q + 1 => if Odd q then pointRaiseDegree K q else 0

@[simp]
theorem pointContractDegree_zero
    (K : Type u) [Field K] :
    pointContractDegree K 0 =
      ιAugmentedSSet K (singularSSet pointTop) (pointSimplex 0) := rfl

@[simp]
theorem pointContractDegree_succ
    (K : Type u) [Field K] (q : ℕ) :
    pointContractDegree K (q + 1) =
      if Odd q then pointRaiseDegree K q else 0 := rfl

theorem pointAugmentation_section
    (K : Type u) [Field K] :
    (augmentedSSetChainComplex K (singularSSet pointTop)).d 1 0 ≫
        pointContractDegree K 0 = 𝟙 _ := by
  change sSetAugmentation K (singularSSet pointTop) ≫
      ιAugmentedSSet K (singularSSet pointTop) (pointSimplex 0) = 𝟙 _
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, sSet_ι_augmentation, Category.id_comp]
  rw [eq_pointSimplex 0 σ]
  change (singularSSet pointTop).ιChainComplex (pointSimplex 0) =
    (singularSSet pointTop).ιChainComplex (pointSimplex 0)
  rfl

noncomputable def pointContractToPrev
    (K : Type u) [Field K] (i : ℕ) :
    (augmentedSSetChainComplex K (singularSSet pointTop)).X i ⟶
      (augmentedSSetChainComplex K (singularSSet pointTop)).xPrev i :=
  pointContractDegree K i ≫
    ((augmentedSSetChainComplex K (singularSSet pointTop)).xPrevIso
      (show (ComplexShape.down ℕ).Rel (i + 1) i by rfl)).inv

noncomputable def pointContractRel
    (K : Type u) [Field K] (i j : ℕ)
    (hij : (ComplexShape.down ℕ).Rel j i) :
    (augmentedSSetChainComplex K (singularSSet pointTop)).X i ⟶
      (augmentedSSetChainComplex K (singularSSet pointTop)).X j :=
  pointContractToPrev K i ≫
    ((augmentedSSetChainComplex K (singularSSet pointTop)).xPrevIso hij).hom

@[simp]
theorem pointContractRel_succ
    (K : Type u) [Field K] (i : ℕ) :
    pointContractRel K i (i + 1) (by rfl) =
      pointContractDegree K i := by
  dsimp only [pointContractRel, pointContractToPrev]
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]

theorem pointNullHomotopicMap_f_zero
    (K : Type u) [Field K] :
    (Homotopy.nullHomotopicMap' (pointContractRel K)).f 0 =
      𝟙 _ := by
  rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left
      (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
  · rw [pointContractRel_succ]
    exact ιAugmentedSSet_d_one_zero K
      (singularSSet pointTop) (pointSimplex 0)
  · intro l hl
    simp at hl

theorem pointNullHomotopicMap_f_succ
    (K : Type u) [Field K] (q : ℕ) :
    (Homotopy.nullHomotopicMap' (pointContractRel K)).f (q + 1) =
      𝟙 _ := by
  rw [Homotopy.nullHomotopicMap'_f
      (show (ComplexShape.down ℕ).Rel (q + 2) (q + 1) by rfl)
      (show (ComplexShape.down ℕ).Rel (q + 1) q by rfl)]
  simp only [pointContractRel_succ]
  rcases Nat.even_or_odd q with hq | hq
  · rcases q with _ | p
    · let A := augmentedSSetChainComplex K (singularSSet pointTop)
      change A.d 1 0 ≫ pointContractDegree K 0 +
          (0 : A.X 1 ⟶ A.X 2) ≫ A.d 2 1 = 𝟙 (A.X 1)
      rw [zero_comp, add_zero]
      exact pointAugmentation_section K
    · have hpodd : Odd p := by
        exact Nat.not_even_iff_odd.mp (Nat.even_add_one.mp hq)
      change
        (sSetChainComplex K (singularSSet pointTop)).d (p + 1) p ≫
            (if Odd p then pointRaiseDegree K p else 0) +
          (if Odd (p + 1) then pointRaiseDegree K (p + 1) else 0) ≫
            (sSetChainComplex K (singularSSet pointTop)).d (p + 2) (p + 1) =
          𝟙 _
      rw [if_pos hpodd, if_neg (Nat.not_odd_iff_even.mpr hq)]
      simp only [zero_comp, add_zero]
      exact boundary_pointRaiseDegree_of_even_succ K p hq
  · rcases q with _ | p
    · exact (Nat.not_odd_zero hq).elim
    · have hpeven : Even p := by
        exact Nat.not_odd_iff_even.mp (Nat.odd_add_one.mp hq)
      change
        (sSetChainComplex K (singularSSet pointTop)).d (p + 1) p ≫
            (if Odd p then pointRaiseDegree K p else 0) +
          (if Odd (p + 1) then pointRaiseDegree K (p + 1) else 0) ≫
            (sSetChainComplex K (singularSSet pointTop)).d (p + 2) (p + 1) =
          𝟙 _
      rw [if_neg (Nat.not_odd_iff_even.mpr hpeven), if_pos hq]
      simp only [comp_zero, zero_add]
      exact pointRaiseDegree_boundary_of_odd K (p + 1) hq

theorem pointNullHomotopicMap_eq_id
    (K : Type u) [Field K] :
    Homotopy.nullHomotopicMap' (pointContractRel K) =
      𝟙 (augmentedSSetChainComplex K (singularSSet pointTop)) := by
  apply HomologicalComplex.hom_ext
  intro i
  rcases i with _ | q
  · exact pointNullHomotopicMap_f_zero K
  · exact pointNullHomotopicMap_f_succ K q

/-- The parity contraction really contracts the *augmented unnormalized*
singular complex of a point, including the formal empty generator. -/
noncomputable def augmentedPointContraction
    (K : Type u) [Field K] :
    _root_.Homotopy
      (𝟙 (augmentedSSetChainComplex K (singularSSet pointTop))) 0 :=
  (Homotopy.ofEq (pointNullHomotopicMap_eq_id K).symm).trans
    (Homotopy.nullHomotopy' (pointContractRel K))

def collapseToPoint (Y : TopCat.{u}) : Y ⟶ pointTop :=
  TopCat.const PUnit.unit

def includePoint {Y : TopCat.{u}} (y : Y) : pointTop ⟶ Y :=
  TopCat.const y

theorem collapseToPoint_includePoint {Y : TopCat.{u}} (y : Y) :
    collapseToPoint Y ≫ includePoint y = TopCat.const y := by
  ext x
  rfl

@[simp]
theorem augmentedSingularMap_id_probe
    (K : Type u) [Field K] (Y : TopCat.{u}) :
    augmentedSingularMap K (𝟙 Y) =
      𝟙 (augmentedSingularChainComplex K Y) := by
  exact augmentedSSetMap_id K (singularSSet Y)

@[simp]
theorem augmentedSingularMap_comp_probe
    (K : Type u) [Field K] {X Y Z : TopCat.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    augmentedSingularMap K (f ≫ g) =
      augmentedSingularMap K f ≫ augmentedSingularMap K g := by
  change augmentedSSetMap K (TopCat.toSSet.map (f ≫ g)) =
    augmentedSSetMap K (TopCat.toSSet.map f) ≫
      augmentedSSetMap K (TopCat.toSSet.map g)
  rw [Functor.map_comp, augmentedSSetMap_comp]

theorem augmentedConstantMap_factorization
    (K : Type u) [Field K] {Y : TopCat.{u}} (y : Y) :
    augmentedSingularMap K (TopCat.const (X := Y) y) =
      augmentedSingularMap K (collapseToPoint Y) ≫
        augmentedSingularMap K (includePoint y) := by
  rw [← augmentedSingularMap_comp_probe,
    collapseToPoint_includePoint]

/-- The transported point contraction has the constant self-map as its
source.  In Lean's left-to-right composition order its operator is
`collapse_* ≫ h_pt ≫ incl_*`. -/
noncomputable def transportedPointContraction
    (K : Type u) [Field K] {Y : TopCat.{u}} (y : Y) :
    _root_.Homotopy
      (augmentedSingularMap K (collapseToPoint Y) ≫
        augmentedSingularMap K (includePoint y)) 0 := by
  let hraw := ((augmentedPointContraction K).compLeft
    (augmentedSingularMap K (collapseToPoint Y))).compRight
      (augmentedSingularMap K (includePoint y))
  exact (Homotopy.ofEq (by simp)).trans
    (hraw.trans (Homotopy.ofEq (by simp)))

noncomputable def augmentedConstantMapToZero
    (K : Type u) [Field K] {Y : TopCat.{u}} (y : Y) :
    _root_.Homotopy
      (augmentedSingularMap K (TopCat.const (X := Y) y)) 0 :=
  (Homotopy.ofEq (augmentedConstantMap_factorization K y)).trans
    (transportedPointContraction K y)

/-- A topological contraction plus the point correction contracts augmented
unnormalized singular chains. -/
noncomputable def augmentedContractionOfHomotopy
    (K : Type u) [Field K] {Y : TopCat.{u}} (y : Y)
    (H : TopCat.Homotopy (𝟙 Y) (TopCat.const (X := Y) y)) :
    _root_.Homotopy (𝟙 (augmentedSingularChainComplex K Y)) 0 :=
  (Homotopy.ofEq (augmentedSingularMap_id_probe K Y).symm).trans
    ((augmentedSingularHomotopy K H).trans
      (augmentedConstantMapToZero K y))

theorem augmentedContractionOfHomotopy_hom_formula
    (K : Type u) [Field K] {Y : TopCat.{u}} (y : Y)
    (H : TopCat.Homotopy (𝟙 Y) (TopCat.const (X := Y) y)) (i j : ℕ) :
    (augmentedContractionOfHomotopy K y H).hom i j =
      (augmentedSingularHomotopy K H).hom i j +
        (augmentedSingularMap K (collapseToPoint Y)).f i ≫
          (augmentedPointContraction K).hom i j ≫
            (augmentedSingularMap K (includePoint y)).f j := by
  simp [augmentedContractionOfHomotopy,
    augmentedConstantMapToZero, transportedPointContraction]

/-! ## The actual pointwise support-carrier contraction -/

/-- The coordinate vertex selected by the common open-star witness belongs
to the realization of the pointwise support carrier. -/
noncomputable def supportCarrierVertex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    preGeomTop (supportCarrier C σ.1) :=
  ⟨Pi.single (starApex C σ) 1, by
    refine ⟨(single_mem_stdSimplex ℝ (starApex C σ)).1,
      (single_mem_stdSimplex ℝ (starApex C σ)).2, ?_⟩
    rw [show SimplicialSphereAnisotropicity.barycentricSupport
        (Pi.single (starApex C σ) 1) = {starApex C σ} by
      ext v
      simp [SimplicialSphereAnisotropicity.barycentricSupport, Pi.single_apply, eq_comm]]
    exact starApex_singleton_mem_supportCarrier C σ⟩

@[simp]
theorem supportCarrierVertex_apply {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) (v : Fin m) :
    (supportCarrierVertex C σ).1 v =
      if starApex C σ = v then 1 else 0 := by
  simp [supportCarrierVertex, Pi.single_apply, eq_comm]

/-- Coordinate formula for the straight line from a carrier point to its
common apex. -/
noncomputable def supportCarrierStraightPoint {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (s : Set.Icc (0 : ℝ) 1)
    (x : preGeomTop (supportCarrier C σ.1)) :
    preGeomTop (supportCarrier C σ.1) := by
  let y : Fin m → ℝ := fun v ↦
    (1 - (s : ℝ)) * x.1 v +
      (s : ℝ) * (supportCarrierVertex C σ).1 v
  have hs0 : 0 ≤ (s : ℝ) := s.property.1
  have hs1 : (s : ℝ) ≤ 1 := s.property.2
  have hnonneg : ∀ v, 0 ≤ y v := by
    intro v
    exact add_nonneg
      (mul_nonneg (sub_nonneg.mpr hs1) (x.property.1 v))
      (mul_nonneg hs0 ((supportCarrierVertex C σ).property.1 v))
  have hsum : (∑ v, y v) = 1 := by
    dsimp only [y]
    rw [Finset.sum_add_distrib]
    simp_rw [← Finset.mul_sum]
    rw [x.property.2.1, (supportCarrierVertex C σ).property.2.1]
    ring
  refine ⟨y, hnonneg, hsum, ?_⟩
  dsimp only [y]
  apply ((supportCarrier C σ.1).isRelLowerSet_faces
    (supportCarrier_insert_starApex C σ x.property.2.2)).2
  · intro v hv
    simp only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
      Finset.mem_univ, true_and] at hv
    rw [Finset.mem_insert]
    by_cases hva : starApex C σ = v
    · exact Or.inl hva.symm
    · apply Or.inr
      rw [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      intro hx
      simp [supportCarrierVertex_apply, hva, hx] at hv
  · have hsum_ne : (∑ v, y v) ≠ 0 := by
      rw [hsum]
      norm_num
    obtain ⟨v, -, hv⟩ :=
      Finset.exists_ne_zero_of_sum_ne_zero hsum_ne
    exact ⟨v, by
      simpa only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
        Finset.mem_univ, true_and, y] using hv⟩

@[simp]
theorem supportCarrierStraightPoint_zero {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (x : preGeomTop (supportCarrier C σ.1)) :
    supportCarrierStraightPoint C σ ⟨0, by simp⟩ x = x := by
  ext v
  simp [supportCarrierStraightPoint]

@[simp]
theorem supportCarrierStraightPoint_one {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (x : preGeomTop (supportCarrier C σ.1)) :
    supportCarrierStraightPoint C σ ⟨1, by simp⟩ x =
      supportCarrierVertex C σ := by
  ext v
  simp [supportCarrierStraightPoint]

/-- The realization of the pointwise support carrier contracts to the
coordinate vertex selected by star-smallness. -/
noncomputable def supportCarrierTopHomotopy {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    TopCat.Homotopy
      (𝟙 (preGeomTop (supportCarrier C σ.1)))
      (TopCat.const (supportCarrierVertex C σ)) where
  toFun p := supportCarrierStraightPoint C σ p.1 p.2
  continuous_toFun := by
    apply Continuous.subtype_mk
    apply continuous_pi
    intro v
    have hs : Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
        preGeomTop (supportCarrier C σ.1) ↦ (p.1 : ℝ)) :=
      continuous_subtype_val.comp continuous_fst
    have hx : Continuous (fun p : Set.Icc (0 : ℝ) 1 ×
        preGeomTop (supportCarrier C σ.1) ↦ p.2.1 v) :=
      (continuous_apply v).comp
        (continuous_subtype_val.comp continuous_snd)
    fun_prop
  map_zero_left x := supportCarrierStraightPoint_zero C σ x
  map_one_left x := supportCarrierStraightPoint_one C σ x

/-! ## Transport of the local carrier through the universe lift -/

/-- The low-universe carrier attached to a lifted star-small simplex. -/
abbrev liftedSupportCarrier {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :=
  supportCarrier C (liftedSmallToSmall C σ).1

/-- Inclusion of lifted realizations induced by an inclusion of low-universe
precomplexes. -/
def liftedPreGeomMapOfLE {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C) :
    liftedPreGeomTop.{u} L ⟶ liftedPreGeomTop.{u} C :=
  TopCat.uliftFunctor.{u}.map (preGeomMapOfLE h)

@[simp]
theorem liftedPreGeomMapOfLE_down_apply {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (x : liftedPreGeomTop.{u} L) :
    (preGeomTop C).uliftFunctorObjHomeo.symm
        (liftedPreGeomMapOfLE h x) =
      preGeomMapOfLE h
        ((preGeomTop L).uliftFunctorObjHomeo.symm x) := by
  exact TopCat.uliftFunctorObjHomeo_symm_naturality_apply
    (preGeomMapOfLE h) x

/-- The lifted coordinate apex. -/
noncomputable def liftedSupportCarrierVertex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    liftedPreGeomTop.{u} (liftedSupportCarrier C σ) :=
  (preGeomTop (liftedSupportCarrier C σ)).uliftFunctorObjHomeo
    (supportCarrierVertex C (liftedSmallToSmall C σ))

/-- Transporting the low carrier contraction through the canonical
homeomorphism gives the contraction in the coefficient universe. -/
noncomputable def liftedSupportCarrierTopHomotopy {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    TopCat.Homotopy
      (𝟙 (liftedPreGeomTop.{u} (liftedSupportCarrier C σ)))
      (TopCat.const (liftedSupportCarrierVertex C σ)) := by
  let L := liftedSupportCarrier C σ
  let e := (preGeomTop L).uliftFunctorObjHomeo
  let h := supportCarrierTopHomotopy C (liftedSmallToSmall C σ)
  exact
    { toFun := fun p ↦ e (h ⟨p.1, e.symm p.2⟩)
      continuous_toFun := by
        exact e.continuous.comp
          (h.continuous.comp
            (continuous_fst.prodMk
              (e.symm.continuous.comp continuous_snd)))
      map_zero_left := fun x ↦ by
        change e (h ⟨⟨0, by simp⟩, e.symm x⟩) = x
        exact (congrArg e (h.map_zero_left (e.symm x))).trans
          (e.apply_symm_apply x)
      map_one_left := fun x ↦ by
        change e (h ⟨⟨1, by simp⟩, e.symm x⟩) =
          liftedSupportCarrierVertex C σ
        exact congrArg e (h.map_one_left (e.symm x)) }

/-- Lift the original simplex into the lifted realization of its own low
support carrier.  This avoids any universe-polymorphic redefinition of the
carrier itself. -/
noncomputable def liftedSupportCarrierLift {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    singularSSet (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))
      _⦋q⦌ :=
  (liftedSingularEquiv (liftedSupportCarrier C σ) _).symm
    (supportCarrierLift C (liftedSmallToSmall C σ).1)

/-- The carrier-subtype lift really maps back to the original lifted
simplex.  This is the critical universe/naturality equation used by the
local recursive homotopy. -/
theorem liftedSupportCarrierLift_map_inclusion {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (TopCat.toSSet.map
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).app
          (Opposite.op (SimplexCategory.mk q))
      (liftedSupportCarrierLift C σ) = σ.1 := by
  apply Equiv.injective
    ((liftedPreGeomTop.{u} C).toSSetObjEquiv
      (Opposite.op (SimplexCategory.mk q)))
  ext t
  apply (preGeomTop C).uliftFunctorObjHomeo.symm.injective
  ext v
  rfl

/-- Promote a precomplex inclusion to the corresponding augmented face-family
inclusion. -/
theorem augmentedOfPreLE {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C) :
    ∀ G : Finset (Fin m),
      G ∈ AugmentedComplex.ofPre L → G ∈ AugmentedComplex.ofPre C := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr (h hG)

/-- Affine characteristic simplices commute with inclusion of a local
carrier realization into the ambient realization. -/
theorem affineFaceSimplexLifted_map_inclusion {m q : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (F : AugmentedSimplex (AugmentedComplex.ofPre L) (q + 1)) :
    (TopCat.toSSet.map (liftedPreGeomMapOfLE h)).app
        (Opposite.op (SimplexCategory.mk q))
        (affineFaceSimplexLifted.{u} L F) =
      affineFaceSimplexLifted.{u} C
        (augmentedSimplexOfLE (augmentedOfPreLE h) F) := by
  apply Equiv.injective
    ((liftedPreGeomTop.{u} C).toSSetObjEquiv
      (Opposite.op (SimplexCategory.mk q)))
  ext t
  apply (preGeomTop C).uliftFunctorObjHomeo.symm.injective
  ext v
  rfl

/-- Generator-level naturality of the affine characteristic chain. -/
theorem affineFaceGenerator_map_inclusion
    (K : Type u) [Field K] {m q : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (F : AugmentedSimplex (AugmentedComplex.ofPre L) (q + 1)) :
    affineFaceGenerator K L F ≫
        (augmentedSingularMap K (liftedPreGeomMapOfLE h)).f (q + 1) =
      affineFaceGenerator K C
        (augmentedSimplexOfLE (augmentedOfPreLE h) F) := by
  rw [affineFaceGenerator, affineFaceGenerator,
    augmentedSingularMap_f_succ]
  change
    (singularSSet (liftedPreGeomTop.{u} L)).ιChainComplex
        (affineFaceSimplexLifted.{u} L F) ≫
      (SSet.chainComplexMap
        (TopCat.toSSet.map (liftedPreGeomMapOfLE h))
        (ModuleCat.of K K)).f q =
    (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
      (affineFaceSimplexLifted.{u} C
        (augmentedSimplexOfLE (augmentedOfPreLE h) F))
  rw [SSet.ι_chainComplexMap_f]
  congr 1

/-- Degreewise naturality: applying the affine map locally and then
including the carrier agrees with first including the face chain and then
using the ambient affine map. -/
theorem affineFaceDegree_map_inclusion
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (q : ℕ) :
    ((augmentedSingularMap K
        (liftedPreGeomMapOfLE h)).f (q + 1)).hom.comp
        (affineFaceDegree K L q).hom =
      (affineFaceDegree K C q).hom.comp
        (faceChainInclusionDegree K (augmentedOfPreLE h) (q + 1)) := by
  apply Finsupp.lhom_ext
  intro F a
  change
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE h)).f (q + 1)).hom
        ((affineFaceDegree K L q).hom (Finsupp.single F a)) =
      (affineFaceDegree K C q).hom
        (faceChainInclusionDegree K (augmentedOfPreLE h) (q + 1)
          (Finsupp.single F a))
  rw [affineFaceDegree_single, map_smul,
    faceChainInclusionDegree_single, affineFaceDegree_single]
  congr 1
  have hgen := affineFaceGenerator_map_inclusion K h F
  exact congrArg (fun f ↦ f.hom 1) hgen

/-- The locally lifted original generator also maps to the original ambient
lifted simplex. -/
theorem liftedSupportCarrierGenerator_map_inclusion
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ιAugmentedSSet K
        (singularSSet
          (liftedPreGeomTop.{u} (liftedSupportCarrier C σ)))
        (liftedSupportCarrierLift C σ) ≫
      (augmentedSingularMap K
        (liftedPreGeomMapOfLE
          (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
            (q + 1) =
      ιAugmentedSSet K
        (singularSSet (liftedPreGeomTop.{u} C)) σ.1 := by
  rw [augmentedSingularMap_f_succ]
  change
    (singularSSet
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).ιChainComplex
        (liftedSupportCarrierLift C σ) ≫
      (SSet.chainComplexMap
        (TopCat.toSSet.map
          (liftedPreGeomMapOfLE
            (supportCarrier_le C (liftedSmallToSmall C σ).1)))
        (ModuleCat.of K K)).f q =
    (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex σ.1
  rw [SSet.ι_chainComplexMap_f]
  congr 1

/-- Carrier monotonicity survives the low-universe conversion of a lifted
face. -/
theorem liftedSupportCarrier_face_le {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q + 1⦌)
    (i : Fin (q + 2)) :
    liftedSupportCarrier C
        ((liftedStarSmallSingularSSet.{u} C).δ i σ) ≤
      liftedSupportCarrier C σ := by
  dsimp only [liftedSupportCarrier]
  rw [liftedSmallToSmall_face]
  exact supportCarrier_map_le C (SimplexCategory.δ i)
    (liftedSmallToSmall C σ).1

/-- The exact augmented contraction available for every lifted local carrier.
Its homotopy operator includes both the prism and the transported point
correction proved above. -/
noncomputable def liftedSupportCarrierAugmentedContraction
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    _root_.Homotopy
      (𝟙 (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ)))) 0 :=
  augmentedContractionOfHomotopy K
    (liftedSupportCarrierVertex C σ)
    (liftedSupportCarrierTopHomotopy C σ)

/-! ## Local-by-construction recursive filler -/

/-- The affine image of the already-existing carried reverse chain, formed
inside the lifted realization of this simplex's carrier. -/
noncomputable def localAffineReverseChain
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 1) :=
  (affineFaceDegree K (liftedSupportCarrier C σ) q).hom
    (reverseLocalOn K C q (liftedSmallToSmall C σ))

/-- The original simplex, lifted as a generator of its local carrier. -/
noncomputable def localOriginalChain
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 1) :=
  (ιAugmentedSSet K
    (singularSSet
      (liftedPreGeomTop.{u} (liftedSupportCarrier C σ)))
    (liftedSupportCarrierLift C σ)).hom 1

/-- Including the local affine reverse chain recovers the ambient affine
image of the public reverse chain. -/
theorem localAffineReverseChain_map_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
          (q + 1)).hom (localAffineReverseChain K C σ) =
      (affineFaceDegree K C q).hom
        (reverseOn K C (liftedSmallToSmall C σ)) := by
  have hnat := LinearMap.congr_fun
    (affineFaceDegree_map_inclusion K
      (supportCarrier_le C (liftedSmallToSmall C σ).1) q)
    (reverseLocalOn K C q (liftedSmallToSmall C σ))
  change
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
          (q + 1)).hom
      ((affineFaceDegree K
        (supportCarrier C (liftedSmallToSmall C σ).1) q).hom
          (reverseLocalOn K C q (liftedSmallToSmall C σ))) =
    (affineFaceDegree K C q).hom
      (faceChainInclusionDegree K
        (augmentedOfPreLE
          (supportCarrier_le C (liftedSmallToSmall C σ).1)) (q + 1)
        (reverseLocalOn K C q (liftedSmallToSmall C σ))) at hnat
  simpa only [localAffineReverseChain, reverseOn] using hnat

/-- Including the local original chain recovers the ambient generator. -/
theorem localOriginalChain_map_inclusion
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    ((augmentedSingularMap K
      (liftedPreGeomMapOfLE
        (supportCarrier_le C (liftedSmallToSmall C σ).1))).f
          (q + 1)).hom (localOriginalChain K C σ) =
      (ιAugmentedSSet K
        (singularSSet (liftedPreGeomTop.{u} C)) σ.1).hom 1 := by
  exact congrArg (fun f ↦ f.hom 1)
    (liftedSupportCarrierGenerator_map_inclusion K C σ)

/-- Recursive filler in the local lifted support carrier.  The proof that
the displayed input is a cycle is deliberately separated from this
definition; applying the contraction is meaningful for every chain. -/
noncomputable def singularCarrierHomotopyLocalOn
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) : (q : ℕ) →
    ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 2) :=
  fun q ↦ Nat.rec
    (motive := fun q ↦
      ∀ σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌,
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} (liftedSupportCarrier C σ))).X (q + 2))
    (fun σ ↦
      ((liftedSupportCarrierAugmentedContraction K C σ).hom 1 2).hom
        (localAffineReverseChain K C σ + localOriginalChain K C σ))
    (fun q ih σ ↦
      ((liftedSupportCarrierAugmentedContraction K C σ).hom
          (q + 2) (q + 3)).hom
        (localAffineReverseChain K C σ + localOriginalChain K C σ +
          ∑ i : Fin (q + 2),
            ((augmentedSingularMap K
              (liftedPreGeomMapOfLE
                (liftedSupportCarrier_face_le C σ i))).f
                  (q + 2)).hom
              (ih ((liftedStarSmallSingularSSet.{u} C).δ i σ))))
    q

/-! The following injectivity route can be used to prove each local cycle by
including it in the ambient singular complex, where the inductive homotopy
calculation is simpler. -/

theorem sSetChainComplexMap_injective_of_app
    (K : Type u) [Field K] {X Y : SSet.{u}} (f : X ⟶ Y) (q : ℕ)
    (hf : Function.Injective
      (f.app (Opposite.op (SimplexCategory.mk q)))) :
    Function.Injective
      ((SSet.chainComplexMap f (ModuleCat.of K K)).f q) := by
  rw [← ModuleCat.mono_iff_injective]
  dsimp [SSet.chainComplexMap, SSet.chainComplexFunctor]
  exact MonoCoprod.mono_map'_of_injective
    (fun _ : Y _⦋q⦌ ↦ ModuleCat.of K K)
    (f.app (Opposite.op (SimplexCategory.mk q))) hf

theorem liftedPreGeomMapOfLE_injective {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C) :
    Function.Injective (liftedPreGeomMapOfLE.{u} h) := by
  intro x y hxy
  apply (preGeomTop L).uliftFunctorObjHomeo.symm.injective
  have hd := congrArg
    (preGeomTop C).uliftFunctorObjHomeo.symm hxy
  have hd' :
      preGeomMapOfLE h
          ((preGeomTop L).uliftFunctorObjHomeo.symm x) =
        preGeomMapOfLE h
          ((preGeomTop L).uliftFunctorObjHomeo.symm y) := by
    calc
      preGeomMapOfLE h
          ((preGeomTop L).uliftFunctorObjHomeo.symm x) =
          (preGeomTop C).uliftFunctorObjHomeo.symm
            (liftedPreGeomMapOfLE h x) :=
        (TopCat.uliftFunctorObjHomeo_symm_naturality_apply
          (preGeomMapOfLE h) x).symm
      _ = (preGeomTop C).uliftFunctorObjHomeo.symm
            (liftedPreGeomMapOfLE h y) := hd
      _ = preGeomMapOfLE h
          ((preGeomTop L).uliftFunctorObjHomeo.symm y) :=
        TopCat.uliftFunctorObjHomeo_symm_naturality_apply
          (preGeomMapOfLE h) y
  apply Subtype.ext
  exact congrArg (fun z : preGeomTop C ↦ z.1) hd'

theorem liftedPreGeomMapOfLE_singular_app_injective {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (q : ℕ) :
    Function.Injective
      ((TopCat.toSSet.map (liftedPreGeomMapOfLE.{u} h)).app
        (Opposite.op (SimplexCategory.mk q))) := by
  intro σ τ hστ
  apply Equiv.injective
    ((liftedPreGeomTop.{u} L).toSSetObjEquiv
      (Opposite.op (SimplexCategory.mk q)))
  ext t
  apply liftedPreGeomMapOfLE_injective h
  have ht := congrArg
    (fun ρ ↦ (liftedPreGeomTop.{u} C).toSSetObjEquiv
      (Opposite.op (SimplexCategory.mk q)) ρ t) hστ
  exact ht

theorem augmentedSingularMap_liftedPreGeomMapOfLE_injective
    (K : Type u) [Field K] {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (q : ℕ) :
    Function.Injective
      ((augmentedSingularMap K
        (liftedPreGeomMapOfLE.{u} h)).f (q + 1)) := by
  rw [augmentedSingularMap_f_succ]
  exact sSetChainComplexMap_injective_of_app K _ q
    (liftedPreGeomMapOfLE_singular_app_injective h q)

/-- Element-level form of the only contraction identity needed by the
recursion: on a cycle in positive cardinal degree, the raising component of
an `id ∼ 0` homotopy is a filler. -/
theorem contraction_fills_cycle
    (K : Type u) [Field K]
    (A : ChainComplex (ModuleCat K) ℕ)
    (T : _root_.Homotopy (𝟙 A) 0)
    (q : ℕ) (z : A.X (q + 1))
    (hz : (A.d (q + 1) q).hom z = 0) :
    (A.d (q + 2) (q + 1)).hom
        ((T.hom (q + 1) (q + 2)).hom z) = z := by
  have hc := T.comm (q + 1)
  rw [HomologicalComplex.id_f, HomologicalComplex.zero_f,
    dNext_eq T.hom
      (show (ComplexShape.down ℕ).Rel (q + 1) q by rfl),
    prevD_eq T.hom
      (show (ComplexShape.down ℕ).Rel (q + 2) (q + 1) by rfl)] at hc
  have hzEq := congrArg (fun f ↦ f.hom z) hc
  simp only [ModuleCat.hom_id, LinearMap.id_apply, ModuleCat.hom_add,
    LinearMap.add_apply, ModuleCat.hom_comp, LinearMap.comp_apply,
    add_zero] at hzEq
  rw [hz, map_zero, zero_add] at hzEq
  exact hzEq.symm

end SimplicialSphereAnisotropicity.Topology

