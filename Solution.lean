abbrev FaceRingDegreeIndex {m : ℕ}
    (C : AugmentedComplex (Fin m)) (q : ℕ) :=
  {a : AllowedExponent C // a.1.degree = q}

noncomputable instance faceRingDegreeIndexFintype {m : ℕ}
    (C : AugmentedComplex (Fin m)) (q : ℕ) :
    Fintype (FaceRingDegreeIndex C q) := by
  let E := {a : Fin m →₀ ℕ // a.degree = q}
  letI : Fintype E := (Finsupp.finite_of_degree_eq q).fintype
  let f : FaceRingDegreeIndex C q → E := fun a ↦ ⟨a.1.1, a.2⟩
  letI : Finite (FaceRingDegreeIndex C q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : E => z.1) h)
  exact Fintype.ofFinite _

abbrev WeightedFreeDegreeIndex (d N : ℕ)
    (r : Fin N → ℕ) (q : ℕ) :=
  {ia : Fin N × (Fin d →₀ ℕ) // r ia.1 + ia.2.degree = q}

noncomputable instance weightedFreeDegreeIndexFintype
    (d N : ℕ) (r : Fin N → ℕ) (q : ℕ) :
    Fintype (WeightedFreeDegreeIndex d N r q) := by
  let E := {a : Fin d →₀ ℕ // a.degree ≤ q}
  letI : Fintype E := (Finsupp.finite_of_degree_le q).fintype
  let f : WeightedFreeDegreeIndex d N r q → Fin N × E := fun ia ↦
    ⟨ia.1.1, ⟨ia.1.2, by omega⟩⟩
  letI : Finite (WeightedFreeDegreeIndex d N r q) :=
    Finite.of_injective f (fun x y h ↦ by
      apply Subtype.ext
      apply Prod.ext
      · exact congrArg (fun z ↦ z.1) h
      · exact congrArg (fun z ↦ z.2.1) h)
  exact Fintype.ofFinite _

noncomputable def mvPolynomialCoeffLinearEquiv
    (K : Type u) [Field K] (d : ℕ) :
    MvPolynomial (Fin d) K ≃ₗ[K] ((Fin d →₀ ℕ) →₀ K) where
  toFun p := AddMonoidAlgebra.coeff p
  invFun p := AddMonoidAlgebra.ofCoeff p
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

noncomputable def weightedFreeFlatten
    (K : Type u) [Field K] (d N : ℕ) :
    (Fin N → MvPolynomial (Fin d) K) ≃ₗ[K]
      (Fin N × (Fin d →₀ ℕ) →₀ K) :=
  (Finsupp.linearEquivFunOnFinite K
      (MvPolynomial (Fin d) K) (Fin N)).symm |>.trans
    (Finsupp.mapRange.linearEquiv (mvPolynomialCoeffLinearEquiv K d)) |>.trans
    ((Finsupp.curryLinearEquiv K :
      (Fin N × (Fin d →₀ ℕ) →₀ K) ≃ₗ[K]
        (Fin N →₀ (Fin d →₀ ℕ) →₀ K)).symm)

@[simp]
theorem weightedFreeFlatten_apply
    (K : Type u) [Field K] (d N : ℕ)
    (p : Fin N → MvPolynomial (Fin d) K)
    (ia : Fin N × (Fin d →₀ ℕ)) :
    weightedFreeFlatten K d N p ia =
      MvPolynomial.coeff ia.2 (p ia.1) := by
  rfl

noncomputable def weightedFlatComponent
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ) :
    (Fin N × (Fin d →₀ ℕ) →₀ K) →ₗ[K]
      (Fin N × (Fin d →₀ ℕ) →₀ K) where
  toFun z := z.filter (fun ia ↦ r ia.1 + ia.2.degree = q)
  map_add' _ _ := Finsupp.filter_add
  map_smul' _ _ := Finsupp.filter_smul

@[simp]
theorem weightedFlatComponent_apply
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ)
    (z : Fin N × (Fin d →₀ ℕ) →₀ K)
    (ia : Fin N × (Fin d →₀ ℕ)) :
    weightedFlatComponent K r q z ia =
      if r ia.1 + ia.2.degree = q then z ia else 0 := by
  rfl

theorem weightedFreeFlatten_component
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ)
    (p : Fin N → MvPolynomial (Fin d) K) :
    weightedFreeFlatten K d N (weightedFreeComponent K r q p) =
      weightedFlatComponent K r q (weightedFreeFlatten K d N p) := by
  ext ia
  rw [weightedFreeFlatten_apply, weightedFreeComponent_apply,
    weightedFlatComponent_apply, weightedFreeFlatten_apply]
  by_cases hw : r ia.1 + ia.2.degree = q
  · have hrq : r ia.1 ≤ q := by omega
    have hdegree : ia.2.degree = q - r ia.1 := by omega
    rw [dif_pos hrq, MvPolynomial.coeff_homogeneousComponent,
      if_pos hw, if_pos hdegree]
  · by_cases hrq : r ia.1 ≤ q
    · have hdegree : ia.2.degree ≠ q - r ia.1 := by omega
      rw [dif_pos hrq, MvPolynomial.coeff_homogeneousComponent,
        if_neg hw, if_neg hdegree]
    · rw [dif_neg hrq, if_neg hw, MvPolynomial.coeff_zero]

theorem faceRingModelComponent_range_eq_supported
    (K : Type u) [Field K] {m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    LinearMap.range (faceRingModelComponent K C q) =
      Finsupp.supported K K
        {a : AllowedExponent C | a.1.degree = q} := by
  apply le_antisymm
  · rintro z ⟨x, rfl⟩
    rw [Finsupp.mem_supported']
    intro a ha
    rw [faceRingModelComponent_apply]
    exact if_neg ha
  · intro z hz
    refine ⟨z, faceRingModelComponent_eq_self K C z ?_⟩
    intro a ha
    rw [Finsupp.mem_supported] at hz
    exact hz ha

theorem weightedFlatComponent_range_eq_supported
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ) :
    LinearMap.range (weightedFlatComponent K r q) =
      Finsupp.supported K K
        {ia : Fin N × (Fin d →₀ ℕ) |
          r ia.1 + ia.2.degree = q} := by
  apply le_antisymm
  · rintro z ⟨x, rfl⟩
    rw [Finsupp.mem_supported']
    intro ia hia
    rw [weightedFlatComponent_apply]
    exact if_neg hia
  · intro z hz
    refine ⟨z, ?_⟩
    ext ia
    rw [weightedFlatComponent_apply]
    by_cases hia : r ia.1 + ia.2.degree = q
    · rw [if_pos hia]
    · rw [if_neg hia]
      rw [Finsupp.mem_supported'] at hz
      exact (hz ia hia).symm

noncomputable def weightedFreeComponentRangeEquiv
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ) :
    LinearMap.range (weightedFreeComponent (sigma := Fin d) K r q) ≃ₗ[K]
      LinearMap.range (weightedFlatComponent (d := d) K r q) where
  toFun x := ⟨weightedFreeFlatten K d N x.1, by
    rcases x.2 with ⟨p, hp⟩
    refine ⟨weightedFreeFlatten K d N p, ?_⟩
    rw [← weightedFreeFlatten_component K r q p]
    exact congrArg (weightedFreeFlatten K d N) hp⟩
  invFun z := ⟨(weightedFreeFlatten K d N).symm z.1, by
    rcases z.2 with ⟨w, hw⟩
    refine ⟨(weightedFreeFlatten K d N).symm w, ?_⟩
    apply (weightedFreeFlatten K d N).injective
    rw [weightedFreeFlatten_component]
    simp only [LinearEquiv.apply_symm_apply]
    exact hw⟩
  left_inv x := by
    apply Subtype.ext
    simp
  right_inv z := by
    apply Subtype.ext
    simp
  map_add' x y := by
    apply Subtype.ext
    simp
  map_smul' c x := by
    apply Subtype.ext
    simp

theorem finrank_finsupp_supported_eq_card
    (K : Type u) [Field K] {alpha : Type*}
    (s : Set alpha) [Fintype s] :
    Module.finrank K (Finsupp.supported K K s) = Fintype.card s := by
  rw [LinearEquiv.finrank_eq (Finsupp.supportedEquivFinsupp (R := K) s)]
  exact Module.finrank_finsupp_self K

set_option linter.style.haveILetI false in
theorem finrank_faceRingModelComponent_range_eq_card
    (K : Type u) [Field K] {m q : ℕ}
    (C : AugmentedComplex (Fin m)) :
    Module.finrank K (LinearMap.range
      (faceRingModelComponent K C q)) =
      Fintype.card (FaceRingDegreeIndex C q) := by
  letI : Fintype {a : AllowedExponent C | a.1.degree = q} :=
    faceRingDegreeIndexFintype C q
  rw [faceRingModelComponent_range_eq_supported]
  exact finrank_finsupp_supported_eq_card K _

set_option linter.style.haveILetI false in
theorem finrank_weightedFreeComponent_range_eq_card
    (K : Type u) [Field K] {d N : ℕ}
    (r : Fin N → ℕ) (q : ℕ) :
    Module.finrank K (LinearMap.range
      (weightedFreeComponent (sigma := Fin d) K r q)) =
      Fintype.card (WeightedFreeDegreeIndex d N r q) := by
  letI : Fintype {ia : Fin N × (Fin d →₀ ℕ) |
      r ia.1 + ia.2.degree = q} :=
    weightedFreeDegreeIndexFintype d N r q
  rw [LinearEquiv.finrank_eq
    (weightedFreeComponentRangeEquiv K r q)]
  rw [weightedFlatComponent_range_eq_supported]
  exact finrank_finsupp_supported_eq_card K _

noncomputable def linearEquivRangeOfCommute
    (K : Type u) [Field K]
    {M P : Type*} [AddCommMonoid M] [Module K M]
    [AddCommMonoid P] [Module K P]
    (E : M ≃ₗ[K] P) (f : M →ₗ[K] M) (g : P →ₗ[K] P)
    (h : ∀ x, E (f x) = g (E x)) :
    LinearMap.range f ≃ₗ[K] LinearMap.range g where
  toFun x := ⟨E x.1, by
    rcases x.2 with ⟨y, hy⟩
    refine ⟨E y, ?_⟩
    rw [← h]
    exact congrArg E hy⟩
  invFun z := ⟨E.symm z.1, by
    rcases z.2 with ⟨y, hy⟩
    refine ⟨E.symm y, ?_⟩
