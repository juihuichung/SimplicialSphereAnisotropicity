section

/-!
# Universal affine subdivision chains

Affine simplices are stored by their ordered vertex tuples.  Their continuous
realizations are obtained by barycentric interpolation.  This presentation
makes deletion and coning finite combinatorial operations while retaining the
canonical term lists needed by the adaptive small-chain construction.
-/

noncomputable section

open scoped BigOperators

namespace SimplicialSphereAnisotropicity.Topology

open Finset

universe v

namespace StdSimplex

/-- A finite barycentric combination of points of a standard simplex. -/
def barycenter {X A : Type*} [Fintype X] [Fintype A]
    (p : A → stdSimplex ℝ X) (w : A → ℝ)
    (hw₀ : ∀ a, 0 ≤ w a) (hw₁ : ∑ a, w a = 1) :
    stdSimplex ℝ X :=
  ⟨fun x ↦ ∑ a, w a * p a x,
    fun x ↦ Finset.sum_nonneg
      (fun a _ ↦ mul_nonneg (hw₀ a) ((p a).2.1 x)), by
      rw [Finset.sum_comm]
      calc
        ∑ a, ∑ x, w a * p a x = ∑ a, w a * ∑ x, p a x := by
          congr 1
          funext a
          rw [Finset.mul_sum]
        _ = ∑ a, w a := by simp
        _ = 1 := hw₁⟩

@[simp]
theorem barycenter_apply {X A : Type*} [Fintype X] [Fintype A]
    (p : A → stdSimplex ℝ X) (w : A → ℝ)
    (hw₀ : ∀ a, 0 ≤ w a) (hw₁ : ∑ a, w a = 1) (x : X) :
    barycenter p w hw₀ hw₁ x = ∑ a, w a * p a x := rfl

/-- The equally weighted barycenter of a nonempty finite tuple. -/
def isobarycenter {X A : Type*} [Fintype X] [Fintype A]
    [Nonempty A] (p : A → stdSimplex ℝ X) : stdSimplex ℝ X :=
  barycenter p (fun _ ↦ 1 / Fintype.card A) (fun _ ↦ by positivity) (by simp)

/-- Barycentric interpolation of an ordered tuple of simplex points. -/
def affineMap {X A : Type*} [Fintype X] [Fintype A]
    (p : A → stdSimplex ℝ X) :
    stdSimplex ℝ A → stdSimplex ℝ X :=
  fun t ↦ barycenter p t t.2.1 t.2.2

@[simp]
theorem affineMap_apply {X A : Type*} [Fintype X] [Fintype A]
    (p : A → stdSimplex ℝ X) (t : stdSimplex ℝ A) (x : X) :
    affineMap p t x = ∑ a, t a * p a x := rfl

theorem continuous_affineMap {X A : Type*} [Fintype X] [Fintype A]
    (p : A → stdSimplex ℝ X) : Continuous (affineMap p) := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro x
  apply continuous_finsetSum
  intro a _
  exact ((continuous_apply a).comp continuous_subtype_val).mul continuous_const

@[simp]
theorem affineMap_vertex {X A : Type*} [Fintype X] [Fintype A]
    [DecidableEq A] (p : A → stdSimplex ℝ X) (a : A) :
    affineMap p (stdSimplex.vertex a) = p a := by
  apply Subtype.ext
  funext x
  change (∑ a', (stdSimplex.vertex a : stdSimplex ℝ A) a' * p a' x) = p a x
  rw [Finset.sum_eq_single (a := a)]
  all_goals aesop

end StdSimplex

/-- An affine `r`-simplex in the standard `q`-simplex, represented by its
`r+1` ordered vertices. -/
abbrev AffineSimplex (q r : ℕ) :=
  Fin (r + 1) → stdSimplex ℝ (Fin (q + 1))

/-- Continuous realization of an affine simplex. -/
def AffineSimplex.realize {q r : ℕ} (p : AffineSimplex q r) :
    C(stdSimplex ℝ (Fin (r + 1)), stdSimplex ℝ (Fin (q + 1))) :=
  ⟨StdSimplex.affineMap p, StdSimplex.continuous_affineMap p⟩

@[simp]
theorem AffineSimplex.realize_vertex {q r : ℕ}
    (p : AffineSimplex q r) (i : Fin (r + 1)) :
    p.realize (stdSimplex.vertex i) = p i :=
  StdSimplex.affineMap_vertex p i

/-- Delete one ordered vertex. -/
def AffineSimplex.face {q r : ℕ} (p : AffineSimplex q (r + 1))
    (i : Fin (r + 2)) : AffineSimplex q r :=
  fun j ↦ p (i.succAbove j)

/-- Prepend a cone vertex. -/
def AffineSimplex.cone {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (p : AffineSimplex q r) :
    AffineSimplex q (r + 1) :=
  Fin.cases b p

@[simp]
theorem AffineSimplex.cone_zero {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (p : AffineSimplex q r) :
    p.cone b 0 = b := rfl

@[simp]
theorem AffineSimplex.cone_succ {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (p : AffineSimplex q r)
    (i : Fin (r + 1)) :
    p.cone b i.succ = p i := rfl

@[simp]
theorem AffineSimplex.face_cone_zero {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (p : AffineSimplex q r) :
    (p.cone b).face 0 = p := by
  funext i
  rfl

@[simp]
theorem AffineSimplex.face_cone_succ {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1)))
    (p : AffineSimplex q (r + 1)) (i : Fin (r + 2)) :
    (p.cone b).face i.succ = (p.face i).cone b := by
  funext j
  refine Fin.cases ?_ (fun k ↦ ?_) j
  · simp [AffineSimplex.face]
  · simp [AffineSimplex.face]

@[simp]
theorem AffineSimplex.face_cone_one {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (p : AffineSimplex q 0) :
    (p.cone b).face 1 = fun _ ↦ b := by
  funext j
  fin_cases j
  rfl

abbrev AffineChain (K : Type v) [Semiring K] (q r : ℕ) :=
  AffineSimplex q r →₀ K

/-- Unsigned boundary of one affine simplex. -/
def affineBoundaryOn (K : Type v) [Field K] {q : ℕ} (r : ℕ)
    (p : AffineSimplex q (r + 1)) : AffineChain K q r :=
  ∑ i : Fin (r + 2), Finsupp.single (p.face i) 1

/-- Unsigned affine boundary, used over characteristic two. -/
def affineBoundary (K : Type v) [Field K] (q r : ℕ) :
    AffineChain K q (r + 1) →ₗ[K] AffineChain K q r :=
  Finsupp.linearCombination K (affineBoundaryOn K r)

@[simp]
theorem affineBoundary_single (K : Type v) [Field K] {q : ℕ} (r : ℕ)
    (p : AffineSimplex q (r + 1)) (a : K) :
    affineBoundary K q r (Finsupp.single p a) =
      a • affineBoundaryOn K r p := by
  exact Finsupp.linearCombination_single K a p

abbrev AffineDeletionPair (r : ℕ) :=
  Σ _i : Fin (r + 3), Fin (r + 2)

/-- Swap the order of two distinct vertex deletions. -/
def swapAffineDeletionPair (r : ℕ) :
    AffineDeletionPair r → AffineDeletionPair r
  | ⟨i, j⟩ => ⟨i.succAbove j, j.predAbove i⟩

theorem swapAffineDeletionPair_ne (r : ℕ) (p : AffineDeletionPair r) :
    swapAffineDeletionPair r p ≠ p := by
  rintro h
  have hi := congrArg (fun z : AffineDeletionPair r ↦ z.1) h
  exact Fin.succAbove_ne p.1 p.2 hi

theorem swapAffineDeletionPair_involutive (r : ℕ)
    (p : AffineDeletionPair r) :
    swapAffineDeletionPair r (swapAffineDeletionPair r p) = p := by
  rcases p with ⟨i, j⟩
  apply Sigma.ext
  · exact Fin.succAbove_succAbove_predAbove i j
  · exact heq_of_eq (Fin.predAbove_predAbove_succAbove i j)

theorem AffineSimplex.face_face_swap {q r : ℕ}
    (p : AffineSimplex q (r + 2)) (z : AffineDeletionPair r) :
    (p.face (swapAffineDeletionPair r z).1).face
        (swapAffineDeletionPair r z).2 =
      (p.face z.1).face z.2 := by
  rcases z with ⟨i, j⟩
  funext k
  exact congrArg p
    (Fin.succAbove_succAbove_succAbove_predAbove i j k)

def affineDeletionPairTerm (K : Type v) [Field K] {q r : ℕ}
    (p : AffineSimplex q (r + 2)) (z : AffineDeletionPair r) :
    AffineChain K q r :=
  Finsupp.single ((p.face z.1).face z.2) 1

theorem affineDeletionPairTerm_swap (K : Type v) [Field K] {q r : ℕ}
    (p : AffineSimplex q (r + 2)) (z : AffineDeletionPair r) :
    affineDeletionPairTerm K p (swapAffineDeletionPair r z) =
      affineDeletionPairTerm K p z := by
  apply congrArg (fun s : AffineSimplex q r ↦ Finsupp.single s (1 : K))
  exact p.face_face_swap z

theorem affineBoundary_boundary_single (K : Type v) [Field K] [CharP K 2]
    {q : ℕ} (r : ℕ) (p : AffineSimplex q (r + 2)) :
    affineBoundary K q r
        (affineBoundary K q (r + 1) (Finsupp.single p 1)) = 0 := by
  simp only [affineBoundary_single, one_smul, affineBoundaryOn, map_sum]
  change (∑ i : Fin (r + 3), ∑ j : Fin (r + 2),
    affineDeletionPairTerm K p ⟨i, j⟩) = 0
  rw [← Fintype.sum_sigma (fun z : AffineDeletionPair r ↦
    affineDeletionPairTerm K p z)]
  let term : AffineDeletionPair r → AffineChain K q r :=
    affineDeletionPairTerm K p
  have hcancel : ∀ z : AffineDeletionPair r,
      term z + term (swapAffineDeletionPair r z) = 0 := by
    intro z
    change affineDeletionPairTerm K p z +
      affineDeletionPairTerm K p (swapAffineDeletionPair r z) = 0
    rw [affineDeletionPairTerm_swap]
    let x : AffineChain K q r := affineDeletionPairTerm K p z
    calc
      x + x = (1 : K) • x + (1 : K) • x := by simp
      _ = ((1 : K) + 1) • x := by rw [add_smul]
      _ = 0 := by rw [CharTwo.add_self_eq_zero, zero_smul]
  simpa [term, affineDeletionPairTerm] using
    (Finset.sum_involution (s := Finset.univ) (f := term)
      (fun z _ ↦ swapAffineDeletionPair r z)
      (fun z _ ↦ hcancel z)
      (fun z _ _ ↦ swapAffineDeletionPair_ne r z)
      (fun _ _ ↦ Finset.mem_univ _)
      (fun z _ ↦ swapAffineDeletionPair_involutive r z))

theorem affineBoundary_boundary_on (K : Type v) [Field K] [CharP K 2]
    {q : ℕ} (r : ℕ) (p : AffineSimplex q (r + 2)) :
    affineBoundary K q r (affineBoundaryOn K (r + 1) p) = 0 := by
  simpa only [affineBoundary_single, one_smul] using
    affineBoundary_boundary_single K r p

theorem affineBoundary_boundary (K : Type v) [Field K] [CharP K 2]
    (q r : ℕ) :
    (affineBoundary K q r).comp (affineBoundary K q (r + 1)) = 0 := by
  apply Finsupp.lhom_ext
  intro p a
  simp only [LinearMap.comp_apply, affineBoundary_single, map_smul,
    affineBoundary_boundary_on, smul_zero, LinearMap.zero_apply]

/-- Cone an affine chain at `b`. -/
def affineCone (K : Type v) [Field K] {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (r : ℕ) :
    AffineChain K q r →ₗ[K] AffineChain K q (r + 1) :=
  Finsupp.linearCombination K
    (fun p ↦ Finsupp.single (p.cone b) 1)

@[simp]
theorem affineCone_single (K : Type v) [Field K] {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (r : ℕ)
    (p : AffineSimplex q r) (a : K) :
    affineCone K b r (Finsupp.single p a) =
      a • Finsupp.single (p.cone b) 1 := by
  exact Finsupp.linearCombination_single K a p

theorem affineBoundaryOn_cone (K : Type v) [Field K] {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1)))
    (p : AffineSimplex q (r + 1)) :
    affineBoundaryOn K (r + 1) (p.cone b) =
      Finsupp.single p 1 + affineCone K b r (affineBoundaryOn K r p) := by
  rw [affineBoundaryOn, Fin.sum_univ_succ]
  simp only [AffineSimplex.face_cone_zero, affineBoundaryOn, map_sum,
    affineCone_single, one_smul, AffineSimplex.face_cone_succ]

/-- The unsigned cone identity in positive dimension. -/
theorem affineBoundary_cone (K : Type v) [Field K] {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (c : AffineChain K q (r + 1)) :
    affineBoundary K q (r + 1) (affineCone K b (r + 1) c) =
      c + affineCone K b r (affineBoundary K q r c) := by
  have hmap :
      (affineBoundary K q (r + 1)).comp (affineCone K b (r + 1)) =
        LinearMap.id + (affineCone K b r).comp (affineBoundary K q r) := by
    apply Finsupp.lhom_ext
    intro p a
    simp only [LinearMap.comp_apply, affineCone_single, map_smul,
      affineBoundary_single, affineBoundaryOn_cone, smul_add,
      LinearMap.add_apply, LinearMap.id_apply]
    simp
  exact LinearMap.congr_fun hmap c

/-- Sum of the coefficients of an affine zero-chain. -/
def affineChainAugmentation (K : Type v) [Field K] (q : ℕ) :
    AffineChain K q 0 →ₗ[K] K :=
  Finsupp.linearCombination K (fun _ ↦ (1 : K))

@[simp]
theorem affineChainAugmentation_single (K : Type v) [Field K] (q : ℕ)
    (p : AffineSimplex q 0) (a : K) :
    affineChainAugmentation K q (Finsupp.single p a) = a := by
  simp [affineChainAugmentation]

theorem affineChainAugmentation_eq_sum (K : Type v) [Field K] (q : ℕ)
    (c : AffineChain K q 0) :
    affineChainAugmentation K q c = Finsupp.sum c (fun _ a ↦ a) := by
  rw [affineChainAugmentation, Finsupp.linearCombination_apply]
  apply Finsupp.sum_congr
  intro p
  simp

/-- Insert a fixed constant vertex with a prescribed coefficient. -/
def affineConstantVertexMap (K : Type v) [Field K] {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) : K →ₗ[K] AffineChain K q 0 :=
  LinearMap.toSpanSingleton K (AffineChain K q 0)
    (Finsupp.single (fun _ : Fin 1 ↦ b) (1 : K))

@[simp]
theorem affineConstantVertexMap_apply (K : Type v) [Field K] {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (a : K) :
    affineConstantVertexMap K b a = a • Finsupp.single (fun _ ↦ b) 1 := rfl

/-- At the bottom, the boundary of a coned vertex consists of its two
endpoints. -/
theorem affineBoundary_cone_zero (K : Type v) [Field K] {q : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (c : AffineChain K q 0) :
    affineBoundary K q 0 (affineCone K b 0 c) =
      c + (Finsupp.sum c fun _ a ↦ a) • Finsupp.single (fun _ ↦ b) 1 := by
  rw [← affineChainAugmentation_eq_sum]
  have hmap :
      (affineBoundary K q 0).comp (affineCone K b 0) =
        LinearMap.id +
          (affineConstantVertexMap K b).comp (affineChainAugmentation K q) := by
    apply Finsupp.lhom_ext
    intro p a
    simp only [LinearMap.comp_apply, affineCone_single, map_smul,
      affineBoundary_single]
    rw [affineBoundaryOn, Fin.sum_univ_two]
    simp [AffineSimplex.face_cone_zero, AffineSimplex.face_cone_one,
      affineChainAugmentation_single, affineConstantVertexMap_apply,
      LinearMap.add_apply]
  exact LinearMap.congr_fun hmap c

/-- Barycenter of the ordered vertices of an affine simplex. -/
def AffineSimplex.barycenter {q r : ℕ} (p : AffineSimplex q r) :
    stdSimplex ℝ (Fin (q + 1)) :=
  StdSimplex.isobarycenter p

/-- Canonical uncollected list of the terms in one barycentric subdivision.
Keeping this list separate from the collected `Finsupp` chain prevents
cancellation from corrupting the later smallness predicate. -/
def affineSubdivisionTermList {q : ℕ} :
    (r : ℕ) → AffineSimplex q r → List (AffineSimplex q r)
  | 0, p => [p]
  | r + 1, p =>
      ((List.ofFn fun i : Fin (r + 2) ↦
        affineSubdivisionTermList r (p.face i)).flatten).map
          (AffineSimplex.cone p.barycenter)

/-- One barycentric subdivision of a basis affine simplex, with equal
coefficient `1` on the canonical recursive terms. -/
def affineSubdivisionOn (K : Type v) [Field K] {q : ℕ} :
    (r : ℕ) → AffineSimplex q r → AffineChain K q r
  | 0, p => Finsupp.single p 1
  | r + 1, p =>
      affineCone K p.barycenter r
        (∑ i : Fin (r + 2), affineSubdivisionOn K r (p.face i))

/-- Linear barycentric subdivision in a fixed ambient standard simplex. -/
def affineSubdivision (K : Type v) [Field K] (q r : ℕ) :
    AffineChain K q r →ₗ[K] AffineChain K q r :=
  Finsupp.linearCombination K (affineSubdivisionOn K r)

@[simp]
theorem affineSubdivision_single (K : Type v) [Field K] {q : ℕ} (r : ℕ)
    (p : AffineSimplex q r) (a : K) :
    affineSubdivision K q r (Finsupp.single p a) =
      a • affineSubdivisionOn K r p := by
  exact Finsupp.linearCombination_single K a p

@[simp]
theorem affineSubdivision_zero (K : Type v) [Field K] (q : ℕ) :
    affineSubdivision K q 0 = LinearMap.id := by
  apply Finsupp.lhom_ext
  intro p a
  simp [affineSubdivisionOn]

theorem affineChainAugmentation_boundaryOn_zero
    (K : Type v) [Field K] [CharP K 2] {q : ℕ}
    (p : AffineSimplex q 1) :
    affineChainAugmentation K q (affineBoundaryOn K 0 p) = 0 := by
  rw [affineBoundaryOn, Fin.sum_univ_two]
  simp
  exact CharTwo.add_self_eq_zero (1 : K)

theorem affineSubdivision_boundaryOn (K : Type v) [Field K] {q r : ℕ}
    (p : AffineSimplex q (r + 1)) :
    affineSubdivision K q r (affineBoundaryOn K r p) =
      ∑ i : Fin (r + 2), affineSubdivisionOn K r (p.face i) := by
  simp only [affineBoundaryOn, map_sum, affineSubdivision_single, one_smul]

theorem affineBoundary_subdivisionOn (K : Type v) [Field K] [CharP K 2]
    {q : ℕ} : ∀ (r : ℕ) (p : AffineSimplex q (r + 1)),
      affineBoundary K q r (affineSubdivisionOn K (r + 1) p) =
        affineSubdivision K q r (affineBoundaryOn K r p) := by
  intro r
  induction r with
  | zero =>
      intro p
      rw [affineSubdivisionOn, ← affineSubdivision_boundaryOn,
        affineSubdivision_zero, LinearMap.id_apply, affineBoundary_cone_zero,
        ← affineChainAugmentation_eq_sum,
        affineChainAugmentation_boundaryOn_zero]
      simp
  | succ r ih =>
      intro p
      rw [affineSubdivisionOn, affineBoundary_cone]
      have hz : affineBoundary K q r
          (∑ i : Fin (r + 3), affineSubdivisionOn K (r + 1) (p.face i)) = 0 := by
        rw [map_sum]
        simp_rw [ih]
        rw [← map_sum]
        have hbb : (∑ i : Fin (r + 3),
            affineBoundaryOn K r (p.face i)) = 0 := by
          have h := affineBoundary_boundary_on K r p
          rw [affineBoundaryOn, map_sum] at h
          simpa only [affineBoundary_single, one_smul] using h
        rw [hbb, map_zero]
      rw [hz, map_zero]
      simp [affineSubdivision_boundaryOn]

/-- Barycentric subdivision commutes with the unsigned boundary in
characteristic two. -/
theorem affineBoundary_comp_subdivision
    (K : Type v) [Field K] [CharP K 2] (q r : ℕ) :
    (affineBoundary K q r).comp (affineSubdivision K q (r + 1)) =
      (affineSubdivision K q r).comp (affineBoundary K q r) := by
  apply Finsupp.lhom_ext
  intro p a
  simp only [LinearMap.comp_apply, affineSubdivision_single, map_smul,
    affineBoundary_single, affineBoundary_subdivisionOn]

@[simp]
theorem AffineSimplex.barycenter_zero {q : ℕ} (p : AffineSimplex q 0) :
    p.barycenter = p 0 := by
  apply Subtype.ext
  funext x
  change (∑ i : Fin 1, (1 / Fintype.card (Fin 1) : ℝ) * p i x) = p 0 x
  simp

theorem AffineSimplex.const_barycenter_zero {q : ℕ}
    (p : AffineSimplex q 0) : (fun _ : Fin 1 ↦ p.barycenter) = p := by
  funext i
  fin_cases i
  simp

/-- Canonical uncollected terms of the subdivision prism. -/
def affinePrismTermList {q : ℕ} :
    (r : ℕ) → AffineSimplex q r → List (AffineSimplex q (r + 1))
  | 0, p => [(p.cone p.barycenter)]
  | r + 1, p =>
      (p :: (List.ofFn fun i : Fin (r + 2) ↦
        affinePrismTermList r (p.face i)).flatten).map
          (AffineSimplex.cone p.barycenter)

/-- Prism on a basis affine simplex, recursively coned at its barycenter. -/
def affinePrismOn (K : Type v) [Field K] {q : ℕ} :
    (r : ℕ) → AffineSimplex q r → AffineChain K q (r + 1)
  | 0, p => affineCone K p.barycenter 0 (Finsupp.single p 1)
  | r + 1, p =>
      affineCone K p.barycenter (r + 1)
        (Finsupp.single p 1 +
          ∑ i : Fin (r + 2), affinePrismOn K r (p.face i))

/-- Linear subdivision prism in a fixed ambient standard simplex. -/
def affinePrism (K : Type v) [Field K] (q r : ℕ) :
    AffineChain K q r →ₗ[K] AffineChain K q (r + 1) :=
  Finsupp.linearCombination K (affinePrismOn K r)

@[simp]
theorem affinePrism_single (K : Type v) [Field K] {q : ℕ} (r : ℕ)
    (p : AffineSimplex q r) (a : K) :
    affinePrism K q r (Finsupp.single p a) =
      a • affinePrismOn K r p := by
  exact Finsupp.linearCombination_single K a p

theorem affinePrism_boundaryOn (K : Type v) [Field K] {q r : ℕ}
    (p : AffineSimplex q (r + 1)) :
    affinePrism K q r (affineBoundaryOn K r p) =
      ∑ i : Fin (r + 2), affinePrismOn K r (p.face i) := by
  simp only [affineBoundaryOn, map_sum, affinePrism_single, one_smul]

theorem affineBoundary_prismOn_zero
    (K : Type v) [Field K] [CharP K 2] {q : ℕ}
    (p : AffineSimplex q 0) :
    affineBoundary K q 0 (affinePrismOn K 0 p) =
      Finsupp.single p 1 + affineSubdivisionOn K 0 p := by
  rw [affinePrismOn, affineBoundary_cone_zero,
    ← affineChainAugmentation_eq_sum,
    AffineSimplex.const_barycenter_zero]
  simp [affineSubdivisionOn]

theorem charTwo_module_add_self_eq_zero
    (K : Type v) [Field K] [CharP K 2]
    {M : Type*} [AddCommMonoid M] [Module K M] (x : M) :
    x + x = 0 := by
  calc
    x + x = (1 : K) • x + (1 : K) • x := by simp
    _ = ((1 : K) + 1) • x := by rw [add_smul]
    _ = 0 := by rw [CharTwo.add_self_eq_zero, zero_smul]

/-- The `T∂` term in the prism identity, with the degree-zero endpoint set to
zero. -/
def affinePrismBoundaryPart (K : Type v) [Field K] {q : ℕ} :
    (r : ℕ) → AffineSimplex q r → AffineChain K q r
  | 0, _ => 0
  | r + 1, p => affinePrism K q r (affineBoundaryOn K r p)

@[simp]
theorem affinePrismBoundaryPart_zero (K : Type v) [Field K] {q : ℕ}
    (p : AffineSimplex q 0) : affinePrismBoundaryPart K 0 p = 0 := rfl

@[simp]
theorem affinePrismBoundaryPart_succ (K : Type v) [Field K] {q : ℕ}
    (r : ℕ) (p : AffineSimplex q (r + 1)) :
    affinePrismBoundaryPart K (r + 1) p =
      affinePrism K q r (affineBoundaryOn K r p) := rfl

/-- Generator form of `∂T + T∂ = 1 + S`. -/
theorem affinePrism_identity_on
    (K : Type v) [Field K] [CharP K 2] {q : ℕ} :
    ∀ (r : ℕ) (p : AffineSimplex q r),
      affineBoundary K q r (affinePrismOn K r p) +
          affinePrismBoundaryPart K r p =
        Finsupp.single p 1 + affineSubdivisionOn K r p := by
  intro r
  induction r with
  | zero =>
      intro p
      simpa using affineBoundary_prismOn_zero K p
  | succ r ih =>
      intro p
      let A : AffineChain K q (r + 1) :=
        ∑ i : Fin (r + 2), affinePrismOn K r (p.face i)
      let B : AffineChain K q r :=
        ∑ i : Fin (r + 2), affineSubdivisionOn K r (p.face i)
      have hcorr :
          (∑ i : Fin (r + 2),
            affinePrismBoundaryPart K r (p.face i)) = 0 := by
        rcases r with _ | r
        · simp
        · simp only [affinePrismBoundaryPart_succ]
          rw [← map_sum]
          have hbb : (∑ i : Fin (r + 3),
              affineBoundaryOn K r (p.face i)) = 0 := by
            have h := affineBoundary_boundary_on K r p
            rw [affineBoundaryOn, map_sum] at h
            simpa only [affineBoundary_single, one_smul] using h
          rw [hbb, map_zero]
      have hfaces : affineBoundary K q r A =
          affineBoundaryOn K r p + B := by
        have hsum : affineBoundary K q r A +
              (∑ i : Fin (r + 2),
                affinePrismBoundaryPart K r (p.face i)) =
            affineBoundaryOn K r p + B := by
          dsimp only [A, B]
          rw [map_sum, ← Finset.sum_add_distrib]
          simp_rw [ih]
          rw [Finset.sum_add_distrib]
          rfl
        rw [hcorr, add_zero] at hsum
        exact hsum
      have hdinside : affineBoundary K q r
          (Finsupp.single p 1 + A) = B := by
        rw [map_add, affineBoundary_single, one_smul, hfaces]
        calc
          affineBoundaryOn K r p + (affineBoundaryOn K r p + B) =
              (affineBoundaryOn K r p + affineBoundaryOn K r p) + B := by
                rw [add_assoc]
          _ = B := by
            rw [charTwo_module_add_self_eq_zero K (affineBoundaryOn K r p),
              zero_add]
      rw [affinePrismOn, affineBoundary_cone,
        affinePrismBoundaryPart_succ, affinePrism_boundaryOn]
      change (Finsupp.single p 1 + A +
          affineCone K p.barycenter r
            (affineBoundary K q r (Finsupp.single p 1 + A))) + A =
        Finsupp.single p 1 + affineCone K p.barycenter r B
      rw [hdinside]
      calc
        (Finsupp.single p 1 + A + affineCone K p.barycenter r B) + A =
            Finsupp.single p 1 + (A + A) +
              affineCone K p.barycenter r B := by abel
        _ = Finsupp.single p 1 + affineCone K p.barycenter r B := by
          rw [charTwo_module_add_self_eq_zero K A, add_zero]

/-- The linear `T∂` correction, zero in ordinary degree zero. -/
def affinePrismBoundaryMap (K : Type v) [Field K] (q : ℕ) :
    (r : ℕ) → AffineChain K q r →ₗ[K] AffineChain K q r
  | 0 => 0
  | r + 1 => (affinePrism K q r).comp (affineBoundary K q r)

@[simp]
theorem affinePrismBoundaryMap_single (K : Type v) [Field K]
    {q : ℕ} (r : ℕ) (p : AffineSimplex q r) (a : K) :
    affinePrismBoundaryMap K q r (Finsupp.single p a) =
      a • affinePrismBoundaryPart K r p := by
  rcases r with _ | r
  · simp [affinePrismBoundaryMap, affinePrismBoundaryPart]
  · simp [affinePrismBoundaryMap, affinePrismBoundaryPart]

/-- Linear universal prism identity. -/
theorem affinePrism_identity
    (K : Type v) [Field K] [CharP K 2] (q r : ℕ) :
    (affineBoundary K q r).comp (affinePrism K q r) +
        affinePrismBoundaryMap K q r =
      LinearMap.id + affineSubdivision K q r := by
  apply Finsupp.lhom_ext
  intro p a
  simp only [LinearMap.add_apply, LinearMap.comp_apply, affinePrism_single,
    map_smul, affinePrismBoundaryMap_single,
    LinearMap.id_apply, affineSubdivision_single]
  rw [← smul_add, affinePrism_identity_on, smul_add,
    Finsupp.smul_single_one]

/-- Collect a canonical list of affine simplices into a `Finsupp` chain. -/
def affineChainOfList (K : Type v) [Field K] {q r : ℕ}
    (l : List (AffineSimplex q r)) : AffineChain K q r :=
  (l.map fun p ↦ Finsupp.single p 1).sum

@[simp]
theorem affineChainOfList_nil (K : Type v) [Field K] {q r : ℕ} :
    affineChainOfList K ([] : List (AffineSimplex q r)) = 0 := rfl

@[simp]
theorem affineChainOfList_cons (K : Type v) [Field K] {q r : ℕ}
    (p : AffineSimplex q r) (l : List (AffineSimplex q r)) :
    affineChainOfList K (p :: l) =
      Finsupp.single p 1 + affineChainOfList K l := by
  simp [affineChainOfList]

@[simp]
theorem affineChainOfList_append (K : Type v) [Field K] {q r : ℕ}
    (l₁ l₂ : List (AffineSimplex q r)) :
    affineChainOfList K (l₁ ++ l₂) =
      affineChainOfList K l₁ + affineChainOfList K l₂ := by
  simp [affineChainOfList, List.map_append]

theorem affineChainOfList_map_cone (K : Type v) [Field K] {q r : ℕ}
    (b : stdSimplex ℝ (Fin (q + 1))) (l : List (AffineSimplex q r)) :
    affineChainOfList K (l.map (AffineSimplex.cone b)) =
      affineCone K b r (affineChainOfList K l) := by
  induction l with
  | nil => simp
  | cons p l ih =>
      simp [ih]

theorem affineChainOfList_flatten (K : Type v) [Field K] {q r : ℕ}
    (l : List (List (AffineSimplex q r))) :
    affineChainOfList K l.flatten =
      (l.map (affineChainOfList K)).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

theorem affineChainOfList_subdivisionTermList
    (K : Type v) [Field K] {q : ℕ} :
    ∀ (r : ℕ) (p : AffineSimplex q r),
      affineChainOfList K (affineSubdivisionTermList r p) =
        affineSubdivisionOn K r p := by
  intro r
  induction r with
  | zero => intro p; simp [affineSubdivisionTermList, affineSubdivisionOn]
  | succ r ih =>
      intro p
      rw [affineSubdivisionTermList, affineChainOfList_map_cone,
        affineChainOfList_flatten]
      simp only [List.map_ofFn, List.sum_ofFn, Function.comp_apply, ih,
        affineSubdivisionOn]

theorem affineChainOfList_prismTermList
    (K : Type v) [Field K] {q : ℕ} :
    ∀ (r : ℕ) (p : AffineSimplex q r),
      affineChainOfList K (affinePrismTermList r p) =
        affinePrismOn K r p := by
  intro r
  induction r with
  | zero =>
      intro p
      simp [affinePrismTermList, affinePrismOn]
  | succ r ih =>
      intro p
      rw [affinePrismTermList, affineChainOfList_map_cone,
        affineChainOfList_cons, affineChainOfList_flatten]
      simp only [List.map_ofFn, List.sum_ofFn, Function.comp_apply, ih,
        affinePrismOn]

/-! ## Iterated subdivision and the telescoped prism -/

/-- The `N`-fold iterate of universal affine subdivision. -/
def affineSubdivisionIter (K : Type v) [Field K] (q r : ℕ) :
    ℕ → AffineChain K q r →ₗ[K] AffineChain K q r
  | 0 => LinearMap.id
  | N + 1 =>
      (affineSubdivision K q r).comp (affineSubdivisionIter K q r N)

@[simp]
theorem affineSubdivisionIter_zero (K : Type v) [Field K] (q r : ℕ) :
    affineSubdivisionIter K q r 0 = LinearMap.id := rfl

@[simp]
theorem affineSubdivisionIter_succ (K : Type v) [Field K]
    (q r N : ℕ) :
    affineSubdivisionIter K q r (N + 1) =
      (affineSubdivision K q r).comp (affineSubdivisionIter K q r N) := rfl

/-- Every iterate of subdivision commutes with the unsigned boundary. -/
theorem affineBoundary_comp_subdivisionIter
    (K : Type v) [Field K] [CharP K 2] (q r N : ℕ) :
    (affineBoundary K q r).comp
        (affineSubdivisionIter K q (r + 1) N) =
      (affineSubdivisionIter K q r N).comp (affineBoundary K q r) := by
  induction N with
  | zero =>
      apply LinearMap.ext
      intro c
      rfl
  | succ N ih =>
      apply LinearMap.ext
      intro c
      change affineBoundary K q r
          (affineSubdivision K q (r + 1)
            (affineSubdivisionIter K q (r + 1) N c)) =
        affineSubdivision K q r
          (affineSubdivisionIter K q r N (affineBoundary K q r c))
      have hstep := LinearMap.congr_fun
        (affineBoundary_comp_subdivision K q r)
        (affineSubdivisionIter K q (r + 1) N c)
      have hiter := LinearMap.congr_fun ih c
      change affineBoundary K q r
          (affineSubdivision K q (r + 1)
            (affineSubdivisionIter K q (r + 1) N c)) =
        affineSubdivision K q r
          (affineBoundary K q r
            (affineSubdivisionIter K q (r + 1) N c)) at hstep
      change affineBoundary K q r
          (affineSubdivisionIter K q (r + 1) N c) =
        affineSubdivisionIter K q r N (affineBoundary K q r c) at hiter
      rw [hstep, hiter]

/-- The canonical uncollected terms after `N` subdivisions. -/
def affineSubdivisionTermListIter {q : ℕ} (r : ℕ) :
    ℕ → AffineSimplex q r → List (AffineSimplex q r)
  | 0, p => [p]
  | N + 1, p =>
      (affineSubdivisionTermListIter r N p).flatMap
        (affineSubdivisionTermList r)

@[simp]
theorem affineSubdivisionTermListIter_zero {q r : ℕ}
    (p : AffineSimplex q r) :
    affineSubdivisionTermListIter r 0 p = [p] := rfl

@[simp]
theorem affineSubdivisionTermListIter_succ {q r N : ℕ}
    (p : AffineSimplex q r) :
    affineSubdivisionTermListIter r (N + 1) p =
      (affineSubdivisionTermListIter r N p).flatMap
        (affineSubdivisionTermList r) := rfl

theorem affineChainOfList_flatMap_subdivision
    (K : Type v) [Field K] {q r : ℕ}
    (l : List (AffineSimplex q r)) :
    affineChainOfList K
        (l.flatMap (affineSubdivisionTermList r)) =
      affineSubdivision K q r (affineChainOfList K l) := by
  induction l with
  | nil => simp
  | cons p l ih =>
      simp [ih, affineChainOfList_subdivisionTermList]

/-- Collecting the canonical iterated term list gives the iterated affine
subdivision chain. -/
theorem affineChainOfList_subdivisionTermListIter
    (K : Type v) [Field K] {q r : ℕ} (N : ℕ)
    (p : AffineSimplex q r) :
    affineChainOfList K (affineSubdivisionTermListIter r N p) =
      affineSubdivisionIter K q r N (Finsupp.single p 1) := by
  induction N with
  | zero => simp [affineChainOfList, affineSubdivisionTermListIter,
      affineSubdivisionIter]
  | succ N ih =>
      rw [affineSubdivisionTermListIter_succ,
        affineChainOfList_flatMap_subdivision, ih]
      rfl

/-- The finite prism sum `D_N = T + T S + ... + T S^(N-1)`. -/
def affineIteratedPrism (K : Type v) [Field K] (q r : ℕ) :
    ℕ → AffineChain K q r →ₗ[K] AffineChain K q (r + 1)
  | 0 => 0
  | N + 1 =>
      affineIteratedPrism K q r N +
        (affinePrism K q r).comp (affineSubdivisionIter K q r N)

@[simp]
theorem affineIteratedPrism_zero (K : Type v) [Field K] (q r : ℕ) :
    affineIteratedPrism K q r 0 = 0 := rfl

@[simp]
theorem affineIteratedPrism_succ (K : Type v) [Field K]
    (q r N : ℕ) :
    affineIteratedPrism K q r (N + 1) =
      affineIteratedPrism K q r N +
        (affinePrism K q r).comp (affineSubdivisionIter K q r N) := rfl

/-- The lower-degree `D_N ∂` term, zero in ordinary degree zero. -/
def affineIteratedPrismBoundaryMap (K : Type v) [Field K] (q : ℕ)
    (N : ℕ) : (r : ℕ) → AffineChain K q r →ₗ[K] AffineChain K q r
  | 0 => 0
  | r + 1 =>
      (affineIteratedPrism K q r N).comp (affineBoundary K q r)

@[simp]
theorem affineIteratedPrismBoundaryMap_zero
    (K : Type v) [Field K] (q N : ℕ) :
    affineIteratedPrismBoundaryMap K q N 0 = 0 := rfl

@[simp]
theorem affineIteratedPrismBoundaryMap_succ_degree
    (K : Type v) [Field K] (q N r : ℕ) :
    affineIteratedPrismBoundaryMap K q N (r + 1) =
      (affineIteratedPrism K q r N).comp (affineBoundary K q r) := rfl

theorem affineIteratedPrismBoundaryMap_succ_iter
    (K : Type v) [Field K] [CharP K 2] (q r N : ℕ) :
    affineIteratedPrismBoundaryMap K q (N + 1) r =
      affineIteratedPrismBoundaryMap K q N r +
        (affinePrismBoundaryMap K q r).comp
          (affineSubdivisionIter K q r N) := by
  rcases r with _ | r
  · simp [affineIteratedPrismBoundaryMap, affinePrismBoundaryMap]
  · apply LinearMap.ext
    intro c
    change affineIteratedPrism K q r N (affineBoundary K q r c) +
        affinePrism K q r
          (affineSubdivisionIter K q r N (affineBoundary K q r c)) =
      affineIteratedPrism K q r N (affineBoundary K q r c) +
        affinePrism K q r
          (affineBoundary K q r
            (affineSubdivisionIter K q (r + 1) N c))
    have hcomm := LinearMap.congr_fun
      (affineBoundary_comp_subdivisionIter K q r N) c
    change affineBoundary K q r
        (affineSubdivisionIter K q (r + 1) N c) =
      affineSubdivisionIter K q r N (affineBoundary K q r c) at hcomm
    rw [hcomm]

/-- Telescoping the universal prism gives
`∂D_N + D_N∂ = 1 + S^N`. -/
theorem affineIteratedPrism_identity
    (K : Type v) [Field K] [CharP K 2] (q r N : ℕ) :
    (affineBoundary K q r).comp (affineIteratedPrism K q r N) +
        affineIteratedPrismBoundaryMap K q N r =
      LinearMap.id + affineSubdivisionIter K q r N := by
  induction N with
  | zero =>
      rcases r with _ | r
      · apply LinearMap.ext
        intro c
        simp [affineIteratedPrism, affineIteratedPrismBoundaryMap,
          affineSubdivisionIter, charTwo_module_add_self_eq_zero K c]
      · apply LinearMap.ext
        intro c
        simp [affineIteratedPrism, affineIteratedPrismBoundaryMap,
          affineSubdivisionIter, charTwo_module_add_self_eq_zero K c]
  | succ N ih =>
      apply LinearMap.ext
      intro c
      have hih := LinearMap.congr_fun ih c
      have hstep := LinearMap.congr_fun (affinePrism_identity K q r)
        (affineSubdivisionIter K q r N c)
      simp only [LinearMap.add_apply, LinearMap.comp_apply,
        LinearMap.id_apply] at hih hstep
      rw [affineIteratedPrism_succ,
        affineIteratedPrismBoundaryMap_succ_iter]
      simp only [LinearMap.add_apply, LinearMap.comp_apply, map_add]
      calc
        affineBoundary K q r (affineIteratedPrism K q r N c) +
              affineBoundary K q r
                (affinePrism K q r
                  (affineSubdivisionIter K q r N c)) +
            (affineIteratedPrismBoundaryMap K q N r c +
              affinePrismBoundaryMap K q r
                (affineSubdivisionIter K q r N c)) =
            (affineBoundary K q r (affineIteratedPrism K q r N c) +
              affineIteratedPrismBoundaryMap K q N r c) +
              (affineBoundary K q r
                  (affinePrism K q r
                    (affineSubdivisionIter K q r N c)) +
                affinePrismBoundaryMap K q r
                  (affineSubdivisionIter K q r N c)) := by abel
        _ = (c + affineSubdivisionIter K q r N c) +
              (affineSubdivisionIter K q r N c +
                affineSubdivision K q r
                  (affineSubdivisionIter K q r N c)) := by
              rw [hih, hstep]
        _ = c + affineSubdivision K q r
              (affineSubdivisionIter K q r N c) := by
              have hz := charTwo_module_add_self_eq_zero K
                (affineSubdivisionIter K q r N c)
              calc
                (c + affineSubdivisionIter K q r N c) +
                    (affineSubdivisionIter K q r N c +
                      affineSubdivision K q r
                        (affineSubdivisionIter K q r N c)) =
                    c + (affineSubdivisionIter K q r N c +
                      affineSubdivisionIter K q r N c) +
                        affineSubdivision K q r
                          (affineSubdivisionIter K q r N c) := by abel
                _ = c + affineSubdivision K q r
                      (affineSubdivisionIter K q r N c) := by rw [hz, add_zero]
        _ = ((LinearMap.id : AffineChain K q r →ₗ[K] AffineChain K q r) +
              affineSubdivisionIter K q r (N + 1)) c := rfl

/-! ## Affine naturality and pushforward to singular chains -/

open CategoryTheory CategoryTheory.Limits Opposite
open _root_.Simplicial
open AlgebraicTopology

namespace StdSimplex

/-- Barycentric interpolation is natural under a map of vertex sets. -/
theorem affineMap_comp_map
    {X A B : Type*} [Fintype X] [Fintype A] [Fintype B]
    (p : B → stdSimplex ℝ X) (f : A → B)
    (t : stdSimplex ℝ A) :
    affineMap (p ∘ f) t = affineMap p (stdSimplex.map f t) := by
  classical
  apply Subtype.ext
  funext x
  change (∑ a : A, t a * p (f a) x) =
    ∑ b : B, (FunOnFinite.linearMap ℝ ℝ f t) b * p b x
  simp_rw [FunOnFinite.linearMap_apply_apply]
  rw [← Finset.sum_fiberwise Finset.univ f (fun a ↦ t a * p (f a) x)]
  congr 1
  funext b
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro a ha
  have hab : f a = b := by simpa using ha
  rw [hab]

/-- Barycentric interpolation of barycentric interpolations is associative. -/
theorem affineMap_comp_affineMap
    {X A B : Type*} [Fintype X] [Fintype A] [Fintype B]
    (p : B → stdSimplex ℝ X) (g : A → stdSimplex ℝ B)
    (t : stdSimplex ℝ A) :
    affineMap (fun a ↦ affineMap p (g a)) t =
      affineMap p (affineMap g t) := by
  apply Subtype.ext
  funext x
  change (∑ a : A, t a * ∑ b : B, g a b * p b x) =
    ∑ b : B, (∑ a : A, t a * g a b) * p b x
  simp_rw [Finset.mul_sum, ← mul_assoc, Finset.sum_mul]
  rw [Finset.sum_comm]

/-- Interpolating the ordered vertex tuple is the identity map. -/
theorem affineMap_vertices
    {A : Type*} [Fintype A] [DecidableEq A]
    (t : stdSimplex ℝ A) :
    affineMap (fun a ↦ stdSimplex.vertex a) t = t := by
  apply Subtype.ext
  funext x
  change (∑ a, t a * (Pi.single a 1 : A → ℝ) x) = t x
  rw [Finset.sum_eq_single x]
  · simp
  · intro b _ hbx
    simp [hbx]
  · simp

end StdSimplex

/-- Postcompose an affine simplex by another affine simplex. -/
def AffineSimplex.postcompose {a q r : ℕ}
    (g : AffineSimplex a q) (p : AffineSimplex q r) :
    AffineSimplex a r :=
  fun i ↦ g.realize (p i)

theorem AffineSimplex.realize_postcompose {a q r : ℕ}
    (g : AffineSimplex a q) (p : AffineSimplex q r) :
    (postcompose g p).realize = g.realize.comp p.realize := by
  ext t x
  exact congrArg (fun s : stdSimplex ℝ (Fin (a + 1)) ↦ s x)
    (StdSimplex.affineMap_comp_affineMap g p t)

@[simp]
theorem AffineSimplex.postcompose_face {a q r : ℕ}
    (g : AffineSimplex a q) (p : AffineSimplex q (r + 1))
    (i : Fin (r + 2)) :
    postcompose g (p.face i) = (postcompose g p).face i := rfl

@[simp]
theorem AffineSimplex.postcompose_cone {a q r : ℕ}
    (g : AffineSimplex a q) (p : AffineSimplex q r)
    (b : stdSimplex ℝ (Fin (q + 1))) :
    postcompose g (p.cone b) =
      (postcompose g p).cone (g.realize b) := by
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i <;> rfl

@[simp]
theorem AffineSimplex.postcompose_barycenter {a q r : ℕ}
    (g : AffineSimplex a q) (p : AffineSimplex q r) :
    (postcompose g p).barycenter = g.realize p.barycenter := by
  apply Subtype.ext
  funext x
  change (∑ i : Fin (r + 1),
      (1 / Fintype.card (Fin (r + 1)) : ℝ) *
        ∑ j : Fin (q + 1), p i j * g j x) =
    ∑ j : Fin (q + 1),
      (∑ i : Fin (r + 1),
        (1 / Fintype.card (Fin (r + 1)) : ℝ) * p i j) * g j x
  simp_rw [Finset.mul_sum, ← mul_assoc, Finset.sum_mul]
  rw [Finset.sum_comm]

/-- Apply affine postcomposition termwise to a finite affine chain. -/
def affinePostcompose (K : Type v) [Field K]
    {a q : ℕ} (g : AffineSimplex a q) (r : ℕ) :
    AffineChain K q r →ₗ[K] AffineChain K a r :=
  Finsupp.linearCombination K
    (fun p ↦ Finsupp.single (AffineSimplex.postcompose g p) 1)

@[simp]
theorem affinePostcompose_single (K : Type v) [Field K]
    {a q r : ℕ} (g : AffineSimplex a q)
    (p : AffineSimplex q r) (c : K) :
    affinePostcompose K g r (Finsupp.single p c) =
      c • Finsupp.single (AffineSimplex.postcompose g p) 1 := by
  exact Finsupp.linearCombination_single K c p

theorem affinePostcompose_cone (K : Type v) [Field K]
    {a q r : ℕ} (g : AffineSimplex a q)
    (b : stdSimplex ℝ (Fin (q + 1))) (c : AffineChain K q r) :
    affinePostcompose K g (r + 1) (affineCone K b r c) =
      affineCone K (g.realize b) r (affinePostcompose K g r c) := by
  suffices (affinePostcompose K g (r + 1)).comp (affineCone K b r) =
      (affineCone K (g.realize b) r).comp (affinePostcompose K g r) by
    exact LinearMap.congr_fun this c
  apply Finsupp.lhom_ext
  intro p z
  simp

/-- Universal affine subdivision is natural under affine postcomposition. -/
theorem affinePostcompose_subdivisionOn
    (K : Type v) [Field K] {a q : ℕ} (g : AffineSimplex a q) :
    ∀ (r : ℕ) (p : AffineSimplex q r),
      affinePostcompose K g r (affineSubdivisionOn K r p) =
        affineSubdivisionOn K r (AffineSimplex.postcompose g p) := by
  intro r
  induction r with
  | zero => intro p; simp [affineSubdivisionOn]
  | succ r ih =>
      intro p
      rw [affineSubdivisionOn, affinePostcompose_cone, map_sum]
      change affineCone K (g.realize p.barycenter) r
          (∑ i : Fin (r + 2),
            affinePostcompose K g r (affineSubdivisionOn K r (p.face i))) =
        affineSubdivisionOn K (r + 1) (AffineSimplex.postcompose g p)
      rw [affineSubdivisionOn, AffineSimplex.postcompose_barycenter]
      simp only [ih, AffineSimplex.postcompose_face]

/-- The ordered vertex tuple of a standard simplex. -/
def AffineSimplex.identity (q : ℕ) : AffineSimplex q q :=
  fun i ↦ stdSimplex.vertex i

@[simp]
theorem AffineSimplex.realize_identity (q : ℕ) :
    (identity q).realize = ContinuousMap.id _ := by
  ext t x
  exact congrArg (fun s : stdSimplex ℝ (Fin (q + 1)) ↦ s x)
    (StdSimplex.affineMap_vertices t)

/-- Push an affine simplex through a singular simplex. -/
def pushAffineSimplex (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r) :
    singularSSet X _⦋r⦌ :=
  (X.toSSetObjEquiv _).symm ((X.toSSetObjEquiv _ σ).comp p.realize)

/-- Pushing an affine face gives the corresponding singular face. -/
theorem pushAffineSimplex_face (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q (r + 1))
    (i : Fin (r + 2)) :
    pushAffineSimplex X σ (p.face i) =
      (singularSSet X).δ i (pushAffineSimplex X σ p) := by
  apply (X.toSSetObjEquiv _).injective
  ext t
  change (X.toSSetObjEquiv _ σ)
      (StdSimplex.affineMap (p ∘ i.succAbove) t) = _
  rw [StdSimplex.affineMap_comp_map]
  rw [TopCat.toSSetObjEquiv_δ_apply]
  rfl

@[simp]
theorem pushAffineSimplex_identity (X : TopCat) {q : ℕ}
    (σ : singularSSet X _⦋q⦌) :
    pushAffineSimplex X σ (AffineSimplex.identity q) = σ := by
  apply (X.toSSetObjEquiv _).injective
  ext t
  change (X.toSSetObjEquiv _ σ)
      (StdSimplex.affineMap (fun i ↦ stdSimplex.vertex i) t) =
    X.toSSetObjEquiv _ σ t
  rw [StdSimplex.affineMap_vertices]

theorem pushAffineSimplex_postcompose (X : TopCat) {a q r : ℕ}
    (σ : singularSSet X _⦋a⦌) (g : AffineSimplex a q)
    (p : AffineSimplex q r) :
    pushAffineSimplex X σ (AffineSimplex.postcompose g p) =
      pushAffineSimplex X (pushAffineSimplex X σ g) p := by
  apply (X.toSSetObjEquiv _).injective
  ext t
  change (X.toSSetObjEquiv _ σ)
      (StdSimplex.affineMap
        (fun i ↦ StdSimplex.affineMap g (p i)) t) =
    (X.toSSetObjEquiv _ σ)
      (StdSimplex.affineMap g (StdSimplex.affineMap p t))
  rw [StdSimplex.affineMap_comp_affineMap]

/-- Push a finite affine chain through a fixed singular simplex. -/
def affineChainToSingular
    (K : Type v) [Field K] (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) :
    AffineChain K q r →ₗ[K]
      (ModuleCat.of K K ⟶ (sSetChainComplex K (singularSSet X)).X r) :=
  Finsupp.linearCombination K (fun p ↦
    (singularSSet X).ιChainComplex (pushAffineSimplex X σ p))

@[simp]
theorem affineChainToSingular_single
    (K : Type v) [Field K] (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r) (a : K) :
    affineChainToSingular K X σ (Finsupp.single p a) =
      a • (singularSSet X).ιChainComplex (pushAffineSimplex X σ p) := by
  exact Finsupp.linearCombination_single K a p

/-- Pushing affine chains intertwines affine and singular boundaries in
characteristic two. -/
theorem affineChainToSingular_boundary
    (K : Type v) [Field K] [CharP K 2] (X : TopCat)
    {q r : ℕ} (σ : singularSSet X _⦋q⦌)
    (c : AffineChain K q (r + 1)) :
    affineChainToSingular K X σ c ≫
        (sSetChainComplex K (singularSSet X)).d (r + 1) r =
      affineChainToSingular K X σ (affineBoundary K q r c) := by
  induction c using Finsupp.induction with
  | zero => simp
  | single_add p a c ha hp ih =>
      rw [map_add, Preadditive.add_comp, map_add, ih, map_add]
      congr 1
      rw [affineChainToSingular_single, Linear.smul_comp,
        affineBoundary_single, map_smul]
      simp only [SSet.ιChainComplex_d, pushAffineSimplex_face,
        affineBoundaryOn, map_sum, affineChainToSingular_single, one_smul]
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      let u : ModuleCat.of K K ⟶
          (sSetChainComplex K (singularSSet X)).X r :=
        (singularSSet X).ιChainComplex
          ((singularSSet X).δ i (pushAffineSimplex X σ p))
      change ((-1 : ℤ) ^ i.val) • u = u
      obtain hsign | hsign := neg_one_pow_eq_or ℤ i.val
      · rw [hsign, one_smul]
      · rw [hsign]
        calc
          (-1 : ℤ) • u = -u := by simp
          _ = (-1 : K) • u := by simp
          _ = (1 : K) • u := by rw [CharTwo.neg_eq]
          _ = u := one_smul K u

/-- Affine postcomposition before pushing is the same as first pushing the
outer affine simplex. -/
theorem affineChainToSingular_postcompose
    (K : Type v) [Field K] (X : TopCat) {a q r : ℕ}
    (σ : singularSSet X _⦋a⦌) (g : AffineSimplex a q)
    (c : AffineChain K q r) :
    affineChainToSingular K X σ (affinePostcompose K g r c) =
      affineChainToSingular K X (pushAffineSimplex X σ g) c := by
  induction c using Finsupp.induction with
  | zero => simp
  | single_add p z c hz hp ih =>
      rw [map_add, map_add, map_add, ih]
      congr 1
      simp [pushAffineSimplex_postcompose]

@[simp]
theorem AffineSimplex.postcompose_identity {a q : ℕ}
    (g : AffineSimplex a q) :
    postcompose g (identity q) = g := by
  funext i
  exact g.realize_vertex i

/-- Affine postcomposition commutes with one linear subdivision. -/
theorem affinePostcompose_subdivision
    (K : Type v) [Field K] {a q r : ℕ}
    (g : AffineSimplex a q) (c : AffineChain K q r) :
    affinePostcompose K g r (affineSubdivision K q r c) =
      affineSubdivision K a r (affinePostcompose K g r c) := by
  suffices (affinePostcompose K g r).comp (affineSubdivision K q r) =
      (affineSubdivision K a r).comp (affinePostcompose K g r) by
    exact LinearMap.congr_fun this c
  apply Finsupp.lhom_ext
  intro p z
  simp [affinePostcompose_subdivisionOn]

/-- Affine postcomposition commutes with every subdivision iterate. -/
theorem affinePostcompose_subdivisionIter
    (K : Type v) [Field K] {a q r : ℕ}
    (g : AffineSimplex a q) (N : ℕ) (c : AffineChain K q r) :
    affinePostcompose K g r (affineSubdivisionIter K q r N c) =
      affineSubdivisionIter K a r N (affinePostcompose K g r c) := by
  induction N with
  | zero => rfl
  | succ N ih =>
      change affinePostcompose K g r
          (affineSubdivision K q r (affineSubdivisionIter K q r N c)) =
        affineSubdivision K a r
          (affineSubdivisionIter K a r N (affinePostcompose K g r c))
      rw [affinePostcompose_subdivision, ih]

/-- The universal prism on a generator is natural under affine
postcomposition. -/
theorem affinePostcompose_prismOn
    (K : Type v) [Field K] {a q : ℕ} (g : AffineSimplex a q) :
    ∀ (r : ℕ) (p : AffineSimplex q r),
      affinePostcompose K g (r + 1) (affinePrismOn K r p) =
        affinePrismOn K r (AffineSimplex.postcompose g p) := by
  intro r
  induction r with
  | zero =>
      intro p
      rw [affinePrismOn, affinePostcompose_cone, affinePrismOn]
      simp [AffineSimplex.postcompose]
  | succ r ih =>
      intro p
      rw [affinePrismOn, affinePostcompose_cone, map_add, map_sum]
      change affineCone K (g.realize p.barycenter) (r + 1)
          (affinePostcompose K g (r + 1) (Finsupp.single p 1) +
            ∑ i : Fin (r + 2),
              affinePostcompose K g (r + 1)
                (affinePrismOn K r (p.face i))) =
        affinePrismOn K (r + 1) (AffineSimplex.postcompose g p)
      rw [affinePrismOn, AffineSimplex.postcompose_barycenter]
      simp only [affinePostcompose_single, one_smul, ih,
        AffineSimplex.postcompose_face]

/-- Affine postcomposition commutes with the linear universal prism. -/
theorem affinePostcompose_prism
    (K : Type v) [Field K] {a q r : ℕ}
    (g : AffineSimplex a q) (c : AffineChain K q r) :
    affinePostcompose K g (r + 1) (affinePrism K q r c) =
      affinePrism K a r (affinePostcompose K g r c) := by
  suffices (affinePostcompose K g (r + 1)).comp (affinePrism K q r) =
      (affinePrism K a r).comp (affinePostcompose K g r) by
    exact LinearMap.congr_fun this c
  apply Finsupp.lhom_ext
  intro p z
  simp [affinePostcompose_prismOn]

/-- Affine postcomposition commutes with every finite prism sum. -/
theorem affinePostcompose_iteratedPrism
    (K : Type v) [Field K] {a q r : ℕ}
    (g : AffineSimplex a q) (N : ℕ) (c : AffineChain K q r) :
    affinePostcompose K g (r + 1) (affineIteratedPrism K q r N c) =
      affineIteratedPrism K a r N (affinePostcompose K g r c) := by
  induction N with
  | zero => simp
  | succ N ih =>
      change affinePostcompose K g (r + 1)
          (affineIteratedPrism K q r N c +
            affinePrism K q r (affineSubdivisionIter K q r N c)) =
        affineIteratedPrism K a r N (affinePostcompose K g r c) +
          affinePrism K a r
            (affineSubdivisionIter K a r N (affinePostcompose K g r c))
      rw [map_add, ih, affinePostcompose_prism,
        affinePostcompose_subdivisionIter]

/-- The subdivision of a standard face is the postcomposition of the
subdivision of the smaller identity simplex. -/
theorem affineSubdivisionIter_face_identity
    (K : Type v) [Field K] (r N : ℕ) (i : Fin (r + 2)) :
    affineSubdivisionIter K (r + 1) r N
        (Finsupp.single ((AffineSimplex.identity (r + 1)).face i) 1) =
      affinePostcompose K ((AffineSimplex.identity (r + 1)).face i) r
        (affineSubdivisionIter K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  symm
  rw [affinePostcompose_subdivisionIter]
  simp

/-- The iterated prism on a standard face is the postcomposition of the
iterated prism on the smaller identity simplex. -/
theorem affineIteratedPrism_face_identity
    (K : Type v) [Field K] (r N : ℕ) (i : Fin (r + 2)) :
    affineIteratedPrism K (r + 1) r N
        (Finsupp.single ((AffineSimplex.identity (r + 1)).face i) 1) =
      affinePostcompose K ((AffineSimplex.identity (r + 1)).face i) (r + 1)
        (affineIteratedPrism K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  symm
  rw [affinePostcompose_iteratedPrism]
  simp

/-- In a module over a characteristic-two field, every alternating integral
sign acts trivially. -/
theorem charTwo_int_neg_one_pow_smul
    (K : Type v) [Field K] [CharP K 2]
    {M : Type*} [AddCommGroup M] [Module K M]
    (n : ℕ) (x : M) : ((-1 : ℤ) ^ n) • x = x := by
  obtain h | h := neg_one_pow_eq_or ℤ n
  · rw [h, one_smul]
  · rw [h]
    calc
      (-1 : ℤ) • x = -x := by simp
      _ = (-1 : K) • x := by simp
      _ = (1 : K) • x := by rw [CharTwo.neg_eq]
      _ = x := one_smul K x

/-! ## Singular subdivision and its augmented homotopy -/

theorem affineSubdivisionIter_zero_degree
    (K : Type v) [Field K] (q N : ℕ) :
    affineSubdivisionIter K q 0 N = LinearMap.id := by
  induction N with
  | zero => rfl
  | succ N ih =>
      rw [affineSubdivisionIter_succ, affineSubdivision_zero, ih]
      rfl

/-- The `N`-fold singular subdivision in one ordinary chain degree. -/
noncomputable def singularSubdivisionIterDegree
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X r :=
  Sigma.desc (fun σ : singularSSet X _⦋r⦌ ↦
    affineChainToSingular K X σ
      (affineSubdivisionIter K r r N
        (Finsupp.single (AffineSimplex.identity r) 1)))

@[reassoc]
theorem iota_singularSubdivisionIterDegree
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ)
    (σ : singularSSet X _⦋r⦌) :
    (singularSSet X).ιChainComplex σ ≫
        singularSubdivisionIterDegree K X N r =
      affineChainToSingular K X σ
        (affineSubdivisionIter K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  exact Sigma.ι_desc _ σ

theorem affineChainToSingular_subdivisionIter_face_identity
    (K : Type v) [Field K] (X : TopCat)
    (r N : ℕ) (σ : singularSSet X _⦋r + 1⦌)
    (i : Fin (r + 2)) :
    affineChainToSingular K X σ
        (affineSubdivisionIter K (r + 1) r N
          (Finsupp.single ((AffineSimplex.identity (r + 1)).face i) 1)) =
      affineChainToSingular K X ((singularSSet X).δ i σ)
        (affineSubdivisionIter K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  rw [affineSubdivisionIter_face_identity,
    affineChainToSingular_postcompose, pushAffineSimplex_face,
    pushAffineSimplex_identity]

/-- Iterated singular subdivision commutes with the ordinary singular
boundary. -/
theorem singularSubdivisionIterDegree_d
    (K : Type v) [Field K] [CharP K 2]
    (X : TopCat) (N r : ℕ) :
    singularSubdivisionIterDegree K X N (r + 1) ≫
        (sSetChainComplex K (singularSSet X)).d (r + 1) r =
      (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
        singularSubdivisionIterDegree K X N r := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_singularSubdivisionIterDegree,
    affineChainToSingular_boundary]
  have hcomm := LinearMap.congr_fun
    (affineBoundary_comp_subdivisionIter K (r + 1) r N)
    (Finsupp.single (AffineSimplex.identity (r + 1)) 1)
  change affineBoundary K (r + 1) r
      (affineSubdivisionIter K (r + 1) (r + 1) N
        (Finsupp.single (AffineSimplex.identity (r + 1)) 1)) =
    affineSubdivisionIter K (r + 1) r N
      (affineBoundary K (r + 1) r
        (Finsupp.single (AffineSimplex.identity (r + 1)) 1)) at hcomm
  rw [hcomm, affineBoundary_single, one_smul, affineBoundaryOn, map_sum,
    map_sum]
  simp only [affineChainToSingular_subdivisionIter_face_identity]
  rw [← Category.assoc, SSet.ιChainComplex_d,
    Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Linear.smul_comp, iota_singularSubdivisionIterDegree]
  exact (charTwo_int_neg_one_pow_smul K i.val _).symm

@[simp]
theorem singularSubdivisionIterDegree_zero
    (K : Type v) [Field K] (X : TopCat) (N : ℕ) :
    singularSubdivisionIterDegree K X N 0 = 𝟙 _ := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [iota_singularSubdivisionIterDegree,
    affineSubdivisionIter_zero_degree]
  simp

/-- The iterated singular subdivision as a map of augmented singular chain
complexes. -/
noncomputable def augmentedSingularSubdivisionIter
    (K : Type v) [Field K] [CharP K 2]
    (X : TopCat) (N : ℕ) :
    augmentedSingularChainComplex K X ⟶
      augmentedSingularChainComplex K X where
  f
    | 0 => 𝟙 _
    | r + 1 => singularSubdivisionIterDegree K X N r
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      simp [singularSubdivisionIterDegree_zero]
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact singularSubdivisionIterDegree_d K X N j

/-- The finite iterated singular prism in one ordinary chain degree. -/
noncomputable def singularIteratedPrismDegree
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
  Sigma.desc (fun σ : singularSSet X _⦋r⦌ ↦
    affineChainToSingular K X σ
      (affineIteratedPrism K r r N
        (Finsupp.single (AffineSimplex.identity r) 1)))

@[reassoc]
theorem iota_singularIteratedPrismDegree
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ)
    (σ : singularSSet X _⦋r⦌) :
    (singularSSet X).ιChainComplex σ ≫
        singularIteratedPrismDegree K X N r =
      affineChainToSingular K X σ
        (affineIteratedPrism K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  exact Sigma.ι_desc _ σ

theorem affineChainToSingular_iteratedPrism_face_identity
    (K : Type v) [Field K] (X : TopCat)
    (r N : ℕ) (σ : singularSSet X _⦋r + 1⦌)
    (i : Fin (r + 2)) :
    affineChainToSingular K X σ
        (affineIteratedPrism K (r + 1) r N
          (Finsupp.single ((AffineSimplex.identity (r + 1)).face i) 1)) =
      affineChainToSingular K X ((singularSSet X).δ i σ)
        (affineIteratedPrism K r r N
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  rw [affineIteratedPrism_face_identity,
    affineChainToSingular_postcompose, pushAffineSimplex_face,
    pushAffineSimplex_identity]

/-- The singular `D_N∂` term, zero in ordinary degree zero. -/
def singularIteratedPrismBoundaryDegree
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X r := by
  rcases r with _ | r
  · exact 0
  · exact (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
      singularIteratedPrismDegree K X N r

@[simp]
theorem singularIteratedPrismBoundaryDegree_zero
    (K : Type v) [Field K] (X : TopCat) (N : ℕ) :
    singularIteratedPrismBoundaryDegree K X N 0 = 0 := rfl

@[simp]
theorem singularIteratedPrismBoundaryDegree_succ
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ) :
    singularIteratedPrismBoundaryDegree K X N (r + 1) =
      (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
        singularIteratedPrismDegree K X N r := rfl

theorem iota_singularIteratedPrismBoundaryDegree
    (K : Type v) [Field K] [CharP K 2]
    (X : TopCat) (N r : ℕ) (σ : singularSSet X _⦋r⦌) :
    (singularSSet X).ιChainComplex σ ≫
        singularIteratedPrismBoundaryDegree K X N r =
      affineChainToSingular K X σ
        (affineIteratedPrismBoundaryMap K r N r
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  rcases r with _ | r
  · simp [affineIteratedPrismBoundaryMap]
  · rw [singularIteratedPrismBoundaryDegree_succ,
      ← Category.assoc, SSet.ιChainComplex_d, Preadditive.sum_comp]
    simp only [Linear.smul_comp, iota_singularIteratedPrismDegree]
    rw [affineIteratedPrismBoundaryMap_succ_degree,
      LinearMap.comp_apply, affineBoundary_single, one_smul,
      affineBoundaryOn, map_sum, map_sum]
    simp only [affineChainToSingular_iteratedPrism_face_identity]
    apply Finset.sum_congr rfl
    intro i hi
    exact charTwo_int_neg_one_pow_smul K i.val _

/-- Pushing the telescoped affine prism gives the singular identity
`D_N∂ + ∂D_N = 1 + S^N`. -/
theorem singularIteratedPrismDegree_identity
    (K : Type v) [Field K] [CharP K 2]
    (X : TopCat) (N r : ℕ) :
    singularIteratedPrismDegree K X N r ≫
          (sSetChainComplex K (singularSSet X)).d (r + 1) r +
        singularIteratedPrismBoundaryDegree K X N r =
      𝟙 ((sSetChainComplex K (singularSSet X)).X r) +
        singularSubdivisionIterDegree K X N r := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [Preadditive.comp_add, ← Category.assoc,
    iota_singularIteratedPrismDegree,
    affineChainToSingular_boundary,
    iota_singularIteratedPrismBoundaryDegree,
    Preadditive.comp_add, Category.comp_id,
    iota_singularSubdivisionIterDegree]
  rw [← map_add]
  have h := LinearMap.congr_fun
    (affineIteratedPrism_identity K r r N)
    (Finsupp.single (AffineSimplex.identity r) 1)
  simp only [LinearMap.add_apply, LinearMap.comp_apply,
    LinearMap.id_apply] at h
  rw [h, map_add]
  simp

/-- The degree-raising augmented prism, expressed as a map to the chosen
`xPrev` object so that all index casts are handled by the complex API. -/
def augmentedIteratedPrismToPrev
    (K : Type v) [Field K] (X : TopCat) (N : ℕ) (i : ℕ) :
    (augmentedSingularChainComplex K X).X i ⟶
      (augmentedSingularChainComplex K X).xPrev i := by
  rcases i with _ | r
  · exact 0
  · exact singularIteratedPrismDegree K X N r ≫
      ((augmentedSingularChainComplex K X).xPrevIso
        (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv

@[simp]
theorem augmentedIteratedPrismToPrev_zero
    (K : Type v) [Field K] (X : TopCat) (N : ℕ) :
    augmentedIteratedPrismToPrev K X N 0 = 0 := rfl

@[simp]
theorem augmentedIteratedPrismToPrev_succ
    (K : Type v) [Field K] (X : TopCat) (N r : ℕ) :
    augmentedIteratedPrismToPrev K X N (r + 1) =
      singularIteratedPrismDegree K X N r ≫
        ((augmentedSingularChainComplex K X).xPrevIso
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv := rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- The explicit finite prism gives an augmented chain homotopy from the
identity to `N`-fold singular subdivision. -/
noncomputable def augmentedSingularSubdivisionHomotopy
    (K : Type v) [Field K] [CharP K 2]
    (X : TopCat) (N : ℕ) :
    _root_.Homotopy
      (𝟙 (augmentedSingularChainComplex K X))
      (augmentedSingularSubdivisionIter K X N) := by
  let C := augmentedSingularChainComplex K X
  let hrel : ∀ i j, (ComplexShape.down ℕ).Rel j i → (C.X i ⟶ C.X j) :=
    fun i j hij ↦ augmentedIteratedPrismToPrev K X N i ≫
      (C.xPrevIso hij).hom
  have hrel_zero : hrel 0 1 (by rfl) = 0 := by
    dsimp [hrel]
    rw [zero_comp]
  have hrel_succ (r : ℕ) : hrel (r + 1) (r + 2) (by rfl) =
      singularIteratedPrismDegree K X N r := by
    dsimp [hrel]
    let hr : (ComplexShape.down ℕ).Rel (r + 2) (r + 1) := by rfl
    change (singularIteratedPrismDegree K X N r ≫
        (C.xPrevIso hr).inv) ≫ (C.xPrevIso hr).hom = _
    rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hmap : Homotopy.nullHomotopicMap' hrel =
      (𝟙 C) - augmentedSingularSubdivisionIter K X N := by
    apply HomologicalComplex.hom_ext
    intro i
    rcases i with _ | r
    · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left
          (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
      · rw [hrel_zero, zero_comp]
        change 0 = 𝟙 (ModuleCat.of K K) - 𝟙 (ModuleCat.of K K)
        rw [sub_self]
      · intro l hl
        simp at hl
    · rw [Homotopy.nullHomotopicMap'_f
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)
          (show (ComplexShape.down ℕ).Rel (r + 1) r by rfl)]
      have hlower :
          C.d (r + 1) r ≫ hrel r (r + 1) (by rfl) =
            singularIteratedPrismBoundaryDegree K X N r := by
        rcases r with _ | r
        · rw [hrel_zero, comp_zero]
          rfl
        · rw [hrel_succ]
          rfl
      have hupper :
          hrel (r + 1) (r + 2) (by rfl) ≫ C.d (r + 2) (r + 1) =
            singularIteratedPrismDegree K X N r ≫
              (sSetChainComplex K (singularSSet X)).d (r + 1) r := by
        rw [hrel_succ]
        rfl
      have hid := singularIteratedPrismDegree_identity K X N r
      have hneg : -(singularSubdivisionIterDegree K X N r) =
          singularSubdivisionIterDegree K X N r := by
        calc
          -(singularSubdivisionIterDegree K X N r) =
              (-1 : K) • singularSubdivisionIterDegree K X N r := by simp
          _ = (1 : K) • singularSubdivisionIterDegree K X N r := by
                rw [CharTwo.neg_eq]
          _ = singularSubdivisionIterDegree K X N r := one_smul _ _
      have hdeg :
          singularIteratedPrismBoundaryDegree K X N r +
              singularIteratedPrismDegree K X N r ≫
                (sSetChainComplex K (singularSSet X)).d (r + 1) r =
            𝟙 ((sSetChainComplex K (singularSSet X)).X r) -
              singularSubdivisionIterDegree K X N r := by
        calc
          singularIteratedPrismBoundaryDegree K X N r +
              singularIteratedPrismDegree K X N r ≫
                (sSetChainComplex K (singularSSet X)).d (r + 1) r =
              singularIteratedPrismDegree K X N r ≫
                  (sSetChainComplex K (singularSSet X)).d (r + 1) r +
                singularIteratedPrismBoundaryDegree K X N r := add_comm _ _
          _ = 𝟙 ((sSetChainComplex K (singularSSet X)).X r) +
                singularSubdivisionIterDegree K X N r := hid
          _ = 𝟙 ((sSetChainComplex K (singularSSet X)).X r) -
                singularSubdivisionIterDegree K X N r := by
                  rw [sub_eq_add_neg, hneg]
      rw [hlower, hupper]
      change singularIteratedPrismBoundaryDegree K X N r +
          singularIteratedPrismDegree K X N r ≫
            (sSetChainComplex K (singularSSet X)).d (r + 1) r =
        𝟙 ((sSetChainComplex K (singularSSet X)).X r) -
          singularSubdivisionIterDegree K X N r
      exact hdeg
  have hnull : _root_.Homotopy
      ((𝟙 C) - augmentedSingularSubdivisionIter K X N) 0 := by
    rw [← hmap]
    exact Homotopy.nullHomotopy' hrel
  exact Homotopy.equivSubZero.symm hnull

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Mesh control for universal affine subdivision

Canonical barycentric subdivision terms shrink geometrically in the ambient
standard simplex.  The uncollected term lists are used throughout so that
metric smallness is not affected by coefficient cancellation.
-/

noncomputable section

open scoped BigOperators

namespace SimplicialSphereAnisotropicity.Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

lemma dist_centerMass_le_affineSubdivision {d : ℕ} (f : Fin (d + 1) → E)
    (x : convexHull ℝ (Set.range f)) :
    dist x.1 (Finset.univ.centerMass (R := ℝ) (fun _ ↦ 1) f) ≤ d / (d + 1) *
      Metric.diam (convexHull ℝ (Set.range f)) := by
  obtain _ | d := d
  · obtain ⟨x, hx⟩ := x
    have : Set.range f = {f 0} := by
      ext i
      constructor
      · rintro ⟨i, rfl⟩
        fin_cases i
        rfl
      · aesop
    simp [this] at hx
    simpa [Finset.centerMass]
  let G := Finset.univ.centerMass (R := ℝ) (fun _ ↦ 1) f
  suffices ∀ i, dist (f i) G ≤ (d + 1) / (d + 2) *
      Metric.diam (convexHull ℝ (Set.range f)) by
    obtain ⟨_, ⟨i, rfl⟩, ⟨_, rfl, h⟩⟩ := convexHull_exists_dist_ge2 x.2
      ((subset_convexHull ℝ _) (Set.mem_singleton G))
    rw [Nat.cast_add, Nat.cast_one]
    simp only [add_assoc, one_add_one_eq_two]
    exact h.trans (this i)
  intro i
  let P : E := Finset.centerMass {i}ᶜ (R := ℝ) (fun _ ↦ 1) f
  have hi : Finset.card {i}ᶜ = d + 1 := by simpa using Finset.card_compl_add_card {i}
  have h : ∑ i ∈ {i}ᶜ, (1 : ℝ) = d + 1 := by simp [hi]
  have hP : dist (f i) G = (d + 1) / (d + 2) * dist (f i) P := by
    have : ((d : ℝ) + 2) • (f i - G) = ((d : ℝ) + 1) • (f i - P) := by
      have hp := Finset.centerMass_insert i {i}ᶜ (R := ℝ) (w := fun _ ↦ 1) f (by simp) (by
        simp only [h]
        positivity)
      simp only [Finset.insert_compl_self, Finset.sum_const, nsmul_eq_mul, mul_one, one_div] at hp
      simp only [hi, show (1 : ℝ) + ↑(d + 1) = d + 2 by simp; ring] at hp
      change G = _ + _ • P at hp
      rw [smul_sub, hp, smul_add, smul_smul, mul_inv_cancel₀ (by positivity), one_smul,
        smul_smul, mul_div_cancel₀ _ (by positivity), Nat.cast_add, Nat.cast_one,
        sub_add_eq_sub_sub]
      nth_rw 2 [← one_smul (M := ℝ) (f i)]
      rw [← sub_smul, add_sub_assoc, ← one_add_one_eq_two, add_sub_cancel_right, smul_sub]
    replace this := congr_arg norm this
    simp only [norm_smul, Real.norm_eq_abs] at this
    rw [← Nat.cast_two, ← Nat.cast_add] at this
    rw [abs_of_nonneg (by positivity), Nat.cast_add, Nat.cast_two] at this
    simp only [dist_eq_norm_sub]
    rw [← mul_right_inj' (a := (d : ℝ) + 2) (ne_of_gt (by positivity)), this, ← mul_assoc]
    congr
    rw [mul_comm, div_mul_cancel_of_imp, abs_eq_self]
    · positivity
    · intro h'
      exact (ne_of_gt (show 0 < (d : ℝ) + 2 by positivity) h').elim
  rw [hP]
  refine mul_le_mul (le_refl _) ?_ (by positivity) (by positivity)
  exact Metric.dist_le_diam_of_mem
    (isBounded_convexHull.2 ((isCompact_range (by continuity)).isBounded))
      (subset_convexHull _ _ (Set.mem_range_self i)) (by
      apply Finset.centerMass_mem_convexHull _ (by simp) (by
        rw [h]
        apply Nat.cast_add_one_pos)
      aesop)

def AffineSimplex.ambientHull {q r : ℕ} (p : AffineSimplex q r) :
    Set (Fin (q + 1) → ℝ) :=
  convexHull ℝ (Set.range fun i ↦ (p i : Fin (q + 1) → ℝ))

def AffineSimplex.ambientDiam {q r : ℕ} (p : AffineSimplex q r) : ℝ :=
  Metric.diam (Set.range fun i ↦ (p i : Fin (q + 1) → ℝ))

theorem AffineSimplex.vertex_mem_ambientHull {q r : ℕ}
    (p : AffineSimplex q r) (i : Fin (r + 1)) :
    ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
      p.ambientHull :=
  subset_convexHull ℝ _ (Set.mem_range_self i)

theorem AffineSimplex.face_ambientHull_subset {q r : ℕ}
    (p : AffineSimplex q (r + 1)) (i : Fin (r + 2)) :
    (p.face i).ambientHull ⊆ p.ambientHull := by
  apply convexHull_min
  · rintro _ ⟨j, rfl⟩
    exact p.vertex_mem_ambientHull (i.succAbove j)
  · exact convex_convexHull ℝ _

theorem AffineSimplex.face_ambientDiam_le {q r : ℕ}
    (p : AffineSimplex q (r + 1)) (i : Fin (r + 2)) :
    (p.face i).ambientDiam ≤ p.ambientDiam := by
  apply Metric.diam_mono
  · rintro _ ⟨j, rfl⟩
    exact ⟨i.succAbove j, rfl⟩
  · exact (isCompact_range (by continuity)).isBounded

theorem AffineSimplex.realize_val_mem_ambientHull {q r : ℕ}
    (p : AffineSimplex q r) (t : stdSimplex ℝ (Fin (r + 1))) :
    ((p.realize t : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
      p.ambientHull := by
  have hmem : (∑ i : Fin (r + 1), t i •
        ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) ∈
      convexHull ℝ (Set.range fun i ↦
        ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) := by
    refine (convex_convexHull ℝ _).sum_mem
      (t := Finset.univ) (w := fun i ↦ t i) (fun i _ ↦ t.2.1 i)
      t.2.2 ?_
    intro i hi
    exact subset_convexHull ℝ _ (Set.mem_range_self i)
  change (fun x ↦ ∑ i : Fin (r + 1), t i * p i x) ∈
    convexHull ℝ (Set.range fun i ↦
      ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
  convert hmem using 1
  ext x
  simp

theorem AffineSimplex.barycenter_mem_ambientHull {q r : ℕ}
    (p : AffineSimplex q r) :
    ((p.barycenter : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
      p.ambientHull := by
  have hmem : (∑ i : Fin (r + 1),
        (1 / Fintype.card (Fin (r + 1)) : ℝ) •
          ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) ∈
      p.ambientHull := by
    refine (convex_convexHull ℝ _).sum_mem
      (t := Finset.univ)
      (w := fun _ : Fin (r + 1) ↦
        (1 / Fintype.card (Fin (r + 1)) : ℝ))
      (fun _ _ ↦ by positivity)
      (by simp [ne_of_gt (show 0 < (r : ℝ) + 1 by positivity)]) ?_
    intro i hi
    exact p.vertex_mem_ambientHull i
  change (fun x ↦ ∑ i : Fin (r + 1),
      (1 / Fintype.card (Fin (r + 1)) : ℝ) * p i x) ∈ p.ambientHull
  convert hmem using 1
  ext x
  simp

theorem AffineSimplex.barycenter_val_eq_centerMass {q r : ℕ}
    (p : AffineSimplex q r) :
    ((p.barycenter : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) =
      Finset.univ.centerMass (R := ℝ) (fun _ ↦ 1)
        (fun i ↦ ((p i : stdSimplex ℝ (Fin (q + 1))) :
          Fin (q + 1) → ℝ)) := by
  ext x
  change (∑ i : Fin (r + 1),
      (1 / Fintype.card (Fin (r + 1)) : ℝ) * p i x) =
    ((∑ i : Fin (r + 1), (1 : ℝ))⁻¹ •
      ∑ i : Fin (r + 1), (1 : ℝ) •
        ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) x
  simp [Finset.mul_sum]

theorem AffineSimplex.realize_diam_le_ambientDiam {q r : ℕ}
    (p : AffineSimplex q r) :
    Metric.diam (Set.range p.realize) ≤ p.ambientDiam := by
  apply Metric.diam_le_of_forall_dist_le (Metric.diam_nonneg)
  rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
  change dist (((p.realize x).1 : Fin (q + 1) → ℝ))
      (((p.realize y).1 : Fin (q + 1) → ℝ)) ≤
    Metric.diam (Set.range fun i ↦
      ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
  rw [← convexHull_diam]
  exact Metric.dist_le_diam_of_mem
    (isBounded_convexHull.2 ((isCompact_range (by continuity)).isBounded))
    (p.realize_val_mem_ambientHull x) (p.realize_val_mem_ambientHull y)

theorem affineSubdivisionTermList_ambientHull_subset {q : ℕ} :
    ∀ (r : ℕ) (p t : AffineSimplex q r),
      t ∈ affineSubdivisionTermList r p → t.ambientHull ⊆ p.ambientHull
  | 0, p, t, ht => by
      simp [affineSubdivisionTermList] at ht
      subst t
      exact Set.Subset.rfl
  | r + 1, p, t, ht => by
      rw [affineSubdivisionTermList] at ht
      obtain ⟨u, hu, rfl⟩ := List.mem_map.mp ht
      obtain ⟨l, hl, hu⟩ := List.mem_flatten.mp hu
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
      have ihu := affineSubdivisionTermList_ambientHull_subset r (p.face i) u hu
      apply convexHull_min
      · rintro _ ⟨j, rfl⟩
        refine Fin.cases ?_ (fun j ↦ ?_) j
        · exact p.barycenter_mem_ambientHull
        · simpa using
            p.face_ambientHull_subset i (ihu (u.vertex_mem_ambientHull j))
      · exact convex_convexHull ℝ _

lemma monotone_self_div_succ (a b : ℝ) (h : a ≤ b)
    (ha : 0 ≤ a := by positivity) :
    a / (a + 1) ≤ b / (b + 1) := by
  have hrewrite (t : ℝ) (ht : t ≠ -1) :
      t / (t + 1) = 1 - 1 / (t + 1) := by
    grind
  rw [hrewrite a (by grind), hrewrite b (by grind), sub_le_sub_iff_left]
  exact one_div_le_one_div_of_le (by grind) (by simpa)

theorem affineSubdivisionTermList_ambientDiam_le {q : ℕ} :
    ∀ (r : ℕ) (p t : AffineSimplex q r),
      t ∈ affineSubdivisionTermList r p →
        t.ambientDiam ≤ (r : ℝ) / (r + 1) * p.ambientDiam
  | 0, p, t, ht => by
      simp [affineSubdivisionTermList] at ht
      subst t
      have hrange :
          Set.range (fun i : Fin 1 ↦
            ((p i : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) =
            {((p 0 : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)} := by
        ext x
        constructor
        · rintro ⟨i, rfl⟩
          fin_cases i
          rfl
        · rintro (rfl : x = _)
          exact ⟨0, rfl⟩
      simp [AffineSimplex.ambientDiam, hrange]
  | r + 1, p, t, ht => by
      rw [affineSubdivisionTermList] at ht
      obtain ⟨u, hu, rfl⟩ := List.mem_map.mp ht
      obtain ⟨l, hl, hu⟩ := List.mem_flatten.mp hu
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
      have ihu := affineSubdivisionTermList_ambientDiam_le r (p.face i) u hu
      have huhull :=
        affineSubdivisionTermList_ambientHull_subset r (p.face i) u hu
      have hapex (j : Fin (r + 1)) :
          dist
              (((u j : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
              (((p.barycenter : stdSimplex ℝ (Fin (q + 1))) :
                Fin (q + 1) → ℝ)) ≤
            ((r : ℝ) + 1) / ((r : ℝ) + 1 + 1) * p.ambientDiam := by
        rw [p.barycenter_val_eq_centerMass]
        change dist
            (((u j : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
            (Finset.univ.centerMass (R := ℝ) (fun _ ↦ 1)
              (fun i ↦ ((p i : stdSimplex ℝ (Fin (q + 1))) :
                Fin (q + 1) → ℝ))) ≤
          ((r : ℝ) + 1) / ((r : ℝ) + 1 + 1) * p.ambientDiam
        unfold AffineSimplex.ambientDiam
        rw [← convexHull_diam]
        simpa only [Nat.cast_add, Nat.cast_one] using
          (dist_centerMass_le_affineSubdivision
            (fun i ↦ ((p i : stdSimplex ℝ (Fin (q + 1))) :
              Fin (q + 1) → ℝ))
            ⟨_, p.face_ambientHull_subset i
              (huhull (u.vertex_mem_ambientHull j))⟩)
      have hchild (j k : Fin (r + 1)) :
          dist
              (((u j : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
              (((u k : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) ≤
            ((r : ℝ) + 1) / ((r : ℝ) + 1 + 1) * p.ambientDiam := by
        calc
          dist
                (((u j : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
                (((u k : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ))
              ≤ u.ambientDiam :=
            Metric.dist_le_diam_of_mem
              ((isCompact_range (by continuity)).isBounded)
              ⟨j, rfl⟩ ⟨k, rfl⟩
          _ ≤ (r : ℝ) / (r + 1) * (p.face i).ambientDiam := ihu
          _ ≤ (r : ℝ) / (r + 1) * p.ambientDiam :=
            mul_le_mul_of_nonneg_left (p.face_ambientDiam_le i) (by positivity)
          _ ≤ ((r : ℝ) + 1) / ((r : ℝ) + 1 + 1) * p.ambientDiam := by
            exact mul_le_mul_of_nonneg_right
              (monotone_self_div_succ (r : ℝ) (r + 1)
                (by norm_num)) Metric.diam_nonneg
      apply Metric.diam_le_of_forall_dist_le
        (mul_nonneg (by positivity) Metric.diam_nonneg)
      rintro _ ⟨j, rfl⟩ _ ⟨k, rfl⟩
      refine Fin.cases ?_ (fun j ↦ ?_) j
      · refine Fin.cases ?_ (fun k ↦ ?_) k
        · simpa [AffineSimplex.ambientDiam] using
            (mul_nonneg (show 0 ≤ ((r : ℝ) + 1) /
              ((r : ℝ) + 1 + 1) by positivity) Metric.diam_nonneg)
        · simpa only [AffineSimplex.cone_zero, AffineSimplex.cone_succ,
            dist_comm, AffineSimplex.ambientDiam, Nat.cast_add,
            Nat.cast_one] using hapex k
      · refine Fin.cases ?_ (fun k ↦ ?_) k
        · simpa only [AffineSimplex.cone_zero, AffineSimplex.cone_succ,
            AffineSimplex.ambientDiam, Nat.cast_add, Nat.cast_one]
            using hapex j
        · simpa only [AffineSimplex.cone_succ, AffineSimplex.ambientDiam,
            Nat.cast_add, Nat.cast_one]
            using hchild j k

theorem affineSubdivisionTermListIter_ambientHull_subset {q r N : ℕ}
    (p t : AffineSimplex q r)
    (ht : t ∈ affineSubdivisionTermListIter r N p) :
    t.ambientHull ⊆ p.ambientHull := by
  induction N generalizing t with
  | zero =>
      simp [affineSubdivisionTermListIter] at ht
      subst t
      exact Set.Subset.rfl
  | succ N ih =>
      rw [affineSubdivisionTermListIter_succ] at ht
      obtain ⟨u, hu, ht⟩ := List.mem_flatMap.mp ht
      exact (affineSubdivisionTermList_ambientHull_subset r u t ht).trans
        (ih u hu)

theorem affineSubdivisionTermListIter_ambientDiam_le {q r N : ℕ}
    (p t : AffineSimplex q r)
    (ht : t ∈ affineSubdivisionTermListIter r N p) :
    t.ambientDiam ≤ ((r : ℝ) / (r + 1)) ^ N * p.ambientDiam := by
  induction N generalizing t with
  | zero =>
      simp [affineSubdivisionTermListIter] at ht
      subst t
      simp
  | succ N ih =>
      rw [affineSubdivisionTermListIter_succ] at ht
      obtain ⟨u, hu, ht⟩ := List.mem_flatMap.mp ht
      calc
        t.ambientDiam ≤ (r : ℝ) / (r + 1) * u.ambientDiam :=
          affineSubdivisionTermList_ambientDiam_le r u t ht
        _ ≤ (r : ℝ) / (r + 1) *
            (((r : ℝ) / (r + 1)) ^ N * p.ambientDiam) :=
          mul_le_mul_of_nonneg_left (ih u hu) (by positivity)
        _ = ((r : ℝ) / (r + 1)) ^ (N + 1) * p.ambientDiam := by
          rw [pow_succ]
          ring

theorem exists_affineSubdivisionTermListIter_realize_diam_lt {q r : ℕ}
    (p : AffineSimplex q r) (ε : ℝ) (hε : 0 < ε) :
    ∃ N : ℕ, ∀ t ∈ affineSubdivisionTermListIter r N p,
      Metric.diam (Set.range t.realize) < ε := by
  have hnonneg : 0 ≤ p.ambientDiam := Metric.diam_nonneg
  obtain hd | hd := hnonneg.lt_or_eq
  · have hε' : 0 < ε / (2 * p.ambientDiam) :=
      div_pos hε (mul_pos (by positivity) hd)
    obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hε'
      (y := ((r : ℝ) / (r + 1))) (by
        rw [div_lt_one (by positivity)]
        norm_num)
    refine ⟨N, ?_⟩
    intro t ht
    refine lt_of_le_of_lt
      ((t.realize_diam_le_ambientDiam).trans
        (affineSubdivisionTermListIter_ambientDiam_le p t ht)) ?_
    refine lt_of_le_of_lt
      (mul_le_mul_of_nonneg_right hN.le Metric.diam_nonneg) ?_
    refine lt_of_eq_of_lt ?_ (show ε / 2 < ε by linarith)
    rw [div_mul, mul_div_cancel_right₀ _ hd.ne']
  · refine ⟨0, ?_⟩
    intro t ht
    simp [affineSubdivisionTermListIter] at ht
    subst t
    exact lt_of_le_of_lt
      (p.realize_diam_le_ambientDiam.trans hd.ge) hε

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Cover-small subdivision depths

An open cover is pulled back along each singular simplex.  Metric mesh
control then gives a raw subdivision depth, and a recursive face maximum
produces a depth compatible with every boundary face while remaining zero on
simplices that are already small.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory Simplicial Opposite

namespace SimplicialSphereAnisotropicity.Topology

theorem AffineSimplex.range_realize_val_eq_ambientHull {q r : ℕ}
    (p : AffineSimplex q r) :
    Set.range (fun t ↦
      ((p.realize t : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ)) =
      p.ambientHull := by
  apply Set.Subset.antisymm
  · rintro _ ⟨t, rfl⟩
    exact p.realize_val_mem_ambientHull t
  · apply convexHull_min
    · rintro _ ⟨i, rfl⟩
      exact ⟨stdSimplex.vertex i, by simp⟩
    · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩ a b ha hb hab
      have hxsum : ∑ i : Fin (r + 1), x i = 1 := x.2.2
      have hysum : ∑ i : Fin (r + 1), y i = 1 := y.2.2
      let z : stdSimplex ℝ (Fin (r + 1)) :=
        ⟨fun i ↦ a * x i + b * y i,
          fun i ↦ add_nonneg (mul_nonneg ha (x.2.1 i))
            (mul_nonneg hb (y.2.1 i)), by
            rw [Finset.sum_add_distrib, ← Finset.mul_sum,
              ← Finset.mul_sum, hxsum, hysum, mul_one, mul_one, hab]⟩
      refine ⟨z, ?_⟩
      funext j
      change (∑ i : Fin (r + 1),
          (a * x i + b * y i) * p i j) =
        (a • (fun j ↦ ∑ i : Fin (r + 1), x i * p i j) +
          b • (fun j ↦ ∑ i : Fin (r + 1), y i * p i j)) j
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      simp_rw [add_mul, mul_assoc]
      rw [Finset.sum_add_distrib]
      rw [← Finset.mul_sum, ← Finset.mul_sum]

theorem affineSubdivisionTermList_realize_range_subset {q r : ℕ}
    (p t : AffineSimplex q r)
    (ht : t ∈ affineSubdivisionTermList r p) :
    Set.range t.realize ⊆ Set.range p.realize := by
  intro _ hy
  obtain ⟨z, rfl⟩ := hy
  have hz :
      ((t.realize z : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
        p.ambientHull :=
    affineSubdivisionTermList_ambientHull_subset r p t ht
      (t.realize_val_mem_ambientHull z)
  rw [← p.range_realize_val_eq_ambientHull] at hz
  obtain ⟨w, hw⟩ := hz
  refine ⟨w, ?_⟩
  exact Subtype.ext hw

theorem affineSubdivisionTermListIter_realize_range_subset {q r N : ℕ}
    (p t : AffineSimplex q r)
    (ht : t ∈ affineSubdivisionTermListIter r N p) :
    Set.range t.realize ⊆ Set.range p.realize := by
  intro _ hy
  obtain ⟨z, rfl⟩ := hy
  have hz :
      ((t.realize z : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
        p.ambientHull :=
    affineSubdivisionTermListIter_ambientHull_subset p t ht
      (t.realize_val_mem_ambientHull z)
  rw [← p.range_realize_val_eq_ambientHull] at hz
  obtain ⟨w, hw⟩ := hz
  refine ⟨w, ?_⟩
  exact Subtype.ext hw

/-- Lebesgue-number form suited to a finite-diameter subset. -/
theorem exists_compact_cover_mesh {Y : Type*} [MetricSpace Y] [CompactSpace Y]
    {I : Type*} (V : I → Set Y) (hV : ∀ i, IsOpen (V i))
    (hcover : ⋃ i, V i = Set.univ) :
    ∃ ε > 0, ∀ (S : Set Y), S.Nonempty → Metric.diam S ≤ ε →
      ∃ i, S ⊆ V i := by
  obtain ⟨δ, hδ, hδ'⟩ :=
    lebesgue_number_lemma_of_metric isCompact_univ hV (by simp [hcover])
  refine ⟨δ / 2, by simpa, ?_⟩
  intro S hS hdiam
  obtain ⟨x, hx⟩ := hS
  obtain ⟨i, hi⟩ := hδ' x (by simp)
  refine ⟨i, ?_⟩
  intro s hs
  apply hi
  simp only [Metric.mem_ball]
  refine lt_of_le_of_lt (Metric.dist_le_diam_of_mem' ?_ hs hx)
    (lt_of_le_of_lt hdiam (by simpa))
  simpa only [← Metric.isBounded_iff_ediam_ne_top] using
    Metric.isBounded_of_compactSpace

/-- Every canonical term at depth `N`, pushed through `σ`, is subordinate to
one member of `U`. -/
def AllSubdivisionTermsSmall {X : TopCat} {I : Type*}
    (U : I → Set X) {r : ℕ} (N : ℕ)
    (σ : singularSSet X _⦋r⦌) : Prop :=
  ∀ p ∈ affineSubdivisionTermListIter r N (AffineSimplex.identity r),
    pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _

theorem pushAffineSimplex_small_of_realize_range_subset
    {X : TopCat} {I : Type*} (U : I → Set X) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (p t : AffineSimplex q r)
    (hsub : Set.range t.realize ⊆ Set.range p.realize)
    (hp : pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    pushAffineSimplex X σ t ∈ (smallSingularSubcomplex U).obj _ := by
  obtain ⟨i, hi⟩ := hp
  refine ⟨i, ?_⟩
  change Set.range ((X.toSSetObjEquiv _ σ).comp t.realize) ⊆ U i
  change Set.range ((X.toSSetObjEquiv _ σ).comp p.realize) ⊆ U i at hi
  rintro _ ⟨z, rfl⟩
  obtain ⟨w, hw⟩ := hsub ⟨z, rfl⟩
  exact hi ⟨w, by simp only [ContinuousMap.comp_apply, hw]⟩

theorem allSubdivisionTermsSmall_succ {X : TopCat} {I : Type*}
    (U : I → Set X) {r N : ℕ} (σ : singularSSet X _⦋r⦌)
    (hsmall : AllSubdivisionTermsSmall U N σ) :
    AllSubdivisionTermsSmall U (N + 1) σ := by
  intro t ht
  rw [affineSubdivisionTermListIter_succ] at ht
  obtain ⟨p, hp, ht⟩ := List.mem_flatMap.mp ht
  exact pushAffineSimplex_small_of_realize_range_subset U σ p t
    (affineSubdivisionTermList_realize_range_subset p t ht)
    (hsmall p hp)

theorem allSubdivisionTermsSmall_mono {X : TopCat} {I : Type*}
    (U : I → Set X) {r N M : ℕ} (σ : singularSSet X _⦋r⦌)
    (hNM : N ≤ M) (hsmall : AllSubdivisionTermsSmall U N σ) :
    AllSubdivisionTermsSmall U M σ := by
  induction M, hNM using Nat.le_induction with
  | base => exact hsmall
  | succ M hNM ih => exact allSubdivisionTermsSmall_succ U σ ih

theorem exists_allSubdivisionTermsSmall {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) {r : ℕ}
    (σ : singularSSet X _⦋r⦌) :
    ∃ N, AllSubdivisionTermsSmall U N σ := by
  let f : C(stdSimplex ℝ (Fin (r + 1)), X) := X.toSSetObjEquiv _ σ
  let V : I → Set (stdSimplex ℝ (Fin (r + 1))) := fun i ↦ f ⁻¹' U i
  have hV : ∀ i, IsOpen (V i) := fun i ↦ (hU i).preimage f.continuous
  have hVcover : ⋃ i, V i = Set.univ := by
    ext x
    simp only [V, Set.mem_iUnion, Set.mem_preimage, Set.mem_univ, iff_true]
    have hx : f x ∈ ⋃ i, U i := by rw [hcover]; trivial
    simpa only [Set.mem_iUnion] using hx
  obtain ⟨ε, hε, hmesh⟩ := exists_compact_cover_mesh V hV hVcover
  obtain ⟨N, hN⟩ :=
    exists_affineSubdivisionTermListIter_realize_diam_lt
      (AffineSimplex.identity r) ε hε
  refine ⟨N, ?_⟩
  intro p hp
  obtain ⟨i, hi⟩ := hmesh (Set.range p.realize) (Set.range_nonempty _)
    (hN p hp).le
  refine ⟨i, ?_⟩
  change Set.range (f.comp p.realize) ⊆ U i
  rintro _ ⟨t, rfl⟩
  exact hi ⟨t, rfl⟩

theorem smallSingularSubcomplex_face {X : TopCat} {I : Type*}
    (U : I → Set X) {r : ℕ} (σ : singularSSet X _⦋r + 1⦌)
    (i : Fin (r + 2))
    (hσ : σ ∈ (smallSingularSubcomplex U).obj _) :
    (singularSSet X).δ i σ ∈ (smallSingularSubcomplex U).obj _ := by
  exact (smallSingularSubcomplex U).map (SimplexCategory.δ i).op hσ

noncomputable def rawSubdivisionDepth {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) {r : ℕ}
    (σ : singularSSet X _⦋r⦌) : ℕ := by
  classical
  exact Nat.find (exists_allSubdivisionTermsSmall U hU hcover σ)

theorem rawSubdivisionDepth_allSmall {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) {r : ℕ}
    (σ : singularSSet X _⦋r⦌) :
    AllSubdivisionTermsSmall U
      (rawSubdivisionDepth U hU hcover σ) σ := by
  classical
  exact Nat.find_spec (exists_allSubdivisionTermsSmall U hU hcover σ)

noncomputable def adaptiveSubdivisionDepth {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) :
    (r : ℕ) → singularSSet X _⦋r⦌ → ℕ := by
  classical
  intro r
  induction r with
  | zero =>
      intro σ
      exact if σ ∈ (smallSingularSubcomplex U).obj _ then 0
        else rawSubdivisionDepth U hU hcover σ
  | succ r ih =>
      intro σ
      exact if σ ∈ (smallSingularSubcomplex U).obj _ then 0
        else max (rawSubdivisionDepth U hU hcover σ)
          (Finset.univ.sup fun i : Fin (r + 2) ↦
            ih ((singularSSet X).δ i σ))

theorem adaptiveSubdivisionDepth_zero_of_not_small {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ)
    (σ : singularSSet X _⦋0⦌)
    (hσ : σ ∉ (smallSingularSubcomplex U).obj _) :
    adaptiveSubdivisionDepth U hU hcover 0 σ =
      rawSubdivisionDepth U hU hcover σ := by
  classical
  change (if σ ∈ (smallSingularSubcomplex U).obj _ then 0
    else rawSubdivisionDepth U hU hcover σ) = _
  rw [if_neg hσ]

theorem adaptiveSubdivisionDepth_succ_of_not_small {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) (r : ℕ)
    (σ : singularSSet X _⦋r + 1⦌)
    (hσ : σ ∉ (smallSingularSubcomplex U).obj _) :
    adaptiveSubdivisionDepth U hU hcover (r + 1) σ =
      max (rawSubdivisionDepth U hU hcover σ)
        (Finset.univ.sup fun i : Fin (r + 2) ↦
          adaptiveSubdivisionDepth U hU hcover r
            ((singularSSet X).δ i σ)) := by
  classical
  change (if σ ∈ (smallSingularSubcomplex U).obj _ then 0
    else max (rawSubdivisionDepth U hU hcover σ)
      (Finset.univ.sup fun i : Fin (r + 2) ↦
        adaptiveSubdivisionDepth U hU hcover r
          ((singularSSet X).δ i σ))) = _
  rw [if_neg hσ]

theorem adaptiveSubdivisionDepth_eq_zero_of_small {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) {r : ℕ}
    (σ : singularSSet X _⦋r⦌)
    (hσ : σ ∈ (smallSingularSubcomplex U).obj _) :
    adaptiveSubdivisionDepth U hU hcover r σ = 0 := by
  classical
  cases r with
  | zero =>
      change (if σ ∈ (smallSingularSubcomplex U).obj _ then 0
        else rawSubdivisionDepth U hU hcover σ) = 0
      rw [if_pos hσ]
  | succ r =>
      change (if σ ∈ (smallSingularSubcomplex U).obj _ then 0
        else max (rawSubdivisionDepth U hU hcover σ)
          (Finset.univ.sup fun i : Fin (r + 2) ↦
            adaptiveSubdivisionDepth U hU hcover r
              ((singularSSet X).δ i σ))) = 0
      rw [if_pos hσ]

theorem adaptiveSubdivisionDepth_allSmall {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) :
    ∀ (r : ℕ) (σ : singularSSet X _⦋r⦌),
      AllSubdivisionTermsSmall U
        (adaptiveSubdivisionDepth U hU hcover r σ) σ := by
  intro r
  induction r with
  | zero =>
    intro σ
    by_cases hσ : σ ∈ (smallSingularSubcomplex U).obj _
    · rw [adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover σ hσ]
      intro p hp
      simp [affineSubdivisionTermListIter] at hp
      subst p
      simpa using hσ
    · rw [adaptiveSubdivisionDepth_zero_of_not_small U hU hcover σ hσ]
      exact rawSubdivisionDepth_allSmall U hU hcover σ
  | succ r ih =>
      intro σ
      by_cases hσ : σ ∈ (smallSingularSubcomplex U).obj _
      · rw [adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover σ hσ]
        intro p hp
        simp [affineSubdivisionTermListIter] at hp
        subst p
        simpa using hσ
      · rw [adaptiveSubdivisionDepth_succ_of_not_small U hU hcover r σ hσ]
        exact allSubdivisionTermsSmall_mono U σ
          (Nat.le_max_left _ _)
          (rawSubdivisionDepth_allSmall U hU hcover σ)

theorem adaptiveSubdivisionDepth_face_le {X : TopCat} {I : Type*}
    (U : I → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ⋃ i, U i = Set.univ) {r : ℕ}
    (σ : singularSSet X _⦋r + 1⦌) (i : Fin (r + 2)) :
    adaptiveSubdivisionDepth U hU hcover r ((singularSSet X).δ i σ) ≤
      adaptiveSubdivisionDepth U hU hcover (r + 1) σ := by
  by_cases hσ : σ ∈ (smallSingularSubcomplex U).obj _
  · have hface := smallSingularSubcomplex_face U σ i hσ
    rw [adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover σ hσ,
      adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover _ hface]
  · rw [adaptiveSubdivisionDepth_succ_of_not_small U hU hcover r σ hσ]
    exact (Finset.le_sup (f := fun j : Fin (r + 2) ↦
      adaptiveSubdivisionDepth U hU hcover r
        ((singularSSet X).δ j σ)) (Finset.mem_univ i)).trans
      (Nat.le_max_right _ _)

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Adaptive cover-small singular-chain retraction

This file packages variable-depth affine subdivision into an augmented chain
retraction onto the subcomplex generated by singular simplices subordinate to
an open cover.  Face-depth monotonicity supplies the correction prisms, whose
characteristic-two cancellation proves both the chain-map identity and the
homotopy to the identity.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite

namespace SimplicialSphereAnisotropicity.Topology

theorem AffineSimplex.cone_ambientHull_subset_of_subset {q r : ℕ}
    (p : AffineSimplex q r) (b : stdSimplex ℝ (Fin (q + 1)))
    {A : Set (Fin (q + 1) → ℝ)}
    (hb : ((b : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈ A)
    (hp : p.ambientHull ⊆ A) (hA : Convex ℝ A) :
    (p.cone b).ambientHull ⊆ A := by
  apply convexHull_min
  · rintro _ ⟨i, rfl⟩
    refine Fin.cases hb (fun j ↦ ?_) i
    exact hp (p.vertex_mem_ambientHull j)
  · exact hA

theorem affinePrismTermList_ambientHull_subset {q : ℕ} :
    ∀ (r : ℕ) (p : AffineSimplex q r) (t : AffineSimplex q (r + 1)),
      t ∈ affinePrismTermList r p → t.ambientHull ⊆ p.ambientHull := by
  intro r
  induction r with
  | zero =>
      intro p t ht
      simp [affinePrismTermList] at ht
      subst t
      simpa only [AffineSimplex.barycenter_zero] using
        p.cone_ambientHull_subset_of_subset p.barycenter
          p.barycenter_mem_ambientHull Set.Subset.rfl (convex_convexHull ℝ _)
  | succ r ih =>
      intro p t ht
      rw [affinePrismTermList] at ht
      obtain ⟨u, hu, rfl⟩ := List.mem_map.mp ht
      have hup : u.ambientHull ⊆ p.ambientHull := by
        simp only [List.mem_cons] at hu
        rcases hu with rfl | hu
        · exact Set.Subset.rfl
        · obtain ⟨l, hl, hu⟩ := List.mem_flatten.mp hu
          obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
          exact (ih (p.face i) u hu).trans
            (p.face_ambientHull_subset i)
      exact u.cone_ambientHull_subset_of_subset p.barycenter
        p.barycenter_mem_ambientHull hup (convex_convexHull ℝ _)

theorem AffineSimplex.realize_range_subset_of_ambientHull_subset
    {q r s : ℕ} (p : AffineSimplex q r) (t : AffineSimplex q s)
    (hull : t.ambientHull ⊆ p.ambientHull) :
    Set.range t.realize ⊆ Set.range p.realize := by
  intro _ hy
  obtain ⟨z, rfl⟩ := hy
  have hz :
      ((t.realize z : stdSimplex ℝ (Fin (q + 1))) : Fin (q + 1) → ℝ) ∈
        p.ambientHull := hull (t.realize_val_mem_ambientHull z)
  rw [← p.range_realize_val_eq_ambientHull] at hz
  obtain ⟨w, hw⟩ := hz
  exact ⟨w, Subtype.ext hw⟩

theorem affinePrismTermList_realize_range_subset {q r : ℕ}
    (p : AffineSimplex q r) (t : AffineSimplex q (r + 1))
    (ht : t ∈ affinePrismTermList r p) :
    Set.range t.realize ⊆ Set.range p.realize :=
  p.realize_range_subset_of_ambientHull_subset t
    (affinePrismTermList_ambientHull_subset r p t ht)

/-- Canonical terms in `T S^a(p)`. -/
def affinePrismLevelTermList {q r : ℕ} (a : ℕ)
    (p : AffineSimplex q r) : List (AffineSimplex q (r + 1)) :=
  (affineSubdivisionTermListIter r a p).flatMap (affinePrismTermList r)

theorem affineChainOfList_flatMap_prism
    (K : Type*) [Field K] {q r : ℕ}
    (l : List (AffineSimplex q r)) :
    affineChainOfList K (l.flatMap (affinePrismTermList r)) =
      affinePrism K q r (affineChainOfList K l) := by
  induction l with
  | nil => simp
  | cons p l ih =>
      simp [ih, affineChainOfList_prismTermList]

theorem affineChainOfList_prismLevelTermList
    (K : Type*) [Field K] {q r : ℕ} (a : ℕ)
    (p : AffineSimplex q r) :
    affineChainOfList K (affinePrismLevelTermList a p) =
      affinePrism K q r
        (affineSubdivisionIter K q r a (Finsupp.single p 1)) := by
  rw [affinePrismLevelTermList, affineChainOfList_flatMap_prism,
    affineChainOfList_subdivisionTermListIter]

/-- Canonical terms in the interval `T S^a + ... + T S^(a+g-1)`. -/
def affinePrismTailTermList {q r : ℕ} (a : ℕ)
    (p : AffineSimplex q r) (g : ℕ) : List (AffineSimplex q (r + 1)) :=
  Nat.rec [] (fun g ih ↦ ih ++ affinePrismLevelTermList (a + g) p) g

@[simp]
theorem affinePrismTailTermList_zero {q r a : ℕ}
    (p : AffineSimplex q r) :
    affinePrismTailTermList a p 0 = [] := by
  rfl

@[simp]
theorem affinePrismTailTermList_succ {q r a g : ℕ}
    (p : AffineSimplex q r) :
    affinePrismTailTermList a p (g + 1) =
      affinePrismTailTermList a p g ++
        affinePrismLevelTermList (a + g) p := by
  rfl

theorem affineChainOfList_prismTailTermList
    (K : Type*) [Field K] [CharP K 2] {q r : ℕ}
    (a g : ℕ) (p : AffineSimplex q r) :
    affineChainOfList K (affinePrismTailTermList a p g) =
      affineIteratedPrism K q r (a + g) (Finsupp.single p 1) +
        affineIteratedPrism K q r a (Finsupp.single p 1) := by
  induction g with
  | zero =>
      exact (charTwo_module_add_self_eq_zero K _).symm
  | succ g ih =>
      rw [affinePrismTailTermList_succ, affineChainOfList_append, ih,
        affineChainOfList_prismLevelTermList]
      rw [show a + (g + 1) = (a + g) + 1 by omega,
        affineIteratedPrism_succ]
      simp only [LinearMap.add_apply, LinearMap.comp_apply]
      abel

theorem affinePrismLevelTermList_realize_range_subset {q r a : ℕ}
    (p : AffineSimplex q r) (t : AffineSimplex q (r + 1))
    (ht : t ∈ affinePrismLevelTermList a p) :
    Set.range t.realize ⊆ Set.range p.realize := by
  rw [affinePrismLevelTermList] at ht
  obtain ⟨u, hu, ht⟩ := List.mem_flatMap.mp ht
  exact (affinePrismTermList_realize_range_subset u t ht).trans
    (affineSubdivisionTermListIter_realize_range_subset p u hu)

theorem affinePrismTailTermList_realize_range_subset {q r a g : ℕ}
    (p : AffineSimplex q r) (t : AffineSimplex q (r + 1))
    (ht : t ∈ affinePrismTailTermList a p g) :
    Set.range t.realize ⊆ Set.range p.realize := by
  induction g with
  | zero => simp at ht
  | succ g ih =>
      rw [affinePrismTailTermList_succ, List.mem_append] at ht
      rcases ht with ht | ht
      · exact ih ht
      · exact affinePrismLevelTermList_realize_range_subset p t ht

theorem pushAffineSimplex_small_of_realize_range_subset'
    {X : TopCat} {I : Type*} (U : I → Set X) {q r s : ℕ}
    (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r)
    (t : AffineSimplex q s)
    (hsub : Set.range t.realize ⊆ Set.range p.realize)
    (hp : pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    pushAffineSimplex X σ t ∈ (smallSingularSubcomplex U).obj _ := by
  obtain ⟨i, hi⟩ := hp
  refine ⟨i, ?_⟩
  change Set.range ((X.toSSetObjEquiv _ σ).comp t.realize) ⊆ U i
  change Set.range ((X.toSSetObjEquiv _ σ).comp p.realize) ⊆ U i at hi
  rintro _ ⟨z, rfl⟩
  obtain ⟨w, hw⟩ := hsub ⟨z, rfl⟩
  exact hi ⟨w, by simp only [ContinuousMap.comp_apply, hw]⟩

theorem allPrismLevelTermsSmall {X : TopCat} {I : Type*}
    (U : I → Set X) {r a : ℕ} (σ : singularSSet X _⦋r⦌)
    (ha : AllSubdivisionTermsSmall U a σ) :
    ∀ t ∈ affinePrismLevelTermList a (AffineSimplex.identity r),
      pushAffineSimplex X σ t ∈ (smallSingularSubcomplex U).obj _ := by
  intro t ht
  rw [affinePrismLevelTermList] at ht
  obtain ⟨p, hp, ht⟩ := List.mem_flatMap.mp ht
  exact pushAffineSimplex_small_of_realize_range_subset' U σ p t
    (affinePrismTermList_realize_range_subset p t ht) (ha p hp)

theorem allPrismTailTermsSmall {X : TopCat} {I : Type*}
    (U : I → Set X) {r a g : ℕ} (σ : singularSSet X _⦋r⦌)
    (ha : AllSubdivisionTermsSmall U a σ) :
    ∀ t ∈ affinePrismTailTermList a (AffineSimplex.identity r) g,
      pushAffineSimplex X σ t ∈ (smallSingularSubcomplex U).obj _ := by
  induction g with
  | zero => simp
  | succ g ih =>
      intro t ht
      rw [affinePrismTailTermList_succ, List.mem_append] at ht
      rcases ht with ht | ht
      · exact ih t ht
      · exact allPrismLevelTermsSmall U σ
          (allSubdivisionTermsSmall_mono U σ (Nat.le_add_right a g) ha)
          t ht

/-- Collect an affine term list after pushing it through a singular simplex. -/
def singularChainOfAffineList
    (K : Type*) [Field K] (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (l : List (AffineSimplex q r)) :
    ModuleCat.of K K ⟶ (sSetChainComplex K (singularSSet X)).X r :=
  (l.map fun p ↦
    (singularSSet X).ιChainComplex (pushAffineSimplex X σ p)).sum

theorem singularChainOfAffineList_eq
    (K : Type*) [Field K] (X : TopCat) {q r : ℕ}
    (σ : singularSSet X _⦋q⦌) (l : List (AffineSimplex q r)) :
    singularChainOfAffineList K X σ l =
      affineChainToSingular K X σ (affineChainOfList K l) := by
  induction l with
  | nil => simp [singularChainOfAffineList]
  | cons p l ih =>
      rw [affineChainOfList_cons, map_add,
        affineChainToSingular_single, one_smul]
      simp only [singularChainOfAffineList, List.map_cons, List.sum_cons]
      exact congrArg
        (fun z ↦ (singularSSet X).ιChainComplex
          (pushAffineSimplex X σ p) + z) ih

def smallPushAffineSimplex {X : TopCat} {I : Type*} (U : I → Set X)
    {q r : ℕ} (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r)
    (hp : pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    smallSingularSSet U _⦋r⦌ :=
  ⟨pushAffineSimplex X σ p, hp⟩

noncomputable def smallPushAffineIota
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    {q r : ℕ} (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r)
    (hp : pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    ModuleCat.of K K ⟶ (sSetChainComplex K (smallSingularSSet U)).X r :=
  (smallSingularSSet U).ιChainComplex
    (smallPushAffineSimplex U σ p hp)

theorem smallPushAffineIota_inclusion
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    {q r : ℕ} (σ : singularSSet X _⦋q⦌) (p : AffineSimplex q r)
    (hp : pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    smallPushAffineIota K X U σ p hp ≫
        (SSet.chainComplexMap (smallSingularSubcomplex U).ι
          (ModuleCat.of K K)).f r =
      (singularSSet X).ιChainComplex (pushAffineSimplex X σ p) := by
  exact SSet.ι_chainComplexMap_f _ _ _ _ _

theorem exists_small_lift_singularChainOfAffineList
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    {q r : ℕ} (σ : singularSSet X _⦋q⦌)
    (l : List (AffineSimplex q r))
    (hsmall : ∀ p ∈ l,
      pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _) :
    ∃ c : ModuleCat.of K K ⟶
        (sSetChainComplex K (smallSingularSSet U)).X r,
      c ≫ (SSet.chainComplexMap (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f r = singularChainOfAffineList K X σ l := by
  induction l with
  | nil =>
      exact ⟨0, by simp [singularChainOfAffineList]⟩
  | cons p l ih =>
      have hp := hsmall p (by simp)
      obtain ⟨c, hc⟩ := ih (fun t ht ↦ hsmall t (by simp [ht]))
      refine ⟨smallPushAffineIota K X U σ p hp + c, ?_⟩
      rw [Preadditive.add_comp, smallPushAffineIota_inclusion, hc]
      simp [singularChainOfAffineList]

/-- The variable-depth singular prism in one ordinary degree. -/
noncomputable def adaptiveSingularPrismDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
  Sigma.desc (fun σ : singularSSet X _⦋r⦌ ↦
    affineChainToSingular K X σ
      (affineIteratedPrism K r r
        (adaptiveSubdivisionDepth U hU hcover r σ)
        (Finsupp.single (AffineSimplex.identity r) 1)))

@[reassoc]
theorem iota_adaptiveSingularPrismDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) (σ : singularSSet X _⦋r⦌) :
    (singularSSet X).ιChainComplex σ ≫
        adaptiveSingularPrismDegree K X U hU hcover r =
      affineChainToSingular K X σ
        (affineIteratedPrism K r r
          (adaptiveSubdivisionDepth U hU hcover r σ)
          (Finsupp.single (AffineSimplex.identity r) 1)) := by
  exact Sigma.ι_desc _ σ

/-- The variable `D∂` term. -/
def adaptiveSingularPrismBoundaryDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X r :=
  match r with
  | 0 => 0
  | r + 1 =>
    (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
      adaptiveSingularPrismDegree K X U hU hcover r

@[simp]
theorem adaptiveSingularPrismBoundaryDegree_zero
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    adaptiveSingularPrismBoundaryDegree K X U hU hcover 0 = 0 := rfl

@[simp]
theorem adaptiveSingularPrismBoundaryDegree_succ
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    adaptiveSingularPrismBoundaryDegree K X U hU hcover (r + 1) =
      (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
        adaptiveSingularPrismDegree K X U hU hcover r := rfl

theorem iota_adaptiveSingularPrismBoundaryDegree_succ
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) (σ : singularSSet X _⦋r + 1⦌) :
    (singularSSet X).ιChainComplex σ ≫
        adaptiveSingularPrismBoundaryDegree K X U hU hcover (r + 1) =
      ∑ i : Fin (r + 2),
        affineChainToSingular K X ((singularSSet X).δ i σ)
          (affineIteratedPrism K r r
            (adaptiveSubdivisionDepth U hU hcover r
              ((singularSSet X).δ i σ))
            (Finsupp.single (AffineSimplex.identity r) 1)) := by
  rw [adaptiveSingularPrismBoundaryDegree_succ,
    ← Category.assoc, SSet.ιChainComplex_d, Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Linear.smul_comp, iota_adaptiveSingularPrismDegree]
  exact charTwo_int_neg_one_pow_smul K i.val _

theorem iota_singularIteratedPrismBoundaryDegree_succ_sum
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) (N r : ℕ) (σ : singularSSet X _⦋r + 1⦌) :
    (singularSSet X).ιChainComplex σ ≫
        singularIteratedPrismBoundaryDegree K X N (r + 1) =
      ∑ i : Fin (r + 2),
        affineChainToSingular K X ((singularSSet X).δ i σ)
          (affineIteratedPrism K r r N
            (Finsupp.single (AffineSimplex.identity r) 1)) := by
  rw [singularIteratedPrismBoundaryDegree_succ,
    ← Category.assoc, SSet.ιChainComplex_d, Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Linear.smul_comp, iota_singularIteratedPrismDegree]
  exact charTwo_int_neg_one_pow_smul K i.val _

/-- Generatorwise `ρ = 1 + ∂D + D∂` in one ordinary degree. -/
def adaptiveRhoDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (singularSSet X)).X r :=
  𝟙 _ + adaptiveSingularPrismDegree K X U hU hcover r ≫
      (sSetChainComplex K (singularSSet X)).d (r + 1) r +
    adaptiveSingularPrismBoundaryDegree K X U hU hcover r

theorem iota_adaptiveRhoDegree_zero
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (σ : singularSSet X _⦋0⦌) :
    (singularSSet X).ιChainComplex σ ≫
        adaptiveRhoDegree K X U hU hcover 0 =
      singularChainOfAffineList K X σ
        (affineSubdivisionTermListIter 0
          (adaptiveSubdivisionDepth U hU hcover 0 σ)
          (AffineSimplex.identity 0)) := by
  let m := adaptiveSubdivisionDepth U hU hcover 0 σ
  let ι : ModuleCat.of K K ⟶
      (sSetChainComplex K (singularSSet X)).X 0 :=
    (singularSSet X).ιChainComplex σ
  let D : (sSetChainComplex K (singularSSet X)).X 0 ⟶
      (sSetChainComplex K (singularSSet X)).X 1 :=
    singularIteratedPrismDegree K X m 0
  let d : (sSetChainComplex K (singularSSet X)).X 1 ⟶
      (sSetChainComplex K (singularSSet X)).X 0 :=
    (sSetChainComplex K (singularSSet X)).d 1 0
  let S : (sSetChainComplex K (singularSSet X)).X 0 ⟶
      (sSetChainComplex K (singularSSet X)).X 0 :=
    singularSubdivisionIterDegree K X m 0
  have hD : ι ≫ adaptiveSingularPrismDegree K X U hU hcover 0 = ι ≫ D := by
    rw [iota_adaptiveSingularPrismDegree,
      iota_singularIteratedPrismDegree]
  have hfixed : (ι ≫ D) ≫ d = ι + ι ≫ S := by
    have h := congrArg (fun f ↦ ι ≫ f)
      (singularIteratedPrismDegree_identity K X m 0)
    simpa only [Preadditive.comp_add, Category.assoc, Category.comp_id,
      singularIteratedPrismBoundaryDegree_zero, comp_zero, add_zero] using h
  have hι : ι + ι = 0 := charTwo_module_add_self_eq_zero K ι
  simp only [adaptiveRhoDegree, Preadditive.comp_add, Category.comp_id,
    adaptiveSingularPrismBoundaryDegree_zero, add_zero]
  rw [← Category.assoc, hD, hfixed]
  rw [← add_assoc, hι, zero_add]
  rw [singularChainOfAffineList_eq,
    affineChainOfList_subdivisionTermListIter]
  simpa only [m, ι, S] using
    (iota_singularSubdivisionIterDegree K X m 0 σ)

theorem iota_adaptiveRhoDegree_succ
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) (σ : singularSSet X _⦋r + 1⦌) :
    (singularSSet X).ιChainComplex σ ≫
        adaptiveRhoDegree K X U hU hcover (r + 1) =
      singularChainOfAffineList K X σ
          (affineSubdivisionTermListIter (r + 1)
            (adaptiveSubdivisionDepth U hU hcover (r + 1) σ)
            (AffineSimplex.identity (r + 1))) +
        ∑ i : Fin (r + 2),
          singularChainOfAffineList K X ((singularSSet X).δ i σ)
            (affinePrismTailTermList
              (adaptiveSubdivisionDepth U hU hcover r
                ((singularSSet X).δ i σ))
              (AffineSimplex.identity r)
              (adaptiveSubdivisionDepth U hU hcover (r + 1) σ -
                adaptiveSubdivisionDepth U hU hcover r
                  ((singularSSet X).δ i σ))) := by
  let m := adaptiveSubdivisionDepth U hU hcover (r + 1) σ
  let ι : ModuleCat.of K K ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
    (singularSSet X).ιChainComplex σ
  let D : (sSetChainComplex K (singularSSet X)).X (r + 1) ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 2) :=
    singularIteratedPrismDegree K X m (r + 1)
  let d : (sSetChainComplex K (singularSSet X)).X (r + 2) ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
    (sSetChainComplex K (singularSSet X)).d (r + 2) (r + 1)
  let S : (sSetChainComplex K (singularSSet X)).X (r + 1) ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
    singularSubdivisionIterDegree K X m (r + 1)
  let FB : (sSetChainComplex K (singularSSet X)).X (r + 1) ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
    singularIteratedPrismBoundaryDegree K X m (r + 1)
  let AB : (sSetChainComplex K (singularSSet X)).X (r + 1) ⟶
      (sSetChainComplex K (singularSSet X)).X (r + 1) :=
    adaptiveSingularPrismBoundaryDegree K X U hU hcover (r + 1)
  have hD : ι ≫ adaptiveSingularPrismDegree K X U hU hcover (r + 1) =
      ι ≫ D := by
    rw [iota_adaptiveSingularPrismDegree,
      iota_singularIteratedPrismDegree]
  have hfixed : (ι ≫ D) ≫ d + ι ≫ FB = ι + ι ≫ S := by
    have h := congrArg (fun f ↦ ι ≫ f)
      (singularIteratedPrismDegree_identity K X m (r + 1))
    simpa only [Preadditive.comp_add, Category.assoc, Category.comp_id,
      D, d, FB, S] using h
  have hι : ι + ι = 0 := charTwo_module_add_self_eq_zero K ι
  have hFB : ι ≫ FB + ι ≫ FB = 0 :=
    charTwo_module_add_self_eq_zero K (ι ≫ FB)
  have hmain : ι + (ι ≫ D) ≫ d = ι ≫ S + ι ≫ FB := by
    calc
      ι + (ι ≫ D) ≫ d = ι + (ι ≫ D) ≫ d + 0 := by simp
      _ = ι + (ι ≫ D) ≫ d + (ι ≫ FB + ι ≫ FB) := by rw [hFB]
      _ = ((ι ≫ D) ≫ d + ι ≫ FB) + (ι + ι ≫ FB) := by abel
      _ = (ι + ι ≫ S) + (ι + ι ≫ FB) := by rw [hfixed]
      _ = (ι + ι) + (ι ≫ S + ι ≫ FB) := by abel
      _ = ι ≫ S + ι ≫ FB := by rw [hι, zero_add]
  have htail : ι ≫ FB + ι ≫ AB =
      ∑ i : Fin (r + 2),
        singularChainOfAffineList K X ((singularSSet X).δ i σ)
          (affinePrismTailTermList
            (adaptiveSubdivisionDepth U hU hcover r
              ((singularSSet X).δ i σ))
            (AffineSimplex.identity r)
            (m - adaptiveSubdivisionDepth U hU hcover r
              ((singularSSet X).δ i σ))) := by
    dsimp only [ι, FB, AB]
    rw [iota_singularIteratedPrismBoundaryDegree_succ_sum,
      iota_adaptiveSingularPrismBoundaryDegree_succ,
      ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [singularChainOfAffineList_eq,
      affineChainOfList_prismTailTermList]
    have hle := adaptiveSubdivisionDepth_face_le U hU hcover σ i
    rw [Nat.add_sub_of_le hle, map_add]
  have hSlist : ι ≫ S =
      singularChainOfAffineList K X σ
        (affineSubdivisionTermListIter (r + 1) m
          (AffineSimplex.identity (r + 1))) := by
    rw [singularChainOfAffineList_eq,
      affineChainOfList_subdivisionTermListIter]
    simpa only [ι, S] using
      (iota_singularSubdivisionIterDegree K X m (r + 1) σ)
  simp only [adaptiveRhoDegree, Preadditive.comp_add, Category.comp_id]
  rw [← Category.assoc, hD]
  change ι + (ι ≫ D) ≫ d + ι ≫ AB = _
  rw [hmain, add_assoc, htail, hSlist]

theorem exists_small_lift_adaptiveRhoDegree
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    ∀ (r : ℕ) (σ : singularSSet X _⦋r⦌),
      ∃ c : ModuleCat.of K K ⟶
          (sSetChainComplex K (smallSingularSSet U)).X r,
        c ≫ (SSet.chainComplexMap (smallSingularSubcomplex U).ι
          (ModuleCat.of K K)).f r =
          (singularSSet X).ιChainComplex σ ≫
            adaptiveRhoDegree K X U hU hcover r := by
  intro r
  cases r with
  | zero =>
      intro σ
      let l := affineSubdivisionTermListIter 0
        (adaptiveSubdivisionDepth U hU hcover 0 σ)
        (AffineSimplex.identity 0)
      have hl : ∀ p ∈ l,
          pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _ :=
        adaptiveSubdivisionDepth_allSmall U hU hcover 0 σ
      obtain ⟨c, hc⟩ :=
        exists_small_lift_singularChainOfAffineList K X U σ l hl
      refine ⟨c, hc.trans ?_⟩
      exact (iota_adaptiveRhoDegree_zero K X U hU hcover σ).symm
  | succ r =>
      intro σ
      let m := adaptiveSubdivisionDepth U hU hcover (r + 1) σ
      let l₀ := affineSubdivisionTermListIter (r + 1) m
        (AffineSimplex.identity (r + 1))
      have hl₀ : ∀ p ∈ l₀,
          pushAffineSimplex X σ p ∈ (smallSingularSubcomplex U).obj _ :=
        adaptiveSubdivisionDepth_allSmall U hU hcover (r + 1) σ
      obtain ⟨c₀, hc₀⟩ :=
        exists_small_lift_singularChainOfAffineList K X U σ l₀ hl₀
      let a (i : Fin (r + 2)) :=
        adaptiveSubdivisionDepth U hU hcover r ((singularSSet X).δ i σ)
      let l (i : Fin (r + 2)) :=
        affinePrismTailTermList (a i) (AffineSimplex.identity r) (m - a i)
      have hl (i : Fin (r + 2)) : ∀ p ∈ l i,
          pushAffineSimplex X ((singularSSet X).δ i σ) p ∈
            (smallSingularSubcomplex U).obj _ :=
        allPrismTailTermsSmall U ((singularSSet X).δ i σ)
          (adaptiveSubdivisionDepth_allSmall U hU hcover r
            ((singularSSet X).δ i σ))
      have hex (i : Fin (r + 2)) :
          ∃ c : ModuleCat.of K K ⟶
              (sSetChainComplex K (smallSingularSSet U)).X (r + 1),
            c ≫ (SSet.chainComplexMap (smallSingularSubcomplex U).ι
              (ModuleCat.of K K)).f (r + 1) =
              singularChainOfAffineList K X ((singularSSet X).δ i σ) (l i) :=
        exists_small_lift_singularChainOfAffineList K X U
          ((singularSSet X).δ i σ) (l i) (hl i)
      choose c hc using hex
      refine ⟨c₀ + ∑ i, c i, ?_⟩
      rw [Preadditive.add_comp, hc₀, Preadditive.sum_comp]
      simp_rw [hc]
      exact (iota_adaptiveRhoDegree_succ K X U hU hcover r σ).symm

/-- The ordinary-degree lift of `ρ` into the cover-small singular chains. -/
noncomputable def adaptiveRhoSmallDegree
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (smallSingularSSet U)).X r :=
  Sigma.desc (fun σ : singularSSet X _⦋r⦌ ↦
    Classical.choose
      (exists_small_lift_adaptiveRhoDegree K X U hU hcover r σ))

theorem adaptiveRhoSmallDegree_inclusion
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    adaptiveRhoSmallDegree K X U hU hcover r ≫
        (SSet.chainComplexMap (smallSingularSubcomplex U).ι
          (ModuleCat.of K K)).f r =
      adaptiveRhoDegree K X U hU hcover r := by
  apply SSet.chainComplex_hom_ext
  intro σ
  have hiota : (singularSSet X).ιChainComplex σ ≫
        adaptiveRhoSmallDegree K X U hU hcover r =
      Classical.choose
        (exists_small_lift_adaptiveRhoDegree K X U hU hcover r σ) := by
    exact Sigma.ι_desc _ σ
  rw [← Category.assoc, hiota]
  exact Classical.choose_spec
    (exists_small_lift_adaptiveRhoDegree K X U hU hcover r σ)

theorem adaptiveRhoDegree_d
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    adaptiveRhoDegree K X U hU hcover (r + 1) ≫
        (sSetChainComplex K (singularSSet X)).d (r + 1) r =
      (sSetChainComplex K (singularSSet X)).d (r + 1) r ≫
        adaptiveRhoDegree K X U hU hcover r := by
  rcases r with _ | r
  · simp only [adaptiveRhoDegree,
      adaptiveSingularPrismBoundaryDegree_succ,
      adaptiveSingularPrismBoundaryDegree_zero,
      Preadditive.add_comp, Preadditive.comp_add, Category.id_comp,
      Category.comp_id, Category.assoc,
      HomologicalComplex.d_comp_d,
      comp_zero, add_zero]
  · simp only [adaptiveRhoDegree,
      adaptiveSingularPrismBoundaryDegree_succ,
      Preadditive.add_comp, Preadditive.comp_add, Category.id_comp,
      Category.comp_id, Category.assoc,
      HomologicalComplex.d_comp_d, HomologicalComplex.d_comp_d_assoc,
      comp_zero, zero_comp, add_zero]

theorem adaptiveRhoDegree_augmentation
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    adaptiveRhoDegree K X U hU hcover 0 ≫
        sSetAugmentation K (singularSSet X) =
      sSetAugmentation K (singularSSet X) := by
  have haug :
      (sSetChainComplex K (singularSSet X)).d (0 + 1) 0 ≫
        sSetAugmentation K (singularSSet X) = 0 := by
    simpa using sSet_boundary_augmentation K (singularSSet X)
  simp only [adaptiveRhoDegree,
    adaptiveSingularPrismBoundaryDegree_zero, add_zero,
    Preadditive.add_comp, Category.id_comp, Category.assoc, haug,
    comp_zero, add_zero]

/-- The variable-depth ambient retraction formula as an augmented chain map. -/
noncomputable def augmentedAdaptiveRho
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    augmentedSingularChainComplex K X ⟶
      augmentedSingularChainComplex K X where
  f
    | 0 => 𝟙 _
    | r + 1 => adaptiveRhoDegree K X U hU hcover r
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      simpa using adaptiveRhoDegree_augmentation K X U hU hcover
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact adaptiveRhoDegree_d K X U hU hcover j

@[simp]
theorem augmentedAdaptiveRho_f_zero
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    (augmentedAdaptiveRho K X U hU hcover).f 0 = 𝟙 _ := rfl

@[simp]
theorem augmentedAdaptiveRho_f_succ
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    (augmentedAdaptiveRho K X U hU hcover).f (r + 1) =
      adaptiveRhoDegree K X U hU hcover r := rfl

/-- A degreewise linear left inverse to the small-chain inclusion.  It sends
non-small basis simplices to zero; no chain-map property is asserted. -/
noncomputable def smallSingularInclusionRetractionDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (r : ℕ) :
    (sSetChainComplex K (singularSSet X)).X r ⟶
      (sSetChainComplex K (smallSingularSSet U)).X r := by
  classical
  exact Sigma.desc (fun σ : singularSSet X _⦋r⦌ ↦
    if hσ : σ ∈ (smallSingularSubcomplex U).obj _ then
      (smallSingularSSet U).ιChainComplex
        (⟨σ, hσ⟩ : smallSingularSSet U _⦋r⦌)
    else 0)

theorem smallSingularInclusion_retraction
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (r : ℕ) :
    (SSet.chainComplexMap (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f r ≫
      smallSingularInclusionRetractionDegree K X U r = 𝟙 _ := by
  classical
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, SSet.ι_chainComplexMap_f, Category.comp_id]
  change (singularSSet X).ιChainComplex σ.1 ≫
      smallSingularInclusionRetractionDegree K X U r =
    (smallSingularSSet U).ιChainComplex σ
  have hiota : (singularSSet X).ιChainComplex σ.1 ≫
      smallSingularInclusionRetractionDegree K X U r =
    (if hσ : σ.1 ∈ (smallSingularSubcomplex U).obj _ then
      ((smallSingularSSet U).ιChainComplex
        (⟨σ.1, hσ⟩ : smallSingularSSet U _⦋r⦌) :
          ModuleCat.of K K ⟶
            (sSetChainComplex K (smallSingularSSet U)).X r)
    else (0 : ModuleCat.of K K ⟶
      (sSetChainComplex K (smallSingularSSet U)).X r)) := by
    exact Sigma.ι_desc _ σ.1
  rw [hiota]
  rw [dif_pos σ.2]
  congr 1

@[simp]
theorem augmentedSmallSingularInclusion_f_zero
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X) :
    (augmentedSmallSingularInclusion K U).f 0 = 𝟙 _ := rfl

@[simp]
theorem augmentedSmallSingularInclusion_f_succ
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (r : ℕ) :
    (augmentedSmallSingularInclusion K U).f (r + 1) =
      (SSet.chainComplexMap (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f r := rfl

noncomputable def augmentedSmallSingularInclusionRetractionDegree
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (i : ℕ) :
    (augmentedSingularChainComplex K X).X i ⟶
      (augmentedSmallSingularChainComplex K U).X i :=
  match i with
  | 0 => 𝟙 _
  | r + 1 => smallSingularInclusionRetractionDegree K X U r

theorem augmentedSmallSingularInclusion_retraction
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (i : ℕ) :
    (augmentedSmallSingularInclusion K U).f i ≫
      augmentedSmallSingularInclusionRetractionDegree K X U i = 𝟙 _ := by
  rcases i with _ | r
  · simp [augmentedSmallSingularInclusionRetractionDegree]
  · exact smallSingularInclusion_retraction K X U r

noncomputable def augmentedAdaptiveRhoSmallDegree
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (i : ℕ) :
    (augmentedSingularChainComplex K X).X i ⟶
      (augmentedSmallSingularChainComplex K U).X i :=
  match i with
  | 0 => 𝟙 _
  | r + 1 => adaptiveRhoSmallDegree K X U hU hcover r

theorem augmentedAdaptiveRhoSmallDegree_inclusion
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (i : ℕ) :
    augmentedAdaptiveRhoSmallDegree K X U hU hcover i ≫
        (augmentedSmallSingularInclusion K U).f i =
      (augmentedAdaptiveRho K X U hU hcover).f i := by
  rcases i with _ | r
  · simp [augmentedAdaptiveRhoSmallDegree]
  · exact adaptiveRhoSmallDegree_inclusion K X U hU hcover r

/-- The variable-depth retraction into cover-small augmented chains. -/
noncomputable def augmentedAdaptiveRhoSmall
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    augmentedSingularChainComplex K X ⟶
      augmentedSmallSingularChainComplex K U where
  f i := augmentedAdaptiveRhoSmallDegree K X U hU hcover i
  comm' i j hij := by
    let inc := augmentedSmallSingularInclusion K U
    let rho := augmentedAdaptiveRho K X U hU hcover
    let ret := augmentedSmallSingularInclusionRetractionDegree K X U j
    have hret : inc.f j ≫ ret = 𝟙 _ :=
      augmentedSmallSingularInclusion_retraction K X U j
    let _ : IsSplitMono (inc.f j) :=
      IsSplitMono.mk' { retraction := ret, id := hret }
    apply (cancel_mono (inc.f j)).1
    rw [Category.assoc, ← inc.comm, ← Category.assoc,
      augmentedAdaptiveRhoSmallDegree_inclusion,
      rho.comm, Category.assoc,
      augmentedAdaptiveRhoSmallDegree_inclusion]

@[simp]
theorem augmentedAdaptiveRhoSmall_f
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (i : ℕ) :
    (augmentedAdaptiveRhoSmall K X U hU hcover).f i =
      augmentedAdaptiveRhoSmallDegree K X U hU hcover i := rfl

theorem augmentedAdaptiveRhoSmall_inclusion
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    augmentedAdaptiveRhoSmall K X U hU hcover ≫
        augmentedSmallSingularInclusion K U =
      augmentedAdaptiveRho K X U hU hcover := by
  apply HomologicalComplex.hom_ext
  intro i
  exact augmentedAdaptiveRhoSmallDegree_inclusion K X U hU hcover i

theorem iota_adaptiveRhoDegree_of_small
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    ∀ {r : ℕ} (σ : singularSSet X _⦋r⦌),
      σ ∈ (smallSingularSubcomplex U).obj _ →
        (singularSSet X).ιChainComplex σ ≫
          adaptiveRhoDegree K X U hU hcover r =
            (singularSSet X).ιChainComplex σ := by
  intro r σ hσ
  rcases r with _ | r
  · rw [iota_adaptiveRhoDegree_zero]
    have hm := adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover σ hσ
    simp [hm, singularChainOfAffineList]
  · rw [iota_adaptiveRhoDegree_succ]
    have hm := adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover σ hσ
    have hface (i : Fin (r + 2)) :=
      smallSingularSubcomplex_face U σ i hσ
    have hmface (i : Fin (r + 2)) :=
      adaptiveSubdivisionDepth_eq_zero_of_small U hU hcover
        ((singularSSet X).δ i σ) (hface i)
    simp [hm, hmface, affinePrismTailTermList, singularChainOfAffineList]

theorem augmentedSmallInclusion_adaptiveRho
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    augmentedSmallSingularInclusion K U ≫
        augmentedAdaptiveRho K X U hU hcover =
      augmentedSmallSingularInclusion K U := by
  apply HomologicalComplex.hom_ext
  intro i
  rw [HomologicalComplex.comp_f]
  rcases i with _ | r
  · simp
  · change (SSet.chainComplexMap (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f r ≫ adaptiveRhoDegree K X U hU hcover r =
      (SSet.chainComplexMap (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f r
    apply SSet.chainComplex_hom_ext
    intro σ
    rw [← Category.assoc, SSet.ι_chainComplexMap_f]
    exact iota_adaptiveRhoDegree_of_small K X U hU hcover σ.1 σ.2

theorem augmentedSmallInclusion_adaptiveRhoSmall
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    augmentedSmallSingularInclusion K U ≫
        augmentedAdaptiveRhoSmall K X U hU hcover =
      𝟙 (augmentedSmallSingularChainComplex K U) := by
  apply HomologicalComplex.hom_ext
  intro i
  simp only [HomologicalComplex.comp_f, HomologicalComplex.id_f]
  let inc := augmentedSmallSingularInclusion K U
  let ret := augmentedSmallSingularInclusionRetractionDegree K X U i
  have hret : inc.f i ≫ ret = 𝟙 _ :=
    augmentedSmallSingularInclusion_retraction K X U i
  let _ : IsSplitMono (inc.f i) :=
    IsSplitMono.mk' { retraction := ret, id := hret }
  apply (cancel_mono (inc.f i)).1
  have hfac : (augmentedAdaptiveRhoSmall K X U hU hcover).f i ≫
      inc.f i = (augmentedAdaptiveRho K X U hU hcover).f i := by
    have h := congrArg (fun f ↦ f.f i)
      (augmentedAdaptiveRhoSmall_inclusion K X U hU hcover)
    simpa only [HomologicalComplex.comp_f] using h
  rw [Category.assoc, hfac, Category.id_comp]
  have h := congrArg (fun f ↦ f.f i)
    (augmentedSmallInclusion_adaptiveRho K X U hU hcover)
  exact h

/-- The variable prism as a map to the predecessor object of the augmented
complex. -/
def adaptiveAugmentedPrismToPrev
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (i : ℕ) :
    (augmentedSingularChainComplex K X).X i ⟶
      (augmentedSingularChainComplex K X).xPrev i :=
  match i with
  | 0 => 0
  | r + 1 => adaptiveSingularPrismDegree K X U hU hcover r ≫
      ((augmentedSingularChainComplex K X).xPrevIso
        (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv

@[simp]
theorem adaptiveAugmentedPrismToPrev_zero
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    adaptiveAugmentedPrismToPrev K X U hU hcover 0 = 0 := rfl

@[simp]
theorem adaptiveAugmentedPrismToPrev_succ
    (K : Type*) [Field K] (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ)
    (r : ℕ) :
    adaptiveAugmentedPrismToPrev K X U hU hcover (r + 1) =
      adaptiveSingularPrismDegree K X U hU hcover r ≫
        ((augmentedSingularChainComplex K X).xPrevIso
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)).inv := rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- The adaptive prism gives the homotopy from the ambient adaptive
retraction to the identity. -/
noncomputable def augmentedAdaptiveRhoHomotopy
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    _root_.Homotopy
      (augmentedAdaptiveRho K X U hU hcover)
      (𝟙 (augmentedSingularChainComplex K X)) := by
  let C := augmentedSingularChainComplex K X
  let hrel : ∀ i j, (ComplexShape.down ℕ).Rel j i → (C.X i ⟶ C.X j) :=
    fun i j hij ↦ adaptiveAugmentedPrismToPrev K X U hU hcover i ≫
      (C.xPrevIso hij).hom
  have hrel_zero : hrel 0 1 (by rfl) = 0 := by
    dsimp [hrel]
    rw [zero_comp]
  have hrel_succ (r : ℕ) : hrel (r + 1) (r + 2) (by rfl) =
      adaptiveSingularPrismDegree K X U hU hcover r := by
    dsimp [hrel]
    let hr : (ComplexShape.down ℕ).Rel (r + 2) (r + 1) := by rfl
    change (adaptiveSingularPrismDegree K X U hU hcover r ≫
        (C.xPrevIso hr).inv) ≫ (C.xPrevIso hr).hom = _
    rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hmap : Homotopy.nullHomotopicMap' hrel =
      augmentedAdaptiveRho K X U hU hcover - 𝟙 C := by
    apply HomologicalComplex.hom_ext
    intro i
    rcases i with _ | r
    · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left
          (show (ComplexShape.down ℕ).Rel 1 0 by rfl)]
      · rw [hrel_zero, zero_comp]
        change 0 = 𝟙 (ModuleCat.of K K) - 𝟙 (ModuleCat.of K K)
        rw [sub_self]
      · intro l hl
        simp at hl
    · rw [Homotopy.nullHomotopicMap'_f
          (show (ComplexShape.down ℕ).Rel (r + 2) (r + 1) by rfl)
          (show (ComplexShape.down ℕ).Rel (r + 1) r by rfl)]
      have hlower :
          C.d (r + 1) r ≫ hrel r (r + 1) (by rfl) =
            adaptiveSingularPrismBoundaryDegree K X U hU hcover r := by
        rcases r with _ | r
        · rw [hrel_zero, comp_zero]
          rfl
        · rw [hrel_succ]
          rfl
      have hupper :
          hrel (r + 1) (r + 2) (by rfl) ≫ C.d (r + 2) (r + 1) =
            adaptiveSingularPrismDegree K X U hU hcover r ≫
              (sSetChainComplex K (singularSSet X)).d (r + 1) r := by
        rw [hrel_succ]
        rfl
      have hneg : -(𝟙 ((sSetChainComplex K (singularSSet X)).X r)) = 𝟙 _ := by
        calc
          -(𝟙 ((sSetChainComplex K (singularSSet X)).X r)) =
              (-1 : K) • 𝟙 _ := by simp
          _ = (1 : K) • 𝟙 _ := by rw [CharTwo.neg_eq]
          _ = 𝟙 _ := one_smul _ _
      have hid : (𝟙 ((sSetChainComplex K (singularSSet X)).X r)) + 𝟙 _ = 0 :=
        charTwo_module_add_self_eq_zero K _
      have hdeg :
          adaptiveSingularPrismBoundaryDegree K X U hU hcover r +
              adaptiveSingularPrismDegree K X U hU hcover r ≫
                (sSetChainComplex K (singularSSet X)).d (r + 1) r =
            adaptiveRhoDegree K X U hU hcover r -
              𝟙 ((sSetChainComplex K (singularSSet X)).X r) := by
        simp only [adaptiveRhoDegree, sub_eq_add_neg, hneg]
        symm
        calc
          (𝟙 ((sSetChainComplex K (singularSSet X)).X r) +
                adaptiveSingularPrismDegree K X U hU hcover r ≫
                  (sSetChainComplex K (singularSSet X)).d (r + 1) r +
              adaptiveSingularPrismBoundaryDegree K X U hU hcover r) + 𝟙 _ =
              (𝟙 _ + 𝟙 _) +
                (adaptiveSingularPrismDegree K X U hU hcover r ≫
                    (sSetChainComplex K (singularSSet X)).d (r + 1) r +
                  adaptiveSingularPrismBoundaryDegree K X U hU hcover r) := by
                abel
          _ = adaptiveSingularPrismDegree K X U hU hcover r ≫
                (sSetChainComplex K (singularSSet X)).d (r + 1) r +
              adaptiveSingularPrismBoundaryDegree K X U hU hcover r := by
                rw [hid, zero_add]
          _ = adaptiveSingularPrismBoundaryDegree K X U hU hcover r +
              adaptiveSingularPrismDegree K X U hU hcover r ≫
                (sSetChainComplex K (singularSSet X)).d (r + 1) r := add_comm _ _
      rw [hlower, hupper]
      simp only [HomologicalComplex.sub_f_apply,
        augmentedAdaptiveRho_f_succ, HomologicalComplex.id_f]
      have hX : C.X (r + 1) =
          (sSetChainComplex K (singularSSet X)).X r := by
        exact augmentedSSetChainComplex_X_succ K (singularSSet X) r
      cases hX
      exact hdeg
  have hnull : _root_.Homotopy
      (augmentedAdaptiveRho K X U hU hcover - 𝟙 C) 0 := by
    rw [← hmap]
    exact Homotopy.nullHomotopy' hrel
  exact Homotopy.equivSubZero.symm hnull

/-- Inclusion after the small retraction is homotopic to the identity. -/
noncomputable def augmentedAdaptiveSmallRetractionHomotopy
    (K : Type*) [Field K] [CharP K 2]
    (X : TopCat) {I : Type*} (U : I → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcover : ⋃ i, U i = Set.univ) :
    _root_.Homotopy
      (augmentedAdaptiveRhoSmall K X U hU hcover ≫
        augmentedSmallSingularInclusion K U)
      (𝟙 (augmentedSingularChainComplex K X)) := by
  rw [augmentedAdaptiveRhoSmall_inclusion]
  exact augmentedAdaptiveRhoHomotopy K X U hU hcover

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Carried comparison from small singular chains to finite face chains

Pointwise support carriers of cover-small singular simplices are finite
augmented cones.  Their explicit cone contraction recursively produces a
carried reverse map from augmented star-small singular chains to the finite
augmented face complex.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

/-- Barycentric realization for a pre-simplicial complex. -/
def preGeom {m : ℕ} (C : PreAbstractSimplicialComplex (Fin m)) :
    Set (Fin m → ℝ) :=
  {x | (∀ v, 0 ≤ x v) ∧ (∑ v, x v) = 1 ∧
    SimplicialSphereAnisotropicity.barycentricSupport x ∈ C}

abbrev preGeomTop {m : ℕ} (C : PreAbstractSimplicialComplex (Fin m)) :=
  TopCat.of (preGeom C)

theorem preGeom_toPre_eq_geometricRealization {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    preGeom D.toPreAbstractSimplicialComplex =
      SimplicialSphereAnisotropicity.geometricRealization D := rfl

/-- The coordinate-open star of a vertex. -/
def openStar {m : ℕ} (C : PreAbstractSimplicialComplex (Fin m))
    (v : Fin m) : Set (preGeomTop C) :=
  {x | 0 < x.1 v}

theorem isOpen_openStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (v : Fin m) :
    IsOpen (openStar C v) := by
  exact isOpen_lt continuous_const
    ((continuous_apply v).comp continuous_subtype_val)

theorem exists_mem_openStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (x : preGeomTop C) :
    ∃ v : Fin m, x ∈ openStar C v := by
  have hsum : (∑ v, x.1 v) ≠ 0 := by
    rw [x.property.2.1]
    norm_num
  obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  exact ⟨v, lt_of_le_of_ne (x.property.1 v) (Ne.symm hv)⟩

theorem iUnion_openStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ⋃ v, openStar C v = Set.univ := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
  exact exists_mem_openStar C x

abbrev starSmallSingularSubcomplex {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :=
  smallSingularSubcomplex (openStar C)

abbrev starSmallSingularSSet {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) : SSet :=
  smallSingularSSet (openStar C)

/-- Pointwise support carrier of a singular simplex. -/
def supportCarrier {m : ℕ} (C : PreAbstractSimplicialComplex (Fin m))
    {Δ : SimplexCategory}
    (σ : (singularSSet (preGeomTop C)).obj (.op Δ)) :
    PreAbstractSimplicialComplex (Fin m) where
  faces := {G | ∃ t : stdSimplex ℝ (Fin (Δ.len + 1)),
    G.Nonempty ∧ G ⊆ SimplicialSphereAnisotropicity.barycentricSupport
      ((preGeomTop C).toSSetObjEquiv (.op Δ) σ t).1}
  isRelLowerSet_faces := by
    rintro G ⟨t, hGne, hG⟩
    exact ⟨hGne, fun H hHG hHne ↦ ⟨t, hHne, hHG.trans hG⟩⟩

theorem supportCarrier_le {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) {Δ : SimplexCategory}
    (σ : (singularSSet (preGeomTop C)).obj (.op Δ)) :
    supportCarrier C σ ≤ C := by
  intro G hG
  obtain ⟨t, hGne, hGsub⟩ := hG
  let x := (preGeomTop C).toSSetObjEquiv (.op Δ) σ t
  exact (C.isRelLowerSet_faces x.property.2.2).2 hGsub hGne

theorem supportCarrier_map_le {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    {Δ E : SimplexCategory} (f : E ⟶ Δ)
    (σ : (singularSSet (preGeomTop C)).obj (.op Δ)) :
    supportCarrier C ((singularSSet (preGeomTop C)).map f.op σ) ≤
      supportCarrier C σ := by
  intro G hG
  obtain ⟨t, hGne, hGsub⟩ := hG
  refine ⟨stdSimplex.map f t, hGne, ?_⟩
  change G ⊆ SimplicialSphereAnisotropicity.barycentricSupport
    ((preGeomTop C).toSSetObjEquiv (.op Δ) σ
      (stdSimplex.map f t)).1 at hGsub
  exact hGsub

theorem supportCarrier_point_mem {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) {Δ : SimplexCategory}
    (σ : (singularSSet (preGeomTop C)).obj (.op Δ))
    (t : stdSimplex ℝ (Fin (Δ.len + 1))) :
    ((preGeomTop C).toSSetObjEquiv (.op Δ) σ t).1 ∈
      preGeom (supportCarrier C σ) := by
  let x := (preGeomTop C).toSSetObjEquiv (.op Δ) σ t
  refine ⟨x.property.1, x.property.2.1, ?_⟩
  exact ⟨t, (C.isRelLowerSet_faces x.property.2.2).1,
    Finset.Subset.rfl⟩

/-- The simplex lifted to the realization of its own support carrier. -/
noncomputable def supportCarrierLift {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : singularSSet (preGeomTop C) _⦋q⦌) :
    singularSSet (preGeomTop (supportCarrier C σ)) _⦋q⦌ :=
  (preGeomTop (supportCarrier C σ)).toSSetObjEquiv _ |>.symm
    ⟨fun t ↦ ⟨((preGeomTop C).toSSetObjEquiv _ σ t).1,
        supportCarrier_point_mem C σ t⟩,
      Continuous.subtype_mk
        (continuous_subtype_val.comp
          ((preGeomTop C).toSSetObjEquiv _ σ).continuous) _⟩

/-- Inclusion of realizations induced by inclusion of pre-complexes. -/
def preGeomMapOfLE {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C) :
    preGeomTop L ⟶ preGeomTop C :=
  TopCat.ofHom
    ⟨fun x ↦ ⟨x.1, x.property.1, x.property.2.1,
        h x.property.2.2⟩,
      Continuous.subtype_mk continuous_subtype_val _⟩

@[simp]
theorem preGeomMapOfLE_apply {m : ℕ}
    {C L : PreAbstractSimplicialComplex (Fin m)} (h : L ≤ C)
    (x : preGeomTop L) :
    (preGeomMapOfLE h x).1 = x.1 := rfl

theorem supportCarrierLift_map_inclusion {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : singularSSet (preGeomTop C) _⦋q⦌) :
    (TopCat.toSSet.map
        (preGeomMapOfLE (supportCarrier_le C σ))).app
          (Opposite.op (SimplexCategory.mk q))
      (supportCarrierLift C σ) = σ := by
  apply Equiv.injective
    ((preGeomTop C).toSSetObjEquiv
      (Opposite.op (SimplexCategory.mk q)))
  ext t v
  rfl

/-- A full simplex on a fixed finite vertex set, in the nonempty-face model. -/
def faceSimplex {m : ℕ} (F : Finset (Fin m)) :
    PreAbstractSimplicialComplex (Fin m) where
  faces := {G | G.Nonempty ∧ G ⊆ F}
  isRelLowerSet_faces := by
    rintro G ⟨hGne, hGF⟩
    exact ⟨hGne, fun H hHG hHne ↦ ⟨hHne, hHG.trans hGF⟩⟩

theorem supportCarrier_le_faceSimplex {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) {Δ : SimplexCategory}
    (σ : (singularSSet (preGeomTop C)).obj (.op Δ))
    (F : Finset (Fin m))
    (hF : ∀ t : stdSimplex ℝ (Fin (Δ.len + 1)),
      SimplicialSphereAnisotropicity.barycentricSupport
        ((preGeomTop C).toSSetObjEquiv (.op Δ) σ t).1 ⊆ F) :
    supportCarrier C σ ≤ faceSimplex F := by
  rintro G ⟨t, hGne, hG⟩
  exact ⟨hGne, hG.trans (hF t)⟩

/-- Chosen open-star witness for a small singular simplex. -/
noncomputable def starApex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) : Fin m :=
  Classical.choose σ.2

theorem starApex_positive {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (t : stdSimplex ℝ (Fin (q + 1))) :
    0 < ((preGeomTop C).toSSetObjEquiv _ σ.1 t).1 (starApex C σ) := by
  exact Classical.choose_spec σ.2 ⟨t, rfl⟩

theorem starApex_mem_support {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (t : stdSimplex ℝ (Fin (q + 1))) :
    starApex C σ ∈ SimplicialSphereAnisotropicity.barycentricSupport
      ((preGeomTop C).toSSetObjEquiv _ σ.1 t).1 := by
  rw [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter]
  exact ⟨Finset.mem_univ _, ne_of_gt (starApex_positive C σ t)⟩

theorem starApex_singleton_mem_supportCarrier {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    {starApex C σ} ∈ supportCarrier C σ.1 := by
  let t : stdSimplex ℝ (Fin (q + 1)) :=
    ⟨Pi.single 0 1, single_mem_stdSimplex ℝ 0⟩
  refine ⟨t, Finset.singleton_nonempty _, ?_⟩
  exact Finset.singleton_subset_iff.mpr (starApex_mem_support C σ t)

theorem supportCarrier_insert_starApex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    {G : Finset (Fin m)} (hG : G ∈ supportCarrier C σ.1) :
    insert (starApex C σ) G ∈ supportCarrier C σ.1 := by
  obtain ⟨t, hGne, hGsub⟩ := hG
  refine ⟨t, Finset.insert_nonempty _ _, ?_⟩
  exact Finset.insert_subset (starApex_mem_support C σ t) hGsub

theorem supportCarrierAugmented_insert_starApex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    {G : Finset (Fin m)}
    (hG : G ∈ AugmentedComplex.ofPre (supportCarrier C σ.1)) :
    insert (starApex C σ) G ∈
      AugmentedComplex.ofPre (supportCarrier C σ.1) := by
  rcases hG with rfl | hG
  · exact Or.inr (by simpa using starApex_singleton_mem_supportCarrier C σ)
  · exact Or.inr (supportCarrier_insert_starApex C σ hG)

/-- A face of a subcomplex, regarded as a face of a larger complex. -/
def augmentedSimplexOfLE {V : Type*} {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D)
    {q : ℕ} (F : AugmentedSimplex C q) :
    AugmentedSimplex D q :=
  ⟨F.1, h F.2.1, F.2.2⟩

@[simp]
theorem augmentedSimplexOfLE_val {V : Type*}
    {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) {q : ℕ}
    (F : AugmentedSimplex C q) :
    (augmentedSimplexOfLE h F).1 = F.1 := rfl

theorem augmentedSimplexOfLE_injective {V : Type*}
    {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) {q : ℕ} :
    Function.Injective (augmentedSimplexOfLE h :
      AugmentedSimplex C q → AugmentedSimplex D q) := by
  intro F G hFG
  apply Subtype.ext
  exact congrArg (fun H : AugmentedSimplex D q ↦ H.1) hFG

/-- Degreewise inclusion of augmented face chains. -/
def faceChainInclusionDegree (K : Type*) [Field K]
    {V : Type*} {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ) :
    AugmentedChain K C q →ₗ[K] AugmentedChain K D q :=
  Finsupp.linearCombination K (fun F ↦
    Finsupp.single (augmentedSimplexOfLE h F) 1)

@[simp]
theorem faceChainInclusionDegree_single (K : Type*) [Field K]
    {V : Type*} {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ)
    (F : AugmentedSimplex C q) (a : K) :
    faceChainInclusionDegree K h q (Finsupp.single F a) =
      Finsupp.single (augmentedSimplexOfLE h F) a := by
  rw [faceChainInclusionDegree, Finsupp.linearCombination_single]
  simp

theorem faceChainInclusionDegree_eq_lmapDomain (K : Type*) [Field K]
    {V : Type*} {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ) :
    faceChainInclusionDegree K h q =
      Finsupp.lmapDomain K K (augmentedSimplexOfLE h) := by
  apply Finsupp.lhom_ext
  intro F a
  simp [faceChainInclusionDegree_single]

theorem faceChainInclusionDegree_injective (K : Type*) [Field K]
    {V : Type*} {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ) :
    Function.Injective (faceChainInclusionDegree K h q) := by
  rw [faceChainInclusionDegree_eq_lmapDomain]
  exact Finsupp.mapDomain_injective (augmentedSimplexOfLE_injective h)

theorem faceChainInclusionDegree_comp (K : Type*) [Field K]
    {V : Type*} {B C D : AugmentedComplex V}
    (hBC : ∀ ⦃F : Finset V⦄, F ∈ B → F ∈ C)
    (hCD : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D)
    (hBD : ∀ ⦃F : Finset V⦄, F ∈ B → F ∈ D)
    (q : ℕ) :
    (faceChainInclusionDegree K hCD q).comp
        (faceChainInclusionDegree K hBC q) =
      faceChainInclusionDegree K hBD q := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceChainInclusionDegree_single]
  apply congrArg (fun G : AugmentedSimplex D q ↦ Finsupp.single G a)
  apply Subtype.ext
  rfl

theorem augmentedSimplexOfLE_erase {V : Type*} [DecidableEq V]
    {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) {q : ℕ}
    (F : AugmentedSimplex C (q + 1)) (v : ↥F.1) :
    augmentedSimplexOfLE h (eraseSimplex C F v) =
      eraseSimplex D (augmentedSimplexOfLE h F)
        ⟨v.1, v.2⟩ := by
  apply Subtype.ext
  rfl

theorem faceChainInclusion_boundary (K : Type*) [Field K]
    {V : Type*} [DecidableEq V] {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ) :
    (faceBoundary K D q).comp (faceChainInclusionDegree K h (q + 1)) =
      (faceChainInclusionDegree K h q).comp (faceBoundary K C q) := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceChainInclusionDegree_single,
    faceBoundary_single, map_smul]
  congr 1
  simp only [boundaryOnSimplex, map_sum,
    faceChainInclusionDegree_single]
  change (∑ v : ↥F.1,
      Finsupp.single
        (eraseSimplex D (augmentedSimplexOfLE h F) ⟨v.1, v.2⟩) 1) =
    ∑ v : ↥F.1,
      Finsupp.single
        (augmentedSimplexOfLE h (eraseSimplex C F v)) 1
  apply Finset.sum_congr rfl
  intro v hv
  rw [augmentedSimplexOfLE_erase]

/-- Inclusion of augmented face-chain complexes along a face-family
inclusion. -/
def faceChainInclusion (K : Type*) [Field K] [CharP K 2]
    {V : Type*} [DecidableEq V] {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) :
    faceChainComplex K C ⟶ faceChainComplex K D where
  f q := ModuleCat.ofHom (faceChainInclusionDegree K h q)
  comm' i j hij := by
    have hi : j + 1 = i := by simpa using hij
    subst i
    apply ModuleCat.hom_ext
    rw [faceChainComplex_d, faceChainComplex_d]
    change (faceBoundary K D j).comp
        (faceChainInclusionDegree K h (j + 1)) =
      (faceChainInclusionDegree K h j).comp (faceBoundary K C j)
    exact faceChainInclusion_boundary K h j

@[simp]
theorem faceChainInclusion_f (K : Type*) [Field K] [CharP K 2]
    {V : Type*} [DecidableEq V] {C D : AugmentedComplex V}
    (h : ∀ ⦃F : Finset V⦄, F ∈ C → F ∈ D) (q : ℕ) :
    (faceChainInclusion K h).f q =
      ModuleCat.ofHom (faceChainInclusionDegree K h q) := rfl

def finsetInsertSubtypeEquiv {V : Type*} [DecidableEq V]
    {v : V} {F : Finset V} (hv : v ∉ F) :
    ↥(insert v F) ≃ ↥F ⊕ PUnit :=
  (Equiv.setCongr (by ext x; simp)).trans
    (Equiv.Set.insert (s := (↑F : Set V)) hv)

@[simp]
theorem finsetInsertSubtypeEquiv_symm_inl {V : Type*} [DecidableEq V]
    {v : V} {F : Finset V} (hv : v ∉ F) (w : ↥F) :
    (finsetInsertSubtypeEquiv hv).symm (Sum.inl w) =
      ⟨w.1, Finset.mem_insert_of_mem w.2⟩ := by
  apply Subtype.ext
  rfl

@[simp]
theorem finsetInsertSubtypeEquiv_symm_inr {V : Type*} [DecidableEq V]
    {v : V} {F : Finset V} (hv : v ∉ F) (u : PUnit) :
    (finsetInsertSubtypeEquiv hv).symm (Sum.inr u) =
      ⟨v, Finset.mem_insert_self v F⟩ := by
  apply Subtype.ext
  rcases u with ⟨⟩
  rfl

theorem sum_finsetInsertSubtype {V M : Type*} [DecidableEq V]
    [AddCommMonoid M] {v : V} {F : Finset V} (hv : v ∉ F)
    (f : ↥(insert v F) → M) :
    (∑ w, f w) = f ⟨v, Finset.mem_insert_self v F⟩ +
      ∑ w : ↥F, f ⟨w.1, Finset.mem_insert_of_mem w.2⟩ := by
  rw [Fintype.sum_equiv (finsetInsertSubtypeEquiv hv) f
    (fun y ↦ f ((finsetInsertSubtypeEquiv hv).symm y)) (by simp)]
  rw [Fintype.sum_sum_type]
  simp [add_comm]

/-- Insert a cone apex into an augmented face not already containing it. -/
def insertAugmentedSimplex {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    {q : ℕ} (F : AugmentedSimplex C q) (hv : v ∉ F.1) :
    AugmentedSimplex C (q + 1) :=
  ⟨insert v F.1, hcone F.2.1, by
    rw [Finset.card_insert_of_notMem hv, F.2.2]⟩

@[simp]
theorem insertAugmentedSimplex_val {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    {q : ℕ} (F : AugmentedSimplex C q) (hv : v ∉ F.1) :
    (insertAugmentedSimplex C v hcone F hv).1 = insert v F.1 := rfl

theorem erase_insertAugmentedSimplex_apex {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    {q : ℕ} (F : AugmentedSimplex C q) (hv : v ∉ F.1) :
    eraseSimplex C (insertAugmentedSimplex C v hcone F hv)
        ⟨v, Finset.mem_insert_self v F.1⟩ = F := by
  apply Subtype.ext
  exact Finset.erase_insert hv

theorem erase_insertAugmentedSimplex_old {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    {q : ℕ} (F : AugmentedSimplex C (q + 1)) (hv : v ∉ F.1)
    (w : ↥F.1) :
    eraseSimplex C (insertAugmentedSimplex C v hcone F hv)
        ⟨w.1, Finset.mem_insert_of_mem w.2⟩ =
      insertAugmentedSimplex C v hcone (eraseSimplex C F w)
        (by exact fun h ↦ hv (Finset.mem_of_mem_erase h)) := by
  apply Subtype.ext
  change (insert v F.1).erase w.1 = insert v (F.1.erase w.1)
  have hwv : w.1 ≠ v := fun h ↦ hv (h ▸ w.2)
  exact Finset.erase_insert_of_ne hwv.symm

/-- Cone insertion on one augmented face, zero when the apex is already
present. -/
def faceConeOn (K : Type*) [Field K] {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) (F : AugmentedSimplex C q) : AugmentedChain K C (q + 1) :=
  if hv : v ∈ F.1 then 0
  else Finsupp.single (insertAugmentedSimplex C v hcone F hv) 1

/-- Linear cone insertion on augmented face chains. -/
def faceCone (K : Type*) [Field K] {V : Type*} [DecidableEq V]
    (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) : AugmentedChain K C q →ₗ[K] AugmentedChain K C (q + 1) :=
  Finsupp.linearCombination K (faceConeOn K C v hcone q)

@[simp]
theorem faceCone_single (K : Type*) [Field K]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) (F : AugmentedSimplex C q) (a : K) :
    faceCone K C v hcone q (Finsupp.single F a) =
      a • faceConeOn K C v hcone q F := by
  exact Finsupp.linearCombination_single K a F

theorem faceBoundary_faceConeOn_of_not_mem (K : Type*) [Field K]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) (F : AugmentedSimplex C (q + 1)) (hv : v ∉ F.1) :
    faceBoundary K C (q + 1) (faceConeOn K C v hcone (q + 1) F) =
      Finsupp.single F 1 +
        faceCone K C v hcone q (boundaryOnSimplex K C q F) := by
  rw [faceConeOn, dif_neg hv, faceBoundary_single, one_smul]
  simp only [boundaryOnSimplex]
  change (∑ w : ↥(insert v F.1),
      Finsupp.single
        (eraseSimplex C (insertAugmentedSimplex C v hcone F hv)
          ⟨w.1, w.2⟩) 1) = _
  rw [sum_finsetInsertSubtype hv,
    erase_insertAugmentedSimplex_apex]
  simp only [map_sum, faceCone_single, one_smul]
  apply congrArg (fun z ↦ Finsupp.single F 1 + z)
  apply Finset.sum_congr rfl
  intro w hw
  rw [erase_insertAugmentedSimplex_old]
  rw [faceConeOn, dif_neg]

theorem faceCone_boundaryOn_of_mem (K : Type*) [Field K]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) (F : AugmentedSimplex C (q + 1)) (hv : v ∈ F.1) :
    faceCone K C v hcone q (boundaryOnSimplex K C q F) =
      Finsupp.single F 1 := by
  simp only [boundaryOnSimplex, map_sum, faceCone_single, one_smul]
  let apex : ↥F.1 := ⟨v, hv⟩
  rw [Finset.sum_eq_single apex]
  · have hnot : v ∉ (eraseSimplex C F apex).1 := by
      exact Finset.notMem_erase v F.1
    rw [faceConeOn, dif_neg hnot]
    apply congrArg (fun G : AugmentedSimplex C (q + 1) ↦
      Finsupp.single G (1 : K))
    apply Subtype.ext
    exact Finset.insert_erase hv
  · intro w hw hwa
    have hwv : w.1 ≠ v := by
      intro h
      apply hwa
      apply Subtype.ext
      exact h
    rw [faceConeOn, dif_pos]
    exact Finset.mem_erase.mpr ⟨hwv.symm, hv⟩
  · intro h
    exact (h (Finset.mem_univ apex)).elim

theorem faceBoundary_faceConeOn_zero (K : Type*) [Field K]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (F : AugmentedSimplex C 0) :
    faceBoundary K C 0 (faceConeOn K C v hcone 0 F) =
      Finsupp.single F 1 := by
  have hF : F.1 = ∅ := Finset.card_eq_zero.mp F.2.2
  have hv : v ∉ F.1 := by simp [hF]
  rw [faceConeOn, dif_neg hv, faceBoundary_single, one_smul]
  simp only [boundaryOnSimplex]
  change (∑ w : ↥(insert v F.1),
      Finsupp.single
        (eraseSimplex C (insertAugmentedSimplex C v hcone F hv)
          ⟨w.1, w.2⟩) 1) = _
  rw [sum_finsetInsertSubtype hv,
    erase_insertAugmentedSimplex_apex]
  let _ : IsEmpty ↥F.1 :=
    ⟨fun w ↦ by simpa [hF] using w.2⟩
  simp

theorem faceCone_contractionOn_succ (K : Type*) [Field K] [CharP K 2]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) (F : AugmentedSimplex C (q + 1)) :
    faceBoundary K C (q + 1) (faceConeOn K C v hcone (q + 1) F) +
        faceCone K C v hcone q (boundaryOnSimplex K C q F) =
      Finsupp.single F 1 := by
  by_cases hv : v ∈ F.1
  · rw [faceConeOn, dif_pos hv, map_zero, zero_add,
      faceCone_boundaryOn_of_mem K C v hcone q F hv]
  · rw [faceBoundary_faceConeOn_of_not_mem K C v hcone q F hv]
    rw [add_assoc,
      charTwo_module_add_self_eq_zero K
        (faceCone K C v hcone q (boundaryOnSimplex K C q F)),
      add_zero]

theorem faceCone_contraction_zero (K : Type*) [Field K] [CharP K 2]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C) :
    (faceBoundary K C 0).comp (faceCone K C v hcone 0) =
      LinearMap.id := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.comp_apply, faceCone_single, map_smul,
    faceBoundary_faceConeOn_zero K C v hcone F, LinearMap.id_apply]
  simp

theorem faceCone_contraction_succ (K : Type*) [Field K] [CharP K 2]
    {V : Type*} [DecidableEq V] (C : AugmentedComplex V) (v : V)
    (hcone : ∀ {G : Finset V}, G ∈ C → insert v G ∈ C)
    (q : ℕ) :
    (faceBoundary K C (q + 1)).comp (faceCone K C v hcone (q + 1)) +
        (faceCone K C v hcone q).comp (faceBoundary K C q) =
      LinearMap.id := by
  apply Finsupp.lhom_ext
  intro F a
  simp only [LinearMap.add_apply, LinearMap.comp_apply, faceCone_single,
    map_smul, faceBoundary_single, LinearMap.id_apply]
  rw [← smul_add, faceCone_contractionOn_succ K C v hcone q F]
  simp

abbrev augmentedSupportCarrier {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) : AugmentedComplex (Fin m) :=
  AugmentedComplex.ofPre (supportCarrier C σ.1)

theorem augmentedSupportCarrier_le {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ augmentedSupportCarrier C σ → G ∈ AugmentedComplex.ofPre C := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr (supportCarrier_le C σ.1 hG)

/-- A face of a small singular simplex, retaining its smallness proof. -/
def starSmallFace {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q + 1⦌) (i : Fin (q + 2)) :
    starSmallSingularSSet C _⦋q⦌ :=
  ⟨(singularSSet (preGeomTop C)).δ i σ.1,
    smallSingularSubcomplex_face (openStar C) σ.1 i σ.2⟩

@[simp]
theorem starSmallFace_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q + 1⦌) (i : Fin (q + 2)) :
    (starSmallFace C σ i).1 =
      (singularSSet (preGeomTop C)).δ i σ.1 := rfl

theorem augmentedSupportCarrier_face_le {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q + 1⦌) (i : Fin (q + 2)) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ augmentedSupportCarrier C (starSmallFace C σ i) →
        G ∈ augmentedSupportCarrier C σ := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr
      (supportCarrier_map_le C (SimplexCategory.δ i) σ.1 hG)

def emptyAugmentedSimplex {V : Type*} (C : AugmentedComplex V) :
    AugmentedSimplex C 0 :=
  ⟨∅, C.empty_mem, Finset.card_empty⟩

@[simp]
theorem emptyAugmentedSimplex_val {V : Type*} (C : AugmentedComplex V) :
    (emptyAugmentedSimplex C).1 = ∅ := rfl

/-- The recursive reverse chain, constructed first inside the simplex's own
support carrier. -/
noncomputable def reverseLocalOn
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    ∀ σ : starSmallSingularSSet C _⦋q⦌,
      AugmentedChain K (augmentedSupportCarrier C σ) (q + 1) :=
  Nat.rec (motive := fun q ↦ ∀ σ : starSmallSingularSSet C _⦋q⦌,
      AugmentedChain K (augmentedSupportCarrier C σ) (q + 1))
    (fun σ ↦
      faceCone K (augmentedSupportCarrier C σ) (starApex C σ)
        (supportCarrierAugmented_insert_starApex C σ) 0
        (Finsupp.single
          (emptyAugmentedSimplex (augmentedSupportCarrier C σ)) 1))
    (fun q ih σ ↦
      faceCone K (augmentedSupportCarrier C σ) (starApex C σ)
        (supportCarrierAugmented_insert_starApex C σ) (q + 1)
        (∑ i : Fin (q + 2),
          faceChainInclusionDegree K
            (augmentedSupportCarrier_face_le C σ i) (q + 1)
            (ih (starSmallFace C σ i))))
    q

/-- The recursively assembled boundary which is coned to define
`reverseLocalOn`. -/
noncomputable def reverseLocalBoundary
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    ∀ σ : starSmallSingularSSet C _⦋q⦌,
      AugmentedChain K (augmentedSupportCarrier C σ) q :=
  Nat.rec (motive := fun q ↦ ∀ σ : starSmallSingularSSet C _⦋q⦌,
      AugmentedChain K (augmentedSupportCarrier C σ) q)
    (fun σ ↦ Finsupp.single
      (emptyAugmentedSimplex (augmentedSupportCarrier C σ)) 1)
    (fun q _ σ ↦ ∑ i : Fin (q + 2),
      faceChainInclusionDegree K
        (augmentedSupportCarrier_face_le C σ i) (q + 1)
        (reverseLocalOn K C q (starSmallFace C σ i)))
    q

theorem reverseLocalOn_eq_faceCone
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (q : ℕ) (σ : starSmallSingularSSet C _⦋q⦌) :
    reverseLocalOn K C q σ =
      faceCone K (augmentedSupportCarrier C σ) (starApex C σ)
        (supportCarrierAugmented_insert_starApex C σ) q
        (reverseLocalBoundary K C q σ) := by
  rcases q with _ | q <;> rfl

/-- The local reverse chain included into the ambient finite face complex. -/
noncomputable def reverseOn
    (K : Type*) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) :=
  faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) (q + 1)
    (reverseLocalOn K C q σ)

/-- The reverse image of one generator, typed in the corresponding face-chain
degree. -/
noncomputable def reverseGenerator
    (K : Type*) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    ModuleCat.of K K ⟶
      (faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1) :=
  ModuleCat.ofHom
    (LinearMap.toSpanSingleton K _ (reverseOn K C σ))

@[simp]
theorem reverseGenerator_hom
    (K : Type*) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌) :
    (reverseGenerator K C σ).hom =
      LinearMap.toSpanSingleton K _ (reverseOn K C σ) := rfl

/-- Ordinary-degree reverse map on cover-small singular chains. -/
noncomputable def reverseDegree
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    ((starSmallSingularSSet C).chainComplex (ModuleCat.of K K)).X q ⟶
      (faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1) :=
  Sigma.desc (fun σ : starSmallSingularSSet C _⦋q⦌ ↦
    reverseGenerator K C σ)

@[reassoc]
theorem iota_reverseDegree
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q⦌) :
    (starSmallSingularSSet C).ιChainComplex σ ≫ reverseDegree K C q =
      reverseGenerator K C σ := by
  exact Sigma.ι_desc _ σ

theorem iota_chainComplex_d_charTwo
    (K : Type*) [Field K] [CharP K 2] (X : SSet.{0})
    (q : ℕ) (σ : X _⦋q + 1⦌) :
    X.ιChainComplex σ ≫
        (X.chainComplex (ModuleCat.of K K)).d (q + 1) q =
      ∑ i : Fin (q + 2), X.ιChainComplex (X.δ i σ) := by
  rw [SSet.ιChainComplex_d]
  apply Finset.sum_congr rfl
  intro i hi
  exact charTwo_int_neg_one_pow_smul K i.val _

theorem sum_reverseOn_face_face_eq_zero
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (r : ℕ)
    (σ : starSmallSingularSSet C _⦋r + 2⦌) :
    (∑ i : Fin (r + 3), ∑ j : Fin (r + 2),
      reverseOn K C (starSmallFace C (starSmallFace C σ i) j)) = 0 := by
  let X := starSmallSingularSSet C
  let ι : ModuleCat.of K K ⟶
      (X.chainComplex (ModuleCat.of K K)).X (r + 2) :=
    X.ιChainComplex σ
  let d₁ := (X.chainComplex (ModuleCat.of K K)).d (r + 2) (r + 1)
  let d₂ := (X.chainComplex (ModuleCat.of K K)).d (r + 1) r
  let R := reverseDegree K C r
  have hzero : ι ≫ d₁ ≫ d₂ ≫ R = 0 := by
    rw [← Category.assoc d₁ d₂ R]
    have hdd : d₁ ≫ d₂ = 0 := by
      exact HomologicalComplex.d_comp_d
        (X.chainComplex (ModuleCat.of K K)) (r + 2) (r + 1) r
    rw [hdd, zero_comp, comp_zero]
  rw [← Category.assoc ι d₁ (d₂ ≫ R)] at hzero
  dsimp only [ι, d₁] at hzero
  rw [iota_chainComplex_d_charTwo] at hzero
  simp only [Preadditive.sum_comp] at hzero
  simp_rw [← Category.assoc] at hzero
  dsimp only [d₂] at hzero
  simp_rw [iota_chainComplex_d_charTwo] at hzero
  simp only [Preadditive.sum_comp] at hzero
  dsimp only [R, X] at hzero
  simp_rw [iota_reverseDegree] at hzero
  let z : AugmentedChain K (AugmentedComplex.ofPre C) (r + 1) :=
    ∑ i : Fin (r + 3), ∑ j : Fin (r + 2),
      reverseOn K C
        ((starSmallSingularSSet C).δ j
          ((starSmallSingularSSet C).δ i σ))
  have hmaps :
      (∑ i : Fin (r + 3), ∑ j : Fin (r + 2),
        ModuleCat.ofHom (LinearMap.toSpanSingleton K _
          (reverseOn K C
            ((starSmallSingularSSet C).δ j
              ((starSmallSingularSSet C).δ i σ))))) =
        ModuleCat.ofHom (LinearMap.toSpanSingleton K _ z) := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    simp only [ModuleCat.hom_sum, ModuleCat.hom_ofHom,
      LinearMap.sum_apply, LinearMap.toSpanSingleton_apply]
    dsimp only [z]
    simp only [Finset.smul_sum]
  have hzero' : ModuleCat.ofHom (LinearMap.toSpanSingleton K _ z) = 0 :=
    hmaps.symm.trans hzero
  have hlin := congrArg ModuleCat.Hom.hom hzero'
  have hz : z = 0 := by
    apply LinearMap.toSpanSingleton_injective K _
    rw [LinearMap.toSpanSingleton_zero]
    simpa only [ModuleCat.hom_zero, ModuleCat.hom_ofHom] using hlin
  change z = 0
  exact hz

theorem reverseLocalBoundary_inclusion_zero
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋0⦌) :
    faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) 0
        (reverseLocalBoundary K C 0 σ) =
      Finsupp.single
        (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1 := by
  change faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) 0
      (Finsupp.single
        (emptyAugmentedSimplex (augmentedSupportCarrier C σ)) 1) = _
  rw [faceChainInclusionDegree_single]
  apply congrArg (fun F : AugmentedSimplex (AugmentedComplex.ofPre C) 0 ↦
    Finsupp.single F (1 : K))
  apply Subtype.ext
  rfl

theorem reverseLocalBoundary_inclusion_succ
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q + 1⦌) :
    faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) (q + 1)
        (reverseLocalBoundary K C (q + 1) σ) =
      ∑ i : Fin (q + 2), reverseOn K C (starSmallFace C σ i) := by
  rw [reverseLocalBoundary, map_sum]
  apply Finset.sum_congr rfl
  intro i hi
  let τ := starSmallFace C σ i
  let c := reverseLocalOn K C q τ
  have hcomp := faceChainInclusionDegree_comp K
    (augmentedSupportCarrier_face_le C σ i)
    (augmentedSupportCarrier_le C σ)
    (augmentedSupportCarrier_le C τ) (q + 1)
  have hc := LinearMap.congr_fun hcomp c
  simpa only [c, τ, LinearMap.comp_apply, reverseOn] using hc

theorem reverseOn_boundary_of_local
    (K : Type*) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (hlocal : faceBoundary K (augmentedSupportCarrier C σ) q
        (reverseLocalOn K C q σ) = reverseLocalBoundary K C q σ) :
    faceBoundary K (AugmentedComplex.ofPre C) q (reverseOn K C σ) =
      faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) q
        (reverseLocalBoundary K C q σ) := by
  have hcomm := LinearMap.congr_fun
    (faceChainInclusion_boundary K (augmentedSupportCarrier_le C σ) q)
    (reverseLocalOn K C q σ)
  simpa only [LinearMap.comp_apply, reverseOn, hlocal] using hcomm

theorem reverseLocalOn_boundary
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ∀ (q : ℕ) (σ : starSmallSingularSSet C _⦋q⦌),
      faceBoundary K (augmentedSupportCarrier C σ) q
          (reverseLocalOn K C q σ) = reverseLocalBoundary K C q σ := by
  intro q
  induction q with
  | zero =>
      intro σ
      rw [reverseLocalOn_eq_faceCone]
      change faceBoundary K (augmentedSupportCarrier C σ) 0
          (faceCone K (augmentedSupportCarrier C σ) (starApex C σ)
            (supportCarrierAugmented_insert_starApex C σ) 0
            (Finsupp.single
              (emptyAugmentedSimplex (augmentedSupportCarrier C σ)) 1)) = _
      rw [faceCone_single, one_smul,
        faceBoundary_faceConeOn_zero]
      rfl
  | succ q ih =>
      intro σ
      let A := augmentedSupportCarrier C σ
      let y := reverseLocalBoundary K C (q + 1) σ
      have hycycle : faceBoundary K A q y = 0 := by
        apply faceChainInclusionDegree_injective K
          (augmentedSupportCarrier_le C σ) q
        rw [map_zero]
        have hcomm := LinearMap.congr_fun
          (faceChainInclusion_boundary K
            (augmentedSupportCarrier_le C σ) q) y
        rw [LinearMap.comp_apply, LinearMap.comp_apply] at hcomm
        change faceChainInclusionDegree K
            (augmentedSupportCarrier_le C σ) q
            (faceBoundary K (augmentedSupportCarrier C σ) q y) = 0
        rw [← hcomm]
        rw [reverseLocalBoundary_inclusion_succ]
        rw [map_sum]
        simp_rw [reverseOn_boundary_of_local K C _ (ih _)]
        rcases q with _ | r
        · simp_rw [reverseLocalBoundary_inclusion_zero]
          rw [Fin.sum_univ_two]
          exact charTwo_module_add_self_eq_zero K _
        · simp_rw [reverseLocalBoundary_inclusion_succ]
          exact sum_reverseOn_face_face_eq_zero K C r σ
      rw [reverseLocalOn_eq_faceCone]
      have hcon := LinearMap.congr_fun
        (faceCone_contraction_succ K A (starApex C σ)
          (supportCarrierAugmented_insert_starApex C σ) q) y
      simp only [LinearMap.add_apply, LinearMap.comp_apply,
        LinearMap.id_apply] at hcon
      rw [hycycle, map_zero, add_zero] at hcon
      exact hcon

theorem reverseOn_boundary_zero
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋0⦌) :
    faceBoundary K (AugmentedComplex.ofPre C) 0 (reverseOn K C σ) =
      Finsupp.single
        (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1 := by
  have hlocal : faceBoundary K (augmentedSupportCarrier C σ) 0
      (reverseLocalOn K C 0 σ) = reverseLocalBoundary K C 0 σ := by
    apply reverseLocalOn_boundary
  calc
    faceBoundary K (AugmentedComplex.ofPre C) 0 (reverseOn K C σ) =
        faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) 0
          (reverseLocalBoundary K C 0 σ) :=
      reverseOn_boundary_of_local K C σ hlocal
    _ = _ := reverseLocalBoundary_inclusion_zero K C σ

theorem reverseOn_boundary_succ
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q + 1⦌) :
    faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (reverseOn K C σ) =
      ∑ i : Fin (q + 2), reverseOn K C (starSmallFace C σ i) := by
  have hlocal : faceBoundary K (augmentedSupportCarrier C σ) (q + 1)
      (reverseLocalOn K C (q + 1) σ) =
        reverseLocalBoundary K C (q + 1) σ := by
    apply reverseLocalOn_boundary
  calc
    faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (reverseOn K C σ) =
      faceChainInclusionDegree K (augmentedSupportCarrier_le C σ) (q + 1)
        (reverseLocalBoundary K C (q + 1) σ) :=
      reverseOn_boundary_of_local K C σ hlocal
    _ = _ := reverseLocalBoundary_inclusion_succ K C q σ

/-- The augmentation of the low-universe star-small singular chains.  This
specialized definition keeps the coefficient field in an arbitrary universe. -/
noncomputable def starSmallAugmentation
    (K : Type*) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ((starSmallSingularSSet C).chainComplex
        (ModuleCat.of K K)).X 0 ⟶ ModuleCat.of K K :=
  Sigma.desc (fun _ : starSmallSingularSSet C _⦋0⦌ ↦
    𝟙 (ModuleCat.of K K))

@[reassoc (attr := simp)]
theorem starSmall_ι_augmentation
    (K : Type*) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋0⦌) :
    (starSmallSingularSSet C).ιChainComplex σ ≫
        starSmallAugmentation K C =
      𝟙 (ModuleCat.of K K) := by
  exact Sigma.ι_desc _ σ

theorem starSmall_boundary_augmentation
    (K : Type*) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ((starSmallSingularSSet C).chainComplex
        (ModuleCat.of K K)).d 1 0 ≫
      starSmallAugmentation K C = 0 := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, SSet.ιChainComplex_d]
  simp

/-- Star-small singular chains with the empty degree inserted, without tying
the coefficient and simplicial-set universes. -/
noncomputable abbrev augmentedStarSmallChainComplex
    (K : Type*) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ChainComplex (ModuleCat K) ℕ :=
  ((starSmallSingularSSet C).chainComplex
      (ModuleCat.of K K)).augment (starSmallAugmentation K C)
    (starSmall_boundary_augmentation K C)

/-- The formal empty face as a map out of the coefficient object. -/
noncomputable def faceEmptyDegree
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ModuleCat.of K K ⟶
      (faceChainComplex K (AugmentedComplex.ofPre C)).X 0 :=
  ModuleCat.ofHom (LinearMap.toSpanSingleton K _
    (Finsupp.single
      (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1))

theorem reverseDegree_boundary_zero
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    reverseDegree K C 0 ≫
        (faceChainComplex K (AugmentedComplex.ofPre C)).d 1 0 =
      starSmallAugmentation K C ≫ faceEmptyDegree K C := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_reverseDegree,
    ← Category.assoc, starSmall_ι_augmentation,
    Category.id_comp]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro a
  change faceBoundary K (AugmentedComplex.ofPre C) 0
      (a • reverseOn K C σ) =
    a • Finsupp.single
      (emptyAugmentedSimplex (AugmentedComplex.ofPre C)) 1
  rw [map_smul, reverseOn_boundary_zero]

@[simp]
theorem faceChainComplex_d_hom
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    ((faceChainComplex K (AugmentedComplex.ofPre C)).d
      (q + 1) q).hom =
        faceBoundary K (AugmentedComplex.ofPre C) q := by
  rw [faceChainComplex_d]
  rfl

theorem reverseSpan_boundary_succ_linear
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q + 1⦌) :
    (faceBoundary K (AugmentedComplex.ofPre C) (q + 1)).comp
        (LinearMap.toSpanSingleton K _ (reverseOn K C σ)) =
      ∑ i : Fin (q + 2), LinearMap.toSpanSingleton K _
        (reverseOn K C (starSmallFace C σ i)) := by
  apply LinearMap.ext
  intro a
  simp only [LinearMap.comp_apply, LinearMap.toSpanSingleton_apply,
    LinearMap.sum_apply]
  rw [map_smul, reverseOn_boundary_succ, Finset.smul_sum]

theorem reverseGenerator_boundary_succ
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q + 1⦌) :
    reverseGenerator K C σ ≫
        (faceChainComplex K (AugmentedComplex.ofPre C)).d
          ((q + 1) + 1) (q + 1) =
      ∑ i : Fin (q + 2),
        reverseGenerator K C (starSmallFace C σ i) := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_comp, reverseGenerator_hom,
    faceChainComplex_d_hom, ModuleCat.hom_sum]
  simp_rw [reverseGenerator_hom]
  exact reverseSpan_boundary_succ_linear K C q σ

theorem iota_boundary_reverseDegree_succ
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    (σ : starSmallSingularSSet C _⦋q + 1⦌) :
    ((starSmallSingularSSet C).ιChainComplex σ ≫
        ((starSmallSingularSSet C).chainComplex
          (ModuleCat.of K K)).d (q + 1) q) ≫
      reverseDegree K C q =
    ∑ i : Fin (q + 2),
      reverseGenerator K C (starSmallFace C σ i) := by
  rw [iota_chainComplex_d_charTwo,
    Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro i hi
  exact iota_reverseDegree K C q (starSmallFace C σ i)

theorem reverseDegree_boundary_succ
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    reverseDegree K C (q + 1) ≫
        (faceChainComplex K (AugmentedComplex.ofPre C)).d
          ((q + 1) + 1) (q + 1) =
      ((starSmallSingularSSet C).chainComplex
          (ModuleCat.of K K)).d (q + 1) q ≫
        reverseDegree K C q := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_reverseDegree,
    reverseGenerator_boundary_succ]
  exact (iota_boundary_reverseDegree_succ K C q σ).symm

/-- The carried reverse map from augmented star-small singular chains to the
finite augmented face complex. -/
noncomputable def augmentedReverse
    (K : Type*) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedStarSmallChainComplex K C ⟶
      faceChainComplex K (AugmentedComplex.ofPre C) where
  f
    | 0 => faceEmptyDegree K C
    | q + 1 => reverseDegree K C q
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      exact reverseDegree_boundary_zero K C
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact reverseDegree_boundary_succ K C j

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Universe transport for the finite realization

The pinned singular-chain API ties the universe of a space to that of its
coefficient field.  The finite realization itself is low-universe.  This
module transports singular simplices across its canonical `TopCat` universe
lift, preserving faces, coordinate-open-star smallness, augmentations, and
the adaptive carried map to finite face chains.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

/-- A universe lift of the finite realization. -/
abbrev liftedPreGeomTop {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) : TopCat.{u} :=
  TopCat.uliftFunctor.{u}.obj (preGeomTop C)

/-- The lifted coordinate-open-star cover. -/
def liftedOpenStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (v : Fin m) :
    Set (liftedPreGeomTop.{u} C) :=
  {x | (preGeomTop C).uliftFunctorObjHomeo.symm x ∈ openStar C v}

theorem isOpen_liftedOpenStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (v : Fin m) :
    IsOpen (liftedOpenStar.{u} C v) := by
  exact (isOpen_openStar C v).preimage
    (preGeomTop C).uliftFunctorObjHomeo.symm.continuous

theorem iUnion_liftedOpenStar {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    ⋃ v, liftedOpenStar.{u} C v = Set.univ := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
  exact exists_mem_openStar C
    ((preGeomTop C).uliftFunctorObjHomeo.symm x)

abbrev liftedStarSmallSingularSSet {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) : SSet.{u} :=
  smallSingularSSet (liftedOpenStar.{u} C)

/-- A lifted singular simplex is exactly a low-universe singular simplex,
after applying the canonical homeomorphism on its codomain. -/
noncomputable def liftedSingularEquiv {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (Δ : SimplexCategoryᵒᵖ) :
    (singularSSet (liftedPreGeomTop.{u} C)).obj Δ ≃
      (singularSSet (preGeomTop C)).obj Δ :=
  ((liftedPreGeomTop.{u} C).toSSetObjEquiv Δ).trans
    (((Homeomorph.refl
      (stdSimplex ℝ (Fin (Δ.unop.len + 1)))).continuousMapCongr
        (preGeomTop C).uliftFunctorObjHomeo.symm).trans
      ((preGeomTop C).toSSetObjEquiv Δ).symm)

@[simp]
theorem liftedSingularEquiv_apply {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (Δ : SimplexCategoryᵒᵖ)
    (σ : (singularSSet (liftedPreGeomTop.{u} C)).obj Δ)
    (t : stdSimplex ℝ (Fin (Δ.unop.len + 1))) :
    (preGeomTop C).toSSetObjEquiv Δ (liftedSingularEquiv C Δ σ) t =
      (preGeomTop C).uliftFunctorObjHomeo.symm
        ((liftedPreGeomTop.{u} C).toSSetObjEquiv Δ σ t) := by
  rfl

theorem liftedSingularEquiv_map {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    {Δ E : SimplexCategory} (f : E ⟶ Δ)
    (σ : (singularSSet (liftedPreGeomTop.{u} C)).obj (.op Δ)) :
    liftedSingularEquiv C (.op E)
        ((singularSSet (liftedPreGeomTop.{u} C)).map f.op σ) =
      (singularSSet (preGeomTop C)).map f.op
        (liftedSingularEquiv C (.op Δ) σ) := by
  apply Equiv.injective ((preGeomTop C).toSSetObjEquiv (.op E))
  ext t v
  rfl

/-- Forget the universe lift on a star-small singular simplex. -/
noncomputable def liftedSmallToSmall {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    starSmallSingularSSet C _⦋q⦌ :=
  ⟨liftedSingularEquiv C _ σ.1, by
    obtain ⟨v, hv⟩ := σ.2
    refine ⟨v, ?_⟩
    rintro x ⟨t, rfl⟩
    have ht := hv ⟨t, rfl⟩
    exact ht⟩

theorem liftedSmallToSmall_face {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q + 1⦌)
    (i : Fin (q + 2)) :
    liftedSmallToSmall C
        ((liftedStarSmallSingularSSet.{u} C).δ i σ) =
      (starSmallSingularSSet C).δ i (liftedSmallToSmall C σ) := by
  apply Subtype.ext
  exact liftedSingularEquiv_map C (SimplexCategory.δ i) σ.1

theorem iota_chainComplex_d_charTwo_sameUniverse
    (K : Type u) [Field K] [CharP K 2] (X : SSet.{u})
    (q : ℕ) (σ : X _⦋q + 1⦌) :
    X.ιChainComplex σ ≫
        (X.chainComplex (ModuleCat.of K K)).d (q + 1) q =
      ∑ i : Fin (q + 2), X.ιChainComplex (X.δ i σ) := by
  rw [SSet.ιChainComplex_d]
  apply Finset.sum_congr rfl
  intro i hi
  exact charTwo_int_neg_one_pow_smul K i.val _

/-- Degreewise linear transport from lifted star-small chains to the
low-universe star-small chains. -/
noncomputable def liftedSmallToSmallDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (sSetChainComplex K (liftedStarSmallSingularSSet.{u} C)).X q ⟶
      ((starSmallSingularSSet C).chainComplex
        (ModuleCat.of K K)).X q :=
  Sigma.desc (fun σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌ ↦
    (starSmallSingularSSet C).ιChainComplex
      (liftedSmallToSmall C σ))

@[reassoc]
theorem iota_liftedSmallToSmallDegree
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : liftedStarSmallSingularSSet.{u} C _⦋q⦌) :
    (liftedStarSmallSingularSSet.{u} C).ιChainComplex σ ≫
        liftedSmallToSmallDegree K C q =
      (starSmallSingularSSet C).ιChainComplex
        (liftedSmallToSmall C σ) := by
  exact Sigma.ι_desc _ σ

theorem liftedSmallToSmallDegree_d
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    liftedSmallToSmallDegree K C (q + 1) ≫
        ((starSmallSingularSSet C).chainComplex
          (ModuleCat.of K K)).d (q + 1) q =
      (sSetChainComplex K
          (liftedStarSmallSingularSSet.{u} C)).d (q + 1) q ≫
        liftedSmallToSmallDegree K C q := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_liftedSmallToSmallDegree,
    iota_chainComplex_d_charTwo]
  rw [← Category.assoc,
    iota_chainComplex_d_charTwo_sameUniverse,
    Preadditive.sum_comp]
  simp_rw [iota_liftedSmallToSmallDegree]
  apply Finset.sum_congr rfl
  intro i hi
  rw [liftedSmallToSmall_face]

theorem liftedSmallToSmallDegree_augmentation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    liftedSmallToSmallDegree K C 0 ≫ starSmallAugmentation K C =
      sSetAugmentation K (liftedStarSmallSingularSSet.{u} C) := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [← Category.assoc, iota_liftedSmallToSmallDegree,
    starSmall_ι_augmentation,
    sSet_ι_augmentation]

/-- The universe-lift homeomorphism on augmented star-small chains. -/
noncomputable def augmentedLiftedSmallToSmall
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSmallSingularChainComplex K
        (liftedOpenStar.{u} C) ⟶
      augmentedStarSmallChainComplex K C where
  f
    | 0 => 𝟙 _
    | q + 1 => liftedSmallToSmallDegree K C q
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      simpa using liftedSmallToSmallDegree_augmentation K C
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact liftedSmallToSmallDegree_d K C j

/-- The adaptive map on the lifted realization, followed by the carried
reverse map to finite face chains. -/
noncomputable def liftedAdaptiveFaceRetraction
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) ⟶
      faceChainComplex K (AugmentedComplex.ofPre C) :=
  augmentedAdaptiveRhoSmall K (liftedPreGeomTop.{u} C)
      (liftedOpenStar.{u} C) (isOpen_liftedOpenStar C)
      (iUnion_liftedOpenStar C) ≫
    augmentedLiftedSmallToSmall K C ≫
    augmentedReverse K C

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# Affine characteristic simplices of finite faces

Increasing enumeration of a nonempty face gives its canonical affine
singular simplex in the barycentric realization.  This module proves strict
compatibility with ordered face deletion, transports the simplex to the
coefficient-field universe, and verifies termwise that one barycentric
subdivision lies in the coordinate-open-star small subcomplex.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

/-- Increasing enumeration of a nonempty augmented face. -/
def faceOrderEmb {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    Fin (q + 1) ↪o Fin m :=
  F.1.orderEmbOfFin F.2.2

@[simp]
theorem faceOrderEmb_mem {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (i : Fin (q + 1)) :
    faceOrderEmb C F i ∈ F.1 :=
  Finset.orderEmbOfFin_mem F.1 F.2.2 i

theorem barycentricSupport_stdSimplex_map_subset
    {a m : ℕ} (e : Fin a → Fin m)
    (t : stdSimplex ℝ (Fin a)) :
    SimplicialSphereAnisotropicity.barycentricSupport (stdSimplex.map e t) ⊆
      Finset.image e Finset.univ := by
  classical
  intro v hv
  simp only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
    Finset.mem_univ, true_and] at hv
  by_contra hvi
  have he : ∀ i : Fin a, e i ≠ v := by
    intro i hi
    exact hvi (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, hi⟩)
  simp only [stdSimplex.map_coe,
    FunOnFinite.linearMap_apply_apply] at hv
  simp [he] at hv

theorem barycentricSupport_stdSimplex_map_nonempty
    {a m : ℕ} (e : Fin a → Fin m)
    (t : stdSimplex ℝ (Fin a)) :
    (SimplicialSphereAnisotropicity.barycentricSupport (stdSimplex.map e t)).Nonempty := by
  classical
  let x : stdSimplex ℝ (Fin m) := stdSimplex.map e t
  have hsum : (∑ v, x v) ≠ 0 :=
    ne_of_eq_of_ne x.2.2 one_ne_zero
  obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  refine ⟨v, ?_⟩
  simpa only [SimplicialSphereAnisotropicity.barycentricSupport, Finset.mem_filter,
    Finset.mem_univ, true_and] using hv

/-- The characteristic affine map of a nonempty face into the exact
barycentric-coordinate realization. -/
def affineFaceContinuousLow {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    C(stdSimplex ℝ (Fin (q + 1)), preGeomTop C) where
  toFun t := ⟨stdSimplex.map (faceOrderEmb C F) t, by
    let x : stdSimplex ℝ (Fin m) :=
      stdSimplex.map (faceOrderEmb C F) t
    have hFne : F.1.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hzero
      have hcard : F.1.card = 0 := by simp [hzero]
      omega
    have hFC : F.1 ∈ C := by
      rcases F.2.1 with hzero | hface
      · exact (hFne.ne_empty hzero).elim
      · exact hface
    refine ⟨x.2.1, x.2.2, (C.isRelLowerSet_faces hFC).2 ?_ ?_⟩
    · exact (barycentricSupport_stdSimplex_map_subset
          (faceOrderEmb C F) t).trans (by
            rw [faceOrderEmb, Finset.image_orderEmbOfFin_univ])
    · exact barycentricSupport_stdSimplex_map_nonempty
        (faceOrderEmb C F) t⟩
  continuous_toFun := by
    exact Continuous.subtype_mk
      (continuous_subtype_val.comp
        (stdSimplex.continuous_map (S := ℝ) (faceOrderEmb C F))) _

@[simp]
theorem affineFaceContinuousLow_apply {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (t : stdSimplex ℝ (Fin (q + 1))) :
    (affineFaceContinuousLow C F t).1 =
      stdSimplex.map (faceOrderEmb C F) t := rfl

/-- Delete the vertex in the `i`th increasing position of a face. -/
def eraseFaceAtIndex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1) :=
  eraseSimplex (AugmentedComplex.ofPre C) F
    ⟨faceOrderEmb C F i, faceOrderEmb_mem C F i⟩

@[simp]
theorem eraseFaceAtIndex_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    (eraseFaceAtIndex C F i).1 = F.1.erase (faceOrderEmb C F i) := rfl

/-- Increasing enumeration commutes strictly with deleting an index. -/
theorem faceOrderEmb_eraseFaceAtIndex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    faceOrderEmb C (eraseFaceAtIndex C F i) =
      (Fin.succAboveOrderEmb i).trans (faceOrderEmb C F) := by
  symm
  apply Finset.orderEmbOfFin_unique'
  intro j
  change faceOrderEmb C F (i.succAbove j) ∈
    F.1.erase (faceOrderEmb C F i)
  rw [Finset.mem_erase]
  exact ⟨fun h ↦ Fin.succAbove_ne i j
      ((faceOrderEmb C F).injective h),
    faceOrderEmb_mem C F _⟩

/-- The low-universe singular characteristic simplex of a nonempty face. -/
def affineFaceSimplexLow {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    singularSSet (preGeomTop C) _⦋q⦌ :=
  ((preGeomTop C).toSSetObjEquiv _).symm
    (affineFaceContinuousLow C F)

@[simp]
theorem affineFaceSimplexLow_apply {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (t : stdSimplex ℝ (Fin (q + 1))) :
    ((preGeomTop C).toSSetObjEquiv _
      (affineFaceSimplexLow C F) t).1 =
        stdSimplex.map (faceOrderEmb C F) t := rfl

/-- Deleting an ordered domain vertex gives the characteristic simplex of
the corresponding erased face. -/
theorem affineFaceSimplexLow_face {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    (singularSSet (preGeomTop C)).δ i (affineFaceSimplexLow C F) =
      affineFaceSimplexLow C (eraseFaceAtIndex C F i) := by
  apply (preGeomTop C).toSSetObjEquiv _ |>.injective
  ext t v
  rw [TopCat.toSSetObjEquiv_δ_apply]
  change stdSimplex.map (faceOrderEmb C F)
      (stdSimplex.map i.succAbove t) v =
    stdSimplex.map (faceOrderEmb C (eraseFaceAtIndex C F i)) t v
  rw [stdSimplex.map_comp_apply, faceOrderEmb_eraseFaceAtIndex]
  rfl

universe u

/-- The characteristic face simplex transported to the universe of an
arbitrary coefficient field. -/
noncomputable def affineFaceSimplexLifted {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    singularSSet (liftedPreGeomTop.{u} C) _⦋q⦌ :=
  (liftedSingularEquiv C _).symm (affineFaceSimplexLow C F)

theorem affineFaceSimplexLifted_down {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    liftedSingularEquiv C _ (affineFaceSimplexLifted C F) =
      affineFaceSimplexLow C F := by
  exact Equiv.apply_symm_apply _ _

/-- Lifted characteristic simplices retain strict face compatibility. -/
theorem affineFaceSimplexLifted_face {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    (singularSSet (liftedPreGeomTop.{u} C)).δ i
        (affineFaceSimplexLifted C F) =
      affineFaceSimplexLifted C (eraseFaceAtIndex C F i) := by
  apply (liftedSingularEquiv C _).injective
  change liftedSingularEquiv C _
      ((singularSSet (liftedPreGeomTop.{u} C)).map
        (SimplexCategory.δ i).op (affineFaceSimplexLifted C F)) = _
  rw [liftedSingularEquiv_map, affineFaceSimplexLifted_down,
    affineFaceSimplexLifted_down]
  exact affineFaceSimplexLow_face C F i

/-! ## The positive-cardinal affine face-chain map -/

/-- Reindex the unsigned face boundary by increasing vertex position. -/
theorem boundaryOnSimplex_eq_sum_eraseFaceAtIndex
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    boundaryOnSimplex K (AugmentedComplex.ofPre C) (q + 1) F =
      ∑ i : Fin (q + 2), Finsupp.single (eraseFaceAtIndex C F i) 1 := by
  rw [boundaryOnSimplex]
  symm
  exact Fintype.sum_equiv (F.1.orderIsoOfFin F.2.2)
    (fun i ↦ Finsupp.single (eraseFaceAtIndex C F i) (1 : K))
    (fun v ↦ Finsupp.single
      (eraseSimplex (AugmentedComplex.ofPre C) F v) (1 : K))
    (fun i ↦ by rfl)

/-- Singular-chain generator associated to a positive-cardinal face. -/
noncomputable def affineFaceGenerator
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    ModuleCat.of K K ⟶
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).X (q + 1) :=
  ιAugmentedSSet K (singularSSet (liftedPreGeomTop.{u} C))
    (affineFaceSimplexLifted C F)

/-- Linear extension of affine characteristic simplices in positive
cardinal degree. -/
noncomputable def affineFaceDegreeLinear
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) →ₗ[K]
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).X (q + 1) :=
  Finsupp.linearCombination K (fun F ↦
    (affineFaceGenerator K C F).hom 1)

@[simp]
theorem affineFaceDegreeLinear_single
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    affineFaceDegreeLinear K C q (Finsupp.single F a) =
      a • (affineFaceGenerator K C F).hom 1 := by
  exact Finsupp.linearCombination_single K a F

/-- Positive-cardinal degree of the affine characteristic map. -/
noncomputable def affineFaceDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1) ⟶
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).X (q + 1) :=
  ModuleCat.ofHom (affineFaceDegreeLinear K C q)

@[simp]
theorem affineFaceDegree_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    (affineFaceDegree K C q).hom (Finsupp.single F a) =
      a • (affineFaceGenerator K C F).hom 1 := by
  change affineFaceDegreeLinear K C q (Finsupp.single F a) = _
  exact affineFaceDegreeLinear_single K C F a

/-- The singular boundary of a characteristic face is the sum of its
characteristic codimension-one faces. -/
theorem affineFaceGenerator_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    affineFaceGenerator K C F ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1) =
      ∑ i : Fin (q + 2),
        affineFaceGenerator K C (eraseFaceAtIndex C F i) := by
  rw [affineFaceGenerator, ιAugmentedSSet_d_succ_succ]
  apply Finset.sum_congr rfl
  intro i hi
  rw [charTwo_int_neg_one_pow_smul K i.val]
  congr 1
  exact affineFaceSimplexLifted_face C F i

theorem affineFaceDegree_boundaryOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    (affineFaceDegree K C q).hom
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) (q + 1) F) =
      ((affineFaceGenerator K C F ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom 1) := by
  rw [boundaryOnSimplex_eq_sum_eraseFaceAtIndex]
  change affineFaceDegreeLinear K C q
      (∑ i : Fin (q + 2),
        Finsupp.single (eraseFaceAtIndex C F i) 1) = _
  rw [affineFaceDegreeLinear, map_sum]
  simp only [Finsupp.linearCombination_single, one_smul]
  rw [affineFaceGenerator_boundary, ModuleCat.hom_sum,
    LinearMap.sum_apply]

/-- Positive-cardinal chain-map squares for the affine characteristic map. -/
theorem affineFaceDegree_boundary_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    affineFaceDegree K C (q + 1) ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1) =
      (faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫ affineFaceDegree K C q := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom]
  change ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom.comp
        (affineFaceDegreeLinear K C (q + 1)) =
    (affineFaceDegreeLinear K C q).comp
      (faceBoundary K (AugmentedComplex.ofPre C) (q + 1))
  apply Finsupp.lhom_ext
  intro F a
  rw [LinearMap.comp_apply, LinearMap.comp_apply,
    affineFaceDegreeLinear_single, map_smul,
    faceBoundary_single, map_smul]
  congr 1
  change ((affineFaceGenerator K C F ≫
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).d (q + 2) (q + 1)).hom 1) = _
  exact (affineFaceDegree_boundaryOn K C F).symm

/-! ## The augmented affine face-chain map -/

/-- Collapse the unique augmented empty face to the coefficient `1`. -/
noncomputable def affineFaceZeroLinear
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    AugmentedChain K (AugmentedComplex.ofPre C) 0 →ₗ[K] K :=
  Finsupp.linearCombination K (fun _ ↦ 1)

@[simp]
theorem affineFaceZeroLinear_single
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) 0) (a : K) :
    affineFaceZeroLinear K C (Finsupp.single F a) = a := by
  rw [affineFaceZeroLinear, Finsupp.linearCombination_single]
  simp

/-- Degree-zero part of the affine characteristic map. -/
noncomputable def affineFaceZero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X 0 ⟶
      (augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).X 0 :=
  ModuleCat.ofHom (affineFaceZeroLinear K C)

theorem affineFaceZeroLinear_boundaryOn
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) 1) :
    affineFaceZeroLinear K C
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) 0 F) = 1 := by
  rw [boundaryOnSimplex, map_sum]
  simp only [affineFaceZeroLinear_single]
  simp [F.2.2]

theorem affineFaceGenerator_augmentation
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) 1) :
    affineFaceGenerator K C F ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d 1 0 =
      𝟙 (ModuleCat.of K K) := by
  exact ιAugmentedSSet_d_one_zero K
    (singularSSet (liftedPreGeomTop.{u} C))
    (affineFaceSimplexLifted C F)

/-- The augmentation square for the affine characteristic map. -/
theorem affineFaceDegree_boundary_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    affineFaceDegree K C 0 ≫
        (augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d 1 0 =
      (faceChainComplex K (AugmentedComplex.ofPre C)).d 1 0 ≫
        affineFaceZero K C := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom]
  change ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d 1 0).hom.comp
        (affineFaceDegreeLinear K C 0) =
    (affineFaceZero K C).hom.comp
      (faceBoundary K (AugmentedComplex.ofPre C) 0)
  apply Finsupp.lhom_ext
  intro F a
  rw [LinearMap.comp_apply, affineFaceDegreeLinear_single, map_smul]
  change a • ((augmentedSingularChainComplex K
      (liftedPreGeomTop.{u} C)).d 1 0).hom
        ((affineFaceGenerator K C F).hom 1) =
    affineFaceZeroLinear K C
      (faceBoundary K (AugmentedComplex.ofPre C) 0
        (Finsupp.single F a))
  rw [faceBoundary_single, map_smul]
  congr 1
  have hgen :
      ((augmentedSingularChainComplex K
          (liftedPreGeomTop.{u} C)).d 1 0).hom
          ((affineFaceGenerator K C F).hom 1) = (1 : K) := by
    have h := congrArg
      (fun f : ModuleCat.of K K ⟶ ModuleCat.of K K ↦ f.hom (1 : K))
      (affineFaceGenerator_augmentation K C F)
    change ((augmentedSingularChainComplex K
        (liftedPreGeomTop.{u} C)).d 1 0).hom
          ((affineFaceGenerator K C F).hom 1) = (1 : K) at h
    exact h
  rw [hgen]
  exact (affineFaceZeroLinear_boundaryOn K C F).symm

/-- The augmented affine characteristic map from finite face chains to
singular chains on the lifted barycentric realization. -/
noncomputable def augmentedAffineFaceMap
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    faceChainComplex K (AugmentedComplex.ofPre C) ⟶
      augmentedSingularChainComplex K (liftedPreGeomTop.{u} C) where
  f
    | 0 => affineFaceZero K C
    | q + 1 => affineFaceDegree K C q
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      exact affineFaceDegree_boundary_zero K C
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact affineFaceDegree_boundary_succ K C j

@[simp]
theorem augmentedAffineFaceMap_f_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (augmentedAffineFaceMap K C).f 0 = affineFaceZero K C := rfl

@[simp]
theorem augmentedAffineFaceMap_f_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (augmentedAffineFaceMap K C).f (q + 1) =
      affineFaceDegree K C q := rfl

/-! ## One-fold subdivision is termwise star-small -/

/-- Positivity at every ordered vertex implies positivity throughout the
realized affine simplex. -/
theorem AffineSimplex.realize_apply_pos_of_vertices {q r : ℕ}
    (p : AffineSimplex q r) (v : Fin (q + 1))
    (hvertices : ∀ i, 0 < p i v)
    (t : stdSimplex ℝ (Fin (r + 1))) :
    0 < p.realize t v := by
  change 0 < ∑ i : Fin (r + 1), t i * p i v
  rw [Finset.sum_pos_iff_of_nonneg]
  · have hsum : (∑ i : Fin (r + 1), t i) ≠ 0 :=
      ne_of_eq_of_ne t.2.2 one_ne_zero
    obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
    refine ⟨i, Finset.mem_univ i, mul_pos ?_ (hvertices i)⟩
    exact lt_of_le_of_ne (t.2.1 i) (Ne.symm hi)
  · intro i hi
    exact mul_nonneg (t.2.1 i) (hvertices i).le

/-- The barycenter of distinct coordinate vertices is positive at every
coordinate occurring in the tuple. -/
theorem AffineSimplex.vertexMap_barycenter_apply_pos {q r : ℕ}
    (f : Fin (r + 1) → Fin (q + 1))
    (hf : Function.Injective f) (v : Fin (r + 1)) :
    0 < AffineSimplex.barycenter
      ((fun i ↦ stdSimplex.vertex (S := ℝ) (f i)) :
        AffineSimplex q r) (f v) := by
  change 0 < ∑ i : Fin (r + 1),
    (1 / Fintype.card (Fin (r + 1)) : ℝ) *
      (stdSimplex.vertex (S := ℝ) (f i)) (f v)
  rw [Finset.sum_eq_single v]
  · simp
    positivity
  · intro b hb hbv
    have hne : f b ≠ f v := fun h ↦ hbv (hf h)
    simp [hne]
  · simp

/-- A first-subdivision term of a coordinate-vertex simplex has a common
positive coordinate, namely the singleton at the bottom of its flag. -/
theorem affineSubdivisionTermList_vertexMap_common_positive {q : ℕ} :
    ∀ (r : ℕ) (f : Fin (r + 1) → Fin (q + 1)),
      Function.Injective f →
      ∀ t ∈ affineSubdivisionTermList r
          (fun i ↦ stdSimplex.vertex (S := ℝ) (f i)),
        ∃ v : Fin (r + 1), ∀ j : Fin (r + 1), 0 < t j (f v) := by
  intro r
  induction r with
  | zero =>
      intro f hf t ht
      simp [affineSubdivisionTermList] at ht
      subst t
      refine ⟨0, ?_⟩
      intro j
      fin_cases j
      simp
  | succ r ih =>
      intro f hf t ht
      rw [affineSubdivisionTermList] at ht
      obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ht
      obtain ⟨l, hl, hw⟩ := List.mem_flatten.mp hw
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
      let g : Fin (r + 1) → Fin (q + 1) :=
        fun j ↦ f (i.succAbove j)
      have hg : Function.Injective g :=
        hf.comp Fin.succAbove_right_injective
      change w ∈ affineSubdivisionTermList r
        (fun j ↦ stdSimplex.vertex (S := ℝ)
          (f (i.succAbove j))) at hw
      obtain ⟨v, hv⟩ := ih g hg w (by simpa only [g] using hw)
      refine ⟨i.succAbove v, ?_⟩
      intro j
      refine Fin.cases ?_ (fun k ↦ ?_) j
      · exact AffineSimplex.vertexMap_barycenter_apply_pos
          f hf (i.succAbove v)
      · exact hv k

/-- Specialization of the flag lemma to the universal identity simplex. -/
theorem affineSubdivisionTermList_identity_common_positive {q : ℕ}
    (t : AffineSimplex q q)
    (ht : t ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    ∃ v : Fin (q + 1), ∀ j : Fin (q + 1), 0 < t j v := by
  simpa [AffineSimplex.identity] using
    (affineSubdivisionTermList_vertexMap_common_positive q
      (fun i : Fin (q + 1) ↦ i) Function.injective_id t ht)

/-- Reading an injectively relabeled standard simplex at an image coordinate
recovers the original coordinate. -/
theorem stdSimplex_map_apply_image_of_injective
    {a m : ℕ} (e : Fin a → Fin m) (he : Function.Injective e)
    (t : stdSimplex ℝ (Fin a)) (v : Fin a) :
    stdSimplex.map e t (e v) = t v := by
  classical
  simp only [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply]
  rw [Finset.sum_eq_single v]
  · intro b hb hbv
    have hbe : e b = e v := (Finset.mem_filter.mp hb).2
    exact (hbv (he hbe)).elim
  · intro hv
    exfalso
    exact hv (by simp)

/-- Every uncollected first-subdivision term of a lifted characteristic face
simplex lies in one lifted coordinate open star.  The witness may depend on
the term. -/
theorem push_affineFaceSimplexLifted_term_mem_small
    {m q : ℕ} (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (t : AffineSimplex q q)
    (ht : t ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    pushAffineSimplex (liftedPreGeomTop.{u} C)
        (affineFaceSimplexLifted C F) t ∈
      (smallSingularSubcomplex (liftedOpenStar.{u} C)).obj _ := by
  obtain ⟨v, hv⟩ :=
    affineSubdivisionTermList_identity_common_positive t ht
  refine ⟨faceOrderEmb C F v, ?_⟩
  change Set.range
      (((liftedPreGeomTop.{u} C).toSSetObjEquiv _
        (affineFaceSimplexLifted C F)).comp t.realize) ⊆
      liftedOpenStar.{u} C (faceOrderEmb C F v)
  rintro _ ⟨z, rfl⟩
  change 0 < ((preGeomTop C).uliftFunctorObjHomeo.symm
    ((liftedPreGeomTop.{u} C).toSSetObjEquiv _
      (affineFaceSimplexLifted C F) (t.realize z))).1
      (faceOrderEmb C F v)
  have hdown := liftedSingularEquiv_apply C _
    (affineFaceSimplexLifted C F) (t.realize z)
  rw [affineFaceSimplexLifted_down] at hdown
  rw [← hdown]
  change 0 < stdSimplex.map (faceOrderEmb C F) (t.realize z)
    (faceOrderEmb C F v)
  rw [stdSimplex_map_apply_image_of_injective]
  · exact AffineSimplex.realize_apply_pos_of_vertices t v hv z
  · exact (faceOrderEmb C F).injective

end SimplicialSphereAnisotropicity.Topology

end

end

section

/-!
# The subdivided affine face map in the star-small complex

One barycentric subdivision of every affine characteristic face is
termwise contained in a coordinate open star.  We retain the attached
uncollected term list, so that both multiplicities and the individual
smallness witnesses remain available.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

/-- A single attached first-subdivision term, regarded as a lifted
star-small singular simplex. -/
def liftedAffineFaceSubdivisionTerm {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : AffineSimplex q q)
    (hp : p ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    liftedStarSmallSingularSSet.{u} C _⦋q⦌ :=
  ⟨pushAffineSimplex (liftedPreGeomTop.{u} C)
      (affineFaceSimplexLifted C F) p,
    push_affineFaceSimplexLifted_term_mem_small C F p hp⟩

@[simp]
theorem liftedAffineFaceSubdivisionTerm_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : AffineSimplex q q)
    (hp : p ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    (liftedAffineFaceSubdivisionTerm C F p hp).1 =
      pushAffineSimplex (liftedPreGeomTop.{u} C)
        (affineFaceSimplexLifted C F) p := rfl

/-- The free small-chain generator belonging to one attached subdivision
term. -/
noncomputable def affineSubdivisionLiftedSmallGeneratorTerm
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : {p // p ∈
      affineSubdivisionTermList q (AffineSimplex.identity q)}) :
    ModuleCat.of K K ⟶
      (sSetChainComplex K
        (liftedStarSmallSingularSSet.{u} C)).X q :=
  (liftedStarSmallSingularSSet.{u} C).ιChainComplex
    (liftedAffineFaceSubdivisionTerm C F p.1 p.2)

/-- The attached-list sum representing one subdivision of an affine face
inside the lifted star-small chain complex. -/
noncomputable def affineSubdivisionLiftedSmallGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    ModuleCat.of K K ⟶
      (sSetChainComplex K
        (liftedStarSmallSingularSSet.{u} C)).X q :=
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  (l.attach.map
    (affineSubdivisionLiftedSmallGeneratorTerm K C F)).sum

/-- After inclusion into all singular chains, the attached small generator
is the ordinary uncollected subdivision list. -/
theorem affineSubdivisionLiftedSmallGenerator_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    affineSubdivisionLiftedSmallGenerator K C F ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      singularChainOfAffineList K (liftedPreGeomTop.{u} C)
        (affineFaceSimplexLifted C F)
        (affineSubdivisionTermList q (AffineSimplex.identity q)) := by
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  change (l.attach.map
      (affineSubdivisionLiftedSmallGeneratorTerm K C F)).sum ≫ _ =
    (l.map fun p ↦
      (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
        (pushAffineSimplex (liftedPreGeomTop.{u} C)
          (affineFaceSimplexLifted C F) p)).sum
  have hrhs :
      (l.map fun p ↦
        ((singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
          (pushAffineSimplex (liftedPreGeomTop.{u} C)
            (affineFaceSimplexLifted C F) p) :
          ModuleCat.of K K ⟶
            (sSetChainComplex K
              (singularSSet (liftedPreGeomTop.{u} C))).X q)).sum =
        (l.attach.map fun p ↦
          ((singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
            (pushAffineSimplex (liftedPreGeomTop.{u} C)
              (affineFaceSimplexLifted C F) p.1) :
            ModuleCat.of K K ⟶
              (sSetChainComplex K
                (singularSSet (liftedPreGeomTop.{u} C))).X q)).sum := by
    calc
      _ = ((l.attach.map Subtype.val).map fun p ↦
          ((singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
            (pushAffineSimplex (liftedPreGeomTop.{u} C)
              (affineFaceSimplexLifted C F) p) :
            ModuleCat.of K K ⟶
              (sSetChainComplex K
                (singularSSet (liftedPreGeomTop.{u} C))).X q)).sum := by
            rw [l.attach_map_subtype_val]
      _ = _ := by
        rw [List.map_map]
        apply congrArg List.sum
        apply List.map_congr_left
        intro p hp
        rfl
  rw [hrhs]
  induction l.attach with
  | nil => simp
  | cons p ps ih =>
      simp only [List.map_cons, List.sum_cons, Preadditive.add_comp]
      rw [ih]
      congr 1
      exact SSet.ι_chainComplexMap_f _ _ _ _ _

/-- The included small generator is exactly one ordinary singular
subdivision of the affine characteristic generator. -/
theorem affineSubdivisionLiftedSmallGenerator_inclusion_eq_subdivision
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    affineSubdivisionLiftedSmallGenerator K C F ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      affineFaceGenerator K C F ≫
        singularSubdivisionIterDegree K
          (liftedPreGeomTop.{u} C) 1 q := by
  rw [affineSubdivisionLiftedSmallGenerator_inclusion,
    singularChainOfAffineList_eq,
    affineChainOfList_subdivisionTermList]
  change affineChainToSingular K (liftedPreGeomTop.{u} C)
      (affineFaceSimplexLifted C F)
        (affineSubdivisionOn K q (AffineSimplex.identity q)) =
    (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
        (affineFaceSimplexLifted C F) ≫
      singularSubdivisionIterDegree K
        (liftedPreGeomTop.{u} C) 1 q
  rw [iota_singularSubdivisionIterDegree]
  simp [affineSubdivisionIter]

/-! ## Linear extension in positive cardinal degrees -/

/-- Linear extension of the attached small generator over finite faces. -/
noncomputable def affineSubdivisionLiftedSmallDegreeLinear
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) →ₗ[K]
      (sSetChainComplex K
        (liftedStarSmallSingularSSet.{u} C)).X q :=
  Finsupp.linearCombination K (fun F ↦
    (affineSubdivisionLiftedSmallGenerator K C F).hom 1)

@[simp]
theorem affineSubdivisionLiftedSmallDegreeLinear_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    affineSubdivisionLiftedSmallDegreeLinear K C q
        (Finsupp.single F a) =
      a • (affineSubdivisionLiftedSmallGenerator K C F).hom 1 := by
  exact Finsupp.linearCombination_single K a F

/-- Positive-cardinal degree of the subdivided affine small map. -/
noncomputable def affineSubdivisionLiftedSmallDegree
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1) ⟶
      (sSetChainComplex K
        (liftedStarSmallSingularSSet.{u} C)).X q :=
  ModuleCat.ofHom (affineSubdivisionLiftedSmallDegreeLinear K C q)

@[simp]
theorem affineSubdivisionLiftedSmallDegree_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    (affineSubdivisionLiftedSmallDegree K C q).hom
        (Finsupp.single F a) =
      a • (affineSubdivisionLiftedSmallGenerator K C F).hom 1 := by
  exact affineSubdivisionLiftedSmallDegreeLinear_single K C F a

/-- Ordinary singular-chain generator of an affine characteristic face. -/
noncomputable def affineFaceGeneratorRaw
    (K : Type u) [Field K] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    ModuleCat.of K K ⟶
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).X q :=
  (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
    (affineFaceSimplexLifted C F)

/-- The raw affine generator has the unsigned face boundary in
characteristic two. -/
theorem affineFaceGeneratorRaw_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    affineFaceGeneratorRaw K C F ≫
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q =
      ∑ i : Fin (q + 2),
        affineFaceGeneratorRaw K C (eraseFaceAtIndex C F i) := by
  rw [affineFaceGeneratorRaw,
    iota_chainComplex_d_charTwo_sameUniverse]
  apply Finset.sum_congr rfl
  intro i hi
  congr 1
  exact affineFaceSimplexLifted_face C F i

/-- The affine-face degree exposed through the ordinary singular-chain
presentation of successor augmented degree. -/
noncomputable def affineFaceDegreeLinearRaw
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) →ₗ[K]
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).X q :=
  Finsupp.linearCombination K (fun F ↦
    (affineFaceGeneratorRaw K C F).hom 1)

@[simp]
theorem affineFaceDegreeLinearRaw_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    affineFaceDegreeLinearRaw K C q (Finsupp.single F a) =
      a • (affineFaceGeneratorRaw K C F).hom (1 : K) := by
  exact Finsupp.linearCombination_single K a F

/-- Ordinary-degree presentation of the positive affine-face map. -/
noncomputable def affineFaceDegreeRaw
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X (q + 1) ⟶
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).X q :=
  ModuleCat.ofHom (affineFaceDegreeLinearRaw K C q)

/-- Evaluation of the raw affine degree on a finite basis face. -/
@[simp]
theorem affineFaceDegreeRaw_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    (affineFaceDegreeRaw K C q).hom (Finsupp.single F a) =
      a • (affineFaceGeneratorRaw K C F).hom (1 : K) := by
  exact affineFaceDegreeLinearRaw_single K C F a

theorem affineFaceDegreeRaw_boundaryOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    (affineFaceDegreeRaw K C q).hom
        (boundaryOnSimplex K (AugmentedComplex.ofPre C) (q + 1) F) =
      ((affineFaceGeneratorRaw K C F ≫
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).d
            (q + 1) q).hom 1) := by
  rw [boundaryOnSimplex_eq_sum_eraseFaceAtIndex]
  change affineFaceDegreeLinearRaw K C q
      (∑ i : Fin (q + 2),
        Finsupp.single (eraseFaceAtIndex C F i) 1) = _
  rw [map_sum]
  simp only [affineFaceDegreeLinearRaw_single, one_smul]
  rw [affineFaceGeneratorRaw_boundary, ModuleCat.hom_sum,
    LinearMap.sum_apply]

/-- Positive-cardinal differential squares for the raw affine map. -/
theorem affineFaceDegreeRaw_boundary_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    affineFaceDegreeRaw K C (q + 1) ≫
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q =
      (faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫ affineFaceDegreeRaw K C q := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom]
  change ((sSetChainComplex K
      (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q).hom.comp
        (affineFaceDegreeLinearRaw K C (q + 1)) =
    (affineFaceDegreeLinearRaw K C q).comp
      (faceBoundary K (AugmentedComplex.ofPre C) (q + 1))
  apply Finsupp.lhom_ext
  intro F a
  rw [LinearMap.comp_apply, LinearMap.comp_apply,
    affineFaceDegreeLinearRaw_single, map_smul,
    faceBoundary_single, map_smul]
  congr 1
  change ((affineFaceGeneratorRaw K C F ≫
      (sSetChainComplex K
        (singularSSet (liftedPreGeomTop.{u} C))).d
          (q + 1) q).hom 1) = _
  exact (affineFaceDegreeRaw_boundaryOn K C F).symm

/-- Degreewise, inclusion of the small affine map is the affine
characteristic map followed by one singular subdivision. -/
theorem affineSubdivisionLiftedSmallDegree_inclusion
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
      affineSubdivisionLiftedSmallDegree K C q ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      affineFaceDegreeRaw K C q ≫
        singularSubdivisionIterDegree K
          (liftedPreGeomTop.{u} C) 1 q := by
  apply ModuleCat.hom_ext
  change ((SSet.chainComplexMap
      (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
      (ModuleCat.of K K)).f q).hom.comp
        (affineSubdivisionLiftedSmallDegreeLinear K C q) =
    (singularSubdivisionIterDegree K
      (liftedPreGeomTop.{u} C) 1 q).hom.comp
        (affineFaceDegreeLinearRaw K C q)
  apply Finsupp.lhom_ext
  intro F a
  rw [LinearMap.comp_apply, LinearMap.comp_apply,
    affineSubdivisionLiftedSmallDegreeLinear_single,
    affineFaceDegreeLinearRaw_single, map_smul, map_smul]
  congr 1
  exact congrArg (fun f ↦ f.hom (1 : K))
    (affineSubdivisionLiftedSmallGenerator_inclusion_eq_subdivision K C F)

/-- Postcomposition with the small-chain inclusion is injective, using its
explicit degreewise retraction. -/
theorem eq_of_comp_smallSingularInclusion
    (K : Type u) [Field K] (X : TopCat.{u})
    {I : Type u} (U : I → Set X) (q : ℕ)
    {A : ModuleCat K}
    (f g : A ⟶ (sSetChainComplex K (smallSingularSSet U)).X q)
    (h : f ≫
        (SSet.chainComplexMap (smallSingularSubcomplex U).ι
          (ModuleCat.of K K)).f q =
      g ≫
        (SSet.chainComplexMap (smallSingularSubcomplex U).ι
          (ModuleCat.of K K)).f q) :
    f = g := by
  calc
    f = (f ≫ (SSet.chainComplexMap
        (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f q) ≫
          smallSingularInclusionRetractionDegree K X U q := by
      rw [Category.assoc,
        smallSingularInclusion_retraction, Category.comp_id]
    _ = (g ≫ (SSet.chainComplexMap
        (smallSingularSubcomplex U).ι
        (ModuleCat.of K K)).f q) ≫
          smallSingularInclusionRetractionDegree K X U q := by rw [h]
    _ = g := by
      rw [Category.assoc,
        smallSingularInclusion_retraction, Category.comp_id]

/-- Specialization of the preceding cancellation lemma to the lifted
coordinate-star cover. -/
theorem eq_of_comp_liftedStarSmallInclusion
    (K : Type u) [Field K] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ)
    {A : ModuleCat K}
    (f g : A ⟶
      (sSetChainComplex K
        (liftedStarSmallSingularSSet.{u} C)).X q)
    (h : f ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      g ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q) :
    f = g := by
  calc
    f = (f ≫ (SSet.chainComplexMap
        (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
        (ModuleCat.of K K)).f q) ≫
          smallSingularInclusionRetractionDegree K
            (liftedPreGeomTop.{u} C) (liftedOpenStar.{u} C) q := by
      rw [Category.assoc,
        smallSingularInclusion_retraction, Category.comp_id]
    _ = (g ≫ (SSet.chainComplexMap
        (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
        (ModuleCat.of K K)).f q) ≫
          smallSingularInclusionRetractionDegree K
            (liftedPreGeomTop.{u} C) (liftedOpenStar.{u} C) q := by rw [h]
    _ = g := by
      rw [Category.assoc,
        smallSingularInclusion_retraction, Category.comp_id]

/-- The attached-list lifted-small degrees commute with every positive
ordinary differential. -/
theorem affineSubdivisionLiftedSmallDegree_boundary_succ
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) (q : ℕ) :
    affineSubdivisionLiftedSmallDegree K C (q + 1) ≫
        (sSetChainComplex K
          (liftedStarSmallSingularSSet.{u} C)).d (q + 1) q =
      (faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫
        affineSubdivisionLiftedSmallDegree K C q := by
  apply eq_of_comp_liftedStarSmallInclusion K C q
  calc
    (affineSubdivisionLiftedSmallDegree K C (q + 1) ≫
          (sSetChainComplex K
            (liftedStarSmallSingularSSet.{u} C)).d (q + 1) q) ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f q =
      (affineSubdivisionLiftedSmallDegree K C (q + 1) ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f (q + 1)) ≫
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q := by
      rw [Category.assoc,
        ← (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).comm (q + 1) q,
        ← Category.assoc]
    _ = (affineFaceDegreeRaw K C (q + 1) ≫
          singularSubdivisionIterDegree K
            (liftedPreGeomTop.{u} C) 1 (q + 1)) ≫
        (sSetChainComplex K
          (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q := by
      rw [affineSubdivisionLiftedSmallDegree_inclusion]
    _ = affineFaceDegreeRaw K C (q + 1) ≫
        (singularSubdivisionIterDegree K
            (liftedPreGeomTop.{u} C) 1 (q + 1) ≫
          (sSetChainComplex K
            (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q) := by
      rw [Category.assoc]
    _ = affineFaceDegreeRaw K C (q + 1) ≫
        ((sSetChainComplex K
            (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q ≫
          singularSubdivisionIterDegree K
            (liftedPreGeomTop.{u} C) 1 q) := by
      rw [singularSubdivisionIterDegree_d]
    _ = (affineFaceDegreeRaw K C (q + 1) ≫
          (sSetChainComplex K
            (singularSSet (liftedPreGeomTop.{u} C))).d (q + 1) q) ≫
        singularSubdivisionIterDegree K
          (liftedPreGeomTop.{u} C) 1 q := by
      rw [Category.assoc]
    _ = ((faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫ affineFaceDegreeRaw K C q) ≫
        singularSubdivisionIterDegree K
          (liftedPreGeomTop.{u} C) 1 q := by
      rw [affineFaceDegreeRaw_boundary_succ]
    _ = (faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫
        (affineFaceDegreeRaw K C q ≫
          singularSubdivisionIterDegree K
            (liftedPreGeomTop.{u} C) 1 q) := by
      rw [Category.assoc]
    _ = (faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫
        (affineSubdivisionLiftedSmallDegree K C q ≫
          (SSet.chainComplexMap
            (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
            (ModuleCat.of K K)).f q) := by
      rw [affineSubdivisionLiftedSmallDegree_inclusion]
    _ = ((faceChainComplex K (AugmentedComplex.ofPre C)).d
          (q + 2) (q + 1) ≫
        affineSubdivisionLiftedSmallDegree K C q) ≫
          (SSet.chainComplexMap
            (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
            (ModuleCat.of K K)).f q := by
      rw [Category.assoc]

/-! ## Augmentation and chain-map packaging -/

/-- A subdivided affine vertex has augmentation one in the lifted small
singular complex. -/
theorem affineSubdivisionLiftedSmallGenerator_augmentation
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) 1) :
    affineSubdivisionLiftedSmallGenerator K C F ≫
        sSetAugmentation K (liftedStarSmallSingularSSet.{u} C) =
      𝟙 (ModuleCat.of K K) := by
  calc
    affineSubdivisionLiftedSmallGenerator K C F ≫
        sSetAugmentation K (liftedStarSmallSingularSSet.{u} C) =
      affineSubdivisionLiftedSmallGenerator K C F ≫
        ((SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f 0 ≫
        sSetAugmentation K
          (singularSSet (liftedPreGeomTop.{u} C))) := by
      rw [sSetAugmentation_naturality]
    _ = (affineSubdivisionLiftedSmallGenerator K C F ≫
        (SSet.chainComplexMap
          (smallSingularSubcomplex (liftedOpenStar.{u} C)).ι
          (ModuleCat.of K K)).f 0) ≫
        sSetAugmentation K
          (singularSSet (liftedPreGeomTop.{u} C)) := by
      rw [Category.assoc]
    _ = (affineFaceGenerator K C F ≫
          singularSubdivisionIterDegree K
            (liftedPreGeomTop.{u} C) 1 0) ≫
        sSetAugmentation K
          (singularSSet (liftedPreGeomTop.{u} C)) := by
      rw [affineSubdivisionLiftedSmallGenerator_inclusion_eq_subdivision]
    _ = affineFaceGenerator K C F ≫
        sSetAugmentation K
          (singularSSet (liftedPreGeomTop.{u} C)) := by
      rw [singularSubdivisionIterDegree_zero]
      change ((((singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
          (affineFaceSimplexLifted C F) :
            ModuleCat.of K K ⟶
              (sSetChainComplex K
                (singularSSet (liftedPreGeomTop.{u} C))).X 0) ≫
            𝟙 _) ≫
          sSetAugmentation K
            (singularSSet (liftedPreGeomTop.{u} C))) =
        (singularSSet (liftedPreGeomTop.{u} C)).ιChainComplex
            (affineFaceSimplexLifted C F) ≫
          sSetAugmentation K
            (singularSSet (liftedPreGeomTop.{u} C))
      simp
    _ = 𝟙 (ModuleCat.of K K) :=
      affineFaceGenerator_augmentation K C F

/-- Degree-zero part of the lifted-small map. -/
noncomputable def affineSubdivisionLiftedSmallZero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (faceChainComplex K (AugmentedComplex.ofPre C)).X 0 ⟶
      ModuleCat.of K K :=
  ModuleCat.ofHom (affineFaceZeroLinear K C)

/-- The augmentation differential square for the lifted-small map. -/
theorem affineSubdivisionLiftedSmallDegree_boundary_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    affineSubdivisionLiftedSmallDegree K C 0 ≫
        sSetAugmentation K (liftedStarSmallSingularSSet.{u} C) =
      (faceChainComplex K (AugmentedComplex.ofPre C)).d 1 0 ≫
        affineSubdivisionLiftedSmallZero K C := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom]
  change (sSetAugmentation K
      (liftedStarSmallSingularSSet.{u} C)).hom.comp
        (affineSubdivisionLiftedSmallDegreeLinear K C 0) =
    (affineFaceZeroLinear K C).comp
      (faceBoundary K (AugmentedComplex.ofPre C) 0)
  apply Finsupp.lhom_ext
  intro F a
  rw [LinearMap.comp_apply, LinearMap.comp_apply,
    affineSubdivisionLiftedSmallDegreeLinear_single, map_smul,
    faceBoundary_single, map_smul]
  congr 1
  have hgen :
      (sSetAugmentation K
        (liftedStarSmallSingularSSet.{u} C)).hom
        ((affineSubdivisionLiftedSmallGenerator K C F).hom 1) =
      (1 : K) := by
    have h := congrArg
      (fun f : ModuleCat.of K K ⟶ ModuleCat.of K K ↦ f.hom (1 : K))
      (affineSubdivisionLiftedSmallGenerator_augmentation K C F)
    change (sSetAugmentation K
        (liftedStarSmallSingularSSet.{u} C)).hom
        ((affineSubdivisionLiftedSmallGenerator K C F).hom 1) =
      (1 : K) at h
    exact h
  rw [hgen]
  exact (affineFaceZeroLinear_boundaryOn K C F).symm

/-- The canonical one-subdivision affine map with values in lifted
coordinate-star-small augmented singular chains. -/
noncomputable def augmentedAffineSubdivisionLiftedSmall
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    faceChainComplex K (AugmentedComplex.ofPre C) ⟶
      augmentedSmallSingularChainComplex K (liftedOpenStar.{u} C) where
  f
    | 0 => affineSubdivisionLiftedSmallZero K C
    | q + 1 => affineSubdivisionLiftedSmallDegree K C q
  comm' i j hij := by
    rcases i with _ | i
    · simp at hij
    rcases j with _ | j
    · have hi : i = 0 := by simpa using hij
      subst i
      exact affineSubdivisionLiftedSmallDegree_boundary_zero K C
    · have hi : j + 1 = i := by simpa using hij
      subst i
      exact affineSubdivisionLiftedSmallDegree_boundary_succ K C j

@[simp]
theorem augmentedAffineSubdivisionLiftedSmall_f_zero
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (augmentedAffineSubdivisionLiftedSmall K C).f 0 =
      affineSubdivisionLiftedSmallZero K C := rfl

@[simp]
theorem augmentedAffineSubdivisionLiftedSmall_f_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (augmentedAffineSubdivisionLiftedSmall K C).f (q + 1) =
      affineSubdivisionLiftedSmallDegree K C q := rfl

/-- The lifted-small affine map transported to the low-universe carrier
complex used by the finite reverse map. -/
noncomputable def augmentedAffineSubdivisionSmall
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    faceChainComplex K (AugmentedComplex.ofPre C) ⟶
      augmentedStarSmallChainComplex K C :=
  augmentedAffineSubdivisionLiftedSmall K C ≫
    augmentedLiftedSmallToSmall K C

end SimplicialSphereAnisotropicity.Topology

end

