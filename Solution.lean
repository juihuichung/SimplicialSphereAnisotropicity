/-!
# The Brion Gram determinant

This module compares the canonical face ring with the product of its generic
facet-coordinate rings.  The joint facet-restriction map is injective, so its
square coordinate matrix has nonzero determinant.  After passing to the
parameter fraction field, the Brion Gram matrix factors as the transpose of
that restriction matrix, a diagonal matrix of nonzero inverse Euler weights,
and the restriction matrix itself.

For a homogeneous parameter-ring basis, the Hilbert incidence identity makes
every nonzero Leibniz term of the Gram determinant have total degree zero.
Thus the determinant is both nonzero and homogeneous of degree zero, hence is
a unit.  The final wrappers derive every hypothesis from the trusted
simplicial-sphere predicate.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

def augmentedSimplexEquivFacetOfCard
    {m : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (d : ℕ) (hd : 0 < d) :
    AugmentedSimplex (AugmentedComplex.ofAbstract D) d ≃
      FacetOfCard D d where
  toFun F := ⟨F.1,
    (AugmentedComplex.nonempty_mem_ofAbstract_iff D
      (Finset.card_pos.mp (by simpa [F.2.2] using hd))).mp F.2.1,
    F.2.2⟩
  invFun F := ⟨F.1, Or.inr F.2.1, F.2.2⟩
  left_inv _F := rfl
  right_inv _F := rfl

def augmentedSimplexEquivTopCardFace
    {m d : ℕ} (C : AugmentedComplex (Fin m)) :
    AugmentedSimplex C d ≃ TopCardFace C d where
  toFun F := ⟨⟨F.1, F.2.1⟩, F.2.2⟩
  invFun F := ⟨F.1.1, F.1.2, F.2⟩
  left_inv _F := rfl
  right_inv _F := rfl

theorem card_facetOfCard_eq_faceCardCount
    {m : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (d : ℕ) (hd : 0 < d) :
    Fintype.card (FacetOfCard D d) =
      faceCardCount (AugmentedComplex.ofAbstract D) d := by
  calc
    Fintype.card (FacetOfCard D d) =
        Fintype.card
          (AugmentedSimplex (AugmentedComplex.ofAbstract D) d) :=
      Fintype.card_congr (augmentedSimplexEquivFacetOfCard D d hd).symm
    _ = Fintype.card
        (TopCardFace (AugmentedComplex.ofAbstract D) d) :=
      Fintype.card_congr
        (augmentedSimplexEquivTopCardFace
          (AugmentedComplex.ofAbstract D))
    _ = faceCardCount (AugmentedComplex.ofAbstract D) d :=
      card_topCardFace_eq_faceCardCount _

set_option linter.style.haveILetI false in
noncomputable def faceRingFacetRestrictionLinearMap
    (k : Type*) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D) →ₗ[Generic.ParameterRing k n m]
      (FacetOfCard D (n + 1) → Generic.ParameterRing k n m) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  exact
    { toFun := fun z F ↦
        facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
          (genericCoefficientMatrix k) F.1 F.2.2
          (genericFacetMatrix_det_ne_zero k F)
          (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D) z)
      map_add' := by
        intro x y
        funext F
        rw [map_add, map_add, Pi.add_apply]
      map_smul' := by
        intro p z
        funext F
        rw [faceRingModelCanonical_smul_eq_facePart]
        change facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
            (genericCoefficientMatrix k) F.1 F.2.2
            (genericFacetMatrix_det_ne_zero k F)
            (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
              (AugmentedComplex.ofAbstract D)
              (polynomialFacePart (SimplicialSphereAnisotropicity.GenericField k n m)
                (AugmentedComplex.ofAbstract D)
                (ambientParameterAlgHom k p *
                  faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
                    (AugmentedComplex.ofAbstract D) z))) =
          p * facetRestriction (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
            (genericCoefficientMatrix k) F.1 F.2.2
            (genericFacetMatrix_det_ne_zero k F)
            (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
              (AugmentedComplex.ofAbstract D) z)
        rw [facetRestriction_facePart, map_mul,
          ← parameterActionAlgHom_genericCoefficientMatrix k,
          facetRestriction_parameterActionAlgHom] }

set_option linter.style.haveILetI false in
theorem faceRingFacetRestrictionLinearMap_injective
    (k : Type*) [Field k] [CharP k 2] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hbound : FacesBoundedBy
      (AugmentedComplex.ofAbstract D) (n + 1))
    (hall : IsAllLinkHomologySphere (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D) (n + 1)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    Function.Injective
      (faceRingFacetRestrictionLinearMap k (n := n) D) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  intro x y hxy
  apply faceCoordinateSource_injective k
    (d := n + 1) (AugmentedComplex.ofAbstract D) hbound hall
  funext A
  rw [faceCoordinateSource_eq_ambientFaceRestriction,
    faceCoordinateSource_eq_ambientFaceRestriction]
  let F : FacetOfCard D (n + 1) :=
    augmentedSimplexEquivFacetOfCard D (n + 1) (by omega) A
  have hF := congrFun hxy F
  change (facetParameterAlgEquiv (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) F.1 F.2.2
        (genericFacetMatrix_det_ne_zero k F)).symm
      (ambientFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) F.1
        (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) x)) =
    (facetParameterAlgEquiv (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
        (genericCoefficientMatrix k) F.1 F.2.2
        (genericFacetMatrix_det_ne_zero k F)).symm
      (ambientFaceRestriction (SimplicialSphereAnisotropicity.GenericField k n m) F.1
        (faceRingModelToPolynomial (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D) y)) at hF
  exact (facetParameterAlgEquiv (SimplicialSphereAnisotropicity.GenericField k n m) (n + 1)
    (genericCoefficientMatrix k) F.1 F.2.2
    (genericFacetMatrix_det_ne_zero k F)).symm.injective hF

set_option linter.style.haveILetI false in
noncomputable def faceRingFacetRestrictionCoordinateLinearMap
    (k : Type*) [Field k] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)))
    (e : FacetOfCard D (n + 1) ≃ Fin N) :
    (Fin N → Generic.ParameterRing k n m) →ₗ[Generic.ParameterRing k n m]
      (Fin N → Generic.ParameterRing k n m) := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  exact
    { toFun := fun c i ↦
        faceRingFacetRestrictionLinearMap k (n := n) D
          (b.equivFun.symm c) (e.symm i)
      map_add' := by
        intro x y
        funext i
        change faceRingFacetRestrictionLinearMap k (n := n) D
            (b.equivFun.symm (x + y)) (e.symm i) =
          faceRingFacetRestrictionLinearMap k (n := n) D
              (b.equivFun.symm x) (e.symm i) +
            faceRingFacetRestrictionLinearMap k (n := n) D
              (b.equivFun.symm y) (e.symm i)
        rw [map_add, map_add, Pi.add_apply]
      map_smul' := by
        intro p x
        funext i
        change faceRingFacetRestrictionLinearMap k (n := n) D
            (b.equivFun.symm (p • x)) (e.symm i) =
          p • faceRingFacetRestrictionLinearMap k (n := n) D
            (b.equivFun.symm x) (e.symm i)
        rw [map_smul, map_smul, Pi.smul_apply] }

set_option linter.style.haveILetI false in
theorem faceRingFacetRestrictionCoordinateLinearMap_injective
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
