section

noncomputable section

open scoped BigOperators
open Matrix MvPolynomial

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v

abbrev ParameterPolynomial (L : Type u) [Field L] (d : ℕ) :=
  MvPolynomial (Fin d) L

abbrev ParameterFraction (L : Type u) [Field L] (d : ℕ) :=
  FractionRing (ParameterPolynomial L d)

noncomputable def facetMatrix
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d) : Matrix (Fin d) (Fin d) L :=
  fun i j ↦ a i (F.orderEmbOfFin hF j)

noncomputable def facetParameterAlgEquiv
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    ParameterPolynomial L d ≃ₐ[L] MvPolynomial ↥F L :=
  (SimplicialSphereAnisotropicity.Generic.matrixLinearAlgEquiv
      (facetMatrix L d a F hF) (isUnit_iff_ne_zero.mpr hdet)).trans
    (MvPolynomial.renameEquiv L (F.orderIsoOfFin hF).toEquiv)

@[simp]
theorem facetParameterAlgEquiv_X
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (i : Fin d) :
    facetParameterAlgEquiv L d a F hF hdet (MvPolynomial.X i) =
      ∑ j : Fin d,
        MvPolynomial.C (a i (F.orderEmbOfFin hF j)) *
          MvPolynomial.X (F.orderIsoOfFin hF j) := by
  simp [facetParameterAlgEquiv, facetMatrix,
    SimplicialSphereAnisotropicity.Generic.matrixLinearAlgEquiv]

theorem facetParameterAlgEquiv_X_subtype
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (i : Fin d) :
    facetParameterAlgEquiv L d a F hF hdet (MvPolynomial.X i) =
      ∑ v : ↥F,
        MvPolynomial.C (a i v.1) * MvPolynomial.X v := by
  rw [facetParameterAlgEquiv_X]
  let o := F.orderIsoOfFin hF
  simpa [o] using
    (Equiv.sum_comp o.toEquiv
      (fun v : ↥F ↦ MvPolynomial.C (a i v.1) * MvPolynomial.X v))

noncomputable def inverseCoordinate
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) : ParameterPolynomial L d :=
  (facetParameterAlgEquiv L d a F hF hdet).symm
    (MvPolynomial.X v)

@[simp]
theorem facetParameterAlgEquiv_inverseCoordinate
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    facetParameterAlgEquiv L d a F hF hdet
        (inverseCoordinate L d a F hF hdet v) =
      MvPolynomial.X v := by
  exact (facetParameterAlgEquiv L d a F hF hdet).apply_symm_apply _

set_option linter.unnecessarySimpa false in
theorem inverseCoordinate_ne_zero
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    inverseCoordinate L d a F hF hdet v ≠ 0 := by
  intro hz
  have := congrArg (facetParameterAlgEquiv L d a F hF hdet) hz
  simpa using this

theorem inverseCoordinate_eq_sum
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    inverseCoordinate L d a F hF hdet v =
      ∑ i : Fin d,
        MvPolynomial.C
            ((facetMatrix L d a F hF)⁻¹
              ((F.orderIsoOfFin hF).symm v) i) *
          MvPolynomial.X i := by
  simp [inverseCoordinate, facetParameterAlgEquiv,
    SimplicialSphereAnisotropicity.Generic.matrixLinearAlgEquiv,
    SimplicialSphereAnisotropicity.Generic.matrixLinearAlgHom_X]

theorem inverseCoordinate_isHomogeneous
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    (inverseCoordinate L d a F hF hdet v).IsHomogeneous 1 := by
  rw [inverseCoordinate_eq_sum]
  apply MvPolynomial.IsHomogeneous.sum
  intro i _hi
  exact MvPolynomial.isHomogeneous_C_mul_X _ _

theorem inverseCoordinates_linearIndependent
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    LinearIndependent L
      (inverseCoordinate L d a F hF hdet :
        ↥F → ParameterPolynomial L d) := by
  let e : MvPolynomial ↥F L →ₗ[L] ParameterPolynomial L d :=
    { toFun := (facetParameterAlgEquiv L d a F hF hdet).symm
      map_add' := map_add _
      map_smul' := by
        intro c p
        simp }
  have h := (MvPolynomial.linearIndependent_X (σ := ↥F) (R := L)).map'
    e (LinearMap.ker_eq_bot.mpr
      (facetParameterAlgEquiv L d a F hF hdet).symm.injective)
  change LinearIndependent L (fun v ↦ e (MvPolynomial.X v)) at h
  have heq : (fun v : ↥F ↦ e (MvPolynomial.X v)) =
      inverseCoordinate L d a F hF hdet := by
    funext v
    rfl
  rw [heq] at h
  exact h

theorem map_C_facetMatrix_inv
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    ((MvPolynomial.C : L →+* ParameterPolynomial L d).mapMatrix
        (facetMatrix L d a F hF))⁻¹ =
      (MvPolynomial.C : L →+* ParameterPolynomial L d).mapMatrix
        (facetMatrix L d a F hF)⁻¹ := by
  let φ : L →+* ParameterPolynomial L d := MvPolynomial.C
  change (φ.mapMatrix (facetMatrix L d a F hF))⁻¹ =
    φ.mapMatrix (facetMatrix L d a F hF)⁻¹
  apply Matrix.inv_eq_left_inv
  change (facetMatrix L d a F hF)⁻¹.map φ *
      (facetMatrix L d a F hF).map φ = 1
  rw [← Matrix.map_mul,
    Matrix.nonsing_inv_mul (facetMatrix L d a F hF)
      (isUnit_iff_ne_zero.mpr hdet)]
  simp

theorem map_C_facetMatrix_isUnit_det
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    IsUnit (((MvPolynomial.C : L →+* ParameterPolynomial L d).mapMatrix
      (facetMatrix L d a F hF)).det) := by
  let φ : L →+* ParameterPolynomial L d := MvPolynomial.C
  change IsUnit ((φ.mapMatrix (facetMatrix L d a F hF)).det)
  rw [← φ.map_det]
  exact (isUnit_iff_ne_zero.mpr hdet).map φ

noncomputable def facetCramerPolynomial
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (v : ↥F) : ParameterPolynomial L d :=
  Matrix.cramer
    ((MvPolynomial.C : L →+* ParameterPolynomial L d).mapMatrix
      (facetMatrix L d a F hF))
    (fun i ↦ MvPolynomial.X i) ((F.orderIsoOfFin hF).symm v)

theorem det_mul_inverseCoordinate_eq_facetCramerPolynomial
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : ↥F) :
    MvPolynomial.C (facetMatrix L d a F hF).det *
        inverseCoordinate L d a F hF hdet v =
      facetCramerPolynomial L d a F hF v := by
  let φ : L →+* ParameterPolynomial L d := MvPolynomial.C
  let A := facetMatrix L d a F hF
  let Ap : Matrix (Fin d) (Fin d) (ParameterPolynomial L d) :=
    φ.mapMatrix A
  let t : Fin d → ParameterPolynomial L d := fun i ↦ MvPolynomial.X i
  let j : Fin d := (F.orderIsoOfFin hF).symm v
  have hcr := congrFun
    (Matrix.det_smul_inv_mulVec_eq_cramer Ap t
      (map_C_facetMatrix_isUnit_det L d a F hF hdet)) j
  rw [inverseCoordinate_eq_sum]
  change φ A.det *
      (∑ i : Fin d, φ (A⁻¹ j i) * t i) = Matrix.cramer Ap t j
  have hdetmap : Ap.det = φ A.det := by
    dsimp only [Ap]
    exact (φ.map_det A).symm
  have hinvmap : Ap⁻¹ = φ.mapMatrix A⁻¹ := by
    dsimp only [Ap, A, φ]
    exact map_C_facetMatrix_inv L d a F hF hdet
  have hmulvec : (Ap⁻¹ *ᵥ t) j =
      ∑ i : Fin d, φ (A⁻¹ j i) * t i := by
    rw [hinvmap]
    simp only [Matrix.mulVec, dotProduct, RingHom.mapMatrix_apply]
    apply Finset.sum_congr rfl
    intro i _hi
    rfl
  rw [Pi.smul_apply, smul_eq_mul, hdetmap, hmulvec] at hcr
  exact hcr

theorem facetCramerPolynomial_eq_updateCol_det
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d) (v : ↥F) :
    facetCramerPolynomial L d a F hF v =
      (((MvPolynomial.C : L →+* ParameterPolynomial L d).mapMatrix
          (facetMatrix L d a F hF)).updateCol
        ((F.orderIsoOfFin hF).symm v) (fun i ↦ MvPolynomial.X i)).det := by
  exact Matrix.cramer_apply _ _ _

theorem facetCramerPolynomial_ne_zero
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) (v : ↥F) :
    facetCramerPolynomial L d a F hF v ≠ 0 := by
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
    L d a F hF hdet v]
  exact mul_ne_zero (MvPolynomial.C_ne_zero.mpr hdet)
    (inverseCoordinate_ne_zero L d a F hF hdet v)

theorem facetCramerPolynomial_isHomogeneous
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) (v : ↥F) :
    (facetCramerPolynomial L d a F hF v).IsHomogeneous 1 := by
  rw [← det_mul_inverseCoordinate_eq_facetCramerPolynomial
    L d a F hF hdet v]
  have hc :
      (MvPolynomial.C (facetMatrix L d a F hF).det :
        ParameterPolynomial L d).IsHomogeneous 0 :=
    MvPolynomial.isHomogeneous_C _ _
  simpa using hc.mul
    (inverseCoordinate_isHomogeneous L d a F hF hdet v)

noncomputable def facetRestriction
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    MvPolynomial V L →ₐ[L] ParameterPolynomial L d :=
  (facetParameterAlgEquiv L d a F hF hdet).symm.toAlgHom.comp
    (MvPolynomial.killCompl
      (f := fun v : ↥F ↦ v.1) Subtype.val_injective)

@[simp]
theorem facetRestriction_X_mem
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : V) (hv : v ∈ F) :
    facetRestriction L d a F hF hdet (MvPolynomial.X v) =
      inverseCoordinate L d a F hF hdet ⟨v, hv⟩ := by
  let e : ↥F ↪ V := Function.Embedding.subtype (fun w : V ↦ w ∈ F)
  change (facetParameterAlgEquiv L d a F hF hdet).symm
      (MvPolynomial.killCompl e.injective
        (MvPolynomial.X (e ⟨v, hv⟩))) = _
  rw [SimplicialSphereAnisotropicity.Generic.killCompl_X_embedding]
  rfl

@[simp]
theorem facetRestriction_X_not_mem
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (v : V) (hv : v ∉ F) :
    facetRestriction L d a F hF hdet (MvPolynomial.X v) = 0 := by
  let e : ↥F ↪ V := Function.Embedding.subtype (fun w : V ↦ w ∈ F)
  change (facetParameterAlgEquiv L d a F hF hdet).symm
      (MvPolynomial.killCompl e.injective (MvPolynomial.X v)) = 0
  rw [SimplicialSphereAnisotropicity.Generic.killCompl_X_eq_zero e v]
  · simp
  · rintro ⟨w, hw⟩
    apply hv
    rw [← hw]
    exact w.2

noncomputable def parameterLinearForm
    (L : Type u) [Field L]
    {V : Type v} [Fintype V]
    (d : ℕ) (a : Matrix (Fin d) V L) (i : Fin d) :
    MvPolynomial V L :=
  ∑ v, MvPolynomial.C (a i v) * MvPolynomial.X v

theorem facetRestriction_parameterLinearForm
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    (i : Fin d) :
    facetRestriction L d a F hF hdet
        (parameterLinearForm L d a i) =
      MvPolynomial.X i := by
  let e : ↥F ↪ V := Function.Embedding.subtype (fun w : V ↦ w ∈ F)
  change (facetParameterAlgEquiv L d a F hF hdet).symm
      (MvPolynomial.killCompl e.injective
        (∑ v, MvPolynomial.C (a i v) * MvPolynomial.X v)) = _
  rw [SimplicialSphereAnisotropicity.Generic.killCompl_sum_C_mul_X e (fun v ↦ a i v)]
  change (facetParameterAlgEquiv L d a F hF hdet).symm
      (∑ v : ↥F, MvPolynomial.C (a i v.1) * MvPolynomial.X v) = _
  apply (facetParameterAlgEquiv L d a F hF hdet).injective
  rw [(facetParameterAlgEquiv L d a F hF hdet).apply_symm_apply]
  exact (facetParameterAlgEquiv_X_subtype L d a F hF hdet i).symm

theorem parameterLinearForm_isHomogeneous
    (L : Type u) [Field L]
    {V : Type v} [Fintype V]
    (d : ℕ) (a : Matrix (Fin d) V L) (i : Fin d) :
    (parameterLinearForm L d a i).IsHomogeneous 1 := by
  apply MvPolynomial.IsHomogeneous.sum
  intro v _hv
  exact MvPolynomial.isHomogeneous_C_mul_X _ _

theorem facetRestriction_faceProduct
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    facetRestriction L d a F hF hdet
        (∏ v ∈ F, MvPolynomial.X v) =
      ∏ v : ↥F, inverseCoordinate L d a F hF hdet v := by
  rw [map_prod]
  apply Finset.prod_bij (fun v hv ↦ (⟨v, hv⟩ : ↥F))
  · intro v hv
    simp
  · intro v₁ hv₁ v₂ hv₂ heq
    exact congrArg Subtype.val heq
  · intro v _hv
    exact ⟨v.1, v.2, rfl⟩
  · intro v hv
    exact facetRestriction_X_mem L d a F hF hdet v hv

noncomputable def facetEuler
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    ParameterPolynomial L d :=
  MvPolynomial.C (facetMatrix L d a F hF).det *
    ∏ v : ↥F, inverseCoordinate L d a F hF hdet v

theorem facetEuler_ne_zero
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    facetEuler L d a F hF hdet ≠ 0 := by
  rw [facetEuler]
  exact mul_ne_zero (MvPolynomial.C_ne_zero.mpr hdet)
    (Finset.prod_ne_zero_iff.mpr fun v _hv ↦
      inverseCoordinate_ne_zero L d a F hF hdet v)

theorem facetEuler_isHomogeneous
    (L : Type u) [Field L]
    {V : Type v} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0) :
    (facetEuler L d a F hF hdet).IsHomogeneous d := by
  rw [facetEuler]
  have hp := MvPolynomial.IsHomogeneous.prod
    (Finset.univ : Finset ↥F)
    (inverseCoordinate L d a F hF hdet)
    (fun _v ↦ 1)
    (fun v _hv ↦ inverseCoordinate_isHomogeneous L d a F hF hdet v)
  have hp' :
      (∏ v : ↥F, inverseCoordinate L d a F hF hdet v).IsHomogeneous d := by
    simpa [Fintype.card_coe, hF] using hp
  have hc :
      (MvPolynomial.C (facetMatrix L d a F hF).det :
        ParameterPolynomial L d).IsHomogeneous 0 :=
    MvPolynomial.isHomogeneous_C _ _
  simpa using hc.mul hp'

end SimplicialSphereAnisotropicity.Generic.Brion

end

