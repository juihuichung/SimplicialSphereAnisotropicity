import Mathlib

set_option synthInstance.maxHeartbeats 200000

/-!
# Characteristic-two anisotropicity of simplicial spheres

This file proves that every positive-dimensional simplicial sphere is
generically anisotropic over every field of characteristic two.
-/

section

/-!
# The generic Artinian reduction of a simplicial complex

This file fixes the objects occurring in Definitions 2.2 and 3.2 of
Papadakis--Petrotou.  Vertices are indexed by `Fin m`; this is only the
zero-based version of the paper's vertex set `{1, ..., m}`.

The grading on a quotient is represented extensionally: a quotient class is
homogeneous of degree `j` when it has a homogeneous polynomial representative
of degree `j`.  Once homogeneity of the defining ideal has been developed,
this agrees with membership in the degree-`j` graded component.
-/

noncomputable section

open scoped BigOperators

namespace SimplicialSphereAnisotropicity

open MvPolynomial

section Sphere

/-- The support of a barycentric coordinate vector. -/
def barycentricSupport {m : ℕ} (x : Fin m → ℝ) : Finset (Fin m) :=
  Finset.univ.filter fun v ↦ x v ≠ 0

/--
The canonical geometric realization of a finite abstract simplicial complex:
nonnegative barycentric coordinate vectors of total mass one whose support is
a face.
-/
def geometricRealization {m : ℕ} (D : AbstractSimplicialComplex (Fin m)) :
    Set (Fin m → ℝ) :=
  {x | (∀ v, 0 ≤ x v) ∧ (∑ v, x v) = 1 ∧ barycentricSupport x ∈ D}

/-- `D` has combinatorial dimension exactly `n`. -/
def HasDimension {m : ℕ} (D : AbstractSimplicialComplex (Fin m)) (n : ℕ) : Prop :=
  (∀ s : Finset (Fin m), s ∈ D → s.card ≤ n + 1) ∧
    ∃ s : Finset (Fin m), s ∈ D ∧ s.card = n + 1

/--
A finite simplicial sphere of dimension `n`.

The topological condition uses the canonical barycentric realization and the
unit sphere in `ℝ^(n+1)`, i.e. the standard `n`-sphere.  The explicit
dimension clause records the paper's combinatorial dimension convention.
-/
def IsSimplicialSphere {m : ℕ} (D : AbstractSimplicialComplex (Fin m)) (n : ℕ) : Prop :=
  HasDimension D n ∧
    Nonempty
      (geometricRealization D ≃ₜ
        Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)

end Sphere

section Reduction

variable (k₁ : Type*) [Field k₁]

/-- The polynomial ring `k₁[a_(i,j)]` of generic coefficients. -/
abbrev CoefficientPolynomial (n m : ℕ) :=
  MvPolynomial (Fin (n + 1) × Fin m) k₁

/-- The purely transcendental coefficient field `k₁(a_(i,j))`. -/
abbrev GenericField (n m : ℕ) :=
  FractionRing (CoefficientPolynomial k₁ n m)

/-- The coefficient `a_(i,j)` in the generic coefficient field. -/
def genericCoefficient {n m : ℕ} (i : Fin (n + 1)) (j : Fin m) :
    GenericField k₁ n m :=
  algebraMap (CoefficientPolynomial k₁ n m) (GenericField k₁ n m)
    (MvPolynomial.X (i, j))

/-- The square-free monomial attached to a set of vertices. -/
def faceMonomial {K : Type*} [CommSemiring K] {m : ℕ} (s : Finset (Fin m)) :
    MvPolynomial (Fin m) K :=
  ∏ v ∈ s, MvPolynomial.X v

/--
The Stanley--Reisner ideal, generated by the square-free monomials belonging
to nonempty nonfaces of `D`.
-/
def stanleyReisnerIdeal {K : Type*} [CommSemiring K] {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) : Ideal (MvPolynomial (Fin m) K) :=
  Ideal.span
    {p | ∃ s : Finset (Fin m), s.Nonempty ∧ s ∉ D ∧ p = faceMonomial s}

/-- The generic degree-one parameter `f_i = Σ_j a_(i,j) x_j`. -/
def genericLinearForm {n m : ℕ} (i : Fin (n + 1)) :
    MvPolynomial (Fin m) (GenericField k₁ n m) :=
  ∑ j : Fin m, MvPolynomial.C (genericCoefficient k₁ i j) * MvPolynomial.X j

/-- The ideal generated by all `n+1` generic linear parameters. -/
def genericParameterIdeal (n m : ℕ) :
    Ideal (MvPolynomial (Fin m) (GenericField k₁ n m)) :=
  Ideal.span (Set.range (genericLinearForm k₁ (n := n) (m := m)))

/-- The Stanley--Reisner and generic-parameter relations together. -/
def genericReductionIdeal {n m : ℕ} (D : AbstractSimplicialComplex (Fin m)) :
    Ideal (MvPolynomial (Fin m) (GenericField k₁ n m)) :=
  stanleyReisnerIdeal D ⊔ genericParameterIdeal k₁ n m

/-- The paper's generic Artinian reduction `A`. -/
abbrev GenericArtinianReduction {n m : ℕ} (D : AbstractSimplicialComplex (Fin m)) :=
  MvPolynomial (Fin m) (GenericField k₁ n m) ⧸ genericReductionIdeal k₁ D

/-- A class in `A` lying in its homogeneous component of degree `j`. -/
def IsHomogeneousClass {n m : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (j : ℕ) (u : GenericArtinianReduction k₁ (n := n) D) : Prop :=
  ∃ p : MvPolynomial (Fin m) (GenericField k₁ n m),
    p.IsHomogeneous j ∧
      Ideal.Quotient.mk (genericReductionIdeal k₁ D) p = u

/--
Definition 3.2: every nonzero homogeneous class through half the socle degree
has nonzero square.
-/
def GenericallyAnisotropic {m : ℕ} (D : AbstractSimplicialComplex (Fin m))
    (n : ℕ) : Prop :=
  ∀ j : ℕ, 1 ≤ j → 2 * j ≤ n + 1 →
    ∀ u : GenericArtinianReduction k₁ (n := n) D,
      IsHomogeneousClass k₁ D j u → u ≠ 0 → u ^ 2 ≠ 0

end Reduction

end SimplicialSphereAnisotropicity

end

end

section

noncomputable section

open scoped Pointwise
open RingTheory.Sequence
open CategoryTheory

universe u v

namespace SimplicialSphereAnisotropicity.Algebra

lemma ideal_ofList_map_X_eq_span
    {R : Type u} [CommSemiring R] {sigma : Type v}
    (l : List sigma) :
    Ideal.ofList (l.map (MvPolynomial.X (R := R))) =
      Ideal.span
        (MvPolynomial.X '' {i : sigma | i ∈ l} :
          Set (MvPolynomial sigma R)) := by
  apply congrArg Ideal.span
  ext p
  simp

lemma ideal_smul_top_eq_self
    {R : Type u} [CommRing R] (I : Ideal R) :
    I • (⊤ : Submodule R R) = (I : Submodule R R) := by
  rw [smul_eq_mul, Ideal.mul_top]

lemma current_not_mem_take
    {sigma : Type v} (l : List sigma) (hl : l.Nodup)
    (i : ℕ) (hi : i < l.length) :
    l[i] ∉ l.take i := by
  classical
  intro hmem
  have hcur : l[i] ∈ l := by simp
  have hlt := (List.mem_take_iff_idxOf_lt hcur).mp hmem
  have hidx := List.get_idxOf hl ⟨i, hi⟩
  change l.idxOf l[i] = i at hidx
  rw [hidx] at hlt
  exact Nat.lt_irrefl i hlt

theorem isWeaklyRegular_map_X_of_nodup
    {R : Type u} [CommRing R] {sigma : Type v}
    (l : List sigma) (hl : l.Nodup) :
    IsWeaklyRegular (MvPolynomial sigma R)
      (l.map (MvPolynomial.X (R := R))) := by
  classical
  constructor
  intro i hi
  have hi' : i < l.length := by simpa using hi
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  have hsmul :
      Ideal.ofList
          ((l.map (MvPolynomial.X (R := R))).take i) •
            (⊤ : Submodule (MvPolynomial sigma R)
              (MvPolynomial sigma R)) =
        (Ideal.ofList
          ((l.map (MvPolynomial.X (R := R))).take i) :
            Submodule (MvPolynomial sigma R)
              (MvPolynomial sigma R)) :=
    ideal_smul_top_eq_self _
  rw [hsmul] at hp ⊢
  have htake :
      Ideal.ofList
          ((l.map (MvPolynomial.X (R := R))).take i) =
        Ideal.span
          (MvPolynomial.X '' {j : sigma | j ∈ l.take i} :
            Set (MvPolynomial sigma R)) := by
    simpa using ideal_ofList_map_X_eq_span
      (R := R) (l.take i)
  rw [htake] at hp ⊢
  have hmul :
      MvPolynomial.X l[i] * p ∈
        Ideal.span
          (MvPolynomial.X '' {j : sigma | j ∈ l.take i} :
            Set (MvPolynomial sigma R)) := by
    simpa only [List.getElem_map, smul_eq_mul] using hp
  rw [MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  have hshift :
      Finsupp.single l[i] 1 + m ∈
        (MvPolynomial.X l[i] * p).support := by
    rw [MvPolynomial.support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  have hcriterion :=
    (MvPolynomial.mem_ideal_span_X_image.mp hmul)
      (Finsupp.single l[i] 1 + m) hshift
  obtain ⟨j, hjprev, hjshift⟩ := hcriterion
  refine ⟨j, hjprev, ?_⟩
  have hjne : j ≠ l[i] := by
    intro hji
    subst j
    exact current_not_mem_take l hl i hi' hjprev
  simpa [Finsupp.single_apply, hjne] using hjshift

lemma hasProjectiveDimensionLT_quotSMulTop
    {R : Type u} [CommRing R] [Small.{v} R]
    (M : ModuleCat.{v} R) (x : R) (r : ℕ)
    (hx : IsSMulRegular M x)
    (hM : HasProjectiveDimensionLT M (r + 1)) :
    HasProjectiveDimensionLT
      (ModuleCat.of R (QuotSMulTop x M)) (r + 2) := by
  let S := ModuleCat.smulShortComplex M x
  have hS : S.ShortExact := hx.smulShortComplex_shortExact
  exact hS.hasProjectiveDimensionLT_X₃ (r + 1) hM
    (hasProjectiveDimensionLT_of_ge M (r + 1) (r + 2) (by omega))

lemma hasProjectiveDimensionLT_quotient_of_isWeaklyRegular
    {R : Type u} [CommRing R] [Small.{v} R]
    {M : Type v} [AddCommGroup M] [Module R M]
    (rs : List R) (hreg : IsWeaklyRegular M rs)
    (r : ℕ)
    (hM : HasProjectiveDimensionLT (ModuleCat.of R M) (r + 1)) :
    HasProjectiveDimensionLT
      (ModuleCat.of R
        (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))))
      (r + rs.length + 1) := by
  induction rs generalizing M r with
  | nil =>
      simp only [List.length_nil, Nat.add_zero]
      have hbot : Ideal.ofList ([] : List R) •
          (⊤ : Submodule R M) = ⊥ := by simp
      let e := Submodule.quotEquivOfEqBot
        (Ideal.ofList ([] : List R) • (⊤ : Submodule R M)) hbot
      let _ : HasProjectiveDimensionLT (ModuleCat.of R M) (r + 1) := hM
      exact hasProjectiveDimensionLT_of_iso e.toModuleIso.symm (r + 1)
  | cons x xs ih =>
      have hparts := (isWeaklyRegular_cons_iff M x xs).mp hreg
      have hQ : HasProjectiveDimensionLT
          (ModuleCat.of R (QuotSMulTop x M)) (r + 2) :=
        hasProjectiveDimensionLT_quotSMulTop
          (ModuleCat.of R M) x r hparts.1 hM
      have htail := ih hparts.2 (r + 1) hQ
      let e := Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner
        M x xs
      let _ : HasProjectiveDimensionLT
          (ModuleCat.of R
            (QuotSMulTop x M ⧸
              (Ideal.ofList xs •
                (⊤ : Submodule R (QuotSMulTop x M)))))
          ((r + 1) + xs.length + 1) := htail
      have hout := hasProjectiveDimensionLT_of_iso
        e.toModuleIso.symm ((r + 1) + xs.length + 1)
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hout

/-- A finite dependent product inherits a common projective-dimension
bound. -/
lemma hasProjectiveDimensionLT_pi
    {R : Type u} [Ring R] [Small.{v} R]
    {ι : Type} [Finite ι] (M : ι → Type v)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    (n : ℕ)
    (hM : ∀ i, HasProjectiveDimensionLT (ModuleCat.of R (M i)) n) :
    HasProjectiveDimensionLT (ModuleCat.of R (∀ i, M i)) n := by
  refine Module.pi_induction'
    (motive := fun N _ _ ↦
      HasProjectiveDimensionLT (ModuleCat.of R N) n)
    (motive' := fun N _ _ ↦
      HasProjectiveDimensionLT (ModuleCat.of R N) n)
    R ?_ ?_ ?_ ?_ M hM
  · intro N N' _ _ _ _ e hN
    let _ : HasProjectiveDimensionLT (ModuleCat.of R N) n := hN
    exact hasProjectiveDimensionLT_of_iso e.toModuleIso n
  · intro N N' _ _ _ _ e hN
    let _ : HasProjectiveDimensionLT (ModuleCat.of R N) n := hN
    exact hasProjectiveDimensionLT_of_iso e.toModuleIso n
  · let _ : HasProjectiveDimensionLT (ModuleCat.of R PUnit) 0 :=
      (ModuleCat.isZero_of_subsingleton
        (ModuleCat.of R PUnit)).hasProjectiveDimensionLT_zero
    exact hasProjectiveDimensionLT_of_ge
      (ModuleCat.of R PUnit) 0 n (Nat.zero_le n)
  · intro N N' _ _ _ _ hN hN'
    let _ : HasProjectiveDimensionLT (ModuleCat.of R N) n := hN
    let _ : HasProjectiveDimensionLT (ModuleCat.of R N') n := hN'
    exact hasProjectiveDimensionLT_of_iso
      (ModuleCat.biprodIsoProd
        (ModuleCat.of R N) (ModuleCat.of R N')) n

/-- Exact strict indices for a kernel step in a short-exact staircase. -/
lemma hasProjectiveDimensionLT_kernel_step
    {A : Type u} [Category A] [Abelian A]
    {S : ShortComplex A} (hS : S.ShortExact) (r : ℕ)
    (hMiddle : HasProjectiveDimensionLT S.X₂ (r + 1))
    (hRight : HasProjectiveDimensionLT S.X₃ (r + 2)) :
    HasProjectiveDimensionLT S.X₁ (r + 1) := by
  exact hS.hasProjectiveDimensionLT_X₁ (r + 1) hMiddle hRight

/-- The strict endpoint `< 1` is module projectivity. -/
lemma moduleProjective_of_hasProjectiveDimensionLT_one
    {R : Type u} [Ring R] [Small.{v} R]
    {M : Type v} [AddCommGroup M] [Module R M]
    (hM : HasProjectiveDimensionLT (ModuleCat.of R M) 1) :
    Module.Projective R M := by
  exact (IsProjective.iff_projective M).mpr
    (projective_iff_hasProjectiveDimensionLT_one.mpr hM)

/-- In an exact pair `A → B → C`, the usual short exact sequence
`0 → ker(f) → A → ker(g) → 0` gives one dimension-shifting step. -/
lemma hasProjectiveDimensionLT_ker_of_range_eq_ker
    {R : Type u} [Ring R] [Small.{v} R]
    {A B C : Type v}
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module R A] [Module R B] [Module R C]
    (f : A →ₗ[R] B) (g : B →ₗ[R] C)
    (hexact : LinearMap.range f = LinearMap.ker g)
    (r : ℕ)
    (hA : HasProjectiveDimensionLT (ModuleCat.of R A) (r + 1))
    (hker : HasProjectiveDimensionLT
      (ModuleCat.of R (LinearMap.ker g)) (r + 2)) :
    HasProjectiveDimensionLT
      (ModuleCat.of R (LinearMap.ker f)) (r + 1) := by
  let fc : A →ₗ[R] LinearMap.ker g :=
    f.codRestrict (LinearMap.ker g) (fun x ↦ by
      rw [← hexact]
      exact ⟨x, rfl⟩)
  have hsurj : Function.Surjective fc := by
    rintro ⟨y, hy⟩
    rw [← hexact] at hy
    obtain ⟨x, hx⟩ := hy
    exact ⟨x, Subtype.ext hx⟩
  have hpd : HasProjectiveDimensionLT
      (ModuleCat.of R (LinearMap.ker fc)) (r + 1) :=
    hasProjectiveDimensionLT_kernel_step
      (LinearMap.shortExact_shortComplexKer hsurj) r hA hker
  have hkerEq : LinearMap.ker fc = LinearMap.ker f := by
    dsimp [fc]
    exact LinearMap.ker_codRestrict _ _ _
  let eker : LinearMap.ker fc ≃ₗ[R] LinearMap.ker f :=
    LinearEquiv.ofEq _ _ hkerEq
  let _ : HasProjectiveDimensionLT
      (ModuleCat.of R (LinearMap.ker fc)) (r + 1) := hpd
  exact hasProjectiveDimensionLT_of_iso eker.toModuleIso (r + 1)

lemma ker_killCompl_eq_span_complement
    {K : Type u} [Field K] {sigma tau : Type v}
    (f : sigma → tau) (hf : Function.Injective f) :
    RingHom.ker (MvPolynomial.killCompl (R := K) hf).toRingHom =
      Ideal.span
        (MvPolynomial.X '' {i : tau | i ∉ Set.range f} :
          Set (MvPolynomial tau K)) := by
  classical
  ext p
  rw [RingHom.mem_ker, MvPolynomial.mem_ideal_span_X_image]
  change MvPolynomial.killCompl hf p = 0 ↔ _
  constructor
  · intro hp m hm
    by_contra! hOutside
    have hsupp : (m.support : Set tau) ⊆ Set.range f := by
      intro i hi
      by_contra hiRange
      exact (Finsupp.mem_support_iff.mp hi) (hOutside i hiRange)
    let s : sigma →₀ ℕ := m.comapDomain f hf.injOn
    have hmap : s.mapDomain f = m :=
      Finsupp.mapDomain_comapDomain f hf m hsupp
    have hcoeff : p.coeff m = 0 := by
      calc
        p.coeff m = p.coeff (s.mapDomain f) := by rw [hmap]
        _ = (MvPolynomial.killCompl hf p).coeff s := by
          exact (MvPolynomial.coeff_killCompl (p := p) hf).symm
        _ = 0 := by rw [hp, MvPolynomial.coeff_zero]
    exact (MvPolynomial.mem_support_iff.mp hm hcoeff).elim
  · intro hp
    apply MvPolynomial.ext
    intro s
    rw [MvPolynomial.coeff_killCompl]
    by_cases hs : p.coeff (s.mapDomain f) = 0
    · simpa using hs
    · have hm : s.mapDomain f ∈ p.support :=
        MvPolynomial.mem_support_iff.mpr hs
      obtain ⟨i, hi, hsi⟩ := hp (s.mapDomain f) hm
      exact (hsi (Finsupp.mapDomain_of_notMem_range s i hi)).elim

noncomputable def complementIndexListProbe
    {sigma tau : Type v} [Fintype sigma] [Fintype tau]
    (f : sigma → tau) : List tau := by
  classical
  exact (Finset.univ.filter (fun j : tau ↦ j ∉ Set.range f)).toList

lemma complementIndexList_nodup
    {sigma tau : Type v} [Fintype sigma] [Fintype tau]
    (f : sigma → tau) : (complementIndexListProbe f).Nodup := by
  classical
  exact Finset.nodup_toList _

lemma mem_complementIndexList
    {sigma tau : Type v} [Fintype sigma] [Fintype tau]
    (f : sigma → tau) (j : tau) :
    j ∈ complementIndexListProbe f ↔ j ∉ Set.range f := by
  classical
  simp [complementIndexListProbe]

lemma length_complementIndexList
    {sigma tau : Type v} [Fintype sigma] [Fintype tau]
    (f : sigma → tau) (hf : Function.Injective f) :
    (complementIndexListProbe f).length =
      Fintype.card tau - Fintype.card sigma := by
  classical
  rw [complementIndexListProbe, Finset.length_toList]
  let s : Finset tau := Finset.univ.image f
  have heq : Finset.univ.filter (fun j : tau ↦ j ∉ Set.range f) =
      Finset.univ \ s := by
    ext j
    simp [s]
  have hs_card : s.card = Fintype.card sigma := by
    change (Finset.univ.image f).card = Fintype.card sigma
    rw [Finset.card_image_of_injective Finset.univ hf,
      Finset.card_univ]
  rw [heq, Finset.card_sdiff]
  simp [hs_card]

set_option linter.style.haveILetI false in
theorem coordinateRestriction_hasProjectiveDimensionLT
    {K : Type u} [Field K] {sigma tau : Type v}
    [Fintype sigma] [Fintype tau]
    (e : sigma ↪ tau) :
    letI : Algebra (MvPolynomial tau K) (MvPolynomial sigma K) :=
      (MvPolynomial.killCompl (R := K) e.injective).toRingHom.toAlgebra
    HasProjectiveDimensionLT
      (ModuleCat.of (MvPolynomial tau K) (MvPolynomial sigma K))
      (Fintype.card tau - Fintype.card sigma + 1) := by
  classical
  let R := MvPolynomial tau K
  let S := MvPolynomial sigma K
  let φ := MvPolynomial.killCompl (R := K) e.injective
  letI : Algebra R S := φ.toRingHom.toAlgebra
  let l := complementIndexListProbe (e : sigma → tau)
  let rs : List R := l.map (MvPolynomial.X (R := K))
  have hl : l.Nodup := complementIndexList_nodup _
  have hreg : IsWeaklyRegular R rs :=
    isWeaklyRegular_map_X_of_nodup l hl
  have hR : HasProjectiveDimensionLT (ModuleCat.of R R) 1 :=
    projective_iff_hasProjectiveDimensionLT_one.mp inferInstance
  have hquot : HasProjectiveDimensionLT
      (ModuleCat.of R
        (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R))))
      (rs.length + 1) := by
    simpa using
      (hasProjectiveDimensionLT_quotient_of_isWeaklyRegular
        rs hreg 0 hR)
  let f : R →ₗ[R] S := Algebra.linearMap R S
  have hf : Function.Surjective f := by
    intro p
    refine ⟨MvPolynomial.rename e p, ?_⟩
    change MvPolynomial.killCompl e.injective
      (MvPolynomial.rename e p) = p
    exact MvPolynomial.killCompl_rename_app e.injective p
  have hker :
      Ideal.ofList rs • (⊤ : Submodule R R) = LinearMap.ker f := by
    rw [ideal_smul_top_eq_self]
    change (Ideal.ofList rs : Submodule R R) = LinearMap.ker f
    have hrs : Ideal.ofList rs =
        Ideal.span
          (MvPolynomial.X '' {j : tau | j ∉ Set.range e} : Set R) := by
      change Ideal.ofList (l.map (MvPolynomial.X (R := K))) = _
      rw [ideal_ofList_map_X_eq_span]
      have hset : {j : tau | j ∈ l} =
          {j : tau | j ∉ Set.range e} := by
        ext j
        exact mem_complementIndexList (e : sigma → tau) j
      rw [hset]
    rw [hrs]
    change (Ideal.span
        (MvPolynomial.X '' {j : tau | j ∉ Set.range e} : Set R) :
          Submodule R R) = LinearMap.ker f
    rw [← ker_killCompl_eq_span_complement
      (e : sigma → tau) e.injective]
    rfl
  let eqKer :
      (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R))) ≃ₗ[R]
        (R ⧸ LinearMap.ker f) :=
    Submodule.quotEquivOfEq _ _ hker
  let eqTarget :
      (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R))) ≃ₗ[R] S :=
    eqKer.trans (f.quotKerEquivOfSurjective hf)
  let _ : HasProjectiveDimensionLT
      (ModuleCat.of R
        (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R))))
      (rs.length + 1) := hquot
  have hout : HasProjectiveDimensionLT (ModuleCat.of R S)
      (rs.length + 1) :=
    hasProjectiveDimensionLT_of_iso eqTarget.toModuleIso (rs.length + 1)
  simpa [rs, l, length_complementIndexList
    (e : sigma → tau) e.injective] using hout

end SimplicialSphereAnisotropicity.Algebra

end

