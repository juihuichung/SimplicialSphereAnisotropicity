section

/-!
# Face-locality for the finite affine comparison

The carried reverse of every attached subdivision term of an affine face
already lives in the full simplex on that original face.  This module makes
that locality explicit and records the corresponding attached-list sums.
-/

noncomputable section

open scoped BigOperators
open CategoryTheory CategoryTheory.Limits Simplicial Opposite
open SimplicialSphereAnisotropicity.Simplicial

namespace SimplicialSphereAnisotropicity.Topology

universe u

/-- Forget the universe lift on one attached small affine subdivision term. -/
noncomputable def smallAffineFaceSubdivisionTerm {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : AffineSimplex q q)
    (hp : p ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    starSmallSingularSSet C _⦋q⦌ :=
  liftedSmallToSmall.{u} C
    (liftedAffineFaceSubdivisionTerm.{u} C F p hp)

theorem smallAffineFaceSubdivisionTerm_val {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : AffineSimplex q q)
    (hp : p ∈ affineSubdivisionTermList q (AffineSimplex.identity q)) :
    (smallAffineFaceSubdivisionTerm.{u} C F p hp).1 =
      pushAffineSimplex (preGeomTop C) (affineFaceSimplexLow C F) p := by
  apply Equiv.injective ((preGeomTop C).toSSetObjEquiv _)
  ext z v
  rfl

/-- Every pointwise barycentric support of a subdivided affine term remains
inside its original finite face. -/
theorem smallAffineFaceSubdivisionTerm_support {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : AffineSimplex q q)
    (hp : p ∈ affineSubdivisionTermList q (AffineSimplex.identity q))
    (z : stdSimplex ℝ (Fin (q + 1))) :
    SimplicialSphereAnisotropicity.barycentricSupport
        ((preGeomTop C).toSSetObjEquiv _
          (smallAffineFaceSubdivisionTerm.{u} C F p hp).1 z).1 ⊆ F.1 := by
  rw [smallAffineFaceSubdivisionTerm_val.{u}]
  change SimplicialSphereAnisotropicity.barycentricSupport
      (stdSimplex.map (faceOrderEmb C F) (p.realize z)) ⊆ F.1
  exact (barycentricSupport_stdSimplex_map_subset
      (faceOrderEmb C F) (p.realize z)).trans (by
        rw [faceOrderEmb, Finset.image_orderEmbOfFin_univ])

/-! ## Transported attached-list generator -/

/-- Low-universe generator belonging to one attached term. -/
noncomputable def affineSubdivisionSmallGeneratorTerm
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : {p // p ∈
      affineSubdivisionTermList q (AffineSimplex.identity q)}) :
    ModuleCat.of K K ⟶
      ((starSmallSingularSSet C).chainComplex
        (ModuleCat.of K K)).X q :=
  (starSmallSingularSSet C).ιChainComplex
    (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)

/-- The attached-list small generator after universe transport. -/
noncomputable def affineSubdivisionSmallGenerator
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    ModuleCat.of K K ⟶
      ((starSmallSingularSSet C).chainComplex
        (ModuleCat.of K K)).X q :=
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  (l.attach.map (affineSubdivisionSmallGeneratorTerm K C F)).sum

/-- Transport of the lifted attached-list generator is the low-universe
attached-list generator term by term. -/
theorem affineSubdivisionLiftedSmallGenerator_toLow
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    affineSubdivisionLiftedSmallGenerator K C F ≫
        liftedSmallToSmallDegree K C q =
      affineSubdivisionSmallGenerator K C F := by
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  change (l.attach.map
      (affineSubdivisionLiftedSmallGeneratorTerm K C F)).sum ≫
        liftedSmallToSmallDegree K C q =
    (l.attach.map (affineSubdivisionSmallGeneratorTerm K C F)).sum
  induction l.attach with
  | nil => simp
  | cons p ps ih =>
      simp only [List.map_cons, List.sum_cons, Preadditive.add_comp]
      rw [ih]
      congr 1
      exact iota_liftedSmallToSmallDegree K C
        (liftedAffineFaceSubdivisionTerm C F p.1 p.2)

/-! ## Retaining the reverse chain in the original face -/

/-- Inclusion of the full simplex on a face into the ambient precomplex. -/
theorem faceSimplex_le_ambient {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    {F : Finset (Fin m)} (hF : F ∈ C) : faceSimplex F ≤ C := by
  rintro G ⟨hGne, hGF⟩
  exact (C.isRelLowerSet_faces hF).2 hGF hGne

theorem augmentedFaceSimplex_le_ambient {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    {F : Finset (Fin m)} (hF : F ∈ C) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ AugmentedComplex.ofPre (faceSimplex F) →
        G ∈ AugmentedComplex.ofPre C := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr (faceSimplex_le_ambient C hF hG)

/-- A pointwise support carrier bounded by `F` includes into the augmented
full simplex on `F`. -/
theorem augmentedSupportCarrier_le_faceSimplex {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (F : Finset (Fin m))
    (hF : ∀ t : stdSimplex ℝ (Fin (q + 1)),
      SimplicialSphereAnisotropicity.barycentricSupport
        ((preGeomTop C).toSSetObjEquiv _ σ.1 t).1 ⊆ F) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ augmentedSupportCarrier C σ →
        G ∈ AugmentedComplex.ofPre (faceSimplex F) := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr (supportCarrier_le_faceSimplex C σ.1 F hF hG)

/-- The recursive carried reverse chain included only as far as a prescribed
full face simplex. -/
noncomputable def reverseOnToFace
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (F : Finset (Fin m))
    (hF : ∀ t : stdSimplex ℝ (Fin (q + 1)),
      SimplicialSphereAnisotropicity.barycentricSupport
        ((preGeomTop C).toSSetObjEquiv _ σ.1 t).1 ⊆ F) :
    AugmentedChain K (AugmentedComplex.ofPre (faceSimplex F)) (q + 1) :=
  faceChainInclusionDegree K
      (augmentedSupportCarrier_le_faceSimplex C σ F hF) (q + 1)
    (reverseLocalOn K C q σ)

/-- Further inclusion of the prescribed-face reverse chain is the public
ambient reverse chain. -/
theorem reverseOnToFace_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (σ : starSmallSingularSSet C _⦋q⦌)
    (F : Finset (Fin m)) (hFC : F ∈ C)
    (hF : ∀ t : stdSimplex ℝ (Fin (q + 1)),
      SimplicialSphereAnisotropicity.barycentricSupport
        ((preGeomTop C).toSSetObjEquiv _ σ.1 t).1 ⊆ F) :
    faceChainInclusionDegree K
        (augmentedFaceSimplex_le_ambient C hFC)
        (q + 1) (reverseOnToFace K C σ F hF) =
      reverseOn K C σ := by
  let hSF := augmentedSupportCarrier_le_faceSimplex C σ F hF
  let hFA := augmentedFaceSimplex_le_ambient C hFC
  let hSA := augmentedSupportCarrier_le C σ
  have hcomp := faceChainInclusionDegree_comp K hSF hFA hSA (q + 1)
  have hfun := LinearMap.congr_fun hcomp (reverseLocalOn K C q σ)
  simpa only [hSF, hFA, hSA, LinearMap.comp_apply,
    reverseOnToFace, reverseOn] using hfun

/-- A positive-cardinality augmented face belongs to the original
precomplex, rather than being the adjoined empty face. -/
theorem face_mem_pre_of_card_succ {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    F.1 ∈ C := by
  rcases F.2.1 with h | h
  · have hne : F.1 ≠ ∅ :=
      (Finset.card_pos.mp (show 0 < F.1.card by omega)).ne_empty
    exact (hne h).elim
  · exact h

noncomputable def reverseSubdivisionAffineLocalTerm
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : {p // p ∈
      affineSubdivisionTermList q (AffineSimplex.identity q)}) :
    AugmentedChain K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1) :=
  reverseOnToFace K C
    (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2) F.1
    (smallAffineFaceSubdivisionTerm_support.{u} C F p.1 p.2)

noncomputable def reverseSubdivisionAffineTerm
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (p : {p // p ∈
      affineSubdivisionTermList q (AffineSimplex.identity q)}) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) :=
  reverseOn K C (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)

/-- Local face-chain value of `reverse ∘ subdivision ∘ affineFace` on
one positive-cardinality basis face. -/
noncomputable def reverseSubdivisionAffineLocalOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    AugmentedChain K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1) :=
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  (l.attach.map (reverseSubdivisionAffineLocalTerm K C F)).sum

/-- Ambient value of the same attached reverse sum. -/
noncomputable def reverseSubdivisionAffineOn
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    AugmentedChain K (AugmentedComplex.ofPre C) (q + 1) :=
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  (l.attach.map (reverseSubdivisionAffineTerm K C F)).sum

/-- Applying the carried reverse to the low attached generator is the
attached sum of reverse generators. -/
theorem affineSubdivisionSmallGenerator_reverse
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    affineSubdivisionSmallGenerator K C F ≫ reverseDegree K C q =
      ((affineSubdivisionTermList q (AffineSimplex.identity q)).attach.map
        fun p ↦ reverseGenerator K C
          (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).sum := by
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  change (l.attach.map (affineSubdivisionSmallGeneratorTerm K C F)).sum ≫
      reverseDegree K C q =
    (l.attach.map fun p ↦ reverseGenerator K C
      (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).sum
  induction l.attach with
  | nil =>
      change 0 ≫ reverseDegree K C q = 0
      rw [zero_comp]
  | cons p ps ih =>
      simp only [List.map_cons, List.sum_cons, Preadditive.add_comp]
      rw [ih]
      dsimp only [affineSubdivisionSmallGeneratorTerm]
      rw [iota_reverseDegree]

/-- Evaluation at `1` of the preceding generator equation is the concrete
ambient attached reverse sum. -/
theorem affineSubdivisionSmallGenerator_reverse_apply_one
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    (reverseDegree K C q).hom
        ((affineSubdivisionSmallGenerator K C F).hom 1) =
      reverseSubdivisionAffineOn K C F := by
  have h := congrArg (fun f ↦ f.hom (1 : K))
    (affineSubdivisionSmallGenerator_reverse K C F)
  rw [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  have heval :
      ((l.attach.map fun p ↦ reverseGenerator K C
        (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).sum).hom
          (1 : K) =
        (l.attach.map (reverseSubdivisionAffineTerm K C F)).sum := by
    induction l.attach with
    | nil =>
        change (0 : AugmentedChain K
          (AugmentedComplex.ofPre C) (q + 1)) = 0
        rfl
    | cons p ps ih =>
        have hpval :
            (reverseGenerator K C
              (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).hom
                (1 : K) =
              reverseSubdivisionAffineTerm K C F p := by
          change (LinearMap.toSpanSingleton K _
              (reverseOn K C
                (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2))) 1 =
            reverseOn K C
              (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)
          exact LinearMap.toSpanSingleton_apply_one K
            (AugmentedChain K (AugmentedComplex.ofPre C) (q + 1)) _
        simp only [List.map_cons, List.sum_cons]
        change (reverseGenerator K C
            (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).hom 1 +
            ((ps.map fun p ↦ reverseGenerator K C
              (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2)).sum).hom 1 =
          reverseSubdivisionAffineTerm K C F p +
            (ps.map (reverseSubdivisionAffineTerm K C F)).sum
        rw [ih, hpval]
        rfl
  exact h.trans (by
    simpa only [l, reverseSubdivisionAffineOn] using heval)

/-- The endomorphism of finite face chains obtained by the small affine map
followed by the carried reverse. -/
noncomputable def reverseSubdivisionAffine
    (K : Type u) [Field K] [CharP K 2] {m : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    faceChainComplex K (AugmentedComplex.ofPre C) ⟶
      faceChainComplex K (AugmentedComplex.ofPre C) :=
  augmentedAffineSubdivisionSmall K C ≫ augmentedReverse K C

@[simp]
theorem reverseSubdivisionAffine_f_succ
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m)) :
    (reverseSubdivisionAffine K C).f (q + 1) =
      affineSubdivisionLiftedSmallDegree K C q ≫
        liftedSmallToSmallDegree K C q ≫ reverseDegree K C q := rfl

/-- Concrete value of the composite on a positive-cardinality basis face. -/
theorem reverseSubdivisionAffine_single
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1))
    (a : K) :
    ((reverseSubdivisionAffine K C).f (q + 1)).hom
        (Finsupp.single F a) =
      a • reverseSubdivisionAffineOn K C F := by
  rw [reverseSubdivisionAffine_f_succ]
  change (reverseDegree K C q).hom
      ((liftedSmallToSmallDegree K C q).hom
        (affineSubdivisionLiftedSmallDegreeLinear K C q
          (Finsupp.single F a))) = _
  rw [affineSubdivisionLiftedSmallDegreeLinear_single,
    map_smul, map_smul]
  congr 1
  have hlow := congrArg (fun f ↦ f.hom (1 : K))
    (affineSubdivisionLiftedSmallGenerator_toLow K C F)
  change (liftedSmallToSmallDegree K C q).hom
      ((affineSubdivisionLiftedSmallGenerator K C F).hom 1) =
    (affineSubdivisionSmallGenerator K C F).hom 1 at hlow
  rw [hlow]
  exact affineSubdivisionSmallGenerator_reverse_apply_one K C F

/-- The concrete ambient values satisfy the finite face-boundary equation. -/
theorem reverseSubdivisionAffineOn_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (reverseSubdivisionAffineOn K C F) =
      ∑ i : Fin (q + 2),
        reverseSubdivisionAffineOn K C (eraseFaceAtIndex C F i) := by
  have hcomm := (reverseSubdivisionAffine K C).comm (q + 2) (q + 1)
  have hlin := congrArg ModuleCat.Hom.hom hcomm
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp,
    faceChainComplex_d_hom] at hlin
  let x : (faceChainComplex K
      (AugmentedComplex.ofPre C)).X (q + 2) := Finsupp.single F (1 : K)
  have h := LinearMap.congr_fun hlin x
  change faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
      (((reverseSubdivisionAffine K C).f (q + 2)).hom
        (Finsupp.single F 1)) =
    ((reverseSubdivisionAffine K C).f (q + 1)).hom
      (faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (Finsupp.single F 1)) at h
  rw [reverseSubdivisionAffine_single, one_smul,
    faceBoundary_single, one_smul,
    boundaryOnSimplex_eq_sum_eraseFaceAtIndex] at h
  let y : Fin (q + 2) →
      (faceChainComplex K
        (AugmentedComplex.ofPre C)).X (q + 1) :=
    fun i ↦ Finsupp.single (eraseFaceAtIndex C F i) 1
  have hmap := map_sum
    ((reverseSubdivisionAffine K C).f (q + 1)).hom y Finset.univ
  change ((reverseSubdivisionAffine K C).f (q + 1)).hom
      (∑ i, y i) =
    ∑ i, ((reverseSubdivisionAffine K C).f (q + 1)).hom (y i) at hmap
  change faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
      (reverseSubdivisionAffineOn K C F) =
    ((reverseSubdivisionAffine K C).f (q + 1)).hom (∑ i, y i) at h
  rw [hmap] at h
  simp only [y, reverseSubdivisionAffine_single, one_smul] at h
  apply Finsupp.ext
  intro G
  exact congrArg (fun z ↦ z G) h

/-- The local attached reverse sum includes to its ambient value. -/
theorem reverseSubdivisionAffineLocalOn_inclusion
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 1)) :
    faceChainInclusionDegree K
        (augmentedFaceSimplex_le_ambient C (face_mem_pre_of_card_succ C F))
        (q + 1) (reverseSubdivisionAffineLocalOn K C F) =
      reverseSubdivisionAffineOn K C F := by
  let l := affineSubdivisionTermList q (AffineSimplex.identity q)
  rw [reverseSubdivisionAffineLocalOn, reverseSubdivisionAffineOn,
    map_list_sum, List.map_map]
  apply congrArg List.sum
  apply List.map_congr_left
  intro p hp
  change faceChainInclusionDegree K
      (augmentedFaceSimplex_le_ambient C
        (face_mem_pre_of_card_succ C F)) (q + 1)
      (reverseSubdivisionAffineLocalTerm K C F p) =
    reverseSubdivisionAffineTerm K C F p
  exact reverseOnToFace_inclusion K C
    (smallAffineFaceSubdivisionTerm.{u} C F p.1 p.2) F.1
    (face_mem_pre_of_card_succ C F)
    (smallAffineFaceSubdivisionTerm_support.{u} C F p.1 p.2)

/-! ## Boundary locality inside the full simplex on a face -/

/-- Monotonicity of augmented full face simplices. -/
theorem augmentedFaceSimplex_mono {m : ℕ}
    {E F : Finset (Fin m)} (hEF : E ⊆ F) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ AugmentedComplex.ofPre (faceSimplex E) →
        G ∈ AugmentedComplex.ofPre (faceSimplex F) := by
  intro G hG
  rcases hG with rfl | hG
  · exact Or.inl rfl
  · exact Or.inr ⟨hG.1, hG.2.trans hEF⟩

/-- The full simplex on an erased face includes into the full simplex on
the original face. -/
theorem augmentedFaceSimplex_eraseFaceAtIndex_le {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2))
    (i : Fin (q + 2)) :
    ∀ ⦃G : Finset (Fin m)⦄,
      G ∈ AugmentedComplex.ofPre
          (faceSimplex (eraseFaceAtIndex C F i).1) →
        G ∈ AugmentedComplex.ofPre (faceSimplex F.1) :=
  augmentedFaceSimplex_mono (by
    rw [eraseFaceAtIndex_val]
    exact Finset.erase_subset _ _)

/-- The face-local attached reverse values themselves satisfy the boundary
equation after including the erased-face values into the larger full
simplex. -/
theorem reverseSubdivisionAffineLocalOn_boundary
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (C : PreAbstractSimplicialComplex (Fin m))
    (F : AugmentedSimplex (AugmentedComplex.ofPre C) (q + 2)) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1)) (q + 1)
        (reverseSubdivisionAffineLocalOn K C F) =
      ∑ i : Fin (q + 2),
        faceChainInclusionDegree K
          (augmentedFaceSimplex_eraseFaceAtIndex_le C F i) (q + 1)
          (reverseSubdivisionAffineLocalOn K C
            (eraseFaceAtIndex C F i)) := by
  let hFA := augmentedFaceSimplex_le_ambient C
    (face_mem_pre_of_card_succ C F)
  apply faceChainInclusionDegree_injective K hFA (q + 1)
  calc
    faceChainInclusionDegree K hFA (q + 1)
        (faceBoundary K (AugmentedComplex.ofPre (faceSimplex F.1))
          (q + 1) (reverseSubdivisionAffineLocalOn K C F)) =
      faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (faceChainInclusionDegree K hFA (q + 2)
          (reverseSubdivisionAffineLocalOn K C F)) := by
      have h := LinearMap.congr_fun
        (faceChainInclusion_boundary K hFA (q + 1))
        (reverseSubdivisionAffineLocalOn K C F)
      exact h.symm
    _ = faceBoundary K (AugmentedComplex.ofPre C) (q + 1)
        (reverseSubdivisionAffineOn K C F) := by
      rw [reverseSubdivisionAffineLocalOn_inclusion]
    _ = ∑ i : Fin (q + 2),
        reverseSubdivisionAffineOn K C
          (eraseFaceAtIndex C F i) :=
      reverseSubdivisionAffineOn_boundary K C F
    _ = faceChainInclusionDegree K hFA (q + 1)
        (∑ i : Fin (q + 2),
          faceChainInclusionDegree K
            (augmentedFaceSimplex_eraseFaceAtIndex_le C F i) (q + 1)
            (reverseSubdivisionAffineLocalOn K C
              (eraseFaceAtIndex C F i))) := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i hi
      let E := eraseFaceAtIndex C F i
      let hEF := augmentedFaceSimplex_eraseFaceAtIndex_le C F i
      let hEA := augmentedFaceSimplex_le_ambient C
        (face_mem_pre_of_card_succ C E)
      have hcomp := LinearMap.congr_fun
        (faceChainInclusionDegree_comp K hEF hFA hEA (q + 1))
        (reverseSubdivisionAffineLocalOn K C E)
      have hlocal := reverseSubdivisionAffineLocalOn_inclusion K C E
      exact (hcomp.trans hlocal).symm

/-! ## Cone filling in a full face simplex -/

/-- Selected apex of a nonempty finite face. -/
noncomputable def faceApex {m q : ℕ}
    (F : Finset (Fin m)) (hcard : F.card = q + 1) : Fin m :=
  F.orderEmbOfFin hcard 0

@[simp]
theorem faceApex_mem {m q : ℕ}
    (F : Finset (Fin m)) (hcard : F.card = q + 1) :
    faceApex F hcard ∈ F :=
  Finset.orderEmbOfFin_mem F hcard 0

theorem faceSimplexAugmented_insert_apex {m q : ℕ}
    (F : Finset (Fin m)) (hcard : F.card = q + 1) :
    ∀ {G : Finset (Fin m)},
      G ∈ AugmentedComplex.ofPre (faceSimplex F) →
        insert (faceApex F hcard) G ∈
          AugmentedComplex.ofPre (faceSimplex F) := by
  intro G hG
  apply (AugmentedComplex.mem_ofPre (faceSimplex F) _).2
  right
  exact ⟨Finset.insert_nonempty _ _, Finset.insert_subset
    (faceApex_mem F hcard) <| by
      rcases hG with rfl | hG
      · exact Finset.empty_subset _
      · exact hG.2⟩

/-- The full simplex on `F` fills every cycle by coning at its selected
apex. -/
theorem faceSimplex_cone_fills_cycle
    (K : Type u) [Field K] [CharP K 2] {m q : ℕ}
    (F : Finset (Fin m)) (hcard : F.card = q + 1)
    (z : AugmentedChain K
      (AugmentedComplex.ofPre (faceSimplex F)) (q + 1))
    (hz : faceBoundary K (AugmentedComplex.ofPre (faceSimplex F)) q z = 0) :
    faceBoundary K (AugmentedComplex.ofPre (faceSimplex F)) (q + 1)
        (faceCone K (AugmentedComplex.ofPre (faceSimplex F))
          (faceApex F hcard) (faceSimplexAugmented_insert_apex F hcard)
          (q + 1) z) = z := by
  have h := LinearMap.congr_fun
    (faceCone_contraction_succ K
      (AugmentedComplex.ofPre (faceSimplex F))
      (faceApex F hcard) (faceSimplexAugmented_insert_apex F hcard) q) z
  simp only [LinearMap.add_apply, LinearMap.comp_apply,
    LinearMap.id_apply, hz, map_zero, add_zero] at h
  exact h

end SimplicialSphereAnisotropicity.Topology

end

