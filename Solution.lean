section

/-!
# A basis of the trusted reduction from the specialized Brion Gram matrix

A general unit-determinant pairing matrix makes its indexed vectors linearly
independent. The direct face-model map is surjective, and its parameter action
specializes by constant coefficient, so images of any parameter-ring basis
span the exact trusted reduction. Applying these two facts to the specialized
Brion Gram matrix constructs a basis of that quotient.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u v

theorem linearIndependent_of_pairingMatrix_det_isUnit
    {K₀ : Type u} [Field K₀]
    {A : Type v} [AddCommGroup A] [Module K₀ A]
    {N : ℕ} (P : A →ₗ[K₀] A →ₗ[K₀] K₀) (a : Fin N → A)
    (hdet : IsUnit (Matrix.of fun i j ↦ P (a i) (a j)).det) :
    LinearIndependent K₀ a := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  let G : Matrix (Fin N) (Fin N) K₀ :=
    Matrix.of fun i j ↦ P (a i) (a j)
  have hvec : c ᵥ* G = 0 := by
    funext j
    change (∑ i, c i * P (a i) (a j)) = 0
    calc
      (∑ i, c i * P (a i) (a j)) =
          P.flip (a j) (∑ i, c i • a i) := by
        rw [map_sum]
        simp only [map_smul, LinearMap.flip_apply, smul_eq_mul]
      _ = P.flip (a j) 0 := by rw [hc]
      _ = 0 := by simp
  have hunit : IsUnit G :=
    (Matrix.isUnit_iff_isUnit_det G).mpr hdet
  have hinj : Function.Injective G.vecMul :=
    Matrix.vecMul_injective_iff_isUnit.mpr hunit
  have hc0 : c = 0 := by
    apply hinj
    simpa using hvec
  exact congrFun hc0 i

private abbrev K_ReductionBasis (k : Type u) [Field k] (n m : ℕ) :=
  SimplicialSphereAnisotropicity.GenericField k n m

private abbrev T_ReductionBasis (k : Type u) [Field k] (n m : ℕ) :=
  Generic.ParameterRing k n m

private abbrev Model_ReductionBasis (k : Type u) [Field k] (n m : ℕ)
    (D : AbstractSimplicialComplex (Fin m)) :=
  FaceRingModel (K_ReductionBasis k n m) (AugmentedComplex.ofAbstract D)

private abbrev Reduction_ReductionBasis (k : Type u) [Field k] (n : ℕ) {m : ℕ}
    (D : AbstractSimplicialComplex (Fin m)) :=
  SimplicialSphereAnisotropicity.GenericArtinianReduction k (n := n) D

set_option linter.style.haveILetI false in
theorem span_faceRingModelToReduction_basis_eq_top
    (k : Type u) [Field k] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (b : letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionBasis k n m) (Model_ReductionBasis k n m D)) :
    Submodule.span (K_ReductionBasis k n m)
        (Set.range fun i ↦ faceRingModelToReduction k D (b i)) = ⊤ := by
  letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
    faceRingModelCanonicalModule k D
  apply top_unique
  intro y _hy
  obtain ⟨z, rfl⟩ :=
    faceRingModelToReduction_surjective k (n := n) D y
  rw [← b.sum_repr z, map_sum]
  apply Submodule.sum_mem
  intro i _hi
  rw [faceRingModelToReduction_parameter_smul]
  exact Submodule.smul_mem _ _
    (Submodule.subset_span (Set.mem_range_self i))

set_option linter.style.haveILetI false in
theorem faceRingModelToReduction_basis_linearIndependent
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionBasis k n m) (Model_ReductionBasis k n m D))
    (hdet : IsUnit (faceRingBrionResidueGramMatrix
      k D hd hpm b).det) :
    LinearIndependent (K_ReductionBasis k n m)
      (fun i ↦ faceRingModelToReduction k D (b i)) := by
  letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
    faceRingModelCanonicalModule k D
  apply linearIndependent_of_pairingMatrix_det_isUnit
    (reductionBrionPairing k D hd hpm)
  have hmatrix :
      Matrix.of (fun i j ↦ reductionBrionPairing k D hd hpm
        (faceRingModelToReduction k D (b i))
        (faceRingModelToReduction k D (b j))) =
        faceRingBrionResidueGramMatrix k D hd hpm b := by
    ext i j
    rw [Matrix.of_apply,
      reductionBrionPairing_basis_eq_constantCoeff_gram,
      faceRingBrionResidueGramMatrix_apply]
  rw [hmatrix]
  exact hdet

set_option linter.style.haveILetI false in
noncomputable def reductionBasisOfFaceRingBasis
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionBasis k n m) (Model_ReductionBasis k n m D))
    (hdet : IsUnit (faceRingBrionResidueGramMatrix
      k D hd hpm b).det) :
    Module.Basis (Fin N) (K_ReductionBasis k n m) (Reduction_ReductionBasis k n D) := by
  letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
    faceRingModelCanonicalModule k D
  exact Module.Basis.mk
    (faceRingModelToReduction_basis_linearIndependent
      k D hd hpm b hdet)
    (span_faceRingModelToReduction_basis_eq_top k D b).ge

set_option linter.style.haveILetI false in
@[simp]
theorem reductionBasisOfFaceRingBasis_apply
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionBasis k n m) (Model_ReductionBasis k n m D))
    (hdet : IsUnit (faceRingBrionResidueGramMatrix
      k D hd hpm b).det) (i : Fin N) :
    reductionBasisOfFaceRingBasis k D hd hpm b hdet i =
      faceRingModelToReduction k D (b i) := by
  letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
    faceRingModelCanonicalModule k D
  exact Module.Basis.mk_apply _ _ i

set_option linter.style.haveILetI false in
noncomputable def sphereReductionBasis
    (k : Type u) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (T_ReductionBasis k n m) (Model_ReductionBasis k n m D) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (T_ReductionBasis k n m) (Model_ReductionBasis k n m D))
    (r : Fin N → ℕ)
