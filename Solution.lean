noncomputable section

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology

namespace SimplicialSphereAnisotropicity.StanleyReisner

universe u

noncomputable def faceRingModelComponent
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ) :
    FaceRingModel K C →ₗ[K] FaceRingModel K C where
  toFun z := z.filter (fun a ↦ a.1.degree = r)
  map_add' _x _y := Finsupp.filter_add
  map_smul' _c _z := Finsupp.filter_smul

@[simp]
theorem faceRingModelComponent_apply
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ)
    (z : FaceRingModel K C) (a : AllowedExponent C) :
    faceRingModelComponent K C r z a =
      if a.1.degree = r then z a else 0 := by
  rfl

theorem faceRingModelComponent_homogeneous
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ)
    (z : FaceRingModel K C) :
    FaceRingModelHomogeneous K C r
      (faceRingModelComponent K C r z) := by
  intro a ha
  rw [Finsupp.mem_support_iff,
    faceRingModelComponent_apply] at ha
  by_contra hdegree
  simp [hdegree] at ha

theorem faceRingModelComponent_eq_self
    (K : Type u) [Field K] {m r : ℕ}
    (C : AugmentedComplex (Fin m)) (z : FaceRingModel K C)
    (hz : FaceRingModelHomogeneous K C r z) :
    faceRingModelComponent K C r z = z := by
  ext a
  rw [faceRingModelComponent_apply]
  by_cases ha : z a = 0
  · simp [ha]
  · have hasupp : a ∈ z.support := Finsupp.mem_support_iff.mpr ha
    simp [hz a hasupp]

theorem faceRingModelComponent_eq_zero_of_homogeneous_ne
    (K : Type u) [Field K] {m r s : ℕ}
    (C : AugmentedComplex (Fin m)) (z : FaceRingModel K C)
    (hz : FaceRingModelHomogeneous K C s z) (hrs : r ≠ s) :
    faceRingModelComponent K C r z = 0 := by
  ext a
  rw [faceRingModelComponent_apply]
  by_cases ha : z a = 0
  · simp [ha]
  · have hasupp : a ∈ z.support := Finsupp.mem_support_iff.mpr ha
    have hdegree := hz a hasupp
    simp [hdegree, hrs.symm]

theorem faceRingModelComponent_polynomialFacePart
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ)
    (p : MvPolynomial (Fin m) K) :
    faceRingModelComponent K C r (polynomialFacePart K C p) =
      polynomialFacePart K C (MvPolynomial.homogeneousComponent r p) := by
  ext a
  rw [faceRingModelComponent_apply,
    polynomialFacePart_apply, polynomialFacePart_apply,
    MvPolynomial.coeff_homogeneousComponent]

theorem faceRingModelToPolynomial_component
    (K : Type u) [Field K] {m : ℕ}
    (C : AugmentedComplex (Fin m)) (r : ℕ)
    (z : FaceRingModel K C) :
    faceRingModelToPolynomial K C (faceRingModelComponent K C r z) =
      MvPolynomial.homogeneousComponent r
        (faceRingModelToPolynomial K C z) := by
  ext a
  rw [MvPolynomial.coeff_homogeneousComponent]
  by_cases hface : a.support ∈ C
  · let a' : AllowedExponent C := ⟨a, hface⟩
    rw [faceRingModelToPolynomial_apply_allowed K C _ a',
      faceRingModelComponent_apply,
      faceRingModelToPolynomial_apply_allowed K C z a']
  · rw [faceRingModelToPolynomial_apply_not_allowed K C _ a hface,
      faceRingModelToPolynomial_apply_not_allowed K C z a hface]
    simp

theorem MvPolynomial.homogeneousComponent_mul_left_degree_one
    {K : Type u} [Field K] {sigma : Type*}
    (l p : MvPolynomial sigma K) (d : ℕ)
    (hl : l.IsHomogeneous 1) :
    MvPolynomial.homogeneousComponent (d + 1) (l * p) =
      l * MvPolynomial.homogeneousComponent d p := by
  induction p using MvPolynomial.induction_on' with
  | monomial a c =>
      have hp : (MvPolynomial.monomial a c).IsHomogeneous a.degree :=
        MvPolynomial.isHomogeneous_monomial c rfl
      have hlp : (l * MvPolynomial.monomial a c).IsHomogeneous
          (1 + a.degree) := hl.mul hp
      rw [MvPolynomial.homogeneousComponent_of_mem hlp,
        MvPolynomial.homogeneousComponent_of_mem hp]
      by_cases hda : d = a.degree
      · subst d
        simp [Nat.add_comm]
      · have hsucc : d + 1 ≠ 1 + a.degree := by omega
        simp [hda, hsucc]
  | add p q hp hq =>
      calc
        MvPolynomial.homogeneousComponent (d + 1) (l * (p + q)) =
            MvPolynomial.homogeneousComponent (d + 1) (l * p + l * q) := by
          rw [mul_add]
        _ = MvPolynomial.homogeneousComponent (d + 1) (l * p) +
            MvPolynomial.homogeneousComponent (d + 1) (l * q) := map_add _ _ _
        _ = l * MvPolynomial.homogeneousComponent d p +
            l * MvPolynomial.homogeneousComponent d q := by rw [hp, hq]
        _ = l * (MvPolynomial.homogeneousComponent d p +
            MvPolynomial.homogeneousComponent d q) := (mul_add _ _ _).symm
        _ = l * MvPolynomial.homogeneousComponent d (p + q) := by rw [map_add]

theorem MvPolynomial.homogeneousComponent_mul_left_degree_one_zero
    {K : Type u} [Field K] {sigma : Type*}
    (l p : MvPolynomial sigma K)
    (hl : l.IsHomogeneous 1) :
    MvPolynomial.homogeneousComponent 0 (l * p) = 0 := by
  induction p using MvPolynomial.induction_on' with
  | monomial a c =>
      have hp : (MvPolynomial.monomial a c).IsHomogeneous a.degree :=
        MvPolynomial.isHomogeneous_monomial c rfl
      have hlp : (l * MvPolynomial.monomial a c).IsHomogeneous
          (1 + a.degree) := hl.mul hp
      rw [MvPolynomial.homogeneousComponent_of_mem hlp]
      have hne : (0 : ℕ) ≠ 1 + a.degree := by omega
      rw [if_neg hne]
  | add p q hp hq =>
      calc
        MvPolynomial.homogeneousComponent 0 (l * (p + q)) =
            MvPolynomial.homogeneousComponent 0 (l * p + l * q) := by
          rw [mul_add]
        _ = MvPolynomial.homogeneousComponent 0 (l * p) +
            MvPolynomial.homogeneousComponent 0 (l * q) := map_add _ _ _
        _ = 0 := by rw [hp, hq, add_zero]

set_option linter.style.haveILetI false in
theorem faceRingModelComponent_parameter_X_smul
    (k : Type u) [Field k] {n m : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (i : Fin (n + 1)) (d : ℕ)
    (z : FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
      (AugmentedComplex.ofAbstract D)) :
    letI : Module (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)) :=
      faceRingModelCanonicalModule k D
    faceRingModelComponent
        (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) (d + 1)
        ((MvPolynomial.X i : Generic.ParameterRing k n m) • z) =
      (MvPolynomial.X i : Generic.ParameterRing k n m) •
        faceRingModelComponent
          (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D) d z := by
  letI : Module (Generic.ParameterRing k n m)
      (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
        (AugmentedComplex.ofAbstract D)) :=
    faceRingModelCanonicalModule k D
  rw [faceRingModelCanonical_smul_eq_facePart,
    faceRingModelComponent_polynomialFacePart,
    ambientParameterAlgHom_X,
    MvPolynomial.homogeneousComponent_mul_left_degree_one
      _ _ d (SimplicialSphereAnisotropicity.genericLinearForm_isHomogeneous k i),
    ← faceRingModelToPolynomial_component]
