section

/-!
# Grading of the polynomial-valued Brion functional

This module proves that the common denominator and common numerator in the
Brion construction are homogeneous.  Cancelling the nonzero denominator then
shows that the resulting polynomial lowers total degree by the facet size.  It
also packages the construction and its grading for the canonical face ring of
a trusted simplicial sphere.
-/

noncomputable section

open scoped BigOperators

open SimplicialSphereAnisotropicity.Simplicial
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

universe u

theorem homogeneousComponent_mul_left_of_homogeneous
    {L : Type u} [Field L] {σ : Type*}
    (a p : MvPolynomial σ L) (r q : ℕ)
    (ha : a.IsHomogeneous r) :
    MvPolynomial.homogeneousComponent q (a * p) =
      if _h : r ≤ q then
        a * MvPolynomial.homogeneousComponent (q - r) p
      else 0 := by
  induction p using MvPolynomial.induction_on' with
  | monomial β c =>
      have hp : (MvPolynomial.monomial β c).IsHomogeneous β.degree :=
        MvPolynomial.isHomogeneous_monomial c rfl
      have hap := ha.mul hp
      rw [MvPolynomial.homogeneousComponent_of_mem hap]
      by_cases hrq : r ≤ q
      · rw [dif_pos hrq,
          MvPolynomial.homogeneousComponent_of_mem hp]
        by_cases heq : q = r + β.degree
        · subst q
          simp
        · have hsub : q - r ≠ β.degree := by omega
          rw [if_neg heq, if_neg hsub, mul_zero]
      · rw [dif_neg hrq]
        have heq : q ≠ r + β.degree := by omega
        rw [if_neg heq]
  | add p₁ p₂ ih₁ ih₂ =>
      rw [mul_add, map_add, ih₁, ih₂]
      by_cases hrq : r ≤ q
      · rw [dif_pos hrq, dif_pos hrq, dif_pos hrq, map_add, mul_add]
      · rw [dif_neg hrq, dif_neg hrq, dif_neg hrq, add_zero]

theorem isHomogeneous_of_mul_left
    {L : Type u} [Field L] {σ : Type*}
    (a p b : MvPolynomial σ L) (r s : ℕ)
    (ha : a.IsHomogeneous r) (hb : b.IsHomogeneous (r + s))
    (ha0 : a ≠ 0) (hab : a * p = b) :
    p.IsHomogeneous s := by
  intro β hβ
  suffices hdegree : β.degree = s by
    rw [Finsupp.degree_eq_weight_one] at hdegree
    exact hdegree
  have hcomponent :
      MvPolynomial.homogeneousComponent β.degree p ≠ 0 := by
    intro hz
    have hzβ := congrArg (MvPolynomial.coeff β) hz
    rw [MvPolynomial.coeff_homogeneousComponent, if_pos rfl] at hzβ
    exact hβ hzβ
  by_contra hdegree
  have hsum : r + β.degree ≠ r + s := by omega
  have hzero :
      MvPolynomial.homogeneousComponent (r + β.degree) (a * p) = 0 := by
    rw [hab, MvPolynomial.homogeneousComponent_of_mem hb, if_neg hsum]
  rw [homogeneousComponent_mul_left_of_homogeneous
      a p r (r + β.degree) ha, dif_pos (by omega)] at hzero
  have hzero' :
      a * MvPolynomial.homogeneousComponent β.degree p = 0 := by
    simpa using hzero
  exact (mul_ne_zero ha0 hcomponent) hzero'

theorem facetRestriction_isHomogeneous
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (d : ℕ) (a : Matrix (Fin d) V L)
    (F : Finset V) (hF : F.card = d)
    (hdet : (facetMatrix L d a F hF).det ≠ 0)
    {r : ℕ} (f : MvPolynomial V L) (hf : f.IsHomogeneous r) :
    (facetRestriction L d a F hF hdet f).IsHomogeneous r := by
  let φ := facetRestriction L d a F hF hdet
  have hX : ∀ v : V, (φ (MvPolynomial.X v)).IsHomogeneous 1 := by
    intro v
    by_cases hv : v ∈ F
    · rw [facetRestriction_X_mem L d a F hF hdet v hv]
      exact inverseCoordinate_isHomogeneous L d a F hF hdet ⟨v, hv⟩
    · rw [facetRestriction_X_not_mem L d a F hF hdet v hv]
      exact MvPolynomial.isHomogeneous_zero (Fin d) L 1
  have heval : MvPolynomial.aeval (fun v : V ↦ φ (MvPolynomial.X v)) = φ := by
    apply MvPolynomial.algHom_ext
    intro v
    simp
  have h := hf.aeval (fun v : V ↦ φ (MvPolynomial.X v)) hX
  rw [heval] at h
  simpa only [one_mul] using h

theorem brionCommonDenominator_isHomogeneous
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0) :
    (brionCommonDenominator L D d a ha).IsHomogeneous
      (d * Fintype.card (FacetOfCard D d)) := by
  classical
  rw [brionCommonDenominator]
  have h := MvPolynomial.IsHomogeneous.prod
    (Finset.univ : Finset (FacetOfCard D d))
    (facetBrionDenominator L d a ha) (fun _F ↦ d)
    (fun F _hF ↦ facetEuler_isHomogeneous
      L d a F.1 F.2.2 (ha F))
  simpa [mul_comm] using h

theorem brionCommonNumerator_isHomogeneous
    (L : Type*) [Field L]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d r : ℕ)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    (f : MvPolynomial V L) (hf : f.IsHomogeneous r) :
    (brionCommonNumerator L D d a ha f).IsHomogeneous
      (r + d * (Fintype.card (FacetOfCard D d) - 1)) := by
  classical
  rw [brionCommonNumerator, commonDenominatorNumerator]
  apply MvPolynomial.IsHomogeneous.sum
      (Finset.univ : Finset (FacetOfCard D d))
  intro F _hF
  have hb : (facetBrionNumerator L d a ha f F).IsHomogeneous r :=
    facetRestriction_isHomogeneous
      L d a F.1 F.2.2 (ha F) f hf
  have hp := MvPolynomial.IsHomogeneous.prod
    ((Finset.univ : Finset (FacetOfCard D d)).erase F)
    (facetBrionDenominator L d a ha) (fun _G ↦ d)
    (fun G _hG ↦ facetEuler_isHomogeneous
      L d a G.1 G.2.2 (ha G))
  have hp' :
      (∏ G ∈ (Finset.univ : Finset (FacetOfCard D d)).erase F,
        facetBrionDenominator L d a ha G).IsHomogeneous
          (d * (Fintype.card (FacetOfCard D d) - 1)) := by
    simpa [mul_comm] using hp
  exact hb.mul hp'

theorem brionPolynomial_isHomogeneous_of_le
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d r : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    [Nonempty (FacetOfCard D d)]
    (f : MvPolynomial V L) (hf : f.IsHomogeneous r)
    (hdr : d ≤ r) :
    (brionPolynomial L D d hd hpm a ha f).IsHomogeneous (r - d) := by
  let N := Fintype.card (FacetOfCard D d)
  have hN : 0 < N := Fintype.card_pos_iff.mpr inferInstance
  have hden := brionCommonDenominator_isHomogeneous L D d a ha
  have hnum := brionCommonNumerator_isHomogeneous L D d r a ha f hf
  have hN1 : 1 ≤ N := hN
  have hNsucc : N - 1 + 1 = N := Nat.sub_add_cancel hN1
  have hr : r - d + d = r := Nat.sub_add_cancel hdr
  have hdegree : r + d * (N - 1) = d * N + (r - d) := by
    calc
      r + d * (N - 1) = (r - d + d) + d * (N - 1) := by rw [hr]
      _ = d * (N - 1 + 1) + (r - d) := by ring
      _ = d * N + (r - d) := by rw [hNsucc]
  rw [hdegree] at hnum
  apply isHomogeneous_of_mul_left
    (brionCommonDenominator L D d a ha)
    (brionPolynomial L D d hd hpm a ha f)
    (brionCommonNumerator L D d a ha f)
    (d * N) (r - d) hden hnum
    (brionCommonDenominator_ne_zero L D d a ha)
  exact (brionCommonNumerator_eq_denominator_mul_brionPolynomial
    L D d hd hpm a ha f).symm

theorem brionPolynomial_eq_zero_of_lt
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d r : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    [Nonempty (FacetOfCard D d)]
    (f : MvPolynomial V L) (hf : f.IsHomogeneous r)
    (hrd : r < d) :
    brionPolynomial L D d hd hpm a ha f = 0 := by
  let N := Fintype.card (FacetOfCard D d)
  have hN : 0 < N := Fintype.card_pos_iff.mpr inferInstance
  let den := brionCommonDenominator L D d a ha
  let num := brionCommonNumerator L D d a ha f
  let p := brionPolynomial L D d hd hpm a ha f
  have hden0 : den ≠ 0 :=
    brionCommonDenominator_ne_zero L D d a ha
  have hdenhom : den.IsHomogeneous (d * N) :=
    brionCommonDenominator_isHomogeneous L D d a ha
  have hnumhom : num.IsHomogeneous (r + d * (N - 1)) :=
    brionCommonNumerator_isHomogeneous L D d r a ha f hf
  have hrel : num = den * p :=
    brionCommonNumerator_eq_denominator_mul_brionPolynomial
      L D d hd hpm a ha f
  change p = 0
  by_contra hp0
  have hnum0 : num ≠ 0 := by
    rw [hrel]
    exact mul_ne_zero hden0 hp0
  have htotal :
      r + d * (N - 1) = d * N + p.totalDegree := by
    calc
      r + d * (N - 1) = num.totalDegree :=
        (hnumhom.totalDegree hnum0).symm
      _ = (den * p).totalDegree := congrArg MvPolynomial.totalDegree hrel
      _ = den.totalDegree + p.totalDegree :=
        MvPolynomial.totalDegree_mul_of_isDomain hden0 hp0
      _ = d * N + p.totalDegree := by
        rw [hdenhom.totalDegree hden0]
  have hN1 : 1 ≤ N := hN
  have hNsucc : N - 1 + 1 = N := Nat.sub_add_cancel hN1
  have hsplit : d * N = d * (N - 1) + d := by
    calc
      d * N = d * (N - 1 + 1) := congrArg (fun x : ℕ ↦ d * x) hNsucc |>.symm
      _ = d * (N - 1) + d := by rw [mul_add, mul_one]
  rw [hsplit] at htotal
  omega

theorem brionPolynomial_isHomogeneous
    (L : Type*) [Field L] [CharP L 2]
    {V : Type u} [Fintype V] [LinearOrder V]
    (D : AbstractSimplicialComplex V) (d r : ℕ)
    (hd : 2 ≤ d) (hpm : IsPseudomanifold D d)
    (a : Matrix (Fin d) V L)
    (ha : ∀ F : FacetOfCard D d,
      (facetMatrix L d a F.1 F.2.2).det ≠ 0)
    [Nonempty (FacetOfCard D d)]
    (f : MvPolynomial V L) (hf : f.IsHomogeneous r) :
    (brionPolynomial L D d hd hpm a ha f).IsHomogeneous (r - d) := by
  by_cases hdr : d ≤ r
  · exact brionPolynomial_isHomogeneous_of_le
      L D d r hd hpm a ha f hf hdr
  · rw [brionPolynomial_eq_zero_of_lt
      L D d r hd hpm a ha f hf (by omega)]
    exact MvPolynomial.isHomogeneous_zero (Fin d) L (r - d)

