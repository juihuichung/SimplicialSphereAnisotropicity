/-!
# Constant-term specialization and complementary Gram blocks

This module specializes the parameter-polynomial Brion Gram matrix at the
parameter origin. Its determinant remains a unit and its entries vanish away
from complementary degrees. A general finite-matrix argument then proves that
each initially rectangular complementary block induces a perfect pairing by
extending vectors by zero and using injectivity of the full matrix on both
sides.
-/

noncomputable section

open scoped BigOperators Matrix

open SimplicialSphereAnisotropicity.Simplicial SimplicialSphereAnisotropicity.Topology
open SimplicialSphereAnisotropicity.StanleyReisner

namespace SimplicialSphereAnisotropicity.Generic.Brion

theorem MvPolynomial.constantCoeff_eq_zero_of_isHomogeneous_pos
    {K : Type*} [Field K] {s : Type*} {p : MvPolynomial s K} {d : ℕ}
    (hp : p.IsHomogeneous d) (hd : 0 < d) :
    MvPolynomial.constantCoeff p = 0 := by
  rw [MvPolynomial.constantCoeff_eq]
  apply hp.coeff_eq_zero
  simp only [Finsupp.degree_apply, Finsupp.support_zero, Finset.sum_empty]
  omega

set_option linter.style.haveILetI false in
noncomputable def faceRingBrionResidueGramMatrix
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D))) :
    Matrix (Fin N) (Fin N) (SimplicialSphereAnisotropicity.GenericField k n m) :=
  (MvPolynomial.constantCoeff :
    Generic.ParameterRing k n m →+* SimplicialSphereAnisotropicity.GenericField k n m).mapMatrix
      (faceRingBrionGramMatrix k D hd hpm b)

set_option linter.style.haveILetI false in
@[simp]
theorem faceRingBrionResidueGramMatrix_apply
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (D : AbstractSimplicialComplex (Fin m))
    (hd : 2 ≤ n + 1) (hpm : IsPseudomanifold D (n + 1))
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)))
    (i j : Fin N) :
    faceRingBrionResidueGramMatrix k D hd hpm b i j =
      MvPolynomial.constantCoeff
        (faceRingBrionGramMatrix k D hd hpm b i j) := by
  rfl

set_option linter.style.haveILetI false in
theorem sphereFaceRingBrionResidueGramMatrix_det_isUnit
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
            (AugmentedComplex.ofAbstract D)) :=
        faceRingModelCanonicalModule k D
      Module.Basis (Fin N) (Generic.ParameterRing k n m)
        (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
          (AugmentedComplex.ofAbstract D)))
    (r : Fin N → ℕ)
    (hb : ∀ i, FaceRingModelHomogeneous
      (SimplicialSphereAnisotropicity.GenericField k n m) (AugmentedComplex.ofAbstract D)
      (r i) (b i)) :
    IsUnit ((faceRingBrionResidueGramMatrix k D (by omega)
      (SimplicialSphereAnisotropicity.Topology.simplicialSphere_isPseudomanifold
        (SimplicialSphereAnisotropicity.GenericField k n m) hn D hD) b).det) := by
  rw [faceRingBrionResidueGramMatrix,
    ← RingHom.map_det]
  exact (sphereFaceRingBrionGramMatrix_det_isUnit
    k hn D hD b r hb).map
      (MvPolynomial.constantCoeff :
        Generic.ParameterRing k n m →+* SimplicialSphereAnisotropicity.GenericField k n m)

set_option linter.style.haveILetI false in
theorem sphereFaceRingBrionResidueGramMatrix_isUnit
    (k : Type*) [Field k] [CharP k 2] {n m N : ℕ}
    (hn : 1 ≤ n) (D : AbstractSimplicialComplex (Fin m))
    (hD : SimplicialSphereAnisotropicity.IsSimplicialSphere D n)
    (b : letI : Module (Generic.ParameterRing k n m)
          (FaceRingModel (SimplicialSphereAnisotropicity.GenericField k n m)
